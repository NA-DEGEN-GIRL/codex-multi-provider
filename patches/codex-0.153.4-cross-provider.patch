+#[tokio::test]
+async fn returning_family_continues_its_own_context_then_the_other_turns() {
+    let config = crate::config::test_config().await;
+    let (records, anchor) = thread_back_on_gpt(&config, gpt_turns(), POLICY);
+    assert_eq!(
+        (
+            anchor.base_position,
+            anchor.cut_position,
+            anchor.items,
+            anchor.request_head.as_deref()
+        ),
+        (None, 7, 7, Some("gpt-head"))
+    );
+
+    let spliced = splice_for_gpt(&config, &records).expect("a splice");
+
+    // GPT's own context as its replay had it, encrypted reasoning included; then one note and
+    // DeepSeek's turn without its bundle or model-switch message. Other developer messages of
+    // DeepSeek's turn keep their content.
+    let gpt_context = gpt_replay(&transcript_from_rollout_items(&gpt_turns()), POLICY);
+    let mut expected = gpt_context.clone();
+    expected.push(ResponseItemEnvelope::new(ContextualUserFragment::into(
+        ProviderHandoffNote::new(DEEPSEEK_MODEL),
+    )));
+    expected.extend(
+        [
+            message("developer", "Keep answers short."),
+            message("user", "deepseek question"),
+            message("assistant", "deepseek answer"),
+        ]
+        .map(ResponseItemEnvelope::new),
+    );
+    assert_eq!(spliced.items, expected);
+    assert_eq!(
+        (
+            spliced.prefix_items,
+            spliced.suffix_items,
+            spliced.reference_context,
+            spliced.world_state,
+            spliced.request_head.as_deref(),
+        ),
+        (
+            gpt_context.len(),
+            3,
+            turn_context(GPT_MODEL, "openai"),
+            world_state(),
+            Some("gpt-head"),
+        )
+    );
+}
+
+#[tokio::test]
+async fn the_prefix_uses_the_returning_familys_limits_not_the_anchoring_familys() {
