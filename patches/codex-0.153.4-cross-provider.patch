+++ b/codex-rs/core/src/context/provider_handoff_note.rs
@@ -0,0 +1,54 @@
+use super::ContextualUserFragment;
+use codex_protocol::models::ContentItemKind;
+
+/// Longest provider name the note repeats.
+const MAX_PROVIDER_CHARS: usize = 64;
+
+/// Tells the model that the turns after it were answered by another model provider.
+///
+/// A family that takes a thread back keeps its own earlier context unchanged and appends the
+/// other provider's turns after this note, so the model knows those answers were not its own.
+/// Its size is bounded: one sentence and a provider name of at most 64 characters. Later
+/// rebuilds and splices for other families drop it with the rest of the recorded context
+/// messages.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ProviderHandoffNote {
+    provider: String,
+}
+
+impl ProviderHandoffNote {
+    pub(crate) fn new(provider: &str) -> Self {
+        Self {
+            provider: provider.chars().take(MAX_PROVIDER_CHARS).collect(),
+        }
+    }
+}
+
+impl ContextualUserFragment for ProviderHandoffNote {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("provider_handoff.note".to_string())
+    }
+
+    fn role(&self) -> &'static str {
+        "developer"
+    }
+
+    fn requires_separate_message(&self) -> bool {
+        true
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<provider_handoff>", "</provider_handoff>")
+    }
+
+    fn body(&self) -> String {
+        format!(
+            "\nThe turns below were answered by another model provider ({}). Continue the conversation from them.\n",
+            self.provider
+        )
+    }
+}
