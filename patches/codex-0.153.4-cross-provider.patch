+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn managed_idle_close_requires_descendant_release_and_leaves_other_roots_running()
+-> Result<()> {
+    let server = responses::start_mock_server().await;
+    let response = responses::mount_sse_once(&server, responses::sse_completed("peer")).await;
+    let test = test_codex().build_with_auto_env(&server).await?;
+    let peer = test
+        .thread_manager
+        .start_thread(StartThreadOptions::new(test.config.clone()))
+        .await?;
+    let child = test
+        .thread_manager
+        .start_thread(StartThreadOptions {
+            session_source: Some(SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                parent_thread_id: test.session_configured.thread_id,
+                depth: 1,
+                agent_path: None,
+                agent_nickname: None,
+                agent_role: None,
+            })),
+            ..StartThreadOptions::new(test.config.clone())
+        })
+        .await?;
+
+    assert!(matches!(
+        test.codex.close_idle_and_shutdown().await,
+        Err(error) if matches!(error.details(), CodexErrorDetails::UnsupportedOperation(_))
+    ));
+    child.thread.close_idle_and_shutdown().await?;
+    test.thread_manager
+        .remove_thread(&child.thread_id)
+        .await
+        .expect("the stopped child remains registered until removal");
+    test.codex.close_idle_and_shutdown().await?;
+
+    peer.thread
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "the unrelated root still works".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_event(&peer.thread, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert!(
+        response
+            .single_request()
+            .message_input_texts("user")
+            .iter()
+            .any(|text| text == "the unrelated root still works")
+    );
+    close_when_idle(&peer.thread).await?;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn managed_idle_close_does_not_terminate_a_background_terminal() -> Result<()> {
+    core_test_support::skip_if_no_network!(Ok(()));
+    core_test_support::skip_if_sandbox!(Ok(()));
+    core_test_support::skip_if_wine_exec!(
+        Ok(()),
+        "PowerShell execution is unavailable through Wine"
+    );
+    let server = responses::start_mock_server().await;
+    let command = match core_test_support::test_target_os() {
+        core_test_support::TestTargetOs::Linux | core_test_support::TestTargetOs::MacOs => {
+            "sleep 60"
+        }
+        core_test_support::TestTargetOs::Windows => "Start-Sleep -Seconds 60",
+    };
+    let args = json!({ "cmd": command, "yield_time_ms": 1_000 });
+    responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse(vec![
+                responses::ev_function_call("background", "exec_command", &args.to_string()),
+                responses::ev_completed("terminal-started"),
+            ]),
+            responses::sse_completed("turn-completed"),
+        ],
+    )
+    .await;
+    let idle = Arc::new(tokio::sync::Notify::new());
+    let mut extensions =
+        codex_extension_api::ExtensionRegistryBuilder::<codex_core::config::Config>::new();
+    extensions.thread_lifecycle_contributor(Arc::new(IdleNotification(Arc::clone(&idle))));
+    let test = test_codex()
+        .with_model("gpt-5.4")
+        .with_extensions(Arc::new(extensions.build()))
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("leave the terminal running after this turn")
+        .await?;
+    timeout(Duration::from_secs(10), idle.notified()).await?;
+    let before = test.codex.list_background_terminals().await;
+    assert_eq!(before.len(), 1);
+
+    let close_result = test.codex.close_idle_and_shutdown().await;
+    let after = test.codex.list_background_terminals().await;
+    // Ordinary explicit shutdown is cleanup for the test, after observing that the
+    // managed idle operation did not terminate the user's background process.
+    test.codex.shutdown_and_wait().await?;
+    assert!(matches!(
+        close_result,
+        Err(error) if matches!(error.details(), CodexErrorDetails::UnsupportedOperation(_))
+    ));
+    assert_eq!(after, before);
+    Ok(())
+}
