+++ b/codex-rs/app-server/tests/suite/v2/managed_catalog_derived_history.rs
@@ -0,0 +1,154 @@
+//! Open native paginated history even when the source's history DB was lost.
+
+use super::catalog_mixed::legacy_source;
+use super::catalog_mixed::projection;
+use super::*;
+use codex_protocol::ThreadId;
+use codex_state::ReadOnlyThreadState;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn catalog_reads_missing_history_index_with_native_page_parity_and_no_source_repair()
+-> Result<()> {
+    let source_api = responses::start_mock_server().await;
+    let viewer_api = responses::start_mock_server().await;
+    let calls = responses::mount_sse_sequence(
+        &source_api,
+        vec![create_final_assistant_message_sse_response(
+            "Recovered native answer",
+        )?],
+    )
+    .await;
+    let source = ManagedProfile::new(&source_api.uri(), "source-model", "source-token")?;
+    let viewer = ManagedProfile::new(&viewer_api.uri(), "viewer-model", "viewer-token")?;
+    source.write_manifest(&[&source], Vec::new())?;
+    viewer.write_manifest(&[&viewer], Vec::new())?;
+    let mut writer = source.start_server().await?;
+    let canonical = writer
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    complete_turn(
+        &mut writer,
+        &canonical.id,
+        "Create one native fixture answer",
+    )
+    .await?;
+    let request = writer
+        .send_raw_request(
+            "thread/turns/list",
+            Some(json!({
+                "threadId":canonical.id,"limit":10,"itemsView":"full"
+            })),
+        )
+        .await?;
+    let expected: Value = timeout(READ_TIMEOUT, writer.read_response(request)).await??;
+
+    // Seed a separate fixture from the native durable format, retaining its state
+    // metadata but deliberately never initializing a history DB in that source.
+    // This copying is fixture construction, not the production sharing mechanism.
+    let index =
+        ReadOnlyThreadState::open(&SqliteConfig::from_sqlite_home(source.home.path().abs()))
+            .await?;
+    let mut metadata = index
+        .get_thread(ThreadId::from_string(&canonical.id)?)
+        .await?
+        .context("fixture metadata")?;
+    let durable = fs::read(&metadata.rollout_path)?;
+    index.close().await;
+    let old = TempDir::new()?;
+    fs::create_dir(old.path().join("sessions"))?;
+    let path = old.path().join("sessions").join(
+        metadata
+            .rollout_path
+            .file_name()
+            .context("rollout filename")?,
+    );
+    fs::write(&path, &durable)?;
+    metadata.rollout_path = path.clone();
+    let sqlite = SqliteConfig::from_sqlite_home(old.path().abs());
+    let state = codex_state::StateRuntime::init(sqlite.clone(), "fixture".to_string()).await?;
+    state.upsert_thread(&metadata).await?;
+    state.close().await;
+    assert!(!sqlite.thread_history_db_path().exists());
+    let original_state = fs::read(sqlite.state_db_path())?;
+    let descriptor = legacy_source(old.path());
+    let projected = projection(&descriptor, &canonical.id)?;
+    let catalog = viewer.home.path().join("missing-history.json");
+    let inventory = viewer.home.path().join("registered-homes.json");
+    super::catalog_sources::publish(&inventory, &[])?;
+    fs::write(
+        &catalog,
+        serde_json::to_vec(&json!({
+            "version":3,"hostId":"local","sources":[],"legacySources":[descriptor],
+            "managedSourcesPath":inventory
+        }))?,
+    )?;
+    let original_catalog = fs::read(&catalog)?;
+    let mut reader = super::catalog_sources::start_shared(&viewer, &catalog).await?;
+    assert_eq!(
+        super::catalog_sources::list(&mut reader).await?.data[0].id,
+        projected
+    );
+    let request = reader
+        .send_raw_request(
+            "thread/turns/list",
+            Some(json!({
+                "threadId":projected,"limit":10,"itemsView":"full"
+            })),
+        )
+        .await?;
+    let actual: Value = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert_eq!(actual["data"], expected["data"]);
+    assert!(actual.to_string().contains("Recovered native answer"));
+    for method in ["thread/items/list", "thread/timeline/list"] {
+        let request = reader
+            .send_raw_request(method, Some(json!({"threadId":projected,"limit":10})))
+            .await?;
+        let page: Value = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+        assert!(!page["data"].as_array().context("history data")?.is_empty());
+    }
+    // Adding/removing a profile through the referenced inventory must not leave
+    // the previously opened history bound to an obsolete set of source roots.
+    for sources in [&[&source][..], &[][..]] {
+        super::catalog_sources::publish(&inventory, sources)?;
+        timeout(READ_TIMEOUT, async {
+            loop {
+                if super::catalog_sources::list(&mut reader).await?.data.len() == 1 + sources.len()
+                {
+                    break Ok::<(), anyhow::Error>(());
+                }
+                tokio::time::sleep(Duration::from_millis(100)).await;
+            }
+        })
+        .await??;
+        let request = reader
+            .send_raw_request(
+                "thread/turns/list",
+                Some(json!({"threadId":projected,"limit":10,"itemsView":"full"})),
+            )
+            .await?;
+        let page: Value = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+        assert_eq!(page["data"], expected["data"]);
+    }
+    assert_eq!(fs::read(&catalog)?, original_catalog);
+    let request = reader
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert!(loaded.data.is_empty());
+    assert_eq!(fs::read(&path)?, durable);
+    assert_eq!(fs::read(sqlite.state_db_path())?, original_state);
+    assert!(!sqlite.thread_history_db_path().exists());
+    assert_eq!(calls.requests().len(), 1);
+    assert!(
+        viewer_api
+            .received_requests()
+            .await
+            .context("viewer requests")?
+            .iter()
+            .all(|request| !request.url.path().ends_with("/responses"))
+    );
+    Ok(())
+}
