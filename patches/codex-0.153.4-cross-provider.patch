@@ -0,0 +1,450 @@
+//! Content-free check of how much of each model request repeats the previous request of the same
+//! thread.
+//!
+//! Providers cache a prompt by its prefix: the tools and instructions first, then the input items
+//! in order, under the same request parameters. A request that changes an early item, the tools
+//! or the parameters makes every later token a cache miss. This module logs, for every request,
+//! hashes of the request's head (tools and instructions) and of the longest item prefix it shares
+//! with the thread's previous request, and where the two first differ: in the head, in the
+//! parameters, or at which input item and of which kind. Comparing the matched size with the
+//! cached tokens the provider reports separates "our bytes changed" from "the provider's cache
+//! expired".
+//!
+//! When a provider family takes a thread back from the context it last sent, the head that
+//! request sent is expected again ([`expect_request_head`]), and the next request's log line says
+//! whether it matched: the context can be kept byte for byte and still miss the cache if the
+//! tools or instructions changed meanwhile.
+//!
+//! Nothing here reads or logs content: items are hashed, and only their kind (type and role) is
+//! named. Hashes use the standard library's SipHash with fixed keys, so they are stable within one
+//! build, which is all a log reader compares. The previous request of each thread is kept in
+//! memory for the life of the process, so a thread reloaded in the same process compares its
+//! first request with the one it sent before the reload.
+
+use std::collections::HashMap;
+use std::hash::DefaultHasher;
+use std::hash::Hasher;
+use std::sync::LazyLock;
+use std::sync::Mutex;
+
+use codex_protocol::models::ResponseItem;
+use serde::Serialize;
+
+use crate::common::ResponsesApiRequest;
+
+/// Tracing target of the per-request log line.
+pub const PREFIX_CHECK_TARGET: &str = "codex_api::prefix_check";
+
+/// Threads whose previous request is remembered; the least recently used is forgotten first.
+const MAX_THREADS: usize = 256;
+
+/// Hashes of the parts of one request that decide what a prefix cache can serve.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RequestShape {
+    tools: u64,
+    instructions: u64,
+    params: u64,
+    items: Vec<u64>,
+    item_bytes: Vec<u64>,
+    item_kinds: Vec<&'static str>,
+}
+
+impl RequestShape {
+    /// Hashes `request`. Under Responses Lite the tools and instructions travel as the first
+    /// `head_items` input items instead of request fields; they then count as the head and as
+    /// input items.
+    pub fn of(request: &ResponsesApiRequest, head_items: usize) -> Self {
+        let (tools, instructions) = head_hashes(request, head_items);
+        let mut shape = Self {
+            tools,
+            instructions,
+            params: hash_json(&RequestParams::of(request)).0,
+            items: Vec::with_capacity(request.input.len()),
+            item_bytes: Vec::with_capacity(request.input.len()),
+            item_kinds: Vec::with_capacity(request.input.len()),
+        };
+        for item in &request.input {
+            let (hash, bytes) = hash_json(item);
+            shape.items.push(hash);
+            shape.item_bytes.push(bytes);
+            shape.item_kinds.push(item_kind(item));
+        }
+        shape
+    }
+
+    /// Hash of the request's tools and instructions together.
+    pub fn head(&self) -> String {
+        head_hex(self.tools, self.instructions)
+    }
+}
+
+/// Where a request first differs from the thread's previous request.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Divergence {
+    /// The thread's first request in this process.
+    First,
+    /// The same request again, such as a retry.
+    Identical,
+    /// The previous request is a prefix of this one.
+    Appended,
+    /// The tools changed, so nothing after them can be cached.
+    HeadTools,
+    /// The instructions changed.
+    HeadInstructions,
+    /// The model, reasoning, tier, output format or cache key changed.
+    Params,
+    /// An input item of the previous request changed or disappeared.
+    History,
+}
+
+impl Divergence {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::First => "first",
+            Self::Identical => "identical",
+            Self::Appended => "appended",
+            Self::HeadTools => "head_tools",
+            Self::HeadInstructions => "head_instructions",
+            Self::Params => "params",
+            Self::History => "history",
+        }
+    }
+}
+
+/// How one request compares with the previous request of its thread.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PrefixCheck {
+    pub items: usize,
+    pub previous_items: Option<usize>,
+    /// Input items equal to the previous request's, from the start.
+    pub matched_items: usize,
+    /// Serialized size of the matched items, and of all items.
+    pub matched_bytes: u64,
+    pub total_bytes: u64,
+    /// Hash of the matched item prefix.
+    pub prefix_hash: String,
+    pub head: String,
+    pub divergence: Divergence,
+    /// Index of the first input item that differs, and its kind in this request (`"missing"`
+    /// when this request is shorter).
+    pub first_divergence_index: Option<usize>,
+    pub first_divergence_item: Option<&'static str>,
+}
+
+/// Compares `current` with the thread's `previous` request.
+pub fn compare(previous: Option<&RequestShape>, current: &RequestShape) -> PrefixCheck {
+    let matched_items = previous.map_or(0, |previous| {
+        previous
+            .items
+            .iter()
+            .zip(&current.items)
+            .take_while(|(previous, current)| previous == current)
+            .count()
+    });
+    let divergence = match previous {
+        None => Divergence::First,
+        Some(previous) if previous.tools != current.tools => Divergence::HeadTools,
+        Some(previous) if previous.instructions != current.instructions => {
+            Divergence::HeadInstructions
+        }
+        Some(previous) if previous.params != current.params => Divergence::Params,
+        Some(previous) if matched_items < previous.items.len() => Divergence::History,
+        Some(previous) if previous.items.len() == current.items.len() => Divergence::Identical,
+        Some(_) => Divergence::Appended,
+    };
+    // Only a changed or missing item of the previous request breaks the cached prefix; items
+    // appended after it do not.
+    let first_divergence_index = previous
+        .filter(|previous| matched_items < previous.items.len())
+        .map(|_| matched_items);
+    PrefixCheck {
+        items: current.items.len(),
+        previous_items: previous.map(|previous| previous.items.len()),
+        matched_items,
+        matched_bytes: current.item_bytes[..matched_items].iter().sum(),
+        total_bytes: current.item_bytes.iter().sum(),
+        prefix_hash: chain_hex(&current.items[..matched_items]),
+        head: current.head(),
+        divergence,
+        first_divergence_index,
+        first_divergence_item: first_divergence_index
+            .map(|index| current.item_kinds.get(index).copied().unwrap_or("missing")),
+    }
+}
+
+/// Previous request of each thread.
+#[derive(Debug, Default)]
+pub struct PrefixChains {
+    chains: HashMap<String, (u64, RequestShape)>,
+    heads: HashMap<String, String>,
+    /// Heads a thread's next request should send, as recorded when its context was anchored.
+    expected_heads: HashMap<String, String>,
+    next_use: u64,
+}
+
+impl PrefixChains {
+    /// Compares `shape` with the thread's previous request and remembers it as the newest.
+    pub fn observe(&mut self, thread: &str, shape: RequestShape) -> PrefixCheck {
+        let check = compare(self.chains.get(thread).map(|(_, shape)| shape), &shape);
+        self.next_use += 1;
+        self.chains
+            .insert(thread.to_string(), (self.next_use, shape));
+        if self.chains.len() > MAX_THREADS
+            && let Some(oldest) = self
+                .chains
+                .iter()
+                .min_by_key(|(_, (used, _))| *used)
+                .map(|(thread, _)| thread.clone())
+        {
+            self.chains.remove(&oldest);
+            self.heads.remove(&oldest);
+            self.expected_heads.remove(&oldest);
+        }
+        check
+    }
+
+    /// Expects `thread`'s next request to send `head`.
+    pub fn expect_head(&mut self, thread: &str, head: String) {
+        if self.expected_heads.len() >= MAX_THREADS {
+            self.expected_heads.clear();
+        }
+        self.expected_heads.insert(thread.to_string(), head);
+    }
+
+    /// Remembers `head` as `thread`'s newest request head. Returns whether it is the head the
+    /// thread was expected to send, when one was expected.
+    pub fn record_head(&mut self, thread: &str, head: String) -> Option<bool> {
+        let matches = self
+            .expected_heads
+            .remove(thread)
+            .map(|expected| expected == head);
+        self.heads.insert(thread.to_string(), head);
+        matches
+    }
+}
+
+static CHAINS: LazyLock<Mutex<PrefixChains>> = LazyLock::new(Mutex::default);
+
+/// Hash of `request`'s tools and instructions; see [`RequestShape::of`] for `head_items`.
+pub fn request_head(request: &ResponsesApiRequest, head_items: usize) -> String {
+    let (tools, instructions) = head_hashes(request, head_items);
+    head_hex(tools, instructions)
+}
+
+/// Head hash of the newest request sent for `thread` in this process.
+pub fn last_request_head(thread: &str) -> Option<String> {
+    CHAINS
+        .lock()
+        .ok()
+        .and_then(|chains| chains.heads.get(thread).cloned())
+}
+
+/// Expects `thread`'s next request to send `head`, as the request whose context the thread
+/// continues sent it. The next [`observe_request`] logs whether it did: a changed head (tools or
+/// instructions) loses the provider's cached prefix however well the context was kept.
+pub fn expect_request_head(thread: &str, head: String) {
+    if let Ok(mut chains) = CHAINS.lock() {
+        chains.expect_head(thread, head);
+    }
+}
+
+/// Records `request` as `thread`'s newest request and logs how it compares with the previous
+/// one. The head hash is recorded at once; the input items are hashed on a blocking thread when a
+/// Tokio runtime is available, so the request is not held up by hashing its whole history.
+pub fn observe_request(thread: &str, request: ResponsesApiRequest, head_items: usize) {
+    let head = request_head(&request, head_items);
+    let anchor_head_matches = CHAINS
+        .lock()
+        .ok()
+        .and_then(|mut chains| chains.record_head(thread, head));
+    let thread = thread.to_string();
+    let request_kind = request
+        .client_metadata
+        .as_ref()
+        .and_then(|metadata| metadata.get("request_kind"))
+        .map(String::as_str)
+        .map_or("unknown", request_kind_label);
+    let observe = move || {
+        let shape = RequestShape::of(&request, head_items);
+        let Ok(mut chains) = CHAINS.lock() else {
+            return;
+        };
+        let check = chains.observe(&thread, shape);
+        drop(chains);
+        log_check(&thread, request_kind, anchor_head_matches, &check);
+    };
+    match tokio::runtime::Handle::try_current() {
+        Ok(runtime) => {
+            drop(runtime.spawn_blocking(observe));
+        }
+        Err(_) => observe(),
+    }
+}
+
+fn log_check(
+    thread: &str,
+    request_kind: &'static str,
+    anchor_head_matches: Option<bool>,
+    check: &PrefixCheck,
+) {
+    tracing::info!(
+        target: PREFIX_CHECK_TARGET,
+        thread_id = thread,
+        request_kind,
+        anchor_head_matches,
+        items = check.items,
+        previous_items = check.previous_items,
+        matched_items = check.matched_items,
+        matched_bytes = check.matched_bytes,
+        total_bytes = check.total_bytes,
+        prefix_hash = check.prefix_hash.as_str(),
+        head = check.head.as_str(),
+        divergence = check.divergence.as_str(),
+        first_divergence_index = check.first_divergence_index,
+        first_divergence_item = check.first_divergence_item,
+        "prefix check"
+    );
+}
+
+fn request_kind_label(kind: &str) -> &'static str {
+    match kind {
+        "turn" => "turn",
+        "compaction" => "compaction",
+        "prewarm" => "prewarm",
+        "memory" => "memory",
+        _ => "other",
+    }
+}
+
+/// Request fields other than the input, tools and instructions that the provider's cache or
+/// routing depends on.
+#[derive(Serialize)]
+struct RequestParams<'a> {
+    model: &'a str,
+    tool_choice: &'a str,
+    parallel_tool_calls: bool,
+    reasoning: &'a Option<crate::common::Reasoning>,
+    service_tier: &'a Option<String>,
+    prompt_cache_key: &'a Option<String>,
+    text: &'a Option<crate::common::TextControls>,
+    include: &'a [String],
+    store: bool,
+}
+
+impl<'a> RequestParams<'a> {
+    fn of(request: &'a ResponsesApiRequest) -> Self {
+        Self {
+            model: &request.model,
+            tool_choice: &request.tool_choice,
+            parallel_tool_calls: request.parallel_tool_calls,
+            reasoning: &request.reasoning,
+            service_tier: &request.service_tier,
+            prompt_cache_key: &request.prompt_cache_key,
+            text: &request.text,
+            include: &request.include,
+            store: request.store,
+        }
+    }
+}
+
+fn head_hashes(request: &ResponsesApiRequest, head_items: usize) -> (u64, u64) {
+    let lite_tools =
+        request
+            .input
+            .first()
+            .filter(|_| head_items >= 1)
+            .and_then(|item| match item {
+                ResponseItem::AdditionalTools { tools, .. } => Some(hash_json(tools).0),
+                _ => None,
+            });
+    let tools = match (&request.tools, lite_tools) {
+        (Some(tools), _) => hash_json(tools).0,
+        (None, Some(tools)) => tools,
+        (None, None) => 0,
+    };
+    let lite_instructions = request
+        .input
+        .get(1)
+        .filter(|_| head_items >= 2)
+        .map(|item| hash_json(item).0);
+    let instructions = match lite_instructions {
+        Some(instructions) => instructions,
+        None if request.instructions.is_empty() => 0,
+        None => hash_json(&request.instructions).0,
+    };
+    (tools, instructions)
+}
+
+fn head_hex(tools: u64, instructions: u64) -> String {
+    chain_hex(&[tools, instructions])
+}
+
+fn chain_hex(hashes: &[u64]) -> String {
+    let mut hasher = DefaultHasher::new();
+    for hash in hashes {
+        hasher.write_u64(*hash);
+    }
+    format!("{:016x}", hasher.finish())
+}
+
+/// Hashes a value's JSON form and returns its size in bytes.
+fn hash_json(value: &impl Serialize) -> (u64, u64) {
+    let mut writer = HashWriter {
+        hasher: DefaultHasher::new(),
+        bytes: 0,
+    };
+    if serde_json::to_writer(&mut writer, value).is_err() {
+        return (0, 0);
+    }
+    (writer.hasher.finish(), writer.bytes)
+}
+
+struct HashWriter {
+    hasher: DefaultHasher,
+    bytes: u64,
+}
+
+impl std::io::Write for HashWriter {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.hasher.write(buf);
+        self.bytes += u64::try_from(buf.len()).unwrap_or(u64::MAX);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+/// Names an item's kind without reading its content.
+fn item_kind(item: &ResponseItem) -> &'static str {
+    match item {
+        ResponseItem::Message { role, .. } => match role.as_str() {
+            "user" => "message:user",
+            "assistant" => "message:assistant",
+            "developer" => "message:developer",
+            "system" => "message:system",
+            _ => "message",
+        },
+        ResponseItem::AdditionalTools { .. } => "additional_tools",
+        ResponseItem::AgentMessage { .. } => "agent_message",
+        ResponseItem::Reasoning { .. } => "reasoning",
+        ResponseItem::LocalShellCall { .. } => "local_shell_call",
+        ResponseItem::FunctionCall { .. } => "function_call",
+        ResponseItem::ToolSearchCall { .. } => "tool_search_call",
+        ResponseItem::FunctionCallOutput { .. } => "function_call_output",
+        ResponseItem::CustomToolCall { .. } => "custom_tool_call",
+        ResponseItem::CustomToolCallOutput { .. } => "custom_tool_call_output",
+        ResponseItem::ToolSearchOutput { .. } => "tool_search_output",
+        ResponseItem::WebSearchCall { .. } => "web_search_call",
+        ResponseItem::ImageGenerationCall { .. } => "image_generation_call",
+        ResponseItem::Compaction { .. } => "compaction",
+        ResponseItem::CompactionTrigger {} => "compaction_trigger",
+        ResponseItem::ContextCompaction { .. } => "context_compaction",
+        ResponseItem::Other => "other",
+    }
+}
+
