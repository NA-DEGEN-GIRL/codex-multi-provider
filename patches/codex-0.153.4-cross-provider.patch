@@ -0,0 +1,111 @@
+//! Recorder locks follow the background writer, including failed initialization cleanup.
+use std::io;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+use tokio::sync::watch;
+
+#[derive(Clone, Copy, Eq, PartialEq)]
+enum Completion {
+    Running,
+    Stopped,
+    Uncertain,
+}
+
+pub(super) struct WriterLifetime {
+    resources: Mutex<Option<Vec<Arc<dyn Send + Sync>>>>,
+    completion: watch::Sender<Completion>,
+}
+
+pub(super) struct WriterLifetimeGuard {
+    lifetime: Arc<WriterLifetime>,
+    stopped: bool,
+}
+
+impl WriterLifetime {
+    pub(super) fn new() -> Self {
+        Self {
+            resources: Mutex::new(Some(Vec::new())),
+            completion: watch::channel(Completion::Running).0,
+        }
+    }
+
+    pub(super) fn retain(&self, resources: Arc<dyn Send + Sync>) -> io::Result<()> {
+        let mut held = self
+            .resources
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if *self.completion.borrow() != Completion::Running {
+            return Err(io::Error::other(
+                "rollout writer stopped before resources were attached",
+            ));
+        }
+        held.as_mut()
+            .ok_or_else(|| io::Error::other("rollout writer resources were released"))?
+            .push(resources);
+        Ok(())
+    }
+
+    pub(super) fn actor_guard(self: &Arc<Self>) -> WriterLifetimeGuard {
+        WriterLifetimeGuard {
+            lifetime: Arc::clone(self),
+            stopped: false,
+        }
+    }
+
+    pub(super) async fn wait_stopped(&self) -> io::Result<()> {
+        let mut completion = self.completion.subscribe();
+        let state = *completion
+            .wait_for(|state| *state != Completion::Running)
+            .await
+            .map_err(|_| io::Error::other("rollout writer completion is unavailable"))?;
+        match state {
+            Completion::Stopped => Ok(()),
+            Completion::Uncertain => Err(io::Error::other(
+                "rollout writer termination is uncertain; its locks remain fenced",
+            )),
+            Completion::Running => Err(io::Error::other("rollout writer is still running")),
+        }
+    }
+}
+
+impl WriterLifetimeGuard {
+    pub(super) fn stopped(mut self) {
+        let held = self
+            .lifetime
+            .resources
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take();
+        drop(held);
+        self.lifetime.completion.send_replace(Completion::Stopped);
+        self.stopped = true;
+    }
+}
+
+impl Drop for WriterLifetimeGuard {
+    fn drop(&mut self) {
+        if !self.stopped {
+            self.lifetime.completion.send_replace(Completion::Uncertain);
+            // An aborted future can leave blocking filesystem work alive. Deliberately keep
+            // its lock resources until this process exits; dropping handles is not close proof.
+            if self
+                .lifetime
+                .resources
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .as_ref()
+                .is_some_and(|held| !held.is_empty())
+            {
+                std::mem::forget(Arc::clone(&self.lifetime));
+                tracing::error!(
+                    "rollout writer exited without checked termination; retained resource tombstone"
+                );
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "recorder_writer_lifetime_tests.rs"]
+mod tests;
