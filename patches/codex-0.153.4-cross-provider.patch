+//! Native discovery from source homes, without a client-side record collector.
+
+use super::*;
+use codex_app_server_protocol::ManagedRecordOrigin;
+use codex_app_server_protocol::ThreadExtra;
+use codex_app_server_protocol::ThreadListResponse;
+use codex_app_server_protocol::ThreadNameUpdatedNotification;
+use codex_app_server_protocol::ThreadStartedNotification;
+use pretty_assertions::assert_eq;
+
+pub(super) fn publish(path: &std::path::Path, sources: &[&ManagedProfile]) -> Result<()> {
+    let sources = sources.iter().map(|source| json!({
+        "hostId": "local", "sourceStoreId": source.source_id, "codexHome": source.home.path(),
+    })).collect::<Vec<_>>();
+    let mut file = NamedTempFile::new_in(path.parent().context("catalog parent")?)?;
+    file.write_all(&serde_json::to_vec(
+        &json!({"version":2,"hostId":"local","sources":sources}),
+    )?)?;
+    file.persist(path)?;
+    Ok(())
+}
+
+pub(super) async fn start_shared(
+    profile: &ManagedProfile,
+    catalog: &std::path::Path,
+) -> Result<TestAppServer> {
+    TestAppServer::builder()
+        .with_codex_home(profile.home.path())
+        .without_managed_config()
+        .with_env_overrides(&[
+            (
+                "CODEX_MANAGER_MANAGED_SOURCES",
+                profile.manifest_path.to_str(),
+            ),
+            ("CODEX_MANAGER_SHARED_CATALOG", catalog.to_str()),
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            ("CODEX_MANAGED_HANDOFF_TEST_KEY", Some(&profile.api_key)),
+            ("CODEX_SQLITE_HOME", None),
+            ("OPENAI_API_KEY", None),
+            ("CODEX_ACCESS_TOKEN", None),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await
+}
+
+pub(super) async fn list(server: &mut TestAppServer) -> Result<ThreadListResponse> {
+    let request = server
+        .send_raw_request("thread/list", Some(json!({})))
+        .await?;
+    timeout(READ_TIMEOUT, server.read_response(request)).await?
+}
+
+#[tokio::test]
+async fn source_catalog_discovers_new_records_names_and_replies_without_republishing_entries()
+-> Result<()> {
+    let source_api = responses::start_mock_server().await;
+    let viewer_api = responses::start_mock_server().await;
+    let model_calls = responses::mount_sse_sequence(
+        &source_api,
+        vec![
+            create_final_assistant_message_sse_response("First source answer")?,
+            create_final_assistant_message_sse_response("Later source answer")?,
+        ],
+    )
+    .await;
+    let source = ManagedProfile::new(&source_api.uri(), "source-model", "source-token")?;
+    let viewer = ManagedProfile::new(&viewer_api.uri(), "viewer-model", "viewer-token")?;
+    source.write_manifest(&[&source], Vec::new())?;
+    viewer.write_manifest(&[&source, &viewer], Vec::new())?;
+    let catalog = viewer.home.path().join("source-catalog.json");
+    publish(&catalog, &[&source, &viewer])?;
+    let original_catalog = fs::read(&catalog)?;
+    let mut owner = source.start_server().await?;
+    let mut reader = start_shared(&viewer, &catalog).await?;
+    assert!(list(&mut reader).await?.data.is_empty());
+    let canonical = owner
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    complete_turn(
+        &mut owner,
+        &canonical.id,
+        "Create a record after the viewer listed",
+    )
+    .await?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_notification_message("thread/started"),
+    )
+    .await??;
+    let started: ThreadStartedNotification =
+        serde_json::from_value(notification.params.context("new record")?)?;
+    assert_ne!(started.thread.id, canonical.id);
+    assert_eq!(
+        started.thread.extra,
+        Some(ThreadExtra {
+            managed_record: Some(ManagedRecordOrigin {
+                host_id: "local".to_string(),
+                source_store_id: source.source_id.clone(),
+                canonical_thread_id: canonical.id.clone(),
+            }),
+        })
+    );
+    assert_eq!(started.thread.can_accept_direct_input, Some(false));
+    assert_eq!(started.thread.path, None);
+    super::names::rename(&mut owner, &canonical.id, "SSH 공통 작업 이름").await?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_notification_message("thread/name/updated"),
+    )
+    .await??;
+    let renamed: ThreadNameUpdatedNotification =
+        serde_json::from_value(notification.params.context("name update")?)?;
+    assert_eq!(
+        renamed,
+        ThreadNameUpdatedNotification {
+            thread_id: started.thread.id.clone(),
+            thread_name: Some("SSH 공통 작업 이름".to_string()),
+        }
+    );
+    let request = reader
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert!(loaded.data.is_empty());
+    let read = owner
+        .send_raw_request("thread/read", Some(json!({"threadId":canonical.id})))
+        .await?;
+    let stored: ThreadReadResponse = timeout(READ_TIMEOUT, owner.read_response(read)).await??;
+    assert_eq!(stored.thread.extra, None);
+    let rollout = stored.thread.path.context("canonical rollout")?;
+    let original_bytes = fs::read(&rollout)?;
+    let request = reader
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: started.thread.id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let resumed: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert_eq!(resumed.thread.extra, started.thread.extra);
+    assert_eq!(resumed.thread.name.as_deref(), Some("SSH 공통 작업 이름"));
+    assert_eq!(fs::read(&rollout)?, original_bytes);
+    complete_turn(&mut owner, &canonical.id, "Append a later answer").await?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let completed: TurnCompletedNotification =
+        serde_json::from_value(notification.params.context("later completion")?)?;
+    assert_eq!(completed.thread_id, started.thread.id);
+    assert_eq!(completed.turn.status, TurnStatus::Completed);
+    assert_eq!(fs::read(&catalog)?, original_catalog);
+    assert_eq!(model_calls.requests().len(), 2);
+    assert!(
+        viewer_api
+            .received_requests()
+            .await
+            .context("viewer requests")?
+            .iter()
+            .all(|request| !request.url.path().ends_with("/responses"))
+    );
+    Ok(())
+}
