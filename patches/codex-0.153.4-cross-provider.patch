+//! Keep startup and loaded native work independent from shared history discovery.
+
+use super::CATALOG_ENV;
+use super::RecordCatalog;
+use super::SHARED_CATALOG_ENV;
+use super::has_thread_reference;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_core::ThreadManager;
+use codex_protocol::ThreadId;
+use serde_json::Value;
+
+impl RecordCatalog {
+    pub(crate) async fn guard_request(
+        request: &ClientRequest,
+        thread_manager: &ThreadManager,
+    ) -> Result<(), JSONRPCErrorError> {
+        if std::env::var_os(CATALOG_ENV).is_none() && std::env::var_os(SHARED_CATALOG_ENV).is_some()
+        {
+            let value = serde_json::to_value(request).map_err(|error| {
+                crate::error_code::invalid_request(format!(
+                    "cannot inspect shared record request: {error}"
+                ))
+            })?;
+            // A shared catalog only restricts operations referencing records.
+            // Its list/read handlers load the catalog themselves. Unrelated
+            // startup, configuration and account requests must not wait on a
+            // foreign database or fail because that source is unavailable.
+            if !has_thread_reference(&value) {
+                return Ok(());
+            }
+            let native_id = match request {
+                ClientRequest::TurnStart { params, .. } => Some(&params.thread_id),
+                ClientRequest::TurnSteer { params, .. } => Some(&params.thread_id),
+                ClientRequest::TurnInterrupt { params, .. } => Some(&params.thread_id),
+                ClientRequest::TurnSettingsUpdate { params, .. } => Some(&params.thread_id),
+                ClientRequest::ThreadInjectItems { params, .. } => Some(&params.thread_id),
+                ClientRequest::ThreadRealtimeStart { params, .. } => Some(&params.thread_id),
+                ClientRequest::ThreadRealtimeAppendAudio { params, .. } => Some(&params.thread_id),
+                ClientRequest::ThreadRealtimeAppendText { params, .. } => Some(&params.thread_id),
+                ClientRequest::ThreadRealtimeAppendSpeech { params, .. } => Some(&params.thread_id),
+                ClientRequest::ThreadRealtimeStop { params, .. } => Some(&params.thread_id),
+                _ => None,
+            };
+            if let Some(native_id) = native_id
+                && let Ok(thread_id) = ThreadId::from_string(native_id)
+                && all_thread_references_match(&value, native_id)
+                && thread_manager.get_thread(thread_id).await.is_ok()
+            {
+                // This lookup only checks an existing native actor; it never
+                // resumes a record or creates an actor for a catalog projection.
+                // Native permissions, writer ownership and shutdown gates still
+                // run after this guard. A foreign discovery failure must not
+                // prevent input or interruption of this already loaded task.
+                return Ok(());
+            }
+        }
+        if let Some(catalog) = Self::from_environment().await? {
+            catalog.guard(request)?;
+        }
+        Ok(())
+    }
+}
+
+fn all_thread_references_match(value: &Value, native_id: &str) -> bool {
+    match value {
+        Value::Object(object) => object.iter().all(|(key, value)| {
+            if matches!(
+                key.as_str(),
+                "threadId"
+                    | "threadIds"
+                    | "conversationId"
+                    | "beforeThreadId"
+                    | "parentThreadId"
+                    | "ancestorThreadId"
+            ) {
+                match value {
+                    Value::Null => true,
+                    Value::String(id) => id == native_id,
+                    Value::Array(values) => {
+                        values.iter().all(|value| value.as_str() == Some(native_id))
+                    }
+                    _ => false,
+                }
+            } else {
+                all_thread_references_match(value, native_id)
+            }
+        }),
+        Value::Array(values) => values
+            .iter()
+            .all(|value| all_thread_references_match(value, native_id)),
+        _ => true,
+    }
+}
diff --git a/codex-rs/app-server/src/manager_catalog_index.rs b/codex-rs/app-server/src/manager_catalog_index.rs
new file mode 100644
index 000000000..33f4e503c
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_index.rs
@@ -0,0 +1,40 @@
+//! Choose the registered history index independently of physical rollout ownership.
+
+use std::sync::Arc;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_thread_store::ReadOnlyLocalThreadStore;
+
+use super::RecordCatalog;
+use super::RecordSource;
+use super::history;
+
+impl RecordCatalog {
+    pub(super) async fn record_index(
+        &self,
+        source: &RecordSource,
+    ) -> Result<Option<Arc<ReadOnlyLocalThreadStore>>, JSONRPCErrorError> {
+        let home = self.validated_home(source).await?;
+        let own = self.read_only_store(&home).await?;
+        if let Some(store) = &own
+            && store
+                .read_metadata(source.thread_id)
+                .await
+                .map_err(history::store_error)?
+                .is_some()
+        {
+            return Ok(own);
+        }
+        // Some profiles share session files but keep their native history index
+        // separately. Discovery identifies a registered metadata source; opening
+        // and reading it still enforce database roots and checkpoint coverage.
+        let backend = self.discovered.as_ref().and_then(|data| {
+            let source_id = data.summary_sources.get(&source.projection_thread_id)?;
+            data.registered_homes.get(source_id)
+        });
+        match backend {
+            Some(backend) if backend != &home => self.read_only_store(backend).await,
+            Some(_) | None => Ok(own),
+        }
+    }
+}
diff --git a/codex-rs/app-server/src/manager_catalog_legacy.rs b/codex-rs/app-server/src/manager_catalog_legacy.rs
new file mode 100644
index 000000000..b742e959e
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_legacy.rs
@@ -0,0 +1,144 @@
+//! Discover unindexed legacy records by reading bounded session headers only.
+
+use std::collections::HashSet;
+use std::path::Path;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_protocol::ThreadId;
+use serde::Deserialize;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncReadExt;
+use tokio::io::BufReader;
+use uuid::Uuid;
+
+use super::RecordSource;
+use super::sources::SourceHome;
+use crate::error_code::invalid_request;
+
+const MAX_HEADER_BYTES: u64 = 1024 * 1024;
+const MAX_PATHS: usize = 32768;
+const PROJECTION_NAMESPACE: Uuid = Uuid::from_u128(0x14a0f21bb52945fcbd9eb07637424fa3);
+
+#[derive(Deserialize)]
+struct Header {
+    id: ThreadId,
+    #[serde(default, alias = "historyMode")]
+    history_mode: Option<String>,
+}
+
+pub(super) async fn read_headers(
+    source: &SourceHome,
+    home: &Path,
+    indexed_projections: &HashSet<ThreadId>,
+    entries: &mut Vec<RecordSource>,
+) -> Result<(), JSONRPCErrorError> {
+    let mut directories = Vec::new();
+    for name in ["sessions", "archived_sessions"] {
+        let path = home.join(name);
+        match tokio::fs::symlink_metadata(&path).await {
+            Ok(metadata) if metadata.is_dir() => directories.push(path),
+            // Shared llm-usage links are enumerated under their canonical home.
+            Ok(metadata) if metadata.is_symlink() => {}
+            Ok(_) => return Err(invalid_request("legacy session root is not a directory")),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(invalid_request(format!("legacy root unavailable: {error}"))),
+        }
+    }
+    let mut visited = 0;
+    let mut identities = HashSet::new();
+    while let Some(directory) = directories.pop() {
+        let mut files = tokio::fs::read_dir(directory)
+            .await
+            .map_err(|error| invalid_request(format!("legacy directory unavailable: {error}")))?;
+        while let Some(file) = files
+            .next_entry()
+            .await
+            .map_err(|error| invalid_request(error.to_string()))?
+        {
+            visited += 1;
+            if visited > MAX_PATHS {
+                return Err(invalid_request("legacy discovery exceeds its path limit"));
+            }
+            let kind = file
+                .file_type()
+                .await
+                .map_err(|error| invalid_request(error.to_string()))?;
+            let path = file.path();
+            if kind.is_dir() {
+                directories.push(path);
+                continue;
+            }
+            if !kind.is_file()
+                || path
+                    .extension()
+                    .is_none_or(|extension| extension != "jsonl")
+            {
+                continue;
+            }
+            let path = tokio::fs::canonicalize(path)
+                .await
+                .map_err(|error| invalid_request(error.to_string()))?;
+            if !path.starts_with(home.join("sessions"))
+                && !path.starts_with(home.join("archived_sessions"))
+            {
+                return Err(invalid_request("legacy record escapes its registered home"));
+            }
+            let file = tokio::fs::File::open(&path)
+                .await
+                .map_err(|error| invalid_request(format!("legacy header unavailable: {error}")))?;
+            let mut lines = BufReader::new(file.take(MAX_HEADER_BYTES)).lines();
+            let mut header = None;
+            for _ in 0..8 {
+                let Some(line) = lines
+                    .next_line()
+                    .await
+                    .map_err(|error| invalid_request(error.to_string()))?
+                else {
+                    break;
+                };
+                let Ok(value) = serde_json::from_str::<serde_json::Value>(&line) else {
+                    continue;
+                };
+                if value.get("type").and_then(serde_json::Value::as_str) == Some("session_meta") {
+                    header = serde_json::from_value::<Header>(value["payload"].clone()).ok();
+                    break;
+                }
+            }
+            let Some(header) = header else {
+                return Err(invalid_request(
+                    "legacy record has no valid bounded session header",
+                ));
+            };
+            let key = format!("local\0{}\0{}", source.source_store_id, header.id);
+            let projection = Uuid::new_v5(&PROJECTION_NAMESPACE, key.as_bytes());
+            let projection_thread_id = ThreadId::from_string(&projection.to_string())
+                .map_err(|error| invalid_request(error.to_string()))?;
+            if indexed_projections.contains(&projection_thread_id) {
+                continue;
+            }
+            if header
+                .history_mode
+                .as_deref()
+                .is_some_and(|mode| mode != "legacy")
+            {
+                return Err(invalid_request(
+                    "unindexed paginated history needs its source database",
+                ));
+            }
+            if !identities.insert(header.id) {
+                return Err(invalid_request(
+                    "unindexed legacy thread has ambiguous rollout paths",
+                ));
+            }
+            entries.push(RecordSource {
+                projection_thread_id,
+                thread_id: header.id,
+                host_id: source.host_id.clone(),
+                source_store_id: source.source_store_id.clone(),
+                codex_home: home.to_path_buf(),
+                rollout_path: path,
+            });
+        }
+    }
+    Ok(())
+}
diff --git a/codex-rs/app-server/src/manager_catalog_list_watch.rs b/codex-rs/app-server/src/manager_catalog_list_watch.rs
new file mode 100644
index 000000000..95aa0e760
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_list_watch.rs
@@ -0,0 +1,274 @@
+//! Publish common-record membership through native notifications after listing.
+//!
+//! Notifications use the same identity and input rules as the list response:
+//! projections in viewer mode, canonical tasks in shared execution mode.
+//! The manifest tracks membership; a bounded metadata batch refreshes the names
+//! already delivered to this connection. Failed reads are retried without
+//! discarding the last valid list, and each connection owns its subscription.
+
+use std::collections::BTreeMap;
+use std::collections::HashMap;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::Duration;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::Thread;
+use codex_app_server_protocol::ThreadArchivedNotification;
+use codex_app_server_protocol::ThreadDeletedNotification;
+use codex_app_server_protocol::ThreadStartedNotification;
+use codex_app_server_protocol::ThreadUnarchivedNotification;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use futures::StreamExt;
+use tokio::sync::Mutex;
+use tokio::sync::oneshot;
+use tokio::task::JoinHandle;
+use tokio_util::sync::CancellationToken;
+
+use super::RecordCatalog;
+use super::RecordSource;
+use super::names::CatalogNames;
+use crate::error_code::invalid_request;
+use crate::outgoing_message::ConnectionId;
+use crate::outgoing_message::OutgoingMessageSender;
+use crate::request_processors::thread_from_stored_thread;
+
+const MAX_CONNECTIONS: usize = 64;
+const MAX_UPDATES: usize = 64;
+
+struct Watch {
+    cancel: CancellationToken,
+    task: JoinHandle<()>,
+    names: Arc<CatalogNames>,
+}
+
+#[derive(Default)]
+pub(crate) struct CatalogListWatches {
+    tasks: Mutex<HashMap<ConnectionId, Watch>>,
+}
+
+async fn entries(
+    catalog: &RecordCatalog,
+    native_home: &Path,
+) -> Result<BTreeMap<String, RecordSource>, JSONRPCErrorError> {
+    let native_home = if catalog.is_shared() {
+        Some(
+            tokio::fs::canonicalize(native_home)
+                .await
+                .map_err(|error| {
+                    invalid_request(format!("native catalog home unavailable: {error}"))
+                })?,
+        )
+    } else {
+        None
+    };
+    let mut result = BTreeMap::new();
+    for source in catalog.entries.iter() {
+        if !catalog.shared_routes.includes(source) {
+            continue;
+        }
+        if native_home.as_ref().is_some_and(|home| {
+            catalog
+                .canonical_homes
+                .get()
+                .and_then(|homes| homes.get(&source.codex_home))
+                == Some(home)
+        }) {
+            continue;
+        }
+        let id = if super::execution::enabled() && !catalog.shared_routes.projects(source) {
+            source.thread_id
+        } else {
+            source.projection_thread_id
+        };
+        result.insert(id.to_string(), source.clone());
+    }
+    Ok(result)
+}
+
+impl CatalogListWatches {
+    pub(crate) async fn start(
+        &self,
+        connection: ConnectionId,
+        catalog: &RecordCatalog,
+        native_home: PathBuf,
+        listed: &[Thread],
+        cwd: AbsolutePathBuf,
+        outgoing: Arc<OutgoingMessageSender>,
+    ) -> Result<Option<oneshot::Sender<()>>, JSONRPCErrorError> {
+        let mut known = entries(catalog, &native_home).await?;
+        let mut tasks = self.tasks.lock().await;
+        tasks.retain(|_, watch| !watch.task.is_finished());
+        if let Some(watch) = tasks.get(&connection) {
+            watch.names.observe_listing(&known, listed);
+            return Ok(None);
+        }
+        if tasks.len() >= MAX_CONNECTIONS {
+            return Err(invalid_request("too many common-list subscriptions"));
+        }
+        let (ready, wait) = oneshot::channel();
+        let cancel = CancellationToken::new();
+        let token = cancel.clone();
+        let names = Arc::new(CatalogNames::default());
+        names.observe_listing(&known, listed);
+        let watched_names = Arc::clone(&names);
+        let task = tokio::spawn(async move {
+            tokio::select! {
+                _ = token.cancelled() => return,
+                result = wait => if result.is_err() { return; },
+            }
+            let connections = [connection];
+            let mut after = None;
+            let mut name_after = None;
+            loop {
+                tokio::select! {
+                    _ = token.cancelled() => return,
+                    _ = tokio::time::sleep(Duration::from_secs(2)) => {},
+                }
+                let update = async {
+                    let catalog = RecordCatalog::from_environment()
+                        .await?
+                        .ok_or_else(|| invalid_request("common list is no longer available"))?;
+                    let current = entries(&catalog, &native_home).await?;
+                    let pending = current
+                        .iter()
+                        .filter(|(id, source)| known.get(*id) != Some(*source))
+                        .collect::<Vec<_>>();
+                    // Rotate the bounded batch so an unreadable new record cannot
+                    // permanently starve later additions.
+                    let start = after
+                        .as_ref()
+                        .and_then(|after| pending.iter().position(|(id, _)| *id > after))
+                        .unwrap_or(0);
+                    let batch = pending
+                        .iter()
+                        .cycle()
+                        .skip(start)
+                        .take(pending.len().min(MAX_UPDATES))
+                        .map(|(id, source)| ((*id).clone(), (*source).clone()))
+                        .collect::<Vec<_>>();
+                    let next_after = batch.last().map(|(id, _)| id.clone());
+                    let catalog = &catalog;
+                    let cwd = &cwd;
+                    let changes = batch.into_iter().map(|(id, source)| async move {
+                        let stored = catalog.summary(&source).await?;
+                        let archived = stored.archived_at.is_some();
+                        let (mut thread, _) = thread_from_stored_thread(stored, "openai", cwd);
+                        if !super::execution::enabled() || catalog.shared_routes.projects(&source) {
+                            thread.can_accept_direct_input = Some(false);
+                            thread.path = None;
+                            thread.extra = Some(source.origin());
+                        }
+                        Ok::<_, JSONRPCErrorError>((id, source, thread, archived))
+                    });
+                    let changes = futures::stream::iter(changes)
+                        .buffer_unordered(16)
+                        .collect::<Vec<_>>()
+                        .await;
+                    let (name_changes, next_name_after) = watched_names
+                        .changes(catalog, &current, name_after.as_deref())
+                        .await;
+                    Ok::<_, JSONRPCErrorError>((
+                        current,
+                        changes,
+                        next_after,
+                        name_changes,
+                        next_name_after,
+                    ))
+                };
+                let result = tokio::select! {
+                    _ = token.cancelled() => return,
+                    result = tokio::time::timeout(Duration::from_secs(10), update) => result,
+                };
+                let Ok(Ok((current, changes, next_after, name_changes, next_name_after))) = result
+                else {
+                    continue;
+                };
+                after = next_after;
+                name_after = next_name_after;
+                let mut notifications = name_changes;
+                for id in known.keys().filter(|id| !current.contains_key(*id)) {
+                    // The task left this catalog. Only the client's cached
+                    // entry is removed; no stored record is deleted.
+                    notifications.push(ServerNotification::ThreadDeleted(
+                        ThreadDeletedNotification {
+                            thread_id: id.to_string(),
+                        },
+                    ));
+                }
+                known.retain(|id, _| current.contains_key(id));
+                for (id, source, thread, archived) in changes.into_iter().flatten() {
+                    if known.get(&id).is_some_and(|previous| {
+                        previous.thread_id != source.thread_id
+                            || previous.source_store_id != source.source_store_id
+                            || previous.host_id != source.host_id
+                            || previous.codex_home != source.codex_home
+                    }) {
+                        // Never overwrite cached history with another canonical
+                        // identity that reuses an existing projection ID.
+                        continue;
+                    }
+                    if archived {
+                        if known.contains_key(&id) {
+                            notifications.push(ServerNotification::ThreadArchived(
+                                ThreadArchivedNotification {
+                                    thread_id: id.to_string(),
+                                },
+                            ));
+                        }
+                    } else {
+                        watched_names.observe_listing(&current, std::slice::from_ref(&thread));
+                        notifications.push(ServerNotification::ThreadStarted(
+                            ThreadStartedNotification { thread },
+                        ));
+                        if known.get(&id).is_some_and(|previous| {
+                            previous
+                                .rollout_path
+                                .starts_with(previous.codex_home.join("archived_sessions"))
+                        }) {
+                            notifications.push(ServerNotification::ThreadUnarchived(
+                                ThreadUnarchivedNotification {
+                                    thread_id: id.to_string(),
+                                },
+                            ));
+                        }
+                    }
+                    known.insert(id, source);
+                }
+                for notification in notifications {
+                    tokio::select! {
+                        _ = token.cancelled() => return,
+                        _ = outgoing.send_server_notification_to_connections(&connections, notification) => {},
+                    }
+                }
+            }
+        });
+        tasks.insert(
+            connection,
+            Watch {
+                cancel,
+                task,
+                names,
+            },
+        );
+        Ok(Some(ready))
+    }
+
+    pub(crate) async fn close_connection(&self, connection: ConnectionId) {
+        let watch = self.tasks.lock().await.remove(&connection);
+        if let Some(watch) = watch {
+            watch.cancel.cancel();
+            let _ = watch.task.await;
+        }
+    }
+}
+
+impl Drop for CatalogListWatches {
+    fn drop(&mut self) {
+        for (_, watch) in self.tasks.get_mut().drain() {
+            watch.cancel.cancel();
+        }
+    }
+}
diff --git a/codex-rs/app-server/src/manager_catalog_metadata.rs b/codex-rs/app-server/src/manager_catalog_metadata.rs
new file mode 100644
index 000000000..04d8db109
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_metadata.rs
@@ -0,0 +1,97 @@
+//! Metadata-only discovery snapshots. Selected records still use validated reads.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::Thread;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::SubAgentSource;
+use codex_thread_store::StoredThread;
+
+use super::RecordCatalog;
+use super::RecordSource;
+
+#[derive(Default)]
+pub(super) struct DiscoveredMetadata {
+    pub(super) scope_revision: String,
+    pub(super) summaries: HashMap<ThreadId, StoredThread>,
+    pub(super) summary_sources: HashMap<ThreadId, String>,
+    pub(super) registered_homes: HashMap<String, PathBuf>,
+    pub(super) projections: HashMap<(String, ThreadId), ThreadId>,
+    pub(super) listings: Mutex<HashMap<String, Arc<Vec<Thread>>>>,
+}
+
+impl RecordCatalog {
+    pub(super) async fn summary(
+        &self,
+        source: &RecordSource,
+    ) -> Result<StoredThread, JSONRPCErrorError> {
+        if let Some(stored) = self
+            .discovered
+            .as_ref()
+            .and_then(|data| data.summaries.get(&source.projection_thread_id))
+        {
+            return Ok(self.project_metadata(source, stored.clone()));
+        }
+        self.stored(source, /*include_turns*/ false).await
+    }
+
+    pub(super) fn project_metadata(
+        &self,
+        source: &RecordSource,
+        mut stored: StoredThread,
+    ) -> StoredThread {
+        self.project_aliases.apply(source, &mut stored);
+        if self.is_shared() && super::execution::enabled() && !self.shared_routes.projects(source) {
+            return stored;
+        }
+        let project = |id| {
+            if let Some(data) = &self.discovered {
+                data.projections
+                    .get(&(source.source_store_id.clone(), id))
+                    .copied()
+            } else {
+                self.entries
+                    .iter()
+                    .find(|candidate| {
+                        candidate.host_id == source.host_id
+                            && candidate.source_store_id == source.source_store_id
+                            && candidate.thread_id == id
+                    })
+                    .map(|candidate| candidate.projection_thread_id)
+            }
+        };
+        stored.thread_id = source.projection_thread_id;
+        for relation in [&mut stored.parent_thread_id, &mut stored.forked_from_id] {
+            *relation = relation.and_then(project);
+        }
+        if let SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id,
+            agent_nickname,
+            agent_role,
+            ..
+        }) = &mut stored.source
+        {
+            if let Some(parent) = project(*parent_thread_id) {
+                *parent_thread_id = parent;
+            } else {
+                // Existing child records may outlive their parent. Keep a
+                // generic subagent origin and visible identity, but never put
+                // a raw canonical parent ID into a native navigation field.
+                if stored.agent_nickname.is_none() {
+                    stored.agent_nickname = agent_nickname.clone();
+                }
+                if stored.agent_role.is_none() {
+                    stored.agent_role = agent_role.clone();
+                }
+                stored.source =
+                    SessionSource::SubAgent(SubAgentSource::Other("thread_spawn".to_string()));
+            }
+        }
+        stored
+    }
+}
diff --git a/codex-rs/app-server/src/manager_catalog_names.rs b/codex-rs/app-server/src/manager_catalog_names.rs
new file mode 100644
index 000000000..a3479b659
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_names.rs
@@ -0,0 +1,111 @@
+//! Refresh names already delivered to a native catalog connection.
+//!
+//! A bounded rotating batch uses the same canonical reader as thread/read. Name
+//! notifications do not replace a cached conversation or reopen its history.
+
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::Thread;
+use codex_app_server_protocol::ThreadNameUpdatedNotification;
+use futures::StreamExt;
+
+use super::RecordCatalog;
+use super::RecordSource;
+
+const MAX_NAMES_PER_POLL: usize = 256;
+
+#[derive(Clone, PartialEq)]
+struct KnownName {
+    source: RecordSource,
+    name: Option<String>,
+}
+
+#[derive(Default)]
+pub(super) struct CatalogNames {
+    names: Mutex<BTreeMap<String, KnownName>>,
+}
+
+impl CatalogNames {
+    pub(super) fn observe_listing(
+        &self,
+        sources: &BTreeMap<String, RecordSource>,
+        threads: &[Thread],
+    ) {
+        let mut names = self.names.lock().unwrap_or_else(PoisonError::into_inner);
+        names.retain(|id, known| {
+            sources
+                .get(id)
+                .is_some_and(|source| source == &known.source)
+        });
+        for thread in threads {
+            if let Some(source) = sources.get(&thread.id) {
+                names.insert(
+                    thread.id.clone(),
+                    KnownName {
+                        source: source.clone(),
+                        name: thread.name.clone(),
+                    },
+                );
+            }
+        }
+    }
+
+    pub(super) async fn changes(
+        &self,
+        catalog: &RecordCatalog,
+        sources: &BTreeMap<String, RecordSource>,
+        after: Option<&str>,
+    ) -> (Vec<ServerNotification>, Option<String>) {
+        let batch = {
+            let mut names = self.names.lock().unwrap_or_else(PoisonError::into_inner);
+            names.retain(|id, known| {
+                sources
+                    .get(id)
+                    .is_some_and(|source| source == &known.source)
+            });
+            let start = after
+                .and_then(|after| names.keys().position(|id| id.as_str() > after))
+                .unwrap_or(0);
+            names
+                .iter()
+                .cycle()
+                .skip(start)
+                .take(names.len().min(MAX_NAMES_PER_POLL))
+                .map(|(id, known)| (id.clone(), known.clone()))
+                .collect::<Vec<_>>()
+        };
+        let next_after = batch.last().map(|(id, _)| id.clone());
+        let reads = batch.into_iter().map(|(id, known)| async move {
+            let stored = catalog.stored(&known.source, /*include_turns*/ false).await;
+            (id, known, stored)
+        });
+        let reads = futures::stream::iter(reads)
+            .buffer_unordered(16)
+            .collect::<Vec<_>>()
+            .await;
+        let mut notifications = Vec::new();
+        let mut names = self.names.lock().unwrap_or_else(PoisonError::into_inner);
+        for (id, previous, stored) in reads {
+            let Ok(stored) = stored else { continue };
+            let Some(current) = names.get_mut(&id) else {
+                continue;
+            };
+            // A newer list response may have updated this connection's baseline
+            // while the canonical read was pending. Keep that response's state.
+            if *current != previous || current.name == stored.name {
+                continue;
+            }
+            current.name = stored.name.clone();
+            notifications.push(ServerNotification::ThreadNameUpdated(
+                ThreadNameUpdatedNotification {
+                    thread_id: id,
+                    thread_name: stored.name,
+                },
+            ));
+        }
+        (notifications, next_after)
+    }
+}
diff --git a/codex-rs/app-server/src/manager_catalog_projects.rs b/codex-rs/app-server/src/manager_catalog_projects.rs
new file mode 100644
index 000000000..3ffd43c7f
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_projects.rs
@@ -0,0 +1,97 @@
+//! Translate imported project membership for display in the reader's own HOME.
+//! No source database or project declaration is modified by this adapter.
+
+use super::*;
+use std::collections::BTreeMap;
+
+#[derive(Default, Serialize)]
+pub(super) struct ProjectAliases {
+    source_home: PathBuf,
+    projects: BTreeMap<String, String>,
+    assignments: BTreeMap<String, String>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Manifest {
+    version: u32,
+    source_home: PathBuf,
+    projects: HashMap<String, String>,
+    thread_assignments: HashMap<String, String>,
+}
+
+impl ProjectAliases {
+    pub(super) async fn load(path: &Path) -> Result<Self, JSONRPCErrorError> {
+        let bytes = bounded_read(path).await?;
+        let manifest: Manifest = serde_json::from_slice(&bytes)
+            .map_err(|_| invalid_request("invalid shared project aliases"))?;
+        if manifest.version != 1 || !manifest.source_home.is_absolute() {
+            return Err(invalid_request("unsupported shared project aliases"));
+        }
+        let home = path
+            .parent()
+            .ok_or_else(|| invalid_request("missing project alias home"))?;
+        let state_path = home.join(".codex-global-state.json");
+        let state: serde_json::Value = serde_json::from_slice(&bounded_read(&state_path).await?)
+            .map_err(|_| invalid_request("invalid shared project desktop state"))?;
+        let identity = format!("local:{}", home.display());
+        let mapping = state
+            .get("app-server-project-id-by-legacy-project-id-by-host")
+            .and_then(|value| value.get(&identity));
+        let local_id = |legacy: &String| {
+            mapping
+                .and_then(|value| value.get(legacy))
+                .and_then(serde_json::Value::as_str)
+                .map(str::to_owned)
+        };
+        Ok(Self {
+            source_home: manifest.source_home,
+            projects: manifest
+                .projects
+                .iter()
+                .filter_map(|(server, legacy)| {
+                    local_id(legacy).map(|local| (server.clone(), local))
+                })
+                .collect(),
+            assignments: manifest
+                .thread_assignments
+                .iter()
+                .filter_map(|(thread, legacy)| {
+                    local_id(legacy).map(|local| (thread.clone(), local))
+                })
+                .collect(),
+        })
+    }
+
+    pub(super) fn apply(&self, source: &RecordSource, stored: &mut StoredThread) {
+        if !codex_core::path_utils::paths_match_after_normalization(
+            &self.source_home,
+            &source.codex_home,
+        ) {
+            return;
+        }
+        // An explicit source project wins over the older desktop assignment cache.
+        stored.project_id = match &stored.project_id {
+            Some(project) => self.projects.get(project).cloned(),
+            None => self.assignments.get(&source.thread_id.to_string()).cloned(),
+        };
+    }
+}
+
+async fn bounded_read(path: &Path) -> Result<Vec<u8>, JSONRPCErrorError> {
+    let metadata = tokio::fs::symlink_metadata(path)
+        .await
+        .map_err(|_| invalid_request("shared project settings unavailable"))?;
+    if !metadata.is_file() || metadata.len() > MAX_MANIFEST_BYTES {
+        return Err(invalid_request(
+            "shared project settings must be a bounded regular file",
+        ));
+    }
+    let bytes = tokio::fs::read(path)
+        .await
+        .map_err(|_| invalid_request("shared project settings unreadable"))?;
+    if bytes.len() as u64 > MAX_MANIFEST_BYTES {
+        return Err(invalid_request("shared project settings exceed 4 MiB"));
+    }
+    Ok(bytes)
+}
diff --git a/codex-rs/app-server/src/manager_catalog_projects_tests.rs b/codex-rs/app-server/src/manager_catalog_projects_tests.rs
new file mode 100644
index 000000000..d5810092e
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_projects_tests.rs
@@ -0,0 +1,93 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn imported_project_membership_uses_reader_ids_in_listing_and_read() {
+    let temp = TempDir::new().unwrap();
+    let source_home = temp.path().join("source");
+    let reader = temp.path().join("reader");
+    fs::create_dir_all(&reader).unwrap();
+    let rollout = fixture(&source_home, THREAD_A, "project member", "legacy");
+    let before = fs::read(&rollout).unwrap();
+    let alias_path = reader.join(".manager-project-aliases.json");
+    fs::write(
+        &alias_path,
+        json!({"version":1,"sourceHome":source_home,
+        "projects":{"source-project":"legacy-project"},
+        "threadAssignments":{THREAD_A:"legacy-project"}})
+        .to_string(),
+    )
+    .unwrap();
+    let state_path = reader.join(".codex-global-state.json");
+    fs::write(&state_path, "{}").unwrap();
+    let mut records = catalog(vec![source(
+        &source_home,
+        &rollout,
+        THREAD_A,
+        PROJECTION_A,
+        "legacy:source",
+    )]);
+    records.mode = CatalogMode::Shared;
+    records.project_aliases = projects::ProjectAliases::load(&alias_path).await.unwrap();
+    let empty = records
+        .list(
+            list_params(json!({"projectId":"reader-project"})),
+            &cwd(&reader),
+        )
+        .await
+        .unwrap();
+    assert!(empty.data.is_empty());
+    // The native app imports the declaration and writes its own legacy-ID map.
+    fs::write(
+        &state_path,
+        json!({"app-server-project-id-by-legacy-project-id-by-host":{
+            format!("local:{}",reader.display()):{"legacy-project":"reader-project"}
+        }})
+        .to_string(),
+    )
+    .unwrap();
+    records.project_aliases = projects::ProjectAliases::load(&alias_path).await.unwrap();
+    let alias_bytes = serde_json::to_vec(&records.project_aliases).unwrap();
+    records.project_aliases = projects::ProjectAliases::load(&alias_path).await.unwrap();
+    assert_eq!(
+        serde_json::to_vec(&records.project_aliases).unwrap(),
+        alias_bytes
+    );
+    let listed = records
+        .list(
+            list_params(json!({"projectId":"reader-project"})),
+            &cwd(&reader),
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        listed
+            .data
+            .iter()
+            .map(|t| (&t.id, t.project_id.as_deref()))
+            .collect::<Vec<_>>(),
+        vec![(&PROJECTION_A.to_string(), Some("reader-project"))]
+    );
+    let read = records
+        .read(
+            serde_json::from_value(json!({"threadId":PROJECTION_A})).unwrap(),
+            &cwd(&reader),
+        )
+        .await
+        .unwrap();
+    assert_eq!(read.thread.project_id, Some("reader-project".to_string()));
+    assert_eq!(read.thread.can_accept_direct_input, Some(false));
+    assert_eq!(fs::read(&rollout).unwrap(), before);
+    let source = records.source(PROJECTION_A).unwrap();
+    let mut metadata = records.stored(source, false).await.unwrap();
+    metadata.project_id = Some("source-project".to_string());
+    records.project_aliases.apply(source, &mut metadata);
+    assert_eq!(metadata.project_id, Some("reader-project".to_string()));
+    let foreign = RecordSource {
+        codex_home: temp.path().join("unrelated"),
+        ..source.clone()
+    };
+    metadata.project_id = Some("source-project".to_string());
+    records.project_aliases.apply(&foreign, &mut metadata);
+    assert_eq!(metadata.project_id, Some("source-project".to_string()));
+}
diff --git a/codex-rs/app-server/src/manager_catalog_roots.rs b/codex-rs/app-server/src/manager_catalog_roots.rs
new file mode 100644
index 000000000..277e50d85
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_roots.rs
@@ -0,0 +1,90 @@
+//! Map registered directory aliases to the physical owner of a record.
+
+use std::collections::HashMap;
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_utils_absolute_path::AbsolutePathBuf;
+
+use super::sources::SourceHome;
+use crate::error_code::invalid_request;
+
+struct Root<'a> {
+    logical: PathBuf,
+    physical: PathBuf,
+    home: &'a Path,
+    source: &'a SourceHome,
+}
+
+pub(super) struct RecordRoots<'a> {
+    roots: Vec<Root<'a>>,
+}
+
+pub(super) struct ResolvedRecord<'a> {
+    pub(super) source: &'a SourceHome,
+    pub(super) home: &'a Path,
+    pub(super) path: PathBuf,
+}
+
+impl<'a> RecordRoots<'a> {
+    pub(super) async fn new(
+        homes: &'a HashMap<PathBuf, SourceHome>,
+    ) -> Result<Self, JSONRPCErrorError> {
+        let mut directories = Vec::new();
+        for (home, source) in homes {
+            for name in ["sessions", "archived_sessions"] {
+                let directory = home.join(name);
+                let physical = match tokio::fs::canonicalize(&directory).await {
+                    Ok(path) => path,
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => directory.clone(),
+                    Err(error) => {
+                        return Err(invalid_request(format!(
+                            "source session directory unavailable: {error}"
+                        )));
+                    }
+                };
+                let normalize = |path| {
+                    AbsolutePathBuf::from_absolute_path_checked(path)
+                        .map(AbsolutePathBuf::into_path_buf)
+                        .map_err(|error| invalid_request(error.to_string()))
+                };
+                directories.push((normalize(directory)?, normalize(physical)?, home, source));
+            }
+        }
+        let mut roots = Vec::new();
+        for (logical, physical, _, _) in &directories {
+            // A link does not enroll an otherwise unregistered destination.
+            if let Some((_, _, home, source)) = directories
+                .iter()
+                .find(|(candidate, resolved, _, _)| candidate == physical && candidate == resolved)
+            {
+                roots.push(Root {
+                    logical: logical.clone(),
+                    physical: physical.clone(),
+                    home,
+                    source,
+                });
+            }
+        }
+        roots.sort_by_key(|root| std::cmp::Reverse(root.logical.components().count()));
+        Ok(Self { roots })
+    }
+
+    pub(super) fn resolve(
+        &self,
+        path: &Path,
+    ) -> Result<Option<ResolvedRecord<'a>>, JSONRPCErrorError> {
+        let path = AbsolutePathBuf::from_absolute_path_checked(path)
+            .map_err(|error| invalid_request(error.to_string()))?;
+        Ok(self.roots.iter().find_map(|root| {
+            path.strip_prefix(&root.logical)
+                .ok()
+                .map(|relative| ResolvedRecord {
+                    source: root.source,
+                    home: root.home,
+                    path: root.physical.join(relative),
+                })
+        }))
+    }
+}
diff --git a/codex-rs/app-server/src/manager_catalog_snapshot.rs b/codex-rs/app-server/src/manager_catalog_snapshot.rs
new file mode 100644
index 000000000..623cae2dc
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_snapshot.rs
@@ -0,0 +1,271 @@
+//! Bounded persisted-history changes for an already opened catalog record.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+
+use codex_app_server_protocol::ItemCompletedNotification;
+use codex_app_server_protocol::ItemStartedNotification;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::SortDirection;
+use codex_app_server_protocol::Thread;
+use codex_app_server_protocol::ThreadItemsListParams;
+use codex_app_server_protocol::ThreadNameUpdatedNotification;
+use codex_app_server_protocol::ThreadTurnsListParams;
+use codex_app_server_protocol::Turn;
+use codex_app_server_protocol::TurnCompletedNotification;
+use codex_app_server_protocol::TurnItemsView;
+use codex_app_server_protocol::TurnStartedNotification;
+use codex_app_server_protocol::TurnStatus;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use sha2::Digest;
+
+use super::RecordCatalog;
+use crate::error_code::invalid_request;
+
+const MAX_CATCH_UP_TURNS: u32 = 32;
+const MAX_ITEMS: usize = 2048;
+const MAX_BYTES: usize = 8 * 1024 * 1024;
+
+struct ObservedItem {
+    hash: [u8; 32],
+    needs_completion: bool,
+}
+
+pub(super) struct Snapshot {
+    pub(super) thread: Thread,
+    pub(super) turns: Vec<Turn>,
+    rollout: Option<PathBuf>,
+    item_states: HashMap<String, HashMap<String, ObservedItem>>,
+}
+
+impl Snapshot {
+    pub(super) async fn read(
+        catalog: &RecordCatalog,
+        id: &str,
+        cwd: &AbsolutePathBuf,
+        previous: Option<&Self>,
+    ) -> Result<Self, JSONRPCErrorError> {
+        let source = catalog.source(id)?;
+        let stored = catalog.stored(source, /*include_turns*/ false).await?;
+        if previous.is_some_and(|previous| previous.rollout != stored.rollout_path) {
+            return Err(invalid_request(
+                "record history was replaced; reopen the common record",
+            ));
+        }
+        let rollout = stored.rollout_path.clone();
+        let (mut thread, _) =
+            crate::request_processors::thread_from_stored_thread(stored, "openai", cwd);
+        thread.can_accept_direct_input = Some(false);
+        thread.path = None;
+        let mut page = catalog
+            .turns_list(ThreadTurnsListParams {
+                thread_id: id.to_string(),
+                cursor: None,
+                limit: Some(if previous.is_some() {
+                    MAX_CATCH_UP_TURNS
+                } else {
+                    1
+                }),
+                sort_direction: Some(SortDirection::Desc),
+                items_view: Some(TurnItemsView::NotLoaded),
+            })
+            .await?;
+        if let Some(anchor) = previous.and_then(|previous| previous.turns.last()) {
+            let index = page
+                .data
+                .iter()
+                .position(|turn| turn.id == anchor.id)
+                .ok_or_else(|| {
+                    invalid_request(
+                        "common record history changed or exceeded catch-up limit; reopen it",
+                    )
+                })?;
+            page.data.truncate(index + 1);
+        } else if previous.is_some() && page.next_cursor.is_some() {
+            return Err(invalid_request(
+                "common record catch-up exceeds its limit; reopen it",
+            ));
+        }
+        let mut count = 0;
+        let mut bytes = 0;
+        let mut pages = 0;
+        let mut item_states = HashMap::new();
+        for turn in &mut page.data {
+            let mut cursor = None;
+            let mut states = HashMap::new();
+            let old_states = previous.and_then(|previous| previous.item_states.get(&turn.id));
+            let completed = turn.status != TurnStatus::InProgress;
+            loop {
+                pages += 1;
+                if pages > 64 {
+                    return Err(invalid_request(
+                        "common record item paging exceeds its limit",
+                    ));
+                }
+                let items = catalog
+                    .items_list(ThreadItemsListParams {
+                        thread_id: id.to_string(),
+                        turn_id: Some(turn.id.clone()),
+                        cursor: cursor.clone(),
+                        limit: Some(100),
+                        sort_direction: Some(SortDirection::Asc),
+                    })
+                    .await?;
+                for entry in items.data {
+                    if entry.turn_id != turn.id {
+                        return Err(invalid_request(
+                            "common record returned an item for another turn",
+                        ));
+                    }
+                    let serialized = serde_json::to_vec(&entry.item)
+                        .map_err(|error| invalid_request(error.to_string()))?;
+                    let hash: [u8; 32] = sha2::Sha256::digest(&serialized).into();
+                    let old = old_states.and_then(|states| states.get(entry.item.id()));
+                    let unchanged = old.is_some_and(|old| old.hash == hash);
+                    // Finish items this watcher actually started, even if their
+                    // text did not change when the turn completed. Do not replay
+                    // the entire opening baseline just for a status transition.
+                    let pending_completion = old.is_some_and(|old| old.needs_completion);
+                    let notify =
+                        previous.is_some() && (!unchanged || (completed && pending_completion));
+                    states.insert(
+                        entry.item.id().to_string(),
+                        ObservedItem {
+                            hash,
+                            needs_completion: !completed && (notify || pending_completion),
+                        },
+                    );
+                    // Opening a record establishes a baseline; paginated history
+                    // already supplies its contents. Bound only payloads that
+                    // will actually be sent as new or changed notifications.
+                    if notify {
+                        count += 1;
+                        bytes += serialized.len();
+                        if count > MAX_ITEMS || bytes > MAX_BYTES {
+                            return Err(invalid_request(
+                                "common record update exceeds its limit; reopen it",
+                            ));
+                        }
+                        turn.items.push(entry.item);
+                    }
+                }
+                if items.next_cursor.is_none() {
+                    break;
+                }
+                if items.next_cursor == cursor {
+                    return Err(invalid_request("common record item cursor did not advance"));
+                }
+                cursor = items.next_cursor;
+            }
+            item_states.insert(turn.id.clone(), states);
+            turn.items_view = TurnItemsView::NotLoaded;
+        }
+        if catalog
+            .stored(source, /*include_turns*/ false)
+            .await?
+            .rollout_path
+            != rollout
+        {
+            return Err(invalid_request(
+                "common record changed during update; reopen it",
+            ));
+        }
+        page.data.reverse();
+        if let Some(old) = previous.and_then(|previous| previous.turns.last())
+            && let Some(old_states) =
+                previous.and_then(|previous| previous.item_states.get(&old.id))
+            && item_states
+                .get(&old.id)
+                .is_some_and(|states| old_states.keys().any(|id| !states.contains_key(id)))
+        {
+            return Err(invalid_request(
+                "common record items were removed; reopen it",
+            ));
+        }
+        Ok(Self {
+            thread,
+            turns: page.data,
+            rollout,
+            item_states,
+        })
+    }
+
+    pub(super) fn changes(&self, previous: &Self) -> Vec<ServerNotification> {
+        let id = &self.thread.id;
+        let mut events = Vec::new();
+        if self.thread.name != previous.thread.name {
+            events.push(ServerNotification::ThreadNameUpdated(
+                ThreadNameUpdatedNotification {
+                    thread_id: id.clone(),
+                    thread_name: self.thread.name.clone(),
+                },
+            ));
+        }
+        for turn in &self.turns {
+            let old = previous.turns.iter().find(|old| old.id == turn.id);
+            if old == Some(turn) {
+                continue;
+            }
+            if old.is_none() {
+                let mut start = turn.clone();
+                start.items.clear();
+                start.items_view = TurnItemsView::NotLoaded;
+                start.status = TurnStatus::InProgress;
+                start.error = None;
+                start.completed_at = None;
+                start.duration_ms = None;
+                events.push(ServerNotification::TurnStarted(TurnStartedNotification {
+                    thread_id: id.clone(),
+                    turn: start,
+                }));
+            }
+            let completed = turn.status != TurnStatus::InProgress;
+            for item in &turn.items {
+                // Persisted partial items are upserts. Never invent a completion
+                // for an in-progress turn or forward an actionable tool request.
+                if completed {
+                    events.push(ServerNotification::ItemCompleted(
+                        ItemCompletedNotification {
+                            thread_id: id.clone(),
+                            turn_id: turn.id.clone(),
+                            item: item.clone(),
+                            completed_at_ms: turn.completed_at.unwrap_or(self.thread.updated_at)
+                                * 1000,
+                        },
+                    ));
+                } else {
+                    events.push(ServerNotification::ItemStarted(ItemStartedNotification {
+                        thread_id: id.clone(),
+                        turn_id: turn.id.clone(),
+                        item: item.clone(),
+                        started_at_ms: turn.started_at.unwrap_or(self.thread.updated_at) * 1000,
+                    }));
+                }
+            }
+            if completed {
+                let mut end = turn.clone();
+                end.items.clear();
+                end.items_view = TurnItemsView::NotLoaded;
+                events.push(ServerNotification::TurnCompleted(
+                    TurnCompletedNotification {
+                        thread_id: id.clone(),
+                        turn: end,
+                    },
+                ));
+            }
+        }
+        events
+    }
+
+    pub(super) fn retain_latest(&mut self) {
+        if self.turns.len() > 1 {
+            self.turns.drain(..self.turns.len() - 1);
+        }
+        for turn in &mut self.turns {
+            turn.items.clear();
+        }
+        self.item_states
+            .retain(|id, _| self.turns.last().is_some_and(|turn| turn.id == *id));
+    }
+}
diff --git a/codex-rs/app-server/src/manager_catalog_sources.rs b/codex-rs/app-server/src/manager_catalog_sources.rs
new file mode 100644
index 000000000..8c153deee
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_sources.rs
@@ -0,0 +1,424 @@
+//! Resolve registered managed source homes inside the native remote runtime.
+//!
+//! Discovery uses read-only state pages; it never initializes a database, scans
+//! conversation bodies, acquires a writer, or reads another source's config/auth.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::Duration;
+use std::time::Instant;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_protocol::ThreadId;
+use codex_thread_store::ManagedSourceId;
+use codex_thread_store::ReadOnlyLocalThreadStore;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use serde::Deserialize;
+use sha2::Digest;
+use tokio::sync::Mutex;
+use tokio::sync::OnceCell;
+use uuid::Uuid;
+
+use super::CatalogMode;
+use super::HistoryProjections;
+use super::RecordCatalog;
+use super::RecordSource;
+use super::metadata::DiscoveredMetadata;
+use super::roots::RecordRoots;
+use crate::error_code::invalid_request;
+
+const MAX_SOURCES: usize = 256;
+const REFRESH_INTERVAL: Duration = Duration::from_secs(2);
+const DISCOVERY_TIMEOUT: Duration = Duration::from_secs(8);
+const PROJECTION_NAMESPACE: Uuid = Uuid::from_u128(0x14a0f21bb52945fcbd9eb07637424fa3);
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct SourceCatalog {
+    version: u32,
+    host_id: String,
+    sources: Vec<SourceHome>,
+    #[serde(default)]
+    legacy_sources: Vec<SourceHome>,
+    managed_sources_path: Option<PathBuf>,
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct SourceHome {
+    pub(super) host_id: String,
+    pub(super) source_store_id: String,
+    pub(super) codex_home: PathBuf,
+}
+
+#[derive(Clone)]
+struct Discovery {
+    revision: String,
+    entries: Arc<Vec<RecordSource>>,
+    metadata: Arc<DiscoveredMetadata>,
+}
+
+struct CachedDiscovery {
+    path: PathBuf,
+    bytes: Vec<u8>,
+    snapshot: Arc<OnceCell<DiscoverySnapshot>>,
+    history_projections: Arc<Mutex<HistoryProjections>>,
+}
+
+struct DiscoverySnapshot {
+    observed: Instant,
+    result: Result<Discovery, JSONRPCErrorError>,
+}
+
+static CACHE: Mutex<Option<CachedDiscovery>> = Mutex::const_new(None);
+
+pub(super) async fn discover(
+    path: &Path,
+    bytes: &[u8],
+) -> Result<RecordCatalog, JSONRPCErrorError> {
+    let (snapshot, history_projections) = {
+        let mut cache = CACHE.lock().await;
+        if let Some(previous) = cache.as_ref()
+            && previous.path == path
+            && previous.bytes == bytes
+            && previous
+                .snapshot
+                .get()
+                .is_none_or(|snapshot| snapshot.observed.elapsed() < REFRESH_INTERVAL)
+        {
+            (
+                Arc::clone(&previous.snapshot),
+                Arc::clone(&previous.history_projections),
+            )
+        } else {
+            let snapshot = Arc::new(OnceCell::new());
+            let history_projections = cache
+                .as_ref()
+                .filter(|previous| previous.path == path && previous.bytes == bytes)
+                .map(|previous| Arc::clone(&previous.history_projections))
+                .unwrap_or_default();
+            *cache = Some(CachedDiscovery {
+                path: path.to_path_buf(),
+                bytes: bytes.to_vec(),
+                snapshot: Arc::clone(&snapshot),
+                history_projections: Arc::clone(&history_projections),
+            });
+            (snapshot, history_projections)
+        }
+    };
+    // Share an in-flight refresh without holding the catalog mutex during I/O.
+    let current = snapshot
+        .get_or_init(|| async {
+            let result = tokio::time::timeout(DISCOVERY_TIMEOUT, read_sources(bytes))
+                .await
+                .map_err(|_| invalid_request("managed catalog source discovery timed out"))
+                .and_then(|result| result);
+            DiscoverySnapshot {
+                observed: Instant::now(),
+                result,
+            }
+        })
+        .await
+        .result
+        .clone()?;
+    Ok(RecordCatalog {
+        version: 1,
+        revision: current.revision,
+        host_id: "local".to_string(),
+        entries: current.entries,
+        discovered: Some(current.metadata),
+        mode: CatalogMode::default(),
+        canonical_homes: OnceCell::new(),
+        read_only_stores: Mutex::new(Default::default()),
+        history_projections,
+        project_aliases: Default::default(),
+        shared_routes: Default::default(),
+    })
+}
+
+async fn read_sources(bytes: &[u8]) -> Result<Discovery, JSONRPCErrorError> {
+    let mut catalog: SourceCatalog = serde_json::from_slice(bytes)
+        .map_err(|error| invalid_request(format!("invalid managed source catalog: {error}")))?;
+    if let Some(path) = catalog.managed_sources_path.take() {
+        if catalog.version != 3 || !catalog.sources.is_empty() || !path.is_absolute() {
+            return Err(invalid_request("invalid mixed source inventory reference"));
+        }
+        let metadata = tokio::fs::metadata(&path)
+            .await
+            .map_err(|error| invalid_request(format!("managed inventory unavailable: {error}")))?;
+        if !metadata.is_file() || metadata.len() > super::MAX_MANIFEST_BYTES {
+            return Err(invalid_request("managed inventory exceeds its file limit"));
+        }
+        let bytes = tokio::fs::read(path)
+            .await
+            .map_err(|error| invalid_request(error.to_string()))?;
+        if bytes.len() as u64 > super::MAX_MANIFEST_BYTES {
+            return Err(invalid_request("managed inventory exceeds its file limit"));
+        }
+        let inventory: SourceCatalog = serde_json::from_slice(&bytes).map_err(|error| {
+            invalid_request(format!("invalid referenced managed inventory: {error}"))
+        })?;
+        if inventory.version != 2
+            || inventory.host_id != "local"
+            || !inventory.legacy_sources.is_empty()
+            || inventory.managed_sources_path.is_some()
+        {
+            return Err(invalid_request(
+                "mixed catalog requires a direct version2 managed inventory",
+            ));
+        }
+        catalog.sources = inventory.sources;
+    }
+    if !matches!(catalog.version, 2 | 3)
+        || (catalog.version == 2 && !catalog.legacy_sources.is_empty())
+        || catalog.host_id != "local"
+        || catalog.sources.len() + catalog.legacy_sources.len() > MAX_SOURCES
+    {
+        return Err(invalid_request(
+            "unsupported managed source catalog version, host, or size",
+        ));
+    }
+    let mut identities = HashSet::new();
+    let mut homes = HashMap::new();
+    let mut entries = Vec::new();
+    let mut metadata = DiscoveredMetadata::default();
+    for source in &catalog.sources {
+        let profile_id = source
+            .source_store_id
+            .strip_prefix("manager:")
+            .and_then(|id| Uuid::parse_str(id).ok());
+        if source.host_id != "local"
+            || profile_id.is_none()
+            || !source.codex_home.is_absolute()
+            || !identities.insert(source.source_store_id.clone())
+        {
+            return Err(invalid_request(
+                "invalid or duplicate managed catalog source identity",
+            ));
+        }
+        let home = tokio::fs::canonicalize(&source.codex_home)
+            .await
+            .map_err(|error| {
+                invalid_request(format!("managed source home unavailable: {error}"))
+            })?;
+        if homes.insert(home.clone(), source.clone()).is_some() {
+            return Err(invalid_request(
+                "managed source home has multiple catalog identities",
+            ));
+        }
+        let marker_path = home.join("managed-source.json");
+        let metadata = tokio::fs::symlink_metadata(&marker_path)
+            .await
+            .map_err(|error| {
+                invalid_request(format!("managed source marker unavailable: {error}"))
+            })?;
+        if !metadata.is_file() || metadata.len() > 4096 {
+            return Err(invalid_request("invalid managed source marker"));
+        }
+        let marker_bytes = tokio::fs::read(&marker_path).await.map_err(|error| {
+            invalid_request(format!("managed source marker unavailable: {error}"))
+        })?;
+        if marker_bytes.len() > 4096 {
+            return Err(invalid_request("managed source marker exceeds its limit"));
+        }
+        let marker: ManagedSourceId = serde_json::from_slice(&marker_bytes)
+            .map_err(|error| invalid_request(format!("invalid managed source marker: {error}")))?;
+        if marker.host_id != source.host_id || marker.store_id != source.source_store_id {
+            return Err(invalid_request("managed source marker identity changed"));
+        }
+    }
+    for source in &catalog.legacy_sources {
+        let expected_id = format!(
+            "legacy:{:x}",
+            sha2::Sha256::digest(source.codex_home.to_string_lossy().as_bytes())
+        );
+        if source.host_id != "local"
+            || source.source_store_id != expected_id
+            || !source.codex_home.is_absolute()
+            || !identities.insert(source.source_store_id.clone())
+        {
+            return Err(invalid_request(
+                "invalid mixed source catalog legacy identity",
+            ));
+        }
+        let home = tokio::fs::canonicalize(&source.codex_home)
+            .await
+            .map_err(|error| invalid_request(format!("legacy source home unavailable: {error}")))?;
+        if homes.insert(home, source.clone()).is_some() {
+            return Err(invalid_request(
+                "legacy home has multiple catalog identities",
+            ));
+        }
+    }
+    let mut scope = homes
+        .iter()
+        .map(|(home, source)| (&source.source_store_id, home))
+        .collect::<Vec<_>>();
+    scope.sort();
+    metadata.scope_revision = format!(
+        "{:x}",
+        sha2::Sha256::digest(
+            serde_json::to_vec(&scope).map_err(|error| invalid_request(error.to_string()))?
+        )
+    );
+    let roots = RecordRoots::new(&homes).await?;
+    metadata.registered_homes = homes
+        .iter()
+        .map(|(home, source)| (source.source_store_id.clone(), home.clone()))
+        .collect();
+    let mut indexed_entries = HashMap::new();
+    let mut unindexed_sources = Vec::new();
+    for (home, source) in &homes {
+        let sqlite = codex_state::SqliteConfig::from_sqlite_home(
+            AbsolutePathBuf::from_absolute_path(home)
+                .map_err(|error| invalid_request(error.to_string()))?,
+        );
+        // A just-enrolled profile has no database before its first native start.
+        // Existing unmanaged stores may predate the state database. Discover
+        // their headers without creating or migrating a source index.
+        if !tokio::fs::try_exists(sqlite.state_db_path())
+            .await
+            .map_err(|error| invalid_request(error.to_string()))?
+        {
+            if source.source_store_id.starts_with("legacy:") {
+                unindexed_sources.push((source, home));
+                continue;
+            }
+            for directory in [home.join("sessions"), home.join("archived_sessions")] {
+                if tokio::fs::try_exists(&directory)
+                    .await
+                    .map_err(|error| invalid_request(error.to_string()))?
+                {
+                    let mut files = tokio::fs::read_dir(directory)
+                        .await
+                        .map_err(|error| invalid_request(error.to_string()))?;
+                    if files
+                        .next_entry()
+                        .await
+                        .map_err(|error| invalid_request(error.to_string()))?
+                        .is_some()
+                    {
+                        return Err(invalid_request(
+                            "managed source has records but its state database is unavailable",
+                        ));
+                    }
+                }
+            }
+            continue;
+        }
+        let store = Arc::new(
+            ReadOnlyLocalThreadStore::open(home.clone(), sqlite)
+                .await
+                .map_err(super::history::store_error)?,
+        );
+        let result = read_pages(source, &store, &roots, &mut indexed_entries, &mut metadata).await;
+        store.close().await;
+        result?;
+    }
+    // A physical session home can have no database while another registered
+    // profile indexes its records. Resolve every index before judging headers.
+    let indexed_projections = indexed_entries.keys().copied().collect();
+    for (source, home) in unindexed_sources {
+        super::legacy_sources::read_headers(source, home, &indexed_projections, &mut entries)
+            .await?;
+    }
+    for entry in entries {
+        indexed_entries
+            .entry(entry.projection_thread_id)
+            .or_insert(entry);
+    }
+    let mut entries = indexed_entries.into_values().collect::<Vec<_>>();
+    entries.sort_by_key(|entry| entry.projection_thread_id.to_string());
+    let mut digest = sha2::Sha256::new();
+    for entry in &entries {
+        digest
+            .update(serde_json::to_vec(entry).map_err(|error| invalid_request(error.to_string()))?);
+        metadata.projections.insert(
+            (entry.source_store_id.clone(), entry.thread_id),
+            entry.projection_thread_id,
+        );
+    }
+    Ok(Discovery {
+        revision: format!("{:x}", digest.finalize()),
+        entries: Arc::new(entries),
+        metadata: Arc::new(metadata),
+    })
+}
+
+async fn read_pages(
+    source: &SourceHome,
+    store: &ReadOnlyLocalThreadStore,
+    roots: &RecordRoots<'_>,
+    entries: &mut HashMap<ThreadId, RecordSource>,
+    metadata: &mut DiscoveredMetadata,
+) -> Result<(), JSONRPCErrorError> {
+    let mut after_id = None;
+    loop {
+        let page_size = 256;
+        let page = store
+            .list_metadata_summaries_page(after_id, page_size)
+            .await
+            .map_err(super::history::store_error)?;
+        let count = page.len();
+        for mut thread in page {
+            after_id = Some(thread.thread_id);
+            let path = thread
+                .rollout_path
+                .as_ref()
+                .ok_or_else(|| invalid_request("source metadata has no rollout path"))?;
+            let Some(record) = roots.resolve(path)? else {
+                continue;
+            };
+            // Sidebar pages omit empty previews; V2 children still need an
+            // identity here so a parent's linked history can be projected.
+            let owner_id = &record.source.source_store_id;
+            let key = format!("local\0{owner_id}\0{}", thread.thread_id);
+            let projection = Uuid::new_v5(&PROJECTION_NAMESPACE, key.as_bytes());
+            let projection_thread_id = ThreadId::from_string(&projection.to_string())
+                .map_err(|error| invalid_request(error.to_string()))?;
+            if let Some(previous) = metadata.summaries.get(&projection_thread_id) {
+                let previous_source = &metadata.summary_sources[&projection_thread_id];
+                let priority = (
+                    source.source_store_id == *owner_id,
+                    thread.updated_at,
+                    &source.source_store_id,
+                );
+                let previous_priority = (
+                    previous_source == owner_id,
+                    previous.updated_at,
+                    previous_source,
+                );
+                if priority <= previous_priority {
+                    continue;
+                }
+            }
+            // Prefer the owning store's row. Without one, the newest registered
+            // metadata copy identifies the candidate read-only index. Selected
+            // reads validate physical ownership, IDs and durable checkpoints;
+            // this selection never acquires writer authority.
+            thread.rollout_path = Some(record.path.clone());
+            entries.insert(
+                projection_thread_id,
+                RecordSource {
+                    projection_thread_id,
+                    thread_id: thread.thread_id,
+                    host_id: record.source.host_id.clone(),
+                    source_store_id: owner_id.clone(),
+                    codex_home: record.home.to_path_buf(),
+                    rollout_path: record.path,
+                },
+            );
+            metadata
+                .summary_sources
+                .insert(projection_thread_id, source.source_store_id.clone());
+            metadata.summaries.insert(projection_thread_id, thread);
+        }
+        if count < page_size {
+            break;
+        }
+    }
+    Ok(())
+}
