+async fn managed_status_reports_cold_child_without_creating_its_authority_or_loading_it()
+-> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let profile = ManagedProfile::new(&server.uri())?;
+    let mut app = profile.start_server().await?;
+    let thread_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let root_id = ThreadId::from_string(&thread_id)?;
+    let child_id = ThreadId::from_string(&Uuid::new_v4().to_string())?;
+    // Persist only an edge. There is no child actor, authority, or configured
+    // child binding for an observation to resume or claim implicitly.
+    let state = StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(profile.home.path().abs()),
+        "mock_provider".to_string(),
+    )
+    .await?;
+    state
+        .upsert_thread_spawn_edge(root_id, child_id, DirectionalThreadSpawnEdgeStatus::Open)
+        .await?;
+    let child_authority = profile
+        .home
+        .path()
+        .join("managed-authority")
+        .join(format!("{child_id}.json"));
+    let child_lock = profile
+        .home
+        .path()
+        .join("managed-authority")
+        .join(format!("{child_id}.lock"));
+    assert!(!child_authority.exists());
+    assert!(!child_lock.exists());
+    let root_authority_before = profile.authority_bytes(&thread_id)?;
+    let manifest_before = fs::read(&profile.manifest_path)?;
+
+    let status = snapshot(&mut app, &thread_id).await?;
+    let mut observed_ids = vec![thread_id.clone(), child_id.to_string()];
+    observed_ids.sort();
+    assert_eq!(
+        status,
+        json!({
+            "threadId": thread_id,
+            "hostId": "local",
+            "sourceStoreId": profile.source_id,
+            "idle": false,
+            "blockers": [{ "threadId": child_id.to_string(), "kind": "coldDescendantRequiresWriterClaim" }],
+            "observedThreadIds": observed_ids,
+            "proofScope": "advisory",
+        }),
+    );
+    assert!(!child_authority.exists());
+    assert!(!child_lock.exists());
+    assert_eq!(profile.authority_bytes(&thread_id)?, root_authority_before);
+    assert_eq!(fs::read(&profile.manifest_path)?, manifest_before);
+    let loaded: ThreadLoadedListResponse = app
+        .request(|request_id| ClientRequest::ThreadLoadedList {
+            request_id,
+            params: ThreadLoadedListParams::default(),
+        })
+        .await?;
+    assert_eq!(loaded.data, vec![thread_id.clone()]);
+
+    let started = start_turn(&mut app, &thread_id).await?;
+    assert_completed(&mut app, &thread_id, &started.turn.id).await?;
+    Ok(())
