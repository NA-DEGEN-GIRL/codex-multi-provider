new file mode 100644
index 000000000..4af37baee
--- /dev/null
+++ b/codex-rs/state/src/temporary_history.rs
@@ -0,0 +1,38 @@
+//! Private, disposable history indexes with the same schema as native writers.
+
+use sqlx::ConnectOptions;
+use sqlx::SqlitePool;
+use sqlx::sqlite::SqliteConnectOptions;
+use sqlx::sqlite::SqlitePoolOptions;
+
+/// Open an unnamed SQLite temporary database containing only the native history schema.
+/// SQLite owns its temporary storage and removes it when the connection closes, including
+/// process exit. One persistent connection is required: another connection would see a different
+/// temporary database. No source home, state database, recorder or credential is opened.
+pub async fn open_temporary_thread_history_db() -> anyhow::Result<SqlitePool> {
+    let pool = SqlitePoolOptions::new()
+        .max_connections(1)
+        .min_connections(1)
+        .idle_timeout(None)
+        .max_lifetime(None)
+        .connect_with(
+            SqliteConnectOptions::new()
+                .filename("")
+                .create_if_missing(true)
+                .pragma("cache_size", "-2048")
+                .disable_statement_logging(),
+        )
+        .await?;
+    if let Err(error) = crate::migrations::runtime_thread_history_migrator()
+        .run(&pool)
+        .await
+    {
+        pool.close().await;
+        return Err(error.into());
+    }
+    Ok(pool)
+}
+
+#[cfg(test)]
+#[path = "temporary_history_tests.rs"]
+mod tests;
