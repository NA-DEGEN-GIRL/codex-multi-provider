index 000000000..b16e10636
--- /dev/null
+++ b/codex-rs/core/src/managed_idle_status.rs
@@ -0,0 +1,54 @@
+//! Read-only managed activity observations. Nothing in this module seals
+//! admission, drains input, unloads actors, or proves writer release.
+
+use crate::CodexThread;
+
+impl CodexThread {
+    /// Return bounded activity categories from this actor's current state.
+    /// These observations are advisory and are deliberately not atomic with
+    /// later activity. Strict shutdown must independently obtain admission.
+    pub async fn managed_idle_blockers(&self) -> Vec<String> {
+        let mut blockers = Vec::new();
+        if self.session.active_turn.lock().await.is_some() {
+            blockers.push("activeTurn".to_string());
+        }
+        if self
+            .session
+            .input_queue
+            .has_pending_input(&self.session.active_turn)
+            .await
+            || self.session.input_queue.has_pending_mailbox_items().await
+        {
+            blockers.push("pendingInputOrAgentMail".to_string());
+        }
+        if self.session.conversation.running_state().await.is_some() {
+            blockers.push("realtimeConversation".to_string());
+        }
+        if !self.session.list_background_terminals().await.is_empty() {
+            blockers.push("backgroundTerminal".to_string());
+        }
+        if self.out_of_band_elicitations.lock().await.count != 0
+            || *self.session.services.elicitations.subscribe().borrow()
+        {
+            blockers.push("elicitation".to_string());
+        }
+        if !self.session.async_hook_results.is_empty()
+            || self.session.services.hooks.load().has_pending_work()
+        {
+            blockers.push("hookWork".to_string());
+        }
+        if self.io.tx_sub.pending_count() != 0 {
+            blockers.push("queuedCoreSubmission".to_string());
+        }
+        if self.io.tx_sub.active_admissions() != 0 {
+            blockers.push("pendingInternalActivity".to_string());
+        }
+        if self.session.internal_sessions.ensure_idle().await.is_err() {
+            blockers.push("internalActorWorkOrUnverifiedCleanup".to_string());
+        }
+        if self.io.tx_sub.is_sealed() || self.io.tx_sub.is_closed() {
+            blockers.push("actorClosing".to_string());
+        }
+        blockers
+    }
+}
diff --git a/codex-rs/core/src/portable_context.rs b/codex-rs/core/src/portable_context.rs
