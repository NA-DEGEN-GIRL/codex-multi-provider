+/// Opens a rollout for synchronous line reads from a blocking thread.
+///
+/// The discovered representation is opened first, then its plain or compressed sibling, with the
+/// same not-found retries as [`open_rollout_line_reader`]. Buffers are sized to read a session
+/// header without pulling in much of the rest of the file.
+pub(crate) fn open_rollout_head_reader_blocking(path: &Path) -> io::Result<BlockingLineReader> {
+    for _ in 0..MAX_NOT_FOUND_RETRIES {
+        match reader::open_head_once_blocking(path) {
+            Ok(reader) => return Ok(reader),
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                std::thread::sleep(OPEN_ROLLOUT_LINE_READER_RETRY_DELAY);
+            }
+            Err(err) => return Err(err),
+        }
+    }
+    reader::open_head_once_blocking(path)
+}
