+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn watcher_keeps_independent_revision_cursors_for_each_canonical_source() -> anyhow::Result<()>
+{
+    let server = responses::start_mock_server().await;
+    let model_responses = responses::mount_sse_sequence(
+        &server,
+        ["first-source-turn", "second-source-turn"]
+            .into_iter()
+            .map(responses::sse_completed)
+            .collect(),
+    )
+    .await;
+    let installed = Arc::new(InstalledQueue::default());
+    let mut extensions = ExtensionRegistryBuilder::<Config>::new();
+    extensions.thread_lifecycle_contributor(installed.clone());
+    let test = test_codex()
+        .with_extensions(Arc::new(extensions.build()))
+        .with_config(|config| config.include_environment_context = false)
+        .build_with_auto_env(&server)
+        .await?;
+    let (_first_home, first_binding) = managed_source().await?;
+    let (_second_home, second_binding) = managed_source().await?;
+    let mut first_options = StartThreadOptions::new(test.config.clone());
+    first_options.managed_record_binding = Some(first_binding.clone());
+    let first = test.thread_manager.start_thread(first_options).await?;
+    let mut second_options = StartThreadOptions::new(test.config.clone());
+    second_options.managed_record_binding = Some(second_binding.clone());
+    let second = test.thread_manager.start_thread(second_options).await?;
+    let first_queue = LocalQueueStore::new(
+        first_binding
+            .store()
+            .state_db()
+            .await
+            .context("first source state")?,
+    );
+    let second_queue = LocalQueueStore::new(
+        second_binding
+            .store()
+            .state_db()
+            .await
+            .context("second source state")?,
+    );
+    let first_payload = serde_json::to_string(&user_input("first source"))?;
+    for _ in 0..8 {
+        let staged = first_queue
+            .enqueue(first.thread_id, first_payload.clone())
+            .await?;
+        first_queue.delete(first.thread_id, staged.id).await?;
+    }
+    first_queue.enqueue(first.thread_id, first_payload).await?;
+    let first_revision = first_queue
+        .changes_since(/*revision*/ 0, &[first.thread_id])
+        .await?
+        .last()
+        .context("first revision missing")?
+        .1;
+    let target_queue = process_queue(&test)?;
+    let service = Arc::new(QueuedItemService::new(
+        Arc::clone(&target_queue),
+        Arc::downgrade(&test.thread_manager),
+        Arc::new(NoopExtensionEventSink),
+    ));
+    assert!(installed.0.set(Arc::clone(&service)).is_ok());
+    let mut watcher_extensions = ExtensionRegistryBuilder::<Config>::new();
+    codex_queue_extension::install(&mut watcher_extensions, Arc::clone(&service));
+    wait_for_event_with_timeout(
+        first.thread.as_ref(),
+        |event| matches!(event, EventMsg::TurnComplete(_)),
+        Duration::from_secs(/*secs*/ 25),
+    )
+    .await;
+
+    second_queue
+        .enqueue(
+            second.thread_id,
+            serde_json::to_string(&user_input("second source"))?,
+        )
+        .await?;
+    let second_revision = second_queue
+        .changes_since(/*revision*/ 0, &[second.thread_id])
+        .await?
+        .last()
+        .context("second revision missing")?
+        .1;
+    assert!(second_revision < first_revision);
+    wait_for_event_with_timeout(
+        second.thread.as_ref(),
+        |event| matches!(event, EventMsg::TurnComplete(_)),
+        Duration::from_secs(/*secs*/ 25),
+    )
+    .await;
+    assert_eq!(
+        vec!["first source", "second source"],
+        model_responses
+            .requests()
+            .into_iter()
+            .filter_map(|request| request.message_input_texts("user").pop())
+            .collect::<Vec<_>>()
+    );
+    for thread_id in [first.thread_id, second.thread_id] {
+        // Turn completion and the dispatcher's durable queue deletion may race.
+        tokio::time::timeout(Duration::from_secs(/*secs*/ 5), async {
+            while !service.list(thread_id).await?.is_empty() {
+                tokio::time::sleep(Duration::from_millis(/*millis*/ 10)).await;
+            }
+            anyhow::Ok(())
+        })
+        .await??;
+        assert!(
+            target_queue
+                .list_page(thread_id, /*offset*/ 0, /*limit*/ 10)
+                .await?
+                .is_empty()
+        );
+    }
+    first.thread.shutdown_and_wait().await?;
+    second.thread.shutdown_and_wait().await?;
+    Ok(())
+}
