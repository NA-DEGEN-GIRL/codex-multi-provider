+#[tokio::test]
+async fn dropping_a_fresh_cold_claim_keeps_the_previously_revoked_map_binding() {
+    let fixture = ColdDrainFixture::new().await;
+    let child = fixture.seed_child(ThreadId::new()).await;
+    let admission = fixture
+        .root_actor
+        .try_reserve_idle_close()
+        .expect("exclusive root admission");
+    let ids = [fixture.root.thread_id(), child.thread_id()];
+    let mut first = fixture
+        .manager
+        .prepare_managed_cold_drain(&fixture.root_actor, &admission, &ids)
+        .await
+        .expect("initial cold claim");
+    first
+        .close_thread(child.thread_id())
+        .await
+        .expect("revoke installed lifetime");
+    drop(first);
+    assert!(child.is_released());
+
+    let next = fixture
+        .manager
+        .prepare_managed_cold_drain(&fixture.root_actor, &admission, &ids)
+        .await
+        .expect("private fresh same-grant claim");
+    let fresh = next
+        .binding(child.thread_id())
+        .expect("fresh private binding");
+    assert!(!Arc::ptr_eq(&fresh.store(), &child.store()));
+    assert!(!fresh.is_released());
+    let during = fixture
+        .manager
+        .managed_record_binding(child.thread_id())
+        .await
+        .expect("installed old binding");
+    assert!(Arc::ptr_eq(&during.store(), &child.store()));
+    assert!(during.is_released());
+    drop(next);
+
+    let after = fixture
+        .manager
+        .managed_record_binding(child.thread_id())
+        .await
+        .expect("installed binding after drop");
+    assert!(Arc::ptr_eq(&after.store(), &child.store()));
+    assert!(after.is_released());
+    assert!(after.write_permit().await.is_err());
+    drop(admission);
+    fixture.finish().await;
+}
