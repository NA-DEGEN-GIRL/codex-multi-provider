+// Simulate the manager's durable owner CAS only after a public strict release
+// proof. The fixture follows the same directory lock and atomic replacement
+// protocol; it never manufactures release while an actor still owns the record.
+fn transfer_authority(
+    source: &ManagedProfile,
+    thread_id: &str,
+    previous_owner: &ManagedProfile,
+    previous_epoch: u64,
+    next_owner: &ManagedProfile,
+) -> Result<()> {
+    let directory = source.home.path().join("managed-authority");
+    let authority_path = directory.join(format!("{thread_id}.json"));
+    let lock_path = directory.join(format!("{thread_id}.lock"));
+    fs::create_dir(&lock_path)?;
+    let result = (|| -> Result<()> {
+        let current: Value = serde_json::from_slice(&fs::read(&authority_path)?)?;
+        assert_eq!(
+            current,
+            json!({
+                "version": 1,
+                "host_id": "local",
+                "store_id": source.source_id,
+                "thread_id": thread_id,
+                "owner_profile_id": previous_owner.profile_id,
+                "epoch": previous_epoch,
+                "revision": previous_epoch,
+            })
+        );
+        let mut next = current;
+        next["owner_profile_id"] = json!(next_owner.profile_id);
+        next["epoch"] = json!(previous_epoch + 1);
+        next["revision"] = json!(previous_epoch + 1);
+        let mut file = NamedTempFile::new_in(&directory)?;
+        file.write_all(&serde_json::to_vec(&next)?)?;
+        file.flush()?;
+        file.as_file().sync_all()?;
+        file.persist(&authority_path)?;
+        #[cfg(unix)]
+        fs::File::open(&directory)?.sync_all()?;
+        Ok(())
+    })();
+    let release_result = fs::remove_dir(lock_path);
+    result?;
+    release_result?;
+    Ok(())
+}
