+#[test]
+fn concurrent_session_sends_the_turn_state_without_sharing_it() {
+    let client = test_model_client(SessionSource::Cli);
+    let turn = client.new_session();
+
+    // Before the server assigned the turn a state, a state assigned to the concurrent request
+    // stays with that request.
+    let early = turn.concurrent_session();
+    early
+        .turn_state
+        .set("summary-state".to_string())
+        .expect("fresh turn state");
+    assert_eq!(turn.turn_state.get(), None);
+
+    turn.turn_state
+        .set("turn-state".to_string())
+        .expect("fresh turn state");
+    let beside = turn.concurrent_session();
+    assert_eq!(
+        beside.turn_state.get().map(String::as_str),
+        Some("turn-state")
+    );
+    assert!(!Arc::ptr_eq(&beside.turn_state, &turn.turn_state));
+}
