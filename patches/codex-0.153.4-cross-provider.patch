+    let meta = json!({"ordinal":0,"timestamp":"2026-09-15T00:00:00Z","type":"session_meta","payload":{
+        "id":id,"session_id":id,"timestamp":"2026-09-15T00:00:00Z","cwd":temp.path(),
+        "originator":"fixture","cli_version":"test","source":"cli","history_mode":"paginated"
+    }});
+    // A writer died holding the lease before finishing ordinal 1.
+    let torn = r#"{"timestamp":"2026-09-15T00:00:01Z","ordinal":1,"type":"event_msg","pay"#;
+    std::fs::write(&path, format!("{meta}\n{torn}")).unwrap();
+    let item = serde_json::from_value(json!({"type":"event_msg","payload":{
+        "type":"user_message","message":"after a crashed writer","kind":"plain"
+    }}))
+    .unwrap();
+
+    append(
+        path.clone(),
+        "2026-09-15T00:00:02Z".into(),
+        item,
+        /*initial_ordinal*/ Some(1),
+    )
+    .await
+    .unwrap();
+
+    let contents = std::fs::read_to_string(&path).unwrap();
+    let lines = contents.lines().collect::<Vec<_>>();
+    assert_eq!(lines.len(), 3);
+    assert_eq!(lines[1], torn);
+    let ordinals = lines
+        .iter()
