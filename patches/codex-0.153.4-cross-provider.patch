+/// The summary request offers the compaction's tools, but a reply that calls one is a failed
+/// summary: the call never runs and never reaches the history.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn portable_summary_that_calls_a_tool_fails_without_running_it() -> Result<()> {
+    let (server, mock) = ProviderMock::start(/*fail_portable_summary*/ false).await;
+    mock.answer_summaries_with_a_tool_call();
+    let codex_home = TempDir::new()?;
+    let (mut mcp, thread_id) =
+        gpt_thread_used_by_deepseek(codex_home.path(), &server, ThreadHistoryMode::Legacy).await?;
+    run_turn(&mut mcp, &thread_id, "gpt second question").await?;
+
+    let start = mock.request_count();
+    let notifications = compact(&mut mcp, &thread_id).await?;
+    assert!(
+        mock.requests_since(start)
+            .iter()
+            .any(|body| body["model"] == GPT_MODEL && request_kind(body) == RequestKind::Summary),
+        "expected a portable summary request"
+    );
+    let warnings = notifications
+        .iter()
+        .filter(|notification| notification.method == "warning")
+        .filter_map(|notification| notification.params.as_ref())
+        .filter_map(|params| serde_json::from_value::<WarningNotification>(params.clone()).ok())
+        .collect::<Vec<_>>();
+    assert!(
+        warnings.iter().any(|warning| warning
+            .message
+            .contains("the model called the update_plan tool instead of writing the summary")),
+        "missing summary failure warning: {warnings:?}"
+    );
+    assert!(
+        notifications
+            .iter()
+            .all(|notification| notification.method != "turn/plan/updated"),
+        "the summary's tool call must not run"
+    );
+    assert!(
+        notifications
+            .iter()
+            .any(|notification| notification.method == "turn/completed")
+    );
+
+    // The next request carries neither the call nor an output for it.
+    let next = mock.request_count();
+    run_turn(&mut mcp, &thread_id, "gpt question after compaction").await?;
+    let next_request = mock.first_request_since(next, GPT_MODEL);
+    assert_eq!(occurrences(&next_request, SUMMARY_TOOL_CALL), 0);
+    assert_eq!(occurrences(&next_request, GPT_CHECKPOINT), 1);
+
+    // The checkpoint records the failure, and what the failed request cost.
+    timeout(DEFAULT_READ_TIMEOUT, mcp.shutdown_gracefully()).await??;
+    drop(mcp);
+    let checkpoint = newest_checkpoint(codex_home.path(), &thread_id)?;
+    assert_eq!(
+        checkpoint["portable"]["status"],
+        json!({
+            "state": "failed",
+            "reason": "the model called the update_plan tool instead of writing the summary",
+        })
+    );
+    assert_eq!(checkpoint["portable"]["summary"], "");
+    assert_eq!(
+        checkpoint["portable"]["usage"]["input_tokens"],
+        SUMMARY_INPUT_TOKENS
+    );
+    assert_summary_ran_for_its_delay(&checkpoint);
+    Ok(())
+}
