+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn trigger_turn_mail_uses_selected_claude_task_and_its_validation() {
+    let harness = AgentControlHarness::new().await;
+    let mut config = harness.config.clone();
+    config.model_provider.agent = Some(
+        serde_json::from_value(serde_json::json!({
+            "kind": "claude_code",
+            "command": "unused-fixture-command",
+            "profile_id": "00000000-0000-0000-0000-000000000001"
+        }))
+        .expect("fixture agent"),
+    );
+    config.model_provider.requires_openai_auth = false;
+    let thread = harness
+        .manager
+        .start_thread(StartThreadOptions::new(config))
+        .await
+        .expect("idle Claude thread")
+        .thread;
+    thread
+        .session
+        .input_queue
+        .enqueue_mailbox_communication(
+            InterAgentCommunication::new(
+                AgentPath::root(),
+                AgentPath::root(),
+                Vec::new(),
+                "mailbox task".to_string(),
+                true,
+            ),
+            codex_protocol::turn_input::TurnStartOptions {
+                final_output_json_schema: Some(serde_json::json!({"type": "object"})),
+                ..Default::default()
+            },
+        )
+        .await;
+    thread.session.maybe_start_turn_for_pending_work().await;
+
+    // Claude's own validation happens before spawning a process. The incorrect
+    // RegularTask route instead tries the forbidden model API provider path.
+    let error = timeout(Duration::from_secs(5), async {
+        loop {
+            if let EventMsg::TurnComplete(completion) =
+                thread.next_event().await.expect("thread event").msg
+            {
+                break completion.error.expect("structured output refusal").message;
+            }
+        }
+    })
+    .await
+    .expect("mailbox task completes without a provider call");
+    assert!(error.contains("structured output is unavailable for this local agent"));
+}
+
+#[tokio::test]
+async fn v2_actor_with_disabled_turn_tools_delivers_completions_and_preserves_interrupt_status() {
+    let harness = AgentControlHarness::new().await;
+    let (parent_thread_id, _parent) = harness.start_thread().await;
+    let child_path = AgentPath::root().join("leaf").expect("child path");
+    let mut config = harness.config.clone();
+    let _ = config.features.enable(Feature::MultiAgentV2);
+    let child = harness
+        .manager
+        .start_thread(StartThreadOptions {
+            session_source: Some(SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                parent_thread_id,
+                depth: 1,
+                agent_path: Some(child_path.clone()),
+                agent_nickname: None,
+                agent_role: None,
+            })),
+            ..StartThreadOptions::new(config)
+        })
+        .await
+        .expect("idle child");
+    assert_eq!(
+        child.thread.multi_agent_version(),
+        Some(MultiAgentVersion::V2)
+    );
+
+    // This is the preset leaf split: its graph actor stays V2, while its
+    // captured turn exposes no delegation tools. No inference is submitted.
+    for message in ["first result", "follow-up result"] {
+        let mut turn = child.thread.session.new_default_turn().await;
+        Arc::get_mut(&mut turn)
+            .expect("unshared idle turn")
+            .multi_agent_version = MultiAgentVersion::Disabled;
+        child
+            .thread
+            .session
+            .send_event(
+                &turn,
+                EventMsg::TurnComplete(TurnCompleteEvent {
+                    turn_id: turn.sub_id.clone(),
+                    started_at: None,
+                    last_agent_message: Some(message.to_string()),
+                    error: None,
+                    completed_at: None,
+                    duration_ms: None,
+                    time_to_first_token_ms: None,
+                }),
+            )
+            .await;
+    }
+    let mut interrupted = child.thread.session.new_default_turn().await;
+    Arc::get_mut(&mut interrupted)
+        .expect("unshared idle turn")
+        .multi_agent_version = MultiAgentVersion::Disabled;
+    child
+        .thread
+        .session
+        .send_event(
+            &interrupted,
+            EventMsg::TurnAborted(TurnAbortedEvent {
+                turn_id: Some(interrupted.sub_id.clone()),
+                started_at: None,
+                reason: TurnAbortReason::Interrupted,
+                completed_at: None,
+                duration_ms: None,
+            }),
+        )
+        .await;
+    let results: Vec<_> = harness
+        .manager
+        .captured_ops()
+        .into_iter()
+        .filter_map(|(receiver, op)| match op {
+            Op::InterAgentCommunication { communication, .. }
+                if receiver == parent_thread_id && communication.author == child_path =>
+            {
+                Some(communication.content)
+            }
+            _ => None,
+        })
+        .collect();
+    let expected: Vec<_> = ["first result", "follow-up result"]
+        .into_iter()
+        .map(|message| {
+            crate::session_prefix::format_inter_agent_completion_message(
+                AgentPath::root(),
+                child_path.clone(),
+                &AgentStatus::Completed(Some(message.to_string())),
+            )
+            .expect("completion envelope")
+        })
+        .collect();
+    assert_eq!(
+        *child.thread.subscribe_status().borrow(),
+        AgentStatus::Interrupted
+    );
+    assert!(
+        crate::session_prefix::format_inter_agent_completion_message(
+            AgentPath::root(),
+            child_path,
+            &AgentStatus::Interrupted,
+        )
+        .is_none()
+    );
+    assert_eq!(results, expected);
+}
