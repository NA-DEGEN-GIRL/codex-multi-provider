+async fn an_anchor_needs_the_leaving_familys_own_base_and_replay() {
+    let config = crate::config::test_config().await;
+    let reference_context = turn_context(GPT_MODEL, "openai");
+    // The newest checkpoint is DeepSeek's: GPT's replay would not start from it.
+    let mut records = gpt_turns();
+    records.insert(
