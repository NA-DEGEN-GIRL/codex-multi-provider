+#[tokio::test]
+async fn opening_source_never_initializes_missing_databases() {
+    for existing_state in [false, true] {
+        let home = TempDir::new().expect("temp dir");
+        let config = test_config(home.path());
+        fs::write(home.path().join("unrelated.txt"), "leave source untouched")
+            .expect("write source sentinel");
+        let state = if existing_state {
+            Some(
+                codex_state::StateRuntime::init(
+                    config.sqlite.clone(),
+                    config.default_model_provider_id.clone(),
+                )
+                .await
+                .expect("initialize only state databases"),
+            )
+        } else {
+            None
+        };
+        assert!(!config.sqlite.thread_history_db_path().exists());
+        let before = source_snapshot(home.path());
+
+        let result =
+            ReadOnlyLocalThreadStore::open(home.path().to_path_buf(), config.sqlite.clone()).await;
+        match result {
+            Ok(reader) if existing_state => {
+                assert!(
+                    reader
+                        .list_metadata()
+                        .await
+                        .expect("read existing empty state")
+                        .is_empty()
+                );
+                reader.close().await;
+            }
+            Ok(reader) => {
+                reader.close().await;
+                panic!("missing source state database must fail without initializing it");
+            }
+            Err(error) => {
+                assert!(
+                    !existing_state,
+                    "existing state should allow metadata reads: {error}"
+                );
+                assert!(
+                    error
+                        .to_string()
+                        .contains("source history index unavailable or incomplete:"),
+                    "missing source index should return an actionable error: {error}"
+                );
+            }
+        }
+        assert_source_unchanged(home.path(), &before);
+        assert!(!config.sqlite.thread_history_db_path().exists());
+        if let Some(state) = state {
+            state.close().await;
+        }
+    }
+}
