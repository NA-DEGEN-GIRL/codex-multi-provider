+use super::ModelTranscriptBuilder;
+use crate::ResponseItemEnvelope;
+use crate::RolloutItem;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use serde_json::json;
+
+fn start(turn_id: &str) -> RolloutItem {
+    RolloutItem::EventMsg(EventMsg::TurnStarted(
+        serde_json::from_value(json!({ "turn_id": turn_id })).expect("valid turn start"),
+    ))
+}
+
+fn context(turn_id: &str, provider: &str, model: &str) -> RolloutItem {
+    RolloutItem::TurnContext(
+        serde_json::from_value(json!({
+            "turn_id": turn_id,
+            "cwd": std::env::current_dir().expect("working directory"),
+            "approval_policy": "never",
+            "sandbox_policy": { "type": "read-only" },
+            "model": model,
+            "model_provider": provider,
+            "summary": "auto"
+        }))
+        .expect("valid turn context"),
+    )
+}
+
+fn message(turn_id: &str, role: &str, text: &str) -> RolloutItem {
+    let mut item = ResponseItem::Message {
+        id: None,
+        role: role.into(),
+        content: vec![if role == "assistant" {
+            ContentItem::OutputText { text: text.into() }
+        } else {
+            ContentItem::InputText { text: text.into() }
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    };
+    // Session stamps this metadata before persisting each model-visible response.
+    item.set_turn_id_if_missing(turn_id);
+    RolloutItem::ResponseItem(ResponseItemEnvelope::new(item))
+}
+
+#[test]
+fn interleaved_stamped_responses_keep_their_own_turn_completion_and_provider() {
+    let records = [
+        start("claude-a"),
+        context("claude-a", "claude_code", "opus"),
+        message("claude-a", "user", "Claude request"),
+        start("gpt-b"),
+        context("gpt-b", "openai", "gpt-6-astra"),
+        message("gpt-b", "user", "Concurrent GPT request"),
+        // A completes after B's context marker, while B is still running.
+        message("claude-a", "assistant", "Claude answer"),
+        RolloutItem::EventMsg(EventMsg::TurnComplete(
+            serde_json::from_value(json!({ "turn_id": "claude-a" }))
+                .expect("valid turn completion"),
+        )),
+        message("gpt-b", "assistant", "Partial GPT answer"),
+    ];
+    let mut builder = ModelTranscriptBuilder::new();
+    for (position, record) in records.into_iter().enumerate() {
+        builder.push(position as u64, record);
+    }
+    let transcript = builder.finish();
+    let observed = transcript
+        .items
+        .iter()
+        .map(|item| {
+            let producer = &transcript.producers[item.producer.expect("recorded turn producer")];
+            (
+                item.turn_id.as_deref(),
+                item.completed,
+                producer.model_provider.as_deref(),
+                producer.model.as_str(),
+            )
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        observed,
+        vec![
+            (Some("claude-a"), true, Some("claude_code"), "opus"),
+            (Some("gpt-b"), false, Some("openai"), "gpt-6-astra"),
+            (Some("claude-a"), true, Some("claude_code"), "opus"),
+            (Some("gpt-b"), false, Some("openai"), "gpt-6-astra"),
+        ]
+    );
+}
+
+#[test]
+fn aborted_partial_turns_are_portable_without_completing_concurrent_turns() {
+    let mut builder = ModelTranscriptBuilder::new();
+    let records = [
+        start("a"),
+        context("a", "claude_code", "opus"),
+        message("a", "assistant", "Partial answer"),
+        start("b"),
+        context("b", "openai", "gpt-6-astra"),
+        message("b", "user", "Concurrent request"),
+        RolloutItem::EventMsg(EventMsg::TurnAborted(
+            serde_json::from_value(json!({
+                "turn_id":"a", "reason":"interrupted"
+            }))
+            .unwrap(),
+        )),
+    ];
+    for (position, record) in records.into_iter().enumerate() {
+        builder.push(position as u64, record);
+    }
+    let transcript = builder.finish();
+    assert_eq!(
+        transcript
+            .items
+            .iter()
+            .map(|item| (item.turn_id.as_deref(), item.completed))
+            .collect::<Vec<_>>(),
+        vec![(Some("a"), true), (Some("b"), false)]
+    );
+
+    let mut legacy = ModelTranscriptBuilder::new();
+    for (position, record) in [
+        start("legacy"),
+        context("legacy", "claude_code", "opus"),
+        message("legacy", "assistant", "Legacy partial answer"),
+        RolloutItem::EventMsg(EventMsg::TurnAborted(
+            serde_json::from_value(json!({"reason":"interrupted"})).unwrap(),
+        )),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        legacy.push(position as u64, record);
+    }
+    assert!(legacy.finish().items[0].completed);
+}
+
+#[test]
+fn legacy_abort_ignores_already_completed_turns_with_deferred_completion() {
+    let mut builder = ModelTranscriptBuilder::new();
+    for (position, record) in [
+        start("done"),
+        message("done", "assistant", "finished"),
+        RolloutItem::EventMsg(EventMsg::TurnComplete(
+            serde_json::from_value(json!({"turn_id":"done"})).unwrap(),
+        )),
+        start("interrupted"),
+        message("interrupted", "assistant", "partial"),
+        RolloutItem::EventMsg(EventMsg::TurnAborted(
+            serde_json::from_value(json!({"reason":"interrupted"})).unwrap(),
+        )),
+        start("active"),
+        message("active", "user", "still running"),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        builder.push(position as u64, record);
+    }
+    assert_eq!(
+        builder
+            .finish()
+            .items
+            .iter()
+            .map(|item| item.completed)
+            .collect::<Vec<_>>(),
+        vec![true, true, false]
+    );
+}
