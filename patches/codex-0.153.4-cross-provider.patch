+
+use foreign_state::OpaqueState;
+use foreign_state::opaque_state;
+
+/// Family of the OpenAI and Azure Responses providers.
+pub(crate) const OPENAI_PROVIDER_FAMILY: &str = "openai";
+
+/// Returns the family of a configured provider.
+pub(crate) fn provider_family(provider_id: &str, info: &ModelProviderInfo) -> String {
+    if provider_id == OPENAI_PROVIDER_ID
+        || info.is_openai()
+        || is_azure_responses_provider(&info.name, info.base_url.as_deref())
+    {
+        return OPENAI_PROVIDER_FAMILY.to_string();
+    }
+    // Encrypted state is bound to the credentials that produced it, which a shared endpoint does
+    // not imply, so every other provider only reads its own items.
+    provider_id.to_string()
+}
+
+/// Returns the family of a provider id recorded in history.
+///
+/// A provider that is no longer configured keeps its id as its family, so it never matches a
+/// different configured provider by accident.
+pub(crate) fn provider_family_for_id(config: &Config, provider_id: &str) -> String {
+    match config.model_providers.get(provider_id) {
+        Some(info) => provider_family(provider_id, info),
+        None if provider_id == OPENAI_PROVIDER_ID => OPENAI_PROVIDER_FAMILY.to_string(),
+        None => provider_id.to_string(),
+    }
+}
+
+/// Returns the family of the provider serving `turn_context`.
+pub(crate) fn current_provider_family(turn_context: &TurnContext) -> String {
+    provider_family(
+        &turn_context.config.model_provider_id,
+        turn_context.provider.info(),
+    )
+}
+
+/// Provider family and model a context is rebuilt for.
+#[derive(Clone, Debug)]
+pub(crate) struct TargetProvider {
+    pub(crate) family: String,
+    pub(crate) model: String,
+}
+
+impl TargetProvider {
+    pub(crate) fn of(turn_context: &TurnContext) -> Self {
+        Self {
+            family: current_provider_family(turn_context),
+            model: turn_context.model_info().slug.clone(),
+        }
+    }
+}
+
+/// Returns the family of the provider that served a recorded turn.
+///
+/// A recorded provider id always decides, whatever the model is called. Turns recorded before
+/// providers were tracked fall back to the provider their session was created with, when they use
+/// the model that session started with. Only turns with neither are attributed by model name: an
+/// OpenAI model, fine-tunes (`ft:<model>:...`) included, means the OpenAI family; any other model
+/// cannot be the OpenAI family, and is taken to be the target's own family only when it is the
+/// target's model. Otherwise the family is unknown.
+fn recorded_turn_family(
+    config: &Config,
+    producer: &TranscriptProducer,
+    target: &TargetProvider,
+) -> Option<String> {
+    if let Some(provider_id) = producer
+        .model_provider
+        .as_deref()
+        .or(producer.session_provider.as_deref())
+    {
+        return Some(provider_family_for_id(config, provider_id));
+    }
+    let model = producer.model.as_str();
+    let slug = model.to_ascii_lowercase();
+    let base_model = slug.strip_prefix("ft:").unwrap_or(&slug);
+    let openai_model = !base_model.starts_with("gpt-oss")
+        && ["gpt-", "o1", "o3", "o4", "codex-", "chatgpt-"]
+            .iter()
+            .any(|prefix| base_model.starts_with(prefix));
+    if openai_model {
+        Some(OPENAI_PROVIDER_FAMILY.to_string())
+    } else if target.family == OPENAI_PROVIDER_FAMILY {
+        Some(format!("model:{model}"))
+    } else {
+        (model == target.model).then(|| target.family.clone())
+    }
+}
+
+/// Returns the family whose opaque items a checkpoint's replacement history depends on.
+///
+/// `None` means the checkpoint is plaintext and any family can read it. Checkpoints written
+/// before origins were recorded belong to the turn that wrote them; without one, to the OpenAI
+/// family, the only one that compacted natively then.
+fn checkpoint_family(compacted: &CompactedItem, recorded_by: Option<&str>) -> Option<String> {
+    if let Some(origin) = &compacted.origin {
+        return Some(origin.provider_family.clone());
+    }
+    let mut family = None;
+    for envelope in compacted.replacement_history.iter().flatten() {
+        match opaque_state(&envelope.item) {
+            OpaqueState::Plaintext => {}
+            OpaqueState::Producer => {
+                return Some(recorded_by.unwrap_or(OPENAI_PROVIDER_FAMILY).to_string());
+            }
+            OpaqueState::OpenAi => family = Some(OPENAI_PROVIDER_FAMILY.to_string()),
+        }
+    }
+    family
+}
+
+/// Names who served a response, for its usage record: the configured provider and model, the
+/// manager's account tag when an OpenAI-family provider served it, and the head hash of the
+/// thread's newest request.
+pub(crate) fn served_by(turn_context: &TurnContext, thread_id: &str) -> ServedBy {
+    let account_tag = (current_provider_family(turn_context) == OPENAI_PROVIDER_FAMILY)
+        .then(manager_account_tag)
+        .flatten();
+    ServedBy {
+        provider_id: turn_context.config.model_provider_id.clone(),
+        model: turn_context.model_info().slug.clone(),
+        account_tag,
+        request_head: codex_api::prefix_check::last_request_head(thread_id),
+    }
+}
+
+/// The first 12 hex digits of the account fingerprint the manager launched this runtime for. The
+/// fingerprint is a domain-separated SHA-256 of the account id, not a credential; the manager
+/// tags its own records with the same prefix.
+fn manager_account_tag() -> Option<String> {
+    static TAG: std::sync::LazyLock<Option<String>> = std::sync::LazyLock::new(|| {
+        std::env::var("CODEX_MANAGER_EXPECTED_ACCOUNT_FINGERPRINT")
+            .ok()
+            .filter(|fingerprint| {
+                fingerprint.len() == 64 && fingerprint.bytes().all(|byte| byte.is_ascii_hexdigit())
+            })
+            .map(|fingerprint| fingerprint[..12].to_ascii_lowercase())
+    });
+    TAG.clone()
+}
+
+/// Describes the provider producing a new compaction checkpoint.
+pub(crate) fn compaction_origin(turn_context: &TurnContext) -> CompactionOrigin {
+    checkpoint_origin(turn_context, CheckpointKind::Compaction)
+}
+
+/// Describes the provider writing a checkpoint of `kind`.
+pub(crate) fn checkpoint_origin(
+    turn_context: &TurnContext,
+    kind: CheckpointKind,
+) -> CompactionOrigin {
+    CompactionOrigin {
+        provider_family: current_provider_family(turn_context),
+        provider_id: turn_context.config.model_provider_id.clone(),
+        model: turn_context.model_info().slug.clone(),
+        kind,
+    }
+}
+
+/// Records which history a new checkpoint summarizes: everything up to the newest item. A
+/// compaction that records its own output before its checkpoint adds how many items it recorded.
+pub(crate) fn coverage_of<'a>(
+    items: impl IntoIterator<Item = &'a ResponseItem>,
+) -> PortableCoverage {
+    let mut coverage = PortableCoverage::default();
+    for item in items {
+        if let Some(id) = item.id() {
+            coverage.through_item_id = Some(id.to_string());
+        }
+        if let Some(turn_id) = item.turn_id() {
+            coverage.through_turn_id = Some(turn_id.to_string());
+        }
+    }
+    coverage
+}
+
+/// Builds the portable form of a checkpoint from a summary attempt.
+pub(crate) fn portable_checkpoint(
+    summary: Result<String, String>,
+    covers: PortableCoverage,
+) -> PortableCheckpoint {
+    match summary {
+        Ok(summary) if !summary.trim().is_empty() => PortableCheckpoint {
+            summary,
+            status: PortableCheckpointStatus::Ready,
+            covers,
+            usage: None,
+            elapsed_ms: None,
+        },
+        Ok(_) => PortableCheckpoint {
+            summary: String::new(),
+            status: PortableCheckpointStatus::Failed {
+                reason: "the summary was empty".to_string(),
+            },
+            covers,
+            usage: None,
+            elapsed_ms: None,
+        },
+        Err(reason) => PortableCheckpoint {
+            summary: String::new(),
+            status: PortableCheckpointStatus::Failed { reason },
+            covers,
+            usage: None,
+            elapsed_ms: None,
+        },
+    }
+}
+
+/// Outcome of a portable summary request.
+#[derive(Debug)]
+pub(crate) struct PortableSummaryAttempt {
+    pub(crate) summary: Result<String, String>,
+    /// Usage the provider reported, when the request completed.
+    pub(crate) usage: Option<TokenUsage>,
+    /// How long the request ran, set by [`run_beside_compaction`].
+    pub(crate) elapsed: Option<Duration>,
+}
+
+impl PortableSummaryAttempt {
+    pub(crate) fn failed(reason: impl Into<String>) -> Self {
+        Self {
+            summary: Err(reason.into()),
+            usage: None,
+            elapsed: None,
+        }
+    }
+
+    fn ran_for(self, elapsed: Duration) -> Self {
+        Self {
+            elapsed: Some(elapsed),
+            ..self
+        }
+    }
+
+    /// Builds the portable form of the checkpoint this summary was requested for, with the
+    /// request's usage and running time whether or not it produced a summary.
+    pub(crate) fn into_checkpoint(self, covers: PortableCoverage) -> PortableCheckpoint {
+        PortableCheckpoint {
+            usage: self.usage.as_ref().map(PortableSummaryUsage::from),
+            elapsed_ms: self
+                .elapsed
+                .map(|elapsed| u64::try_from(elapsed.as_millis()).unwrap_or(u64::MAX)),
+            ..portable_checkpoint(self.summary, covers)
+        }
+    }
+}
+
+/// How long a portable summary may keep running after its compaction finished. The summary runs
+/// beside the compaction with the same settings and cached prefix, so it usually finishes about
+/// when the compaction does; a slow one is recorded as failed rather than holding up the thread.
+const PORTABLE_SUMMARY_GRACE_PERIOD: Duration = Duration::from_secs(30);
+
+/// Runs a compaction request and, when one is requested, the portable summary beside it.
+///
+/// The summary never holds back or fails the compaction: a failed compaction drops it, and once
+/// the compaction succeeds the summary gets [`PORTABLE_SUMMARY_GRACE_PERIOD`] more before it is
+/// recorded as failed. Every attempt records how long it ran, so a summary that ran out of time,
+/// and reported no usage, still shows what it took.
+pub(crate) async fn run_beside_compaction<T, E>(
+    compaction: impl Future<Output = Result<T, E>>,
+    summary: Option<impl Future<Output = PortableSummaryAttempt>>,
+) -> (Result<T, E>, Option<PortableSummaryAttempt>) {
+    let started = Instant::now();
+    // Boxed so the compaction's future does not grow by the second request's state.
+    let mut summary = Box::pin(async move {
+        match summary {
+            Some(summary) => Some(summary.await.ran_for(started.elapsed())),
+            None => None,
+        }
+    });
+    tokio::pin!(compaction);
+    tokio::select! {
+        result = &mut compaction => {
+            let summary = if result.is_ok() {
+                tokio::time::timeout(PORTABLE_SUMMARY_GRACE_PERIOD, &mut summary)
+                    .await
+                    .unwrap_or_else(|_| {
+                        Some(
+                            PortableSummaryAttempt::failed(
+                                "the summary did not finish in time after compaction",
+                            )
+                            .ran_for(started.elapsed()),
+                        )
+                    })
+            } else {
+                None
+            };
+            (result, summary)
+        }
+        summary = &mut summary => (compaction.await, summary),
+    }
+}
+
+/// Whether native compaction should also produce a plaintext summary.
+///
+/// The extra request only pays off when another family may continue this thread. It runs when:
+///
+/// - the thread was already served or compacted by another family, as its history records
+///   ([`ReplayProvenance::other_family_seen`]), which costs nothing to check; or
+/// - the manager shares threads between profiles (`CODEX_MANAGER_SHARED_EXECUTION` or
+///   `CODEX_RECORD_SHARED_APPEND`, the same signals the rollout writer uses) and this profile
+///   configures a provider of another family. Built-in providers do not count: they are always
+///   present and do not show intent to switch.
+///
+/// A thread that neither signal covers pays nothing, and continues on another family from its
+/// full transcript or its newest turns. Shared mode does not cover subagent threads: profiles do
+/// not switch them, so they pay only once their own history shows another family.
+pub(crate) async fn portable_summary_enabled(sess: &Session, turn_context: &TurnContext) -> bool {
+    if sess.thread_used_by_other_family().await {
+        return true;
+    }
+    if matches!(turn_context.session_source, SessionSource::SubAgent(_)) {
+        return false;
+    }
+    let shared = [
+        "CODEX_MANAGER_SHARED_EXECUTION",
+        "CODEX_RECORD_SHARED_APPEND",
+    ]
+    .iter()
+    .any(|name| std::env::var(name).as_deref() == Ok("1"));
+    if !shared {
+        return false;
+    }
+    let current_family = current_provider_family(turn_context);
+    let built_in =
+        codex_model_provider_info::built_in_model_providers(/*openai_base_url*/ None);
+    turn_context
+        .config
+        .model_providers
+        .iter()
+        .any(|(provider_id, info)| {
+            !built_in.contains_key(provider_id)
+                && provider_family(provider_id, info) != current_family
+        })
+}
+
+/// Asks for the portable summary as the reply's text. The summary request keeps the compaction's
+/// tools so that both requests share one cached prefix, but a reply that calls one is discarded
+/// (see [`SummaryReply`]).
+const PORTABLE_SUMMARY_TEXT_ONLY: &str = "Reply with the summary as plain text only, and do not call any tools: a reply that calls a tool is discarded.";
+
+/// Builds the portable summary request from the compaction request it runs beside.
+///
+/// It keeps the compaction's tools, instructions, tool settings, output format and history, and
+/// replaces only the trailing compaction trigger with the summary instruction. Providers cache a
+/// prompt by its prefix, and tools and instructions come first (Responses Lite sends them as the
+/// first input items), so the summary reads the history that earlier turns and the compaction
+/// beside it cached instead of paying for all of it again.
+///
+/// Without Responses Lite the request asks for no reasoning context, so the provider keeps only
+/// the current turn's reasoning, and the summary instruction starts a turn of its own: the
+/// summary may then diverge from the compaction at the latest turn's first reasoning item.
+pub(crate) fn portable_summary_prompt(compaction: &Prompt, compact_prompt: Option<&str>) -> Prompt {
+    let mut prompt = compaction.clone();
+    if matches!(
+        prompt.input.last(),
+        Some(ResponseItem::CompactionTrigger {})
+    ) {
+        prompt.input.pop();
+    }
+    let instruction = compact_prompt.unwrap_or(SUMMARIZATION_PROMPT);
+    prompt.input.push(ResponseItem::Message {
+        id: None,
+        role: "user".to_string(),
+        content: vec![ContentItem::InputText {
+            text: format!("{instruction}\n\n{PORTABLE_SUMMARY_TEXT_ONLY}"),
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    });
+    prompt
+}
+
+/// Requests a plaintext summary from the provider that is compacting the same history.
+///
+/// `prompt` comes from [`portable_summary_prompt`], and the request uses the compaction's
+/// reasoning and service tier settings. Reasoning effort is part of the cached prefix, and the
+/// Codex backend routes requests by service tier, so a summary with other settings would likely
+/// miss the compaction's cache and read the whole context at the uncached price. A faster tier
+/// bills the summary's input and output at its multiple; the recorded usage shows whether that
+/// pays off. `client_session` comes from the compaction's session and shares its sticky routing.
+///
+/// Its usage is recorded like any other response's and returned for the checkpoint. Its failure
+/// never fails the compaction; the caller records it on the checkpoint instead.
+pub(crate) async fn request_portable_summary(
+    sess: &Session,
+    step_context: &StepContext,
+    mut client_session: ModelClientSession,
+    prompt: &Prompt,
+    responses_metadata: &CodexResponsesMetadata,
+) -> PortableSummaryAttempt {
+    let turn_context = &step_context.turn;
+    let settings = compaction_request_settings(step_context);
+    let mut stream = match client_session
+        .stream(
+            prompt,
+            turn_context.model_info(),
+            &turn_context.session_telemetry,
+            settings.effort,
+            settings.summary,
+            settings.service_tier,
+            responses_metadata,
+            &InferenceTraceContext::disabled(),
+        )
+        .await
+    {
+        Ok(stream) => stream,
+        Err(err) => return PortableSummaryAttempt::failed(err.to_string()),
+    };
+    let mut reply = SummaryReply::default();
+    while let Some(event) = stream.next().await {
+        let event = match event {
+            Ok(event) => event,
+            Err(err) => return PortableSummaryAttempt::failed(err.to_string()),
+        };
+        match event {
+            ResponseEvent::OutputItemDone(item) => reply.observe(item),
+            ResponseEvent::Completed {
+                response_id,
+                token_usage,
+                usage_metadata,
+                ..
+            } => {
+                sess.record_observed_response_completed(
+                    turn_context,
+                    &response_id,
+                    token_usage.as_ref(),
+                    usage_metadata.as_ref(),
+                )
+                .await;
+                if let Some(token_usage) = &token_usage
+                    && let Err(err) = sess.record_rollout_budget_usage(token_usage)
+                {
+                    tracing::warn!("portable summary usage exceeded the rollout budget: {err}");
+                }
+                return PortableSummaryAttempt {
+                    summary: reply.finish(),
+                    usage: token_usage,
+                    elapsed: None,
+                };
+            }
+            _ => {}
+        }
+    }
+    PortableSummaryAttempt::failed("the summary stream closed before completion")
+}
+
+/// A portable summary reply: its assistant text, and the first tool it called.
+///
+/// A reply that calls a tool is not a summary. The summary never runs the calls it receives: they
+/// have no dispatcher here and never reach the history. A hosted tool (web search, image
+/// generation) has already run on the provider's side, and may be billed, by the time its call
+/// arrives; its reply is discarded all the same.
+#[derive(Debug, Default)]
+struct SummaryReply {
+    /// Text of the assistant's answer messages.
+    text: String,
+    /// Text of commentary messages, such as a preamble before the answer. It is the summary only
+    /// when the reply has no other text.
+    commentary: String,
+    called_tool: Option<String>,
+}
+
+impl SummaryReply {
+    fn observe(&mut self, item: ResponseItem) {
+        let tool = match item {
+            ResponseItem::Message {
+                role,
+                content,
+                phase,
+                ..
+            } if role == "assistant" => {
+                let text = if phase == Some(MessagePhase::Commentary) {
+                    &mut self.commentary
+                } else {
+                    &mut self.text
+                };
+                for content in content {
+                    if let ContentItem::OutputText { text: part } = content {
+                        text.push_str(&part);
+                    }
+                }
+                return;
+            }
+            ResponseItem::FunctionCall { name, .. } | ResponseItem::CustomToolCall { name, .. } => {
+                name
+            }
+            ResponseItem::LocalShellCall { .. } => "local_shell".to_string(),
+            ResponseItem::ToolSearchCall { .. } => "tool_search".to_string(),
+            ResponseItem::WebSearchCall { .. } => "web_search".to_string(),
+            ResponseItem::ImageGenerationCall { .. } => "image_generation".to_string(),
+            ResponseItem::AdditionalTools { .. }
+            | ResponseItem::Message { .. }
+            | ResponseItem::AgentMessage { .. }
+            | ResponseItem::Reasoning { .. }
+            | ResponseItem::FunctionCallOutput { .. }
+            | ResponseItem::CustomToolCallOutput { .. }
+            | ResponseItem::ToolSearchOutput { .. }
+            | ResponseItem::Compaction { .. }
+            | ResponseItem::CompactionTrigger {}
+            | ResponseItem::ContextCompaction { .. }
+            | ResponseItem::Other => return,
+        };
+        self.called_tool.get_or_insert(tool);
+    }
+
+    fn finish(self) -> Result<String, String> {
+        match self.called_tool {
+            Some(tool) => Err(format!(
+                "the model called the {tool} tool instead of writing the summary"
+            )),
+            None if self.text.trim().is_empty() => Ok(self.commentary),
+            None => Ok(self.text),
+        }
+    }
+}
+
+/// Who produced the history a resume or fork replay would install.
+#[derive(Debug, Default)]
+pub(crate) struct ReplayProvenance {
+    /// Family that produced the newest history, when recorded or inferable.
+    pub(crate) history_family: Option<String>,
+    /// Family the newest checkpoint's native items belong to; `None` when it is plaintext.
+    pub(crate) checkpoint_family: Option<String>,
+    /// Another family whose opaque items plain replay would send to the target.
+    pub(crate) foreign_opaque_family: Option<String>,
+    /// Whether another family served or compacted this thread, or an earlier compaction already
+    /// produced a portable summary for one.
+    pub(crate) other_family_seen: bool,
+}
+
+impl ReplayProvenance {
+    /// Returns the other family whose history requires a rebuild, if any.
+    pub(crate) fn changed_family(&self, target: &TargetProvider) -> Option<&str> {
+        [
+            &self.history_family,
+            &self.checkpoint_family,
+            &self.foreign_opaque_family,
+        ]
+        .into_iter()
+        .flatten()
+        .map(String::as_str)
+        .find(|family| *family != target.family)
+    }
+}
+
+/// Reads who produced the records a replay installs: the newest checkpoint with replacement
+/// history and everything after it.
+///
+/// Opaque items whose producer is unknown, for example history copied without turn records, keep
+/// plain replay as before; a rebuild triggered for another reason drops them. A legacy rollback
+/// recorded after the newest checkpoint may remove that checkpoint's turn, and replay then starts
+/// from an older one, so any other family's opaque state or checkpoint in the rollout counts.
+pub(crate) fn replay_provenance(
+    config: &Config,
+    rollout_items: &[RolloutItem],
+    target: &TargetProvider,
+) -> ReplayProvenance {
+    let mut provenance = ReplayProvenance::default();
+    let mut turn_family: Option<String> = None;
+    let mut session_hint = SessionProviderHint::default();
+    // Another family's opaque state or checkpoint anywhere in the rollout.
+    let mut foreign_anywhere: Option<String> = None;
+    let mut rolled_back_since_checkpoint = false;
+    let foreign_owner = |turn_family: Option<&String>, item: &ResponseItem| {
+        let owner = match opaque_state(item) {
+            OpaqueState::Plaintext => None,
+            OpaqueState::Producer => turn_family.cloned(),
+            OpaqueState::OpenAi => Some(OPENAI_PROVIDER_FAMILY.to_string()),
+        };
+        owner.filter(|owner| *owner != target.family)
+    };
+    for item in rollout_items {
+        let foreign = match item {
+            RolloutItem::SessionMeta(meta) => {
+                session_hint.observe_session_meta(meta);
+                None
+            }
+            RolloutItem::TurnContext(context) => {
+                if context.transcript == Some(codex_protocol::protocol::TranscriptKind::Plaintext) {
+                    provenance.other_family_seen = true;
+                    continue;
+                }
+                let producer = TranscriptProducer {
+                    model_provider: context.model_provider.clone(),
+                    model: context.model.clone(),
+                    session_provider: session_hint.provider_for(context),
+                };
+                turn_family = recorded_turn_family(config, &producer, target);
+                if let Some(family) = &turn_family {
+                    provenance.other_family_seen |= *family != target.family;
+                    provenance.history_family = Some(family.clone());
+                }
+                None
+            }
+            RolloutItem::Compacted(compacted) => {
+                if let Some(origin) = &compacted.origin {
+                    // A rebuilt context replaced another family's history.
+                    provenance.other_family_seen |= origin.provider_family != target.family
+                        || matches!(origin.kind, CheckpointKind::Rebuilt { .. });
+                    provenance.history_family = Some(origin.provider_family.clone());
+                }
+                if compacted.replacement_history.is_some() {
+                    let family = checkpoint_family(compacted, turn_family.as_deref());
+                    // A native checkpoint with a portable form was compacted for another family.
+                    provenance.other_family_seen |=
+                        family.is_some() && compacted.portable.is_some();
+                    if let Some(family) = family.as_ref().filter(|family| **family != target.family)
+                    {
+                        foreign_anywhere = Some(family.clone());
+                    }
+                    provenance.checkpoint_family = family;
+                    // Replay installs this checkpoint in place of everything before it.
+                    provenance.foreign_opaque_family = None;
+                    rolled_back_since_checkpoint = false;
+                }
+                None
+            }
+            RolloutItem::EventMsg(EventMsg::ThreadRolledBack(_)) => {
+                rolled_back_since_checkpoint = true;
+                None
+            }
+            RolloutItem::ResponseItem(envelope) => {
+                foreign_owner(turn_family.as_ref(), &envelope.item)
+            }
+            RolloutItem::InterAgentCommunication(communication) => communication
+                .encrypted_content
+                .is_some()
+                .then(|| foreign_owner(turn_family.as_ref(), &communication.to_model_input_item()))
+                .flatten(),
+            RolloutItem::InterAgentCommunicationMetadata { .. }
+            | RolloutItem::TokenUsageRecord(_)
+            | RolloutItem::WorldState(_)
+            | RolloutItem::SecurityRiskScore(_)
+            | RolloutItem::EventMsg(_)
+            | RolloutItem::RealtimeItem(_) => None,
+        };
+        if let Some(owner) = foreign {
+            foreign_anywhere = Some(owner.clone());
+            provenance.foreign_opaque_family = Some(owner);
+        }
+    }
+    if rolled_back_since_checkpoint && provenance.foreign_opaque_family.is_none() {
+        provenance.foreign_opaque_family = foreign_anywhere;
+    }
+    provenance
+}
+
+/// Builds a transcript from rollout records already in memory, such as a legacy rollout or a
+/// fork's inherited history. Only the records a transcript keeps are copied.
+pub(crate) fn transcript_from_rollout_items(rollout_items: &[RolloutItem]) -> ModelTranscript {
+    let mut builder = ModelTranscriptBuilder::new();
+    for (index, item) in rollout_items.iter().enumerate() {
+        builder.push_ref(u64::try_from(index).unwrap_or(u64::MAX), item);
+    }
+    builder.finish()
+}
+
+#[cfg(test)]
+#[path = "portable_context_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/portable_context/agent_summary.rs b/codex-rs/core/src/portable_context/agent_summary.rs
new file mode 100644
index 000000000..8631395bb
--- /dev/null
+++ b/codex-rs/core/src/portable_context/agent_summary.rs
@@ -0,0 +1,111 @@
+//! Uses host-verified local-agent summaries without rewriting the canonical transcript.
+use std::collections::BTreeMap;
+
+use codex_rollout::ModelTranscript;
+use sha1::Digest;
+use sha1::Sha1;
+
+/// Replaces the turns a verified local-agent summary covers with that summary.
+///
+/// Applying it clears the transcript's own checkpoints, whose positions describe the original
+/// items, so their portable summaries are lost. With `fit_tokens`, the summary is applied only
+/// when what remains fits; otherwise the caller rebuilds from those checkpoints instead of
+/// ending with neither summary.
+pub(crate) fn apply_verified_summary(transcript: &mut ModelTranscript, fit_tokens: Option<i64>) -> bool {
+    // Most cross-provider switches have no local-agent summary at all. Do not
+    // serialize and hash their entire (possibly gigabyte-sized) history merely
+    // to discover that there is no candidate to verify.
+    if !has_agent_summary(transcript) {
+        return false;
+    }
+    let mut hashes: BTreeMap<String, Sha1> = BTreeMap::new();
+    for item in &transcript.items {
+        if !item.completed {
+            continue;
+        }
+        let id = item
+            .turn_id
+            .clone()
+            .unwrap_or_else(|| format!("legacy-{}", item.position));
+        let hash = hashes.entry(id).or_default();
+        hash.update(
+            serde_json::to_vec(&(&item.item.item, &item.item.metadata)).unwrap_or_default(),
+        );
+        hash.update(b"\n");
+    }
+    let fingerprints: BTreeMap<_, _> = hashes
+        .into_iter()
+        .map(|(id, hash)| (id, format!("{:x}", hash.finalize())))
+        .collect();
+    let coverage = transcript.items.iter().rev().find_map(|item| {
+        if !item.completed {
+            return None;
+        }
+        let summary = item
+            .item
+            .metadata
+            .as_ref()?
+            .portable_agent_summary
+            .as_ref()?;
+        if summary.turn_fingerprints.is_empty()
+            || !summary
+                .turn_fingerprints
+                .iter()
+                .all(|(id, hash)| fingerprints.get(id) == Some(hash))
+            || item
+                .turn_id
+                .as_ref()
+                .is_some_and(|id| summary.turn_fingerprints.contains_key(id))
+        {
+            return None;
+        }
+        Some(summary.turn_fingerprints.clone())
+    });
+    let Some(coverage) = coverage else {
+        return false;
+    };
+    let id_of = |item: &codex_rollout::TranscriptItem| {
+        item.turn_id
+            .clone()
+            .unwrap_or_else(|| format!("legacy-{}", item.position))
+    };
+    if let Some(limit) = fit_tokens {
+        let remaining: i64 = transcript
+            .items
+            .iter()
+            .filter(|item| !coverage.contains_key(&id_of(item)))
+            .map(|item| super::budget::rebuild_token_count(&item.item.item))
+            .sum();
+        if remaining > limit {
+            return false;
+        }
+    }
+    // Covered turns can be noncontiguous: never use a through-turn cursor that would drop
+    // a concurrent provider's turn. Original records remain in the canonical store.
+    transcript.items.retain(|item| {
+        let id = item
+            .turn_id
+            .clone()
+            .unwrap_or_else(|| format!("legacy-{}", item.position));
+        !coverage.contains_key(&id)
+    });
+    // Their positional coverage describes the original transcript, not this portable view.
+    transcript.checkpoints.clear();
+    true
+}
+
+pub(crate) fn has_agent_summary(transcript: &ModelTranscript) -> bool {
+    transcript.items.iter().any(|item| {
+        item.completed
+            && item
+                .item
+                .metadata
+                .as_ref()
+                .and_then(|metadata| metadata.portable_agent_summary.as_ref())
+                .is_some_and(|summary| !summary.turn_fingerprints.is_empty())
+    })
+}
+
+#[cfg(test)]
+#[path = "agent_summary_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/portable_context/agent_summary_tests.rs b/codex-rs/core/src/portable_context/agent_summary_tests.rs
new file mode 100644
index 000000000..78d8f98c4
--- /dev/null
+++ b/codex-rs/core/src/portable_context/agent_summary_tests.rs
@@ -0,0 +1,63 @@
+use super::*;
+use codex_history::CodexHarnessMetadata;
+use codex_history::PortableAgentSummary;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_rollout::TranscriptCompleteness;
+use codex_rollout::TranscriptItem;
+use pretty_assertions::assert_eq;
+
+fn item(turn_id: &str, text: &str) -> TranscriptItem {
+    TranscriptItem {
+        turn_id: Some(turn_id.into()),
+        completed: true,
+        position: 0,
+        producer: None,
+        item: ResponseItemEnvelope::new(ResponseItem::Message {
+            id: None,
+            role: "assistant".into(),
+            content: vec![ContentItem::OutputText { text: text.into() }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }),
+    }
+}
+
+#[test]
+fn verified_summary_replaces_only_exact_covered_turns_and_rejects_edits() {
+    let earlier = item("gpt-1", "canonical original");
+    let mut hash = Sha1::new();
+    hash.update(serde_json::to_vec(&(&earlier.item.item, &earlier.item.metadata)).unwrap());
+    hash.update(b"\n");
+    let mut summary = item("claude-3", "portable summary");
+    summary.item.metadata = Some(CodexHarnessMetadata {
+        portable_agent_summary: Some(PortableAgentSummary {
+            source_profile: "profile-A".into(),
+            source_model: "opus".into(),
+            turn_fingerprints: BTreeMap::from([("gpt-1".into(), format!("{:x}", hash.finalize()))]),
+        }),
+        ..Default::default()
+    });
+    let concurrent = item("deepseek-2", "concurrent answer");
+    let mut transcript = ModelTranscript {
+        items: vec![earlier, concurrent.clone(), summary.clone()],
+        checkpoints: Vec::new(),
+        producers: Vec::new(),
+        completeness: TranscriptCompleteness::Complete,
+        rejected_checkpoints: 0,
+    };
+    let mut edited = transcript.clone();
+    edited.items[0] = item("gpt-1", "edited original");
+    let expected = edited.clone();
+    apply_verified_summary(&mut edited, None);
+    assert_eq!(edited, expected);
+    // When the uncovered remainder still does not fit, the summary is not applied: the
+    // transcript keeps its own checkpoints (and their portable summaries) for the rebuild.
+    let mut too_long = transcript.clone();
+    let unchanged = too_long.clone();
+    assert!(!apply_verified_summary(&mut too_long, Some(1)));
+    assert_eq!(too_long, unchanged);
+    assert!(apply_verified_summary(&mut transcript, Some(1_000_000)));
+    assert_eq!(transcript.items, vec![concurrent, summary]);
+}
diff --git a/codex-rs/core/src/portable_context/budget.rs b/codex-rs/core/src/portable_context/budget.rs
new file mode 100644
index 000000000..74db4c54d
--- /dev/null
+++ b/codex-rs/core/src/portable_context/budget.rs
@@ -0,0 +1,77 @@
+//! Sizes a rebuilt context so it stays below the limit that makes the target compact.
+//!
+//! The runtime's estimator counts 4 bytes of serialized item per token. That holds for English
+//! prose, but the rebuilt history must fit a tokenizer the runtime does not know, and it can run
+//! well above the estimate: CJK text such as Korean costs about one token or more per 3-byte
+//! character, and JSON-heavy tool output about one token per 3 bytes. A context sized with the
+//! plain estimate can then fill the window on the first request after the switch, and compact
+//! at once or fail. Rebuild sizes therefore count ASCII at 3 bytes per token and other text at
+//! 2 bytes per token (one and a half tokens per CJK character).
+
+use codex_protocol::models::ResponseItem;
+use codex_utils_output_truncation::approx_token_count;
+
+use crate::context_manager::estimate_item_token_count;
+
+/// Tool schemas are built per turn, after resume, so a rebuild assumes a typical tool set.
+const TOOL_SCHEMA_ESTIMATE_TOKENS: i64 = 8_000;
+
+/// Budget for a rebuilt context, in [`rebuild_token_count`] units.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct RebuildBudget {
+    /// Tokens the target may use before it compacts.
+    pub(crate) limit_tokens: i64,
+    /// Tokens every request needs besides history: base instructions, tool schemas and room for
+    /// the new user message and the response.
+    pub(crate) overhead_tokens: i64,
+}
+
+impl RebuildBudget {
+    /// Budget below `limit_tokens`, the smaller of the target's auto-compaction limit and usable
+    /// context window. Tool schemas take an assumed typical size, at most an eighth of the limit;
+    /// the new user message and the response take a tenth.
+    pub(crate) fn for_limit(limit_tokens: Option<i64>, base_instructions: &str) -> Self {
+        let base_tokens = text_token_count(base_instructions);
+        match limit_tokens {
+            Some(limit_tokens) => Self {
+                limit_tokens,
+                overhead_tokens: base_tokens
+                    .saturating_add(TOOL_SCHEMA_ESTIMATE_TOKENS.min(limit_tokens / 8))
+                    .saturating_add(limit_tokens / 10),
+            },
+            None => Self {
+                limit_tokens: i64::MAX,
+                overhead_tokens: base_tokens,
+            },
+        }
+    }
+}
+
+/// Estimates an item's tokens for a rebuild, erring high; see the module docs.
+///
+/// Starts from the runtime's estimate, which already prices images and encrypted payloads, and
+/// adds a third for denser ASCII plus a sixth of the item's non-ASCII bytes.
+pub(crate) fn rebuild_token_count(item: &ResponseItem) -> i64 {
+    let non_ascii_bytes = serde_json::to_string(item)
+        .map(|json| non_ascii_bytes(&json))
+        .unwrap_or_default();
+    conservative(estimate_item_token_count(item), non_ascii_bytes)
+}
+
+/// [`rebuild_token_count`] for plain text.
+pub(crate) fn text_token_count(text: &str) -> i64 {
+    conservative(
+        i64::try_from(approx_token_count(text)).unwrap_or(i64::MAX),
+        non_ascii_bytes(text),
+    )
+}
+
+fn conservative(estimate: i64, non_ascii_bytes: usize) -> i64 {
+    estimate
+        .saturating_add(estimate / 3)
+        .saturating_add(i64::try_from(non_ascii_bytes / 6).unwrap_or(i64::MAX))
+}
+
+fn non_ascii_bytes(text: &str) -> usize {
+    text.bytes().filter(|byte| !byte.is_ascii()).count()
+}
diff --git a/codex-rs/core/src/portable_context/foreign_state.rs b/codex-rs/core/src/portable_context/foreign_state.rs
new file mode 100644
index 000000000..b15f253cc
--- /dev/null
+++ b/codex-rs/core/src/portable_context/foreign_state.rs
@@ -0,0 +1,205 @@
+//! Opaque state carried by model items, and how an item is made readable for a family that cannot
+//! read it.
+//!
+//! Native compaction and encrypted reasoning belong to the family of the turn that produced them.
+//! Encrypted inter-agent messages and encrypted tool outputs are only ever created for OpenAI
+//! agents, so they belong to the OpenAI family whoever recorded them.
+
+use codex_protocol::models::AgentMessageInputContent;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ReasoningItemContent;
+use codex_protocol::models::ReasoningItemReasoningSummary;
+use codex_protocol::models::ResponseItem;
+
+use super::OPENAI_PROVIDER_FAMILY;
+
+/// Replaces an encrypted inter-agent message the target cannot read.
+pub(crate) const ENCRYPTED_MESSAGE_PLACEHOLDER: &str =
+    "[Message content unavailable: it was encrypted for a different model provider.]";
+
+/// Replaces encrypted tool output the target cannot read.
+pub(crate) const ENCRYPTED_TOOL_OUTPUT_PLACEHOLDER: &str =
+    "[Tool output unavailable: it was encrypted for a different model provider.]";
+
+/// Which family can read an item's opaque state.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum OpaqueState {
+    /// The item is plaintext.
+    Plaintext,
+    /// Only the family of the turn that produced the item.
+    Producer,
+    /// Only the OpenAI family.
+    OpenAi,
+}
+
+pub(crate) fn opaque_state(item: &ResponseItem) -> OpaqueState {
+    match item {
+        ResponseItem::Compaction { .. }
+        | ResponseItem::ContextCompaction { .. }
+        | ResponseItem::CompactionTrigger { .. } => OpaqueState::Producer,
+        ResponseItem::Reasoning {
+            encrypted_content, ..
+        } => {
+            if encrypted_content.is_some() {
+                OpaqueState::Producer
+            } else {
+                OpaqueState::Plaintext
+            }
+        }
+        ResponseItem::AgentMessage { content, .. } => {
+            if content
+                .iter()
+                .any(|part| matches!(part, AgentMessageInputContent::EncryptedContent { .. }))
+            {
+                OpaqueState::OpenAi
+            } else {
+                OpaqueState::Plaintext
+            }
+        }
+        ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } => {
+            if output.content_items().is_some_and(|parts| {
+                parts.iter().any(|part| {
+                    matches!(part, FunctionCallOutputContentItem::EncryptedContent { .. })
+                })
+            }) {
+                OpaqueState::OpenAi
+            } else {
+                OpaqueState::Plaintext
+            }
+        }
+        ResponseItem::Message { .. }
+        | ResponseItem::AdditionalTools { .. }
+        | ResponseItem::LocalShellCall { .. }
+        | ResponseItem::FunctionCall { .. }
+        | ResponseItem::ToolSearchCall { .. }
+        | ResponseItem::CustomToolCall { .. }
+        | ResponseItem::ToolSearchOutput { .. }
+        | ResponseItem::WebSearchCall { .. }
+        | ResponseItem::ImageGenerationCall { .. }
+        | ResponseItem::Other => OpaqueState::Plaintext,
+    }
+}
+
+/// Whether `target_family` can read everything in an item recorded by a turn of
+/// `producer_family`. State whose producer is unknown is readable by no family.
+pub(crate) fn readable_by(
+    item: &ResponseItem,
+    producer_family: Option<&str>,
+    target_family: &str,
+) -> bool {
+    match opaque_state(item) {
+        OpaqueState::Plaintext => true,
+        OpaqueState::Producer => producer_family == Some(target_family),
+        OpaqueState::OpenAi => target_family == OPENAI_PROVIDER_FAMILY,
+    }
+}
+
+/// An item made readable for another family.
+pub(crate) struct Readable {
+    /// `None` when nothing readable is left.
+    pub(crate) item: Option<ResponseItem>,
+    /// Encrypted message and tool-output parts replaced with a placeholder.
+    pub(crate) placeholders: usize,
+}
+
+/// Removes opaque state a family other than its owner cannot read, keeping any plaintext.
+///
+/// - Native compaction is dropped.
+/// - Encrypted reasoning loses its encrypted state. Its plaintext summary or content becomes an
+///   assistant message, the form every provider accepts; reasoning without either is dropped.
+/// - Encrypted parts of inter-agent messages and tool outputs become a plaintext placeholder.
+pub(crate) fn without_opaque_state(item: ResponseItem) -> Readable {
+    let mut placeholders = 0;
+    let item = match item {
+        ResponseItem::Compaction { .. }
+        | ResponseItem::ContextCompaction { .. }
+        | ResponseItem::CompactionTrigger { .. } => None,
+        ResponseItem::Reasoning {
+            summary,
+            content,
+            internal_chat_message_metadata_passthrough,
+            ..
+        } => {
+            let text = summary
+                .into_iter()
+                .map(|ReasoningItemReasoningSummary::SummaryText { text }| text)
+                .chain(content.into_iter().flatten().map(|part| match part {
+                    ReasoningItemContent::ReasoningText { text }
+                    | ReasoningItemContent::Text { text } => text,
+                }))
+                .filter(|text| !text.trim().is_empty())
+                .map(|text| ContentItem::OutputText { text })
+                .collect::<Vec<_>>();
+            (!text.is_empty()).then_some(ResponseItem::Message {
+                id: None,
+                role: "assistant".to_string(),
+                content: text,
+                phase: None,
+                internal_chat_message_metadata_passthrough,
+            })
+        }
+        ResponseItem::AgentMessage {
+            id,
+            author,
+            recipient,
+            mut content,
+            internal_chat_message_metadata_passthrough,
+        } => {
+            for part in &mut content {
+                if matches!(part, AgentMessageInputContent::EncryptedContent { .. }) {
+                    *part = AgentMessageInputContent::InputText {
+                        text: ENCRYPTED_MESSAGE_PLACEHOLDER.to_string(),
+                    };
+                    placeholders += 1;
+                }
+            }
+            Some(ResponseItem::AgentMessage {
+                id,
+                author,
+                recipient,
+                content,
+                internal_chat_message_metadata_passthrough,
+            })
+        }
+        mut item @ (ResponseItem::FunctionCallOutput { .. }
+        | ResponseItem::CustomToolCallOutput { .. }) => {
+            placeholders += replace_encrypted_tool_output(&mut item);
+            Some(item)
+        }
+        item @ (ResponseItem::Message { .. }
+        | ResponseItem::AdditionalTools { .. }
+        | ResponseItem::LocalShellCall { .. }
+        | ResponseItem::FunctionCall { .. }
+        | ResponseItem::ToolSearchCall { .. }
+        | ResponseItem::CustomToolCall { .. }
+        | ResponseItem::ToolSearchOutput { .. }
+        | ResponseItem::WebSearchCall { .. }
+        | ResponseItem::ImageGenerationCall { .. }
+        | ResponseItem::Other) => Some(item),
+    };
+    Readable { item, placeholders }
+}
+
+/// Replaces encrypted tool-output parts with a placeholder and returns how many were replaced.
+pub(crate) fn replace_encrypted_tool_output(item: &mut ResponseItem) -> usize {
+    let (ResponseItem::FunctionCallOutput { output, .. }
+    | ResponseItem::CustomToolCallOutput { output, .. }) = item
+    else {
+        return 0;
+    };
+    let Some(parts) = output.content_items_mut() else {
+        return 0;
+    };
+    let mut replaced = 0;
+    for part in parts.iter_mut() {
+        if matches!(part, FunctionCallOutputContentItem::EncryptedContent { .. }) {
+            *part = FunctionCallOutputContentItem::InputText {
+                text: ENCRYPTED_TOOL_OUTPUT_PLACEHOLDER.to_string(),
+            };
+            replaced += 1;
+        }
+    }
+    replaced
+}
diff --git a/codex-rs/core/src/portable_context/rebuild.rs b/codex-rs/core/src/portable_context/rebuild.rs
