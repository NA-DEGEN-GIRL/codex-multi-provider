+            .await
+            .expect("persist canonical topology");
+    }
+    let reader = ReadOnlyLocalThreadStore::open(
+        fixture.source_home.clone(),
+        binding.source_config().sqlite.clone(),
+    )
+    .await
+    .expect("open existing source read-only");
+    assert!(
+        reader
+            .list_thread_spawn_descendants(fixture.root, /*limit*/ 1)
+            .await
+            .is_err(),
+        "the reader must reject an incomplete subtree instead of truncating it"
+    );
+    let mut expected = vec![child, grandchild];
+    expected.sort_by_key(ToString::to_string);
+    assert_eq!(
+        reader
+            .list_thread_spawn_descendants(fixture.root, /*limit*/ 2)
+            .await
+            .expect("exact cap includes closed descendants"),
+        expected
+    );
+    fixture
+        .source_graph
+        .upsert_thread_spawn_edge(grandchild, fixture.root, ThreadSpawnEdgeStatus::Closed)
+        .await
+        .expect("seed corrupt cycle in persisted topology");
+    expected.push(fixture.root);
+    expected.sort_by_key(ToString::to_string);
+    assert_eq!(
+        reader
+            .list_thread_spawn_descendants(fixture.root, /*limit*/ 3)
+            .await
+            .expect("bounded distinct traversal exposes the cyclic root"),
+        expected
+    );
+    let before = fixture.bindings().await;
+    assert!(
+        fixture
+            .manager
+            .managed_activation_thread_ids(&binding)
+            .await
+            .is_err()
+    );
+    assert_eq!(fixture.bindings().await, before);
+    reader.close().await;
+}
