@@ -0,0 +1,115 @@
+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use codex_protocol::ThreadId;
+use pretty_assertions::assert_eq;
+use tokio::sync::Barrier;
+use tokio::sync::oneshot;
+
+use super::super::CommandHookRuntime;
+use crate::engine::CommandShell;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn sealing_racing_async_admission_never_certifies_pending_work_as_idle() {
+    for _ in 0..32 {
+        let (result_sender, _result_receiver) = async_channel::unbounded();
+        let runtime = CommandHookRuntime::new(
+            CommandShell {
+                program: String::new(),
+                args: Vec::new(),
+            },
+            Arc::new(Vec::new()),
+            ThreadId::new(),
+            result_sender,
+        );
+        let barrier = Arc::new(Barrier::new(3));
+        let calls = Arc::new(AtomicUsize::new(0));
+        let (release, released) = oneshot::channel();
+        let scheduled = tokio::spawn({
+            let runtime = runtime.clone();
+            let barrier = Arc::clone(&barrier);
+            let calls = Arc::clone(&calls);
+            async move {
+                barrier.wait().await;
+                runtime.schedule_async_task(async move {
+                    let _ = released.await;
+                    calls.fetch_add(1, Ordering::SeqCst);
+                });
+            }
+        });
+        let sealed = tokio::spawn({
+            let runtime = runtime.clone();
+            let barrier = Arc::clone(&barrier);
+            async move {
+                barrier.wait().await;
+                runtime.try_seal_for_managed_close()
+            }
+        });
+
+        barrier.wait().await;
+        scheduled.await.expect("scheduler finished");
+        let seal = sealed.await.expect("seal attempt finished");
+        let _ = release.send(());
+        tokio::time::timeout(Duration::from_secs(5), async {
+            while runtime.has_pending_work() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("admitted work completes without cancellation");
+
+        assert_eq!(calls.load(Ordering::SeqCst), usize::from(seal.is_none()));
+        if seal.is_none() {
+            let seal = tokio::time::timeout(Duration::from_secs(5), async {
+                loop {
+                    if let Some(seal) = runtime.try_seal_for_managed_close() {
+                        break seal;
+                    }
+                    tokio::task::yield_now().await;
+                }
+            })
+            .await
+            .expect("completed work can be sealed");
+            drop(seal);
+        }
+        assert!(runtime.try_start_dispatch().is_none());
+        runtime.shutdown().await;
+    }
+}
+
+#[tokio::test]
+async fn queued_async_work_prevents_seal_before_it_starts() {
+    let (result_sender, _result_receiver) = async_channel::unbounded();
+    let runtime = CommandHookRuntime::new(
+        CommandShell {
+            program: String::new(),
+            args: Vec::new(),
+        },
+        Arc::new(Vec::new()),
+        ThreadId::new(),
+        result_sender,
+    );
+    let (release, released) = oneshot::channel();
+    runtime.schedule_async_task(async move {
+        let _ = released.await;
+    });
+
+    // The current-thread executor has not polled the scheduled task yet.
+    assert!(runtime.has_pending_work());
+    assert!(runtime.try_seal_for_managed_close().is_none());
+    let dispatch = runtime
+        .try_start_dispatch()
+        .expect("busy seal changes nothing");
+    drop(dispatch);
+    release.send(()).expect("pending hook was not cancelled");
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while runtime.has_pending_work() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("pending work finishes");
+    runtime.shutdown().await;
+}
