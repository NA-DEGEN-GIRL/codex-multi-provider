+/// Asserts that `returned` sends `earlier`'s input unchanged as its prefix, with the same
+/// settings, as a provider's prompt cache needs to serve it.
+fn assert_resends_as_prefix(earlier: &Value, returned: &Value, label: &str) {
+    let (earlier_input, _) = split_input(earlier);
+    let (returned_input, _) = split_input(returned);
+    assert!(
+        returned_input.len() > earlier_input.len(),
+        "{label}: the return request is shorter than the earlier one"
+    );
+    assert_eq!(
+        &returned_input[..earlier_input.len()],
+        earlier_input.as_slice(),
+        "{label}: the earlier request is not a prefix of the return request"
+    );
+    assert_eq!(
+        request_settings(returned),
+        request_settings(earlier),
+        "{label}"
+    );
+}
