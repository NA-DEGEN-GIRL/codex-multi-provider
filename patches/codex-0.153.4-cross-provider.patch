+#[test]
+/// A rebuilt checkpoint's return anchors and splice marker are optional: older checkpoints read
+/// without them, older readers see only the family, and an anchor this version cannot read is
+/// dropped without making the checkpoint's origin unknown.
+fn rebuilt_checkpoint_anchors_are_optional_and_lenient() -> Result<()> {
+    let anchor = ReturnAnchor {
+        provider_family: "openai".to_string(),
+        provider_id: "openai".to_string(),
+        model: "gpt-test".to_string(),
+        base_position: Some(4),
+        cut_position: 12,
+        items: 7,
+        digest: "0123abcd".to_string(),
+        request_head: Some("head".to_string()),
+        reference_context: json!({"model": "gpt-test"}),
+        world_state: serde_json::Map::from_iter([("model".to_string(), json!("gpt-test"))]),
+    };
+    let spliced = CompactionOrigin {
+        provider_family: "openai".to_string(),
+        provider_id: "openai".to_string(),
+        model: "gpt-test".to_string(),
+        kind: CheckpointKind::Rebuilt {
+            from_family: "deepseek".to_string(),
+            spliced: Some(9),
+            return_anchors: vec![anchor.clone()],
+        },
+    };
+    let written = serde_json::to_value(&spliced)?;
+    assert_eq!(
+        serde_json::from_value::<CompactionOrigin>(written)?,
+        spliced
+    );
+
+    // A checkpoint written before anchors existed.
+    let older = serde_json::from_value::<CompactionOrigin>(json!({
+        "provider_family": "openai",
+        "kind": {"type": "rebuilt", "from_family": "deepseek"},
+    }))?;
+    assert_eq!(
+        older.kind,
+        CheckpointKind::Rebuilt {
+            from_family: "deepseek".to_string(),
+            spliced: None,
+            return_anchors: Vec::new(),
+        }
+    );
+
+    // A malformed anchor is dropped; the valid one and the origin survive.
+    let mut anchors = vec![serde_json::to_value(&anchor)?, json!({"cut_position": "x"})];
+    anchors.reverse();
+    let mixed = serde_json::from_value::<CompactionOrigin>(json!({
+        "provider_family": "openai",
+        "kind": {"type": "rebuilt", "from_family": "deepseek", "return_anchors": anchors},
+    }))?;
+    assert_eq!(
+        mixed.kind,
+        CheckpointKind::Rebuilt {
+            from_family: "deepseek".to_string(),
+            spliced: None,
+            return_anchors: vec![anchor],
+        }
+    );
+    let not_a_list = serde_json::from_value::<CompactionOrigin>(json!({
+        "provider_family": "openai",
+        "kind": {"type": "rebuilt", "from_family": "deepseek", "return_anchors": "x"},
+    }))?;
+    assert_eq!(
+        not_a_list.kind,
+        CheckpointKind::Rebuilt {
+            from_family: "deepseek".to_string(),
+            spliced: None,
+            return_anchors: Vec::new(),
+        }
+    );
+    Ok(())
+}
