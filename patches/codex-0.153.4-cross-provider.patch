+#[path = "submission_admission_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/session/submission_admission_tests.rs b/codex-rs/core/src/session/submission_admission_tests.rs
new file mode 100644
index 000000000..b646c5a23
--- /dev/null
+++ b/codex-rs/core/src/session/submission_admission_tests.rs
@@ -0,0 +1,56 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn submission() -> Submission {
+    Submission {
+        id: "test".into(),
+        op: Op::Interrupt,
+        trace: None,
+        parent_turn_id: None,
+        root_turn_id: None,
+    }
+}
+
+#[tokio::test]
+async fn reservation_rejects_late_internal_mail_without_enqueuing_it() {
+    let (sender, receiver) = async_channel::bounded(4);
+    let sender = SubmissionSender::from(sender);
+    let reservation = sender.try_reserve_idle_close().unwrap();
+    assert!(sender.send(submission()).await.is_err());
+    assert!(receiver.is_empty());
+    drop(reservation);
+    sender.send(submission()).await.unwrap();
+    assert_eq!(receiver.len(), 1);
+}
+
+#[test]
+fn child_admission_and_queued_work_prevent_a_close_reservation() {
+    let (sender, _receiver) = async_channel::bounded(4);
+    let sender = SubmissionSender::from(sender);
+    let child = sender.try_admit().unwrap();
+    assert_eq!(sender.active_admissions(), 1);
+    assert!(sender.try_reserve_idle_close().is_err());
+    drop(child);
+    assert_eq!(sender.active_admissions(), 0);
+    assert!(sender.try_reserve_idle_close().is_ok());
+    sender.sender.try_send(submission()).unwrap();
+    assert!(sender.try_reserve_idle_close().is_err());
+}
+
+#[tokio::test]
+async fn close_operation_keeps_the_seal_when_its_caller_disconnects() {
+    let (sender, receiver) = async_channel::bounded(4);
+    let sender = SubmissionSender::from(sender);
+    let reservation = sender.try_reserve_idle_close().unwrap();
+    let (reply, result) = oneshot::channel();
+    sender.request_idle_shutdown(reservation, reply).unwrap();
+    drop(result);
+    assert!(sender.send(submission()).await.is_err());
+    let Op::CloseIdleAndShutdown { mut admission, .. } = receiver.recv().await.unwrap().op else {
+        panic!("expected close operation");
+    };
+    *admission = true;
+    drop(admission);
+    assert!(sender.send(submission()).await.is_err());
+    assert!(receiver.is_empty());
+}
