+#[tokio::test]
+async fn competing_cold_child_writer_refuses_close_without_fencing_the_root() -> Result<()> {
+    let fixture = ColdTreeFixture::new().await?;
+    let mut app = fixture.resume_root().await?;
+    let source_id = ManagedSourceId {
+        host_id: "local".to_string(),
+        store_id: fixture.source_id.clone(),
+    };
+    let home = fs::canonicalize(fixture.home.path())?;
+    let registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        fixture.profile_id.clone(),
+        vec![ManagedSourceRegistration {
+            source_id: source_id.clone(),
+            config: LocalThreadStoreConfig {
+                codex_home: home.clone(),
+                sqlite: codex_state::SqliteConfig::new_for_testing(AbsolutePathBuf::try_from(
+                    home,
+                )?),
+                default_model_provider_id: "mock_provider".to_string(),
+            },
+        }],
+    )?;
+    let binding = registry
+        .bind(
+            &source_id,
+            ThreadId::from_string(&fixture.child_id)?,
+            ManagedAuthorityGrant {
+                owner_profile_id: fixture.profile_id.clone(),
+                epoch: 1,
+                revision: 1,
+            },
+        )
+        .await?;
+    // The test executable and app-server are different OS processes. Hold the
+    // same canonical writer lock here without creating a child runtime.
+    let writer = binding.prepare_writer().await?;
+    let history_before = fs::read(&fixture.child_rollout)?;
+    let graph_before = fixture.open_children().await?;
+    let authority_before = fs::read(
+        fixture
+            .home
+            .path()
+            .join("managed-authority")
+            .join(format!("{}.json", fixture.root_id)),
+    )?;
+    let requests_before = fixture.model_request_count().await?;
+    let request_id = app
+        .send_raw_request(
+            "thread/managedCloseIdle",
+            Some(json!({ "threadId": fixture.root_id })),
+        )
+        .await?;
+    let rejected = timeout(
+        READ_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(request_id)),
+    )
+    .await??;
+    assert_eq!(rejected.error.code, -32600);
+    assert_eq!(loaded_ids(&mut app).await?, vec![fixture.root_id.clone()]);
+    assert_eq!(fs::read(&fixture.child_rollout)?, history_before);
+    assert_eq!(fixture.open_children().await?, graph_before);
+    assert_eq!(
+        fs::read(
+            fixture
+                .home
+                .path()
+                .join("managed-authority")
+                .join(format!("{}.json", fixture.root_id))
+        )?,
+        authority_before
+    );
+    assert_eq!(fixture.model_request_count().await?, requests_before);
+    assert!(binding.verify_writer_absent().await.is_err());
+
+    let completed = timeout(
+        READ_TIMEOUT,
+        app.start_turn_and_wait_for_completion(turn_params(
+            &fixture.root_id,
+            "Continue the unaffected root",
+        )),
+    )
+    .await??;
+    assert_eq!(
+        (completed.turn.status, completed.turn.error),
+        (TurnStatus::Completed, None)
+    );
+    assert_eq!(fs::read(&fixture.child_rollout)?, history_before);
+    drop(writer);
+    binding.verify_writer_absent().await?;
+    Ok(())
+}
