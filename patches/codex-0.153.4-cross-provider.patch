+use super::*;
+use codex_history::ResponseItemEnvelope;
+use codex_rollout::TranscriptCompleteness;
+use codex_rollout::TranscriptItem;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn transcript() -> ModelTranscript {
+    ModelTranscript {
+        items: vec![
+            item("gpt-1", true, "earlier answer"),
+            item("concurrent", false, "not finished"),
+            item("claude-current", false, "current user request"),
+        ],
+        checkpoints: Vec::new(),
+        completeness: TranscriptCompleteness::Complete,
+        rejected_checkpoints: 0,
+        producers: Vec::new(),
+    }
+}
+
+fn item(turn: &str, completed: bool, text: &str) -> TranscriptItem {
+    TranscriptItem {
+        turn_id: Some(turn.into()),
+        completed,
+        position: 0,
+        producer: None,
+        item: ResponseItemEnvelope::new(ResponseItem::Message {
+            id: None,
+            role: "user".into(),
+            content: vec![ContentItem::InputText { text: text.into() }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }),
+    }
+}
+
+#[test]
+fn coverage_excludes_other_inflight_turns_and_detects_edited_answers() {
+    let mut transcript = transcript();
+    let before = snapshot(&transcript, "claude-current");
+    assert_eq!(before.turn_ids, vec!["gpt-1", "claude-current"]);
+    let ready = json!({"session":{"dirty":false,"covered":["gpt-1"],"turn_fingerprints":before.turn_fingerprints}});
+    assert_eq!(
+        resumable(&ready, &transcript, &before, "claude-current"),
+        Some(HashSet::from(["gpt-1".to_string()]))
+    );
+    transcript.items[0] = item("gpt-1", true, "edited answer");
+    let after = snapshot(&transcript, "claude-current");
+    assert_eq!(
+        resumable(&ready, &transcript, &after, "claude-current"),
+        None
+    );
+}
+
+#[test]
+fn dirty_or_rolled_back_sessions_restart_without_reusing_private_state() {
+    let transcript = transcript();
+    let snapshot = snapshot(&transcript, "claude-current");
+    for session in [
+        json!({"dirty":true,"covered":[]}),
+        json!({"dirty":false,"covered":["removed"],"turn_fingerprints":{"removed":"old"}}),
+        json!({"dirty":false,"covered":["claude-current"],"turn_fingerprints":snapshot.turn_fingerprints}),
+    ] {
+        assert_eq!(
+            resumable(
+                &json!({ "session": session }),
+                &transcript,
+                &snapshot,
+                "claude-current"
+            ),
+            None
+        );
+    }
+}
+
+fn checkpoint_before(items_before: usize) -> codex_rollout::TranscriptCheckpoint {
+    codex_rollout::TranscriptCheckpoint {
+        position: items_before as u64,
+        items_before,
+        compacted: codex_history::CompactedItem {
+            message: format!("summary of {items_before}"),
+            replacement_history: None,
+            guardian_history: None,
+            mcp_resource_origins: None,
+            window_number: None,
+            first_window_id: None,
+            previous_window_id: None,
+            window_id: None,
+            compaction_response_id: None,
+            latest_token_usage_record: None,
+            origin: None,
+            portable: None,
+        },
+        producer: None,
+    }
+}
+
+#[test]
+fn an_early_interrupted_turn_keeps_every_later_summary() {
+    // A long GPT task: an interrupted turn, then two compactions and a tail. Dropping the
+    // interrupted item used to discard both summaries and refuse the handoff.
+    let mut transcript = ModelTranscript {
+        items: vec![
+            item("t1", true, "first"),
+            item("interrupted", false, "never finished"),
+            item("t2", true, "second"),
+            item("t3", true, "third"),
+            item("t4", true, "tail"),
+            item("claude-current", false, "current request"),
+        ],
+        checkpoints: vec![checkpoint_before(3), checkpoint_before(4)],
+        completeness: TranscriptCompleteness::Complete,
+        rejected_checkpoints: 0,
+        producers: Vec::new(),
+    };
+    unseen_completed(&mut transcript, &HashSet::new(), /*budget_tokens*/ i64::MAX);
+    let texts: Vec<_> = transcript
+        .items
+        .iter()
+        .map(|item| item.turn_id.clone().unwrap_or_default())
+        .collect();
+    assert_eq!(texts, vec!["t1", "t2", "t3", "t4"]);
+    let offsets: Vec<_> = transcript
+        .checkpoints
+        .iter()
+        .map(|checkpoint| checkpoint.items_before)
+        .collect();
+    assert_eq!(offsets, vec![2, 3]);
+}
+
+#[test]
+fn checkpoints_after_a_covered_turn_are_still_dropped() {
+    let mut transcript = ModelTranscript {
+        items: vec![
+            item("seen", true, "Claude already has this"),
+            item("t2", true, "new"),
+        ],
+        checkpoints: vec![checkpoint_before(0), checkpoint_before(2)],
+        completeness: TranscriptCompleteness::Complete,
+        rejected_checkpoints: 0,
+        producers: Vec::new(),
+    };
+    unseen_completed(
+        &mut transcript,
+        &HashSet::from(["seen".to_string()]),
+        /*budget_tokens*/ i64::MAX,
+    );
+    assert_eq!(transcript.items.len(), 1);
+    assert_eq!(transcript.checkpoints.len(), 1);
+    assert_eq!(transcript.checkpoints[0].items_before, 0);
+}
+
+#[test]
+fn summaries_after_a_covered_turn_are_used_when_unseen_work_does_not_fit() {
+    // A resumed Claude session saw one early turn; another provider then worked on, and /compact
+    // wrote a portable summary at the end. Without that summary the unseen work cannot be
+    // handed over at all, so it is kept even though it repeats the covered turn.
+    let mut transcript = ModelTranscript {
+        items: vec![
+            item("seen", true, "Claude already has this"),
+            item("gpt-1", true, "long other-provider work"),
+            item("gpt-2", true, "more other-provider work"),
+        ],
+        checkpoints: vec![checkpoint_before(0), checkpoint_before(3)],
+        completeness: TranscriptCompleteness::Complete,
+        rejected_checkpoints: 0,
+        producers: Vec::new(),
+    };
+    unseen_completed(
+        &mut transcript,
+        &HashSet::from(["seen".to_string()]),
+        /*budget_tokens*/ 1,
+    );
+    assert_eq!(transcript.items.len(), 2);
+    assert_eq!(
+        transcript
+            .checkpoints
+            .iter()
+            .map(|checkpoint| checkpoint.items_before)
+            .collect::<Vec<_>>(),
+        vec![0, 2]
+    );
+}
+
+fn reply(turn: &str, text: &str) -> TranscriptItem {
+    TranscriptItem {
+        turn_id: Some(turn.into()),
+        completed: true,
+        position: 0,
+        producer: None,
+        item: ResponseItemEnvelope::new(ResponseItem::Message {
+            id: None,
+            role: "assistant".into(),
+            content: vec![ContentItem::OutputText { text: text.into() }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }),
+    }
+}
+
+/// A task whose previous Claude request stopped on an expired login, then another provider ran.
+fn stopped_task(mut items: Vec<TranscriptItem>) -> ModelTranscript {
+    for (position, item) in items.iter_mut().enumerate() {
+        item.position = position as u64;
+    }
+    ModelTranscript {
+        items,
+        checkpoints: Vec::new(),
+        completeness: TranscriptCompleteness::Complete,
+        rejected_checkpoints: 0,
+        producers: Vec::new(),
+    }
+}
+
+fn stopped_items() -> Vec<TranscriptItem> {
+    vec![
+        item("seen", true, "committed by an earlier Claude request"),
+        item("handed", true, "handed over to the stopped request"),
+        item("stopped", true, "request that hit the expired login"),
+        reply("stopped", "partial work before the login expired"),
+        item("gpt-after", true, "another provider's later turn"),
+        item("claude-current", false, "current request"),
+    ]
+}
+
+/// The runner's ledger record after the stop: still dirty, with the hello's prior fingerprints.
+fn login_stop(snapshot: &Snapshot) -> Value {
+    let fingerprint = |id: &str| snapshot.turn_fingerprints[id].clone();
+    json!({"session":{"dirty":true,"covered":["seen"],"turn_fingerprints":{"seen":fingerprint("seen")},
+        "auth_stop":{"turn_id":"stopped","turn_fingerprints":{"seen":fingerprint("seen"),"handed":fingerprint("handed")}}}})
+}
+
+#[test]
+fn a_login_stop_resumes_and_leaves_the_stopped_turn_out_of_the_handoff() {
+    let mut transcript = stopped_task(stopped_items());
+    let snapshot = snapshot(&transcript, "claude-current");
+    let covered = resumable(
+        &login_stop(&snapshot),
+        &transcript,
+        &snapshot,
+        "claude-current",
+    )
+    .expect("a clean login stop resumes");
+    assert_eq!(
+        covered,
+        HashSet::from(["seen", "handed", "stopped"].map(String::from))
+    );
+    unseen_completed(&mut transcript, &covered, /*budget_tokens*/ i64::MAX);
+    let handed: Vec<_> = transcript
+        .items
+        .iter()
+        .map(|item| item.turn_id.clone().unwrap_or_default())
+        .collect();
+    assert_eq!(handed, vec!["gpt-after"]);
+}
+
+#[test]
+fn a_login_stop_restarts_fresh_after_queued_input_rollback_or_edits() {
+    let queued = {
+        let mut items = stopped_items();
+        items.insert(
+            4,
+            item("stopped", true, "steering queued while the request ran"),
+        );
+        items
+    };
+    let silent = {
+        let mut items = stopped_items();
+        items.remove(3);
+        items
+    };
+    let rolled_back = stopped_items()
+        .into_iter()
+        .filter(|item| item.turn_id.as_deref() != Some("stopped"))
+        .collect();
+    let mut edited = stopped_items();
+    edited[1] = item("handed", true, "edited after the stop");
+    let original = snapshot(&stopped_task(stopped_items()), "claude-current");
+    for items in [queued, silent, rolled_back, edited] {
+        let transcript = stopped_task(items);
+        let snapshot = snapshot(&transcript, "claude-current");
+        assert_eq!(
+            resumable(
+                &login_stop(&original),
+                &transcript,
+                &snapshot,
+                "claude-current"
+            ),
+            None
+        );
+    }
+    // The stopped request itself is never resumed as a new turn.
+    let transcript = stopped_task(stopped_items());
+    let snapshot = snapshot(&transcript, "stopped");
+    assert_eq!(
+        resumable(&login_stop(&original), &transcript, &snapshot, "stopped"),
+        None
+    );
+}
