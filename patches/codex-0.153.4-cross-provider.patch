+use super::*;
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::SystemTime;
+
+use chrono::DateTime;
+use chrono::Utc;
+use codex_protocol::protocol::SessionSource;
+use codex_state::ThreadMetadataBuilder;
+use codex_thread_store::SortDirection;
+use codex_thread_store::ThreadSortKey;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+
+fn config(home: &Path) -> LocalThreadStoreConfig {
+    LocalThreadStoreConfig {
+        codex_home: home.to_path_buf(),
+        sqlite: codex_state::SqliteConfig::new_for_testing(
+            AbsolutePathBuf::try_from(home).unwrap(),
+        ),
+        default_model_provider_id: "test-provider".to_string(),
+    }
+}
+
+fn snapshot(root: &Path) -> BTreeMap<PathBuf, (Vec<u8>, SystemTime)> {
+    let mut result = BTreeMap::new();
+    let mut directories = vec![root.to_path_buf()];
+    while let Some(directory) = directories.pop() {
+        for entry in fs::read_dir(directory).unwrap() {
+            let path = entry.unwrap().path();
+            let metadata = fs::metadata(&path).unwrap();
+            let contents = if metadata.is_dir() {
+                directories.push(path.clone());
+                Vec::new()
+            } else {
+                fs::read(&path).unwrap()
+            };
+            result.insert(
+                path.strip_prefix(root).unwrap().to_path_buf(),
+                (contents, metadata.modified().unwrap()),
+            );
+        }
+    }
+    result
+}
+
+fn list_params(cwd: &Path) -> ListThreadsParams {
+    ListThreadsParams {
+        page_size: 1,
+        cursor: None,
+        sort_key: ThreadSortKey::RecencyAt,
+        sort_direction: SortDirection::Desc,
+        allowed_sources: vec![SessionSource::Cli],
+        model_providers: Some(vec!["test-provider".to_string()]),
+        cwd_filters: Some(vec![cwd.to_path_buf()]),
+        section: Some(None),
+        project_id: Some(None),
+        archived: false,
+        search_term: Some("Needle".to_string()),
+        relation_filter: None,
+        use_state_db_only: true,
+    }
+}
+
+#[tokio::test]
+async fn list_open_does_not_initialize_a_missing_source_database() {
+    let home = tempfile::tempdir().unwrap();
+    fs::write(home.path().join("sentinel.txt"), "preserve source").unwrap();
+    let before = snapshot(home.path());
+
+    assert!(open_list(config(home.path())).await.is_err());
+
+    assert_eq!(snapshot(home.path()), before);
+}
+
+#[tokio::test]
+async fn filtered_recency_pages_and_project_reads_preserve_source_bytes_and_times() {
+    let home = tempfile::tempdir().unwrap();
+    let configuration = config(home.path());
+    let state = codex_state::StateRuntime::init(
+        configuration.sqlite.clone(),
+        configuration.default_model_provider_id.clone(),
+    )
+    .await
+    .unwrap();
+    let cwd = home.path().join("project");
+    let other_cwd = home.path().join("other-project");
+    fs::create_dir_all(&cwd).unwrap();
+    fs::create_dir_all(&other_cwd).unwrap();
+    fs::create_dir_all(home.path().join("sessions")).unwrap();
+    let earlier = ThreadId::from_string("00000000-0000-0000-0000-000000000001").unwrap();
+    let later = ThreadId::from_string("00000000-0000-0000-0000-000000000002").unwrap();
+    let archived = ThreadId::from_string("00000000-0000-0000-0000-000000000003").unwrap();
+    let wrong_cwd = ThreadId::from_string("00000000-0000-0000-0000-000000000004").unwrap();
+    let wrong_case = ThreadId::from_string("00000000-0000-0000-0000-000000000005").unwrap();
+    let tied_time = DateTime::<Utc>::from_timestamp_millis(1_700_000_000_000).unwrap();
+
+    // Seed a later timestamp first. Historical rows retain their original equal timestamps
+    // instead of the writer's hot-timestamp allocator making each timestamp unique.
+    for (id, archived_at, thread_cwd, title) in [
+        (archived, Some(tied_time), &cwd, "Needle archive"),
+        (earlier, None, &cwd, "Needle first"),
+        (later, None, &cwd, "Needle second"),
+        (wrong_cwd, None, &other_cwd, "Needle elsewhere"),
+        (wrong_case, None, &cwd, "needle lower case"),
+    ] {
+        let rollout = home.path().join("sessions").join(format!("{id}.jsonl"));
+        fs::write(&rollout, "metadata-only fixture\n").unwrap();
+        let mut metadata =
+            ThreadMetadataBuilder::new(id, rollout, tied_time, SessionSource::Cli)
+                .build("test-provider");
+        metadata.cwd = codex_rollout::state_db::normalize_cwd_for_state_db(thread_cwd);
+        metadata.title = title.to_string();
+        metadata.preview = Some(title.to_string());
+        metadata.archived_at = archived_at;
+        if archived_at.is_some() {
+            metadata.recency_at = tied_time + chrono::Duration::seconds(5);
+        }
+        state.upsert_thread(&metadata).await.unwrap();
+    }
+    assert_eq!(
+        state.get_thread(earlier).await.unwrap().unwrap().recency_at,
+        state.get_thread(later).await.unwrap().unwrap().recency_at
+    );
+    fs::write(home.path().join("sentinel.txt"), "preserve source").unwrap();
+    let before = snapshot(home.path());
+
+    let reader = open_list(configuration.clone()).await.unwrap();
+    let first = reader.list_threads(list_params(&cwd)).await.unwrap();
+    assert_eq!(first.items.len(), 1);
+    assert_eq!(first.items[0].thread_id, later);
+    let cursor = first.next_cursor.expect("second tied row requires a cursor");
+    assert!(cursor.ends_with(&format!("|{later}")));
+
+    let mut second_params = list_params(&cwd);
+    second_params.cursor = Some(cursor);
+    let second = reader.list_threads(second_params).await.unwrap();
+    assert_eq!(second.items.len(), 1);
+    assert_eq!(second.items[0].thread_id, earlier);
+    assert_eq!(second.next_cursor, None);
+
+    let mut ascending = list_params(&cwd);
+    ascending.sort_direction = SortDirection::Asc;
+    let ascending_first = reader.list_threads(ascending.clone()).await.unwrap();
+    assert_eq!(ascending_first.items[0].thread_id, earlier);
+    ascending.cursor = Some(ascending_first.next_cursor.expect("ascending cursor"));
+    let ascending_second = reader.list_threads(ascending).await.unwrap();
+    assert_eq!(ascending_second.items[0].thread_id, later);
+    assert_eq!(ascending_second.next_cursor, None);
+
+    let mut archived_params = list_params(&cwd);
+    archived_params.archived = true;
+    let archived_page = reader.list_threads(archived_params).await.unwrap();
+    assert_eq!(archived_page.items.len(), 1);
+    assert_eq!(archived_page.items[0].thread_id, archived);
+    assert_eq!(archived_page.next_cursor, None);
+
+    let mut empty_cwds = list_params(&cwd);
+    empty_cwds.cwd_filters = Some(Vec::new());
+    let empty_page = reader.list_threads(empty_cwds).await.unwrap();
+    assert!(empty_page.items.is_empty());
+    assert_eq!(empty_page.next_cursor, None);
+    assert!(!reader.project_exists("missing-project").await.unwrap());
+    let mut invalid_cursor = list_params(&cwd);
+    invalid_cursor.cursor = Some("invalid-cursor".to_string());
+    assert!(matches!(
+        reader.list_threads(invalid_cursor).await,
+        Err(ThreadStoreError::InvalidRequest { .. })
+    ));
+    reader.reader.close().await;
+
+    assert_eq!(snapshot(home.path()), before);
+    assert!(!configuration.sqlite.thread_history_db_path().exists());
+    state.close().await;
+}
