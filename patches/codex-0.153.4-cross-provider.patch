+        (&PROJECTION_B.to_string(), &THREAD_A.to_string(), None)
+    );
+    assert_eq!(first.data[0].can_accept_direct_input, Some(false));
+    assert_eq!(second.data[0], own);
+    assert_eq!(fs::read(&other_path).unwrap(), before);
+    let changed = catalog
+        .list_with_native(
+            list_params(json!({"cursor":first.next_cursor,"searchTerm":"different"})),
+            &cwd(native.path()),
+            native.path(),
+            vec![own.clone()],
+        )
+        .await
+        .unwrap_err();
+    assert!(changed.message.contains("catalog or query changed"));
+    own.updated_at += 1;
+    let changed = catalog
+        .list_with_native(
+            list_params(json!({"cursor":first.next_cursor})),
+            &cwd(native.path()),
+            native.path(),
+            vec![own],
+        )
+        .await
+        .unwrap_err();
+    assert!(changed.message.contains("catalog or query changed"));
+}
+
+#[tokio::test]
+async fn shared_catalog_accepts_native_sidebar_unassigned_filters_and_stays_fresh() {
+    let native = TempDir::new().unwrap();
+    let foreign = TempDir::new().unwrap();
+    let path = fixture(foreign.path(), THREAD_A, "initial", "legacy");
+    let before_databases = main_database_snapshot(foreign.path());
+    let mut catalog = catalog(vec![source(
+        foreign.path(),
+        &path,
+        THREAD_A,
+        PROJECTION_A,
+        "original:local",
+    )]);
+    catalog.mode = CatalogMode::Shared;
+    let params = list_params(json!({"projectId":null,"sectionId":null,"sortKey":"updated_at"}));
+    let first = catalog
+        .list_with_native(
+            params.clone(),
+            &cwd(native.path()),
+            native.path(),
+            Vec::new(),
+        )
+        .await
+        .unwrap();
+    fixture(foreign.path(), THREAD_A, "latest source record", "legacy");
+    let second = catalog
+        .list_with_native(params, &cwd(native.path()), native.path(), Vec::new())
+        .await
+        .unwrap();
+    assert_eq!(first.data.len(), 1);
+    assert_eq!(second.data.len(), 1);
+    assert_ne!(first.data[0].preview, second.data[0].preview);
+    assert!(second.data[0].preview.contains("latest source record"));
+    assert_eq!(main_database_snapshot(foreign.path()), before_databases);
+}
diff --git a/codex-rs/app-server/src/manager_shared_execution.rs b/codex-rs/app-server/src/manager_shared_execution.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b30577be8ab05beda54f3205e547785d82273525
--- /dev/null
+++ b/codex-rs/app-server/src/manager_shared_execution.rs
@@ -0,0 +1,376 @@
+//! Direct shared editing selected by the manager. Storage routing is independent
+//! of the active account: only registered record homes are opened here. Auth,
+//! config, MCP, permissions and model requests remain with the selected profile.
+use super::*;
+use codex_thread_store::*;
+use std::any::Any;
+
+pub(crate) fn enabled() -> bool {
+    std::env::var("CODEX_MANAGER_SHARED_EXECUTION").as_deref() == Ok("1")
+        && (std::env::var_os(SHARED_CATALOG_ENV).is_some()
+            || std::env::var_os("CODEX_RECORD_HOME").is_some())
+        && !is_catalog_viewer()
+}
+
+pub(crate) fn wrap(fallback: Arc<dyn ThreadStore>) -> Arc<dyn ThreadStore> {
+    if !enabled() {
+        return fallback;
+    }
+    Arc::new(SharedStore {
+        fallback,
+        path: std::env::var_os(SHARED_CATALOG_ENV)
+            .map(PathBuf::from)
+            .unwrap_or_default(),
+        canonical_home: std::env::var_os("CODEX_RECORD_HOME").map(PathBuf::from),
+        new_thread_home: std::env::var_os("CODEX_MANAGER_NEW_THREAD_HOME").map(PathBuf::from),
+        default_store: OnceCell::new(),
+        routes: Mutex::new(HashMap::new()),
+        homes: Mutex::new(HashMap::new()),
+    })
+}
+
+// Upgrade saved projection links from older manager versions. Only typed top
+// level reference fields are changed; prompts, history and tool bodies are not.
+pub(crate) async fn canonical_request(
+    request: ClientRequest,
+) -> Result<ClientRequest, JSONRPCErrorError> {
+    if !enabled() {
+        return Ok(request);
+    }
+    let mut value = serde_json::to_value(&request).map_err(|e| invalid_request(e.to_string()))?;
+    let Some(params) = value
+        .get_mut("params")
+        .and_then(serde_json::Value::as_object_mut)
+    else {
+        return Ok(request);
+    };
+    let fields = [
+        "threadId",
+        "threadIds",
+        "conversationId",
+        "beforeThreadId",
+        "parentThreadId",
+        "ancestorThreadId",
+    ];
+    if !fields.iter().any(|field| params.contains_key(*field)) {
+        return Ok(request);
+    }
+    let Some(catalog) = RecordCatalog::from_environment().await? else {
+        return Ok(request);
+    };
+    let convert = |value: &mut serde_json::Value| {
+        if let Some(source) = value.as_str().and_then(|id| catalog.source(id).ok()) {
+            *value = source.thread_id.to_string().into();
+        }
+    };
+    for key in fields {
+        if let Some(value) = params.get_mut(key) {
+            if let Some(ids) = value.as_array_mut() {
+                ids.iter_mut().for_each(&convert);
+            } else {
+                convert(value);
+            }
+        }
+    }
+    serde_json::from_value(value).map_err(|e| invalid_request(e.to_string()))
+}
+
+struct SharedStore {
+    fallback: Arc<dyn ThreadStore>,
+    path: PathBuf,
+    canonical_home: Option<PathBuf>,
+    new_thread_home: Option<PathBuf>,
+    default_store: OnceCell<Arc<dyn ThreadStore>>,
+    routes: Mutex<HashMap<ThreadId, Arc<dyn ThreadStore>>>,
+    homes: Mutex<HashMap<PathBuf, Arc<dyn ThreadStore>>>,
+}
+
+fn failure(error: JSONRPCErrorError) -> ThreadStoreError {
+    ThreadStoreError::InvalidRequest {
+        message: error.message,
+    }
+}
+
+pub(crate) fn is_shared_store(store: &dyn ThreadStore) -> bool {
+    store.as_any().is::<SharedStore>()
+}
+
+pub(crate) async fn read_metadata(
+    store: &dyn ThreadStore,
+    id: ThreadId,
+) -> ThreadStoreResult<Option<codex_state::ThreadMetadata>> {
+    let shared =
+        store
+            .as_any()
+            .downcast_ref::<SharedStore>()
+            .ok_or(ThreadStoreError::Unsupported {
+                operation: "shared metadata",
+            })?;
+    let selected = shared.route(id).await?;
+    selected.read_thread_metadata(id).await
+}
+
+impl SharedStore {
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "serialize one store per source and retain the selected route for live recorders"
+    )]
+    async fn route(&self, id: ThreadId) -> ThreadStoreResult<Arc<dyn ThreadStore>> {
+        if self.canonical_home.is_some() {
+            return self.default_store().await;
+        }
+        let mut routes = self.routes.lock().await;
+        if let Some(store) = routes.get(&id) {
+            return Ok(Arc::clone(store));
+        }
+        let catalog = RecordCatalog::load(&self.path).await.map_err(failure)?;
+        let mut matches = catalog
+            .entries
+            .iter()
+            .filter(|source| source.thread_id == id);
+        let Some(source) = matches.next() else {
+            let store = self.default_store().await?;
+            routes.insert(id, Arc::clone(&store));
+            return Ok(store);
+        };
+        if matches.any(|other| other.codex_home != source.codex_home) {
+            return Err(ThreadStoreError::Conflict {
+                message: "The same task ID exists in multiple record homes.".into(),
+            });
+        }
+        let home = catalog.validated_home(source).await.map_err(failure)?;
+        // Validate the registered logical ID and the current physical rollout
+        // before opening a mutable SQLite handle; never consume source auth.
+        catalog.stored(source, false).await.map_err(failure)?;
+        let store = self.home_store(home).await?;
+        routes.insert(id, Arc::clone(&store));
+        Ok(store)
+    }
+
+    async fn default_store(&self) -> ThreadStoreResult<Arc<dyn ThreadStore>> {
+        self.default_store
+            .get_or_try_init(|| self.open_default_store())
+            .await
+            .map(Arc::clone)
+    }
+
+    async fn open_default_store(&self) -> ThreadStoreResult<Arc<dyn ThreadStore>> {
+        if let Some(home) = &self.canonical_home {
+            // An explicit storage root, like CODEX_HOME, but independent of
+            // profile authentication/configuration. No federated catalog or
+            // ownership grants participate after the cold migration.
+            if !home.is_absolute() {
+                return Err(ThreadStoreError::InvalidRequest {
+                    message: "CODEX_RECORD_HOME must be an absolute storage root".into(),
+                });
+            }
+            let home = tokio::fs::canonicalize(home).await.map_err(|error| {
+                ThreadStoreError::InvalidRequest {
+                    message: error.to_string(),
+                }
+            })?;
+            return self.home_store(home).await;
+        }
+        let Some(home) = &self.new_thread_home else {
+            return Ok(Arc::clone(&self.fallback));
+        };
+        let catalog = RecordCatalog::load(&self.path).await.map_err(failure)?;
+        let canonical = tokio::fs::canonicalize(home).await.map_err(|error| {
+            ThreadStoreError::InvalidRequest {
+                message: error.to_string(),
+            }
+        })?;
+        let enrolled = match &catalog.discovered {
+            Some(metadata) => metadata
+                .registered_homes
+                .values()
+                .any(|path| path == &canonical),
+            None => catalog
+                .validated_homes()
+                .await
+                .map_err(failure)?
+                .values()
+                .any(|path| path == &canonical),
+        };
+        if !enrolled {
+            return Err(ThreadStoreError::InvalidRequest {
+                message: "New task storage is not an enrolled common record home.".into(),
+            });
+        }
+        self.home_store(canonical).await
+    }
+
+    async fn home_store(&self, home: PathBuf) -> ThreadStoreResult<Arc<dyn ThreadStore>> {
+        let mut homes = self.homes.lock().await;
+        let store = if let Some(store) = homes.get(&home) {
+            Arc::clone(store)
+        } else {
+            let sqlite = codex_state::SqliteConfig::from_sqlite_home(
+                AbsolutePathBuf::from_absolute_path(&home).map_err(|e| {
+                    ThreadStoreError::InvalidRequest {
+                        message: e.to_string(),
+                    }
+                })?,
+            );
+            let state = codex_state::StateRuntime::init(sqlite.clone(), "openai".into())
+                .await
+                .map_err(|e| ThreadStoreError::Internal {
+                    message: e.to_string(),
+                })?;
+            let store: Arc<dyn ThreadStore> = Arc::new(LocalThreadStore::new(
+                LocalThreadStoreConfig {
+                    codex_home: home.clone(),
+                    sqlite,
+                    default_model_provider_id: "openai".into(),
+                },
+                Some(state),
+            ));
+            homes.insert(home, Arc::clone(&store));
+            store
+        };
+        Ok(store)
+    }
+}
+
+macro_rules! routed {
+    ($name:ident, $params:ty, $result:ty) => {
+        fn $name(&self, params: $params) -> ThreadStoreFuture<'_, $result> {
+            Box::pin(async move { self.route(params.thread_id).await?.$name(params).await })
+        }
+    };
+}
+macro_rules! by_id {
+    ($name:ident) => {
+        fn $name(&self, id: ThreadId) -> ThreadStoreFuture<'_, ()> {
+            Box::pin(async move { self.route(id).await?.$name(id).await })
+        }
+    };
+}
+macro_rules! native {
+    ($name:ident, $params:ty, $result:ty) => {
+        fn $name(&self, params: $params) -> ThreadStoreFuture<'_, $result> {
+            Box::pin(async move { self.default_store().await?.$name(params).await })
+        }
+    };
+}
+
+impl ThreadStore for SharedStore {
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+    fn local_rollout_path(&self, id: ThreadId) -> ThreadStoreFuture<'_, Option<PathBuf>> {
+        Box::pin(async move { self.route(id).await?.local_rollout_path(id).await })
+    }
+    fn read_thread_metadata(
+        &self,
+        id: ThreadId,
+    ) -> ThreadStoreFuture<'_, Option<codex_state::ThreadMetadata>> {
+        Box::pin(async move { self.route(id).await?.read_thread_metadata(id).await })
+    }
+    fn default_history_mode(&self) -> ThreadHistoryMode {
+        self.fallback.default_history_mode()
+    }
+    fn supports_paginated_history_lists(&self) -> bool {
+        true
+    }
+    fn supports_projects(&self) -> bool {
+        self.fallback.supports_projects()
+    }
+    fn supports_thread_sections(&self) -> bool {
+        self.fallback.supports_thread_sections()
+    }
+
+    fn create_thread(&self, params: CreateThreadParams) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(async move {
+            let store = match params.parent_thread_id.or(params.forked_from_id) {
+                Some(parent) => self.route(parent).await?,
+                None => self.default_store().await?,
+            };
+            self.routes
+                .lock()
+                .await
+                .insert(params.thread_id, Arc::clone(&store));
+            store.create_thread(params).await
+        })
+    }
+    fn stage_pending_thread_metadata(
+        &self,
+        id: ThreadId,
+        patch: ThreadMetadataPatch,
+    ) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(async move {
+            self.route(id)
+                .await?
+                .stage_pending_thread_metadata(id, patch)
+                .await
+        })
+    }
+    fn persist_thread(&self, id: ThreadId, context: PersistContext) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(async move { self.route(id).await?.persist_thread(id, context).await })
+    }
+    routed!(resume_thread, ResumeThreadParams, ());
+    routed!(append_items, AppendThreadItemsParams, ());
+    routed!(load_history, LoadThreadHistoryParams, StoredThreadHistory);
+    routed!(
+        load_latest_model_context,
+        LoadThreadHistoryParams,
+        StoredModelContext
+    );
+    routed!(prepare_fork, PrepareForkParams, PreparedFork);
+    routed!(revert_thread, RevertThreadParams, ());
+    routed!(read_thread, ReadThreadParams, StoredThread);
+    routed!(
+        search_thread_occurrences,
+        SearchThreadOccurrencesParams,
+        ThreadOccurrenceSearchPage
+    );
+    routed!(list_turns, ListTurnsParams, TurnPage);
+    routed!(list_items, ListItemsParams, ItemPage);
+    routed!(list_timeline, ListTimelineParams, TimelinePage);
+    routed!(
+        update_thread_metadata,
+        UpdateThreadMetadataParams,
+        Option<StoredThread>
+    );
+    routed!(move_thread_to_section, MoveThreadToSectionParams, ());
+    routed!(archive_thread, ArchiveThreadParams, ());
+    routed!(unarchive_thread, ArchiveThreadParams, StoredThread);
+    routed!(delete_thread, DeleteThreadParams, ());
+    by_id!(remove_pending_thread_metadata);
+    by_id!(flush_thread);
+    by_id!(shutdown_thread);
+    by_id!(discard_thread);
+    native!(
+        read_thread_by_rollout_path,
+        ReadThreadByRolloutPathParams,
+        StoredThread
+    );
+    native!(list_threads, ListThreadsParams, ThreadPage);
+    native!(
+        list_thread_sections,
+        ListThreadSectionsParams,
+        StoredThreadSectionsPage
+    );
+    native!(
+        create_thread_section,
+        CreateThreadSectionParams,
+        StoredThreadSection
+    );
+    native!(
+        rename_thread_section,
+        RenameThreadSectionParams,
+        Option<StoredThreadSection>
+    );
+    native!(delete_thread_section, DeleteThreadSectionParams, bool);
+    native!(list_projects, ListProjectsParams, StoredProjectsPage);
+    native!(read_project, String, Option<StoredProject>);
+    native!(create_project, CreateProjectParams, CreatedProject);
+    native!(update_project, UpdateProjectParams, Option<UpdatedProject>);
+    native!(move_project, MoveProjectParams, Option<ProjectMoveOutcome>);
+    native!(delete_project, String, Option<DeletedProject>);
+    native!(search_threads, SearchThreadsParams, ThreadSearchPage);
+}
+
