+    let profile_id = uuid::Uuid::now_v7().to_string();
+    let source_id = ManagedSourceId {
+        host_id: "local".to_string(),
+        store_id: format!("manager:{profile_id}"),
+    };
+    std::fs::write(
+        home.path().join("managed-source.json"),
+        serde_json::to_vec(&source_id).expect("source marker JSON"),
+    )
+    .expect("persist source marker");
+    let grant = ManagedAuthorityGrant {
+        owner_profile_id: profile_id,
+        epoch: 1,
+        revision: 1,
+    };
+    let authority = ManagedAuthority::from_grant(home.path(), &source_id, thread_id, &grant)
+        .expect("canonical authority");
+    authority.create_new().expect("publish initial authority");
+    let store = LocalThreadStore::new(test_config(home.path()), /*state_db*/ None)
+        .with_managed_thread_authority(thread_id, authority);
+    let reservation = store
+        .prepare_managed_writer(thread_id)
+        .await
+        .expect("authority-fenced preparation");
+    let transfer_guard = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(
+            home.path()
+                .join("managed-authority")
+                .join(format!("{thread_id}.guard")),
+        )
+        .expect("open independent manager authority fence");
+    assert!(matches!(
+        transfer_guard.try_lock(),
+        Err(std::fs::TryLockError::WouldBlock)
+    ));
+
+    store
+        .resume_thread(resume_params(thread_id, rollout_path, home.path()))
+        .await
+        .expect("transfer exact writer and authority lease to recorder");
+    drop(reservation);
+    assert!(matches!(
+        transfer_guard.try_lock(),
+        Err(std::fs::TryLockError::WouldBlock)
+    ));
+
+    store
+        .shutdown_thread(thread_id)
+        .await
+        .expect("drain source");
+    transfer_guard
+        .try_lock()
+        .expect("successful close permits exclusive authority transfer");
+    close_state_db(&store).await;
+}
+
+#[tokio::test]
+async fn cancelled_prepare_keeps_writer_until_owned_initializer_finishes() {
+    let (home, store, thread_id, rollout_path) = pending_store();
+    let original = std::fs::read(&rollout_path).expect("source bytes");
+    let release = Arc::new(Notify::new());
+    let initialize_release = Arc::clone(&release);
+    let (started_tx, started_rx) = oneshot::channel();
+    let (finished_tx, finished_rx) = oneshot::channel();
+    let preparing_store = store.clone();
+    let outer = tokio::spawn(async move {
+        preparing_store
+            .prepare_managed_writer_with_init(thread_id, move |store| async move {
+                started_tx.send(()).expect("report owned initializer start");
+                initialize_release.notified().await;
+                store.initialize_managed_state_db().await?;
+                finished_tx.send(()).expect("report initializer completion");
+                Ok(())
+            })
+            .await
+    });
+    tokio::time::timeout(Duration::from_secs(10), started_rx)
+        .await
+        .expect("initializer starts")
+        .expect("initializer start signal");
+    outer.abort();
+    assert!(
+        outer
+            .await
+            .expect_err("outer await cancelled")
+            .is_cancelled()
+    );
+
+    let competing = LocalThreadStore::new(test_config(home.path()), /*state_db*/ None);
+    assert!(matches!(
+        competing.writer_lock_coordinator.acquire(thread_id),
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(store.state_db().await.is_none());
+    assert_eq!(
+        std::fs::read(&rollout_path).expect("source bytes"),
+        original
+    );
+
+    release.notify_one();
+    tokio::time::timeout(Duration::from_secs(30), finished_rx)
+        .await
+        .expect("owned initializer finishes despite caller cancellation")
+        .expect("initializer completion signal");
+    let _writer = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            match competing.writer_lock_coordinator.acquire(thread_id) {
+                Ok(writer) => break writer,
+                Err(ThreadStoreError::Conflict { .. }) => tokio::task::yield_now().await,
+                Err(error) => panic!("unexpected lock acquisition failure: {error}"),
+            }
+        }
+    })
+    .await
+    .expect("completed detached preparation releases its reservation");
+    assert!(store.state_db().await.is_some());
+    assert_eq!(std::fs::read(rollout_path).expect("source bytes"), original);
+    close_state_db(&store).await;
+}
+
+#[tokio::test]
+async fn wrong_thread_is_rejected_before_initializer_or_database_access() {
+    let (_home, store, thread_id, rollout_path) = pending_store();
+    let original = std::fs::read(&rollout_path).expect("source bytes");
+    let other_id = ThreadId::default();
+    assert_ne!(other_id, thread_id);
+    let initialized = Arc::new(AtomicBool::new(false));
+    let initializer_called = Arc::clone(&initialized);
+
+    assert!(matches!(
+        store
+            .prepare_managed_writer_with_init(other_id, move |store| async move {
+                initializer_called.store(true, Ordering::Release);
+                store.initialize_managed_state_db().await
+            })
+            .await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(!initialized.load(Ordering::Acquire));
+    assert!(store.state_db().await.is_none());
+    assert_eq!(std::fs::read(rollout_path).expect("source bytes"), original);
+    assert!(
+        store
+            .managed_writer_reservation
+            .lock()
+            .expect("reservation slot")
+            .is_none()
+    );
+}
