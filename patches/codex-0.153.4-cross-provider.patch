+//! Renames follow an already-held canonical writer without starting model work.
+
+use super::*;
+use codex_app_server_protocol::ThreadNameUpdatedNotification;
+use codex_app_server_protocol::ThreadSetNameResponse;
+use pretty_assertions::assert_eq;
+
+pub(super) async fn rename(server: &mut TestAppServer, thread_id: &str, name: &str) -> Result<()> {
+    let request = server
+        .send_raw_request(
+            "thread/name/set",
+            Some(json!({ "threadId": thread_id, "name": name })),
+        )
+        .await?;
+    let _: ThreadSetNameResponse = timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("thread/name/updated"),
+    )
+    .await??;
+    let updated: ThreadNameUpdatedNotification =
+        serde_json::from_value(notification.params.context("updated name")?)?;
+    assert_eq!(
+        updated,
+        ThreadNameUpdatedNotification {
+            thread_id: thread_id.to_string(),
+            thread_name: Some(name.to_string()),
+        }
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn managed_names_follow_the_canonical_writer_without_loading_a_viewer() -> Result<()> {
+    let source_api = responses::start_mock_server().await;
+    let target_api = responses::start_mock_server().await;
+    let source_requests = responses::mount_sse_sequence(
+        &source_api,
+        vec![create_final_assistant_message_sse_response("Initial work")?],
+    )
+    .await;
+    let source = ManagedProfile::new(&source_api.uri(), "source-model", "source-token")?;
+    let target = ManagedProfile::new(&target_api.uri(), "target-model", "target-token")?;
+    source.write_manifest(&[&source], Vec::new())?;
+    let mut owner = source.start_server().await?;
+    let canonical = owner
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    complete_turn(&mut owner, &canonical.id, "Create a stored record").await?;
+    rename(&mut owner, &canonical.id, "공통 제목 · 첫 계정").await?;
+
+    target.write_manifest(
+        &[&source, &target],
+        vec![binding_grant(
+            &source,
+            &source,
+            &canonical.id,
+            /*epoch*/ 1,
+        )],
+    )?;
+    let mut viewer = target.start_server().await?;
+    let request = viewer
+        .send_raw_request(
+            "thread/name/set",
+            Some(json!({ "threadId": canonical.id, "name": "unowned change" })),
+        )
+        .await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        viewer.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    assert!(error.error.message.contains("assigned profile"));
+    let request = viewer
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, viewer.read_response(request)).await??;
+    assert_eq!(loaded.data, Vec::<String>::new());
+
+    close_idle(&mut owner, &canonical.id).await?;
+    transfer_authority(
+        &source,
+        &canonical.id,
+        &source,
+        /*previous_epoch*/ 1,
+        &target,
+    )?;
+    target.write_manifest(
+        &[&source, &target],
+        vec![binding_grant(
+            &source,
+            &target,
+            &canonical.id,
+            /*epoch*/ 2,
+        )],
+    )?;
+    let request = viewer
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: canonical.id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let resumed: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, viewer.read_response(request)).await??;
+    assert_eq!(resumed.thread.name.as_deref(), Some("공통 제목 · 첫 계정"));
+    rename(&mut viewer, &canonical.id, "공통 제목 · 지정 계정").await?;
+
+    let request = owner
+        .send_raw_request(
+            "thread/name/set",
+            Some(json!({ "threadId": canonical.id, "name": "stale change" })),
+        )
+        .await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        owner.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    assert!(error.error.message.contains("released by this instance"));
+    let request = owner
+        .send_raw_request("thread/read", Some(json!({ "threadId": canonical.id })))
+        .await?;
+    let stored: ThreadReadResponse = timeout(READ_TIMEOUT, owner.read_response(request)).await??;
+    assert_eq!(stored.thread.name.as_deref(), Some("공통 제목 · 지정 계정"));
+    let target_rows =
+        read_thread_state_audit_rows(&SqliteConfig::new_for_testing(target.home.path().abs()))
+            .await?;
+    assert!(!target_rows.iter().any(|row| row.id == canonical.id));
+    assert_eq!(source_requests.requests().len(), 1);
+    assert!(
+        target_api
+            .received_requests()
+            .await
+            .context("target request recording")?
+            .iter()
+            .all(|request| !request.url.path().ends_with("/responses"))
+    );
+    close_idle(&mut viewer, &canonical.id).await?;
+    Ok(())
+}
diff --git a/codex-rs/app-server/tests/suite/v2/managed_instance_activity.rs b/codex-rs/app-server/tests/suite/v2/managed_instance_activity.rs
