+fn assert_advisory_identity(response: &Value, profile: &ManagedProfile, thread_id: &str) {
+    assert_eq!(response["threadId"], thread_id);
+    assert_eq!(response["hostId"], "local");
+    assert_eq!(response["sourceStoreId"], profile.source_id);
+    assert_eq!(response["proofScope"], "advisory");
+    assert_eq!(response["observedThreadIds"], json!([thread_id]));
+    assert!(response.get("writerReleaseVerified").is_none());
+    assert!(response.get("closedThreadIds").is_none());
+}
