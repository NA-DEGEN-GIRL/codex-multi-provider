+#[tokio::test]
+async fn cancelled_startup_fences_its_canonical_scope_without_poisoning_unrelated_tasks() {
+    let mut fixture = ActivationFixture::new().await;
+    let root_binding = fixture.seed_root().await;
+    let root = fixture.root;
+    let ancestor = ThreadId::new();
+    let mut completed = fixture
+        .manager
+        .state
+        .track_managed_startup(Some(&root_binding), &[ancestor])
+        .expect("admit completed startup");
+    completed.complete();
+    drop(completed);
+    fixture
+        .manager
+        .state
+        .check_managed_startup_uncertainty(&[root, ancestor])
+        .expect("completed registration leaves no uncertainty");
+
+    fixture.root = ThreadId::new();
+    let unrelated = fixture.seed_root().await;
+    let unrelated_root = fixture.root;
+    fixture.root = root;
+    fixture
+        .manager
+        .activate_managed_record_binding(
+            unrelated.clone(),
+            &[(unrelated_root, fixture.grant(/*epoch*/ 1))],
+        )
+        .await
+        .expect("unrelated task is already admitted");
+    let before = fixture.bindings().await;
+
+    let tracker = fixture
+        .manager
+        .state
+        .track_managed_startup(Some(&root_binding), &[ancestor])
+        .expect("admit startup before its actor is registered");
+    let (started_tx, started_rx) = tokio::sync::oneshot::channel();
+    let startup = tokio::spawn(async move {
+        started_tx.send(()).expect("announce pending startup");
+        std::future::pending::<()>().await;
+        drop(tracker);
+    });
+    started_rx.await.expect("startup reached its pending await");
+    startup.abort();
+    assert!(
+        startup
+            .await
+            .expect_err("startup was cancelled")
+            .is_cancelled()
+    );
+
+    for id in [root, ancestor] {
+        assert!(
+            fixture
+                .manager
+                .state
+                .check_managed_startup_uncertainty(&[id])
+                .is_err(),
+            "cancellation must fence both the child and every admitted ancestor"
+        );
+    }
+    assert!(
+        fixture
+            .manager
+            .state
+            .track_managed_startup(Some(&root_binding), &[ancestor])
+            .is_err(),
+        "a later startup cannot erase uncertain actor ownership"
+    );
+    assert!(
+        fixture
+            .manager
+            .activate_managed_record_binding(root_binding, &[(root, fixture.grant(/*epoch*/ 1))])
+            .await
+            .is_err()
+    );
+    assert_eq!(fixture.bindings().await, before);
+    fixture
+        .manager
+        .state
+        .check_managed_startup_uncertainty(&[unrelated_root])
+        .expect("unrelated canonical scope remains usable");
+    fixture
+        .manager
+        .activate_managed_record_binding(unrelated, &[(unrelated_root, fixture.grant(/*epoch*/ 1))])
+        .await
+        .expect("unrelated activation still succeeds");
+    assert_eq!(fixture.bindings().await, before);
+}
