+async fn paginated_fixture_options(
+    home: &Path,
+    id: &str,
+    complete_last_turn: bool,
+    archived: bool,
+) -> PathBuf {
+    use codex_protocol::items::SubAgentActivityItem;
+    use codex_protocol::items::TurnItem;
+    use codex_protocol::items::UserMessageItem;
+    use codex_protocol::models::BaseInstructions;
+    use codex_protocol::protocol::EventMsg;
+    use codex_protocol::protocol::ItemCompletedEvent;
+    use codex_protocol::protocol::ThreadMemoryMode;
+    use codex_protocol::protocol::TurnCompleteEvent;
+    use codex_protocol::protocol::TurnStartedEvent;
+    use codex_protocol::user_input::UserInput;
+    use codex_rollout::RolloutItem;
+    use codex_thread_store::AppendThreadItemsParams;
+    use codex_thread_store::ArchiveThreadParams;
+    use codex_thread_store::CreateThreadParams;
+    use codex_thread_store::PersistContext;
+    use codex_thread_store::ThreadPersistenceMetadata;
+    use codex_thread_store::ThreadStore;
+
+    let config = LocalThreadStoreConfig {
+        codex_home: home.to_path_buf(),
+        sqlite: codex_state::SqliteConfig::new_for_testing(cwd(home)),
+        default_model_provider_id: "openai".to_string(),
+    };
+    let state = codex_state::StateRuntime::init(config.sqlite.clone(), "openai".to_string())
+        .await
+        .unwrap();
+    let store = LocalThreadStore::new(config, Some(state.clone()));
+    let thread_id = ThreadId::from_string(id).unwrap();
+    store
+        .create_thread(CreateThreadParams {
+            session_id: thread_id.into(),
+            thread_id,
+            extra_config: None,
+            forked_from_id: None,
+            parent_thread_id: None,
+            source: SessionSource::Exec,
+            thread_source: None,
+            originator: "record-catalog-fixture".to_string(),
+            base_instructions: BaseInstructions::default(),
+            dynamic_tools: Vec::new(),
+            selected_capability_roots: Vec::new(),
+            multi_agent_version: None,
+            history_mode: ThreadHistoryMode::Paginated,
+            history_base: None,
+            subagent_history_start_ordinal: None,
+            initial_window_id: format!("window-{thread_id}"),
+            metadata: ThreadPersistenceMetadata {
+                cwd: Some(home.to_path_buf()),
+                model_provider: "openai".to_string(),
+                memory_mode: ThreadMemoryMode::Enabled,
+            },
+        })
+        .await
+        .unwrap();
+    for index in 1..=2 {
+        let turn_id = format!("turn-{index}");
+        let mut events = vec![EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: turn_id.clone(),
+            trace_id: None,
+            started_at: Some(index * 10),
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        })];
+        for item in [
+            TurnItem::UserMessage(UserMessageItem {
+                id: format!("user-{index}"),
+                client_id: None,
+                content: vec![UserInput::Text {
+                    text: format!("authoritative message {index}"),
+                    text_elements: Vec::new(),
+                }],
+            }),
+            TurnItem::SubAgentActivity(SubAgentActivityItem {
+                id: format!("activity-{index}"),
+                kind: codex_protocol::protocol::SubAgentActivityKind::Completed,
+                agent_thread_id: ThreadId::from_string(THREAD_B).unwrap(),
+                agent_path: "/root/worker".parse().unwrap(),
+            }),
+        ] {
+            events.push(EventMsg::ItemCompleted(ItemCompletedEvent {
+                thread_id,
+                turn_id: turn_id.clone(),
+                item,
+                started_at_ms: None,
+                completed_at_ms: index * 10_000 + 1,
+            }));
+        }
+        if index == 1 || complete_last_turn {
+            events.push(EventMsg::TurnComplete(TurnCompleteEvent {
+                turn_id,
+                started_at: Some(index * 10),
+                last_agent_message: None,
+                error: None,
+                completed_at: Some(index * 10 + 2),
+                duration_ms: Some(2_000),
+                time_to_first_token_ms: None,
+            }));
+        }
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id,
+                items: events.into_iter().map(RolloutItem::EventMsg).collect(),
+            })
+            .await
+            .unwrap();
+    }
+    store
+        .persist_thread(thread_id, PersistContext::Standard)
+        .await
+        .unwrap();
+    store.flush_thread(thread_id).await.unwrap();
+    let mut path = store.live_rollout_path(thread_id).await.unwrap();
+    store.shutdown_thread(thread_id).await.unwrap();
+    codex_rollout::state_db::reconcile_rollout(
+        Some(state.as_ref()),
+        &path,
+        "openai",
+        None,
+        &[],
+        Some(false),
+        None,
+    )
+    .await;
+    if archived {
+        store
+            .archive_thread(ArchiveThreadParams { thread_id })
+            .await
+            .unwrap();
+        path = state
+            .get_thread(thread_id)
+            .await
+            .unwrap()
+            .unwrap()
+            .rollout_path;
+    }
+    drop(store);
+    state.close().await;
+    path
+}
