+use std::collections::HashMap;
+
+use codex_protocol::ResponseItemId;
+use codex_protocol::approvals::ElicitationRequest;
+use codex_protocol::approvals::ExecApprovalKind;
+use codex_protocol::items::McpToolCallError;
+use codex_protocol::items::McpToolCallItem;
+use codex_protocol::items::McpToolCallStatus;
+use codex_protocol::items::TurnItem;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::MessagePhase;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::AgentMessageContentDeltaEvent;
+use codex_protocol::protocol::AskForApproval;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ReviewDecision;
+use codex_protocol::protocol::WarningEvent;
+use rmcp::model::NumberOrString;
+use serde_json::Value;
+use serde_json::json;
+use uuid::Uuid;
+
+use super::context::Snapshot;
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+
+#[cfg(test)]
+#[path = "events_tests.rs"]
+mod tests;
+
+#[derive(Default)]
+pub(super) struct Events {
+    text: String,
+    text_complete: bool,
+    message_id: Option<String>,
+    tools: HashMap<String, McpToolCallItem>,
+    pub last_message: Option<String>,
+}
+
+impl Events {
+    pub(super) async fn handle(
+        &mut self,
+        session: &Session,
+        ctx: &TurnContext,
+        event: &Value,
+        snapshot: &Snapshot,
+    ) {
+        match event["kind"].as_str().unwrap_or_default() {
+            "text_delta" => {
+                if self.text_complete {
+                    self.flush(session, ctx, MessagePhase::Commentary).await;
+                }
+                let text = event["text"].as_str().unwrap_or_default();
+                let id = self
+                    .message_id
+                    .get_or_insert_with(|| Uuid::new_v4().to_string())
+                    .clone();
+                if self.text.is_empty() {
+                    let item = super::super::super::event_mapping::parse_turn_item(&message(
+                        &id,
+                        "",
+                        MessagePhase::Commentary,
+                    ));
+                    if let Some(item) = item {
+                        session.emit_turn_item_started(ctx, &item).await;
+                    }
+                }
+                self.text.push_str(text);
+                session
+                    .send_event(
+                        ctx,
+                        EventMsg::AgentMessageContentDelta(AgentMessageContentDeltaEvent {
+                            thread_id: session.thread_id().to_string(),
+                            turn_id: ctx.sub_id.clone(),
+                            item_id: id,
+                            delta: text.into(),
+                        }),
+                    )
+                    .await;
+            }
+            "text" => {
+                let text = event["text"].as_str().unwrap_or_default();
+                if self.text_complete && self.text != text {
+                    self.flush(session, ctx, MessagePhase::Commentary).await;
+                }
+                // A complete text block supersedes its partial deltas; never append both.
+                if !text.is_empty() {
+                    self.text = text.into();
+                }
+                self.text_complete = true;
+            }
+            "tool_start" => {
+                self.flush(session, ctx, MessagePhase::Commentary).await;
+                let id = event["id"].as_str().unwrap_or_default().to_string();
+                let item = McpToolCallItem {
+                    id: id.clone(),
+                    server: "claude-code".into(),
+                    tool: event["tool"].as_str().unwrap_or("tool").into(),
+                    arguments: event["input"].clone(),
+                    status: McpToolCallStatus::InProgress,
+                    result: None,
+                    connector_id: None,
+                    mcp_app_resource_uri: None,
+                    link_id: None,
+                    app_name: None,
+                    action_name: None,
+                    plugin_id: None,
+                    read_only_hint: None,
+                    error: None,
+                    duration: None,
+                };
+                session
+                    .emit_turn_item_started(ctx, &TurnItem::McpToolCall(item.clone()))
+                    .await;
+                self.tools.insert(id, item);
+            }
+            "tool_end" => {
+                let id = event["id"].as_str().unwrap_or_default();
+                if let Some(mut item) = self.tools.remove(id) {
+                    let failed = event["is_error"].as_bool().unwrap_or(false);
+                    item.status = if failed {
+                        McpToolCallStatus::Failed
+                    } else {
+                        McpToolCallStatus::Completed
+                    };
+                    let output = bounded(&event["output"].to_string());
+                    item.result = Some(codex_protocol::mcp::CallToolResult {
+                        content: vec![json!({"type":"text","text":output})],
+                        structured_content: None,
+                        is_error: Some(failed),
+                        meta: None,
+                    });
+                    let summary = format!(
+                        "[Claude tool {}: {}]\nInput: {}\nOutput: {output}",
+                        item.tool,
+                        if failed { "failed" } else { "completed" },
+                        bounded(&item.arguments.to_string())
+                    );
+                    session
+                        .emit_turn_item_completed(ctx, TurnItem::McpToolCall(item))
+                        .await;
+                    // Plaintext is portable; never persist Claude-native tool blocks or signatures.
+                    session
+                        .record_conversation_items(
+                            ctx,
+                            &[message(
+                                &Uuid::new_v4().to_string(),
+                                &summary,
+                                MessagePhase::Commentary,
+                            )],
+                        )
+                        .await;
+                }
+            }
+            "compact" => {
+                if event["summary_available"] == true
+                    && let Some(summary) = event["summary"]
+                        .as_str()
+                        .filter(|summary| !summary.trim().is_empty())
+                {
+                    if summary.len() > 20_000 {
+                        notice(session, ctx, "Claude's portable summary exceeded the safe item limit; canonical history is retained in full").await;
+                        return;
+                    }
+                    let Some(agent) = ctx.provider.info().agent.as_ref() else {
+                        return;
+                    };
+                    // Native compaction alone does not prove which recent turns were covered.
+                    let fingerprints =
+                        serde_json::from_value::<std::collections::BTreeMap<String, String>>(
+                            event["covered_turn_fingerprints"].clone(),
+                        )
+                        .ok()
+                        .filter(|covered| {
+                            event["deliberate_full_context_summary"] == true
+                                && !covered.is_empty()
+                                && covered.iter().all(|(id, hash)| {
+                                    id != &ctx.sub_id
+                                        && snapshot.turn_fingerprints.get(id) == Some(hash)
+                                })
+                        });
+                    let coverage = fingerprints
+                        .as_ref()
+                        .map(|covered| covered.keys().cloned().collect::<Vec<_>>().join(", "))
+                        .unwrap_or_else(|| "unknown; supplemental summary only".into());
+                    let text = format!(
+                        "[Portable Claude compaction summary; profile {}; model {}; coverage: {coverage}. Canonical history is retained.]\n{summary}",
+                        agent.profile_id,
+                        ctx.model_info().slug
+                    );
+                    let mut response =
+                        message(&Uuid::new_v4().to_string(), &text, MessagePhase::Commentary);
+                    Session::stamp_response_item_for_history(&mut response, &ctx.sub_id);
+                    session
+                        .record_prepared_conversation_items(
+                            ctx,
+                            vec![codex_history::ResponseItemEnvelope {
+                                item: response.clone(),
+                                metadata: Some(codex_history::CodexHarnessMetadata {
+                                    portable_agent_summary: fingerprints.map(|fingerprints| {
+                                        codex_history::PortableAgentSummary {
+                                            source_profile: agent.profile_id.clone(),
+                                            source_model: ctx.model_info().slug.clone(),
+                                            turn_fingerprints: fingerprints,
+                                        }
+                                    }),
+                                    ..Default::default()
+                                }),
+                            }],
+                            Vec::new(),
+                        )
+                        .await;
+                    if let Some(item) = crate::event_mapping::parse_turn_item(&response) {
+                        session.emit_turn_item_started(ctx, &item).await;
+                        session.emit_turn_item_completed(ctx, item).await;
+                    }
+                } else {
+                    notice(session, ctx, "Claude compacted its private session without a portable summary; shared history remains available in full").await;
+                }
+            }
+            "notice" | "retry" | "rate_limit" | "plan" | "subagent" => {
+                if let Some(text) = event["message"].as_str().or_else(|| event["text"].as_str()) {
+                    notice(session, ctx, &bounded(text)).await;
+                }
+            }
+            _ => {} // init/ack/usage and private reasoning are runner-owned, not model history.
+        }
+    }
+
+    pub(super) async fn flush(
+        &mut self,
+        session: &Session,
+        ctx: &TurnContext,
+        phase: MessagePhase,
+    ) {
+        if self.text.is_empty() {
+            return;
+        }
+        let id = self
+            .message_id
+            .take()
+            .unwrap_or_else(|| Uuid::new_v4().to_string());
+        let text = std::mem::take(&mut self.text);
+        self.text_complete = false;
+        let response = message(&id, &text, phase);
+        session
+            .record_conversation_items(ctx, std::slice::from_ref(&response))
+            .await;
+        if let Some(item) = crate::event_mapping::parse_turn_item(&response) {
+            session.emit_turn_item_completed(ctx, item).await;
+        }
+        self.last_message = Some(text);
+    }
+
+    pub(super) async fn finish(&mut self, session: &Session, ctx: &TurnContext, result: &str) {
+        if self.text.is_empty()
+            && self.last_message.as_deref() != Some(result)
+            && !result.is_empty()
+        {
+            self.text = result.into();
+        }
+        self.flush(session, ctx, MessagePhase::FinalAnswer).await;
+    }
+
+    pub(super) async fn interrupt_tools(&mut self, session: &Session, ctx: &TurnContext) {
+        for (_, mut item) in self.tools.drain() {
+            let summary = format!(
+                "[Claude tool {} interrupted; outcome unknown. Inspect the workspace before repeating this action.]\nInput: {}",
+                item.tool,
+                bounded(&item.arguments.to_string())
+            );
+            item.status = McpToolCallStatus::Failed;
+            item.error = Some(McpToolCallError {
+                message: "Interrupted; the external tool's outcome is unknown".into(),
+            });
+            session
+                .emit_turn_item_completed(ctx, TurnItem::McpToolCall(item))
+                .await;
+            session
+                .record_conversation_items(
+                    ctx,
+                    &[message(
+                        &Uuid::new_v4().to_string(),
+                        &summary,
+                        MessagePhase::Commentary,
+                    )],
+                )
+                .await;
+        }
+    }
+}
+
+pub(super) fn message(id: &str, text: &str, phase: MessagePhase) -> ResponseItem {
+    ResponseItem::Message {
+        id: Some(ResponseItemId::from_server(id.to_string())),
+        role: "assistant".into(),
+        content: vec![ContentItem::OutputText { text: text.into() }],
+        phase: Some(phase),
+        internal_chat_message_metadata_passthrough: None,
+    }
+}
+
+pub(super) async fn notice(session: &Session, ctx: &TurnContext, text: &str) {
+    session
+        .send_event(
+            ctx,
+            EventMsg::Warning(WarningEvent {
+                message: text.into(),
+            }),
+        )
+        .await;
+}
+
+pub(super) async fn record_usage(session: &Session, ctx: &TurnContext, done: &Value) {
+    let Some(total) = token_usage(&done["usage"]) else {
+        return;
+    };
+    let last = token_usage(&done["last_request_usage"]);
+    session.record_local_agent_usage(ctx, total, last).await;
+}
+
+fn token_usage(value: &Value) -> Option<codex_protocol::protocol::TokenUsage> {
+    let input = value["input_tokens"].as_i64()?.max(0);
+    let cached = value["cache_read_input_tokens"]
+        .as_i64()
+        .unwrap_or(0)
+        .max(0);
+    let written = value["cache_creation_input_tokens"]
+        .as_i64()
+        .unwrap_or(0)
+        .max(0);
+    let output = value["output_tokens"].as_i64().unwrap_or(0).max(0);
+    let total_input = input.saturating_add(cached).saturating_add(written);
+    Some(codex_protocol::protocol::TokenUsage {
+        input_tokens: total_input,
+        cached_input_tokens: cached,
+        cache_write_input_tokens: written,
+        output_tokens: output,
+        reasoning_output_tokens: 0,
+        total_tokens: total_input.saturating_add(output),
+        ..Default::default()
+    })
+}
+
+pub(super) async fn approve(session: &Session, ctx: &TurnContext, request: &Value) -> Value {
+    let id = request["id"].as_str().unwrap_or_default();
+    let tool = request["tool"].as_str().unwrap_or_default();
+    let mut allow = false;
+    let mut remember = "once";
+    if !matches!(ctx.approval_policy(), AskForApproval::Never)
+        && !matches!(tool, "ExitPlanMode" | "EnterPlanMode")
+    {
+        if tool == "Bash" {
+            let command = request["input"]["command"].as_str().unwrap_or_default();
+            let decision = command_approval(
+                session,
+                ctx,
+                id,
+                vec!["bash".into(), "-c".into(), command.into()],
+                request["summary"]
+                    .as_str()
+                    .unwrap_or("Allow this Claude command?"),
+            )
+            .await;
+            allow = matches!(
+                decision,
+                ReviewDecision::Approved | ReviewDecision::ApprovedForSession
+            );
+            if matches!(decision, ReviewDecision::ApprovedForSession) {
+                remember = "session";
+            }
+        } else {
+            let outcome = session.request_mcp_server_elicitation(ctx, "claude".into(), NumberOrString::String(id.into()),
+                ElicitationRequest::Form { meta: None,
+                    message: format!("Allow Claude {tool}?\n{}\n{}", request["summary"].as_str().unwrap_or_default(), bounded(&request["input"].to_string())),
+                    requested_schema: json!({"type":"object","properties":{"allow":{"type":"boolean","title":"Allow this action"}},"required":["allow"]}),
+                }).await;
+            allow = outcome.sent
+                && outcome.response.is_some_and(|response| {
+                    response.action == codex_rmcp_client::ElicitationAction::Accept
+                        && response
+                            .content
+                            .is_some_and(|content| content["allow"] == true)
+                });
+        }
+    }
+    json!({"type":"permission_decision", "id":id, "behavior":if allow {"allow"} else {"deny"},
+        "remember":remember, "message":if allow {"Approved"} else {"Denied by the Codex approval policy or user"}})
+}
+
+pub(super) async fn command_approval(
+    session: &Session,
+    ctx: &TurnContext,
+    id: &str,
+    command: Vec<String>,
+    reason: &str,
+) -> ReviewDecision {
+    #[allow(deprecated)]
+    session
+        .request_command_approval(
+            ctx,
+            ExecApprovalKind::Command,
+            id.into(),
+            None,
+            None,
+            command,
+            codex_utils_path_uri::PathUri::from_abs_path(&ctx.cwd),
+            Some(reason.into()),
+            None,
+            None,
+            None,
+            Some(vec![
+                ReviewDecision::Approved,
+                ReviewDecision::denied("denied"),
+            ]),
+            None,
+        )
+        .await
+}
+
+fn bounded(text: &str) -> String {
+    let mut end = text.len().min(4_000);
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    let mut result = text[..end].to_string();
+    if result.len() < text.len() {
+        result.push_str("\n[Remaining output omitted from this tool summary]");
+    }
+    result
+}
