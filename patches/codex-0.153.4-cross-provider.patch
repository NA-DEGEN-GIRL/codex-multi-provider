+use super::*;
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::SystemTime;
+
+use codex_protocol::models::BaseInstructions;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_protocol::protocol::ThreadMemoryMode;
+use codex_thread_store::ItemSortKey;
+use codex_thread_store::RevertThreadParams;
+use codex_thread_store::SortDirection;
+use codex_thread_store::StoredTurnItemsView;
+use codex_thread_store::ThreadMetadataPatch;
+use codex_thread_store::ThreadPersistenceMetadata;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+
+fn config(home: &Path) -> LocalThreadStoreConfig {
+    LocalThreadStoreConfig {
+        codex_home: home.to_path_buf(),
+        sqlite: codex_state::SqliteConfig::new_for_testing(
+            AbsolutePathBuf::try_from(home).unwrap(),
+        ),
+        default_model_provider_id: "test-provider".to_string(),
+    }
+}
+
+fn snapshot(root: &Path) -> BTreeMap<PathBuf, (Vec<u8>, SystemTime)> {
+    let mut result = BTreeMap::new();
+    let mut directories = vec![root.to_path_buf()];
+    while let Some(directory) = directories.pop() {
+        for entry in fs::read_dir(directory).unwrap() {
+            let path = entry.unwrap().path();
+            let metadata = fs::metadata(&path).unwrap();
+            let contents = if metadata.is_dir() {
+                directories.push(path.clone());
+                Vec::new()
+            } else {
+                fs::read(&path).unwrap()
+            };
+            result.insert(
+                path.strip_prefix(root).unwrap().to_path_buf(),
+                (contents, metadata.modified().unwrap()),
+            );
+        }
+    }
+    result
+}
+
+fn assert_unsupported<T>(result: ThreadStoreResult<T>, expected: &'static str) {
+    match result {
+        Err(ThreadStoreError::Unsupported { operation }) => assert_eq!(operation, expected),
+        Err(error) => panic!("expected unsupported {expected}, received {error}"),
+        Ok(_) => panic!("read-only adapter accepted {expected}"),
+    }
+}
+
+fn assert_wrong_thread<T>(result: ThreadStoreResult<T>) {
+    match result {
+        Err(ThreadStoreError::InvalidRequest { message }) => assert_eq!(
+            message,
+            "read-only source store is bound to another canonical thread"
+        ),
+        Err(error) => panic!("expected canonical scope rejection, received {error}"),
+        Ok(_) => panic!("read-only adapter accepted another thread"),
+    }
+}
+
+#[tokio::test]
+async fn missing_source_is_not_initialized_by_adapter_open() {
+    let home = tempfile::tempdir().unwrap();
+    fs::write(home.path().join("sentinel.txt"), "preserve source").unwrap();
+    let before = snapshot(home.path());
+    assert!(open(config(home.path()), ThreadId::new()).await.is_err());
+    assert_eq!(snapshot(home.path()), before);
+}
+
+#[tokio::test]
+async fn rejected_mutations_and_cross_record_reads_leave_source_unchanged() {
+    let home = tempfile::tempdir().unwrap();
+    let configuration = config(home.path());
+    let state = codex_state::StateRuntime::init(
+        configuration.sqlite.clone(),
+        configuration.default_model_provider_id.clone(),
+    )
+    .await
+    .unwrap();
+    fs::write(home.path().join("sentinel.txt"), "preserve source").unwrap();
+    let before = snapshot(home.path());
+    let thread_id = ThreadId::new();
+    let store = open(configuration.clone(), thread_id).await.unwrap();
+    assert!(is_read_only_store(store.as_ref()));
+    assert!(!store.as_any().is::<codex_thread_store::LocalThreadStore>());
+    assert_eq!(
+        read_metadata(store.as_ref(), thread_id).await.unwrap(),
+        None
+    );
+    assert_unsupported(
+        read_metadata(
+            &codex_thread_store::InMemoryThreadStore::default(),
+            thread_id,
+        )
+        .await,
+        "read_metadata",
+    );
+    assert!(matches_source(store.as_ref(), &configuration, thread_id));
+    assert!(!matches_source(
+        store.as_ref(),
+        &configuration,
+        ThreadId::new()
+    ));
+    let different_home = tempfile::tempdir().unwrap();
+    let mut redirected = config(different_home.path());
+    assert!(!matches_source(store.as_ref(), &redirected, thread_id));
+    redirected.codex_home = configuration.codex_home.clone();
+    assert!(!matches_source(store.as_ref(), &redirected, thread_id));
+    let metadata = ThreadPersistenceMetadata {
+        cwd: Some(home.path().to_path_buf()),
+        model_provider: "test-provider".to_string(),
+        memory_mode: ThreadMemoryMode::Enabled,
+    };
+    assert_unsupported(
+        store
+            .create_thread(CreateThreadParams {
+                session_id: thread_id.into(),
+                thread_id,
+                extra_config: None,
+                forked_from_id: None,
+                parent_thread_id: None,
+                source: SessionSource::Exec,
+                thread_source: None,
+                originator: "read-only-adapter-test".to_string(),
+                base_instructions: BaseInstructions::default(),
+                dynamic_tools: Vec::new(),
+                selected_capability_roots: Vec::new(),
+                multi_agent_version: None,
+                history_mode: ThreadHistoryMode::Legacy,
+                history_base: None,
+                subagent_history_start_ordinal: None,
+                initial_window_id: "window".to_string(),
+                metadata: metadata.clone(),
+            })
+            .await,
+        "create_thread",
+    );
+    assert_unsupported(
+        store
+            .resume_thread(ResumeThreadParams {
+                thread_id,
+                rollout_path: Some(home.path().join("sentinel.txt")),
+                history: None,
+                include_archived: true,
+                metadata,
+            })
+            .await,
+        "resume_thread",
+    );
+    assert_unsupported(
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id,
+                items: Vec::new(),
+            })
+            .await,
+        "append_items",
+    );
+    assert_unsupported(
+        store
+            .persist_thread(thread_id, PersistContext::Standard)
+            .await,
+        "persist_thread",
+    );
+    assert_unsupported(store.flush_thread(thread_id).await, "flush_thread");
+    assert_unsupported(store.shutdown_thread(thread_id).await, "shutdown_thread");
+    assert_unsupported(store.discard_thread(thread_id).await, "discard_thread");
+    assert_unsupported(
+        store
+            .update_thread_metadata(UpdateThreadMetadataParams {
+                thread_id,
+                patch: ThreadMetadataPatch::default(),
+                include_archived: true,
+            })
+            .await,
+        "update_thread_metadata",
+    );
+    assert_unsupported(
+        store
+            .archive_thread(ArchiveThreadParams { thread_id })
+            .await,
+        "archive_thread",
+    );
+    assert_unsupported(
+        store
+            .unarchive_thread(ArchiveThreadParams { thread_id })
+            .await,
+        "unarchive_thread",
+    );
+    assert_unsupported(
+        store.delete_thread(DeleteThreadParams { thread_id }).await,
+        "delete_thread",
+    );
+    assert_unsupported(
+        store
+            .archive_threads(ArchiveThreadsParams {
+                thread_ids: Vec::new(),
+                writer_lock_thread_ids: Vec::new(),
+            })
+            .await,
+        "archive_threads",
+    );
+    assert_unsupported(
+        store
+            .delete_threads(DeleteThreadsParams {
+                thread_ids: Vec::new(),
+            })
+            .await,
+        "delete_threads",
+    );
+    assert_unsupported(
+        store
+            .stage_pending_thread_metadata(thread_id, ThreadMetadataPatch::default())
+            .await,
+        "stage_pending_thread_metadata",
+    );
+    assert_unsupported(
+        store.remove_pending_thread_metadata(thread_id).await,
+        "remove_pending_thread_metadata",
+    );
+    assert_unsupported(
+        store
+            .revert_thread(RevertThreadParams {
+                thread_id,
+                before_turn_id: "turn-1".to_string(),
+            })
+            .await,
+        "revert_thread",
+    );
+    assert_unsupported(
+        store
+            .read_thread_by_rollout_path(ReadThreadByRolloutPathParams {
+                rollout_path: home.path().join("sentinel.txt"),
+                include_archived: true,
+                include_history: true,
+            })
+            .await,
+        "read_thread_by_rollout_path",
+    );
+
+    let other = ThreadId::new();
+    assert_wrong_thread(read_metadata(store.as_ref(), other).await);
+    assert_wrong_thread(
+        store
+            .load_latest_model_context(LoadThreadHistoryParams {
+                thread_id: other,
+                include_archived: true,
+            })
+            .await,
+    );
+    assert_wrong_thread(
+        store
+            .read_thread(ReadThreadParams {
+                thread_id: other,
+                include_archived: true,
+                include_history: false,
+            })
+            .await,
+    );
+    assert_wrong_thread(
+        store
+            .load_history(LoadThreadHistoryParams {
+                thread_id: other,
+                include_archived: true,
+            })
+            .await,
+    );
+    assert_wrong_thread(
+        store
+            .list_turns(ListTurnsParams {
+                thread_id: other,
+                include_archived: true,
+                cursor: None,
+                page_size: 1,
+                sort_direction: SortDirection::Asc,
+                items_view: StoredTurnItemsView::Summary,
+            })
+            .await,
+    );
+    assert_wrong_thread(
+        store
+            .list_items(ListItemsParams {
+                thread_id: other,
+                turn_id: None,
+                include_archived: true,
+                cursor: None,
+                page_size: 1,
+                sort_direction: SortDirection::Asc,
+                sort_key: ItemSortKey::CreatedAtOrdinal,
+                after_updated_at_ordinal: None,
+            })
+            .await,
+    );
+    assert_wrong_thread(
+        store
+            .list_timeline(ListTimelineParams {
+                thread_id: other,
+                cursor: None,
+                page_size: 1,
+            })
+            .await,
+    );
+    assert_wrong_thread(
+        store
+            .search_thread_occurrences(SearchThreadOccurrencesParams {
+                thread_id: other,
+                search_term: "private".to_string(),
+                cursor: None,
+                page_size: 1,
+            })
+            .await,
+    );
+    store
+        .as_any()
+        .downcast_ref::<ManagedReadStore>()
+        .unwrap()
+        .reader
+        .close()
+        .await;
+    assert_eq!(snapshot(home.path()), before);
+    state.close().await;
+}
diff --git a/codex-rs/app-server/src/managed_request_gate.rs b/codex-rs/app-server/src/managed_request_gate.rs
new file mode 100644
index 000000000..6424e765a
--- /dev/null
+++ b/codex-rs/app-server/src/managed_request_gate.rs
@@ -0,0 +1,313 @@
+//! Per-instance admission for managed thread handoff. Independent threads keep
+//! running; a drain only excludes requests targeting its exact subtree.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_protocol::ThreadId;
+use tokio::sync::OwnedRwLockReadGuard;
+use tokio::sync::OwnedRwLockWriteGuard;
+use tokio::sync::RwLock;
+
+use crate::error_code::invalid_request;
+
+#[derive(Clone, Default)]
+pub(crate) struct ManagedRequestGate {
+    threads: Arc<Mutex<HashMap<ThreadId, Arc<RwLock<ManagedGateState>>>>>,
+}
+
+pub(crate) struct ManagedRequestPermit {
+    _guards: Vec<OwnedRwLockReadGuard<ManagedGateState>>,
+}
+
+pub(crate) struct ManagedDrainGuard {
+    guards: Vec<OwnedRwLockWriteGuard<ManagedGateState>>,
+    previous_states: Vec<ManagedGateState>,
+}
+
+#[derive(Clone, Default)]
+pub(crate) struct ManagedGateState {
+    pub(crate) frozen: bool,
+    pub(crate) release_verified: bool,
+    pub(crate) activated_epoch: Option<u64>,
+}
+
+/// Exclusive admission while a source-authorized binding is prepared. Epochs
+/// here are replay protection, never ownership authority: the caller must have
+/// validated the trusted manifest and durable source grant before acquiring it.
+pub(crate) struct ManagedActivationGuard {
+    guards: Vec<(OwnedRwLockWriteGuard<ManagedGateState>, u64)>,
+}
+
+impl ManagedRequestGate {
+    pub(crate) fn try_activate(
+        &self,
+        thread_epochs: &[(ThreadId, u64)],
+    ) -> Result<ManagedActivationGuard, JSONRPCErrorError> {
+        if thread_epochs.is_empty() {
+            return Err(invalid_request(
+                "managed activation requires a canonical subtree",
+            ));
+        }
+        let mut expected = thread_epochs.to_vec();
+        expected.sort_by_key(|(thread_id, _)| thread_id.to_string());
+        for pair in expected.windows(2) {
+            if pair[0].0 == pair[1].0 && pair[0].1 != pair[1].1 {
+                return Err(invalid_request(
+                    "managed activation has conflicting ownership epochs",
+                ));
+            }
+        }
+        expected.dedup();
+        let ids: Vec<_> = expected.iter().map(|(thread_id, _)| *thread_id).collect();
+        let mut guards = Vec::with_capacity(expected.len());
+        for (lock, (_, epoch)) in self.locks(&ids).into_iter().zip(expected) {
+            if epoch == 0 {
+                return Err(invalid_request("managed ownership epoch must be positive"));
+            }
+            let guard = lock.try_write_owned().map_err(|_| {
+                invalid_request("managed thread has a request or lifecycle transition in flight")
+            })?;
+            if guard.frozen && !guard.release_verified {
+                return Err(invalid_request(
+                    "managed thread release is uncertain; a new grant cannot clear this fence",
+                ));
+            }
+            if guard
+                .activated_epoch
+                .is_some_and(|previous| epoch <= previous)
+            {
+                return Err(invalid_request(
+                    "managed activation requires a strictly newer ownership epoch",
+                ));
+            }
+            guards.push((guard, epoch));
+        }
+        Ok(ManagedActivationGuard { guards })
+    }
+}
+
+impl ManagedActivationGuard {
+    /// The caller has installed fresh bindings after atomically verifying that
+    /// the exact subtree contains no loaded or starting actor. No model work is
+    /// started here. Dropping before commit leaves every prior fence unchanged.
+    pub(crate) fn commit(mut self) {
+        for (guard, epoch) in &mut self.guards {
+            guard.frozen = false;
+            guard.release_verified = false;
+            guard.activated_epoch = Some(*epoch);
+        }
+    }
+}
+
+impl ManagedRequestGate {
+    pub(crate) async fn begin(
+        &self,
+        request: &ClientRequest,
+        thread_manager: &codex_core::ThreadManager,
+    ) -> Result<ManagedRequestPermit, JSONRPCErrorError> {
+        if std::env::var_os("CODEX_MANAGER_MANAGED_SOURCES").is_none() {
+            return Ok(ManagedRequestPermit {
+                _guards: Vec::new(),
+            });
+        }
+        let value =
+            serde_json::to_value(request).map_err(|err| invalid_request(err.to_string()))?;
+        let method = value["method"].as_str().unwrap_or_default();
+        if matches!(method, "thread/resume" | "thread/fork")
+            && (value["params"]
+                .get("path")
+                .is_some_and(|path| !path.is_null())
+                || value["params"]
+                    .get("history")
+                    .is_some_and(|history| !history.is_null()))
+        {
+            return Err(invalid_request(
+                "managed source routing requires a canonical thread ID; path/history overrides are disabled",
+            ));
+        }
+        if matches!(
+            method,
+            "project/delete" | "threadSection/delete" | "memory/reset"
+        ) {
+            return Err(invalid_request(
+                "source-wide mutation is disabled while managed record routing is enabled",
+            ));
+        }
+        if matches!(
+            method,
+            "thread/managedCloseIdle"
+                | "thread/managedReloadBinding"
+                | "thread/managedIdleStatus"
+                | "thread/list"
+                | "thread/read"
+                | "thread/loaded/list"
+                | "thread/turns/list"
+                | "thread/items/list"
+                | "thread/timeline/list"
+                | "thread/search"
+                | "thread/searchOccurrences"
+                | "thread/goal/get"
+                | "thread/queue/list"
+        ) {
+            return Ok(ManagedRequestPermit {
+                _guards: Vec::new(),
+            });
+        }
+        let mut ids = Vec::new();
+        if let Some(params) = value["params"].as_object() {
+            for name in [
+                "threadId",
+                "threadIds",
+                "conversationId",
+                "beforeThreadId",
+                "threads",
+            ] {
+                if let Some(value) = params.get(name) {
+                    match value {
+                        serde_json::Value::String(id) => {
+                            if let Ok(id) = ThreadId::from_string(id) {
+                                ids.push(id);
+                            }
+                        }
+                        serde_json::Value::Array(values) => {
+                            ids.extend(
+                                values
+                                    .iter()
+                                    .filter_map(serde_json::Value::as_str)
+                                    .filter_map(|id| ThreadId::from_string(id).ok()),
+                            );
+                        }
+                        _ => {}
+                    }
+                }
+            }
+        }
+        let routed_mutation = matches!(
+            method,
+            "thread/resume"
+                | "thread/unsubscribe"
+                | "thread/name/set"
+                | "turn/start"
+                | "turn/steer"
+                | "turn/interrupt"
+                | "thread/goal/set"
+                | "thread/goal/clear"
+                | "thread/queue/add"
+                | "thread/queue/update"
+                | "thread/queue/delete"
+                | "thread/queue/reorder"
+                | "thread/queue/start"
+        );
+        if !routed_mutation {
+            for id in &ids {
+                if thread_manager.managed_record_binding(*id).await.is_some()
+                    || crate::managed_sources::declared_binding(*id).await?
+                {
+                    return Err(invalid_request(
+                        "this operation has not been enabled for managed canonical records",
+                    ));
+                }
+            }
+        }
+        self.begin_threads(ids)
+    }
+
+    fn begin_threads(
+        &self,
+        mut ids: Vec<ThreadId>,
+    ) -> Result<ManagedRequestPermit, JSONRPCErrorError> {
+        ids.sort_by_key(ToString::to_string);
+        ids.dedup();
+        let locks = self.locks(&ids);
+        let mut guards = Vec::with_capacity(locks.len());
+        for lock in locks {
+            let guard = lock
+                .try_read_owned()
+                .map_err(|_| invalid_request("managed thread is draining; retry after handoff"))?;
+            if guard.frozen {
+                return Err(invalid_request(
+                    "managed thread was released by this instance; use its assigned owner",
+                ));
+            }
+            guards.push(guard);
+        }
+        Ok(ManagedRequestPermit { _guards: guards })
+    }
+
+    pub(crate) fn try_drain(
+        &self,
+        ids: &[ThreadId],
+    ) -> Result<ManagedDrainGuard, JSONRPCErrorError> {
+        let mut ids = ids.to_vec();
+        ids.sort_by_key(ToString::to_string);
+        ids.dedup();
+        let mut guards = Vec::with_capacity(ids.len());
+        for lock in self.locks(&ids) {
+            guards.push(lock.try_write_owned().map_err(|_| {
+                invalid_request("managed thread has a request in flight; wait for it to complete")
+            })?);
+        }
+        let previous_states = guards.iter().map(|guard| (**guard).clone()).collect();
+        Ok(ManagedDrainGuard {
+            guards,
+            previous_states,
+        })
+    }
+
+    fn locks(&self, ids: &[ThreadId]) -> Vec<Arc<RwLock<ManagedGateState>>> {
+        let mut threads = self
+            .threads
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        ids.iter()
+            .map(|id| Arc::clone(threads.entry(*id).or_default()))
+            .collect()
+    }
+}
+
+impl ManagedDrainGuard {
+    /// Seal before invoking Core so cancelling the caller cannot reopen a
+    /// partially stopped actor. Keep the exclusive guards through teardown.
+    pub(crate) fn arm(&mut self) {
+        for guard in &mut self.guards {
+            guard.frozen = true;
+            guard.release_verified = false;
+        }
+    }
+
+    /// Reopen only when Core explicitly refused the first close before stopping
+    /// any actor. Persistence errors and timeouts must never call this method.
+    pub(crate) fn release_after_rejected_close(mut self) {
+        for (guard, previous) in self.guards.iter_mut().zip(self.previous_states) {
+            **guard = previous;
+        }
+    }
+
+    /// Instance maintenance holds a separate global fence. After verified close,
+    /// preserve the same grant so an aborted restart can reload this idle cache.
+    /// Never call this after a partial or unverified close.
+    pub(crate) fn release_after_verified_maintenance(self) {
+        self.release_after_rejected_close();
+    }
+
+    /// Record verified release only after every actor's close has succeeded.
+    /// Dropping an armed guard without committing preserves an unverified fence.
+    pub(crate) fn commit(mut self) {
+        for guard in &mut self.guards {
+            guard.frozen = true;
+            guard.release_verified = true;
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "managed_request_gate_tests.rs"]
+mod tests;
+
+#[cfg(test)]
+#[path = "managed_activation_gate_tests.rs"]
+mod activation_tests;
diff --git a/codex-rs/app-server/src/managed_request_gate_tests.rs b/codex-rs/app-server/src/managed_request_gate_tests.rs
new file mode 100644
index 000000000..1aa93b20a
