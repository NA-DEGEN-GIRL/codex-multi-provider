+use super::*;
+use codex_app_server_protocol::CollabAgentState;
+use codex_app_server_protocol::CollabAgentStatus;
+use codex_app_server_protocol::CollabAgentTool;
+use codex_app_server_protocol::CollabAgentToolCallStatus;
+use codex_app_server_protocol::SubAgentActivityKind;
+use codex_app_server_protocol::ThreadItem;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::SubAgentSource;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::fs;
+use tempfile::TempDir;
+
+#[path = "manager_shared_catalog_tests.rs"]
+mod shared;
+
+#[path = "manager_catalog_projects_tests.rs"]
+mod project_membership;
+
+const THREAD_A: &str = "11111111-1111-4111-8111-111111111111";
+const THREAD_B: &str = "22222222-2222-4222-8222-222222222222";
+const PROJECTION_A: &str = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa";
+const PROJECTION_B: &str = "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb";
+
+pub(super) fn fixture(root: &Path, id: &str, message: &str, history_mode: &str) -> PathBuf {
+    let sessions = root.join("sessions/2026/09/13");
+    fs::create_dir_all(&sessions).unwrap();
+    let path = sessions.join(format!("rollout-2026-09-13T01-00-00-{id}.jsonl"));
+    let meta = json!({"timestamp":"2026-09-13T01:00:00Z","type":"session_meta","payload":{
+        "session_id":id,"id":id,"timestamp":"2026-09-13T01:00:00Z","cwd":root,
+        "originator":"test","cli_version":"test","source":"cli","model_provider":"openai",
+        "history_mode":history_mode
+    }});
+    let event = json!({"timestamp":"2026-09-13T01:00:01Z","type":"event_msg","payload":{
+        "type":"user_message","message":message,"kind":"plain"
+    }});
+    fs::write(&path, format!("{meta}\n{event}\n")).unwrap();
+    path
+}
+
+pub(super) fn source(
+    home: &Path,
+    rollout: &Path,
+    id: &str,
+    projection: &str,
+    store: &str,
+) -> serde_json::Value {
+    json!({"projectionThreadId":projection,"threadId":id,"hostId":"local",
+        "sourceStoreId":store,"codexHome":home,"rolloutPath":rollout})
+}
+
+fn catalog(entries: Vec<serde_json::Value>) -> RecordCatalog {
+    let catalog: RecordCatalog =
+        serde_json::from_value(json!({"version":1,"revision":"revision-1",
+        "hostId":"local","entries":entries}))
+        .unwrap();
+    catalog.validate().unwrap();
+    catalog
+}
+
+fn list_params(value: serde_json::Value) -> ThreadListParams {
+    serde_json::from_value(value).unwrap()
+}
+
+fn resume_params(value: serde_json::Value) -> codex_app_server_protocol::ThreadResumeParams {
+    serde_json::from_value(value).unwrap()
+}
+
+fn cwd(root: &Path) -> AbsolutePathBuf {
+    AbsolutePathBuf::from_absolute_path(root).unwrap()
+}
+
+fn main_database_snapshot(root: &Path) -> Vec<(PathBuf, Option<Vec<u8>>)> {
+    codex_state::SqliteConfig::from_sqlite_home(cwd(root))
+        .runtime_db_paths()
+        .into_iter()
+        .map(|entry| {
+            let contents = entry.path.exists().then(|| fs::read(&entry.path).unwrap());
+            (entry.path, contents)
+        })
+        .collect()
+}
+
+#[tokio::test]
+async fn native_read_observes_changes_without_creating_databases() {
+    let temp = TempDir::new().unwrap();
+    let path = fixture(temp.path(), THREAD_A, "first message", "legacy");
+    let catalog = catalog(vec![source(
+        temp.path(),
+        &path,
+        THREAD_A,
+        PROJECTION_A,
+        "original:local",
+    )]);
+    let request = ThreadReadParams {
+        thread_id: PROJECTION_A.to_string(),
+        include_turns: true,
+    };
+    let before = fs::read(&path).unwrap();
+    let first = catalog
+        .read(request.clone(), &cwd(temp.path()))
+        .await
+        .unwrap();
+    assert_eq!(
+        (
+            &first.thread.id,
+            first.thread.path.as_ref(),
+            first.thread.can_accept_direct_input
+        ),
+        (&PROJECTION_A.to_string(), None, Some(false))
+    );
+    assert!(!first.thread.turns.is_empty());
+    assert_eq!(fs::read(&path).unwrap(), before);
+    assert_eq!(
+        fs::read_dir(temp.path())
+            .unwrap()
+            .map(|entry| entry.unwrap().file_name())
+            .collect::<Vec<_>>(),
