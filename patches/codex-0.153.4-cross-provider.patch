+    let mut file = std::fs::File::open(path).unwrap();
+    assert!(next_durable_ordinal(&mut file).is_err());
+}
+
+#[tokio::test]
+async fn concurrent_accounts_allocate_unique_durable_ordinals() {
+    let temp = TempDir::new().unwrap();
+    let path = temp.path().join("rollout.jsonl");
+    let id = codex_protocol::ThreadId::new().to_string();
+    let meta = json!({"ordinal":0,"timestamp":"2026-09-15T00:00:00Z","type":"session_meta","payload":{
+        "id":id,"session_id":id,"timestamp":"2026-09-15T00:00:00Z","cwd":temp.path(),
+        "originator":"fixture","cli_version":"test","source":"cli","history_mode":"paginated"
+    }});
+    std::fs::write(&path, format!("{meta}\n")).unwrap();
+    let mut tasks = Vec::new();
+    for index in 0..24 {
+        let path = path.clone();
+        tasks.push(tokio::spawn(async move {
+            let item = serde_json::from_value(json!({"type":"event_msg","payload":{
+                "type":"user_message","message":format!("account write {index}"),"kind":"plain"
+            }}))
+            .unwrap();
+            // Every actor started with ordinal 1. The append must allocate from
+            // the physical file after its short write lease, not this stale value.
+            append(
+                path,
+                "2026-09-15T00:00:01Z".into(),
+                item,
+                /*initial_ordinal*/ Some(1),
+            )
+            .await
+            .unwrap();
+        }));
+    }
+    for task in tasks {
+        task.await.unwrap();
+    }
+    let rows: Vec<serde_json::Value> = std::fs::read_to_string(path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str(line).unwrap())
+        .collect();
+    assert_eq!(
+        rows.iter()
