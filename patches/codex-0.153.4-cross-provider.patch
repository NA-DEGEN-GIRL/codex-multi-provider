@@ -0,0 +1,152 @@
+//! Read new-format histories stored through a shared sessions directory.
+
+use super::catalog_mixed::legacy_source;
+use super::catalog_mixed::projection;
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn shared_paginated_index_reads_pages_and_live_commits_without_transferring_the_writer()
+-> Result<()> {
+    let source_api = responses::start_mock_server().await;
+    let viewer_api = responses::start_mock_server().await;
+    let calls = responses::mount_sse_sequence(
+        &source_api,
+        vec![
+            create_final_assistant_message_sse_response("First shared answer")?,
+            create_final_assistant_message_sse_response("Second shared answer")?,
+        ],
+    )
+    .await;
+    let source = ManagedProfile::new(&source_api.uri(), "source-model", "source-token")?;
+    let viewer = ManagedProfile::new(&viewer_api.uri(), "viewer-model", "viewer-token")?;
+    let physical = TempDir::new()?;
+    fs::create_dir(physical.path().join("sessions"))?;
+    #[cfg(windows)]
+    std::os::windows::fs::symlink_dir(
+        physical.path().join("sessions"),
+        source.home.path().join("sessions"),
+    )?;
+    #[cfg(unix)]
+    std::os::unix::fs::symlink(
+        physical.path().join("sessions"),
+        source.home.path().join("sessions"),
+    )?;
+    source.write_manifest(&[&source], Vec::new())?;
+    viewer.write_manifest(&[&viewer], Vec::new())?;
+    let descriptor = legacy_source(physical.path());
+    let catalog = viewer.home.path().join("shared-history.json");
+    fs::write(
+        &catalog,
+        serde_json::to_vec(&json!({
+            "version":3,"hostId":"local","sources":[],
+            "legacySources":[descriptor, legacy_source(source.home.path())]
+        }))?,
+    )?;
+    let original_catalog = fs::read(&catalog)?;
+    // Existing llm-usage profiles use the ordinary native writer. Managed writer
+    // grants intentionally confine sessions to their own home and are unrelated
+    // to enrolling these existing read-only histories.
+    let mut writer = TestAppServer::builder()
+        .with_codex_home(source.home.path())
+        .without_managed_config()
+        .with_env_overrides(&[
+            ("CODEX_MANAGER_MANAGED_SOURCES", None),
+            ("CODEX_MANAGER_SHARED_CATALOG", None),
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            ("CODEX_MANAGED_HANDOFF_TEST_KEY", Some(&source.api_key)),
+            ("CODEX_SQLITE_HOME", None),
+            ("OPENAI_API_KEY", None),
+            ("CODEX_ACCESS_TOKEN", None),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    let canonical = writer
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    complete_turn(&mut writer, &canonical.id, "First shared question").await?;
+    let projected = projection(&descriptor, &canonical.id)?;
+    let mut reader = super::catalog_sources::start_shared(&viewer, &catalog).await?;
+    assert_eq!(
+        super::catalog_sources::list(&mut reader).await?.data[0].id,
+        projected
+    );
+    let request = reader
+        .send_raw_request(
+            "thread/read",
+            Some(json!({"threadId":projected,"includeTurns":true})),
+        )
+        .await?;
+    let read: ThreadReadResponse = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert_eq!(read.thread.id, projected);
+    assert_eq!(
+        serde_json::to_value(&read.thread)?["historyMode"],
+        "paginated"
+    );
+    for method in [
+        "thread/turns/list",
+        "thread/items/list",
+        "thread/timeline/list",
+    ] {
+        let request = reader
+            .send_raw_request(method, Some(json!({"threadId":projected,"limit":1})))
+            .await?;
+        let page: Value = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+        assert!(
+            !page["data"]
+                .as_array()
+                .context("history page data")?
+                .is_empty(),
+            "{method}"
+        );
+    }
+    // Reader hydration subscribes to stored updates; it must not interrupt the owner.
+    let request = reader
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: projected.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let _: ThreadResumeResponse = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    complete_turn(&mut writer, &canonical.id, "Second shared question").await?;
+    timeout(READ_TIMEOUT, async {
+        loop {
+            let request = reader
+                .send_raw_request(
+                    "thread/turns/list",
+                    Some(json!({"threadId":projected,"limit":10,"itemsView":"full"})),
+                )
+                .await?;
+            let page: Value = reader.read_response(request).await?;
+            if page["data"].as_array().context("turn data")?.len() == 2 {
+                assert!(page.to_string().contains("Second shared answer"));
+                break Ok::<_, anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(250)).await;
+        }
+    })
+    .await??;
+    let request = reader
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert!(loaded.data.is_empty());
+    assert_eq!(fs::read(&catalog)?, original_catalog);
+    assert!(
+        !SqliteConfig::from_sqlite_home(physical.path().abs())
+            .state_db_path()
+            .exists()
+    );
+    assert_eq!(calls.requests().len(), 2);
+    assert!(
+        viewer_api
+            .received_requests()
+            .await
+            .context("viewer requests")?
+            .iter()
+            .all(|request| !request.url.path().ends_with("/responses"))
+    );
+    Ok(())
+}
