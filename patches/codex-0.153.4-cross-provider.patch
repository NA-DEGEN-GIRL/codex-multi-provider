+#[tokio::test]
+async fn blocking_session_meta_read_matches_async_reader() -> anyhow::Result<()> {
+    let home = TempDir::new()?;
+    let uuid = Uuid::from_u128(19);
+    let thread_id = ThreadId::from_string(&uuid.to_string())?;
+    let rollout_path = rollout_path(home.path(), "2025-01-03T12-00-00", uuid);
+    write_rollout(&rollout_path, thread_id, "after metadata")?;
+    let contents = fs::read_to_string(&rollout_path)?;
+    let ignored_event = serde_json::json!({
+        "timestamp": "2025-01-03T12:00:00Z",
+        "type": "event_msg",
+        "payload": {"type": "user_message", "message": "before metadata", "kind": "plain"}
+    });
+    let mut padded = format!("\nnot json\n{ignored_event}\n{contents}").into_bytes();
+    padded.resize(padded.len() + 64 * 1024, 0xff);
+    fs::write(&rollout_path, padded)?;
+    let expected = serde_json::to_value(read_session_meta_line(&rollout_path).await?)?;
+
+    // Reference scans list files before reading them, so either representation may be current.
+    let compressed_path = compressed_rollout_path(&rollout_path);
+    let plain_read = crate::list::read_session_meta_line_blocking(&compressed_path)?;
+    assert_eq!(serde_json::to_value(plain_read)?, expected);
+    compress_now(&rollout_path)?;
+    for path in [&rollout_path, &compressed_path] {
+        let compressed_read = crate::list::read_session_meta_line_blocking(path)?;
+        assert_eq!(serde_json::to_value(compressed_read)?, expected);
+    }
+
+    let response_item = serde_json::json!({
+        "timestamp": "2025-01-03T12:00:00Z",
+        "type": "response_item",
+        "payload": {
+            "type": "message",
+            "role": "assistant",
+            "content": [{"type": "output_text", "text": "before metadata"}]
+        }
+    });
+    for invalid in [
+        format!("{response_item}\n{contents}"),
+        "\nnot json\n".to_string(),
+    ] {
+        fs::write(&rollout_path, invalid)?;
+        let blocking_error = crate::list::read_session_meta_line_blocking(&rollout_path)
+            .expect_err("blocking read should reject the rollout");
+        let async_error = read_session_meta_line(&rollout_path)
+            .await
+            .expect_err("async read should reject the rollout");
+        assert_eq!(blocking_error.to_string(), async_error.to_string());
+    }
+    Ok(())
+}
