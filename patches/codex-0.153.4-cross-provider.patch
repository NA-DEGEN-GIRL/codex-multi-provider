+    let temp = TempDir::new().unwrap();
+    let path = temp.path().join("newer-runtime.jsonl");
+    std::fs::write(
+        &path,
+        concat!(
+            "{\"ordinal\":41,\"type\":\"future_payload\",\"payload\":{}}\n",
+            "{\"ordinal\":42,\"type\":\"event_msg\",\"payload\":{\"type\":\"future_event\"}}\n"
+        ),
+    )
+    .unwrap();
+    let mut file = std::fs::File::open(path).unwrap();
+    assert_eq!(next_durable_ordinal(&mut file).unwrap(), 43);
+}
+
+#[test]
