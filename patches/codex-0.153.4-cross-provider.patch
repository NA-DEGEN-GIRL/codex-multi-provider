+#[tokio::test]
+async fn temporary_catalog_failure_recovers_without_reopening_or_loading_a_writer() -> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let manifest = fs::read(&fixture.manifest_path)?;
+    let mut server = fixture.start_server().await?;
+    let request = server
+        .send_raw_request(
+            "thread/resume",
+            Some(json!({"threadId":fixture.projection_id,"excludeTurns":true})),
+        )
+        .await?;
+    let _: ThreadResumeResponse = timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    fs::write(
+        &fixture.manifest_path,
+        b"temporarily incomplete fixture manifest",
+    )?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("thread/status/changed"),
+    )
+    .await??;
+    let changed: ThreadStatusChangedNotification =
+        serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(changed.status, ThreadStatus::SystemError);
+    assert!(
+        timeout(
+            Duration::from_secs(2),
+            server.read_stream_until_notification_message("thread/status/changed")
+        )
+        .await
+        .is_err()
+    );
+    append(
+        &fixture,
+        EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: "during-read-failure".to_string(),
+            trace_id: None,
+            started_at: Some(300),
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        }),
+    )?;
+    append(
+        &fixture,
+        EventMsg::TurnComplete(TurnCompleteEvent {
+            turn_id: "during-read-failure".to_string(),
+            last_agent_message: None,
+            error: None,
+            started_at: Some(300),
+            completed_at: Some(302),
+            duration_ms: Some(2000),
+            time_to_first_token_ms: None,
+        }),
+    )?;
+    let written = fs::read(&fixture.rollout_path)?;
+    fs::write(&fixture.manifest_path, manifest)?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("thread/status/changed"),
+    )
+    .await??;
+    let changed: ThreadStatusChangedNotification =
+        serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(changed.status, ThreadStatus::NotLoaded);
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let completed: TurnCompletedNotification =
+        serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(completed.turn.id, "during-read-failure");
+    let request = server
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(loaded.data, Vec::<String>::new());
+    fixture.assert_source_untouched(&written)?;
+    Ok(())
+}
