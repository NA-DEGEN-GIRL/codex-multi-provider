index 0000000000000000000000000000000000000000..21a5c677c677dd69545c5eeca6d54c66a6fc453a
--- /dev/null
+++ b/codex-rs/app-server-protocol/src/protocol/v2/managed_thread.rs
@@ -0,0 +1,95 @@
+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+
+/// Observe a managed spawn subtree without pausing, sealing, or closing it.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ThreadManagedIdleStatusParams {
+    pub thread_id: String,
+}
+
+/// A bounded activity category, without user input, credentials, or tool output.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadManagedIdleBlocker {
+    pub thread_id: String,
+    pub kind: String,
+}
+
+/// An idle observation never authorizes shutdown or ownership transfer.
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum ThreadManagedIdleProofScope {
+    Advisory,
+}
+
+/// A read-only, non-atomic observation of the exact canonical subtree.
+/// Activity may arrive immediately after any observation. Use managedCloseIdle
+/// for a separate strict release operation; this response is never its proof.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadManagedIdleStatusResponse {
+    pub thread_id: String,
+    pub host_id: String,
+    pub source_store_id: String,
+    pub observed_thread_ids: Vec<String>,
+    pub idle: bool,
+    pub blockers: Vec<ThreadManagedIdleBlocker>,
+    pub proof_scope: ThreadManagedIdleProofScope,
+}
+
+/// Close a managed, loaded spawn subtree without interrupting work.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadManagedCloseIdleParams {
+    pub thread_id: String,
+}
+
+/// Release proof for exactly the actors listed in `closedThreadIds`.
+/// Errors, disconnects, and timeouts are never ownership-transfer proof.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadManagedCloseIdleResponse {
+    pub thread_id: String,
+    pub closed_thread_ids: Vec<String>,
+    /// True only after successful flush, writer close, and actor/listener drain.
+    pub writer_release_verified: bool,
+}
+
+/// Activate an unloaded managed subtree after its source authority has durably
+/// assigned a strictly newer ownership grant to this instance's profile.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ThreadManagedReloadBindingParams {
+    pub thread_id: String,
+    pub host_id: String,
+    pub source_store_id: String,
+    pub owner_profile_id: String,
+    pub ownership_epoch: u64,
+    pub record_revision: u64,
+}
+
+/// Binding evidence returned before a manager permits a new user turn. This is
+/// not an instruction to start, replay, or resume model work.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadManagedReloadBindingResponse {
+    pub thread_id: String,
+    pub host_id: String,
+    pub source_store_id: String,
+    pub owner_profile_id: String,
+    pub ownership_epoch: u64,
+    pub record_revision: u64,
+    pub activated_thread_ids: Vec<String>,
+    pub binding_reloaded: bool,
