+#[tokio::test]
+async fn claude_credential_sources_are_checked_and_a_refused_one_is_never_taken_back() {
+    use codex_app_server_protocol::ExecutionPresetAuthRefusal;
+    use codex_app_server_protocol::ExecutionPresetAuthTokensReadParams;
+    use codex_app_server_protocol::ExecutionPresetAuthTokensReadResponse;
+    const REFUSED: &str = "33333333-3333-4333-8333-333333333333";
+    const SAVED: &str = "44444444-4444-4444-8444-444444444444";
+    let identity = "e".repeat(64);
+    let request = ExecutionPresetAuthTokensReadParams {
+        owner_profile_id: "11111111-1111-4111-8111-111111111111".to_string(),
+        role_id: None,
+        profile_id: "22222222-2222-4222-8222-222222222222".to_string(),
+        kind: "claude".to_string(),
+        expected_account_fingerprint: None,
+        expected_account_identity: Some(identity.clone()),
+        rejected_credential_id: Some(REFUSED.to_string()),
+    };
+    let reply = |source: Option<&str>, id: Option<&str>| ExecutionPresetAuthTokensReadResponse {
+        kind: "claude".to_string(),
+        access_token: "sk-ant-oat01-DUMMY-fixture".to_string(),
+        chatgpt_account_id: None,
+        expires_at: Some(4_000_000_000),
+        account_identity: Some(identity.clone()),
+        credential_source: source.map(str::to_string),
+        credential_id: id.map(str::to_string),
+    };
+    let cases = [
+        (None, None, true),
+        (Some("windowsLogin"), None, true),
+        (Some("longLivedToken"), Some(SAVED), true),
+        (Some("longLivedToken"), Some(REFUSED), false),
+        (Some("longLivedToken"), None, false),
+        (
+            Some("longLivedToken"),
+            Some("44444444-4444-4444-8444-44444444444G"),
+            false,
+        ),
+        (
+            Some("longLivedToken"),
+            Some("AAAAAAAA-4444-4444-8444-444444444444"),
+            false,
+        ),
+        (Some("windowsLogin"), Some(SAVED), false),
+        (Some("somewhereElse"), None, false),
+    ];
+    let mut accepted = Vec::new();
+    for (source, id, _) in &cases {
+        let resolver: Arc<dyn ExecutionPresetAuthResolver> =
+            Arc::new(FixtureResolver(std::sync::Mutex::new(reply(*source, *id))));
+        accepted.push(
+            resolve_credentials(&resolver, request.clone())
+                .await
+                .is_ok(),
+        );
+    }
+    assert_eq!(
+        accepted,
+        cases.iter().map(|(_, _, ok)| *ok).collect::<Vec<_>>()
+    );
+    // A broker's listed refusal keeps its reason through the resolver.
+    let refusing: Arc<dyn ExecutionPresetAuthResolver> = Arc::new(RefusingResolver);
+    let error = resolve_credentials(&refusing, request)
+        .await
+        .expect_err("refused");
+    assert_eq!(
+        error
+            .get_ref()
+            .and_then(|inner| inner.downcast_ref::<ExecutionPresetAuthRefusal>())
+            .copied(),
+        Some(ExecutionPresetAuthRefusal::ClaudeLongLivedRejected)
+    );
+}
