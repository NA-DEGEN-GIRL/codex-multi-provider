+        .expect("read source metadata")
+        .expect("source record");
+    assert_eq!(metadata.id, fixture.thread_id);
+    assert!(
+        reader
+            .read_metadata(ThreadId::new())
+            .await
+            .expect("query missing metadata")
+            .is_none()
+    );
+    let context = reader
+        .load_latest_model_context(LoadThreadHistoryParams {
+            thread_id: fixture.thread_id,
+            include_archived: false,
+        })
+        .await
+        .expect("stage complete current context");
+    assert_eq!(context.thread_id, fixture.thread_id);
+    assert!(
+        matches!(context.items.first(), Some(RolloutItem::SessionMeta(meta)) if meta.meta.id == fixture.thread_id)
+    );
+    assert_eq!(context_turn_ids(&context.items), vec!["turn-1", "turn-2"]);
+    assert!(
+        fixture.store.live_recorders.lock().await.is_empty(),
+        "context staging must not create a live writer"
+    );
+    assert_source_unchanged(fixture.home.path(), &before);
+
+    fixture
+        .store
+        .revert_thread(RevertThreadParams {
+            thread_id: fixture.thread_id,
+            before_turn_id: "turn-2".to_string(),
+        })
+        .await
+        .expect("revert source before second turn");
+    let before = source_snapshot(fixture.home.path());
+    let context = reader
+        .load_latest_model_context(LoadThreadHistoryParams {
+            thread_id: fixture.thread_id,
+            include_archived: false,
+        })
+        .await
+        .expect("stage reference-backed reverted context");
+    assert_eq!(context_turn_ids(&context.items), vec!["turn-1"]);
+    assert!(
+        matches!(context.items.first(), Some(RolloutItem::SessionMeta(meta)) if meta.meta.id == fixture.thread_id)
