+
+// The fake runner enforces the same handshake and durable-history commit as the Python
+// manager. Its state is private to this test; it never discovers or invokes Claude.
+const RUNNER: &str = r#"
+import json, pathlib, sys
+state = pathlib.Path(sys.argv[1])
+log = pathlib.Path(sys.argv[2])
+def read(): return json.loads(sys.stdin.readline())
+def emit(value): print(json.dumps(value), flush=True)
+hello = read()
+assert hello['protocol'] == 1 and hello['trusted_cwd']
+prior = json.loads(state.read_text()) if state.exists() else None
+emit({'type':'ready','protocol':1,'session':prior,'cli_version':'fake'})
+run = read()
+with log.open('a', encoding='utf-8') as out: out.write(json.dumps(run) + '\n')
+assert run['type'] == 'run'
+emit({'type':'event','kind':'text_delta','text':'Native '})
+emit({'type':'event','kind':'text_delta','text':'Claude answer'})
+emit({'type':'event','kind':'text','text':'Native Claude answer'})
+emit({'type':'done','status':'success','result_text':'Native Claude answer'})
+commit = read()
+assert commit['type'] == 'commit'
+snapshot = commit['snapshot']
+state.write_text(json.dumps({'id':'fake-session','dirty':False,'covered':snapshot['turn_ids'],
+    'turn_fingerprints':snapshot['turn_fingerprints'],'fingerprint':snapshot['fingerprint']}))
+emit({'type':'committed','session_id':'fake-session'})
+# The real runner exits after committing; waiting for host EOF would deadlock
+# with the native bridge, which waits for the committed runner to exit.
+"#;
+
+/// Starts a native Claude task whose runner is the given fake script.
+async fn claude_task(
+    server: &wiremock::MockServer,
+    fixture: &std::path::Path,
+    runner: &str,
+) -> anyhow::Result<TestCodex> {
+    let script = fixture.join("runner.py");
+    std::fs::write(&script, runner)?;
+    let provider: ModelProviderInfo = serde_json::from_value(serde_json::json!({
+        "name":"Claude", "agent":{"kind":"claude_code", "command":if cfg!(windows) {"python"} else {"python3"},
+            "args":["-u",script,fixture.join("state.json"),fixture.join("requests.jsonl")],
+            "profile_id":"fake-profile"}
+    }))?;
+    test_codex()
+        .with_config(move |config| {
+            config.sqlite = codex_state::SqliteConfig::from_sqlite_home(config.codex_home.clone());
+            config.model_provider_id = "claude_code".into();
+            config.model_provider = provider.clone();
+            config
+                .model_providers
+                .insert("claude_code".into(), provider);
+            config.active_project.trust_level = Some(TrustLevel::Trusted);
+            config
+                .permissions
+                .set_permission_profile(PermissionProfile::Disabled)
+                .expect("permission profile");
+        })
+        .build_with_auto_env(server)
+        .await
+}
+
+async fn complete_turn(test: &TestCodex, prompt: &str) {
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: prompt.into(),
+            text_elements: Vec::new(),
+        }]))
+        .await
+        .expect("turn starts");
+    let terminal = wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_) | EventMsg::Error(_))
+    })
+    .await;
+    match terminal {
+        EventMsg::TurnComplete(event) => assert_eq!(
+            event.last_agent_message.as_deref(),
+            Some("Native Claude answer")
+        ),
+        event => panic!("unexpected agent task failure: {event:?}"),
+    }
+}
+
+fn logged(fixture: &std::path::Path) -> anyhow::Result<Vec<Value>> {
+    Ok(std::fs::read_to_string(fixture.join("requests.jsonl"))?
+        .lines()
+        .map(serde_json::from_str)
+        .collect::<Result<_, _>>()?)
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn claude_native_task_commits_and_resumes_without_replaying_covered_turns()
+-> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let fixture = tempfile::tempdir()?;
+    let test = claude_task(&server, fixture.path(), RUNNER).await?;
+    for prompt in ["First request", "Next request"] {
+        complete_turn(&test, prompt).await;
+    }
+    let runs = logged(fixture.path())?;
+    assert_eq!(
+        runs.iter()
+            .map(|run| run["mode"].as_str().unwrap())
+            .collect::<Vec<_>>(),
+        vec!["fresh", "resume"]
+    );
+    assert_eq!(
+        runs[1]["blocks"],
+        serde_json::json!([{"kind":"request","text":"Next request\n"}])
+    );
+    assert!(
+        server.received_requests().await.unwrap().is_empty(),
+        "agent turns must never use the model HTTP endpoint"
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn claude_session_stopped_by_an_expired_login_resumes_without_replaying_that_turn()
+-> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let fixture = tempfile::tempdir()?;
+    // The first request stops on an expired login after partial work; the runner keeps its
+    // session dirty with a login-stop marker, as the manager runner does after a clean stop.
+    let runner = RUNNER.replace(
+        "assert run['type'] == 'run'\n",
+        r#"assert run['type'] == 'run' and hello['auth_resume'] == 1
+if prior is None:
+    emit({'type':'event','kind':'text','text':'Partial work before the login expired'})
+    seen = {turn: value for turn, value in hello['snapshot']['turn_fingerprints'].items() if turn != hello['turn_id']}
+    state.write_text(json.dumps({'id':'fake-session','dirty':True,'covered':[],'turn_fingerprints':{},
+        'auth_stop':{'turn_id':hello['turn_id'],'turn_fingerprints':seen}}))
+    emit({'type':'done','status':'error','error':{'code':'claude_auth_expired','message':'login expired'}})
+    sys.exit(0)
+"#,
+    );
+    let test = claude_task(&server, fixture.path(), &runner).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "First request".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await
+        .expect("turn starts");
+    let stopped = wait_for_event(&test.codex, |event| matches!(event, EventMsg::Error(_))).await;
+    assert!(
+        matches!(&stopped, EventMsg::Error(error) if error.message.contains("login expired")),
+        "unexpected stop: {stopped:?}"
+    );
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    complete_turn(&test, "Next request").await;
+    let runs = logged(fixture.path())?;
+    assert_eq!(
+        runs.iter()
+            .map(|run| run["mode"].as_str().unwrap())
+            .collect::<Vec<_>>(),
+        vec!["fresh", "resume"]
+    );
+    // Claude's own session holds the stopped request and its partial work.
+    assert_eq!(
+        runs[1]["blocks"],
+        serde_json::json!([{"kind":"request","text":"Next request\n"}])
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn claude_renewal_request_without_a_borrowed_token_is_unavailable() -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let fixture = tempfile::tempdir()?;
+    // The runner asks for a renewed login mid-turn, reports a refused saved token (never
+    // answered) and asks to switch, then asks for a live rotation while it keeps streaming,
+    // and completes normally. Nothing was lent, so nothing is resolved or recorded.
+    let runner = RUNNER.replace(
+        "assert run['type'] == 'run'\n",
+        r#"assert run['type'] == 'run'
+emit({'type':'auth_refresh'})
+reply = read()
+saved = '44444444-4444-4444-8444-444444444444'
+emit({'type':'auth_rejected','credential_id':saved})
+emit({'type':'auth_refresh','reason':'switch','rejected_credential_id':saved})
+switch = read()
+emit({'type':'auth_refresh','reason':'rotate'})
+emit({'type':'event','kind':'text_delta','text':'Streaming '})
+rotation = read()
+with log.open('a', encoding='utf-8') as out:
+    out.write(json.dumps({'announced':[key for key in ('auth_refresh','auth_rotate','auth_sources') if key in hello],
+                          'replies':[reply, switch, rotation]}) + '\n')
+"#,
+    );
+    let test = claude_task(&server, fixture.path(), &runner).await?;
+    complete_turn(&test, "Request").await;
+    let records = logged(fixture.path())?;
+    let unavailable = serde_json::json!({"type":"auth_update","available":false});
+    assert_eq!(
+        records[1],
+        serde_json::json!({"announced":[],"replies":[unavailable, unavailable, unavailable]})
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn claude_runner_gone_before_a_permission_decision_reports_its_own_error()
+-> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let fixture = tempfile::tempdir()?;
+    // Like a runner that gave up waiting for a login renewal, this one stops reading and
+    // exits while its permission request is still open; its terminal message decides the turn.
+    let runner = RUNNER.replace(
+        "assert run['type'] == 'run'\n",
+        r#"assert run['type'] == 'run'
+import os
+os.close(0)
+emit({'type':'permission_request','id':'stale','tool':'ExitPlanMode','input':{},'summary':'stale'})
+emit({'type':'done','status':'error','error':{'code':'claude_auth_expired','message':'login expired'}})
+sys.exit(0)
+"#,
+    );
+    let test = claude_task(&server, fixture.path(), &runner).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Request".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await
+        .expect("turn starts");
+    let stopped = wait_for_event(&test.codex, |event| matches!(event, EventMsg::Error(_))).await;
+    assert!(
+        matches!(&stopped, EventMsg::Error(error) if error.message.contains("Claude agent: login expired")),
+        "unexpected stop: {stopped:?}"
+    );
+    Ok(())
+}
