+fn append(fixture: &CatalogFixture, event: EventMsg) -> Result<()> {
+    let mut file = fs::OpenOptions::new()
+        .append(true)
+        .open(&fixture.rollout_path)?;
+    writeln!(
+        file,
+        "{}",
+        json!({"timestamp":"2026-09-13T13:30:00Z","type":"event_msg","payload":event})
+    )?;
+    file.flush()?;
+    Ok(())
+}
+
+fn plan(text: &str) -> TurnItem {
+    TurnItem::Plan(PlanItem {
+        id: "shared-plan".to_string(),
+        text: text.to_string(),
+    })
+}
+
+#[tokio::test]
+async fn large_common_record_opens_and_receives_small_updates_without_copying_old_items()
+-> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let turn_id = "large-existing-turn".to_string();
+    append(
+        &fixture,
+        EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: turn_id.clone(),
+            trace_id: None,
+            started_at: Some(100),
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        }),
+    )?;
+    for index in 0..3 {
+        append(
+            &fixture,
+            EventMsg::ItemStarted(ItemStartedEvent {
+                thread_id: ThreadId::from_string(&fixture.thread_id)?,
+                turn_id: turn_id.clone(),
+                item: TurnItem::Plan(PlanItem {
+                    id: format!("large-existing-{index}"),
+                    text: "x".repeat(3 * 1024 * 1024),
+                }),
+                started_at_ms: 100_000,
+            }),
+        )?;
+    }
+    let mut server = fixture.start_server().await?;
+    let request = server
+        .send_raw_request(
+            "thread/resume",
+            Some(json!({
+                "threadId":fixture.projection_id, "excludeTurns":true,
+            })),
+        )
+        .await?;
+    let response: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(response.thread.can_accept_direct_input, Some(false));
+    append(
+        &fixture,
+        EventMsg::ItemStarted(ItemStartedEvent {
+            thread_id: ThreadId::from_string(&fixture.thread_id)?,
+            turn_id: turn_id.clone(),
+            item: plan("new small update"),
+            started_at_ms: 101_000,
+        }),
+    )?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("item/started"),
+    )
+    .await??;
+    let item: ItemStartedNotification = serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(item.item.id(), "shared-plan");
+    assert!(serde_json::to_string(&item.item)?.contains("new small update"));
+    append(
+        &fixture,
+        EventMsg::TurnComplete(TurnCompleteEvent {
+            turn_id: turn_id.clone(),
+            last_agent_message: None,
+            error: None,
+            started_at: Some(100),
+            completed_at: Some(102),
+            duration_ms: Some(2000),
+            time_to_first_token_ms: None,
+        }),
+    )?;
+    let written = fs::read(&fixture.rollout_path)?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("item/completed"),
+    )
+    .await??;
+    let completed_item: ItemCompletedNotification =
+        serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(completed_item.item.id(), "shared-plan");
+    assert_eq!(completed_item.item, item.item);
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let completed: TurnCompletedNotification =
+        serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(completed.turn.id, turn_id);
+    let request = server
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(loaded.data, Vec::<String>::new());
+    fixture.assert_source_untouched(&written)?;
+    Ok(())
+}
