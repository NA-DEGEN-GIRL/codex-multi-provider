+/// Each item as its kind and, for tool items, its call ID.
+fn item_shapes(transcript: &codex_rollout::ModelTranscript) -> Vec<String> {
+    transcript
+        .items
+        .iter()
+        .map(|item| match &item.item.item {
+            ResponseItem::FunctionCall { call_id, .. } => format!("call {call_id}"),
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                ..
+            } => format!("output {call_id}"),
+            ResponseItem::Message { role, content, .. } => match content.first() {
+                Some(ContentItem::InputText { text } | ContentItem::OutputText { text }) => {
+                    format!("{role} {text}")
+                }
+                _ => role.clone(),
+            },
+            ResponseItem::Reasoning { .. } => "reasoning".to_string(),
+            other => format!("{other:?}"),
+        })
+        .collect()
+}
