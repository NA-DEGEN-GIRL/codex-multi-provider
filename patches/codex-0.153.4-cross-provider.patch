--- /dev/null
+++ b/codex-rs/core/src/thread_manager/managed_activation.rs
@@ -0,0 +1,313 @@
+//! Admit a new durable owner without refreshing a previous actor's immutable write lifetime.
+use super::*;
+use codex_thread_store::ManagedAuthorityGrant;
+use codex_thread_store::ReadOnlyLocalThreadStore;
+
+const MAX_ACTIVATION_THREADS: usize = 128;
+
+/// Cancellation after the session is born cannot be treated as proof that its actor stopped.
+pub(super) struct ManagedStartupTracker {
+    uncertain: Arc<std::sync::Mutex<HashSet<ThreadId>>>,
+    thread_ids: Vec<ThreadId>,
+    completed: bool,
+}
+
+impl ManagedStartupTracker {
+    pub(super) fn complete(&mut self) {
+        self.completed = true;
+    }
+}
+
+impl Drop for ManagedStartupTracker {
+    fn drop(&mut self) {
+        if !self.completed && !self.thread_ids.is_empty() {
+            let mut uncertain = self
+                .uncertain
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            uncertain.extend(self.thread_ids.iter().copied());
+        }
+    }
+}
+
+impl ThreadManagerState {
+    pub(super) fn check_managed_startup_uncertainty(
+        &self,
+        thread_ids: &[ThreadId],
+    ) -> CodexResult<()> {
+        let uncertain = self
+            .managed_uncertain_startups
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if thread_ids.iter().any(|id| uncertain.contains(id)) {
+            return Err(CodexErr::InvalidRequest(
+                "managed task startup was cancelled before actor registration; runtime recovery is required".to_string(),
+            ));
+        }
+        Ok(())
+    }
+
+    pub(super) fn track_managed_startup(
+        &self,
+        binding: Option<&ManagedThreadBinding>,
+        ancestor_admissions: &[ThreadId],
+    ) -> CodexResult<ManagedStartupTracker> {
+        // Callers pass only managed ancestor IDs. Ephemeral/internal children have no binding
+        // of their own, but an uncertain child still prevents its canonical parent handing off.
+        let mut thread_ids = ancestor_admissions.to_vec();
+        if let Some(binding) = binding {
+            thread_ids.push(binding.thread_id());
+        }
+        self.check_managed_startup_uncertainty(&thread_ids)?;
+        Ok(ManagedStartupTracker {
+            uncertain: Arc::clone(&self.managed_uncertain_startups),
+            thread_ids,
+            completed: false,
+        })
+    }
+
+    /// Shared startup admission is per canonical UUID; unrelated threads keep starting normally.
+    pub(super) fn managed_lifecycle_locks_for(
+        &self,
+        thread_ids: &[ThreadId],
+    ) -> Vec<Arc<RwLock<()>>> {
+        let mut ids = thread_ids.to_vec();
+        ids.sort_by_key(ToString::to_string);
+        ids.dedup();
+        let mut locks = self
+            .managed_lifecycle_locks
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        locks.retain(|_, lock| lock.strong_count() != 0);
+        ids.into_iter()
+            .map(|thread_id| {
+                if let Some(lock) = locks.get(&thread_id).and_then(std::sync::Weak::upgrade) {
+                    lock
+                } else {
+                    let lock = Arc::new(RwLock::new(()));
+                    locks.insert(thread_id, Arc::downgrade(&lock));
+                    lock
+                }
+            })
+            .collect()
+    }
+}
+
+impl ThreadManager {
+    /// Read the exact persisted root and descendants from the canonical source, including closed
+    /// descendants. The caller must acquire its own request gates for this whole returned set.
+    pub async fn managed_activation_thread_ids(
+        &self,
+        binding: &ManagedThreadBinding,
+    ) -> CodexResult<Vec<ThreadId>> {
+        let _permit = binding.write_permit().await.map_err(activation_error)?;
+        let source = binding.source_config();
+        let reader =
+            ReadOnlyLocalThreadStore::open(source.codex_home.clone(), source.sqlite.clone())
+                .await
+                .map_err(activation_error)?;
+        let result =
+            async {
+                let root = reader
+                    .read_thread(ReadThreadParams {
+                        thread_id: binding.thread_id(),
+                        include_archived: true,
+                        include_history: false,
+                    })
+                    .await;
+                match root {
+                    Ok(root)
+                        if root.thread_id == binding.thread_id()
+                            && root.parent_thread_id.is_none()
+                            && !root.source.is_non_root_agent() => {}
+                    Ok(_) => {
+                        return Err(CodexErr::InvalidRequest(
+                            "managed activation requires a canonical root task".to_string(),
+                        ));
+                    }
+                    Err(codex_thread_store::ThreadStoreError::ThreadNotFound { thread_id })
+                        if thread_id == binding.thread_id() =>
+                    {
+                        // A registered root before its first turn has a real writer
+                        // reservation but intentionally has no persisted record yet.
+                        // This exception requires the live actor and absent rollout;
+                        // it never admits a missing cold record during activation.
+                        let actor = self.get_thread(thread_id).await?;
+                        let configured = actor.session_configured();
+                        if !actor.is_running()
+                            || actor.session_source.is_non_root_agent()
+                            || configured.forked_from_id.is_some()
+                            || configured
+                                .initial_messages
+                                .as_ref()
+                                .is_some_and(|items| !items.is_empty())
+                            || actor.token_usage_info().await.is_some()
+                        {
+                            return Err(CodexErr::InvalidRequest(
+                                "canonical root record is missing".to_string(),
+                            ));
+                        }
+                        let installed =
+                            self.managed_record_binding(thread_id)
+                                .await
+                                .ok_or_else(|| {
+                                    CodexErr::InvalidRequest(
+                                        "canonical root binding is missing".to_string(),
+                                    )
+                                })?;
+                        if installed.source_id() != binding.source_id()
+                            || installed.authority_grant() != binding.authority_grant()
+                            || installed.is_released()
+                        {
+                            return Err(CodexErr::InvalidRequest(
+                                "canonical root binding changed".to_string(),
+                            ));
+                        }
+                        let path = installed
+                            .store()
+                            .live_rollout_path(thread_id)
+                            .await
+                            .map_err(activation_error)?;
+                        let plain = codex_rollout::plain_rollout_path(&path);
+                        let compressed = plain.with_extension("jsonl.zst");
+                        for path in [plain, compressed] {
+                            match tokio::fs::symlink_metadata(path).await {
+                                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                                _ => return Err(CodexErr::InvalidRequest(
+                                    "canonical root record cannot be verified as unmaterialized"
+                                        .to_string(),
+                                )),
+                            }
+                        }
+                    }
+                    Err(error) => return Err(activation_error(error)),
+                }
+                let mut ids = reader
+                    .list_thread_spawn_descendants(binding.thread_id(), MAX_ACTIVATION_THREADS - 1)
+                    .await
+                    .map_err(activation_error)?;
+                if ids.contains(&binding.thread_id()) {
+                    return Err(CodexErr::InvalidRequest(
+                        "managed activation subtree is cyclic".to_string(),
+                    ));
+                }
+                ids.push(binding.thread_id());
+                ids.sort_by_key(ToString::to_string);
+                ids.dedup();
+                Ok(ids)
+            }
+            .await;
+        reader.close().await;
+        result
+    }
+
+    /// Install bindings only after the manager has committed durable source ownership and the
+    /// caller holds exclusive request gates for `expected_grants`. This starts no actors and
+    /// is not a drain, shutdown, writer-release, or durable ownership transfer operation.
+    pub async fn activate_managed_record_binding(
+        &self,
+        binding: ManagedThreadBinding,
+        expected_grants: &[(ThreadId, ManagedAuthorityGrant)],
+    ) -> CodexResult<Vec<ThreadId>> {
+        let expected = self.managed_activation_thread_ids(&binding).await?;
+        let expected_thread_ids = expected_grants
+            .iter()
+            .map(|(id, _)| *id)
+            .collect::<Vec<_>>();
+        if expected != expected_thread_ids {
+            return Err(CodexErr::InvalidRequest(
+                "managed activation gates do not cover the exact canonical subtree".to_string(),
+            ));
+        }
+        let mut _admissions = Vec::new();
+        for lock in self.state.managed_lifecycle_locks_for(&expected) {
+            _admissions.push(lock.try_write_owned().map_err(|_| {
+                CodexErr::InvalidRequest(
+                    "a canonical task is starting or another activation is in progress".to_string(),
+                )
+            })?);
+        }
+        self.state.check_managed_startup_uncertainty(&expected)?;
+        // A new child can acquire its parent's admission before its graph edge is published.
+        // Re-reading with every known parent held makes such a race fail instead of missing it.
+        if self.managed_activation_thread_ids(&binding).await? != expected {
+            return Err(CodexErr::InvalidRequest(
+                "canonical subtree changed during managed activation".to_string(),
+            ));
+        }
+        {
+            let threads = self.state.threads.read().await;
+            if expected.iter().any(|id| threads.contains_key(id)) {
+                return Err(CodexErr::InvalidRequest(
+                    "managed activation requires every canonical task actor to be unloaded"
+                        .to_string(),
+                ));
+            }
+        }
+        let mut replacements = Vec::with_capacity(expected.len());
+        for (thread_id, expected_grant) in expected_grants {
+            let fresh = if *thread_id == binding.thread_id() {
+                binding.clone()
+            } else {
+                binding
+                    .for_child(*thread_id)
+                    .await
+                    .map_err(activation_error)?
+            };
+            if fresh.authority_grant() != expected_grant {
+                return Err(CodexErr::InvalidRequest(
+                    "canonical ownership changed after managed activation gate preflight"
+                        .to_string(),
+                ));
+            }
+            fresh
+                .verify_writer_absent()
+                .await
+                .map_err(activation_error)?;
+            replacements.push(fresh);
+        }
+        let mut _permits = Vec::with_capacity(replacements.len());
+        for fresh in &replacements {
+            _permits.push(fresh.write_permit().await.map_err(activation_error)?);
+        }
+        let mut bindings = self.state.managed_record_bindings.write().await;
+        for fresh in &mut replacements {
+            if let Some(previous) = bindings.get(&fresh.thread_id()) {
+                if previous.source_id() != fresh.source_id()
+                    || previous.source_config().codex_home != fresh.source_config().codex_home
+                {
+                    return Err(CodexErr::InvalidRequest(
+                        "canonical UUID is already bound to another managed source".to_string(),
+                    ));
+                }
+                if previous.authority_grant() == fresh.authority_grant() && !previous.is_released()
+                {
+                    // A dormant read binding may already hold this grant. Keep that exact
+                    // lifetime; never create a second store for an already admitted grant.
+                    *fresh = previous.clone();
+                } else if fresh.authority_grant().epoch <= previous.authority_grant().epoch
+                    || fresh.authority_grant().revision <= previous.authority_grant().revision
+                {
+                    return Err(CodexErr::InvalidRequest(
+                        "a revoked managed binding requires a newer durable ownership grant"
+                            .to_string(),
+                    ));
+                }
+            }
+        }
+        // All fallible preflight precedes the first map change. A later source CAS still fences
+        // these immutable stores on every write; it can never refresh an old actor implicitly.
+        for fresh in replacements {
+            bindings.insert(fresh.thread_id(), fresh);
+        }
+        Ok(expected)
+    }
+}
+
+fn activation_error(error: ThreadStoreError) -> CodexErr {
+    CodexErr::InvalidRequest(error.to_string())
+}
