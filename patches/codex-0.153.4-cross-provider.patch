@@ -0,0 +1,221 @@
+//! Projects only the admitted native collaboration tools into Claude's MCP bridge.
+use std::collections::BTreeMap;
+use std::collections::HashSet;
+use std::sync::Arc;
+
+use codex_protocol::error::Result;
+use codex_protocol::protocol::MultiAgentVersion;
+use codex_tools::ResponsesApiNamespaceTool;
+use codex_tools::ResponsesApiTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use serde::Deserialize;
+use serde_json::Map;
+use serde_json::Value;
+use serde_json::json;
+use tokio::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+
+use super::bridge::failure;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::session::turn_context::TurnContext;
+use crate::tools::context::ToolCallSource;
+use crate::tools::context::ToolPayload;
+use crate::tools::router::ToolCall;
+use crate::turn_diff_tracker::TurnDiffTracker;
+
+const TOOL_NAMES: [&str; 6] = [
+    "spawn_agent",
+    "followup_task",
+    "send_message",
+    "list_agents",
+    "wait_agent",
+    "interrupt_agent",
+];
+const MAX_RESULT_BYTES: usize = 8192;
+
+pub(super) struct Delegation {
+    step: Arc<StepContext>,
+    names: BTreeMap<String, ToolName>,
+    catalog: Vec<Value>,
+    handled: HashSet<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    #[serde(rename = "type")]
+    kind: String,
+    id: String,
+    name: String,
+    arguments: Map<String, Value>,
+}
+
+impl Delegation {
+    pub(super) async fn prepare(
+        session: &Arc<Session>,
+        turn: &Arc<TurnContext>,
+        cancellation: &CancellationToken,
+    ) -> Result<Option<Self>> {
+        if turn.multi_agent_version != MultiAgentVersion::V2 {
+            return Ok(None);
+        }
+        let step = session
+            .capture_step_context(Arc::clone(turn), cancellation)
+            .await?;
+        let (names, catalog) = catalog(
+            &step.tool_router.model_visible_specs(),
+            turn.config.multi_agent_v2.tool_namespace.as_deref(),
+        );
+        if names.is_empty() {
+            return Ok(None);
+        }
+        Ok(Some(Self {
+            step,
+            names,
+            catalog,
+            handled: HashSet::new(),
+        }))
+    }
+
+    pub(super) fn catalog(&self) -> &[Value] {
+        &self.catalog
+    }
+
+    pub(super) async fn dispatch(
+        &mut self,
+        session: &Arc<Session>,
+        event: Value,
+        cancellation: &CancellationToken,
+    ) -> Result<Value> {
+        if event.to_string().len() > 32768 {
+            return Err(failure("delegation request exceeds the bridge limit"));
+        }
+        let request: Request =
+            serde_json::from_value(event).map_err(|_| failure("invalid delegation request"))?;
+        if request.kind != "agent_request"
+            || uuid::Uuid::parse_str(&request.id).is_err()
+            || self.handled.len() >= 1024
+            || !self.handled.insert(request.id.clone())
+        {
+            return Err(failure("invalid or repeated delegation request identifier"));
+        }
+        let Some(name) = self.names.get(&request.name).cloned() else {
+            return Ok(json!({"type":"agent_response", "id":request.id,
+                "error":"This delegation tool is not available in the current task."}));
+        };
+        let call = ToolCall {
+            tool_name: name,
+            call_id: format!("claude-agent-{}", request.id),
+            payload: ToolPayload::Function {
+                arguments: Value::Object(request.arguments).to_string(),
+            },
+            encrypted_function_args: None,
+        };
+        // The normal router retains role/account checks, tool hooks, execution
+        // limits, native activity events and the root-scoped AgentControl.
+        let outcome = self
+            .step
+            .tool_router
+            .dispatch_tool_call_with_code_mode_result(
+                Arc::clone(session),
+                Arc::clone(&self.step),
+                cancellation.clone(),
+                Arc::new(Mutex::new(TurnDiffTracker::new())),
+                call,
+                ToolCallSource::DirectPlaintextMessage,
+            )
+            .await;
+        match outcome {
+            Ok(output) => {
+                let mut result = output.code_mode_result();
+                if matches!(request.name.as_str(), "wait_agent" | "list_agents") {
+                    let communications = session
+                        .input_queue
+                        .take_queue_only_mailbox_communications()
+                        .await
+                        .unwrap_or_default();
+                    let mut messages = Vec::new();
+                    for communication in communications {
+                        // Preserve opaque messages in native history, but never project
+                        // their content into the external provider's tool result.
+                        if communication.encrypted_content.is_none() {
+                            messages.push(
+                                json!({"sender":communication.author,"text":communication.content}),
+                            );
+                        } else {
+                            messages.push(json!({"error":"An encrypted agent message requires the native recipient."}));
+                        }
+                        session
+                            .record_inter_agent_communication(&self.step.turn, communication)
+                            .await;
+                    }
+                    if !messages.is_empty() {
+                        result = json!({"tool_result":result,"messages":messages});
+                    }
+                }
+                Ok(json!({"type":"agent_response","id":request.id,"result":bounded_result(result)}))
+            }
+            Err(error) => Ok(json!({"type":"agent_response","id":request.id,
+                "error":bounded_text(&error.to_string(), MAX_RESULT_BYTES)})),
+        }
+    }
+}
+
+fn catalog(
+    specs: &[ToolSpec],
+    namespace: Option<&str>,
+) -> (BTreeMap<String, ToolName>, Vec<Value>) {
+    let mut names = BTreeMap::new();
+    let mut catalog = Vec::new();
+    let mut add = |tool: &ResponsesApiTool, namespace: Option<&str>| {
+        if !TOOL_NAMES.contains(&tool.name.as_str()) || names.contains_key(&tool.name) {
+            return;
+        }
+        names.insert(
+            tool.name.clone(),
+            ToolName::new(namespace.map(str::to_string), tool.name.clone()),
+        );
+        catalog.push(
+            json!({"name":tool.name,"description":tool.description,"inputSchema":tool.parameters}),
+        );
+    };
+    for spec in specs {
+        match spec {
+            ToolSpec::Function(tool) => add(tool, None),
+            ToolSpec::Namespace(group) if Some(group.name.as_str()) == namespace => {
+                for tool in &group.tools {
+                    if let ResponsesApiNamespaceTool::Function(tool) = tool {
+                        add(tool, Some(&group.name));
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    (names, catalog)
+}
+
+fn bounded_text(text: &str, limit: usize) -> &str {
+    let mut end = text.len().min(limit);
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    &text[..end]
+}
+
+fn bounded_result(result: Value) -> Value {
+    let text = result.to_string();
+    if text.len() <= MAX_RESULT_BYTES {
+        result
+    } else {
+        // JSON encoding the text a second time can expand each byte up to sixfold.
+        json!({"truncated":true,"text":bounded_text(&text, (MAX_RESULT_BYTES - 256) / 6),
+            "notice":"The full child result remains in native task history."})
+    }
+}
+
+#[cfg(test)]
+#[path = "delegation_tests.rs"]
+mod tests;
