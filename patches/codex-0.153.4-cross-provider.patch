+#[tokio::test]
+async fn shared_delete_threads_keeps_one_home_batch_together() {
+    let temp = TempDir::new().unwrap();
+    let home = temp.path().join("record-home");
+    let parent_id = ThreadId::new();
+    let child_id = ThreadId::new();
+    let parent = super::super::tests::fixture(&home, &parent_id.to_string(), "parent", "legacy");
+    let child = super::super::tests::fixture(&home, &child_id.to_string(), "child", "legacy");
+    let child_contents = std::fs::read_to_string(&child).unwrap();
+    let (meta_line, rest) = child_contents.split_once('\n').unwrap();
+    let mut meta: serde_json::Value = serde_json::from_str(meta_line).unwrap();
+    meta["payload"]["history_base"] = serde_json::to_value(HistoryPosition {
+        thread_id: parent_id,
+        end_ordinal_exclusive: 1,
+        end_byte_offset: std::fs::metadata(&parent).unwrap().len(),
+    })
+    .unwrap();
+    std::fs::write(&child, format!("{meta}\n{rest}")).unwrap();
+    let store = SharedStore {
+        fallback: Arc::new(codex_thread_store::InMemoryThreadStore::default()),
+        path: PathBuf::new(),
+        canonical_home: Some(home.clone()),
+        new_thread_home: None,
+        default_store: OnceCell::new(),
+        routes: Mutex::new(HashMap::new()),
+        homes: Mutex::new(HashMap::new()),
+    };
+
+    // Deleting the parent alone would be refused; one batch sees the child's reference as internal.
+    store
+        .delete_threads(DeleteThreadsParams {
+            thread_ids: vec![parent_id, child_id],
+        })
+        .await
+        .unwrap();
+
+    assert!(!parent.exists());
+    assert!(!child.exists());
+}
