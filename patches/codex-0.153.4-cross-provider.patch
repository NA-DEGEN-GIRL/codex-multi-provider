+#[tokio::test]
+async fn shared_history_refresh_waits_for_a_working_subagent_then_keeps_its_result() -> Result<()> {
+    let fixture = SharedTaskFixture::new(create_escalated_command_execution_sse_response(
+        vec!["echo".to_string(), "shared-refresh".to_string()],
+        /*workdir*/ None,
+        Some(5000),
+        CHILD_CALL_ID,
+    )?)
+    .await?;
+    let (mut owner, root_id) = fixture.start_owner_with_worker().await?;
+    // The worker stays inside its turn until this approval is answered.
+    let approval = timeout(READ_TIMEOUT, owner.read_stream_until_request_message()).await??;
+    let ServerRequest::CommandExecutionRequestApproval { request_id, params } = approval else {
+        anyhow::bail!("expected the worker's command approval request, got {approval:?}");
+    };
+    let worker_id = params.thread_id;
+    assert_ne!(worker_id, root_id);
+    fixture.append_turn_from_other_app(&root_id).await?;
+
+    let rejected_request = owner
+        .send_turn_start_request(text_turn(&root_id, RESUMED_PROMPT))
+        .await?;
+    let rejected = timeout(
+        READ_TIMEOUT,
+        owner.read_stream_until_error_message(RequestId::Integer(rejected_request)),
+    )
+    .await??;
+    assert_eq!(rejected.error.code, -32600);
+    assert!(
+        rejected.error.message.contains("still working")
+            && rejected.error.message.contains("send it again"),
+        "{}",
+        rejected.error.message
+    );
+    // Nothing was stopped, closed or sent to the model.
+    let mut both = vec![root_id.clone(), worker_id.clone()];
+    both.sort();
+    assert_eq!(loaded_ids(&mut owner).await?, both);
+    assert_eq!(
+        fixture.request_bodies_containing(RESUMED_PROMPT).await?,
+        Vec::<String>::new()
+    );
+
+    owner
+        .send_response(
+            request_id,
+            serde_json::to_value(CommandExecutionRequestApprovalResponse {
+                decision: CommandExecutionApprovalDecision::Decline,
+            })?,
+        )
+        .await?;
+    wait_for_turn_completed(&mut owner, &worker_id).await?;
+    // The worker forwards its completion notice right after its turn/completed
+    // event. The root is idle, so that notice waits for the next message and
+    // must move to the reloaded root.
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    assert_refreshed_without_worker(&fixture, &mut owner, &root_id, &worker_id).await
+}
