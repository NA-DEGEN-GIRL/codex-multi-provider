+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+use codex_protocol::ThreadId;
+use tokio::sync::OwnedRwLockReadGuard;
+use tokio::sync::RwLock;
+
+use super::LocalThreadStore;
+use super::live_writer;
+use crate::ReadThreadParams;
+use crate::ResumeThreadParams;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+use crate::UpdateThreadMetadataParams;
+use crate::managed_authority::ManagedAuthority;
+
+/// A write lease for a managed source record, including direct metadata database writes.
+///
+/// Keep this value alive until the write completes. Successful shutdown waits for every
+/// outstanding lease and permanently rejects new leases from all clones of this store.
+pub struct ManagedWritePermit {
+    _lease: Option<OwnedRwLockReadGuard<bool>>,
+    _authority_lease: Option<std::fs::File>,
+}
+
+impl ManagedWritePermit {
+    /// Keep the durable authority fence without retaining a local read permit across
+    /// other public operations, which would deadlock behind a queued close operation.
+    pub(super) fn into_authority_lease(mut self) -> Option<std::fs::File> {
+        self._authority_lease.take()
+    }
+}
+
+pub(super) struct ManagedThreadScope {
+    thread_id: ThreadId,
+    revoked: Arc<RwLock<bool>>,
+    released: AtomicBool,
+    authority: Option<ManagedAuthority>,
+}
+
+pub(super) enum ManagedClose {
+    Shutdown,
+    Discard,
+}
+
+impl LocalThreadStore {
+    pub(super) async fn validated_managed_resume(
+        &self,
+        params: &ResumeThreadParams,
+    ) -> ThreadStoreResult<Option<PathBuf>> {
+        if self.managed_scope.is_none() {
+            return Ok(None);
+        }
+        let stored = super::read_thread::read_thread(
+            self,
+            ReadThreadParams {
+                thread_id: params.thread_id,
+                include_archived: params.include_archived,
+                include_history: false,
+            },
+        )
+        .await?;
+        if stored.thread_id != params.thread_id {
+            return Err(invalid_path(
+                "managed source metadata belongs to another thread",
+            ));
+        }
+        let path = stored
+            .rollout_path
+            .ok_or_else(|| invalid_path("managed source has no canonical rollout"))?;
+        let existing = codex_rollout::existing_rollout_path(&path)
+            .await
+            .ok_or_else(|| invalid_path("managed canonical rollout is missing"))?;
+        let canonical = self
+            .validate_managed_rollout_path(params.thread_id, &existing)
+            .await?;
+        if let Some(requested) = &params.rollout_path {
+            let requested = self
+                .validate_managed_rollout_path(params.thread_id, requested)
+                .await?;
+            if requested != canonical {
+                return Err(invalid_path(
+                    "rollout override differs from managed canonical record",
+                ));
+            }
+        }
+        Ok(Some(canonical))
+    }
+
+    pub(super) async fn validate_managed_metadata_paths(
+        &self,
+        params: &UpdateThreadMetadataParams,
+    ) -> ThreadStoreResult<()> {
+        if self.managed_scope.is_none() {
+            return Ok(());
+        }
+        if let Some(path) = &params.patch.rollout_path {
+            self.validate_managed_rollout_path(params.thread_id, path)
+                .await?;
+        }
+        let current = match self.live_rollout_path(params.thread_id).await {
+            Ok(path) => Some(path),
+            Err(ThreadStoreError::ThreadNotFound { .. }) => match self.state_db().await {
+                Some(state) => state
+                    .get_thread(params.thread_id)
+                    .await
+                    .map_err(|error| {
+                        invalid_path(format!("managed source lookup failed: {error}"))
+                    })?
+                    .map(|metadata| metadata.rollout_path),
+                None => None,
+            },
+            Err(error) => return Err(error),
+        };
+        if let Some(path) = current {
+            self.validate_managed_rollout_path(params.thread_id, &path)
+                .await?;
+        }
+        Ok(())
+    }
+
+    async fn validate_managed_rollout_path(
+        &self,
+        thread_id: ThreadId,
+        path: &Path,
+    ) -> ThreadStoreResult<PathBuf> {
+        let existing = codex_rollout::existing_rollout_path(path).await;
+        let path = existing.as_deref().unwrap_or(path);
+        if !path.is_absolute() || path.components().any(|part| part == Component::ParentDir) {
+            return Err(invalid_path(
+                "managed rollout path must be absolute without parent traversal",
+            ));
+        }
+        let root = std::fs::canonicalize(&self.config.codex_home)
+            .map_err(|error| invalid_path(format!("managed source is unavailable: {error}")))?;
+        // Lazy writers have not created their day directory/file yet. Resolve every existing
+        // ancestor before appending missing components, so junctions cannot escape the source.
+        let mut ancestor = path.to_path_buf();
+        let mut suffix = Vec::new();
+        let mut canonical = loop {
+            match std::fs::canonicalize(&ancestor) {
+                Ok(canonical) => break canonical,
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                    suffix.push(
+                        ancestor
+                            .file_name()
+                            .ok_or_else(|| {
+                                invalid_path("managed rollout has no existing ancestor")
+                            })?
+                            .to_os_string(),
+                    );
+                    ancestor.pop();
+                }
+                Err(error) => {
+                    return Err(invalid_path(format!(
+                        "managed rollout is unavailable: {error}"
+                    )));
+                }
+            }
+        };
+        for component in suffix.into_iter().rev() {
+            canonical.push(component);
+        }
+        if ![
+            codex_rollout::SESSIONS_SUBDIR,
+            codex_rollout::ARCHIVED_SESSIONS_SUBDIR,
+        ]
+        .iter()
+        .any(|directory| canonical.starts_with(root.join(directory)))
+        {
+            return Err(invalid_path(
+                "managed rollout is outside its canonical source sessions",
+            ));
+        }
+        if existing.is_some() {
+            let metadata = codex_rollout::read_session_meta_line(&canonical)
+                .await
+                .map_err(|error| {
+                    invalid_path(format!("managed rollout metadata is invalid: {error}"))
+                })?;
+            if metadata.meta.id != thread_id {
+                return Err(invalid_path(
+                    "managed rollout metadata belongs to another thread",
+                ));
+            }
+        }
+        Ok(canonical)
+    }
+
+    pub(crate) fn is_managed_thread_scope(&self) -> bool {
+        self.managed_scope.is_some()
+    }
+
+    /// In-crate scope tests exercise recorder release independently from durable ownership.
+    #[cfg(test)]
+    pub(crate) fn with_managed_thread_scope(mut self, thread_id: ThreadId) -> Self {
+        self.managed_scope = Some(Arc::new(ManagedThreadScope {
+            thread_id,
+            revoked: Arc::new(RwLock::new(false)),
+            released: AtomicBool::new(false),
+            authority: None,
+        }));
+        self
+    }
+
+    /// Every production managed store is pinned to one immutable durable owner grant.
+    pub(crate) fn with_managed_thread_authority(
+        mut self,
+        thread_id: ThreadId,
+        authority: ManagedAuthority,
+    ) -> Self {
+        self.managed_scope = Some(Arc::new(ManagedThreadScope {
+            thread_id,
+            revoked: Arc::new(RwLock::new(false)),
+            released: AtomicBool::new(false),
+            authority: Some(authority),
+        }));
+        self
+    }
+
+    pub(crate) fn managed_scope_released(&self) -> bool {
+        self.managed_scope
+            .as_ref()
+            .is_some_and(|scope| scope.released.load(Ordering::Acquire))
+    }
+
+    pub(crate) async fn verify_managed_writer_absent(
+        &self,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<()> {
+        let _permit = self.managed_write_permit(thread_id).await?;
+        let _writer_lock = self.writer_lock_coordinator.acquire(thread_id)?;
+        Ok(())
+    }
+
+    /// Reserve a write before touching a managed record's store or metadata database.
+    ///
+    /// An ordinary local store returns an unrestricted permit. This method must not be
+    /// nested with another permit while shutdown is waiting for exclusive access.
+    pub async fn managed_write_permit(
+        &self,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<ManagedWritePermit> {
+        self.managed_write_permit_for(&[thread_id]).await
+    }
+
+    pub(super) async fn managed_write_permit_for(
+        &self,
+        thread_ids: &[ThreadId],
+    ) -> ThreadStoreResult<ManagedWritePermit> {
+        let Some(scope) = &self.managed_scope else {
+            return Ok(ManagedWritePermit {
+                _lease: None,
+                _authority_lease: None,
+            });
+        };
+        let lease = Arc::clone(&scope.revoked).read_owned().await;
+        if *lease || thread_ids.iter().any(|id| *id != scope.thread_id) {
+            return Err(ThreadStoreError::Conflict {
+                message: "managed source record write authority is absent or revoked".to_string(),
+            });
+        }
+        let authority_lease = scope
+            .authority
+            .as_ref()
+            .map(ManagedAuthority::write_guard)
+            .transpose()?;
+        Ok(ManagedWritePermit {
+            _lease: Some(lease),
+            _authority_lease: authority_lease,
+        })
+    }
+
+    pub(super) fn reject_managed_global_write(
+        &self,
+        operation: &'static str,
+    ) -> ThreadStoreResult<()> {
+        if self.managed_scope.is_some() {
+            return Err(ThreadStoreError::Unsupported { operation });
+        }
+        Ok(())
+    }
+
+    pub(super) async fn close_managed_thread(
+        &self,
+        thread_id: ThreadId,
+        operation: ManagedClose,
+    ) -> ThreadStoreResult<()> {
+        let Some(scope) = &self.managed_scope else {
+            return match operation {
+                ManagedClose::Shutdown => live_writer::shutdown_thread(self, thread_id).await,
+                ManagedClose::Discard => live_writer::discard_thread(self, thread_id).await,
+            };
+        };
+        if thread_id != scope.thread_id {
+            return Err(ThreadStoreError::Conflict {
+                message: "managed source record does not own the requested thread".to_string(),
+            });
+        }
+        let scope = Arc::clone(scope);
+        let store = self.clone();
+        // Cancellation must not release the fence while close still drains the recorder.
+        tokio::spawn(async move {
+            let mut revoked = Arc::clone(&scope.revoked).write_owned().await;
+            if *revoked {
+                return Err(ThreadStoreError::Conflict {
+                    message: "managed source record write authority has been revoked".to_string(),
+                });
+            }
+            let _authority_lease = scope
+                .authority
+                .as_ref()
+                .map(ManagedAuthority::write_guard)
+                .transpose()?;
+            let result = match operation {
+                ManagedClose::Shutdown => live_writer::shutdown_thread(&store, thread_id).await,
+                ManagedClose::Discard => live_writer::discard_thread(&store, thread_id).await,
+            };
+            if result.is_ok() {
+                *revoked = true;
+                scope.released.store(true, Ordering::Release);
+            }
+            result
+        })
+        .await
+        .map_err(|error| ThreadStoreError::Internal {
+            message: format!("managed source record close failed: {error}"),
+        })?
+    }
+}
+
+fn invalid_path(message: impl Into<String>) -> ThreadStoreError {
+    ThreadStoreError::InvalidRequest {
+        message: message.into(),
+    }
+}
+
