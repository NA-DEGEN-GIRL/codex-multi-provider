diff --git a/codex-rs/thread-store/src/local/read_only.rs b/codex-rs/thread-store/src/local/read_only.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9b800e24e02659e4719d419a7fe7b22e7eba58f4
--- /dev/null
+++ b/codex-rs/thread-store/src/local/read_only.rs
@@ -0,0 +1,635 @@
+//! Read-only federation over an explicitly selected source home.
+//!
+//! This type deliberately does not implement `ThreadStore`: a catalog reader cannot create a
+//! recorder, acquire write authority, migrate a source database, or repair its history index.
+//! An explicit opt-in can reconstruct a separate private, temporary history projection.
+//! SQLite may create empty WAL/shared-memory bookkeeping for a closed WAL database. We keep normal
+//! `mode=ro` semantics to see live commits; immutable mode would hide them. No sidecars are deleted.
+
+mod derived_history;
+mod list;
+mod roots;
+
+use std::collections::HashSet;
+use std::io::BufRead;
+use std::io::Read;
+use std::io::Seek;
+use std::io::SeekFrom;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+pub use derived_history::PrivateHistoryProjection;
+
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_state::ReadOnlyThreadState;
+use codex_state::SqliteConfig;
+use codex_state::ThreadMetadata;
+use serde::Deserialize;
+use serde::Serialize;
+use tokio::sync::OnceCell;
+
+use super::read_thread::stored_thread_from_state_metadata_with_provider;
+use super::rollout_lineage::RolloutLineage;
+use super::rollout_lineage::RolloutLineageSegment;
+use super::thread_history;
+use crate::ItemPage;
+use crate::ListItemsParams;
+use crate::ListTimelineParams;
+use crate::ListTurnsParams;
+use crate::LoadThreadHistoryParams;
+use crate::ReadThreadParams;
+use crate::SearchThreadOccurrencesParams;
+use crate::StoredModelContext;
+use crate::StoredThread;
+use crate::StoredThreadHistory;
+use crate::ThreadOccurrenceSearchPage;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+use crate::TimelinePage;
+use crate::TurnPage;
+
+pub struct ReadOnlyLocalThreadStore {
+    codex_home: PathBuf,
+    sqlite: SqliteConfig,
+    state: ReadOnlyThreadState,
+    history: OnceCell<sqlx::SqlitePool>,
+    rollout_homes: Vec<PathBuf>,
+    derived_history: Option<Arc<PrivateHistoryProjection>>,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct ReadOnlyCursor {
+    readonly_rollout_id: ThreadId,
+    cursor: String,
+}
+
+fn incomplete(error: impl std::fmt::Display) -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: format!("source history index unavailable or incomplete: {error}"),
+    }
+}
+
+fn invalid(message: impl Into<String>) -> ThreadStoreError {
+    ThreadStoreError::InvalidRequest {
+        message: message.into(),
+    }
+}
+
+impl ReadOnlyLocalThreadStore {
+    /// Opens existing databases only. Authorization of the source identity is owned by the caller;
+    /// this boundary additionally confines every database and rollout to that registered home.
+    pub async fn open(codex_home: PathBuf, sqlite: SqliteConfig) -> ThreadStoreResult<Self> {
+        Self::open_with_registered_rollout_homes(codex_home, sqlite, Vec::new()).await
+    }
+
+    pub async fn close(&self) {
+        self.state.close().await;
+        if let Some(pool) = self.history.get() {
+            pool.close().await;
+        }
+        if let Some(cache) = &self.derived_history
+            && Arc::strong_count(cache) == 1
+        {
+            cache.close().await;
+        }
+    }
+
+    pub async fn list_metadata(&self) -> ThreadStoreResult<Vec<ThreadMetadata>> {
+        self.validate_root()?;
+        self.state.list_threads().await.map_err(incomplete)
+    }
+
+    /// Page over every canonical metadata row, independently of sidebar visibility.
+    pub async fn list_metadata_page(
+        &self,
+        after_id: Option<ThreadId>,
+        page_size: usize,
+    ) -> ThreadStoreResult<Vec<ThreadMetadata>> {
+        self.validate_root()?;
+        self.state
+            .list_metadata_page(after_id, page_size)
+            .await
+            .map_err(incomplete)
+    }
+
+    pub async fn read_metadata(
+        &self,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<Option<ThreadMetadata>> {
+        self.validate_root()?;
+        self.state.get_thread(thread_id).await.map_err(incomplete)
+    }
+
+    pub async fn thread_memory_mode(&self, thread_id: ThreadId) -> ThreadStoreResult<String> {
+        self.validate_root()?;
+        self.state
+            .thread_memory_mode(thread_id)
+            .await
+            .map_err(incomplete)
+    }
+
+    pub async fn list_thread_spawn_descendants(
+        &self,
+        root_thread_id: ThreadId,
+        limit: usize,
+    ) -> ThreadStoreResult<Vec<ThreadId>> {
+        self.validate_root()?;
+        self.state
+            .list_thread_spawn_descendants(root_thread_id, limit)
+            .await
+            .map_err(incomplete)
+    }
+
+    /// Stage source context without opening a recorder or initializing writable state. The caller
+    /// must still acquire source write authority and revalidate before activating a resumed actor.
+    pub async fn load_latest_model_context(
+        &self,
+        params: LoadThreadHistoryParams,
+    ) -> ThreadStoreResult<StoredModelContext> {
+        let metadata = self
+            .metadata(params.thread_id, params.include_archived)
+            .await?;
+        let (metadata, lineage) = match metadata.history_mode {
+            ThreadHistoryMode::Paginated => {
+                let (metadata, lineage) = self
+                    .prepare_history(params.thread_id, params.include_archived)
+                    .await?;
+                (metadata, Some(lineage))
+            }
+            ThreadHistoryMode::Legacy => (metadata, None),
+        };
+        let path = self.rollout_path(&metadata.rollout_path).await?;
+        let session_meta = codex_rollout::read_session_meta_line(&path)
+            .await
+            .map_err(incomplete)?;
+        if session_meta.meta.id != params.thread_id
+            || session_meta.meta.history_mode != metadata.history_mode
+        {
+            return Err(incomplete(
+                "selected rollout metadata does not match its canonical state row",
+            ));
+        }
+        let items = match lineage {
+            Some(lineage) => {
+                super::model_context::scan_model_context_from_lineage(lineage, session_meta).await?
+            }
+            None => super::read_thread::load_history_items(&path).await?,
+        };
+        self.validate_current(&metadata).await?;
+        Ok(StoredModelContext {
+            thread_id: params.thread_id,
+            items,
+        })
+    }
+
+    pub async fn read_thread(&self, params: ReadThreadParams) -> ThreadStoreResult<StoredThread> {
+        let metadata = self
+            .metadata(params.thread_id, params.include_archived)
+            .await?;
+        if params.include_history && metadata.history_mode == ThreadHistoryMode::Paginated {
+            return Err(ThreadStoreError::Unsupported {
+                operation: "read paginated history; use turns/items/timeline",
+            });
+        }
+        let path = self.rollout_path(&metadata.rollout_path).await?;
+        let meta = codex_rollout::read_session_meta_line(&path)
+            .await
+            .map_err(incomplete)?
+            .meta;
+        if meta.id != params.thread_id || meta.history_mode != metadata.history_mode {
+            return Err(incomplete(
+                "selected rollout metadata does not match its canonical state row",
+            ));
+        }
+        let mut thread = stored_thread_from_state_metadata_with_provider(
+            meta.model_provider
+                .as_deref()
+                .filter(|provider| !provider.is_empty())
+                .unwrap_or("openai"),
+            metadata.clone(),
+            meta.parent_thread_id
+                .or_else(|| meta.source.parent_thread_id()),
+        );
+        thread.rollout_path = Some(path.clone());
+        thread.forked_from_id = meta.forked_from_id;
+        if params.include_history {
+            thread.history = Some(StoredThreadHistory {
+                thread_id: params.thread_id,
+                items: super::read_thread::load_history_items(&path).await?,
+            });
+        }
+        if thread.history_mode == ThreadHistoryMode::Legacy && thread.name.is_none() {
+            thread.name =
+                codex_rollout::find_thread_name_by_id(&self.codex_home, &params.thread_id)
+                    .await
+                    .map_err(incomplete)?
+                    .filter(|name| !name.trim().is_empty());
+        }
+        self.validate_current(&metadata).await?;
+        Ok(thread)
+    }
+
+    pub async fn list_turns(&self, mut params: ListTurnsParams) -> ThreadStoreResult<TurnPage> {
+        let (metadata, lineage) = self
+            .prepare_history(params.thread_id, params.include_archived)
+            .await?;
+        let rollout_id = selected_rollout_id(&lineage)?;
+        params.cursor = decode_cursor(params.cursor, rollout_id)?;
+        let mut page =
+            thread_history::list_turns_in_lineage(self.history_pool().await?, &lineage, params)
+                .await?;
+        self.validate_current(&metadata).await?;
+        page.next_cursor = encode_cursor(page.next_cursor, rollout_id)?;
+        page.backwards_cursor = encode_cursor(page.backwards_cursor, rollout_id)?;
+        Ok(page)
+    }
+
+    pub async fn list_items(&self, mut params: ListItemsParams) -> ThreadStoreResult<ItemPage> {
+        let (metadata, lineage) = self
+            .prepare_history(params.thread_id, params.include_archived)
+            .await?;
+        let rollout_id = selected_rollout_id(&lineage)?;
+        params.cursor = decode_cursor(params.cursor, rollout_id)?;
+        let mut page =
+            thread_history::list_items_in_lineage(self.history_pool().await?, &lineage, params)
+                .await?;
+        self.validate_current(&metadata).await?;
+        page.next_cursor = encode_cursor(page.next_cursor, rollout_id)?;
+        page.backwards_cursor = encode_cursor(page.backwards_cursor, rollout_id)?;
+        Ok(page)
+    }
+
+    pub async fn list_timeline(
+        &self,
+        mut params: ListTimelineParams,
+    ) -> ThreadStoreResult<TimelinePage> {
+        let (metadata, lineage) = self.prepare_history(params.thread_id, true).await?;
+        let rollout_id = selected_rollout_id(&lineage)?;
+        params.cursor = decode_cursor(params.cursor, rollout_id)?;
+        let mut page =
+            thread_history::list_timeline_in_lineage(self.history_pool().await?, &lineage, params)
+                .await?;
+        self.validate_current(&metadata).await?;
+        page.next_cursor = encode_cursor(page.next_cursor, rollout_id)?;
+        Ok(page)
+    }
+
+    pub async fn search_thread_occurrences(
+        &self,
+        mut params: SearchThreadOccurrencesParams,
+    ) -> ThreadStoreResult<ThreadOccurrenceSearchPage> {
+        let (metadata, lineage) = self.prepare_history(params.thread_id, true).await?;
+        let rollout_id = selected_rollout_id(&lineage)?;
+        params.cursor = decode_cursor(params.cursor, rollout_id)?;
+        let mut page = thread_history::search_thread_occurrences_in_lineage(
+            self.history_pool().await?,
+            &lineage,
+            params,
+        )
+        .await?;
+        self.validate_current(&metadata).await?;
+        page.next_cursor = encode_cursor(page.next_cursor, rollout_id)?;
+        for item in &mut page.items {
+            item.turn_cursor =
+                encode_cursor(Some(std::mem::take(&mut item.turn_cursor)), rollout_id)?
+                    .unwrap_or_default();
+        }
+        Ok(page)
+    }
+
+    fn validate_root(&self) -> ThreadStoreResult<()> {
+        if std::fs::canonicalize(&self.codex_home).map_err(incomplete)? != self.codex_home
+            || std::fs::canonicalize(self.sqlite.home()).map_err(incomplete)? != self.codex_home
+        {
+            return Err(invalid("registered source home changed"));
+        }
+        for home in &self.rollout_homes {
+            if std::fs::canonicalize(home).map_err(incomplete)? != *home {
+                return Err(invalid("registered rollout home changed"));
+            }
+        }
+        validate_database_path(&self.codex_home, &self.sqlite.state_db_path())
+    }
+
+    async fn metadata(
+        &self,
+        thread_id: ThreadId,
+        include_archived: bool,
+    ) -> ThreadStoreResult<ThreadMetadata> {
+        let metadata = self
+            .read_metadata(thread_id)
+            .await?
+            .ok_or(ThreadStoreError::ThreadNotFound { thread_id })?;
+        if !include_archived && metadata.archived_at.is_some() {
+            return Err(invalid(format!("thread {thread_id} is archived")));
+        }
+        Ok(metadata)
+    }
+
+    async fn validate_current(&self, original: &ThreadMetadata) -> ThreadStoreResult<()> {
+        let current = self.metadata(original.id, true).await?;
+        if current.rollout_path != original.rollout_path
+            || current.history_mode != original.history_mode
+            || current.archived_at != original.archived_at
+        {
+            return Err(invalid(
+                "source thread changed while reading; reload the conversation",
+            ));
+        }
+        Ok(())
+    }
+
+    async fn rollout_path(&self, path: &Path) -> ThreadStoreResult<PathBuf> {
+        let path = if path.is_absolute() {
+            path.to_path_buf()
+        } else {
+            self.codex_home.join(path)
+        };
+        let path = codex_rollout::existing_rollout_path(&path)
+            .await
+            .ok_or_else(|| {
+                incomplete(
+                    "authoritative source rollout is missing; refusing an older rollout fallback",
+                )
+            })?;
+        let path = std::fs::canonicalize(path).map_err(incomplete)?;
+        let allowed = self.rollout_homes.iter().any(|home| {
+            [
+                codex_rollout::SESSIONS_SUBDIR,
+                codex_rollout::ARCHIVED_SESSIONS_SUBDIR,
+            ]
+            .iter()
+            .any(|name| path.starts_with(home.join(name)))
+        });
+        if !allowed || !path.is_file() {
+            return Err(invalid(
+                "source rollout is outside registered session roots",
+            ));
+        }
+        Ok(path)
+    }
+
+    async fn history_pool(&self) -> ThreadStoreResult<&sqlx::SqlitePool> {
+        self.validate_root()?;
+        if let Some(cache) = &self.derived_history {
+            return cache.pool().await;
+        }
+        validate_database_path(&self.codex_home, &self.sqlite.thread_history_db_path())?;
+        self.history
+            .get_or_try_init(|| async {
+                self.sqlite
+                    .open_read_only_pool(&self.sqlite.thread_history_db_path(), None)
+                    .await
+                    .map_err(incomplete)
+            })
+            .await
+    }
+
+    async fn prepare_history(
+        &self,
+        thread_id: ThreadId,
+        include_archived: bool,
+    ) -> ThreadStoreResult<(ThreadMetadata, RolloutLineage)> {
+        let metadata = self.metadata(thread_id, include_archived).await?;
+        if metadata.history_mode != ThreadHistoryMode::Paginated {
+            return Err(ThreadStoreError::Unsupported {
+                operation: "paginated source history",
+            });
+        }
+        let mut path = self.rollout_path(&metadata.rollout_path).await?;
+        let mut end = None;
+        let mut seen = HashSet::new();
+        let mut segments = Vec::new();
+        loop {
+            let meta = codex_rollout::read_session_meta_line(&path)
+                .await
+                .map_err(incomplete)?
+                .meta;
+            if segments.is_empty() && meta.id != thread_id {
+                return Err(incomplete(
+                    "current rollout belongs to another canonical thread",
+                ));
+            }
+            if meta.history_mode != ThreadHistoryMode::Paginated {
+                return Err(incomplete(
+                    "source lineage contains a non-paginated rollout",
+                ));
+            }
+            let rollout_id = codex_rollout::rollout_id_from_path(&path)
+                .ok_or_else(|| incomplete("source rollout has no immutable rollout ID"))?;
+            if !seen.insert(rollout_id) {
+                return Err(incomplete("source rollout lineage contains a cycle"));
+            }
+            let start_ordinal = meta.history_base.map_or(Ok(1), |base| {
+                base.end_ordinal_exclusive
+                    .checked_add(1)
+                    .ok_or_else(|| incomplete("source rollout ordinal overflow"))
+            })?;
+            segments.push(RolloutLineageSegment {
+                rollout_id,
+                rollout_path: path,
+                start_ordinal,
+                end,
+            });
+            let Some(base) = meta.history_base else {
+                break;
+            };
+            let ancestor = self.registered_ancestor(base.thread_id).await?;
+            path = self.rollout_path(&ancestor).await?;
+            if codex_rollout::rollout_id_from_path(&path) != Some(base.thread_id) {
+                return Err(incomplete(
+                    "source lineage ancestor has a different immutable rollout ID",
+                ));
+            }
+            end = Some(base);
+        }
+        segments.reverse();
+        let lineage = RolloutLineage { segments };
+        if let Some(cache) = &self.derived_history {
+            cache.materialize(&lineage).await?;
+        }
+        let pool = self.history_pool().await?;
+        for segment in lineage.segments() {
+            let checkpoint = sqlx::query_as::<_, (i64, i64)>(
+                "SELECT next_rollout_byte_offset, next_rollout_ordinal FROM thread_history_projection_state WHERE thread_id = ?")
+                .bind(segment.rollout_id.to_string()).fetch_optional(pool).await.map_err(incomplete)?;
+            let Some(checkpoint) = checkpoint else {
+                // Older writers publish a metadata-only replacement before its first append.
+                // Verify the actual bytes instead of treating every missing checkpoint as empty.
+                let path = segment.rollout_path.clone();
+                let end = segment.end;
+                let only_metadata =
+                    tokio::task::spawn_blocking(move || -> std::io::Result<bool> {
+                        if let Some(end) = end
+                            && (end.end_ordinal_exclusive == 0
+                                || !codex_rollout::rollout_contains_prefix(
+                                    &path,
+                                    end.end_byte_offset,
+                                )?)
+                        {
+                            return Ok(false);
+                        }
+                        metadata_only_rollout(&path)
+                    })
+                    .await
+                    .map_err(incomplete)?
+                    .map_err(incomplete)?;
+                if !only_metadata {
+                    return Err(incomplete(format!(
+                        "rollout {} has no projection checkpoint",
+                        segment.rollout_id
+                    )));
+                }
+                let rows: i64 = sqlx::query_scalar(
+                    "SELECT EXISTS(SELECT 1 FROM thread_turns WHERE thread_id = ?1 UNION ALL SELECT 1 FROM thread_items WHERE thread_id = ?1 UNION ALL SELECT 1 FROM thread_realtime_items WHERE thread_id = ?1)")
+                    .bind(segment.rollout_id.to_string()).fetch_one(pool).await.map_err(incomplete)?;
+                if rows != 0 {
+                    return Err(incomplete(
+                        "unprojected metadata-only rollout has unexpected history rows",
+                    ));
+                }
+                if segment
+                    .end
+                    .is_some_and(|end| end.end_ordinal_exclusive >= segment.start_ordinal)
+                {
+                    return Err(incomplete(
+                        "metadata-only source segment has an invalid history cutoff",
+                    ));
+                }
+                continue;
+            };
+            let offset = u64::try_from(checkpoint.0).map_err(incomplete)?;
+            let ordinal = u64::try_from(checkpoint.1).map_err(incomplete)?;
+            let path = segment.rollout_path.clone();
+            let end = segment.end;
+            let required = tokio::task::spawn_blocking(move || -> std::io::Result<u64> {
+                if let Some(end) = end {
+                    if end.end_ordinal_exclusive == 0
+                        || !codex_rollout::rollout_contains_prefix(&path, end.end_byte_offset)?
+                    {
+                        return Err(std::io::Error::other("source lineage cutoff is invalid"));
+                    }
+                    Ok(end.end_byte_offset)
+                } else {
+                    complete_rollout_prefix(&path)
+                }
+            })
+            .await
+            .map_err(incomplete)?
+            .map_err(incomplete)?;
+            if offset < required
+                || (end.is_none() && offset > required)
+                || end.is_some_and(|end| ordinal < end.end_ordinal_exclusive)
+            {
+                return Err(incomplete(format!(
+                    "rollout {} projection does not match durable history",
+                    segment.rollout_id
+                )));
+            }
+        }
+        self.validate_current(&metadata).await?;
+        Ok((metadata, lineage))
+    }
+}
+
+fn validate_database_path(root: &Path, path: &Path) -> ThreadStoreResult<()> {
+    let canonical = std::fs::canonicalize(path).map_err(incomplete)?;
+    if canonical.parent() != Some(root) || !canonical.is_file() {
+        return Err(invalid(
+            "source database is outside the registered source home",
+        ));
+    }
+    Ok(())
+}
+
+fn selected_rollout_id(lineage: &RolloutLineage) -> ThreadStoreResult<ThreadId> {
+    lineage
+        .segments()
+        .last()
+        .map(|segment| segment.rollout_id)
+        .ok_or_else(|| incomplete("empty source lineage"))
+}
+
+fn encode_cursor(
+    cursor: Option<String>,
+    rollout_id: ThreadId,
+) -> ThreadStoreResult<Option<String>> {
+    cursor
+        .map(|cursor| {
+            serde_json::to_string(&ReadOnlyCursor {
+                readonly_rollout_id: rollout_id,
+                cursor,
+            })
+            .map_err(incomplete)
+        })
+        .transpose()
+}
+
+fn decode_cursor(
+    cursor: Option<String>,
+    rollout_id: ThreadId,
+) -> ThreadStoreResult<Option<String>> {
+    cursor
+        .map(|cursor| {
+            let cursor: ReadOnlyCursor = serde_json::from_str(&cursor)
+                .map_err(|_| invalid("invalid source history cursor"))?;
+            if cursor.readonly_rollout_id != rollout_id {
+                return Err(invalid(
+                    "source history changed since this cursor; reload the conversation",
+                ));
+            }
+            Ok(cursor.cursor)
+        })
+        .transpose()
+}
+
+/// Locate the durable newline-terminated prefix without scanning a large plain rollout from start.
+/// Compressed history uses the existing anonymous decoded reader and never publishes a source copy.
+fn complete_rollout_prefix(path: &Path) -> std::io::Result<u64> {
+    let mut file = codex_rollout::open_rollout_seekable_reader(path)?;
+    let mut end = file.metadata()?.len();
+    let mut buffer = [0; 8192];
+    while end > 0 {
+        let start = end.saturating_sub(buffer.len() as u64);
+        let count = usize::try_from(end - start).map_err(std::io::Error::other)?;
+        file.seek(SeekFrom::Start(start))?;
+        file.read_exact(&mut buffer[..count])?;
+        if let Some(index) = buffer[..count].iter().rposition(|byte| *byte == b'\n') {
+            return Ok(start + index as u64 + 1);
+        }
+        end = start;
+    }
+    Ok(0)
+}
+
+fn metadata_only_rollout(path: &Path) -> std::io::Result<bool> {
+    let file = codex_rollout::open_rollout_seekable_reader(path)?;
+    let mut reader = std::io::BufReader::new(file);
+    let mut line = String::new();
+    if reader.read_line(&mut line)? == 0 || !line.ends_with('\n') {
+        return Ok(false);
+    }
+    let line: codex_rollout::RolloutLine = match serde_json::from_str(&line) {
+        Ok(line) => line,
+        Err(_) => return Ok(false),
+    };
+    if !matches!(line.item, codex_rollout::RolloutItem::SessionMeta(_)) {
+        return Ok(false);
+    }
+    let mut bytes = [0; 8192];
+    loop {
+        let count = reader.read(&mut bytes)?;
+        if count == 0 {
+            return Ok(true);
+        }
+        if bytes[..count]
+            .iter()
+            .any(|byte| !byte.is_ascii_whitespace())
+        {
+            return Ok(false);
+        }
+    }
+}
diff --git a/codex-rs/thread-store/src/local/read_only/derived_history.rs b/codex-rs/thread-store/src/local/read_only/derived_history.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e41076d6b213078768c7b9fcb9dcb05771de2d54
--- /dev/null
+++ b/codex-rs/thread-store/src/local/read_only/derived_history.rs
@@ -0,0 +1,83 @@
+//! Optional private projection of durable rollouts, never a source-index repair.
+
+use codex_state::open_temporary_thread_history_db;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use tokio::sync::Mutex;
+use tokio::sync::OnceCell;
+
+use super::super::rollout_lineage::RolloutLineage;
+use super::super::thread_history_materialization::ProjectionEnd;
+use super::super::thread_history_materialization::materialize_to_pool;
+use super::ReadOnlyLocalThreadStore;
+use super::incomplete;
+use super::invalid;
+use crate::ThreadStoreResult;
+
+/// Reusable, source-scoped private history projection. It holds no source database
+/// handles; readers may reopen metadata while retaining the incremental projection.
+#[derive(Default)]
+pub struct PrivateHistoryProjection {
+    pool: OnceCell<sqlx::SqlitePool>,
+    projection: Mutex<()>,
+    scope: OnceLock<(PathBuf, Vec<PathBuf>)>,
+}
+
+impl ReadOnlyLocalThreadStore {
+    /// Reconstruct paginated history in an unnamed, viewer-owned temporary index.
+    /// Metadata and rollouts remain read-only in their registered source homes.
+    /// The ordinary constructor stays strict and never enables this projection.
+    pub fn with_private_history_projection(
+        mut self,
+        projection: Arc<PrivateHistoryProjection>,
+    ) -> ThreadStoreResult<Self> {
+        let scope = (self.codex_home.clone(), self.rollout_homes.clone());
+        if projection.scope.get_or_init(|| scope.clone()) != &scope {
+            return Err(invalid(
+                "private history projection belongs to another source scope",
+            ));
+        }
+        self.derived_history = Some(projection);
+        Ok(self)
+    }
+}
+
+impl PrivateHistoryProjection {
+    pub(super) async fn pool(&self) -> ThreadStoreResult<&sqlx::SqlitePool> {
+        self.pool
+            .get_or_try_init(|| async {
+                open_temporary_thread_history_db().await.map_err(incomplete)
+            })
+            .await
+    }
+
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "serialize private checkpoint advancement without acquiring any source writer lock"
+    )]
+    pub(super) async fn materialize(&self, lineage: &RolloutLineage) -> ThreadStoreResult<()> {
+        // Serialize incremental checkpoint advancement within this private index.
+        // This lock never coordinates, stops or acquires a source writer.
+        let _projection = self.projection.lock().await;
+        let pool = self.pool().await?;
+        for segment in lineage.segments() {
+            materialize_to_pool(
+                pool,
+                segment.rollout_id,
+                &segment.rollout_path,
+                segment
+                    .end
+                    .map_or(ProjectionEnd::Durable, ProjectionEnd::Frozen),
+            )
+            .await?;
+        }
+        Ok(())
+    }
+
+    pub(super) async fn close(&self) {
+        if let Some(pool) = self.pool.get() {
+            pool.close().await;
+        }
+    }
+}
diff --git a/codex-rs/thread-store/src/local/read_only/list.rs b/codex-rs/thread-store/src/local/read_only/list.rs
new file mode 100644
index 0000000000000000000000000000000000000000..440bc055342f50b43d848485c0c76aeeb5e2a41b
--- /dev/null
+++ b/codex-rs/thread-store/src/local/read_only/list.rs
@@ -0,0 +1,191 @@
+//! State-backed catalog pages for an explicitly selected, read-only source home.
+
+use chrono::DateTime;
+use chrono::Utc;
+use codex_protocol::ThreadId;
+use codex_state::Anchor;
+use codex_state::ThreadFilterOptions;
+
+use super::ReadOnlyLocalThreadStore;
+use super::incomplete;
+use super::invalid;
+use super::stored_thread_from_state_metadata_with_provider;
+use crate::ListThreadsParams;
+use crate::SortDirection;
+use crate::StoredThread;
+use crate::ThreadPage;
+use crate::ThreadRelationFilter;
+use crate::ThreadSortKey;
+use crate::ThreadStoreResult;
+
+impl ReadOnlyLocalThreadStore {
+    /// Inventory summaries including archived and empty-preview records, without
+    /// opening rollout files. A summary is not proof that its history is readable;
+    /// callers must use the validated read API when a record is selected.
+    pub async fn list_metadata_summaries_page(
+        &self,
+        after_id: Option<ThreadId>,
+        page_size: usize,
+    ) -> ThreadStoreResult<Vec<StoredThread>> {
+        let metadata = self.list_metadata_page(after_id, page_size).await?;
+        Ok(metadata
+            .into_iter()
+            .map(|metadata| {
+                let parent = serde_json::from_str::<codex_protocol::protocol::SessionSource>(
+                    &metadata.source,
+                )
+                .ok()
+                .and_then(|source| source.parent_thread_id());
+                stored_thread_from_state_metadata_with_provider("openai", metadata, parent)
+            })
+            .collect())
+    }
+
+    /// Lists canonical state metadata without opening a recorder, repairing the source index, or
+    /// scanning rollouts. `use_state_db_only` is necessarily true for this store, even when the
+    /// caller permits a writable store to fall back to filesystem scans.
+    pub async fn list_threads(
+        &self,
+        params: ListThreadsParams,
+        default_model_provider_id: &str,
+    ) -> ThreadStoreResult<ThreadPage> {
+        self.validate_root()?;
+        if params.sort_key == ThreadSortKey::SectionPosition
+            && params.section.as_ref().and_then(Option::as_deref).is_none()
+        {
+            return Err(invalid(
+                "section-position sorting requires a section filter",
+            ));
+        }
+        let anchor = params
+            .cursor
+            .as_deref()
+            .map(|cursor| parse_anchor(cursor, params.sort_key))
+            .transpose()?;
+        let allowed_sources = params
+            .allowed_sources
+            .iter()
+            .map(|source| match serde_json::to_value(source) {
+                Ok(serde_json::Value::String(source)) => source,
+                Ok(source) => source.to_string(),
+                Err(_) => String::new(),
+            })
+            .collect::<Vec<_>>();
+        let normalized_cwd_filters = params.cwd_filters.as_ref().map(|filters| {
+            filters
+                .iter()
+                .map(|cwd| codex_rollout::state_db::normalize_cwd_for_state_db(cwd))
+                .collect::<Vec<_>>()
+        });
+        let filters = ThreadFilterOptions {
+            archived_only: params.archived,
+            allowed_sources: allowed_sources.as_slice(),
+            model_providers: params.model_providers.as_deref(),
+            cwd_filters: normalized_cwd_filters.as_deref(),
+            section: params.section.as_ref().map(Option::as_deref),
+            project_id: params.project_id.as_ref().map(Option::as_deref),
+            anchor: anchor.as_ref(),
+            sort_key: match params.sort_key {
+                ThreadSortKey::CreatedAt => codex_state::SortKey::CreatedAt,
+                ThreadSortKey::UpdatedAt => codex_state::SortKey::UpdatedAt,
+                ThreadSortKey::RecencyAt => codex_state::SortKey::RecencyAt,
+                ThreadSortKey::SectionPosition => codex_state::SortKey::SectionPosition,
+            },
+            sort_direction: match params.sort_direction {
+                SortDirection::Asc => codex_state::SortDirection::Asc,
+                SortDirection::Desc => codex_state::SortDirection::Desc,
+            },
+            search_term: params.search_term.as_deref(),
+        };
+        let relation_filter = params.relation_filter.map(|relation| match relation {
+            ThreadRelationFilter::DirectChildrenOf(thread_id) => {
+                codex_state::ThreadRelationFilter::DirectChildrenOf(thread_id)
+            }
+            ThreadRelationFilter::DescendantsOf(thread_id) => {
+                codex_state::ThreadRelationFilter::DescendantsOf(thread_id)
+            }
+        });
+        let codex_state::ThreadsPage {
+            items,
+            parent_thread_ids,
+            next_anchor,
+            ..
+        } = self
+            .state
+            .list_threads_page(params.page_size, filters, relation_filter)
+            .await
+            .map_err(incomplete)?;
+        let items = items
+            .into_iter()
+            .map(|metadata| {
+                let parent_thread_id = parent_thread_ids.get(&metadata.id).copied();
+                stored_thread_from_state_metadata_with_provider(
+                    default_model_provider_id,
+                    metadata,
+                    parent_thread_id,
+                )
+            })
+            .collect();
+        let next_cursor = next_anchor
+            .map(|anchor| format_anchor(anchor, params.sort_key))
+            .transpose()?
+            .flatten();
+        Ok(ThreadPage { items, next_cursor })
+    }
+
+    /// Checks only the registered source's project table. It does not create a project or inspect
+    /// another profile's database when the requested project is absent.
+    pub async fn project_exists(&self, project_id: &str) -> ThreadStoreResult<bool> {
+        self.validate_root()?;
+        self.state
+            .project_exists(project_id)
+            .await
+            .map_err(incomplete)
+    }
+}
+
+fn parse_anchor(cursor: &str, sort_key: ThreadSortKey) -> ThreadStoreResult<Anchor> {
+    let invalid_cursor = || invalid(format!("invalid cursor: {cursor}"));
+    if sort_key == ThreadSortKey::SectionPosition {
+        let (position, thread_id) = cursor.split_once('|').ok_or_else(invalid_cursor)?;
+        let ts = position
+            .parse::<i64>()
+            .ok()
+            .and_then(DateTime::<Utc>::from_timestamp_millis)
+            .ok_or_else(invalid_cursor)?;
+        let id = ThreadId::from_string(thread_id).map_err(|_| invalid_cursor())?;
+        return Ok(Anchor { ts, id: Some(id) });
+    }
+
+    // Cursor's timestamp and ID accessors are private to codex-rollout. Round-trip its public
+    // serialized representation so the accepted legacy timestamp format stays identical to the
+    // native list endpoint, without introducing a second legacy-format parser.
+    let parsed = codex_rollout::parse_cursor(cursor).ok_or_else(invalid_cursor)?;
+    let canonical = serde_json::to_value(parsed).map_err(incomplete)?;
+    let canonical = canonical.as_str().ok_or_else(invalid_cursor)?;
+    let (timestamp, id) = match canonical.rsplit_once('|') {
+        Some((timestamp, id)) => (
+            timestamp,
+            Some(ThreadId::from_string(id).map_err(|_| invalid_cursor())?),
+        ),
+        None => (canonical, None),
+    };
+    let timestamp = DateTime::parse_from_rfc3339(timestamp).map_err(|_| invalid_cursor())?;
+    // Match rollout::state_db's truncation toward zero, including timestamps before the epoch.
+    // i128 also preserves dates outside chrono's i64 nanosecond range.
+    let nanos = i128::from(timestamp.timestamp()) * 1_000_000_000
+        + i128::from(timestamp.timestamp_subsec_nanos());
+    let millis = i64::try_from(nanos / 1_000_000).map_err(|_| invalid_cursor())?;
+    let ts = DateTime::<Utc>::from_timestamp_millis(millis).ok_or_else(invalid_cursor)?;
+    Ok(Anchor { ts, id })
+}
+
+fn format_anchor(anchor: Anchor, sort_key: ThreadSortKey) -> ThreadStoreResult<Option<String>> {
+    if sort_key == ThreadSortKey::SectionPosition {
+        return Ok(anchor
+            .id
+            .map(|thread_id| format!("{}|{thread_id}", anchor.ts.timestamp_millis())));
+    }
+    let value = serde_json::to_value(codex_rollout::Cursor::from(anchor)).map_err(incomplete)?;
+    Ok(value.as_str().map(str::to_owned))
+}
