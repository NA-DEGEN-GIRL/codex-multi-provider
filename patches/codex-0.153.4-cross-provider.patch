+struct ActivationFixture {
+    manager: ThreadManager,
+    registry: ManagedSourceRegistry,
+    source_id: ManagedSourceId,
+    target_id: ManagedSourceId,
+    source_home: PathBuf,
+    target_home: PathBuf,
+    profile_id: String,
+    root: ThreadId,
+    source_graph: LocalAgentGraphStore,
+    target_graph: LocalAgentGraphStore,
