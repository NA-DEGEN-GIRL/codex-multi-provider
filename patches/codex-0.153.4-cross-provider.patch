+//! History projection helpers without a loaded-thread status or write handle.
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::SortDirection;
+use codex_app_server_protocol::ThreadItem;
+use codex_app_server_protocol::ThreadItemEntry;
+use codex_app_server_protocol::ThreadItemsListResponse;
+use codex_app_server_protocol::ThreadTurnsListResponse;
+use codex_app_server_protocol::Turn;
+use codex_app_server_protocol::TurnError;
+use codex_app_server_protocol::TurnItemsView;
+use codex_app_server_protocol::TurnStatus;
+use codex_thread_store::StoredThreadItem;
+use codex_thread_store::StoredTurn;
+use codex_thread_store::StoredTurnStatus;
+use codex_thread_store::ThreadStoreError;
+use serde::Deserialize;
+use serde::Serialize;
+
+use crate::error_code::invalid_request;
+
+pub(super) fn store_error(error: ThreadStoreError) -> JSONRPCErrorError {
+    invalid_request(format!("cannot read canonical history: {error}"))
+}
+
+pub(super) fn sort(direction: SortDirection) -> codex_thread_store::SortDirection {
+    match direction {
+        SortDirection::Asc => codex_thread_store::SortDirection::Asc,
+        SortDirection::Desc => codex_thread_store::SortDirection::Desc,
+    }
+}
+
+pub(super) fn item(stored: StoredThreadItem) -> Result<ThreadItem, JSONRPCErrorError> {
+    let item: ThreadItem = serde_json::from_slice(&stored.item_json).map_err(|err| {
+        invalid_request(format!(
+            "invalid canonical history item {}: {err}",
+            stored.item_id
+        ))
+    })?;
+    if item.id() != stored.item_id {
+        return Err(invalid_request(
+            "canonical history item ID does not match its stored row",
+        ));
+    }
+    Ok(item)
+}
+
+pub(super) fn turn(
+    stored: StoredTurn,
+    items_view: TurnItemsView,
+) -> Result<Turn, JSONRPCErrorError> {
+    let status = match stored.status {
+        StoredTurnStatus::Completed => TurnStatus::Completed,
+        StoredTurnStatus::Interrupted => TurnStatus::Interrupted,
+        StoredTurnStatus::Failed => TurnStatus::Failed,
+        StoredTurnStatus::InProgress => TurnStatus::InProgress,
+    };
+    let error = stored.error.map(|error| TurnError {
+        misalignment: None,
+        message: error.message,
+        codex_error_info: error.codex_error_info,
+        additional_details: error.additional_details,
+    });
+    Ok(Turn {
+        id: stored.turn_id,
+        items: stored
+            .items
+            .into_iter()
+            .map(item)
+            .collect::<Result<_, _>>()?,
+        items_view,
+        status,
+        error,
+        started_at: stored.started_at,
+        completed_at: stored.completed_at,
+        duration_ms: stored.duration_ms,
+    })
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct LegacyCursor {
+    turn_id: String,
+    item_id: Option<String>,
+    include_anchor: bool,
+}
+
+fn encode_cursor(
+    turn_id: &str,
+    item_id: Option<&str>,
+    include_anchor: bool,
+) -> Result<String, JSONRPCErrorError> {
+    serde_json::to_string(&LegacyCursor {
+        turn_id: turn_id.to_string(),
+        item_id: item_id.map(str::to_string),
+        include_anchor,
+    })
+    .map_err(|err| invalid_request(format!("cannot encode legacy history cursor: {err}")))
+}
+
+type HistoryPage<T> = (Vec<T>, Option<String>, Option<String>);
+
+fn paginate<T>(
+    values: Vec<T>,
+    cursor: Option<String>,
+    limit: Option<u32>,
+    direction: SortDirection,
+    identity: impl Fn(&T) -> (&str, Option<&str>),
+) -> Result<HistoryPage<T>, JSONRPCErrorError> {
+    let anchor = cursor
+        .map(|cursor| serde_json::from_str::<LegacyCursor>(&cursor))
+        .transpose()
+        .map_err(|_| invalid_request("invalid legacy record history cursor"))?;
+    let anchor_index = anchor
+        .as_ref()
+        .map(|anchor| {
+            values
+                .iter()
+                .position(|value| {
+                    let (turn_id, item_id) = identity(value);
+                    turn_id == anchor.turn_id && item_id == anchor.item_id.as_deref()
+                })
+                .ok_or_else(|| invalid_request("canonical legacy history changed; restart listing"))
+        })
+        .transpose()?;
+    let descending = direction == SortDirection::Desc;
+    let mut values = values
+        .into_iter()
+        .enumerate()
+        .filter(|(index, _)| match (anchor.as_ref(), anchor_index) {
+            (Some(anchor), Some(anchor_index)) => {
+                if descending {
+                    *index < anchor_index || (anchor.include_anchor && *index == anchor_index)
+                } else {
+                    *index > anchor_index || (anchor.include_anchor && *index == anchor_index)
+                }
+            }
+            _ => true,
+        })
+        .map(|(_, value)| value)
+        .collect::<Vec<_>>();
+    if descending {
+        values.reverse();
+    }
+    let limit = limit
+        .map(|limit| limit as usize)
+        .unwrap_or(25)
+        .clamp(1, super::HISTORY_PAGE_LIMIT);
+    let more = values.len() > limit;
+    values.truncate(limit);
+    let backwards_cursor = values
+        .first()
+        .map(|value| {
+            let (turn_id, item_id) = identity(value);
+            encode_cursor(turn_id, item_id, true)
+        })
+        .transpose()?;
+    let next_cursor = if more {
+        values
+            .last()
+            .map(|value| {
+                let (turn_id, item_id) = identity(value);
+                encode_cursor(turn_id, item_id, false)
+            })
+            .transpose()?
+    } else {
+        None
+    };
+    Ok((values, next_cursor, backwards_cursor))
+}
+
+pub(super) fn legacy_turns_page(
+    mut turns: Vec<Turn>,
+    cursor: Option<String>,
+    limit: Option<u32>,
+    direction: SortDirection,
+    items_view: TurnItemsView,
+) -> Result<ThreadTurnsListResponse, JSONRPCErrorError> {
+    for turn in &mut turns {
+        if items_view == TurnItemsView::NotLoaded {
+            turn.items.clear();
+        } else if items_view == TurnItemsView::Summary {
+            let first = turn
+                .items
+                .iter()
+                .find(|item| matches!(item, ThreadItem::UserMessage { .. }))
+                .cloned();
+            let last = turn
+                .items
+                .iter()
+                .rev()
+                .find(|item| matches!(item, ThreadItem::AgentMessage { .. }))
+                .cloned();
+            turn.items = first.into_iter().chain(last).collect();
+        }
+        turn.items_view = items_view;
+    }
+    let (data, next_cursor, backwards_cursor) =
+        paginate(turns, cursor, limit, direction, |turn| (&turn.id, None))?;
+    Ok(ThreadTurnsListResponse {
+        data,
+        next_cursor,
+        backwards_cursor,
+    })
+}
+
+pub(super) fn legacy_items_page(
+    turns: Vec<Turn>,
+    turn_id: Option<String>,
+    cursor: Option<String>,
+    limit: Option<u32>,
+    direction: SortDirection,
+) -> Result<ThreadItemsListResponse, JSONRPCErrorError> {
+    let items = turns
+        .into_iter()
+        .filter(|turn| turn_id.as_ref().is_none_or(|id| *id == turn.id))
+        .flat_map(|turn| {
+            turn.items.into_iter().map(move |item| ThreadItemEntry {
+                turn_id: turn.id.clone(),
+                item,
+            })
+        })
+        .collect::<Vec<_>>();
+    let (data, next_cursor, backwards_cursor) =
+        paginate(items, cursor, limit, direction, |entry| {
+            (&entry.turn_id, Some(entry.item.id()))
+        })?;
+    Ok(ThreadItemsListResponse {
+        data,
+        next_cursor,
+        backwards_cursor,
+    })
+}
diff --git a/codex-rs/app-server/src/manager_record_catalog_listing.rs b/codex-rs/app-server/src/manager_record_catalog_listing.rs
new file mode 100644
index 000000000..9a980160d
--- /dev/null
+++ b/codex-rs/app-server/src/manager_record_catalog_listing.rs
@@ -0,0 +1,330 @@
+//! Shared native and foreign record listing, with one bounded cursor.
+
+use super::*;
+use futures::StreamExt;
+use futures::stream::FuturesUnordered;
+use sha2::Digest;
+
+const RECORD_READ_CONCURRENCY: usize = 16;
+const CACHED_LISTINGS: usize = 4;
+
+enum NativeRecords<'a> {
+    Omit,
+    Merge {
+        home: &'a Path,
+        threads: Vec<Thread>,
+    },
+}
+
+impl RecordCatalog {
+    pub(crate) async fn list(
+        &self,
+        params: ThreadListParams,
+        fallback_cwd: &AbsolutePathBuf,
+    ) -> Result<ThreadListResponse, JSONRPCErrorError> {
+        self.list_records(params, fallback_cwd, NativeRecords::Omit)
+            .await
+    }
+
+    pub(crate) async fn list_with_native(
+        &self,
+        params: ThreadListParams,
+        fallback_cwd: &AbsolutePathBuf,
+        native_home: &Path,
+        native_threads: Vec<Thread>,
+    ) -> Result<ThreadListResponse, JSONRPCErrorError> {
+        self.list_records(
+            params,
+            fallback_cwd,
+            NativeRecords::Merge {
+                home: native_home,
+                threads: native_threads,
+            },
+        )
+        .await
+    }
+
+    async fn list_records(
+        &self,
+        params: ThreadListParams,
+        fallback_cwd: &AbsolutePathBuf,
+        native: NativeRecords<'_>,
+    ) -> Result<ThreadListResponse, JSONRPCErrorError> {
+        if (!self.is_shared() && (params.project_id.is_some() || params.section_id.is_some()))
+            || params.ancestor_thread_id.is_some()
+            || params.sort_key == Some(ThreadSortKey::SectionPosition)
+        {
+            return Err(invalid_request(
+                "project, section, and ancestry queries require an authoritative catalog adapter",
+            ));
+        }
+        let mut query =
+            serde_json::to_value(&params).map_err(|err| invalid_request(err.to_string()))?;
+        if let Some(object) = query.as_object_mut() {
+            object.remove("cursor");
+            object.remove("limit");
+        }
+        let (native_home, mut data) = match native {
+            NativeRecords::Omit => (None, Vec::new()),
+            NativeRecords::Merge { home, threads } => {
+                let home = tokio::fs::canonicalize(home).await.map_err(|error| {
+                    invalid_request(format!("native record home unavailable: {error}"))
+                })?;
+                (Some(home), threads)
+            }
+        };
+        let native_ids = data
+            .iter()
+            .map(|thread| thread.id.as_str())
+            .collect::<HashSet<_>>();
+        if native_ids.len() != data.len()
+            || self
+                .entries
+                .iter()
+                .any(|source| native_ids.contains(source.projection_thread_id.to_string().as_str()))
+        {
+            return Err(invalid_request(
+                "native and projected record identities collide",
+            ));
+        }
+        let mut digest = sha2::Sha256::new();
+        // Imported projects can become available after native app initialization.
+        // Scope cached membership and pages to the currently resolved aliases.
+        digest.update(
+            serde_json::to_vec(&self.project_aliases)
+                .map_err(|_| invalid_request("cannot encode shared project aliases"))?,
+        );
+        digest.update(
+            self.discovered
+                .as_ref()
+                .map_or(self.revision.as_str(), |data| data.scope_revision.as_str())
+                .as_bytes(),
+        );
+        if let Some(home) = &native_home {
+            digest.update(
+                serde_json::to_vec(home).map_err(|error| invalid_request(error.to_string()))?,
+            );
+        }
+        if native_home.is_some() && self.discovered.is_none() {
+            let metadata = data
+                .iter()
+                .map(|thread| {
+                    (
+                        &thread.id,
+                        thread.created_at,
+                        thread.updated_at,
+                        thread.recency_at,
+                    )
+                })
+                .collect::<Vec<_>>();
+            digest.update(
+                serde_json::to_vec(&metadata)
+                    .map_err(|error| invalid_request(error.to_string()))?,
+            );
+        }
+        let revision = format!("{:x}", digest.finalize());
+        let cursor = params
+            .cursor
+            .as_deref()
+            .map(serde_json::from_str::<PageCursor>)
+            .transpose()
+            .map_err(|err| invalid_request(format!("invalid record catalog cursor: {err}")))?;
+        if cursor
+            .as_ref()
+            .is_some_and(|cursor| cursor.revision != revision || cursor.query != query)
+        {
+            return Err(invalid_request(
+                "record catalog or query changed; restart listing",
+            ));
+        }
+        let listing_key = self
+            .discovered
+            .as_ref()
+            .map(|_| {
+                let mut digest = sha2::Sha256::new();
+                digest.update(revision.as_bytes());
+                digest.update(
+                    serde_json::to_vec(&query)
+                        .map_err(|error| invalid_request(error.to_string()))?,
+                );
+                // Native state can change independently of the foreign discovery
+                // snapshot, including names and loaded actor status.
+                digest.update(
+                    serde_json::to_vec(&data)
+                        .map_err(|error| invalid_request(error.to_string()))?,
+                );
+                Ok::<_, JSONRPCErrorError>(format!("{:x}", digest.finalize()))
+            })
+            .transpose()?;
+        if let Some(discovered) = &self.discovered
+            && let Some(listing_key) = &listing_key
+        {
+            let cached = discovered
+                .listings
+                .lock()
+                .ok()
+                .and_then(|cache| cache.get(listing_key).cloned());
+            if let Some(cached) = cached {
+                return page_response(&cached, &params, cursor.as_ref(), &revision, &query);
+            }
+        }
+        let sort_key = params.sort_key.unwrap_or(ThreadSortKey::CreatedAt);
+        let descending = params.sort_direction != Some(SortDirection::Asc);
+        let cwd_filters = match &params.cwd {
+            None => None,
+            Some(ThreadListCwdFilter::One(path)) => Some(vec![path]),
+            Some(ThreadListCwdFilter::Many(paths)) => Some(paths.iter().collect()),
+        }
+        .map(|paths| {
+            paths
+                .into_iter()
+                .map(|path| {
+                    AbsolutePathBuf::relative_to_current_dir(path.as_str())
+                        .map(AbsolutePathBuf::into_path_buf)
+                        .map_err(|err| {
+                            invalid_request(format!("invalid thread/list cwd filter: {err}"))
+                        })
+                })
+                .collect::<Result<Vec<_>, _>>()
+        })
+        .transpose()?;
+        let (allowed_sources, source_filter) = compute_source_filters(params.source_kinds.clone());
+        let native_home = native_home.as_deref();
+        // Indexed inventory snapshots already contain metadata-only summaries.
+        // Explicit manifests and unindexed records retain the validated fallback.
+        let mut sources = self.entries.iter();
+        let mut records = FuturesUnordered::new();
+        loop {
+            while records.len() < RECORD_READ_CONCURRENCY {
+                let Some(source) = sources.next() else { break };
+                if !self.shared_routes.includes(source) {
+                    continue;
+                }
+                records.push(async move {
+                    if let Some(native_home) = native_home
+                        && self.validated_home(source).await? == native_home
+                    {
+                        // Own records keep their canonical IDs and normal input.
+                        return Ok(None);
+                    }
+                    self.summary(source)
+                        .await
+                        .map(|stored| Some((source, stored)))
+                });
+            }
+            let Some(stored) = records.next().await else {
+                break;
+            };
+            let Some((source, stored)) = stored? else {
+                continue;
+            };
+            if stored.archived_at.is_some() != params.archived.unwrap_or(false)
+                || params
+                    .project_id
+                    .as_ref()
+                    .is_some_and(|project| project.as_ref() != stored.project_id.as_ref())
+                || params.section_id.as_ref().is_some_and(|section| {
+                    section.as_ref() != stored.section.as_ref().map(|section| &section.id)
+                })
+                || (!allowed_sources.is_empty() && !allowed_sources.contains(&stored.source))
+                || source_filter
+                    .as_ref()
+                    .is_some_and(|filter| !source_kind_matches(&stored.source, filter))
+                || params.model_providers.as_ref().is_some_and(|providers| {
+                    !providers.is_empty() && !providers.contains(&stored.model_provider)
+                })
+                || params.parent_thread_id.as_ref().is_some_and(|id| {
+                    stored
+                        .parent_thread_id
+                        .map(|parent| parent.to_string())
+                        .as_ref()
+                        != Some(id)
+                })
+                || params.search_term.as_ref().is_some_and(|needle| {
+                    !stored
+                        .name
+                        .as_deref()
+                        .unwrap_or(&stored.preview)
+                        .to_lowercase()
+                        .contains(&needle.to_lowercase())
+                })
+            {
+                continue;
+            }
+            let (mut thread, _) = thread_from_stored_thread(stored, "openai", fallback_cwd);
+            let cwd_matches = cwd_filters.as_ref().is_none_or(|paths| {
+                paths.iter().any(|path| {
+                    path_utils::paths_match_after_normalization(path, thread.cwd.as_path())
+                })
+            });
+            if !cwd_matches {
+                continue;
+            }
+            if !super::execution::enabled() || self.shared_routes.projects(source) {
+                thread.can_accept_direct_input = Some(false);
+                thread.extra = Some(source.origin());
+                thread.path = None;
+            }
+            data.push(thread);
+        }
+        data.sort_by(|left, right| {
+            let order = key(left, sort_key).cmp(&key(right, sort_key));
+            if descending { order.reverse() } else { order }
+        });
+        let data = Arc::new(data);
+        if let Some(discovered) = &self.discovered
+            && let Some(listing_key) = listing_key
+            && let Ok(mut cache) = discovered.listings.lock()
+        {
+            if cache.len() >= CACHED_LISTINGS && !cache.contains_key(&listing_key) {
+                cache.clear();
+            }
+            cache.insert(listing_key, Arc::clone(&data));
+        }
+        page_response(&data, &params, cursor.as_ref(), &revision, &query)
+    }
+}
+
+fn page_response(
+    sorted: &[Thread],
+    params: &ThreadListParams,
+    cursor: Option<&PageCursor>,
+    revision: &str,
+    query: &serde_json::Value,
+) -> Result<ThreadListResponse, JSONRPCErrorError> {
+    let sort_key = params.sort_key.unwrap_or(ThreadSortKey::CreatedAt);
+    let descending = params.sort_direction != Some(SortDirection::Asc);
+    let offset = cursor.map_or(0, |cursor| {
+        sorted.partition_point(|thread| {
+            let order = key(thread, sort_key).cmp(&(cursor.timestamp, cursor.id.as_str()));
+            if descending {
+                !order.is_lt()
+            } else {
+                !order.is_gt()
+            }
+        })
+    });
+    let remaining = &sorted[offset..];
+    let limit = params.limit.unwrap_or(50).clamp(1, 200) as usize;
+    let data = remaining.iter().take(limit).cloned().collect::<Vec<_>>();
+    let next_cursor = if remaining.len() > limit {
+        data.last()
+            .map(|thread| {
+                serde_json::to_string(&PageCursor {
+                    revision: revision.to_string(),
+                    query: query.clone(),
+                    timestamp: key(thread, sort_key).0,
+                    id: thread.id.clone(),
+                })
+            })
+            .transpose()
+            .map_err(|error| invalid_request(error.to_string()))?
+    } else {
+        None
+    };
+    Ok(ThreadListResponse {
+        data,
+        next_cursor,
+        backwards_cursor: None,
+    })
+}
