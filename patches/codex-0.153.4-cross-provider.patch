+#[tokio::test]
+async fn paginated_source_reads_preserve_database_rollout_bytes_and_modified_times() {
+    let fixture = paginated_fixture().await;
+    let sqlite = test_config(fixture.home.path()).sqlite;
+    let expected_timeline = fixture
+        .store
+        .list_timeline(ListTimelineParams {
+            thread_id: fixture.thread_id,
+            cursor: None,
+            page_size: 100,
+        })
+        .await
+        .expect("source timeline fixture");
+    assert!(!expected_timeline.items.is_empty());
+    let before = source_snapshot(fixture.home.path());
+    let reader = ReadOnlyLocalThreadStore::open(fixture.home.path().to_path_buf(), sqlite)
+        .await
+        .expect("open source read-only");
+
+    let thread = reader
+        .read_thread(read_params(fixture.thread_id))
+        .await
+        .expect("read thread metadata");
+    assert_eq!(thread.thread_id, fixture.thread_id);
+    assert_eq!(thread.history_mode, ThreadHistoryMode::Paginated);
+    assert_eq!(
+        thread.rollout_path,
+        Some(fs::canonicalize(&fixture.rollout_path).expect("canonical fixture rollout"))
+    );
+    assert!(thread.history.is_none());
+
+    let first_turns = reader
+        .list_turns(turn_params(fixture.thread_id, None, 1))
+        .await
+        .expect("first turn page");
+    assert_eq!(turn_ids(&first_turns), vec!["turn-1"]);
+    assert_eq!(first_turns.turns[0].items.len(), 1);
+    assert!(first_turns.next_cursor.is_some());
+    let second_turns = reader
+        .list_turns(turn_params(fixture.thread_id, first_turns.next_cursor, 1))
+        .await
+        .expect("second turn page");
+    assert_eq!(turn_ids(&second_turns), vec!["turn-2"]);
+    assert!(second_turns.next_cursor.is_none());
+
+    let first_items = reader
+        .list_items(item_params(fixture.thread_id, None, 1))
+        .await
+        .expect("first item page");
+    assert_eq!(first_items.items.len(), 1);
+    assert_eq!(first_items.items[0].item_id, "item-turn-1");
+    assert!(first_items.next_cursor.is_some());
+    let second_items = reader
+        .list_items(item_params(fixture.thread_id, first_items.next_cursor, 1))
+        .await
+        .expect("second item page");
+    assert_eq!(second_items.items.len(), 1);
+    assert_eq!(second_items.items[0].item_id, "item-turn-2");
+    assert!(second_items.next_cursor.is_none());
+
+    let mut timeline = Vec::new();
+    let mut cursor = None;
+    for _ in 0..20 {
+        let page = reader
+            .list_timeline(ListTimelineParams {
+                thread_id: fixture.thread_id,
+                cursor,
+                page_size: 1,
+            })
+            .await
+            .expect("read timeline page");
+        let mut previous_items = page.items;
+        previous_items.extend(timeline);
+        timeline = previous_items;
+        cursor = page.next_cursor;
+        if cursor.is_none() {
+            break;
+        }
+    }
+    assert!(cursor.is_none(), "timeline pagination must terminate");
+    assert_eq!(timeline, expected_timeline.items);
+
+    reader.close().await;
+    assert_source_unchanged(fixture.home.path(), &before);
+}
