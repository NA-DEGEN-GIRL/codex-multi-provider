+/// Payload of the newest checkpoint in `thread_id`'s legacy rollout.
+fn newest_checkpoint(codex_home: &Path, thread_id: &str) -> Result<Value> {
+    let mut pending = vec![codex_home.join("sessions")];
+    let mut checkpoints = Vec::new();
+    while let Some(dir) = pending.pop() {
+        for entry in std::fs::read_dir(&dir)? {
+            let path = entry?.path();
+            if path.is_dir() {
+                pending.push(path);
+                continue;
+            }
+            let name = path
+                .file_name()
+                .and_then(|name| name.to_str())
+                .unwrap_or_default();
+            if !name.contains(thread_id) || !name.ends_with(".jsonl") {
+                continue;
+            }
+            let newest = std::fs::read_to_string(&path)?
+                .lines()
+                .map(serde_json::from_str::<Value>)
+                .collect::<std::result::Result<Vec<_>, _>>()?
+                .into_iter()
+                .rfind(|record| record["type"] == "compacted")
+                .expect("a checkpoint");
+            checkpoints.push(newest["payload"].clone());
+        }
+    }
+    assert_eq!(checkpoints.len(), 1, "expected one rollout for {thread_id}");
+    Ok(checkpoints.remove(0))
+}
+
+/// Splits a request body into its input items and everything else.
+fn split_input(body: &Value) -> (Vec<Value>, Value) {
+    let mut rest = body.clone();
+    let input = rest
+        .as_object_mut()
+        .and_then(|body| body.remove("input"))
+        .and_then(|input| input.as_array().cloned())
+        .expect("request input");
+    (input, rest)
+}
