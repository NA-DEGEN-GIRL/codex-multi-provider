+        )?;
+        let manifest_path = home.path().join("managed-sources.json");
+        fs::write(
+            &manifest_path,
+            serde_json::to_vec(&json!({
+                "version": 1,
+                "hostId": "local",
+                "profileId": profile_id,
+                "sources": [{
+                    "hostId": "local",
+                    "sourceStoreId": source_id,
+                    "codexHome": home.path(),
+                }],
+                "bindings": [],
+            }))?,
+        )?;
+        Ok(Self {
+            home,
+            source_id,
+            manifest_path,
+        })
+    }
+
+    async fn start_server(&self) -> Result<TestAppServer> {
+        TestAppServer::builder()
+            .with_codex_home(self.home.path())
+            .without_managed_config()
+            .with_env_overrides(&[
+                (
+                    SOURCES_ENV,
+                    Some(self.manifest_path.to_str().context("UTF-8 manifest path")?),
+                ),
+                ("CODEX_MANAGER_RECORD_CATALOG", None),
+                ("CODEX_SQLITE_HOME", None),
+                ("OPENAI_API_KEY", None),
+                ("CODEX_ACCESS_TOKEN", None),
+            ])
+            .build_initialized_with_timeout(READ_TIMEOUT)
+            .await
+    }
+
+    fn authority_bytes(&self, thread_id: &str) -> Result<Vec<u8>> {
+        Ok(fs::read(
+            self.home
+                .path()
+                .join("managed-authority")
+                .join(format!("{thread_id}.json")),
+        )?)
+    }
+}
