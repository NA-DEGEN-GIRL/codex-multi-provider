@@ -0,0 +1,248 @@
+//! Strict, non-interrupting actor shutdown used by managed record handoff and
+//! by shared-history reloads, which also carry queued agent mail across it:
+//! moved to the replacement actor, or recorded in history for a lazy reload.
+
+use super::IdleCloseAdmission;
+use super::handlers;
+use super::session::Session;
+use crate::codex_thread::CodexThread;
+use async_channel::Receiver;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::Event;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::InterAgentCommunication;
+use codex_protocol::protocol::Submission;
+use codex_protocol::turn_input::TurnStartOptions;
+use std::sync::Arc;
+use tokio_util::sync::CancellationToken;
+
+/// Inter-agent mail moved out of an idle actor reserved for close. It lives only
+/// in memory, so the caller must requeue it on the replacement actor, or on the
+/// original actor when the close is refused.
+#[must_use = "moved agent mail is lost unless it is requeued"]
+pub struct QueuedAgentMail(Vec<(InterAgentCommunication, TurnStartOptions)>);
+
+impl QueuedAgentMail {
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+}
+
+impl CodexThread {
+    /// Move mail that waits for this idle actor's next turn out of it, so a
+    /// strict idle close can replace the actor without dropping the mail. The
+    /// reservation keeps new mail out until the close completes or is refused.
+    pub async fn take_queued_agent_mail(
+        &self,
+        admission: &IdleCloseAdmission,
+    ) -> CodexResult<QueuedAgentMail> {
+        if !self.idle_close_reservation_matches(admission) {
+            return Err(CodexErr::UnsupportedOperation(
+                "idle close reservation belongs to another actor".into(),
+            ));
+        }
+        if self.session.active_turn.lock().await.is_some() {
+            return Err(CodexErr::UnsupportedOperation(
+                "cannot move agent mail: a turn or tool task is active".into(),
+            ));
+        }
+        Ok(QueuedAgentMail(
+            self.session.input_queue.take_mailbox_communications().await,
+        ))
+    }
+
+    /// Queue moved mail for this actor's next turn without starting one.
+    pub async fn requeue_agent_mail(&self, mail: QueuedAgentMail) {
+        for (communication, start_options) in mail.0 {
+            self.session
+                .input_queue
+                .enqueue_mailbox_communication(communication, start_options)
+                .await;
+        }
+    }
+
+    /// Record queue-only mail waiting for this idle actor's next turn in its
+    /// history, as a finishing turn records mail it did not sample, and flush
+    /// it. Nothing starts a turn for such mail (`send_message`, queue-only
+    /// completion notices), so a strict idle close would otherwise refuse the
+    /// actor until it runs again. The actor reloaded from its record, or this
+    /// one if the close is refused, sees the mail once, in history. Mail that
+    /// is about to start a turn is refused and left queued.
+    pub async fn record_queued_agent_mail(
+        &self,
+        admission: &IdleCloseAdmission,
+    ) -> CodexResult<()> {
+        if !self.idle_close_reservation_matches(admission) {
+            return Err(CodexErr::UnsupportedOperation(
+                "idle close reservation belongs to another actor".into(),
+            ));
+        }
+        let session = &self.session;
+        if !session.input_queue.has_pending_mailbox_items().await {
+            return Ok(());
+        }
+        let starts_turn =
+            || CodexErr::UnsupportedOperation("queued agent mail is starting a turn".into());
+        if session.active_turn.lock().await.is_some() {
+            return Err(CodexErr::UnsupportedOperation(
+                "cannot record agent mail: a turn or tool task is active".into(),
+            ));
+        }
+        if session.has_outstanding_durable_sleep()
+            || session.input_queue.has_trigger_turn_mailbox_items().await
+        {
+            return Err(starts_turn());
+        }
+        let turn_context = session.new_default_turn().await;
+        if session.reference_context_item().await.is_none() {
+            // Like injected items, this history-only record owns its initial step.
+            let step_context = session
+                .capture_step_context(Arc::clone(&turn_context), &CancellationToken::new())
+                .await?;
+            session
+                .record_context_updates_and_set_reference_context_item(step_context.as_ref())
+                .await?;
+        }
+        // Checked again under the mailbox lock: a handler already dequeued
+        // before the reservation may still add mail.
+        let mail = session
+            .input_queue
+            .take_queue_only_mailbox_communications()
+            .await
+            .ok_or_else(starts_turn)?;
+        for communication in mail {
+            session
+                .record_inter_agent_communication(turn_context.as_ref(), communication)
+                .await;
+        }
+        session.flush_rollout().await.map_err(|error| {
+            CodexErr::Fatal(format!(
+                "flush after recording queued agent mail failed: {error}"
+            ))
+        })
+    }
+}
+
+pub(super) struct IdleShutdownOutcome {
+    pub(super) result: CodexResult<()>,
+    pub(super) should_exit: bool,
+}
+
+pub(super) async fn close_idle_and_shutdown(
+    session: &Arc<Session>,
+    submissions: &Receiver<Submission>,
+    submission_id: String,
+    admission: &mut bool,
+) -> IdleShutdownOutcome {
+    // This executes inside the submission loop: input accepted earlier is seen
+    // by the checks; later requests cannot start a turn while teardown runs.
+    let prepare = async {
+        ensure_idle(session, submissions).await?;
+        if let Some(live_thread) = session.live_thread() {
+            live_thread.flush().await.map_err(|error| {
+                CodexErr::Fatal(format!("flush before idle thread close failed: {error}"))
+            })?;
+        }
+        // Flushing can yield to mailbox and descendant producers. Refuse work
+        // observed during that wait before stopping any runtime services.
+        ensure_idle(session, submissions).await
+    }
+    .await;
+    if let Err(error) = prepare {
+        return IdleShutdownOutcome {
+            result: Err(error),
+            should_exit: false,
+        };
+    }
+
+    let Some(hook_seal) = session.hooks().try_seal_for_managed_close() else {
+        return IdleShutdownOutcome {
+            result: Err(CodexErr::UnsupportedOperation(
+                "cannot close idle thread: hooks have pending work".into(),
+            )),
+            should_exit: false,
+        };
+    };
+    *admission = true;
+    let result = async {
+        session.internal_sessions.close_idle().await?;
+        handlers::shutdown_session_runtime_checked(
+            session,
+            handlers::ShutdownHooks::Managed(&hook_seal),
+        )
+        .await?;
+        handlers::emit_thread_stop_lifecycle(session.as_ref()).await;
+        if let Some(live_thread) = session.live_thread() {
+            live_thread.flush().await.map_err(|error| {
+                CodexErr::Fatal(format!("flush after idle thread close failed: {error}"))
+            })?;
+            live_thread.shutdown().await.map_err(|error| {
+                CodexErr::Fatal(format!("close idle thread writer failed: {error}"))
+            })?;
+        }
+        session
+            .deliver_event_raw(Event {
+                id: submission_id,
+                msg: EventMsg::ShutdownComplete,
+            })
+            .await;
+        Ok(())
+    }
+    .await
+    .map_err(|error: CodexErr| {
+        CodexErr::Fatal(format!("managed actor teardown was not verified: {error}"))
+    });
+    session.internal_sessions.record_shutdown_result(&result);
+    // Once teardown starts, never admit work into a partly stopped runtime.
+    // An error is deliberately not a release proof; management keeps its gate
+    // sealed and responsibility stays with the source until explicit recovery.
+    IdleShutdownOutcome {
+        result,
+        should_exit: true,
+    }
+}
+
+async fn ensure_idle(
+    session: &Arc<Session>,
+    submissions: &Receiver<Submission>,
+) -> CodexResult<()> {
+    session.internal_sessions.ensure_idle().await?;
+    let reason = if session.active_turn.lock().await.is_some() {
+        Some("a turn or tool task is active")
+    } else if session
+        .input_queue
+        .has_pending_input(&session.active_turn)
+        .await
+    {
+        Some("input or agent mail is pending")
+    } else if *session.services.elicitations.subscribe().borrow() {
+        Some("an elicitation is pending")
+    } else if session.conversation.running_state().await.is_some() {
+        Some("a realtime conversation is active")
+    } else if !session.list_background_terminals().await.is_empty() {
+        Some("a background terminal is active")
+    } else if session
+        .services
+        .agent_control
+        .list_live_agent_subtree_thread_ids(session.thread_id)
+        .await?
+        .len()
+        > 1
+    {
+        Some("a descendant actor is still loaded")
+    } else if session.hooks().has_pending_work()
+        || !submissions.is_empty()
+        || !session.async_hook_results.is_empty()
+    {
+        Some("a submission or hook result is pending")
+    } else {
+        None
+    };
+    match reason {
+        Some(reason) => Err(CodexErr::UnsupportedOperation(format!(
+            "cannot close idle thread: {reason}"
+        ))),
+        None => Ok(()),
+    }
+}
