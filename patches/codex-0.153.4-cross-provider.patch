+#[tokio::test]
+async fn removed_catalog_source_stops_updates_and_explicit_reopen_recovers() -> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let manifest = fs::read(&fixture.manifest_path)?;
+    let original = fs::read(&fixture.rollout_path)?;
+    let mut server = fixture.start_server().await?;
+    let request = server
+        .send_raw_request(
+            "thread/resume",
+            Some(json!({"threadId":fixture.projection_id,"excludeTurns":true})),
+        )
+        .await?;
+    let _: ThreadResumeResponse = timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    let mut removed: serde_json::Value = serde_json::from_slice(&manifest)?;
+    removed["entries"] = json!([]);
+    removed["revision"] = json!("fixture-removed");
+    fs::write(&fixture.manifest_path, serde_json::to_vec(&removed)?)?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("thread/status/changed"),
+    )
+    .await??;
+    let changed: ThreadStatusChangedNotification =
+        serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(
+        changed,
+        ThreadStatusChangedNotification {
+            thread_id: fixture.projection_id.clone(),
+            status: ThreadStatus::SystemError,
+        }
+    );
+    fixture.assert_source_untouched(&original)?;
+    fs::write(&fixture.manifest_path, manifest)?;
+    let request = server
+        .send_raw_request(
+            "thread/resume",
+            Some(json!({"threadId":fixture.projection_id,"excludeTurns":true})),
+        )
+        .await?;
+    let _: ThreadResumeResponse = timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    append(
+        &fixture,
+        EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: "after-reopen".to_string(),
+            trace_id: None,
+            started_at: Some(200),
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        }),
+    )?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("turn/started"),
+    )
+    .await??;
+    let started: TurnStartedNotification = serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(started.turn.id, "after-reopen");
+    Ok(())
+}
