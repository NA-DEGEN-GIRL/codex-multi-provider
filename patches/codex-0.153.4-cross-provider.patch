+    image::DynamicImage::new_rgb8(2, 1)
+        .write_to(&mut encoded, ImageFormat::Jpeg)
+        .unwrap();
+    let bytes = encoded.into_inner();
+    let url = format!("data:image/jpeg;base64,{}", STANDARD.encode(&bytes));
+    let mut builder = ModelTranscriptBuilder::new();
+    for (position, kind) in ["function_call_output", "custom_tool_call_output"]
+        .into_iter()
+        .enumerate()
+    {
+        let response: ResponseItem = serde_json::from_value(serde_json::json!({
+            "type": kind,
+            "call_id": format!("screenshot-{position}"),
+            "output": [
+                {"type": "input_text", "text": "Tool screenshot"},
+                {"type": "input_image", "image_url": url},
+            ]
+        }))
+        .unwrap();
+        builder.push(
+            position as u64,
+            RolloutItem::ResponseItem(ResponseItemEnvelope::new(response)),
+        );
+    }
+    let canonical = builder.finish();
+    let before = super::super::context::snapshot(&canonical, "current").fingerprint;
+    let mut view = canonical.clone();
+    let mut references = Images::new(home.path());
