+#[tokio::test]
+async fn manager_catalog_lists_and_reads_fresh_source_without_creating_source_database()
+-> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let original_bytes = fs::read(&fixture.rollout_path)?;
+    let mut server = fixture.start_server().await?;
+
+    let list_id = server
+        .send_raw_request("thread/list", Some(json!({})))
+        .await?;
+    let listed: ThreadListResponse = timeout(READ_TIMEOUT, server.read_response(list_id)).await??;
+    assert_eq!(listed.data.len(), 1);
+    assert_eq!(listed.data[0].id, fixture.projection_id);
+    assert_ne!(listed.data[0].id, fixture.thread_id);
+    assert_eq!(listed.data[0].path, None);
+    assert_eq!(listed.data[0].can_accept_direct_input, Some(false));
+
+    let read_params = json!({ "threadId": fixture.projection_id, "includeTurns": true });
+    let read_id = server
+        .send_raw_request("thread/read", Some(read_params.clone()))
+        .await?;
+    let first: ThreadReadResponse = timeout(READ_TIMEOUT, server.read_response(read_id)).await??;
+    assert!(!first.thread.turns.is_empty());
+    let mut summary = first.thread.clone();
+    summary.turns.clear();
+    assert_eq!(summary, listed.data[0]);
+    fixture.assert_source_untouched(&original_bytes)?;
+
+    // Simulate another instance appending its completed answer to the canonical
+    // record. The already-running viewer must read it without copying/resuming.
+    let latest_answer = "The source profile has now completed the task";
+    writeln!(
+        fs::OpenOptions::new()
+            .append(true)
+            .open(&fixture.rollout_path)?,
+        "{}",
+        json!({
+            "timestamp": "2025-01-05T12:00:01Z",
+            "type": "event_msg",
+            "payload": { "type": "agent_message", "message": latest_answer },
+        })
+    )?;
+    let appended_bytes = fs::read(&fixture.rollout_path)?;
+    let read_id = server
+        .send_raw_request("thread/read", Some(read_params))
+        .await?;
+    let latest: ThreadReadResponse = timeout(READ_TIMEOUT, server.read_response(read_id)).await??;
+    assert!(latest.thread.turns.iter().flat_map(|turn| &turn.items).any(
+        |item| matches!(item, ThreadItem::AgentMessage { text, .. } if text == latest_answer)
+    ));
+    fixture.assert_source_untouched(&appended_bytes)?;
+    Ok(())
+}
