@@ -0,0 +1,204 @@
+//! The writer's index and the physical session directory can have different homes.
+
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn registered_shared_rollouts_use_existing_index_and_preserve_source_files() {
+    let fixture = paginated_fixture().await;
+    let owner = TempDir::new().expect("physical home");
+    let expected_items = fixture
+        .store
+        .list_items(item_params(fixture.thread_id, None, 10))
+        .await
+        .expect("fixture items")
+        .items;
+    let expected_timeline = fixture
+        .store
+        .list_timeline(ListTimelineParams {
+            thread_id: fixture.thread_id,
+            cursor: None,
+            page_size: 100,
+        })
+        .await
+        .expect("fixture timeline")
+        .items;
+    // Move only the closed fixture's session directory; its live DBs stay in the index home.
+    fs::rename(
+        fixture.home.path().join("sessions"),
+        owner.path().join("sessions"),
+    )
+    .expect("separate physical rollouts from index");
+    let path = owner.path().join(
+        fixture
+            .rollout_path
+            .strip_prefix(fixture.home.path())
+            .unwrap(),
+    );
+    let mut row = fixture
+        .state
+        .get_thread(fixture.thread_id)
+        .await
+        .unwrap()
+        .unwrap();
+    row.rollout_path = path.clone();
+    fixture
+        .state
+        .upsert_thread(&row)
+        .await
+        .expect("fixture's authoritative path");
+
+    let strict = ReadOnlyLocalThreadStore::open(
+        fixture.home.path().to_path_buf(),
+        test_config(fixture.home.path()).sqlite,
+    )
+    .await
+    .unwrap();
+    let error = strict
+        .list_turns(turn_params(fixture.thread_id, None, 10))
+        .await
+        .expect_err("ordinary readers must not follow a foreign root");
+    assert!(
+        error
+            .to_string()
+            .contains("outside registered session roots")
+    );
+    strict.close().await;
+
+    let reader = ReadOnlyLocalThreadStore::open_with_registered_rollout_homes(
+        fixture.home.path().to_path_buf(),
+        test_config(fixture.home.path()).sqlite,
+        vec![fs::canonicalize(owner.path()).unwrap()],
+    )
+    .await
+    .expect("explicitly registered shared reader");
+    let before_index = source_snapshot(fixture.home.path());
+    let before_owner = source_snapshot(owner.path());
+    let turns = reader
+        .list_turns(turn_params(fixture.thread_id, None, 1))
+        .await
+        .unwrap();
+    assert_eq!(turn_ids(&turns), vec!["turn-1"]);
+    let turns = reader
+        .list_turns(turn_params(fixture.thread_id, turns.next_cursor, 1))
+        .await
+        .unwrap();
+    assert_eq!(turn_ids(&turns), vec!["turn-2"]);
+    assert!(turns.next_cursor.is_none());
+    assert_eq!(
+        reader
+            .list_items(item_params(fixture.thread_id, None, 10))
+            .await
+            .unwrap()
+            .items,
+        expected_items
+    );
+    assert_eq!(
+        reader
+            .list_timeline(ListTimelineParams {
+                thread_id: fixture.thread_id,
+                cursor: None,
+                page_size: 100,
+            })
+            .await
+            .unwrap()
+            .items,
+        expected_timeline
+    );
+    assert_eq!(
+        reader
+            .read_thread(read_params(fixture.thread_id))
+            .await
+            .unwrap()
+            .rollout_path,
+        Some(fs::canonicalize(&path).unwrap())
+    );
+    assert_source_unchanged(fixture.home.path(), &before_index);
+    assert_source_unchanged(owner.path(), &before_owner);
+
+    // A registered root does not make a lagging DB authoritative for newer durable bytes.
+    let bytes = fs::read(&path).unwrap();
+    let complete_line = bytes
+        .split(|byte| *byte == b'\n')
+        .find(|line| !line.is_empty())
+        .unwrap();
+    let mut file = fs::OpenOptions::new().append(true).open(&path).unwrap();
+    use std::io::Write;
+    file.write_all(complete_line).unwrap();
+    file.write_all(b"\n").unwrap();
+    drop(file);
+    let error = reader
+        .list_turns(turn_params(fixture.thread_id, None, 10))
+        .await
+        .expect_err("a reader must not silently omit durable unindexed bytes");
+    assert!(
+        error
+            .to_string()
+            .contains("projection does not match durable history"),
+        "{error}"
+    );
+    let outside = TempDir::new().unwrap();
+    fs::create_dir(outside.path().join("sessions")).unwrap();
+    let outside_path = outside.path().join("sessions/escape.jsonl");
+    fs::copy(&path, &outside_path).unwrap();
+    row.rollout_path = outside_path;
+    fixture.state.upsert_thread(&row).await.unwrap();
+    let error = reader
+        .list_turns(turn_params(fixture.thread_id, None, 10))
+        .await
+        .expect_err("explicit sharing must still reject an unregistered destination");
+    assert!(
+        error
+            .to_string()
+            .contains("outside registered session roots")
+    );
+    reader.close().await;
+}
+
+#[tokio::test]
+async fn shared_lineage_rejects_two_physical_ancestors_with_the_same_immutable_id() {
+    let fixture = paginated_fixture().await;
+    fixture
+        .store
+        .revert_thread(RevertThreadParams {
+            thread_id: fixture.thread_id,
+            before_turn_id: "turn-2".to_string(),
+        })
+        .await
+        .expect("create reference-backed history");
+    let other = TempDir::new().unwrap();
+    fs::create_dir(other.path().join("sessions")).unwrap();
+    let duplicate = other
+        .path()
+        .join("sessions")
+        .join(fixture.rollout_path.file_name().unwrap());
+    fs::copy(&fixture.rollout_path, &duplicate).unwrap();
+    let reader = ReadOnlyLocalThreadStore::open_with_registered_rollout_homes(
+        fixture.home.path().to_path_buf(),
+        test_config(fixture.home.path()).sqlite,
+        vec![fs::canonicalize(other.path()).unwrap()],
+    )
+    .await
+    .unwrap();
+    let error = reader
+        .list_turns(turn_params(fixture.thread_id, None, 10))
+        .await
+        .expect_err("ambiguous immutable ancestors must not depend on source order");
+    assert!(
+        error.to_string().contains("ambiguous registered paths"),
+        "{error}"
+    );
+    // With one physical ancestor left in the other registered home, lineage
+    // must resolve there and retain the revert cutoff.
+    fs::remove_file(&fixture.rollout_path).unwrap();
+    let before_index = source_snapshot(fixture.home.path());
+    let before_other = source_snapshot(other.path());
+    let turns = reader
+        .list_turns(turn_params(fixture.thread_id, None, 10))
+        .await
+        .unwrap();
+    assert_eq!(turn_ids(&turns), vec!["turn-1"]);
+    reader.close().await;
+    assert_source_unchanged(fixture.home.path(), &before_index);
+    assert_source_unchanged(other.path(), &before_other);
+}
