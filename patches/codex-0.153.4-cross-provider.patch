+#[test]
+/// Records a portable summary request's usage and running time as plain numbers that older
+/// readers ignore, and a malformed value never makes the summary unusable.
+fn portable_summary_usage_is_optional_and_lenient() -> Result<()> {
+    #[derive(Debug, Deserialize, PartialEq)]
+    struct OlderPortableCheckpoint {
+        summary: String,
+        status: PortableCheckpointStatus,
+        covers: PortableCoverage,
+    }
+
+    let usage = TokenUsage {
+        input_tokens: 227_000,
+        cached_input_tokens: 226_000,
+        cache_write_input_tokens: 1_000,
+        output_tokens: 900,
+        reasoning_output_tokens: 300,
+        total_tokens: 227_900,
+        codex_rollout_budget_units: None,
+    };
+    let portable = PortableCheckpoint {
+        summary: "plaintext summary".to_string(),
+        status: PortableCheckpointStatus::Ready,
+        covers: PortableCoverage::default(),
+        usage: Some(PortableSummaryUsage::from(&usage)),
+        elapsed_ms: Some(41_250),
+    };
+    let value = serde_json::to_value(&portable)?;
+    assert_eq!(
+        (&value["usage"], &value["elapsed_ms"]),
+        (
+            &json!({
+                "input_tokens": 227_000,
+                "cached_input_tokens": 226_000,
+                "output_tokens": 900,
+                "reasoning_output_tokens": 300,
+            }),
+            &json!(41_250)
+        )
+    );
+    assert_eq!(
+        serde_json::from_value::<PortableCheckpoint>(value.clone())?,
+        portable
+    );
+    // Runtimes that predate the fields read the rest of the summary.
+    assert_eq!(
+        serde_json::from_value::<OlderPortableCheckpoint>(value)?,
+        OlderPortableCheckpoint {
+            summary: "plaintext summary".to_string(),
+            status: PortableCheckpointStatus::Ready,
+            covers: PortableCoverage::default(),
+        }
+    );
+
+    // Absent values are not written, and a missing count reads as zero. A request that ran out
+    // of time records how long it ran without any usage.
+    let without = serde_json::to_value(PortableCheckpoint {
+        usage: None,
+        elapsed_ms: None,
+        ..portable
+    })?;
+    assert_eq!(
+        (without.get("usage"), without.get("elapsed_ms")),
+        (None, None)
+    );
+    let timed_out = PortableCheckpoint {
+        summary: String::new(),
+        status: PortableCheckpointStatus::Failed {
+            reason: "the summary did not finish in time after compaction".to_string(),
+        },
+        covers: PortableCoverage::default(),
+        usage: None,
+        elapsed_ms: Some(166_000),
+    };
+    let timed_out_value = serde_json::to_value(&timed_out)?;
+    assert_eq!(
+        (
+            timed_out_value.get("usage"),
+            timed_out_value.get("elapsed_ms")
+        ),
+        (None, Some(&json!(166_000)))
+    );
+    assert_eq!(
+        serde_json::from_value::<PortableCheckpoint>(timed_out_value)?,
+        timed_out
+    );
+    let partial = serde_json::from_value::<PortableCheckpoint>(json!({
+        "summary": "s",
+        "status": {"state": "ready"},
+        "usage": {"input_tokens": 10},
+    }))?;
+    assert_eq!(
+        (partial.usage, partial.elapsed_ms),
+        (
+            Some(PortableSummaryUsage {
+                input_tokens: 10,
+                ..Default::default()
+            }),
+            None
+        )
+    );
