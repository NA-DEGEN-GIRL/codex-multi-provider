+use super::*;
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+
+fn fixture(home: &Path) -> ManagedAuthority {
+    let owner = ThreadId::new().to_string();
+    let source = ManagedSourceId {
+        host_id: "local".to_string(),
+        store_id: format!("manager:{owner}"),
+    };
+    std::fs::write(
+        home.join("managed-source.json"),
+        serde_json::to_vec(&source).expect("marker"),
+    )
+    .expect("source marker");
+    ManagedAuthority::from_grant(
+        home,
+        &source,
+        ThreadId::new(),
+        &ManagedAuthorityGrant {
+            owner_profile_id: owner,
+            epoch: 1,
+            revision: 1,
+        },
+    )
+    .expect("authority")
+}
+
+#[test]
+fn outstanding_write_guards_prevent_manager_cas_across_independent_bindings() {
+    let home = TempDir::new().expect("home");
+    let authority = fixture(home.path());
+    authority.create_new().expect("initial authority");
+    let first = authority.write_guard().expect("first binding write");
+    let second = authority.write_guard().expect("independent binding write");
+    let manager = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(authority.path.with_extension("guard"))
+        .expect("manager guard");
+    assert!(matches!(
+        manager.try_lock(),
+        Err(std::fs::TryLockError::WouldBlock)
+    ));
+    drop(first);
+    assert!(matches!(
+        manager.try_lock(),
+        Err(std::fs::TryLockError::WouldBlock)
+    ));
+    drop(second);
+    manager
+        .try_lock()
+        .expect("CAS after all admitted writes finish");
+    assert!(authority.write_guard().is_err());
+}
+
+#[test]
+fn marker_changes_after_binding_revoke_future_write_guards() {
+    let home = TempDir::new().expect("home");
+    let authority = fixture(home.path());
+    authority.create_new().expect("grant");
+    drop(authority.write_guard().expect("original marker"));
+    std::fs::write(
+        home.path().join("managed-source.json"),
+        br#"{"host_id":"local","store_id":"manager:changed"}"#,
+    )
+    .expect("changed marker");
+    assert!(authority.write_guard().is_err());
+    std::fs::remove_file(home.path().join("managed-source.json")).expect("removed marker");
+    assert!(authority.write_guard().is_err());
+}
+
+#[test]
+fn initial_authority_publishes_once_and_cannot_overwrite_a_transferred_record() {
+    let home = TempDir::new().expect("home");
+    let authority = fixture(home.path());
+    assert!(authority.validate().is_err());
+    authority.create_new().expect("initial grant");
+    assert_eq!(
+        ManagedAuthority::read(&authority.path).expect("durable record"),
+        authority.expected
+    );
+    let mut transferred = authority.expected.clone();
+    transferred.owner_profile_id = ThreadId::new().to_string();
+    transferred.epoch += 1;
+    transferred.revision += 1;
+    std::fs::write(
+        &authority.path,
+        serde_json::to_vec(&transferred).expect("record"),
+    )
+    .expect("transfer");
+    assert!(authority.validate().is_err());
+    assert!(authority.create_new().is_err());
+    assert_eq!(
+        ManagedAuthority::read(&authority.path).expect("preserved grant"),
+        transferred
+    );
+}
+
+#[test]
+fn concurrent_native_creation_has_one_complete_winner() {
+    let home = TempDir::new().expect("home");
+    let authority = fixture(home.path());
+    #[expect(
+        clippy::needless_collect,
+        reason = "spawn every competing writer before joining any worker"
+    )]
+    let workers = (0..8)
+        .map(|_| {
+            let authority = authority.clone();
+            std::thread::spawn(move || authority.create_new().is_ok())
+        })
+        .collect::<Vec<_>>();
+    let wins = workers
+        .into_iter()
+        .map(|worker| usize::from(worker.join().expect("creator")))
+        .sum::<usize>();
+    assert_eq!(wins, 1);
+    authority.validate().expect("fully published winner");
+}
+
+#[test]
+fn interrupted_creation_lock_is_never_stolen_by_time_or_retries() {
+    let home = TempDir::new().expect("home");
+    let authority = fixture(home.path());
+    let lock = authority.path.with_extension("lock");
+    std::fs::create_dir_all(&lock).expect("interrupted lock");
+    assert!(authority.create_new().is_err());
+    assert!(authority.create_new().is_err());
+    assert!(lock.is_dir());
+    assert!(!authority.path.exists());
+}
+
+#[test]
+fn returned_owner_still_requires_fresh_epoch_and_revision() {
+    let home = TempDir::new().expect("home");
+    let authority = fixture(home.path());
+    authority.create_new().expect("grant");
+    let mut returned = authority.expected.clone();
+    returned.epoch = 3;
+    returned.revision = 3;
+    std::fs::write(
+        &authority.path,
+        serde_json::to_vec(&returned).expect("returned"),
+    )
+    .expect("transfer back");
+    assert!(authority.validate().is_err());
+    let fresh = ManagedAuthority {
+        path: authority.path,
+        expected: returned,
+    };
+    fresh.validate().expect("fresh grant");
+}
+
+#[test]
+fn malformed_or_oversized_authority_fails_closed() {
+    let home = TempDir::new().expect("home");
+    let authority = fixture(home.path());
+    authority.create_new().expect("grant");
+    std::fs::write(&authority.path, b"{\"version\":1}").expect("partial record");
+    assert!(authority.validate().is_err());
+    std::fs::write(
+        &authority.path,
+        vec![b' '; MAX_AUTHORITY_BYTES as usize + 1],
+    )
+    .expect("oversized record");
+    assert!(authority.validate().is_err());
+}
