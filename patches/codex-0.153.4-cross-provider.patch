+            text: message.to_string(),
+            text_elements: Vec::new(),
+        }],
+        ..Default::default()
+    }
+}
+
+#[tokio::test]
+async fn managed_close_claims_dormant_v2_child_without_loading_it_or_changing_history() -> Result<()>
+{
+    let fixture = ColdTreeFixture::new().await?;
+    let mut app = fixture.resume_root().await?;
+    let history_before = fs::read(&fixture.child_rollout)?;
+    let graph_before = fixture.open_children().await?;
+    assert_eq!(
+        graph_before,
+        vec![ThreadId::from_string(&fixture.child_id)?]
+    );
+    let requests_before = fixture.model_request_count().await?;
+
+    let request_id = app
+        .send_raw_request(
+            "thread/managedCloseIdle",
+            Some(json!({ "threadId": fixture.root_id })),
+        )
+        .await?;
+    let proof: ThreadManagedCloseIdleResponse =
+        timeout(READ_TIMEOUT, app.read_response(request_id)).await??;
+    assert_eq!(
+        proof,
+        ThreadManagedCloseIdleResponse {
+            thread_id: fixture.root_id.clone(),
+            closed_thread_ids: vec![fixture.child_id.clone(), fixture.root_id.clone()],
+            writer_release_verified: true,
+        }
+    );
+    assert_eq!(loaded_ids(&mut app).await?, Vec::<String>::new());
+    assert_eq!(fs::read(&fixture.child_rollout)?, history_before);
+    assert_eq!(fixture.open_children().await?, graph_before);
+    assert_eq!(fixture.model_request_count().await?, requests_before);
+    assert!(
+        timeout(
+            Duration::from_millis(250),
+            app.read_stream_until_matching_notification(
+                "no cold worker actor started",
+                |notification| {
+                    notification.method == "thread/started"
+                        && notification
+                            .params
+                            .as_ref()
+                            .is_some_and(|params| params["thread"]["id"] == fixture.child_id)
+                }
+            ),
+        )
+        .await
+        .is_err()
+    );
+    Ok(())
+}
