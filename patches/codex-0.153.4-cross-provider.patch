+#[tokio::test]
+async fn cancelled_prepare_keeps_writer_until_owned_initializer_finishes() {
+    let (home, store, thread_id, rollout_path) = pending_store();
+    let original = std::fs::read(&rollout_path).expect("source bytes");
+    let release = Arc::new(Notify::new());
+    let initialize_release = Arc::clone(&release);
+    let (started_tx, started_rx) = oneshot::channel();
+    let (finished_tx, finished_rx) = oneshot::channel();
+    let preparing_store = store.clone();
+    let outer = tokio::spawn(async move {
+        preparing_store
+            .prepare_managed_writer_with_init(thread_id, move |store| async move {
+                started_tx.send(()).expect("report owned initializer start");
+                initialize_release.notified().await;
+                store.initialize_managed_state_db().await?;
+                finished_tx.send(()).expect("report initializer completion");
+                Ok(())
+            })
+            .await
+    });
+    tokio::time::timeout(Duration::from_secs(10), started_rx)
+        .await
+        .expect("initializer starts")
+        .expect("initializer start signal");
+    outer.abort();
+    assert!(
+        outer
+            .await
+            .expect_err("outer await cancelled")
+            .is_cancelled()
+    );
+
+    let competing = LocalThreadStore::new(test_config(home.path()), /*state_db*/ None);
+    assert!(matches!(
+        competing.writer_lock_coordinator.acquire(thread_id),
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(store.state_db().await.is_none());
+    assert_eq!(
+        std::fs::read(&rollout_path).expect("source bytes"),
+        original
+    );
+
+    release.notify_one();
+    tokio::time::timeout(Duration::from_secs(30), finished_rx)
+        .await
+        .expect("owned initializer finishes despite caller cancellation")
+        .expect("initializer completion signal");
+    let _writer = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            match competing.writer_lock_coordinator.acquire(thread_id) {
+                Ok(writer) => break writer,
+                Err(ThreadStoreError::Conflict { .. }) => tokio::task::yield_now().await,
+                Err(error) => panic!("unexpected lock acquisition failure: {error}"),
+            }
+        }
+    })
+    .await
+    .expect("completed detached preparation releases its reservation");
+    assert!(store.state_db().await.is_some());
+    assert_eq!(std::fs::read(rollout_path).expect("source bytes"), original);
+    close_state_db(&store).await;
+}
