+
+fn message(role: &str, text: &str) -> ResponseItem {
+    let content = if role == "assistant" {
+        ContentItem::OutputText {
+            text: text.to_string(),
+        }
+    } else {
+        ContentItem::InputText {
+            text: text.to_string(),
+        }
+    };
+    ResponseItem::Message {
+        id: None,
+        role: role.to_string(),
+        content: vec![content],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    }
+}
+
+fn encrypted_reasoning(state: &str) -> ResponseItem {
+    serde_json::from_value(json!({
+        "type": "reasoning",
+        "summary": [],
+        "encrypted_content": state,
+    }))
+    .expect("reasoning item")
+}
+
+fn tool_output(call_id: &str, output: &str) -> ResponseItem {
+    serde_json::from_value(json!({
+        "type": "function_call_output",
+        "call_id": call_id,
+        "output": output,
+    }))
+    .expect("function call output")
+}
+
+fn record(item: ResponseItem) -> RolloutItem {
+    RolloutItem::ResponseItem(ResponseItemEnvelope::new(item))
+}
+
+/// The context bundle a full context injection records.
+fn bundle() -> RolloutItem {
+    record(message(
+        "developer",
+        "<permissions instructions>read-only</permissions instructions>",
+    ))
+}
+
+fn world_state() -> Map<String, Value> {
+    Map::from_iter([("model".to_string(), json!(GPT_MODEL))])
+}
+
+/// A thread that started on GPT: its bundle, a turn with encrypted reasoning and a large tool
+/// output, and a second turn.
+fn gpt_turns() -> Vec<RolloutItem> {
+    vec![
+        RolloutItem::TurnContext(turn_context(GPT_MODEL, "openai")),
+        bundle(),
+        record(message("user", "gpt first question")),
+        record(encrypted_reasoning("GPT_REASONING")),
+        record(tool_output("call-1", &"output ".repeat(6_000))),
+        record(message("assistant", "gpt first answer")),
+        record(message("user", "gpt second question")),
+        record(message("assistant", "gpt second answer")),
+    ]
+}
+
+/// GPT's context as its replay installs it.
+fn gpt_replay(transcript: &ModelTranscript, policy: TruncationPolicy) -> Vec<ResponseItemEnvelope> {
+    render(None, &transcript.items, policy)
+}
+
+/// DeepSeek takes over: its rebuilt checkpoint records GPT's anchor, then its bundle (recorded
+/// before its turn context, as a full injection does) and a turn.
+fn thread_back_on_gpt(
+    config: &Config,
+    mut records: Vec<RolloutItem>,
+    anchor_policy: TruncationPolicy,
+) -> (Vec<RolloutItem>, ReturnAnchor) {
+    let transcript = transcript_from_rollout_items(&records);
+    let reference_context = turn_context(GPT_MODEL, "openai");
+    let anchor = return_anchor(
+        &transcript,
+        config,
+        &deepseek(),
+        LeavingContext {
+            family: OPENAI_PROVIDER_FAMILY,
+            history: &gpt_replay(&transcript, anchor_policy),
+            truncation_policy: anchor_policy,
+            reference_context: Some(&reference_context),
+            world_state: Some(world_state()),
+            request_head: Some("gpt-head".to_string()),
+        },
+    )
+    .expect("an anchor for GPT");
+    records.push(RolloutItem::Compacted(rebuilt_checkpoint(
+        DEEPSEEK,
+        vec![anchor.clone()],
+    )));
+    records.extend([
+        bundle(),
+        record(message(
+            "developer",
+            "<model_switch>\nDeepSeek instructions\n</model_switch>",
+        )),
+        RolloutItem::TurnContext(turn_context(DEEPSEEK_MODEL, DEEPSEEK)),
+        record(message("developer", "Keep answers short.")),
+        record(message("user", "deepseek question")),
+        record(message("assistant", "deepseek answer")),
+    ]);
+    (records, anchor)
+}
+
+fn rebuilt_checkpoint(family: &str, return_anchors: Vec<ReturnAnchor>) -> CompactedItem {
+    checkpoint(
+        family,
+        CheckpointKind::Rebuilt {
+            from_family: OPENAI_PROVIDER_FAMILY.to_string(),
+            spliced: None,
+            return_anchors,
+        },
+        vec![ResponseItemEnvelope::new(message(
+            "user",
+            "DeepSeek's rebuilt view",
+        ))],
+    )
+}
+
+fn checkpoint(
+    family: &str,
+    kind: CheckpointKind,
+    replacement: Vec<ResponseItemEnvelope>,
+) -> CompactedItem {
+    CompactedItem {
+        message: String::new(),
+        replacement_history: Some(replacement),
+        guardian_history: None,
+        mcp_resource_origins: None,
+        window_number: None,
+        first_window_id: None,
+        previous_window_id: None,
+        window_id: None,
+        compaction_response_id: None,
+        latest_token_usage_record: None,
+        origin: Some(CompactionOrigin {
+            provider_family: family.to_string(),
+            provider_id: family.to_string(),
+            model: String::new(),
+            kind,
+        }),
+        portable: None,
+    }
+}
+
+fn splice_for_gpt(
+    config: &Config,
+    records: &[RolloutItem],
+) -> Result<super::SplicedContext, super::SpliceMiss> {
+    splice_context(
+        &transcript_from_rollout_items(records),
+        config,
+        &gpt(),
+        POLICY,
+        SplicePolicy::UpTo(i64::MAX),
+    )
+}
