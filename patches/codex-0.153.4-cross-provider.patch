+#[test]
+fn plaintext_reasoning_preserves_summary_and_all_text_parts() {
+    let original = ResponseItem::Reasoning {
+        id: None,
+        summary: vec![ReasoningItemReasoningSummary::SummaryText {
+            text: "Summary".to_string(),
+        }],
+        content: Some(vec![
+            ReasoningItemContent::ReasoningText {
+                text: "First".to_string(),
+            },
+            ReasoningItemContent::Text {
+                text: "Second".to_string(),
+            },
+        ]),
+        encrypted_content: None,
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let mut items = vec![original];
+    crate::client_common::normalize_plaintext_reasoning_for_openai(&mut items);
+    assert_eq!(
+        items,
+        vec![ResponseItem::Message {
+            id: None,
+            role: "assistant".to_string(),
+            content: ["Summary", "First", "Second"]
+                .into_iter()
+                .map(|text| ContentItem::OutputText {
+                    text: text.to_string(),
+                })
+                .collect(),
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }]
+    );
+    let normalized = items.clone();
+    crate::client_common::normalize_plaintext_reasoning_for_openai(&mut items);
+    assert_eq!(items, normalized);
+}
