+async fn plaintext_claude_turn_preserves_api_provider_baseline_and_portable_history() {
+    let (session, ctx) = make_session_and_context().await;
+    let mut gpt = ctx.to_turn_context_item();
+    gpt.turn_id = Some("gpt-turn".into());
+    gpt.model_provider = Some("openai".into());
+    let mut claude = gpt.clone();
+    claude.turn_id = Some("claude-turn".into());
+    claude.model = "cc-opus".into();
+    claude.model_provider = Some("claude_code".into());
+    claude.transcript = Some(codex_protocol::protocol::TranscriptKind::Plaintext);
+    let mut records = completed_user_turn_rollout(
+        gpt.clone(),
+        vec![RolloutItem::ResponseItem(user_message("start").into())],
+    );
+    records.extend(completed_user_turn_rollout(
+        claude,
+        vec![RolloutItem::ResponseItem(
+            assistant_message("portable Claude reply").into(),
+        )],
+    ));
+    let reconstructed = session
+        .reconstruct_history_from_rollout(&ctx, &records)
+        .await;
+    assert_eq!(reconstructed.reference_context_item, Some(gpt));
+    assert!(
+        reconstructed
+            .history
+            .iter()
+            .any(|item| item.item == assistant_message("portable Claude reply"))
+    );
+    let target = crate::portable_context::TargetProvider {
+        family: "openai".into(),
+        model: ctx.model_info().slug.clone(),
+    };
+    let provenance = crate::portable_context::replay_provenance(&ctx.config, &records, &target);
+    assert_eq!(provenance.changed_family(&target), None);
+    assert!(provenance.other_family_seen);
+}
