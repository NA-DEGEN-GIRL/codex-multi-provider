+
+fn registration(home: &Path, source_id: &ManagedSourceId) -> ManagedSourceRegistration {
+    ManagedSourceRegistration {
+        source_id: source_id.clone(),
+        config: LocalThreadStoreConfig {
+            codex_home: home.to_path_buf(),
+            sqlite: codex_state::SqliteConfig::new_for_testing(
+                AbsolutePathBuf::try_from(home.to_path_buf()).expect("absolute managed home"),
+            ),
+            default_model_provider_id: "openai".to_string(),
+        },
+    }
+}
+
+impl ActivationFixture {
+    async fn new() -> Self {
+        let home = TempDir::new().expect("temporary managed homes");
+        let source_home = home.path().join("source");
+        let target_home = home.path().join("target");
+        let source_id = ManagedSourceId {
+            host_id: "local".to_string(),
+            store_id: format!("manager:{}", ThreadId::new()),
+        };
+        let profile_id = ThreadId::new().to_string();
+        let target_id = ManagedSourceId {
+            host_id: "local".to_string(),
+            store_id: format!("manager:{profile_id}"),
+        };
+        for (path, id) in [(&source_home, &source_id), (&target_home, &target_id)] {
+            std::fs::create_dir_all(path).expect("managed home");
+            std::fs::write(
+                path.join("managed-source.json"),
+                serde_json::to_vec(id).expect("source marker"),
+            )
+            .expect("write source marker");
+        }
+        let registry = ManagedSourceRegistry::new(
+            "local".to_string(),
+            profile_id.clone(),
+            vec![
+                registration(&source_home, &source_id),
+                registration(&target_home, &target_id),
+            ],
+        )
+        .expect("allowlist both canonical sources");
+        let source_state = codex_state::StateRuntime::init(
+            registration(&source_home, &source_id).config.sqlite,
+            "openai".to_string(),
+        )
+        .await
+        .expect("source database");
+        let target_state = codex_state::StateRuntime::init(
+            registration(&target_home, &target_id).config.sqlite,
+            "openai".to_string(),
+        )
+        .await
+        .expect("target database");
+        let mut config = test_config().await;
+        config.codex_home = AbsolutePathBuf::try_from(target_home.clone()).expect("target home");
+        let manager = ThreadManager::with_models_provider_home_and_state_for_tests(
+            CodexAuth::from_api_key("dummy"),
+            config.model_provider.clone(),
+            target_home.clone(),
+            Arc::new(EnvironmentManager::default_for_tests()),
+            Some(Arc::clone(&target_state)),
+        );
+        Self {
+            manager,
+            registry,
+            source_id,
+            target_id,
+            source_home,
+            target_home,
+            profile_id,
+            root: ThreadId::new(),
+            source_graph: LocalAgentGraphStore::new(source_state),
+            target_graph: LocalAgentGraphStore::new(target_state),
+            config,
+            _home: home,
+        }
+    }
+
+    fn grant(&self, epoch: u64) -> ManagedAuthorityGrant {
+        ManagedAuthorityGrant {
+            owner_profile_id: self.profile_id.clone(),
+            epoch,
+            revision: epoch,
+        }
+    }
+
+    fn publish_authority(
+        &self,
+        source_id: &ManagedSourceId,
+        thread_id: ThreadId,
+        grant: &ManagedAuthorityGrant,
+    ) {
+        let source_home = if source_id == &self.source_id {
+            &self.source_home
+        } else {
+            assert_eq!(source_id, &self.target_id);
+            &self.target_home
+        };
+        let directory = source_home.join("managed-authority");
+        std::fs::create_dir_all(&directory).expect("authority directory");
+        std::fs::write(
+            directory.join(format!("{thread_id}.json")),
+            serde_json::to_vec(&serde_json::json!({
+                "version": 1,
+                "host_id": source_id.host_id,
+                "store_id": source_id.store_id,
+                "thread_id": thread_id,
+                "owner_profile_id": grant.owner_profile_id,
+                "epoch": grant.epoch,
+                "revision": grant.revision,
+            }))
+            .expect("authority record"),
+        )
+        .expect("publish fixture authority");
+    }
+
+    async fn binding(&self, thread_id: ThreadId) -> ManagedThreadBinding {
+        let grant = self.grant(/*epoch*/ 1);
+        self.publish_authority(&self.source_id, thread_id, &grant);
+        self.registry
+            .bind(&self.source_id, thread_id, grant)
+            .await
+            .expect("canonical source binding")
+    }
+
+    async fn seed_root(&self) -> ManagedThreadBinding {
+        let binding = self.binding(self.root).await;
+        let reservation = binding
+            .prepare_writer()
+            .await
+            .expect("reserve seed writer before mutable state initialization");
+        let live = LiveThread::create(
+            binding.store(),
+            CreateThreadParams {
+                session_id: self.root.into(),
+                thread_id: self.root,
+                extra_config: None,
+                forked_from_id: None,
+                parent_thread_id: None,
+                source: SessionSource::Exec,
+                thread_source: None,
+                originator: "managed-activation-test".to_string(),
+                base_instructions: BaseInstructions::default(),
+                dynamic_tools: Vec::new(),
+                selected_capability_roots: Vec::new(),
+                multi_agent_version: None,
+                history_mode: ThreadHistoryMode::Paginated,
+                history_base: None,
+                subagent_history_start_ordinal: None,
+                initial_window_id: "test-window".to_string(),
+                metadata: ThreadPersistenceMetadata {
+                    cwd: Some(self.source_home.clone()),
+                    model_provider: "openai".to_string(),
+                    memory_mode: ThreadMemoryMode::Disabled,
+                },
+            },
+        )
+        .await
+        .expect("canonical root writer");
+        drop(reservation);
+        live.persist(PersistContext::Standard)
+            .await
+            .expect("persist canonical root");
+        live.shutdown().await.expect("release seed writer");
+        self.registry
+            .bind(&self.source_id, self.root, self.grant(/*epoch*/ 1))
+            .await
+            .expect("dormant owner binding")
+    }
+
+    async fn bindings(&self) -> Vec<(String, ManagedSourceId, ManagedAuthorityGrant, usize)> {
+        let bindings = self.manager.state.managed_record_bindings.read().await;
+        let mut snapshot: Vec<_> = bindings
+            .iter()
+            .map(|(id, binding)| {
+                (
+                    id.to_string(),
+                    binding.source_id().clone(),
+                    binding.authority_grant().clone(),
+                    Arc::as_ptr(&binding.store()) as usize,
+                )
+            })
+            .collect();
+        snapshot.sort_by(|left, right| left.0.cmp(&right.0));
+        snapshot
+    }
+}
