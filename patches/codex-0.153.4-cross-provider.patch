+use super::*;
+use codex_tools::ResponsesApiNamespace;
+use pretty_assertions::assert_eq;
+
+fn tool(name: &str) -> ResponsesApiTool {
+    ResponsesApiTool {
+        name: name.into(), description: format!("Native {name}"), strict: false,
+        defer_loading: None, output_schema: None,
+        parameters: serde_json::from_value(json!({"type":"object","properties":{"target":{"type":"string"}},"required":["target"]})).unwrap(),
+    }
+}
+
+#[test]
+fn projects_only_the_configured_native_namespace_and_preserves_schema() {
+    let accepted = tool("send_message");
+    let specs = vec![
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: "foreign".into(),
+            description: String::new(),
+            tools: vec![ResponsesApiNamespaceTool::Function(tool("spawn_agent"))],
+        }),
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: "collaboration".into(),
+            description: String::new(),
+            tools: vec![
+                ResponsesApiNamespaceTool::Function(accepted.clone()),
+                ResponsesApiNamespaceTool::Function(tool("exec_command")),
+            ],
+        }),
+    ];
+    let (names, actual) = catalog(&specs, Some("collaboration"));
+    assert_eq!(
+        names,
+        BTreeMap::from([(
+            "send_message".into(),
+            ToolName::new(Some("collaboration".into()), "send_message")
+        )])
+    );
+    assert_eq!(
+        actual,
+        vec![
+            json!({"name":accepted.name,"description":accepted.description,"inputSchema":accepted.parameters})
+        ]
+    );
+    assert_eq!(catalog(&specs, None), (BTreeMap::new(), Vec::new()));
+}
+
+#[test]
+fn typed_requests_reject_identity_and_dispatch_overrides() {
+    let valid = json!({"type":"agent_request","id":"5d2f8c2e-a4a6-4abc-aa09-fd7c0721d3a3","name":"spawn_agent","arguments":{"task_name":"review","message":"Review this."}});
+    assert!(serde_json::from_value::<Request>(valid.clone()).is_ok());
+    let mut override_parent = valid.clone();
+    override_parent["parent_id"] = json!("another-task");
+    assert!(serde_json::from_value::<Request>(override_parent).is_err());
+    let mut invalid_arguments = valid;
+    invalid_arguments["arguments"] = json!([]);
+    assert!(serde_json::from_value::<Request>(invalid_arguments).is_err());
+}
+
+#[test]
+fn result_projection_is_utf8_safe_and_bounded_even_after_json_escaping() {
+    let normal = json!({"agent_id":"child","status":"completed"});
+    assert_eq!(bounded_result(normal.clone()), normal);
+    for text in ["가".repeat(9000), "\"\\\n".repeat(9000)] {
+        let bounded = bounded_result(json!({"result":text}));
+        assert_eq!(bounded["truncated"], json!(true));
+        assert!(bounded.to_string().len() <= MAX_RESULT_BYTES);
+    }
+}
