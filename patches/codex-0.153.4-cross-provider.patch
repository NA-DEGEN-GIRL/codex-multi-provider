+async fn paginated_fixture() -> PaginatedFixture {
+    let home = TempDir::new().expect("temp dir");
+    let config = test_config(home.path());
+    let state = codex_state::StateRuntime::init(
+        config.sqlite.clone(),
+        config.default_model_provider_id.clone(),
+    )
+    .await
+    .expect("initialize source state");
+    let store = LocalThreadStore::new(config, Some(Arc::clone(&state)));
+    let thread_id = ThreadId::new();
+    store
+        .create_thread(create_params(home.path(), thread_id))
+        .await
+        .expect("create paginated source");
+    store
+        .append_items(AppendThreadItemsParams {
+            thread_id,
+            items: ["turn-1", "turn-2"]
+                .into_iter()
+                .flat_map(|turn_id| completed_turn(thread_id, turn_id))
+                .collect(),
+        })
+        .await
+        .expect("append fixture turns");
+    store
+        .persist_thread(thread_id, PersistContext::Standard)
+        .await
+        .expect("persist fixture");
+    store.flush_thread(thread_id).await.expect("flush fixture");
+    let rollout_path = store
+        .live_rollout_path(thread_id)
+        .await
+        .expect("fixture rollout");
+    store
+        .shutdown_thread(thread_id)
+        .await
+        .expect("close source writer");
+    codex_rollout::state_db::reconcile_rollout(
+        Some(state.as_ref()),
+        rollout_path.as_path(),
+        "test-provider",
+        None,
+        &[],
+        Some(false),
+        None,
+    )
+    .await;
+    assert!(
+        state
+            .get_thread(thread_id)
+            .await
+            .expect("verify fixture metadata")
+            .is_some()
+    );
+    PaginatedFixture {
+        home,
+        store,
+        state,
+        thread_id,
+        rollout_path,
+    }
+}
