+use super::*;
+use crate::outgoing_message::ConnectionId;
+use crate::outgoing_message::OutgoingMessageSender;
+use crate::outgoing_message::RequestContext;
+use codex_analytics::AnalyticsEventsClient;
+use codex_app_server_protocol::RequestId;
+use pretty_assertions::assert_eq;
+use tokio::sync::mpsc;
+
+fn request(connection: u64) -> ConnectionRequestId {
+    ConnectionRequestId {
+        connection_id: ConnectionId(connection),
+        request_id: RequestId::Integer(7),
+    }
+}
+
+#[tokio::test]
+async fn disconnect_keeps_deferred_work_until_its_actual_response() {
+    let (tx, _rx) = mpsc::channel(8);
+    let outgoing = OutgoingMessageSender::new(tx, AnalyticsEventsClient::disabled());
+    let id = request(1);
+    let context = RequestContext::new(
+        id.clone(),
+        tracing::Span::none(),
+        /*parent_trace*/ None,
+    );
+    context
+        .track_managed_activity(&outgoing.managed_activity)
+        .unwrap();
+    outgoing.register_request_context(context.clone()).await;
+    drop(context);
+    outgoing.connection_closed(id.connection_id).await;
+    assert_eq!(
+        outgoing
+            .managed_activity
+            .state
+            .lock()
+            .unwrap()
+            .requests
+            .len(),
+        1
+    );
+    outgoing
+        .send_error(
+            id,
+            invalid_request("deferred operation completed with an error"),
+        )
+        .await;
+    assert!(
+        outgoing
+            .managed_activity
+            .state
+            .lock()
+            .unwrap()
+            .requests
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn response_does_not_hide_a_handler_still_using_its_context() {
+    let (tx, _rx) = mpsc::channel(8);
+    let outgoing = OutgoingMessageSender::new(tx, AnalyticsEventsClient::disabled());
+    let id = request(1);
+    let context = RequestContext::new(
+        id.clone(),
+        tracing::Span::none(),
+        /*parent_trace*/ None,
+    );
+    context
+        .track_managed_activity(&outgoing.managed_activity)
+        .unwrap();
+    outgoing.register_request_context(context.clone()).await;
+    outgoing
+        .send_error(id, invalid_request("finished response"))
+        .await;
+    assert_eq!(
+        outgoing
+            .managed_activity
+            .state
+            .lock()
+            .unwrap()
+            .requests
+            .len(),
+        1
+    );
+    drop(context);
+    assert!(
+        outgoing
+            .managed_activity
+            .state
+            .lock()
+            .unwrap()
+            .requests
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn duplicate_admission_error_preserves_original_and_other_connection_work() {
+    let (tx, _rx) = mpsc::channel(8);
+    let outgoing = OutgoingMessageSender::new(tx, AnalyticsEventsClient::disabled());
+    let first = outgoing.managed_activity.begin_request(request(1)).unwrap();
+    let other = outgoing.managed_activity.begin_request(request(2)).unwrap();
+    let error = match outgoing.managed_activity.begin_request(request(1)) {
+        Err(error) => error,
+        Ok(_) => panic!("duplicate request must be rejected"),
+    };
+    outgoing.send_admission_error(request(1), error).await;
+    assert_eq!(
+        outgoing
+            .managed_activity
+            .state
+            .lock()
+            .unwrap()
+            .requests
+            .len(),
+        2
+    );
+    drop(first);
+    drop(other);
+    // Cancellation or disconnect alone is not completion evidence.
+    assert_eq!(
+        outgoing
+            .managed_activity
+            .state
+            .lock()
+            .unwrap()
+            .requests
+            .len(),
+        2
+    );
+    outgoing.managed_activity.response_finished(&request(1));
+    assert_eq!(
+        outgoing
+            .managed_activity
+            .state
+            .lock()
+            .unwrap()
+            .requests
+            .len(),
+        1
+    );
+    outgoing.managed_activity.response_finished(&request(2));
+    assert!(
+        outgoing
+            .managed_activity
+            .state
+            .lock()
+            .unwrap()
+            .requests
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn process_activity_outlives_its_start_response_and_connection() {
+    let activity = ManagedInstanceActivity::default();
+    let handler = activity.begin_request(request(1)).unwrap();
+    let process = activity.begin_process().unwrap();
+    let (finished_tx, finished_rx) = tokio::sync::oneshot::channel();
+    let worker = tokio::spawn(async move {
+        let _process = process;
+        finished_rx.await.unwrap();
+    });
+    activity.response_finished(&request(1));
+    drop(handler);
+    {
+        let state = activity.state.lock().unwrap();
+        assert_eq!((state.requests.len(), state.processes), (0, 1));
+    }
+    finished_tx.send(()).unwrap();
+    worker.await.unwrap();
+    assert_eq!(activity.state.lock().unwrap().processes, 0);
+}
+
+#[test]
+fn acknowledged_background_operations_count_until_completion_or_cancellation() {
+    let activity = ManagedInstanceActivity::default();
+    let request_handler = activity.begin_request(request(1)).unwrap();
+    let login = activity
+        .begin_background(ManagedBackgroundKind::Login)
+        .unwrap();
+    let setup = activity
+        .begin_background(ManagedBackgroundKind::SandboxSetup)
+        .unwrap();
+    activity.response_finished(&request(1));
+    drop(request_handler);
+    {
+        let state = activity.state.lock().unwrap();
+        assert_eq!(
+            (
+                state.requests.len(),
+                state.background.values().sum::<usize>()
+            ),
+            (0, 2)
+        );
+    }
+    drop(login);
+    {
+        let state = activity.state.lock().unwrap();
+        assert_eq!(
+            (
+                state.background[&ManagedBackgroundKind::Login],
+                state.background[&ManagedBackgroundKind::SandboxSetup]
+            ),
+            (0, 1)
+        );
+    }
+    drop(setup);
+    assert_eq!(
+        activity
+            .state
+            .lock()
+            .unwrap()
+            .background
+            .values()
+            .sum::<usize>(),
+        0
+    );
+}
+
+#[test]
+fn pending_limits_and_instance_isolation_preserve_existing_work() {
+    let activity = ManagedInstanceActivity::default();
+    let other_instance = ManagedInstanceActivity::default();
+    let handlers: Vec<_> = (0..MAX_PENDING as u64)
+        .map(|connection| activity.begin_request(request(connection)).unwrap())
+        .collect();
+    assert!(activity.begin_request(request(MAX_PENDING as u64)).is_err());
+    let other = other_instance.begin_request(request(0)).unwrap();
+    drop(handlers);
+    assert_eq!(activity.state.lock().unwrap().requests.len(), MAX_PENDING);
+    for connection in 0..MAX_PENDING as u64 {
+        activity.response_finished(&request(connection));
+    }
+    assert!(activity.state.lock().unwrap().requests.is_empty());
+    assert_eq!(other_instance.state.lock().unwrap().requests.len(), 1);
+    other_instance.response_finished(&request(0));
+    drop(other);
+    assert!(other_instance.state.lock().unwrap().requests.is_empty());
+}
+
+#[test]
+fn maintenance_rejects_other_connection_work_and_restores_admission_on_abort() {
+    let activity = ManagedInstanceActivity::default();
+    let admin = activity.begin_request(request(1)).unwrap();
+    let peer = activity.begin_request(request(2)).unwrap();
+    assert!(activity.try_freeze(&request(1)).is_err());
+    drop(peer);
+    assert!(activity.try_freeze(&request(1)).is_err());
+    activity.response_finished(&request(2));
+    let fence = activity.try_freeze(&request(1)).unwrap();
+    assert!(activity.begin_request(request(3)).is_err());
+    assert!(activity.begin_process().is_err());
+    assert!(
+        activity
+            .begin_background(ManagedBackgroundKind::Login)
+            .is_err()
+    );
+    assert!(activity.try_freeze(&request(1)).is_err());
+    drop(fence);
+    assert!(activity.begin_request(request(3)).is_ok());
+    drop(admin);
+}
+
+#[test]
+fn maintenance_waits_for_acknowledged_process_and_background_work() {
+    let activity = ManagedInstanceActivity::default();
+    let _admin = activity.begin_request(request(1)).unwrap();
+    let process = activity.begin_process().unwrap();
+    let login = activity
+        .begin_background(ManagedBackgroundKind::Login)
+        .unwrap();
+    let setup = activity
+        .begin_background(ManagedBackgroundKind::SandboxSetup)
+        .unwrap();
+    assert!(activity.try_freeze(&request(1)).is_err());
+    drop(process);
+    assert!(activity.try_freeze(&request(1)).is_err());
+    drop(login);
+    assert!(activity.try_freeze(&request(1)).is_err());
+    drop(setup);
+    let fence = activity.try_freeze(&request(1)).unwrap();
+    let other_instance = ManagedInstanceActivity::default();
+    assert!(other_instance.begin_request(request(2)).is_ok());
+    fence.commit();
+    assert!(activity.begin_request(request(2)).is_err());
+}
