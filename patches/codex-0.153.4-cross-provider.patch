+#[tokio::test]
+async fn independent_profiles_resume_one_canonical_record_and_fence_old_callbacks() {
+    let home = TempDir::new().expect("home");
+    let id = source_id();
+    std::fs::write(
+        home.path().join("managed-source.json"),
+        serde_json::to_vec(&id).expect("marker"),
+    )
+    .expect("write marker");
+    let first_registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        profile_id(&id),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("first registry");
+    let second_profile = ThreadId::new().to_string();
+    let second_registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        second_profile.clone(),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("second registry");
+    let thread_id = ThreadId::new();
+    let first = first_registry
+        .bind_new(&id, thread_id)
+        .await
+        .expect("first binding");
+    let first_live = LiveThread::create(first.store(), create_params(home.path(), thread_id))
+        .await
+        .expect("first owner");
+    first_live
+        .persist(PersistContext::Standard)
+        .await
+        .expect("persist canonical record");
+    first_live
+        .update_metadata(
+            ThreadMetadataPatch {
+                name: Some(Some("canonical task".to_string())),
+                ..Default::default()
+            },
+            /*include_archived*/ true,
+        )
+        .await
+        .expect("canonical name");
+    let original_path = first_live.local_rollout_path().await.expect("rollout path");
+    let second_grant = ManagedAuthorityGrant {
+        owner_profile_id: second_profile,
+        epoch: 2,
+        revision: 2,
+    };
+    assert!(
+        second_registry
+            .bind(&id, thread_id, second_grant.clone())
+            .await
+            .is_err()
+    );
+    let resume = || ResumeThreadParams {
+        thread_id,
+        rollout_path: None,
+        history: None,
+        include_archived: true,
+        metadata: metadata(home.path()),
+    };
+    let other_id = ThreadId::new();
+    let other = first_registry
+        .bind_new(&id, other_id)
+        .await
+        .expect("unrelated binding");
+    let other_live = LiveThread::create(other.store(), create_params(home.path(), other_id))
+        .await
+        .expect("unrelated writer");
+    other_live
+        .persist(PersistContext::Standard)
+        .await
+        .expect("unrelated persists");
+    first_live.shutdown().await.expect("release first writer");
+    advance_owner(home.path(), &id, thread_id, &second_grant);
+    let second = second_registry
+        .bind(&id, thread_id, second_grant)
+        .await
+        .expect("second binding");
+    assert!(
+        first_registry
+            .bind(&id, thread_id, first.authority_grant().clone())
+            .await
+            .is_err()
+    );
+    let second_live = resume_binding(&second, home.path()).await;
+    second_live
+        .update_metadata(
+            ThreadMetadataPatch {
+                name: Some(Some("continued task".to_string())),
+                ..Default::default()
+            },
+            /*include_archived*/ true,
+        )
+        .await
+        .expect("source metadata updated");
+    assert_eq!(
+        second_live.local_rollout_path().await.expect("same path"),
+        original_path
+    );
+    assert!(matches!(
+        first.write_permit().await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(matches!(
+        first
+            .store()
+            .update_thread_metadata(UpdateThreadMetadataParams {
+                thread_id,
+                patch: ThreadMetadataPatch {
+                    name: Some(Some("stale callback".to_string())),
+                    ..Default::default()
+                },
+                include_archived: true,
+            })
+            .await,
+        Err(ThreadStoreError::Conflict { .. }),
+    ));
+    assert!(matches!(
+        first.store().resume_thread(resume()).await,
+        Err(ThreadStoreError::Conflict { .. }),
+    ));
+    let stored = first
+        .store()
+        .read_thread(ReadThreadParams {
+            thread_id,
+            include_archived: true,
+            include_history: false,
+        })
+        .await
+        .expect("canonical read after handoff");
+    assert_eq!(
+        (stored.thread_id, stored.name),
+        (thread_id, Some("continued task".to_string()))
+    );
+    other_live
+        .flush()
+        .await
+        .expect("unrelated writer continues");
+    second_live.shutdown().await.expect("second release");
+    let returning_grant = ManagedAuthorityGrant {
+        owner_profile_id: profile_id(&id),
+        epoch: 3,
+        revision: 3,
+    };
+    advance_owner(home.path(), &id, thread_id, &returning_grant);
+    let returning = first_registry
+        .bind(&id, thread_id, returning_grant)
+        .await
+        .expect("fresh returning grant");
+    assert!(
+        first_registry
+            .bind(&id, thread_id, first.authority_grant().clone())
+            .await
+            .is_err()
+    );
+    assert!(
+        second_registry
+            .bind(&id, thread_id, second.authority_grant().clone())
+            .await
+            .is_err()
+    );
+    let returned_live = resume_binding(&returning, home.path()).await;
+    returned_live.shutdown().await.expect("returning release");
+    other_live.shutdown().await.expect("unrelated release");
+}
