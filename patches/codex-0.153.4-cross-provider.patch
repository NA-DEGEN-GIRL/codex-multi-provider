+/// Bodies smaller than this stay uncompressed so a small turn is byte-identical.
+const AUTO_COMPRESSION_MIN_BYTES: usize = 256 * 1024;
+
+/// A 4xx that names the request encoding is a compression rejection, not a
+/// conversation error, so exactly one uncompressed retry is allowed.
+fn is_encoding_rejection(error: &ApiError) -> bool {
+    let ApiError::Transport(TransportError::Http { status, body, .. }) = error else {
+        return false;
+    };
+    if !status.is_client_error() {
+        return false;
+    }
+    if status.as_u16() == 415 {
+        return true;
+    }
+    let Some(body) = body.as_deref() else {
+        return false;
+    };
+    let body = body.to_ascii_lowercase();
+    [
+        "content-encoding",
+        "content_encoding",
+        "encoding",
+        "compression",
+        "unsupported content",
+    ]
+    .iter()
+    .any(|needle| body.contains(needle))
+}
