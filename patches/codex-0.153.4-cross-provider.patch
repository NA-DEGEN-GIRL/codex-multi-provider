@@ -0,0 +1,63 @@
+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+use pretty_assertions::assert_eq;
+
+use super::WriterLifetime;
+
+struct Resource(Arc<AtomicUsize>);
+
+impl Drop for Resource {
+    fn drop(&mut self) {
+        self.0.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+#[tokio::test]
+async fn checked_stop_releases_resources_before_reporting_completion() {
+    let released = Arc::new(AtomicUsize::new(0));
+    let lifetime = Arc::new(WriterLifetime::new());
+    let actor = lifetime.actor_guard();
+    lifetime
+        .retain(Arc::new(Resource(Arc::clone(&released))))
+        .expect("retain writer resource");
+
+    assert_eq!(released.load(Ordering::SeqCst), 0);
+    actor.stopped();
+    lifetime.wait_stopped().await.expect("checked completion");
+    assert_eq!(released.load(Ordering::SeqCst), 1);
+    assert!(lifetime.retain(Arc::new(())).is_err());
+}
+
+#[test]
+fn dropping_recorder_handle_does_not_release_a_running_writer_resource() {
+    let released = Arc::new(AtomicUsize::new(0));
+    let lifetime = Arc::new(WriterLifetime::new());
+    let actor = lifetime.actor_guard();
+    lifetime
+        .retain(Arc::new(Resource(Arc::clone(&released))))
+        .expect("retain writer resource");
+
+    drop(lifetime);
+    assert_eq!(released.load(Ordering::SeqCst), 0);
+    actor.stopped();
+    assert_eq!(released.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn unchecked_actor_drop_reports_uncertainty_and_keeps_resources_fenced() {
+    let released = Arc::new(AtomicUsize::new(0));
+    let lifetime = Arc::new(WriterLifetime::new());
+    let actor = lifetime.actor_guard();
+    lifetime
+        .retain(Arc::new(Resource(Arc::clone(&released))))
+        .expect("retain writer resource");
+
+    drop(actor);
+    assert!(lifetime.wait_stopped().await.is_err());
+    assert!(lifetime.retain(Arc::new(())).is_err());
+    drop(lifetime);
+    // The production tombstone deliberately survives until process exit.
+    assert_eq!(released.load(Ordering::SeqCst), 0);
+}
