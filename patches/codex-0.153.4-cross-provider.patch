+/// A request's settings without its input and its per-request metadata.
+fn request_settings(body: &Value) -> Value {
+    let (_, mut settings) = split_input(body);
+    if let Some(settings) = settings.as_object_mut() {
+        settings.remove("client_metadata");
+    }
+    settings
+}
