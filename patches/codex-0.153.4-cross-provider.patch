+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+
+/// Request idle shutdown of an exact managed standalone process, across all connections.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ServerManagedShutdownParams {
+    pub process_id: u32,
+}
+
+/// Writer release and shutdown request acknowledgment. The caller must still
+/// verify the exact process exited and its profile lock was released.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ServerManagedShutdownResponse {
+    pub process_id: u32,
+    pub closed_thread_ids: Vec<String>,
+    pub shutdown_requested: bool,
+    pub writer_release_verified: bool,
+}
diff --git a/codex-rs/app-server-protocol/src/protocol/v2/managed_thread.rs b/codex-rs/app-server-protocol/src/protocol/v2/managed_thread.rs
