diff --git a/codex-rs/app-server/src/execution_preset_auth.rs b/codex-rs/app-server/src/execution_preset_auth.rs
new file mode 100644
index 000000000..5282dbc57
--- /dev/null
+++ b/codex-rs/app-server/src/execution_preset_auth.rs
@@ -0,0 +1,121 @@
+//! Connection-bound account borrowing for manager-prepared execution policies.
+
+use crate::outgoing_message::ConnectionId;
+use crate::outgoing_message::OutgoingMessageSender;
+use codex_app_server_protocol::ExecutionPresetAuthRefusal;
+use codex_app_server_protocol::ExecutionPresetAuthTokensReadParams;
+use codex_app_server_protocol::ExecutionPresetAuthTokensReadResponse;
+use codex_app_server_protocol::ServerRequestPayload;
+use codex_core::ExecutionPresetAuthResolver;
+use codex_login::ExternalAuthFuture;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+
+pub(crate) const CAPABILITY: &str = "codex-manager/execution-preset-auth";
+
+pub(crate) struct ManagedPresetAuth {
+    owner_profile_id: Option<String>,
+    connection: Mutex<Option<ConnectionId>>,
+    outgoing: Arc<OutgoingMessageSender>,
+}
+
+impl ManagedPresetAuth {
+    pub(crate) fn new(
+        owner_profile_id: Option<String>,
+        outgoing: Arc<OutgoingMessageSender>,
+    ) -> Self {
+        Self {
+            owner_profile_id,
+            connection: Mutex::new(None),
+            outgoing,
+        }
+    }
+
+    pub(crate) async fn register(
+        &self,
+        connection_id: ConnectionId,
+        capability: Option<&serde_json::Value>,
+    ) -> std::io::Result<()> {
+        let Some(capability) = capability else {
+            return Ok(());
+        };
+        let profile = capability
+            .as_object()
+            .filter(|fields| fields.len() == 1)
+            .and_then(|fields| fields.get("profileId"))
+            .and_then(serde_json::Value::as_str);
+        if self.owner_profile_id.as_deref().is_none() || profile != self.owner_profile_id.as_deref()
+        {
+            return Err(std::io::Error::other(
+                "managed credential capability owner does not match this runtime",
+            ));
+        }
+        let mut current = self.connection.lock().await;
+        if current.is_some_and(|id| id != connection_id) {
+            return Err(std::io::Error::other(
+                "managed credential transport is already connected",
+            ));
+        }
+        *current = Some(connection_id);
+        Ok(())
+    }
+
+    pub(crate) async fn disconnected(&self, connection_id: ConnectionId) {
+        let mut current = self.connection.lock().await;
+        if *current == Some(connection_id) {
+            *current = None;
+        }
+    }
+}
+
+impl ExecutionPresetAuthResolver for ManagedPresetAuth {
+    fn resolve(
+        &self,
+        request: ExecutionPresetAuthTokensReadParams,
+    ) -> ExternalAuthFuture<'_, ExecutionPresetAuthTokensReadResponse> {
+        Box::pin(async move {
+            let fail = || std::io::Error::other("managed credential transport is unavailable");
+            if Some(request.owner_profile_id.as_str()) != self.owner_profile_id.as_deref() {
+                return Err(fail());
+            }
+            let connection_id = (*self.connection.lock().await).ok_or_else(fail)?;
+            let (id, receiver) = self
+                .outgoing
+                .send_request_to_connections(
+                    Some(&[connection_id]),
+                    ServerRequestPayload::ExecutionPresetAuthTokensRead(request),
+                    None,
+                )
+                .await;
+            // Disconnect can race with enqueueing. Cancel any newly registered
+            // callback before waiting if its transport is no longer the owner.
+            if *self.connection.lock().await != Some(connection_id) {
+                self.outgoing.cancel_request(&id).await;
+                return Err(fail());
+            }
+            let result =
+                match tokio::time::timeout(std::time::Duration::from_secs(30), receiver).await {
+                    Ok(Ok(Ok(result))) => result,
+                    // Only a listed reason survives; the broker's message is never forwarded.
+                    Ok(Ok(Err(error))) => {
+                        return Err(ExecutionPresetAuthRefusal::from_error_data(
+                            error.data.as_ref(),
+                        )
+                        .map_or_else(fail, std::io::Error::other));
+                    }
+                    _ => {
+                        self.outgoing.cancel_request(&id).await;
+                        return Err(fail());
+                    }
+                };
+            if *self.connection.lock().await != Some(connection_id) {
+                return Err(fail());
+            }
+            serde_json::from_value(result).map_err(|_| fail())
+        })
+    }
+}
+
