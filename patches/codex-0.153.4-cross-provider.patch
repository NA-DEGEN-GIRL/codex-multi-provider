@@ -0,0 +1,119 @@
+use super::*;
+use codex_protocol::protocol::AgentStatus;
+use pretty_assertions::assert_eq;
+use tokio::sync::watch;
+
+#[tokio::test]
+async fn internal_startup_holds_parent_admission_and_cancellation_remains_uncertain() {
+    let (sender, receiver) = async_channel::bounded(4);
+    let sender = SubmissionSender::from(sender);
+    let registry = InternalSessionRegistry::new(sender.activity_source());
+    let startup = registry.begin_startup().unwrap();
+    assert!(sender.try_reserve_idle_close().is_err());
+    drop(startup);
+    assert!(sender.try_reserve_idle_close().is_ok());
+    assert!(registry.ensure_idle().await.is_err());
+    assert!(registry.close_idle().await.is_err());
+    assert!(receiver.is_empty());
+    drop(sender);
+    assert!(
+        receiver.is_closed(),
+        "the registry must not keep parent input alive"
+    );
+}
+
+#[test]
+fn parent_close_reservation_rejects_guardian_activity_and_internal_startup() {
+    let (sender, _receiver) = async_channel::bounded(4);
+    let sender = SubmissionSender::from(sender);
+    let registry = InternalSessionRegistry::new(sender.activity_source());
+    let reservation = sender.try_reserve_idle_close().unwrap();
+    assert!(registry.try_admit_activity().is_err());
+    assert!(registry.begin_startup().is_err());
+    drop(reservation);
+    assert!(registry.try_admit_activity().is_ok());
+    assert!(registry.actors().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn registered_internal_actor_is_closed_and_awaited_without_public_graph_membership() {
+    let registry = InternalSessionRegistry::default();
+    let (child, _turn) = crate::session::tests::make_session_and_context().await;
+    let child = Arc::new(child);
+    let (sender, receiver) = async_channel::bounded(4);
+    let (_events, rx_event) = async_channel::unbounded();
+    let terminated_child = Arc::clone(&child);
+    let task = tokio::spawn(async move {
+        let submission: Submission = receiver.recv().await.unwrap();
+        let Op::CloseIdleAndShutdown {
+            reply,
+            mut admission,
+        } = submission.op
+        else {
+            panic!("internal actor must receive checked close, never interruption");
+        };
+        *admission = true;
+        terminated_child
+            .internal_sessions
+            .record_shutdown_result(&Ok(()));
+        reply.send(Ok(())).unwrap();
+    });
+    let io = SessionIo {
+        tx_sub: sender.into(),
+        rx_event,
+        agent_status: watch::channel(AgentStatus::PendingInit).1,
+        session_loop_termination: super::super::session_loop_termination_from_handle(task),
+    };
+    let startup = registry.begin_startup().unwrap();
+    startup.register(child, &io).unwrap();
+    drop(startup);
+    registry.close_idle().await.unwrap();
+    assert!(io.session_loop_termination.clone().now_or_never().is_some());
+    registry.ensure_idle().await.unwrap();
+}
+
+#[tokio::test]
+async fn terminated_helper_with_failed_cleanup_never_becomes_release_proof() {
+    let registry = InternalSessionRegistry::default();
+    let (child, _turn) = crate::session::tests::make_session_and_context().await;
+    child
+        .internal_sessions
+        .record_shutdown_result(&Err(blocked("writer close failed")));
+    child.internal_sessions.record_shutdown_result(&Ok(()));
+    let (sender, _receiver) = async_channel::bounded(4);
+    let (_events, rx_event) = async_channel::unbounded();
+    let io = SessionIo {
+        tx_sub: sender.into(),
+        rx_event,
+        agent_status: watch::channel(AgentStatus::PendingInit).1,
+        session_loop_termination: super::super::completed_session_loop_termination(),
+    };
+    let startup = registry.begin_startup().unwrap();
+    startup.register(Arc::new(child), &io).unwrap();
+    drop(startup);
+    tokio::task::yield_now().await;
+    assert!(registry.ensure_idle().await.is_err());
+    assert!(registry.close_idle().await.is_err());
+    assert_eq!(registry.actors().unwrap().len(), 1);
+}
+
+#[tokio::test]
+async fn queued_internal_work_refuses_close_without_consuming_the_submission() {
+    let registry = InternalSessionRegistry::default();
+    let (child, _turn) = crate::session::tests::make_session_and_context().await;
+    let (sender, receiver) = async_channel::bounded(4);
+    let (_events, rx_event) = async_channel::unbounded();
+    let io = SessionIo {
+        tx_sub: sender.into(),
+        rx_event,
+        agent_status: watch::channel(AgentStatus::PendingInit).1,
+        session_loop_termination: futures::future::pending::<()>().boxed().shared(),
+    };
+    let startup = registry.begin_startup().unwrap();
+    startup.register(Arc::new(child), &io).unwrap();
+    drop(startup);
+    io.submit(Op::Interrupt).await.unwrap();
+    assert!(registry.close_idle().await.is_err());
+    assert_eq!(receiver.len(), 1);
+    assert!(matches!(receiver.recv().await.unwrap().op, Op::Interrupt));
+}
