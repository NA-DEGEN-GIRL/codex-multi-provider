+async fn start_canonical_root(
+    harness: &AgentControlHarness,
+) -> (ThreadId, Arc<CodexThread>, ManagedThreadBinding) {
+    let config = &harness.config;
+    let profile_id = ThreadId::new().to_string();
+    let root_id = ThreadId::new();
+    let source_id = ManagedSourceId {
+        host_id: "local".to_string(),
+        store_id: format!("manager:{profile_id}"),
+    };
+    std::fs::write(
+        config.codex_home.join("managed-source.json"),
+        serde_json::to_vec(&source_id).expect("managed source marker"),
+    )
+    .expect("register temporary source");
+    let registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        profile_id,
+        vec![ManagedSourceRegistration {
+            source_id: source_id.clone(),
+            config: LocalThreadStoreConfig::from_config(config),
+        }],
+    )
+    .expect("managed source allowlist");
+    let binding = registry
+        .bind_new(&source_id, root_id)
+        .await
+        .expect("canonical root authority");
+    let root = harness
+        .manager
+        .start_thread(StartThreadOptions {
+            managed_record_binding: Some(binding.clone()),
+            history_mode: Some(ThreadHistoryMode::Paginated),
+            environments: Some(Vec::new()),
+            ..StartThreadOptions::new(config.clone())
+        })
+        .await
+        .expect("start managed source root");
+    assert_eq!(root.thread_id, root_id);
+    (root_id, root.thread, binding)
+}
+
+// Model a completed manager handoff in temporary fixtures only. All source actors have already
+// closed, and each existing canonical authority record advances to the target profile's grant.
+async fn transfer_canonical_tree(
+    source: &ManagedThreadBinding,
+    thread_ids: &[ThreadId],
+) -> ManagedThreadBinding {
+    assert!(
+        source.is_released(),
+        "source root must close before authority advances"
+    );
+    let target_profile = ThreadId::new().to_string();
+    let grant = ManagedAuthorityGrant {
+        owner_profile_id: target_profile.clone(),
+        epoch: 2,
+        revision: 2,
+    };
+    let source_id = source.source_id();
+    for thread_id in thread_ids {
+        let path = source
+            .source_config()
+            .codex_home
+            .join("managed-authority")
+            .join(format!("{thread_id}.json"));
+        let previous: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(&path).expect("existing child authority"))
+                .expect("previous authority JSON");
+        assert_eq!(
+            previous["owner_profile_id"],
+            source.authority_grant().owner_profile_id
+        );
+        let record = serde_json::json!({
+            "version": 1, "host_id": source_id.host_id, "store_id": source_id.store_id,
+            "thread_id": thread_id, "owner_profile_id": grant.owner_profile_id,
+            "epoch": grant.epoch, "revision": grant.revision,
+        });
+        let temporary = path.with_extension("tmp");
+        std::fs::write(
+            &temporary,
+            serde_json::to_vec(&record).expect("target grant JSON"),
+        )
+        .expect("prepare fixture authority transfer");
+        std::fs::rename(temporary, path).expect("publish fixture authority transfer");
+    }
+    let registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        target_profile,
+        vec![ManagedSourceRegistration {
+            source_id: source_id.clone(),
+            config: source.source_config().clone(),
+        }],
+    )
+    .expect("target source allowlist");
+    registry
+        .bind(source_id, source.thread_id(), grant)
+        .await
+        .expect("target canonical root grant")
+}
+
+async fn canonical_history(binding: &ManagedThreadBinding) -> InitialHistory {
+    let stored = binding
+        .store()
+        .read_thread(ReadThreadParams {
+            thread_id: binding.thread_id(),
+            include_archived: true,
+            include_history: false,
+        })
+        .await
+        .expect("canonical root history");
+    InitialHistory::Resumed(ResumedHistory {
+        conversation_id: stored.thread_id,
+        history: Arc::new(
+            binding
+                .store()
+                .load_latest_model_context(codex_thread_store::LoadThreadHistoryParams {
+                    thread_id: binding.thread_id(),
+                    include_archived: true,
+                })
+                .await
+                .expect("canonical paginated model context")
+                .items,
+        ),
+        rollout_path: stored.rollout_path,
+    })
+}
