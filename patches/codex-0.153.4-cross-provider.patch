diff --git a/codex-rs/core/src/config/execution_presets.rs b/codex-rs/core/src/config/execution_presets.rs
new file mode 100644
index 000000000..379bcbc9b
--- /dev/null
+++ b/codex-rs/core/src/config/execution_presets.rs
@@ -0,0 +1,408 @@
+//! Manager-owned preset selections. Requests carry identifiers, never authority or paths.
+
+use super::AgentRoleConfig;
+use super::Config;
+use anyhow::Context;
+use anyhow::ensure;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_protocol::protocol::ExecutionPresetSelection;
+use serde::Deserialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::io::Read;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+const MAX_REGISTRY_BYTES: u64 = 1024 * 1024;
+const MAX_SAVED_PROFILES: usize = 64;
+
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+pub(crate) struct PresetRole {
+    pub(crate) model_provider: String,
+    pub(crate) model: String,
+    pub(crate) effort: Option<ReasoningEffort>,
+    pub(crate) auth_codex_home: Option<PathBuf>,
+    pub(crate) expected_account_fingerprint: Option<String>,
+    pub(crate) auth_source: Option<String>,
+    pub(crate) profile_id: Option<String>,
+    pub(crate) expected_account_identity: Option<String>,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+pub(crate) struct PresetMainAuth {
+    pub(crate) kind: String,
+    pub(crate) auth_source: String,
+    pub(crate) profile_id: String,
+    pub(crate) expected_account_identity: String,
+}
+
+#[derive(Deserialize)]
+struct Registry {
+    schema_version: u32,
+    profile_id: String,
+    presets: Vec<Preset>,
+    roles: BTreeMap<String, PresetRole>,
+    default_preset: Option<ExecutionPresetSelection>,
+    #[serde(default)]
+    task_bindings: BTreeMap<String, Option<ExecutionPresetSelection>>,
+    main_auth: Option<PresetMainAuth>,
+}
+
+#[derive(Deserialize)]
+struct Preset {
+    id: String,
+    revision: u64,
+    role_ids: Vec<String>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+struct PreparedRegistry {
+    path: PathBuf,
+    profile_id: String,
+    roles: BTreeMap<String, AgentRoleConfig>,
+    legacy_roles: BTreeMap<String, AgentRoleConfig>,
+    role_bindings: BTreeMap<String, PresetRole>,
+    main_auth: Option<PresetMainAuth>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ExecutionPresets {
+    prepared: Arc<PreparedRegistry>,
+    selection: Option<ExecutionPresetSelection>,
+    roles: BTreeMap<String, PresetRole>,
+    leaf: bool,
+    bindings: BTreeMap<String, Option<ExecutionPresetSelection>>,
+}
+
+fn read_registry(path: &std::path::Path) -> anyhow::Result<Registry> {
+    ensure!(
+        path.is_absolute(),
+        "execution preset registry path must be absolute"
+    );
+    let mut bytes = Vec::new();
+    std::fs::File::open(path)?
+        .take(MAX_REGISTRY_BYTES + 1)
+        .read_to_end(&mut bytes)?;
+    ensure!(
+        bytes.len() as u64 <= MAX_REGISTRY_BYTES,
+        "execution preset registry is too large"
+    );
+    let registry: Registry = serde_json::from_slice(&bytes)?;
+    ensure!(
+        registry.schema_version == 1,
+        "unsupported execution preset registry version"
+    );
+    ensure!(
+        uuid::Uuid::parse_str(&registry.profile_id).is_ok(),
+        "invalid execution preset registry owner"
+    );
+    ensure!(
+        registry.presets.len() <= 256 && registry.roles.len() <= 256,
+        "too many execution presets or roles"
+    );
+    Ok(registry)
+}
+
+impl Config {
+    pub(crate) fn initialize_execution_presets(&mut self) -> anyhow::Result<()> {
+        let Some(path) = std::env::var_os("CODEX_MANAGER_EXECUTION_PRESETS") else {
+            return Ok(());
+        };
+        self.load_execution_presets(PathBuf::from(path))
+    }
+
+    fn load_execution_presets(&mut self, path: PathBuf) -> anyhow::Result<()> {
+        let registry = read_registry(&path).context("cannot load trusted execution presets")?;
+        let legacy_roles = self
+            .agent_roles
+            .iter()
+            .filter(|(id, _)| !registry.roles.contains_key(*id))
+            .map(|(id, role)| (id.clone(), role.clone()))
+            .collect();
+        self.execution_presets = Some(ExecutionPresets {
+            prepared: Arc::new(PreparedRegistry {
+                path,
+                profile_id: registry.profile_id,
+                roles: self.agent_roles.clone(),
+                legacy_roles,
+                role_bindings: registry.roles,
+                main_auth: registry.main_auth,
+            }),
+            selection: None,
+            roles: BTreeMap::new(),
+            leaf: false,
+            bindings: BTreeMap::new(),
+        });
+        self.select_execution_preset(None)
+    }
+
+    pub(crate) fn execution_preset_selection(&self) -> Option<ExecutionPresetSelection> {
+        self.execution_presets
+            .as_ref()
+            .and_then(|state| state.selection.clone())
+    }
+
+    /// Trusted registry owner used to bind the managed credential transport.
+    pub fn execution_preset_profile_id(&self) -> Option<String> {
+        self.execution_presets
+            .as_ref()
+            .map(|state| state.prepared.profile_id.clone())
+    }
+
+    pub(crate) fn execution_preset_main_auth(&self) -> Option<&PresetMainAuth> {
+        self.execution_presets.as_ref()?.prepared.main_auth.as_ref()
+    }
+
+    pub(crate) fn execution_preset_bindings(
+        &self,
+    ) -> BTreeMap<String, Option<ExecutionPresetSelection>> {
+        self.execution_presets
+            .as_ref()
+            .map(|state| state.bindings.clone())
+            .unwrap_or_default()
+    }
+
+    pub(crate) fn select_execution_preset(
+        &mut self,
+        selection: Option<ExecutionPresetSelection>,
+    ) -> anyhow::Result<()> {
+        let Some(state) = self.execution_presets.as_ref() else {
+            ensure!(
+                selection.is_none(),
+                "execution presets are not prepared; prepare/reload required"
+            );
+            return Ok(());
+        };
+        let prepared = Arc::clone(&state.prepared);
+        let mut roles = BTreeMap::new();
+        let mut declarations = prepared.legacy_roles.clone();
+        if let Some(selection) = &selection {
+            ensure!(
+                uuid::Uuid::parse_str(&selection.id).is_ok() && selection.revision > 0,
+                "invalid execution preset selection"
+            );
+            let registry = read_registry(&prepared.path)?;
+            ensure!(
+                registry.profile_id == prepared.profile_id,
+                "execution preset registry owner changed; prepare/reload required"
+            );
+            let preset = registry
+                .presets
+                .iter()
+                .find(|preset| preset.id == selection.id && preset.revision == selection.revision)
+                .context("execution preset revision is unavailable; prepare/reload required")?;
+            ensure!(
+                preset.role_ids.len() <= 128,
+                "too many roles in execution preset"
+            );
+            declarations.clear();
+            for id in &preset.role_ids {
+                let declaration = prepared
+                    .roles
+                    .get(id)
+                    .context("execution preset role is not prepared; prepare/reload required")?;
+                let role = registry
+                    .roles
+                    .get(id)
+                    .context("execution preset role metadata is unavailable")?;
+                ensure!(
+                    prepared.role_bindings.get(id) == Some(role),
+                    "execution preset role binding changed; prepare/reload required"
+                );
+                ensure!(
+                    declaration.model_provider.as_deref() == Some(role.model_provider.as_str()),
+                    "execution preset provider changed; prepare/reload required"
+                );
+                self.subagent_model_provider_baseline_for(&role.model_provider)
+                    .context(
+                        "execution preset provider is not prepared; prepare/reload required",
+                    )?;
+                ensure!(
+                    role.auth_codex_home
+                        .as_ref()
+                        .is_none_or(|path| path.is_absolute()),
+                    "execution preset auth source must be absolute"
+                );
+                declarations.insert(id.clone(), declaration.clone());
+                roles.insert(id.clone(), role.clone());
+            }
+        }
+        let leaf = state.leaf;
+        let mut bindings = state.bindings.clone();
+        bindings.insert(prepared.profile_id.clone(), selection.clone());
+        ensure!(
+            bindings.len() <= MAX_SAVED_PROFILES,
+            "too many saved execution preset profiles"
+        );
+        self.agent_roles = declarations;
+        self.execution_presets = Some(ExecutionPresets {
+            prepared,
+            selection,
+            roles,
+            leaf,
+            bindings,
+        });
+        Ok(())
+    }
+
+    pub(crate) fn execution_preset_allows_role(&self, role_name: &str) -> bool {
+        self.execution_presets
+            .as_ref()
+            .is_none_or(|state| state.selection.is_none() || state.roles.contains_key(role_name))
+    }
+
+    pub(crate) fn execution_preset_account_matches(
+        &self,
+        role_name: Option<&str>,
+        account_id: Option<&str>,
+    ) -> anyhow::Result<bool> {
+        let Some(role) = self.execution_preset_role(role_name)? else {
+            return Ok(true);
+        };
+        let Some(expected) = &role.expected_account_fingerprint else {
+            return Ok(role.auth_codex_home.is_none() && role.auth_source.is_none());
+        };
+        let Some(account_id) = account_id else {
+            return Ok(false);
+        };
+        let mut digest = Sha256::new();
+        digest.update(b"codex-manager-account-v1\0");
+        digest.update(account_id.as_bytes());
+        Ok(format!("{:x}", digest.finalize()) == *expected)
+    }
+
+    pub(crate) fn execution_preset_has_account_roles(&self) -> bool {
+        self.execution_presets.as_ref().is_some_and(|state| {
+            state
+                .roles
+                .values()
+                .any(|role| role.auth_codex_home.is_some() || role.auth_source.is_some())
+        })
+    }
+
+    pub(crate) fn execution_preset_is_leaf(&self) -> bool {
+        self.execution_presets
+            .as_ref()
+            .is_some_and(|state| state.leaf)
+    }
+
+    pub(crate) fn mark_execution_preset_child(&mut self) {
+        if let Some(state) = &mut self.execution_presets {
+            state.leaf = state.selection.is_some();
+        }
+    }
+
+    pub(crate) fn restore_execution_preset(
+        &mut self,
+        history: &codex_history::InitialHistory,
+    ) -> anyhow::Result<()> {
+        let Some(state) = &self.execution_presets else {
+            return Ok(());
+        };
+        let registry = read_registry(&state.prepared.path)?;
+        ensure!(
+            registry.profile_id == state.prepared.profile_id,
+            "execution preset registry owner changed; prepare/reload required"
+        );
+        let mut saved_bindings = BTreeMap::new();
+        let selection = if let codex_history::InitialHistory::Resumed(resumed) = history {
+            let binding = registry
+                .task_bindings
+                .get(&resumed.conversation_id.to_string())
+                .cloned();
+            let snapshots =
+                history
+                    .get_rollout_items()
+                    .iter()
+                    .rev()
+                    .filter_map(|item| match item {
+                        codex_history::RolloutItem::EventMsg(
+                            codex_protocol::protocol::EventMsg::ThreadSettingsApplied(event),
+                        ) if event
+                            .thread_id
+                            .is_none_or(|id| id == resumed.conversation_id) =>
+                        {
+                            Some(&event.thread_settings)
+                        }
+                        _ => None,
+                    });
+            let mut latest_legacy = None;
+            for (index, snapshot) in snapshots.enumerate() {
+                if index == 0 && snapshot.execution_preset_profile_id.is_none() {
+                    latest_legacy = Some(snapshot.execution_preset.clone());
+                }
+                // Current-owner fields take precedence over that checkpoint's inherited map.
+                let current = snapshot
+                    .execution_preset_profile_id
+                    .as_ref()
+                    .map(|owner| (owner, &snapshot.execution_preset));
+                for (owner, selection) in current
+                    .into_iter()
+                    .chain(snapshot.execution_preset_bindings.iter())
+                {
+                    ensure!(
+                        uuid::Uuid::parse_str(owner).is_ok(),
+                        "invalid saved execution preset owner"
+                    );
+                    ensure!(
+                        selection
+                            .as_ref()
+                            .is_none_or(|selection| uuid::Uuid::parse_str(&selection.id).is_ok()
+                                && selection.revision > 0),
+                        "invalid saved execution preset selection"
+                    );
+                    saved_bindings
+                        .entry(owner.clone())
+                        .or_insert_with(|| selection.clone());
+                    ensure!(
+                        saved_bindings.len() <= MAX_SAVED_PROFILES,
+                        "too many saved execution preset profiles"
+                    );
+                }
+            }
+            let persisted = saved_bindings
+                .get(&registry.profile_id)
+                .cloned()
+                .or(latest_legacy);
+            binding.or(persisted).unwrap_or(registry.default_preset)
+        } else {
+            registry.default_preset
+        };
+        let mut candidate = self.clone();
+        if let Some(state) = &mut candidate.execution_presets {
+            state.bindings = saved_bindings;
+        }
+        candidate.select_execution_preset(selection)?;
+        *self = candidate;
+        Ok(())
+    }
+
+    pub(crate) fn execution_preset_role(
+        &self,
+        role_name: Option<&str>,
+    ) -> anyhow::Result<Option<&PresetRole>> {
+        let Some(state) = self
+            .execution_presets
+            .as_ref()
+            .filter(|state| state.selection.is_some())
+        else {
+            return Ok(None);
+        };
+        let role = state
+            .roles
+            .get(role_name.unwrap_or("default"))
+            .context("choose an explicit role allowed by this task's execution preset")?;
+        ensure!(
+            self.model_provider_id == role.model_provider
+                && self.model.as_deref() == Some(role.model.as_str())
+                && self.model_reasoning_effort == role.effort,
+            "subagent model/provider/effort does not match the selected execution preset role"
+        );
+        Ok(Some(role))
+    }
+}
+
