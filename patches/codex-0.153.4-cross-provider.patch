+use super::*;
+use pretty_assertions::assert_eq;
+
+fn sources(root: &Path) -> Arc<Vec<RecordSource>> {
+    let id = ThreadId::new();
+    Arc::new(
+        ["first", "second"]
+            .into_iter()
+            .map(|name| RecordSource {
+                projection_thread_id: ThreadId::new(),
+                thread_id: id,
+                host_id: "local".into(),
+                source_store_id: name.into(),
+                codex_home: root.join(name),
+                rollout_path: root.join(name).join("session.jsonl"),
+            })
+            .collect(),
+    )
+}
+
+#[tokio::test]
+async fn explicit_source_selection_survives_reopen_and_other_profile_aliases() {
+    let temp = tempfile::tempdir().unwrap();
+    let entries = sources(temp.path());
+    let path = temp.path().join("routes.json");
+    let routes = SharedRoutes::load_path(Some(path.clone()), Arc::clone(&entries))
+        .await
+        .unwrap();
+    assert!(
+        entries
+            .iter()
+            .all(|source| routes.projects(source) && routes.includes(source))
+    );
+    routes.select(&entries[1]).await.unwrap();
+    let selected = SharedRoutes::load_path(Some(path.clone()), Arc::clone(&entries))
+        .await
+        .unwrap();
+    assert_eq!(
+        entries
+            .iter()
+            .map(|s| (selected.projects(s), selected.includes(s)))
+            .collect::<Vec<_>>(),
+        vec![(false, false), (false, true)]
+    );
+    assert_ne!(selected.revision(), routes.revision());
+    routes.select(&entries[0]).await.unwrap();
+    assert_eq!(read(&path).unwrap(), selected.selected);
+    let missing = SharedRoutes::load_path(Some(path), Arc::new(vec![entries[0].clone()]))
+        .await
+        .unwrap();
+    assert!(missing.has_selection(entries[0].thread_id));
+    assert!(!missing.includes(&entries[0]));
+}
+
+#[tokio::test]
+async fn concurrent_source_choices_publish_one_complete_stable_mapping() {
+    let temp = tempfile::tempdir().unwrap();
+    let entries = sources(temp.path());
+    let path = temp.path().join("routes.json");
