+#[tokio::test]
+async fn managed_active_status_observes_without_interrupting_inference() -> Result<()> {
+    let (complete_tx, complete_rx) = oneshot::channel();
+    let (server, _) = start_streaming_sse_server(vec![vec![
+        StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![responses::ev_response_created("active")]),
+        },
+        StreamingSseChunk {
+            gate: Some(complete_rx),
+            body: responses::sse(vec![responses::ev_completed("active")]),
+        },
+    ]])
+    .await;
+    let profile = ManagedProfile::new(server.uri())?;
+    let mut app = profile.start_server().await?;
+    let thread_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let started = start_turn(&mut app, &thread_id).await?;
+    timeout(READ_TIMEOUT, server.wait_for_request_count(1)).await?;
+    let authority_before = profile.authority_bytes(&thread_id)?;
+
+    let status = snapshot(&mut app, &thread_id).await?;
+    assert_advisory_identity(&status, &profile, &thread_id);
+    assert_eq!(status["idle"], false);
+    let blockers = status["blockers"].as_array().context("blocker array")?;
+    assert!(blockers.iter().any(|blocker| {
+        blocker["threadId"] == thread_id
+            && matches!(blocker["kind"].as_str(), Some("activeTurn" | "agentActive"))
+    }));
+    assert_eq!(profile.authority_bytes(&thread_id)?, authority_before);
+
+    complete_tx
+        .send(())
+        .expect("snapshot left the original inference stream alive");
+    assert_completed(&mut app, &thread_id, &started.turn.id).await?;
+    assert_eq!(server.requests().await.len(), 1);
+    server.shutdown().await;
+    Ok(())
+}
