+        .await
+        .unwrap();
+    assert_eq!(updated.name.as_deref(), Some("renamed task"));
+    let history = std::fs::read_to_string(&rollout).unwrap();
+    assert!(history.contains("original question"));
+    assert!(history.contains("reply from selected account"));
+    assert_eq!(std::fs::read(auth).unwrap(), b"source-credential-sentinel");
+    assert_eq!(std::fs::read(config).unwrap(), b"source-config-sentinel");
+    assert!(!selected_home.join("sessions").exists());
