+#[test]
+fn plaintext_reasoning_is_preserved_only_in_openai_request_copies() -> anyhow::Result<()> {
+    let input: Vec<ResponseItem> = serde_json::from_value(json!([
+        {"type":"reasoning", "id":"rs_native", "summary":[],
+         "content":[{"type":"text","text":"Native reasoning display"}],
+         "encrypted_content":"native-encrypted-state"},
+        {"type":"reasoning", "id":"00000000-0000-4000-8000-000000000001", "summary":[],
+         "content":[{"type":"reasoning_text","text":"Keep the migration atomic."}],
+         "encrypted_content":"00000000-0000-4000-8000-000000000001-0",
+         "internal_chat_message_metadata_passthrough":{"turn_id":"foreign-turn"}},
+        {"type":"function_call", "name":"inspect", "arguments":"{}", "call_id":"call-1"},
+        {"type":"function_call_output", "call_id":"call-1",
+         "output":[{"type":"input_image", "image_url":"data:image/png;base64,cGl4ZWw="}]},
+        {"type":"message", "role":"user", "content":[{"type":"input_text","text":"Continue."}]}
+    ]))?;
+    let prompt = Prompt {
+        input: input.clone(),
+        ..Default::default()
+    };
+    for use_responses_lite in [false, true] {
+        for openai in [false, true] {
+            let mut client = test_model_client(SessionSource::Cli);
+            if openai {
+                Arc::get_mut(&mut client.state)
+                    .expect("unique test client")
+                    .provider = create_model_provider(
+                    ModelProviderInfo::create_openai_provider(/*base_url*/ None),
+                    /*auth_manager*/ None,
+                );
+            }
+            let mut model = test_model_info();
+            model.use_responses_lite = use_responses_lite;
+            let request = client.build_responses_request(
+                &prompt,
+                &model,
+                /*effort*/ None,
+                codex_protocol::config_types::ReasoningSummary::None,
+                /*service_tier*/ None,
+                &test_responses_metadata_for_client(
+                    &client,
+                    /*turn_id*/ None,
+                    "window".to_string(),
+                    /*parent_thread_id*/ None,
+                    TestCodexResponsesRequestKind::Turn,
+                ),
+            )?;
+            let start = if use_responses_lite { 2 } else { 0 };
+            let actual = &request.input[start..];
+            let mut expected = input.clone();
+            if openai {
+                expected[1] = ResponseItem::Message {
+                    id: actual[1].id().cloned(),
+                    role: "assistant".to_string(),
+                    content: vec![ContentItem::OutputText {
+                        text: "Keep the migration atomic.".to_string(),
+                    }],
+                    phase: None,
+                    internal_chat_message_metadata_passthrough: None,
+                };
+                assert!(
+                    actual[1]
+                        .id()
+                        .is_some_and(codex_protocol::ResponseItemId::is_prefixed)
+                );
+                let mut repeated = input.clone();
+                crate::client_common::normalize_plaintext_reasoning_for_openai(&mut repeated);
+                assert_eq!(actual[1], repeated[1]);
+            } else {
+                expected[1].clear_internal_chat_message_metadata_passthrough();
+            }
+            assert_eq!(actual, expected);
+            assert_eq!(prompt.input, input);
+            let http = serde_json::to_value(&request)?;
+            let websocket = serde_json::to_value(ResponseCreateWsRequest::from(&request))?;
+            assert_eq!(http["input"], websocket["input"]);
+            if openai {
+                assert!(!http.to_string().contains("reasoning_text"));
+                assert!(
+                    !http
+                        .to_string()
+                        .contains("00000000-0000-4000-8000-000000000001-0")
+                );
+            }
+        }
+    }
+    Ok(())
+}
