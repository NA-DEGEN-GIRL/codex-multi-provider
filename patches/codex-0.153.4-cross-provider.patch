+//! Two independently opened catalog connections observe one canonical writer.
+
+use super::manager_record_catalog::CatalogFixture;
+use super::manager_record_catalog::READ_TIMEOUT;
+use anyhow::Result;
+use app_test_support::TestAppServer;
+use codex_app_server_protocol::ItemCompletedNotification;
+use codex_app_server_protocol::ItemStartedNotification;
+use codex_app_server_protocol::ThreadLoadedListResponse;
+use codex_app_server_protocol::ThreadResumeResponse;
+use codex_app_server_protocol::ThreadStatus;
+use codex_app_server_protocol::ThreadStatusChangedNotification;
+use codex_app_server_protocol::ThreadUnsubscribeResponse;
+use codex_app_server_protocol::ThreadUnsubscribeStatus;
+use codex_app_server_protocol::TurnCompletedNotification;
+use codex_app_server_protocol::TurnStartedNotification;
+use codex_protocol::ThreadId;
+use codex_protocol::items::PlanItem;
+use codex_protocol::items::TurnItem;
+use codex_protocol::protocol::AgentMessageEvent;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ItemCompletedEvent;
+use codex_protocol::protocol::ItemStartedEvent;
+use codex_protocol::protocol::TurnCompleteEvent;
+use codex_protocol::protocol::TurnStartedEvent;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::fs;
+use std::io::Write;
+use std::time::Duration;
+use tempfile::TempDir;
+use tokio::time::timeout;
+
+fn append(fixture: &CatalogFixture, event: EventMsg) -> Result<()> {
+    let mut file = fs::OpenOptions::new()
+        .append(true)
+        .open(&fixture.rollout_path)?;
+    writeln!(
+        file,
+        "{}",
+        json!({"timestamp":"2026-09-13T13:30:00Z","type":"event_msg","payload":event})
+    )?;
+    file.flush()?;
+    Ok(())
+}
+
+fn plan(text: &str) -> TurnItem {
+    TurnItem::Plan(PlanItem {
+        id: "shared-plan".to_string(),
+        text: text.to_string(),
+    })
+}
+
+#[tokio::test]
+async fn large_common_record_opens_and_receives_small_updates_without_copying_old_items()
+-> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let turn_id = "large-existing-turn".to_string();
+    append(
+        &fixture,
+        EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: turn_id.clone(),
+            trace_id: None,
+            started_at: Some(100),
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        }),
+    )?;
+    for index in 0..3 {
+        append(
+            &fixture,
+            EventMsg::ItemStarted(ItemStartedEvent {
+                thread_id: ThreadId::from_string(&fixture.thread_id)?,
+                turn_id: turn_id.clone(),
+                item: TurnItem::Plan(PlanItem {
+                    id: format!("large-existing-{index}"),
+                    text: "x".repeat(3 * 1024 * 1024),
+                }),
+                started_at_ms: 100_000,
+            }),
+        )?;
+    }
+    let mut server = fixture.start_server().await?;
+    let request = server
+        .send_raw_request(
+            "thread/resume",
+            Some(json!({
+                "threadId":fixture.projection_id, "excludeTurns":true,
+            })),
+        )
+        .await?;
+    let response: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(response.thread.can_accept_direct_input, Some(false));
+    append(
+        &fixture,
+        EventMsg::ItemStarted(ItemStartedEvent {
+            thread_id: ThreadId::from_string(&fixture.thread_id)?,
+            turn_id: turn_id.clone(),
+            item: plan("new small update"),
+            started_at_ms: 101_000,
+        }),
+    )?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("item/started"),
+    )
+    .await??;
+    let item: ItemStartedNotification = serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(item.item.id(), "shared-plan");
+    assert!(serde_json::to_string(&item.item)?.contains("new small update"));
+    append(
+        &fixture,
+        EventMsg::TurnComplete(TurnCompleteEvent {
+            turn_id: turn_id.clone(),
+            last_agent_message: None,
+            error: None,
+            started_at: Some(100),
+            completed_at: Some(102),
+            duration_ms: Some(2000),
+            time_to_first_token_ms: None,
+        }),
+    )?;
+    let written = fs::read(&fixture.rollout_path)?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("item/completed"),
+    )
+    .await??;
+    let completed_item: ItemCompletedNotification =
+        serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(completed_item.item.id(), "shared-plan");
+    assert_eq!(completed_item.item, item.item);
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let completed: TurnCompletedNotification =
+        serde_json::from_value(notification.params.unwrap())?;
+    assert_eq!(completed.turn.id, turn_id);
+    let request = server
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(loaded.data, Vec::<String>::new());
+    fixture.assert_source_untouched(&written)?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn common_record_updates_reach_both_viewers_and_unsubscribe_stops_only_one() -> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let second_home = TempDir::new()?;
+    let mut first = fixture.start_server().await?;
+    let mut second = TestAppServer::builder()
+        .with_codex_home(second_home.path())
+        .without_managed_config()
+        .with_env_overrides(&[
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            (
+                "CODEX_MANAGER_SHARED_CATALOG",
+                fixture.manifest_path.to_str(),
+            ),
+            ("CODEX_SQLITE_HOME", None),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    for server in [&mut first, &mut second] {
+        let request = server
+            .send_raw_request(
+                "thread/resume",
+                Some(json!({"threadId":fixture.projection_id,"excludeTurns":true})),
+            )
+            .await?;
+        let response: ThreadResumeResponse =
+            timeout(READ_TIMEOUT, server.read_response(request)).await??;
+        assert_eq!(response.thread.can_accept_direct_input, Some(false));
+    }
+    let turn_id = "shared-live-turn".to_string();
+    append(
+        &fixture,
+        EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: turn_id.clone(),
+            trace_id: None,
+            started_at: Some(100),
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        }),
+    )?;
+    append(
+        &fixture,
+        EventMsg::ItemStarted(ItemStartedEvent {
+            thread_id: ThreadId::from_string(&fixture.thread_id)?,
+            turn_id: turn_id.clone(),
+            item: plan("partial"),
+            started_at_ms: 100_000,
+        }),
+    )?;
+    for server in [&mut first, &mut second] {
+        let notification = timeout(
+            READ_TIMEOUT,
+            server.read_stream_until_notification_message("turn/started"),
+        )
+        .await??;
+        let started: TurnStartedNotification =
+            serde_json::from_value(notification.params.unwrap())?;
+        assert_eq!(
+            (&started.thread_id, &started.turn.id),
+            (&fixture.projection_id, &turn_id)
+        );
+        let notification = timeout(
+            READ_TIMEOUT,
+            server.read_stream_until_notification_message("item/started"),
+        )
+        .await??;
+        let item: ItemStartedNotification = serde_json::from_value(notification.params.unwrap())?;
+        assert_eq!(
+            (&item.thread_id, &item.turn_id),
+            (&fixture.projection_id, &turn_id)
+        );
+        assert!(serde_json::to_string(&item.item)?.contains("partial"));
+    }
+    append(
+        &fixture,
+        EventMsg::ItemCompleted(ItemCompletedEvent {
+            thread_id: ThreadId::from_string(&fixture.thread_id)?,
+            turn_id: turn_id.clone(),
+            item: plan("partial plus final"),
+            started_at_ms: Some(100_000),
+            completed_at_ms: 102_000,
+        }),
+    )?;
+    // Legacy rollouts persist assistant text as AgentMessage, whereas paginated
+    // histories persist ItemCompleted(AgentMessage). Use the canonical format.
+    append(
+        &fixture,
+        EventMsg::AgentMessage(AgentMessageEvent {
+            message: "The shared final reply".to_string(),
+            phase: None,
+            memory_citation: None,
+            delivery: None,
+            questions: None,
+        }),
+    )?;
+    append(
