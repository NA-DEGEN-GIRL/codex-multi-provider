+    use std::io::Write;
+
+    let temp = TempDir::new().unwrap();
+    let parent_path = fixture(temp.path(), THREAD_A, "parent message", "legacy");
+    let child_path = fixture(temp.path(), THREAD_B, "child message", "legacy");
+    let items = [
+        TurnItem::CollabAgentToolCall(CollabAgentToolCallItem {
+            id: "resume-1".to_string(),
+            tool: CollabAgentTool::ResumeAgent,
+            status: CollabAgentToolCallStatus::Completed,
+            sender_thread_id: ThreadId::from_string(THREAD_A).unwrap(),
+            receiver_thread_ids: vec![ThreadId::from_string(THREAD_B).unwrap()],
+            receiver_agents: vec![],
+            prompt: None,
+            model: None,
+            reasoning_effort: None,
+            agents_states: [(
+                ThreadId::from_string(THREAD_B).unwrap(),
+                AgentStatus::Completed(None),
+            )]
+            .into(),
+        }),
+        TurnItem::SubAgentActivity(SubAgentActivityItem {
+            id: "activity-1".to_string(),
+            agent_thread_id: ThreadId::from_string(THREAD_B).unwrap(),
+            agent_path: "/root/worker".parse().unwrap(),
+            kind: codex_protocol::protocol::SubAgentActivityKind::Completed,
+        }),
+    ];
+    let mut file = fs::OpenOptions::new()
+        .append(true)
+        .open(&parent_path)
+        .unwrap();
+    let started = EventMsg::TurnStarted(codex_protocol::protocol::TurnStartedEvent {
+        turn_id: "turn-1".to_string(),
+        trace_id: None,
+        started_at: Some(1),
+        model_context_window: None,
+        collaboration_mode_kind: Default::default(),
+    });
+    writeln!(
+        file,
+        "{}",
+        json!({"timestamp":"2026-09-13T01:00:02Z","type":"event_msg","payload":started})
+    )
+    .unwrap();
+    for item in items {
+        let event = EventMsg::ItemCompleted(ItemCompletedEvent {
+            thread_id: ThreadId::from_string(THREAD_A).unwrap(),
+            turn_id: "turn-1".to_string(),
+            item,
+            started_at_ms: None,
+            completed_at_ms: 0,
+        });
+        writeln!(
+            file,
+            "{}",
+            json!({"timestamp":"2026-09-13T01:00:02Z","type":"event_msg","payload":event})
+        )
+        .unwrap();
+    }
+    drop(file);
+    let before = fs::read(&parent_path).unwrap();
+    let catalog = catalog(vec![
+        source(
+            temp.path(),
+            &parent_path,
+            THREAD_A,
+            PROJECTION_A,
+            "manager:a",
+        ),
+        source(
+            temp.path(),
+            &child_path,
+            THREAD_B,
+            PROJECTION_B,
+            "manager:a",
+        ),
