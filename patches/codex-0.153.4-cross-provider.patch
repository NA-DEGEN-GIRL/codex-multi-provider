+    assert_eq!(
+        reloaded_child.session.codex_home().await,
+        target.config.codex_home
+    );
+    assert_eq!(reloaded_child.rollout_path(), Some(child_rollout));
+    let snapshot = reloaded_child.config_snapshot().await;
+    assert_eq!(snapshot.model_provider_id, "ollama");
+    assert_eq!(snapshot.model, "gpt-5.6-luna");
+    let child_binding = target
+        .manager
+        .managed_record_binding(child.thread_id)
+        .await
+        .expect("resumed canonical child binding");
+    let child_history = child_binding
+        .store()
+        .load_latest_model_context(codex_thread_store::LoadThreadHistoryParams {
+            thread_id: child.thread_id,
+            include_archived: true,
+        })
+        .await
+        .expect("canonical worker history");
+    assert!(
+        serde_json::to_string(&child_history.items)
+            .expect("serialize history")
+            .contains("canonical worker history"),
+        "cold resume must reopen the worker's canonical history"
+    );
+    assert_thread_not_loaded(&target.manager, reviewer.thread_id).await;
+    assert_eq!(
+        target_graph
+            .list_thread_spawn_children(root_id, None)
+            .await
+            .expect("target graph"),
+        vec![target_only_child],
+        "restoring and loading source children must not change target topology"
+    );
+    assert!(
+        target_graph
+            .list_thread_spawn_children(child.thread_id, None)
+            .await
+            .expect("target grandchild topology")
+            .is_empty()
+    );
+
+    // A new child after handoff must also inherit canonical persistence, not only restored children.
+    let fresh = spawn_v2_reload_test_child(
+        &restored_control,
+        target.config.clone(),
+        &resumed.thread,
+        "after_handoff",
+    )
+    .await;
+    let fresh_thread = target
+        .manager
+        .get_thread(fresh.thread_id)
+        .await
+        .expect("fresh child");
+    persist_thread_for_tree_resume(&fresh_thread, "new child after account handoff").await;
+    let fresh_binding = target
+        .manager
+        .managed_record_binding(fresh.thread_id)
+        .await
+        .expect("fresh child canonical binding");
+    assert_eq!(fresh_binding.source_id(), &source_id);
+    assert_eq!(
+        fresh_thread.session.codex_home().await,
+        target.config.codex_home
+    );
+    let canonical_graph = LocalAgentGraphStore::new(
+        fresh_binding
+            .store()
+            .state_db()
+            .await
+            .expect("canonical graph database"),
+    );
+    assert!(
+        canonical_graph
+            .list_thread_spawn_children(root_id, None)
+            .await
+            .expect("canonical children")
+            .contains(&fresh.thread_id)
+    );
+    assert_eq!(
+        target_graph
+            .list_thread_spawn_children(root_id, None)
+            .await
+            .expect("target still unchanged"),
+        vec![target_only_child]
+    );
+    // A sender-driven nested reload may evict its idle parent while acquiring residency.
+    // The captured canonical grant must survive that eviction without reverting to target HOME.
+    for idle_child in [&reloaded_child, &fresh_thread] {
+        // The test harness has no task runner to consume queued child notifications.
+        idle_child.session.mark_interrupted();
+        *idle_child.session.active_turn.lock().await = None;
+        let _ = idle_child
+            .session
+            .input_queue
+            .drain_mailbox_input_items()
+            .await;
+    }
+    let mut constrained_reload = target.config.clone();
+    constrained_reload
+        .multi_agent_v2
+        .max_concurrent_threads_per_session = 2; // Root plus one resident child.
+    restored_control
+        .ensure_v2_agent_loaded(constrained_reload, reviewer.thread_id, None)
+        .await
+        .expect("nested canonical child reload survives parent residency eviction");
+    assert_thread_not_loaded(&target.manager, child.thread_id).await;
+    assert_thread_not_loaded(&target.manager, fresh.thread_id).await;
+    let reloaded_reviewer = target
+        .manager
+        .get_thread(reviewer.thread_id)
+        .await
+        .expect("nested reviewer");
+    assert_eq!(
+        reloaded_reviewer.config_snapshot().await.model_provider_id,
+        "openai"
+    );
+    assert_eq!(
+        target
+            .manager
+            .managed_record_binding(reviewer.thread_id)
+            .await
+            .expect("nested binding")
+            .source_id(),
+        &source_id
+    );
+    assert_eq!(
+        target_graph
+            .list_thread_spawn_children(root_id, None)
+            .await
+            .expect("target graph still isolated"),
+        vec![target_only_child]
+    );
+    stop_all_managed_test_threads(&target.manager).await;
+}
