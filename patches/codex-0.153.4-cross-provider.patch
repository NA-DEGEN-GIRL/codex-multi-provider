+fn message(role: &str, text: &str) -> ResponseItem {
+    ResponseItem::Message {
+        id: None,
+        role: role.to_string(),
+        content: vec![ContentItem::InputText {
+            text: text.to_string(),
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    }
+}
+
+fn tools(json: &str) -> Arc<RawValue> {
+    Arc::from(RawValue::from_string(json.to_string()).expect("tools JSON"))
+}
+
+/// A request that sends its tools and instructions as request fields.
+fn request(input: Vec<ResponseItem>) -> ResponsesApiRequest {
+    ResponsesApiRequest {
+        model: "model".to_string(),
+        instructions: "instructions".to_string(),
+        input,
+        tools: Some(tools(r#"[{"type":"function","name":"shell"}]"#).into()),
+        tool_choice: "auto".to_string(),
+        parallel_tool_calls: true,
+        reasoning: Some(Reasoning {
+            effort: Some(ReasoningEffort::Low),
+            summary: None,
+            context: None,
+        }),
+        store: false,
+        stream: true,
+        stream_options: None,
+        include: Vec::new(),
+        service_tier: None,
+        prompt_cache_key: Some("thread".to_string()),
+        text: None,
+        client_metadata: None,
+        access_programs: None,
+    }
+}
+
+/// A Responses Lite request: its tools and instructions are its first two input items.
+fn lite_request(tool_names: &str, history: Vec<ResponseItem>) -> ResponsesApiRequest {
+    let head = vec![
+        ResponseItem::AdditionalTools {
+            id: None,
+            role: "developer".to_string(),
+            tools: vec![serde_json::json!({"type": "function", "name": tool_names})],
+        },
+        message("developer", "instructions"),
+    ];
+    ResponsesApiRequest {
+        instructions: String::new(),
+        tools: None,
+        input: head.into_iter().chain(history).collect(),
+        ..request(Vec::new())
+    }
+}
+
+fn history(len: usize) -> Vec<ResponseItem> {
+    (0..len)
+        .map(|index| message("user", &format!("item {index}")))
+        .collect()
+}
+
+#[test]
+fn a_request_that_extends_the_previous_one_matches_all_of_it() {
+    let previous = RequestShape::of(&request(history(/*len*/ 3)), /*head_items*/ 0);
+    let current = RequestShape::of(&request(history(/*len*/ 5)), /*head_items*/ 0);
+
+    let check = compare(Some(&previous), &current);
+    assert_eq!(
+        (
+            check.divergence,
+            check.items,
+            check.previous_items,
+            check.matched_items,
+            check.first_divergence_index,
+        ),
+        (Divergence::Appended, 5, Some(3), 3, None)
+    );
+    assert!(check.matched_bytes > 0 && check.matched_bytes < check.total_bytes);
+    // The prefix hash names the matched items, so it equals the previous request's full chain.
+    assert_eq!(
+        check.prefix_hash,
+        compare(Some(&previous), &previous).prefix_hash
+    );
+    assert_eq!(
+        compare(Some(&current), &current).divergence,
+        Divergence::Identical
+    );
+    assert_eq!(compare(None, &current).divergence, Divergence::First);
+}
+
+#[test]
+fn a_changed_history_item_is_located_and_named() {
+    let previous = RequestShape::of(&request(history(/*len*/ 4)), /*head_items*/ 0);
+    let mut changed = history(/*len*/ 4);
+    changed[2] = message("developer", "rewritten");
+    let current = RequestShape::of(&request(changed), /*head_items*/ 0);
+
+    let check = compare(Some(&previous), &current);
+    assert_eq!(
+        (
+            check.divergence,
+            check.matched_items,
+            check.first_divergence_index,
+            check.first_divergence_item,
+        ),
+        (Divergence::History, 2, Some(2), Some("message:developer"))
+    );
+
+    // A shorter request is a history change too.
+    let shorter = RequestShape::of(&request(history(/*len*/ 2)), /*head_items*/ 0);
+    let check = compare(Some(&previous), &shorter);
+    assert_eq!(
+        (
+            check.divergence,
+            check.first_divergence_index,
+            check.first_divergence_item
+        ),
+        (Divergence::History, Some(2), Some("missing"))
+    );
+}
+
+#[test]
+fn head_and_parameter_changes_are_reported_before_history() {
+    let previous = RequestShape::of(&request(history(/*len*/ 3)), /*head_items*/ 0);
+
+    let mut other_tools = request(history(/*len*/ 3));
+    other_tools.tools = Some(tools(r#"[{"type":"function","name":"exec"}]"#).into());
+    let check = compare(
+        Some(&previous),
+        &RequestShape::of(&other_tools, /*head_items*/ 0),
+    );
+    assert_eq!(
+        (check.divergence, check.matched_items),
+        (Divergence::HeadTools, 3)
+    );
+
+    let mut other_instructions = request(history(/*len*/ 3));
+    other_instructions.instructions = "other".to_string();
+    let check = compare(
+        Some(&previous),
+        &RequestShape::of(&other_instructions, /*head_items*/ 0),
+    );
+    assert_eq!(check.divergence, Divergence::HeadInstructions);
+
+    let mut other_effort = request(history(/*len*/ 3));
+    other_effort.reasoning = Some(Reasoning {
+        effort: Some(ReasoningEffort::High),
+        summary: None,
+        context: None,
+    });
+    let check = compare(
+        Some(&previous),
+        &RequestShape::of(&other_effort, /*head_items*/ 0),
+    );
+    assert_eq!(check.divergence, Divergence::Params);
+    assert_eq!(check.head, previous.head());
+}
+
+#[test]
+fn responses_lite_head_items_count_as_the_head() {
+    let previous = RequestShape::of(
+        &lite_request("shell", history(/*len*/ 2)),
+        /*head_items*/ 2,
+    );
+    let current = RequestShape::of(
+        &lite_request("exec", history(/*len*/ 2)),
+        /*head_items*/ 2,
+    );
+
+    let check = compare(Some(&previous), &current);
+    assert_eq!(
+        (
+            check.divergence,
+            check.matched_items,
+            check.first_divergence_index,
+            check.first_divergence_item,
+        ),
+        (Divergence::HeadTools, 0, Some(0), Some("additional_tools"))
+    );
+    assert_ne!(previous.head(), current.head());
+    assert_eq!(
+        request_head(
+            &lite_request("shell", history(/*len*/ 9)),
+            /*head_items*/ 2
+        ),
+        previous.head()
+    );
+}
+
+#[test]
+fn chains_compare_each_thread_with_its_own_previous_request() {
+    let mut chains = PrefixChains::default();
+    let first = chains.observe(
+        "a",
+        RequestShape::of(&request(history(/*len*/ 2)), /*head_items*/ 0),
+    );
+    let other_thread = chains.observe(
+        "b",
+        RequestShape::of(&request(history(/*len*/ 1)), /*head_items*/ 0),
+    );
+    let second = chains.observe(
+        "a",
+        RequestShape::of(&request(history(/*len*/ 3)), /*head_items*/ 0),
+    );
+
+    assert_eq!(
+        [first.divergence, other_thread.divergence, second.divergence],
+        [Divergence::First, Divergence::First, Divergence::Appended]
+    );
+    assert_eq!(second.matched_items, 2);
+}
+
+#[test]
+fn observed_requests_remember_their_head_for_usage_records() {
+    let request = lite_request("shell", history(/*len*/ 2));
+    let head = request_head(&request, /*head_items*/ 2);
+
+    observe_request("prefix-check-test-thread", request, /*head_items*/ 2);
+
+    assert_eq!(last_request_head("prefix-check-test-thread"), Some(head));
+    assert_eq!(last_request_head("another-thread"), None);
+}
+
+#[test]
+fn an_expected_head_is_checked_once_against_the_next_request() {
+    let mut chains = PrefixChains::default();
+    chains.expect_head("returning", "head-a".to_string());
+
+    assert_eq!(
+        [
+            chains.record_head("returning", "head-b".to_string()),
+            chains.record_head("returning", "head-a".to_string()),
+            chains.record_head("other", "head-a".to_string()),
+        ],
+        [Some(false), None, None]
+    );
+    chains.expect_head("returning", "head-a".to_string());
+    assert_eq!(
+        chains.record_head("returning", "head-a".to_string()),
+        Some(true)
+    );
+}
