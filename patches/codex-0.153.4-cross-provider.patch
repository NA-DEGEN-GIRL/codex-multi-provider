+//! Native name notifications for listed, unopened canonical records.
+
+use super::manager_record_catalog::CatalogFixture;
+use super::manager_record_catalog::READ_TIMEOUT;
+use anyhow::Context;
+use anyhow::Result;
+use app_test_support::TestAppServer;
+use codex_app_server_protocol::ThreadListResponse;
+use codex_app_server_protocol::ThreadLoadedListResponse;
+use codex_app_server_protocol::ThreadNameUpdatedNotification;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::fs;
+use std::path::PathBuf;
+use std::time::Duration;
+use tempfile::TempDir;
+use tokio::time::timeout;
+
+fn source_home(fixture: &CatalogFixture) -> Result<PathBuf> {
+    let manifest: Value = serde_json::from_slice(&fs::read(&fixture.manifest_path)?)?;
+    Ok(PathBuf::from(
+        manifest["entries"][0]["codexHome"]
+            .as_str()
+            .context("source home")?,
+    ))
+}
+
+async fn list(server: &mut TestAppServer, params: Value) -> Result<ThreadListResponse> {
+    let request = server.send_raw_request("thread/list", Some(params)).await?;
+    timeout(READ_TIMEOUT, server.read_response(request)).await?
+}
+
+async fn updated_name(server: &mut TestAppServer) -> Result<ThreadNameUpdatedNotification> {
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("thread/name/updated"),
+    )
+    .await??;
+    Ok(serde_json::from_value(
+        notification.params.context("name notification")?,
+    )?)
+}
+
+#[tokio::test]
+async fn legacy_name_changes_reach_both_listeners_without_opening_the_record() -> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let home = source_home(&fixture)?;
+    let original = fs::read(&fixture.rollout_path)?;
+    let original_manifest = fs::read(&fixture.manifest_path)?;
+    let other_home = TempDir::new()?;
+    let mut first = fixture.start_server().await?;
+    let mut second = TestAppServer::builder()
+        .with_codex_home(other_home.path())
+        .without_managed_config()
+        .with_env_overrides(&[
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            (
+                "CODEX_MANAGER_SHARED_CATALOG",
+                fixture.manifest_path.to_str(),
+            ),
+            ("CODEX_SQLITE_HOME", None),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    for server in [&mut first, &mut second] {
+        let response = list(server, json!({})).await?;
+        assert_eq!(response.data.len(), 1);
+        assert_eq!(response.data[0].name, None);
+    }
+    let id = ThreadId::from_string(&fixture.thread_id)?;
+    codex_rollout::append_thread_name(&home, id, "공통 작업 이름 수정").await?;
+    let index = fs::read(home.join("session_index.jsonl"))?;
+    for server in [&mut first, &mut second] {
+        assert_eq!(
+            updated_name(server).await?,
+            ThreadNameUpdatedNotification {
+                thread_id: fixture.projection_id.clone(),
+                thread_name: Some("공통 작업 이름 수정".to_string()),
+            }
+        );
+        let request = server
+            .send_raw_request("thread/loaded/list", Some(json!({})))
+            .await?;
+        let loaded: ThreadLoadedListResponse =
+            timeout(READ_TIMEOUT, server.read_response(request)).await??;
+        assert_eq!(loaded.data, Vec::<String>::new());
+    }
+    assert!(
+        timeout(Duration::from_secs(3), updated_name(&mut first))
+            .await
+            .is_err()
+    );
+    assert_eq!(fs::read(&fixture.rollout_path)?, original);
+    assert_eq!(fs::read(&fixture.manifest_path)?, original_manifest);
+    assert_eq!(fs::read(home.join("session_index.jsonl"))?, index);
+    assert!(!home.join("state_5.sqlite").exists());
+    Ok(())
+}
+
+#[tokio::test]
+async fn later_list_pages_join_the_existing_name_subscription() -> Result<()> {
+    let first = CatalogFixture::new()?;
+    let second = CatalogFixture::new()?;
+    let mut manifest: Value = serde_json::from_slice(&fs::read(&first.manifest_path)?)?;
+    let other: Value = serde_json::from_slice(&fs::read(&second.manifest_path)?)?;
+    let mut other_source = other["entries"][0].clone();
+    other_source["sourceStoreId"] = json!("fixture-second-source");
+    manifest["entries"]
+        .as_array_mut()
+        .context("entries")?
+        .push(other_source);
+    fs::write(&first.manifest_path, serde_json::to_vec(&manifest)?)?;
+    let mut server = first.start_server().await?;
+    let initial = list(&mut server, json!({"limit":1})).await?;
+    let next = list(
+        &mut server,
+        json!({"limit":1,"cursor":initial.next_cursor.context("next page")?}),
+    )
+    .await?;
+    assert_eq!(next.data.len(), 1);
+    let selected = if next.data[0].id == first.projection_id {
+        &first
+    } else {
+        &second
+    };
+    codex_rollout::append_thread_name(
+        &source_home(selected)?,
+        ThreadId::from_string(&selected.thread_id)?,
+        "A renamed record from the second page",
+    )
+    .await?;
+    assert_eq!(
+        updated_name(&mut server).await?,
+        ThreadNameUpdatedNotification {
+            thread_id: selected.projection_id.clone(),
+            thread_name: Some("A renamed record from the second page".to_string()),
+        }
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn paginated_name_update_and_clear_need_no_manifest_or_rollout_change() -> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let home = source_home(&fixture)?;
+    let id = ThreadId::from_string(&fixture.thread_id)?;
+    let original_manifest = fs::read(&fixture.manifest_path)?;
+    let mut lines = fs::read_to_string(&fixture.rollout_path)?
+        .lines()
+        .map(serde_json::from_str::<Value>)
+        .collect::<Result<Vec<_>, _>>()?;
+    lines[0]["payload"]["history_mode"] = json!("paginated");
+    let contents = lines
+        .into_iter()
+        .map(|line| line.to_string())
+        .collect::<Vec<_>>()
+        .join("\n");
+    fs::write(&fixture.rollout_path, format!("{contents}\n"))?;
+    let original = fs::read(&fixture.rollout_path)?;
+    let state = codex_state::StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(AbsolutePathBuf::from_absolute_path(&home)?),
+        "openai".to_string(),
+    )
+    .await?;
+    let mut builder = codex_state::ThreadMetadataBuilder::new(
+        id,
+        fixture.rollout_path.clone(),
+        chrono::Utc::now(),
+        SessionSource::Cli,
+    );
+    builder.cwd = home.clone();
+    let mut metadata = builder.build("openai");
+    metadata.history_mode = ThreadHistoryMode::Paginated;
+    metadata.name = Some("Initial paginated name".to_string());
+    state.upsert_thread(&metadata).await?;
+    let mut server = fixture.start_server().await?;
+    let listed = list(&mut server, json!({})).await?;
+    assert_eq!(listed.data[0].name, metadata.name);
+    for name in [Some("수정된 이름"), None] {
+        assert!(state.update_thread_name(id, name).await?);
+        assert_eq!(
+            updated_name(&mut server).await?,
+            ThreadNameUpdatedNotification {
+                thread_id: fixture.projection_id.clone(),
+                thread_name: name.map(str::to_string),
+            }
+        );
+    }
+    assert_eq!(fs::read(&fixture.rollout_path)?, original);
+    assert_eq!(fs::read(&fixture.manifest_path)?, original_manifest);
+    let request = server
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(loaded.data, Vec::<String>::new());
+    Ok(())
+}
