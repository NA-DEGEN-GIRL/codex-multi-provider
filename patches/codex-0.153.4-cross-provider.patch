+
+impl ManagedProfile {
+    fn new(endpoint: &str, model: &str, api_key: &str) -> Result<Self> {
+        let home = TempDir::new()?;
+        let profile_id = Uuid::new_v4().to_string();
+        let source_id = format!("manager:{profile_id}");
+        fs::write(
+            home.path().join("managed-source.json"),
+            serde_json::to_vec(&json!({ "host_id": "local", "store_id": source_id }))?,
+        )?;
+        MockResponsesConfig::new(endpoint)
+            .with_model(model)
+            .with_provider_config(
+                "env_key = \"CODEX_MANAGED_HANDOFF_TEST_KEY\"\nsupports_websockets = false",
+            )
+            .enable_feature(Feature::Goals)
+            .write(home.path())?;
+        let manifest_path = home.path().join("managed-sources.json");
+        Ok(Self {
+            home,
+            profile_id,
+            source_id,
+            manifest_path,
+            api_key: api_key.to_string(),
+        })
+    }
+
+    fn write_manifest(&self, sources: &[&Self], bindings: Vec<Value>) -> Result<()> {
+        let sources = sources
+            .iter()
+            .map(|source| {
+                json!({
+                    "hostId": "local",
+                    "sourceStoreId": source.source_id,
+                    "codexHome": source.home.path(),
+                })
+            })
+            .collect::<Vec<_>>();
+        let mut file = NamedTempFile::new_in(self.home.path())?;
+        file.write_all(&serde_json::to_vec(&json!({
+            "version": 1,
+            "hostId": "local",
+            "profileId": self.profile_id,
+            "sources": sources,
+            "bindings": bindings,
+        }))?)?;
+        file.persist(&self.manifest_path)?;
+        Ok(())
+    }
+
+    async fn start_server(&self) -> Result<TestAppServer> {
+        TestAppServer::builder()
+            .with_codex_home(self.home.path())
+            .without_managed_config()
+            .with_env_overrides(&[
+                (
+                    "CODEX_MANAGER_MANAGED_SOURCES",
+                    Some(self.manifest_path.to_str().context("UTF-8 manifest path")?),
+                ),
+                ("CODEX_MANAGED_HANDOFF_TEST_KEY", Some(&self.api_key)),
+                ("CODEX_MANAGER_RECORD_CATALOG", None),
+                ("CODEX_SQLITE_HOME", None),
+                ("OPENAI_API_KEY", None),
+                ("CODEX_ACCESS_TOKEN", None),
+            ])
