+
+impl<'a> CompactionRequest<'a> {
+    fn new(turn_context: &'a TurnContext, step_context: Option<&'a StepContext>) -> Self {
+        match step_context {
+            Some(step_context) => Self {
+                model_info: &step_context.settings.model_info,
+                session_telemetry: &step_context.session_telemetry,
+                effort: step_context.settings.reasoning_effort().cloned(),
+                summary: step_context.settings.reasoning_summary,
+                service_tier: step_context.settings.service_tier.clone(),
+            },
+            None => Self {
+                model_info: turn_context.model_info(),
+                session_telemetry: &turn_context.session_telemetry,
+                effort: turn_context.reasoning_effort().cloned(),
+                summary: turn_context.reasoning_summary(),
+                service_tier: turn_context.config.service_tier.clone(),
+            },
+        }
+    }
+}
