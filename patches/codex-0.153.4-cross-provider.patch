+                    uncertain.thread_id(),
+                    unrelated.thread_id()
+                ],
+            )
+            .await
+            .is_err()
+    );
+    assert!(!uncertain.is_released());
+    assert_eq!(
+        std::fs::read(&path).expect("uncertain child unchanged"),
+        before
+    );
+    fixture
+        .manager
+        .state
+        .check_managed_startup_uncertainty(&[unrelated.thread_id()])
+        .expect("failed preflight does not poison another child");
+    assert!(!unrelated.is_released());
+    drop(admission);
