+#[tokio::test]
+async fn manager_catalog_rejects_resume_path_filesystem_write_and_command_before_dispatch()
+-> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let original_bytes = fs::read(&fixture.rollout_path)?;
+    let write_path = fixture.source_home.path().join("forbidden.txt");
+    let mut server = fixture.start_server().await?;
+    for (method, params) in [
+        (
+            "thread/resume",
+            json!({ "threadId": fixture.thread_id, "path": fixture.rollout_path }),
+        ),
+        (
+            "fs/writeFile",
+            json!({ "path": write_path, "dataBase64": "bXV0YXRlZA==" }),
+        ),
+        (
+            "command/exec",
+            json!({ "command": ["codex-manager-catalog-test-must-not-launch"] }),
+        ),
+    ] {
+        let request_id = server.send_raw_request(method, Some(params)).await?;
+        let actual = timeout(
+            READ_TIMEOUT,
+            server.read_stream_until_error_message(RequestId::Integer(request_id)),
+        )
+        .await??;
+        assert_eq!(
+            actual,
+            JSONRPCError {
+                id: RequestId::Integer(request_id),
+                error: JSONRPCErrorError {
+                    code: -32600,
+                    message: if method == "thread/resume" {
+                        "This instance is a read-only record catalog. Viewing accepts only a registered projection thread ID; path and injected history are disabled."
+                    } else {
+                        "This instance is a read-only record catalog. Open the canonical task in its assigned profile to run or change it. This operation is not supported by the catalog viewer."
+                    }.to_string(),
+                    data: None,
+                },
+            },
+            "unexpected response for {method}",
+        );
+    }
+
+    let loaded_id = server
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, server.read_response(loaded_id)).await??;
+    assert_eq!(
+        loaded,
+        ThreadLoadedListResponse {
+            data: Vec::new(),
+            next_cursor: None,
+        }
+    );
+    assert!(!write_path.exists());
+    fixture.assert_source_untouched(&original_bytes)?;
+    Ok(())
+}
