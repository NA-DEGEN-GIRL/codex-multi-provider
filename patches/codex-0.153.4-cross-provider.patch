+#[tokio::test]
+async fn fork_reader_inherits_only_frozen_prefix_and_preserves_parent_metadata() {
+    let fixture = paginated_fixture().await;
+    let prepared = fixture
+        .store
+        .prepare_fork(PrepareForkParams {
+            thread_id: fixture.thread_id,
+            boundary: ForkBoundary::ThroughTurn("turn-1".to_string()),
+        })
+        .await
+        .expect("freeze parent prefix before excluded second turn");
+    let child_id = ThreadId::new();
+    let mut params = create_params(fixture.home.path(), child_id);
+    params.session_id = fixture.thread_id.into();
+    params.parent_thread_id = Some(fixture.thread_id);
+    params.forked_from_id = Some(fixture.thread_id);
+    params.history_base = prepared.history_base;
+    fixture
+        .store
+        .create_thread(params)
+        .await
+        .expect("create reference-backed child");
+    fixture
+        .store
+        .append_items(AppendThreadItemsParams {
+            thread_id: child_id,
+            items: completed_turn(child_id, "child-turn"),
+        })
+        .await
+        .expect("append child's own turn");
+    fixture
+        .store
+        .persist_thread(child_id, PersistContext::Standard)
+        .await
+        .expect("persist child reference");
+    drop(prepared);
+    let child_path = fixture
+        .store
+        .live_rollout_path(child_id)
+        .await
+        .expect("child rollout path");
+    fixture
+        .store
+        .shutdown_thread(child_id)
+        .await
+        .expect("commit child projection");
+    codex_rollout::state_db::reconcile_rollout(
+        Some(fixture.state.as_ref()),
+        child_path.as_path(),
+        "test-provider",
+        None,
+        &[],
+        Some(false),
+        None,
+    )
+    .await;
+    let before = source_snapshot(fixture.home.path());
+    let reader = ReadOnlyLocalThreadStore::open(
+        fixture.home.path().to_path_buf(),
+        test_config(fixture.home.path()).sqlite,
+    )
+    .await
+    .expect("open forked source read-only");
+
+    let child = reader
+        .read_thread(read_params(child_id))
+        .await
+        .expect("read child metadata");
+    assert_eq!(child.thread_id, child_id);
+    assert_eq!(child.parent_thread_id, Some(fixture.thread_id));
+    assert_eq!(child.forked_from_id, Some(fixture.thread_id));
+    let turns = reader
+        .list_turns(turn_params(child_id, None, 10))
+        .await
+        .expect("read child lineage");
+    assert_eq!(turn_ids(&turns), vec!["turn-1", "child-turn"]);
+    let items = reader
+        .list_items(item_params(child_id, None, 10))
+        .await
+        .expect("read child item lineage");
+    assert_eq!(
+        items
+            .items
+            .iter()
+            .map(|item| item.item_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["item-turn-1", "item-child-turn"]
+    );
+    assert_eq!(
+        turn_ids(
+            &reader
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .expect("parent still contains its excluded second turn")
+        ),
+        vec!["turn-1", "turn-2"]
+    );
+    reader.close().await;
+    assert_source_unchanged(fixture.home.path(), &before);
+}
