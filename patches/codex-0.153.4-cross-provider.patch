+/// The portable summary beside a compaction sends the compaction's request with only its last
+/// input item replaced, so the provider can serve everything before it from its prompt cache.
+#[test]
+fn portable_summary_request_differs_from_its_compaction_only_in_the_last_item() -> anyhow::Result<()>
+{
+    let mut client = test_model_client(SessionSource::Cli);
+    Arc::get_mut(&mut client.state)
+        .expect("test client should have unique session state")
+        .provider = create_model_provider(
+        ModelProviderInfo::create_openai_provider(/*base_url*/ None),
+        /*auth_manager*/ None,
+    );
+    let message = |role: &str, content: ContentItem| ResponseItem::Message {
+        id: None,
+        role: role.to_string(),
+        content: vec![content],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let compaction = Prompt {
+        input: vec![
+            message(
+                "user",
+                ContentItem::InputText {
+                    text: "question".to_string(),
+                },
+            ),
+            message(
+                "assistant",
+                ContentItem::OutputText {
+                    text: "answer".to_string(),
+                },
+            ),
+            ResponseItem::CompactionTrigger {},
+        ],
+        tools: vec![codex_tools::ToolSpec::Freeform(codex_tools::FreeformTool {
+            name: "exec".to_string(),
+            description: "Execute JavaScript.".to_string(),
+            defer_loading: None,
+            format: codex_tools::FreeformToolFormat {
+                r#type: "grammar".to_string(),
+                syntax: "lark".to_string(),
+                definition: "start: /.+/".to_string(),
+            },
+        })]
+        .into(),
+        parallel_tool_calls: true,
+        base_instructions: BaseInstructions {
+            text: "base instructions".to_string(),
+            provenance: None,
+        },
+        ..Default::default()
+    };
+    let summary = crate::portable_context::portable_summary_prompt(
+        &compaction,
+        Some("Summarize the conversation."),
+    );
+    let metadata = test_responses_metadata_for_client(
+        &client,
+        Some("turn-1"),
+        format!("{}:0", client.state.thread_id),
+        /*parent_thread_id*/ None,
+        TestCodexResponsesRequestKind::Turn,
+    );
+
+    for use_responses_lite in [true, false] {
+        let mut model = test_model_info();
+        model.use_responses_lite = use_responses_lite;
+        model.supports_reasoning_summary_parameter = true;
+        model.supported_reasoning_levels = [ReasoningEffort::Low, ReasoningEffort::High]
+            .into_iter()
+            .map(|effort| ReasoningEffortPreset {
+                description: effort.to_string(),
+                effort,
+            })
+            .collect();
+        model.service_tiers = vec![codex_protocol::openai_models::ModelServiceTier {
+            id: "priority".to_string(),
+            name: "Fast".to_string(),
+            description: "Priority processing.".to_string(),
+        }];
+        let build =
+            |prompt: &Prompt| -> anyhow::Result<(serde_json::Value, Vec<serde_json::Value>)> {
+                let request = client.build_responses_request(
+                    prompt,
+                    &model,
+                    Some(ReasoningEffort::High),
+                    codex_protocol::config_types::ReasoningSummary::Concise,
+                    Some("priority".to_string()),
+                    &metadata,
+                )?;
+                let mut body = serde_json::to_value(request)?;
+                let input = body
+                    .as_object_mut()
+                    .and_then(|body| body.remove("input"))
+                    .and_then(|input| input.as_array().cloned())
+                    .expect("request input");
+                Ok((body, input))
+            };
+
+        let (compaction_body, compaction_input) = build(&compaction)?;
+        let (summary_body, summary_input) = build(&summary)?;
+
+        assert_eq!(summary_body, compaction_body, "lite={use_responses_lite}");
+        assert_eq!(compaction_body["reasoning"]["effort"], "high");
+        assert_eq!(compaction_body["reasoning"]["summary"], "concise");
+        assert_eq!(compaction_body["service_tier"], "priority");
+        let (trigger, prefix) = compaction_input.split_last().expect("compaction input");
+        assert_eq!(trigger["type"], "compaction_trigger");
+        assert_eq!(summary_input.len(), compaction_input.len());
+        assert_eq!(&summary_input[..prefix.len()], prefix);
+        assert_eq!(summary_input[prefix.len()]["role"], "user");
+        if use_responses_lite {
+            // Tools and instructions lead the input, ahead of the history.
+            assert_eq!(prefix[0]["type"], "additional_tools");
+            assert_eq!(prefix[1]["role"], "developer");
+            assert!(compaction_body.get("tools").is_none());
+        } else {
+            assert_eq!(compaction_body["tools"][0]["name"], "exec");
+            assert_eq!(compaction_body["instructions"], "base instructions");
+        }
+    }
+    Ok(())
+}
