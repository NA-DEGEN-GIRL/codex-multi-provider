+    let response = catalog
+        .read(
+            ThreadReadParams {
+                thread_id: PROJECTION_A.to_string(),
+                include_turns: true,
+            },
+            &cwd(temp.path()),
+        )
+        .await
+        .unwrap();
+    let items = response
+        .thread
+        .turns
+        .iter()
+        .flat_map(|turn| &turn.items)
+        .collect::<Vec<_>>();
+    let serialized = serde_json::to_value(&items).unwrap();
+    assert!(
+        items
+            .iter()
+            .any(|item| matches!(item, ThreadItem::CollabAgentToolCall { .. }))
+    );
+    assert!(
+        items
+            .iter()
+            .any(|item| matches!(item, ThreadItem::SubAgentActivity { .. }))
+    );
+    assert!(serialized.to_string().contains(PROJECTION_A));
+    assert!(serialized.to_string().contains(PROJECTION_B));
+    assert!(!serialized.to_string().contains(THREAD_A));
+    assert!(!serialized.to_string().contains(THREAD_B));
+    assert_eq!(fs::read(&parent_path).unwrap(), before);
