+struct RefusingResolver;
+
+impl ExecutionPresetAuthResolver for RefusingResolver {
+    fn resolve(
+        &self,
+        _request: codex_app_server_protocol::ExecutionPresetAuthTokensReadParams,
+    ) -> ExternalAuthFuture<'_, codex_app_server_protocol::ExecutionPresetAuthTokensReadResponse>
+    {
+        Box::pin(async {
+            Err(std::io::Error::other(
+                codex_app_server_protocol::ExecutionPresetAuthRefusal::ClaudeLongLivedRejected,
+            ))
+        })
+    }
+}
