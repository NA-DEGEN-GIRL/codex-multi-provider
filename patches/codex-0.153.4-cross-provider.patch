+use super::*;
+use crate::CreateThreadParams;
+use crate::LiveThread;
+use crate::LoadThreadHistoryParams;
+use crate::PersistContext;
+use crate::ReadThreadParams;
+use crate::ResumeThreadParams;
+use crate::ThreadMetadataPatch;
+use crate::ThreadPersistenceMetadata;
+use crate::ThreadStore;
+use crate::UpdateThreadMetadataParams;
+use codex_protocol::models::BaseInstructions;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_protocol::protocol::ThreadMemoryMode;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+
+fn registration(home: &std::path::Path, id: &ManagedSourceId) -> ManagedSourceRegistration {
+    ManagedSourceRegistration {
+        source_id: id.clone(),
+        config: LocalThreadStoreConfig {
+            codex_home: home.to_path_buf(),
+            sqlite: codex_state::SqliteConfig::new_for_testing(
+                AbsolutePathBuf::try_from(home.to_path_buf()).expect("absolute home"),
+            ),
+            default_model_provider_id: "test-provider".to_string(),
+        },
+    }
+}
+
+fn source_id() -> ManagedSourceId {
+    ManagedSourceId {
+        host_id: "local".to_string(),
+        store_id: format!("manager:{}", ThreadId::new()),
+    }
+}
+
+fn profile_id(source: &ManagedSourceId) -> String {
+    source
+        .store_id
+        .strip_prefix("manager:")
+        .expect("manager store")
+        .to_string()
+}
+
+fn advance_owner(
+    home: &std::path::Path,
+    source: &ManagedSourceId,
+    thread_id: ThreadId,
+    grant: &ManagedAuthorityGrant,
+) {
+    let record = serde_json::json!({
+        "version": 1, "host_id": source.host_id, "store_id": source.store_id,
+        "thread_id": thread_id, "owner_profile_id": grant.owner_profile_id,
+        "epoch": grant.epoch, "revision": grant.revision,
+    });
+    let path = home
+        .join("managed-authority")
+        .join(format!("{thread_id}.json"));
+    let cas_guard = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(path.with_extension("guard"))
+        .expect("CAS guard");
+    cas_guard
+        .try_lock()
+        .expect("no outstanding canonical writes");
+    let temporary = path.with_extension("tmp");
+    std::fs::write(&temporary, serde_json::to_vec(&record).expect("authority")).expect("temporary");
+    std::fs::rename(temporary, path).expect("atomic authority replacement");
+}
