new file mode 100644
index 000000000..27687aef3
--- /dev/null
+++ b/codex-rs/core/src/tasks/claude_code/auth_refresh.rs
@@ -0,0 +1,247 @@
+//! Renews the Claude access token lent for this turn when the runner asks.
+//!
+//! The runner asks with `{"type":"auth_refresh","reason":...}` only after the hello
+//! announced `"auth_refresh":1` (and `"auth_rotate":1` for live rotation), which is sent
+//! only when this turn lent it a token. Every request gets exactly one `auth_update`, in
+//! order; the token never reaches logs, events or errors.
+//!
+//! With `"auth_sources":1` a lent credential also names its source. When Claude refuses a
+//! saved long-lived token the runner sends `{"type":"auth_rejected","credential_id":...}`
+//! (no reply) and may ask with reason `switch` and `rejected_credential_id`; every later read
+//! of the turn reports that ID, so the broker records it and lends the PC login instead.
+use std::future::Future;
+use std::time::Duration;
+use std::time::Instant;
+
+use codex_app_server_protocol::ExecutionPresetAuthRefusal;
+use codex_app_server_protocol::ExecutionPresetAuthTokensReadResponse;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use serde_json::Value;
+use serde_json::json;
+use tokio_util::sync::CancellationToken;
+
+use super::bridge::failure;
+
+/// One expired launch is resumed, with one retry while the host is still renewing the login.
+const EXPIRY_REQUESTS: u8 = 2;
+/// The same for a switch to another credential source after the lent one was rejected.
+const SWITCH_REQUESTS: u8 = 2;
+/// Live rotations keep a running CLI signed in across long turns: about one per token
+/// lifetime, plus retries spaced by the runner and by this interval.
+const ROTATIONS: u16 = 32;
+const ROTATION_INTERVAL: Duration = Duration::from_secs(15);
+/// The manager transport answers within 30 seconds; never hold the turn much longer.
+const RESOLVE_TIMEOUT: Duration = Duration::from_secs(35);
+
+/// Why the runner asks. Each reason has its own budget, so rotations during a long turn
+/// never use up the renewal that resumes an expired launch, and neither uses up a switch.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Reason {
+    /// The CLI stopped on an expired login and the runner relaunches it; older runners send
+    /// no reason.
+    Expired,
+    /// The lent credential was rejected and the runner continues with another source.
+    Switch,
+    /// A running CLI receives the renewed token without stopping.
+    Rotate,
+    Unknown,
+}
+
+impl Reason {
+    pub(super) fn of(request: &Value) -> Self {
+        match request.get("reason") {
+            None | Some(Value::Null) => Self::Expired,
+            Some(reason) => match reason.as_str() {
+                Some("expired") => Self::Expired,
+                Some("switch") => Self::Switch,
+                Some("rotate") => Self::Rotate,
+                _ => Self::Unknown,
+            },
+        }
+    }
+}
+
+pub(super) struct AuthRefresh {
+    borrowed: bool,
+    expired: u8,
+    switched: u8,
+    rotations: u16,
+    last_rotation: Option<Instant>,
+}
+
+impl AuthRefresh {
+    pub(super) fn borrowed() -> Self {
+        Self {
+            borrowed: true,
+            expired: 0,
+            switched: 0,
+            rotations: 0,
+            last_rotation: None,
+        }
+    }
+
+    pub(super) fn unavailable() -> Self {
+        Self {
+            borrowed: false,
+            ..Self::borrowed()
+        }
+    }
+
+    /// Only a token this turn lent can be renewed; older runners ignore the hello flags.
+    pub(super) fn announced(&self) -> bool {
+        self.borrowed
+    }
+
+    /// Counts a request against its reason's budget; `false` means the reply is
+    /// `available:false` at once, without asking the host.
+    pub(super) fn admit(&mut self, reason: Reason, now: Instant) -> bool {
+        fn take(used: &mut u8, budget: u8) -> bool {
+            let admitted = *used < budget;
+            *used += u8::from(admitted);
+            admitted
+        }
+        if !self.borrowed {
+            return false;
+        }
+        match reason {
+            Reason::Expired => take(&mut self.expired, EXPIRY_REQUESTS),
+            Reason::Switch => take(&mut self.switched, SWITCH_REQUESTS),
+            Reason::Rotate => {
+                let early = self
+                    .last_rotation
+                    .is_some_and(|last| now.duration_since(last) < ROTATION_INTERVAL);
+                if early || self.rotations >= ROTATIONS {
+                    return false;
+                }
+                self.rotations += 1;
+                self.last_rotation = Some(now);
+                true
+            }
+            Reason::Unknown => false,
+        }
+    }
+}
+
+pub(super) fn unavailable() -> Value {
+    json!({"type":"auth_update","available":false})
+}
+
+/// The turn's error when its account cannot be lent; a listed broker refusal says why.
+pub(super) fn unavailable_account(error: &anyhow::Error) -> CodexErr {
+    let refusal = error
+        .downcast_ref::<std::io::Error>()
+        .and_then(std::io::Error::get_ref)
+        .and_then(|inner| inner.downcast_ref::<ExecutionPresetAuthRefusal>());
+    match refusal {
+        Some(refusal) => failure(refusal),
+        None => failure("the selected Claude account is unavailable"),
+    }
+}
+
+/// Resolves the turn's account again with the same request as the turn start.
+pub(super) async fn respond(
+    profile_id: &str,
+    resolve: impl Future<Output = anyhow::Result<Option<ExecutionPresetAuthTokensReadResponse>>>,
+    cancellation: &CancellationToken,
+) -> Result<Value> {
+    let resolved = tokio::select! {
+        biased;
+        _ = cancellation.cancelled() => return Err(CodexErr::TurnAborted),
+        resolved = tokio::time::timeout(RESOLVE_TIMEOUT, resolve) => resolved,
+    };
+    // A refused, changed or late account is reported by the runner's own error.
+    let Ok(Ok(Some(response))) = resolved else {
+        return Ok(unavailable());
+    };
+    Ok(match credentials(profile_id, &response) {
+        Ok(credentials) => json!({"type":"auth_update","available":true,"credentials":credentials}),
+        Err(_) => unavailable(),
+    })
+}
+
+/// The access-only credential the runner validates; the refresh token never leaves the host.
+///
+/// The source keys are added only when the broker reported them, which it does only for a
+/// runtime and a prepared helper that both accept them; older helpers require four keys.
+pub(super) fn credentials(
+    profile_id: &str,
+    response: &ExecutionPresetAuthTokensReadResponse,
+) -> Result<Value> {
+    if response.kind != "claude" {
+        return Err(failure("the selected credential is not a Claude account"));
+    }
+    let mut credentials = json!({
+        "profileId": profile_id,
+        "accessToken": response.access_token,
+        "expiresAt": response.expires_at,
+        "accountIdentity": response.account_identity,
+    });
+    if let Some(source) = &response.credential_source {
+        credentials["credentialSource"] = json!(source);
+        credentials["credentialId"] = json!(response.credential_id);
+    }
+    Ok(credentials)
+}
+
+/// Long-lived credentials this turn lent, and the one its runner reported as refused.
+///
+/// A report names a credential ID; only one this turn lent is accepted (and only once), so a
+/// runner cannot make the host record another profile's token.
+#[derive(Debug, Default)]
+pub(super) struct Lent {
+    ids: Vec<String>,
+    refused: Option<String>,
+}
+
+impl Lent {
+    /// Remembers the long-lived credential in a lent credential JSON or an `auth_update`.
+    pub(super) fn record(&mut self, credentials: &Value) {
+        let credentials = credentials.get("credentials").unwrap_or(credentials);
+        if credentials["credentialSource"] == "longLivedToken"
+            && let Some(id) = credentials["credentialId"].as_str()
+            && !self.ids.iter().any(|lent| lent == id)
+        {
+            self.ids.push(id.to_string());
+        }
+    }
+
+    /// The newly refused credential named by `id`, if this turn lent it and it was not yet
+    /// reported.
+    pub(super) fn refuse(&mut self, id: &Value) -> Option<String> {
+        let id = id.as_str()?;
+        if !self.ids.iter().any(|lent| lent == id) || self.refused.as_deref() == Some(id) {
+            return None;
+        }
+        self.refused = Some(id.to_string());
+        self.refused.clone()
+    }
+
+    /// The refused credential every later read of this turn reports, so it is never lent again.
+    pub(super) fn refused(&self) -> Option<&str> {
+        self.refused.as_deref()
+    }
+}
+
+/// Reports a refused long-lived credential to the host without waiting for it: the broker
+/// records the refusal before it answers, so the next turn is lent another credential even
+/// when this one stops right away. The lent replacement is dropped unread.
+pub(super) fn report_refusal<F>(resolve: F)
+where
+    F: Future<Output = anyhow::Result<Option<ExecutionPresetAuthTokensReadResponse>>>
+        + Send
+        + 'static,
+{
+    tokio::spawn(async move {
+        if !matches!(
+            tokio::time::timeout(RESOLVE_TIMEOUT, resolve).await,
+            Ok(Ok(Some(_)))
+        ) {
+            tracing::debug!("the host did not confirm a refused Claude credential");
+        }
+    });
+}
+
+#[cfg(test)]
+#[path = "auth_refresh_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/tasks/claude_code/auth_refresh_tests.rs b/codex-rs/core/src/tasks/claude_code/auth_refresh_tests.rs
