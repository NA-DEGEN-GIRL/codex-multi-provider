+/// Rewrites a legacy rollout as a runtime without provider tracking would have written it.
+fn forget_recorded_providers(codex_home: &Path, thread_id: &str) -> Result<()> {
+    let mut pending = vec![codex_home.join("sessions")];
+    let mut rewritten = 0;
+    while let Some(dir) = pending.pop() {
+        for entry in std::fs::read_dir(&dir)? {
+            let path = entry?.path();
+            if path.is_dir() {
+                pending.push(path);
+                continue;
+            }
+            let name = path
+                .file_name()
+                .and_then(|name| name.to_str())
+                .unwrap_or_default();
+            if !name.contains(thread_id) || !name.ends_with(".jsonl") {
+                continue;
+            }
+            let lines = std::fs::read_to_string(&path)?
+                .lines()
+                .map(|line| {
+                    let mut value: Value = serde_json::from_str(line)?;
+                    if let Some(payload) = value["payload"].as_object_mut() {
+                        payload.remove("model_provider");
+                        payload.remove("origin");
+                        payload.remove("portable");
+                    }
+                    Ok(serde_json::to_string(&value)?)
+                })
+                .collect::<Result<Vec<_>>>()?;
+            std::fs::write(&path, lines.join("\n") + "\n")?;
+            rewritten += 1;
+        }
+    }
+    assert_eq!(rewritten, 1, "expected one rollout for {thread_id}");
+    Ok(())
+}
