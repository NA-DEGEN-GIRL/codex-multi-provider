+    assign_turn_states: bool,
+    /// Report DeepSeek turn usage as a real tokenizer would count the request, instead of a
+    /// fixed count.
+    realistic_usage: bool,
+    /// Give reasoning items a plaintext summary beside their encrypted content.
+    reasoning_summaries: bool,
+    /// The [`TOOL_TURN`] tool calls were already answered.
+    tool_calls_sent: bool,
+    next_response: u64,
+}
+
+/// Answers every `/responses` request of both providers by its shape.
+#[derive(Clone, Default)]
+struct ProviderMock {
+    state: Arc<Mutex<ProviderMockState>>,
+}
+
+impl ProviderMock {
+    async fn start(fail_portable_summary: bool) -> (MockServer, Self) {
+        let server = responses::start_mock_server().await;
+        let mock = Self::default();
+        mock.state.lock().expect("mock state").fail_portable_summary = fail_portable_summary;
+        Mock::given(method("POST"))
+            .and(path_regex(".*/responses$"))
+            .respond_with(mock.clone())
+            .mount(&server)
+            .await;
+        (server, mock)
+    }
+
+    fn request_count(&self) -> usize {
+        self.state.lock().expect("mock state").requests.len()
+    }
+
+    fn report_realistic_usage(&self) {
+        self.state.lock().expect("mock state").realistic_usage = true;
+    }
+
+    fn report_reasoning_summaries(&self) {
+        self.state.lock().expect("mock state").reasoning_summaries = true;
+    }
+
+    fn answer_summaries_with_a_tool_call(&self) {
+        self.state.lock().expect("mock state").summary_calls_tool = true;
+    }
+
+    fn answer_local_compactions_with_a_tool_call(&self) {
+        self.state
+            .lock()
+            .expect("mock state")
+            .local_compaction_calls_tool = true;
+    }
+
+    fn assign_turn_states(&self) {
+        self.state.lock().expect("mock state").assign_turn_states = true;
+    }
+
+    fn requests_since(&self, start: usize) -> Vec<Value> {
+        self.state.lock().expect("mock state").requests[start..].to_vec()
+    }
+
+    /// The requests after `start` with the sticky-routing turn state each one sent.
+    fn requests_with_turn_states_since(&self, start: usize) -> Vec<(Value, Option<String>)> {
+        let state = self.state.lock().expect("mock state");
+        state.requests[start..]
+            .iter()
+            .cloned()
+            .zip(state.request_turn_states[start..].iter().cloned())
+            .collect()
+    }
+
+    /// First request `model` received after `start`, of any kind.
+    fn first_request_since(&self, start: usize, model: &str) -> Value {
+        self.requests_since(start)
+            .into_iter()
+            .find(|body| body["model"] == model)
+            .unwrap_or_else(|| panic!("expected a {model} request"))
+    }
+}
+
+impl Respond for ProviderMock {
+    fn respond(&self, request: &Request) -> ResponseTemplate {
+        let body: Value = serde_json::from_slice(&request.body).expect("uncompressed JSON body");
+        let mut state = self.state.lock().expect("mock state");
+        state.next_response += 1;
+        let id = format!("resp-{}", state.next_response);
+        state.requests.push(body.clone());
+        state.request_turn_states.push(
+            request
+                .headers
+                .get(TURN_STATE_HEADER)
+                .and_then(|value| value.to_str().ok())
+                .map(ToString::to_string),
+        );
+        let is_gpt = body["model"] == GPT_MODEL;
+        let is_xai = body["model"] == XAI_MODEL;
+        match request_kind(&body) {
+            RequestKind::NativeCompaction => responses::sse_response(responses::sse(vec![
+                responses::ev_response_created(&id),
+                json!({
+                    "type": "response.output_item.done",
+                    "item": {"type": "compaction", "encrypted_content": GPT_CHECKPOINT},
+                }),
+                responses::ev_completed_with_tokens(&id, /*total_tokens*/ 20),
+            ])),
+            RequestKind::Summary if is_gpt && state.fail_portable_summary => {
+                ResponseTemplate::new(400).set_body_json(json!({
+                    "error": {"message": "summary rejected", "type": "invalid_request_error"}
+                }))
+            }
+            RequestKind::Summary if is_gpt => {
+                let reply = if state.summary_calls_tool {
+                    let plan = json!({"plan": [{"step": "summarize", "status": "completed"}]});
+                    responses::ev_function_call(SUMMARY_TOOL_CALL, "update_plan", &plan.to_string())
+                } else {
+                    responses::ev_assistant_message(&format!("msg-{id}"), GPT_PORTABLE_SUMMARY)
+                };
+                responses::sse_response(responses::sse(vec![
+                    responses::ev_response_created(&id),
+                    reply,
+                    json!({
+                        "type": "response.completed",
+                        "response": {
+                            "id": id,
+                            "usage": {
+                                "input_tokens": SUMMARY_INPUT_TOKENS,
+                                "input_tokens_details": {"cached_tokens": SUMMARY_CACHED_INPUT_TOKENS},
+                                "output_tokens": SUMMARY_OUTPUT_TOKENS,
+                                "output_tokens_details": {"reasoning_tokens": SUMMARY_REASONING_TOKENS},
+                                "total_tokens": SUMMARY_INPUT_TOKENS + SUMMARY_OUTPUT_TOKENS,
+                            },
+                        },
+                    }),
+                ]))
+                .set_delay(SUMMARY_DELAY)
+            }
+            RequestKind::Summary if state.local_compaction_calls_tool && offers_tools(&body) => {
+                let plan = json!({"plan": [{"step": "summarize", "status": "completed"}]});
+                responses::sse_response(responses::sse(vec![
+                    responses::ev_response_created(&id),
+                    responses::ev_function_call(
+                        SUMMARY_TOOL_CALL,
+                        "update_plan",
+                        &plan.to_string(),
+                    ),
+                    responses::ev_completed_with_tokens(&id, /*total_tokens*/ 20),
+                ]))
+            }
+            RequestKind::Summary => responses::sse_response(responses::sse(vec![
+                responses::ev_response_created(&id),
+                responses::ev_assistant_message(&format!("msg-{id}"), DEEPSEEK_SUMMARY),
+                responses::ev_completed_with_tokens(&id, /*total_tokens*/ 20),
+            ])),
+            RequestKind::Turn => {
+                let question = last_user_text(&body);
+                // Two tool calls whose usage crosses the auto-compaction limit, so GPT compacts
+                // mid-turn with the tool outputs as the newest history.
+                if is_gpt && question.contains(TOOL_TURN) && !state.tool_calls_sent {
+                    state.tool_calls_sent = true;
+                    let plan = json!({"plan": [{"step": "check", "status": "completed"}]});
+                    let response = responses::sse_response(responses::sse(vec![
+                        responses::ev_response_created(&id),
+                        responses::ev_function_call(
+                            "call-plan-1",
+                            "update_plan",
+                            &plan.to_string(),
+                        ),
+                        responses::ev_function_call(
+                            "call-plan-2",
+                            "update_plan",
+                            &plan.to_string(),
+                        ),
+                        responses::ev_completed_with_tokens(&id, TOOL_TURN_COMPACT_LIMIT + 10_000),
+                    ]));
+                    return if state.assign_turn_states {
+                        response
+                            .insert_header(TURN_STATE_HEADER, format!("turn-state-{id}").as_str())
+                    } else {
+                        response
+                    };
+                }
+                let question = question.chars().take(40).collect::<String>();
+                let mut events = vec![responses::ev_response_created(&id)];
+                // Encrypted-only reasoning is state only the provider that produced it can read.
+                let reasoning = if is_gpt {
+                    Some(GPT_REASONING)
+                } else if is_xai {
+                    Some(XAI_REASONING)
+                } else {
+                    None
+                };
+                if let Some(reasoning) = reasoning {
+                    let summary = match (state.reasoning_summaries, is_gpt) {
+                        (false, _) => json!([]),
+                        (true, true) => {
+                            json!([{"type": "summary_text", "text": GPT_REASONING_SUMMARY}])
+                        }
+                        (true, false) => {
+                            json!([{"type": "summary_text", "text": XAI_REASONING_SUMMARY}])
+                        }
+                    };
+                    events.push(json!({
+                        "type": "response.output_item.done",
+                        "item": {
+                            "type": "reasoning",
+                            "id": format!("rs-{id}"),
+                            "summary": summary,
+                            "encrypted_content": reasoning,
+                        },
+                    }));
+                }
+                let speaker = if is_gpt {
+                    "GPT"
+                } else if is_xai {
+                    "XAI"
+                } else {
+                    "DEEPSEEK"
+                };
+                events.push(responses::ev_assistant_message(
+                    &format!("msg-{id}"),
+                    &format!("{speaker} REPLY TO {question}"),
+                ));
+                let total_tokens = if state.realistic_usage && body["model"] == DEEPSEEK_MODEL {
+                    realistic_tokens(&body)
+                } else {
+                    20
+                };
+                events.push(responses::ev_completed_with_tokens(&id, total_tokens));
+                let response = responses::sse_response(responses::sse(events));
+                if is_gpt && state.assign_turn_states {
+                    response.insert_header(TURN_STATE_HEADER, format!("turn-state-{id}").as_str())
+                } else {
+                    response
+                }
+            }
+        }
+    }
+}
+
+/// Tokens a real tokenizer would count for a request: four ASCII bytes per token, and 1.3 tokens
+/// per other character, as Korean text costs.
+fn realistic_tokens(body: &Value) -> i64 {
+    let text = body.to_string();
+    let ascii_bytes = text.bytes().filter(u8::is_ascii).count();
+    let other_chars = text.chars().filter(|ch| !ch.is_ascii()).count();
+    i64::try_from(ascii_bytes / 4 + other_chars * 13 / 10).unwrap_or(i64::MAX)
+}
+
+fn request_kind(body: &Value) -> RequestKind {
+    let input = body["input"].as_array().cloned().unwrap_or_default();
+    if input
+        .iter()
+        .any(|item| item["type"] == "compaction_trigger")
+    {
+        return RequestKind::NativeCompaction;
+    }
+    if input
+        .last()
+        .is_some_and(|item| item["role"] == "user" && item.to_string().contains(COMPACT_PROMPT))
+    {
+        return RequestKind::Summary;
+    }
+    RequestKind::Turn
+}
+
+/// Whether a request offers the model any tools, as request fields or Responses Lite items.
+fn offers_tools(body: &Value) -> bool {
+    body["tools"]
+        .as_array()
+        .is_some_and(|tools| !tools.is_empty())
+        || body["input"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .any(|item| item["type"] == "additional_tools")
+}
+
+fn last_user_text(body: &Value) -> String {
+    body["input"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter(|item| item["role"] == "user")
+        .filter_map(|item| item["content"][0]["text"].as_str())
+        .next_back()
+        .unwrap_or_default()
+        .to_string()
+}
+
+fn input_types(body: &Value) -> Vec<String> {
+    body["input"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|item| item["type"].as_str().map(ToString::to_string))
+        .collect()
+}
+
+fn input_text(body: &Value) -> String {
+    body["input"].to_string()
+}
+
+fn occurrences(body: &Value, needle: &str) -> usize {
+    input_text(body).matches(needle).count()
+}
+
+/// A user message of about `tokens` tokens that starts with `label`.
+fn padded(label: &str, tokens: usize) -> String {
+    format!("{label} {}", "pad ".repeat(tokens))
+}
+
+/// Reasoning items sent without their encrypted state, which OpenAI cannot accept.
+fn reasoning_without_encrypted_state(body: &Value) -> usize {
+    body["input"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter(|item| {
+            item["type"] == "reasoning"
+                && item["encrypted_content"].as_str().is_none_or(str::is_empty)
+        })
+        .count()
+}
+
+/// Output text of each function call in a request, by call ID; `None` when a call has no output.
+fn call_outputs(body: &Value) -> Vec<(String, Option<String>)> {
+    let input = body["input"].as_array().cloned().unwrap_or_default();
+    input
+        .iter()
+        .filter(|item| item["type"] == "function_call")
+        .filter_map(|call| call["call_id"].as_str())
+        .map(|call_id| {
+            let output = input
+                .iter()
+                .find(|item| item["type"] == "function_call_output" && item["call_id"] == call_id)
+                .map(|item| item["output"].to_string());
+            (call_id.to_string(), output)
+        })
+        .collect()
+}
+
+fn assert_has_no_openai_state(body: &Value) {
+    let types = input_types(body);
+    for opaque in ["compaction", "compaction_trigger", "context_compaction"] {
+        assert!(
+            !types.iter().any(|ty| ty == opaque),
+            "request to another family must not carry {opaque}: {types:?}"
+        );
+    }
+    let text = input_text(body);
+    assert!(!text.contains(GPT_CHECKPOINT), "native checkpoint leaked");
+    assert!(!text.contains(GPT_REASONING), "encrypted reasoning leaked");
+}
+
+fn write_config(codex_home: &Path, server: &MockServer) -> Result<()> {
+    write_config_with(codex_home, server, "")
+}
