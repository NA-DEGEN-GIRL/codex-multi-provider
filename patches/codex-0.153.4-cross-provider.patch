+//! A management connection must account for actual work on another connection.
+use super::super::connection_handling_websocket::connect_websocket;
+use super::super::connection_handling_websocket::read_error_for_id;
+use super::super::connection_handling_websocket::read_response_for_id;
+use super::super::connection_handling_websocket::send_request;
+use super::super::connection_handling_websocket::spawn_websocket_server_with_env;
+use super::*;
+use codex_app_server_protocol::ServerManagedShutdownResponse;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn managed_shutdown_other_connection_work_defers_then_exits_with_both_clients_open()
+-> Result<()> {
+    let api = responses::start_mock_server().await;
+    let profile = ManagedProfile::new(&api.uri(), "mock-model", "mock-token")?;
+    profile.write_manifest(&[&profile], Vec::new())?;
+    let (mut process, address) = spawn_websocket_server_with_env(
+        profile.home.path(),
+        "ws://127.0.0.1:0",
+        &[],
+        &[
+            (
+                "CODEX_MANAGER_MANAGED_SOURCES",
+                profile.manifest_path.to_str(),
+            ),
+            ("CODEX_MANAGED_HANDOFF_TEST_KEY", Some(&profile.api_key)),
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            ("CODEX_SQLITE_HOME", None),
+            ("OPENAI_API_KEY", None),
+            ("CODEX_ACCESS_TOKEN", None),
+        ],
+    )
+    .await?;
+    let process_id = process.id().context("managed process ID")?;
+    let mut worker = connect_websocket(address).await?;
+    let mut admin = connect_websocket(address).await?;
+    for client in [&mut worker, &mut admin] {
+        send_request(
+            client,
+            "initialize",
+            /*id*/ 1,
+            Some(json!({
+                "clientInfo":{"name":"managed-maintenance-test","version":"1"},
+                "capabilities":{"experimentalApi":true}
+            })),
+        )
+        .await?;
+        read_response_for_id(client, /*id*/ 1).await?;
+    }
+    send_request(&mut worker, "thread/start", /*id*/ 2, Some(json!({}))).await?;
+    let first = read_response_for_id(&mut worker, /*id*/ 2).await?.result["thread"]["id"]
+        .as_str()
+        .context("first root ID")?
+        .to_owned();
+    let command = if cfg!(windows) {
+        vec![
+            "powershell.exe",
+            "-NoProfile",
+            "-NonInteractive",
+            "-Command",
+            "[Console]::In.ReadLine() | Out-Null",
+        ]
+    } else {
+        vec!["sh", "-c", "read line"]
+    };
+    send_request(
+        &mut worker,
+        "process/spawn",
+        /*id*/ 3,
+        Some(json!({
+            "command":command,"processHandle":"peer-work","cwd":profile.home.path(),
+            "streamStdin":true,"timeoutMs":30000
+        })),
+    )
+    .await?;
+    read_response_for_id(&mut worker, /*id*/ 3).await?;
+    send_request(
+        &mut admin,
+        "server/managedShutdown",
+        /*id*/ 4,
+        Some(json!({"processId":process_id})),
+    )
+    .await?;
+    let error = read_error_for_id(&mut admin, /*id*/ 4).await?;
+    assert!(error.error.message.contains("operations in flight"));
+    // Refusal must restore normal admission on the original connection.
+    send_request(&mut worker, "thread/start", /*id*/ 5, Some(json!({}))).await?;
+    let second = read_response_for_id(&mut worker, /*id*/ 5).await?.result["thread"]["id"]
+        .as_str()
+        .context("second root ID")?
+        .to_owned();
+    send_request(
+        &mut worker,
+        "process/writeStdin",
+        /*id*/ 6,
+        Some(json!({"processHandle":"peer-work","closeStdin":true})),
+    )
+    .await?;
+    read_response_for_id(&mut worker, /*id*/ 6).await?;
+    timeout(READ_TIMEOUT, async {
+        for id in 100.. {
+            send_request(&mut admin, "server/diagnostics", id, Some(json!({}))).await?;
+            let response = read_response_for_id(&mut admin, id).await?;
+            let drained = response.result["gauges"]
+                .as_array()
+                .context("diagnostics gauges")?
+                .iter()
+                .any(|gauge| {
+                    gauge["name"] == "app.managed.processes.running" && gauge["value"] == 0
+                });
+            if drained {
+                return Ok::<(), anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+        unreachable!()
+    })
+    .await??;
+    send_request(
+        &mut admin,
+        "server/managedShutdown",
+        /*id*/ 7,
+        Some(json!({"processId":process_id})),
+    )
+    .await?;
+    let reply = read_response_for_id(&mut admin, /*id*/ 7).await?;
+    let mut response: ServerManagedShutdownResponse = serde_json::from_value(reply.result)?;
+    response.closed_thread_ids.sort();
+    let mut expected = vec![first, second];
+    expected.sort();
+    assert_eq!(
+        response,
+        ServerManagedShutdownResponse {
+            process_id,
+            closed_thread_ids: expected,
+            shutdown_requested: true,
+            writer_release_verified: true,
+        }
+    );
+    assert!(timeout(READ_TIMEOUT, process.wait()).await??.success());
+    Ok(())
+}
