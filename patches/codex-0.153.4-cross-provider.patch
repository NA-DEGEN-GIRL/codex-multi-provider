@@ -0,0 +1,31 @@
+//! Exact actor cleanup for internal sessions owned by a parent registry.
+
+use super::ThreadManagerState;
+use crate::session::session::Session;
+use codex_protocol::protocol::SessionSource;
+use futures::FutureExt;
+use std::sync::Arc;
+
+impl ThreadManagerState {
+    pub(crate) async fn remove_verified_internal_actor(&self, expected: &Arc<Session>) {
+        let mut threads = self.threads.write().await;
+        let remove = threads.get(&expected.thread_id).is_some_and(|thread| {
+            Arc::ptr_eq(&thread.session, expected)
+                && matches!(&thread.session_source, SessionSource::Internal(_))
+                && expected.internal_sessions.shutdown_is_verified()
+                && thread
+                    .io
+                    .session_loop_termination
+                    .clone()
+                    .now_or_never()
+                    .is_some()
+        });
+        if remove {
+            threads.remove(&expected.thread_id);
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "internal_sessions_tests.rs"]
+mod tests;
