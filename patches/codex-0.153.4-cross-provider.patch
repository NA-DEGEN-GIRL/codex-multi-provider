+/// [`write_config_with`] with `root` top-level keys.
+fn write_config_with_root(
+    codex_home: &Path,
+    server: &MockServer,
+    root: &str,
+    extra: &str,
+) -> Result<()> {
+    MockResponsesConfig::new(&server.uri())
+        .with_model(GPT_MODEL)
+        .with_provider_name("OpenAI")
+        .with_provider_config("supports_websockets = false")
+        .with_root_config(&format!(
+            "compact_prompt = \"{COMPACT_PROMPT}\"\ntools.update_plan.enabled = true\n{root}"
+        ))
+        .with_extra_config(&format!(
+            r#"[model_providers.{DEEPSEEK_PROVIDER}]
+name = "DeepSeek"
+base_url = "{uri}/v1"
+wire_api = "responses"
+request_max_retries = 0
+stream_max_retries = 0
+supports_websockets = false
+
+[model_providers.{XAI_PROVIDER}]
+name = "xAI"
+base_url = "{uri}/v1"
+wire_api = "responses"
+request_max_retries = 0
+stream_max_retries = 0
+supports_websockets = false
+{extra}"#,
+            uri = server.uri()
+        ))
+        .write(codex_home)?;
+    Ok(())
+}
