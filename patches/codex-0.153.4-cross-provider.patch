+    fs::write(&path_b, format!("{header}\n{rest}")).unwrap();
+    let parent = source(temp.path(), &path_a, THREAD_A, PROJECTION_A, "manager:a");
+    let child = source(temp.path(), &path_b, THREAD_B, PROJECTION_B, "manager:a");
+    let complete = catalog(vec![parent, child.clone()]);
+    let response = complete
+        .read(
+            ThreadReadParams {
+                thread_id: PROJECTION_B.to_string(),
+                include_turns: true,
+            },
+            &cwd(temp.path()),
+        )
+        .await
+        .unwrap();
+    let serialized = serde_json::to_value(&response.thread).unwrap();
+    assert_eq!(
+        (
+            response.thread.parent_thread_id.as_deref(),
+            response.thread.forked_from_id.as_deref()
+        ),
+        (Some(PROJECTION_A), Some(PROJECTION_A))
+    );
+    assert!(serialized["source"].to_string().contains(PROJECTION_A));
+    assert!(!serialized.to_string().contains(THREAD_A));
+
+    let missing_parent = catalog(vec![child]);
+    let orphan = missing_parent
+        .read(
+            ThreadReadParams {
+                thread_id: PROJECTION_B.to_string(),
+                include_turns: true,
+            },
+            &cwd(temp.path()),
+        )
+        .await
+        .unwrap();
+    assert_eq!(orphan.thread.parent_thread_id, None);
+    assert_eq!(orphan.thread.forked_from_id, None);
+    assert_eq!(orphan.thread.agent_nickname.as_deref(), Some("Reader"));
+    assert_eq!(
+        orphan.thread.source,
+        codex_app_server_protocol::SessionSource::SubAgent(SubAgentSource::Other(
+            "thread_spawn".to_string()
+        ))
+    );
+    assert!(
+        !serde_json::to_string(&orphan.thread)
+            .unwrap()
+            .contains(THREAD_A)
+    );
