+//! Keep an explicitly opened source stable when legacy accounts contain copies
+//! with the same task ID. Selection changes routing only, never source records.
+use super::*;
+use std::collections::BTreeMap;
+use std::io::Read;
+use std::io::Write;
+
+const ROUTES_ENV: &str = "CODEX_MANAGER_SHARED_ROUTES";
+const MAX_BYTES: u64 = 4 * 1024 * 1024;
+
+#[derive(Default)]
+pub(super) struct SharedRoutes {
+    path: Option<PathBuf>,
+    selected: BTreeMap<String, String>,
+    ambiguous: HashSet<ThreadId>,
+}
+
+fn read(path: &Path) -> Result<BTreeMap<String, String>, JSONRPCErrorError> {
+    if !path.exists() {
+        return Ok(BTreeMap::new());
+    }
+    let metadata = std::fs::symlink_metadata(path).map_err(|e| invalid_request(e.to_string()))?;
+    if !metadata.is_file() || metadata.len() > MAX_BYTES {
+        return Err(invalid_request("invalid shared record route file"));
+    }
+    let file = std::fs::File::open(path).map_err(|e| invalid_request(e.to_string()))?;
+    let mut bytes = Vec::new();
+    file.take(MAX_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|e| invalid_request(e.to_string()))?;
+    if bytes.len() as u64 > MAX_BYTES {
+        return Err(invalid_request("shared record route size limit"));
+    }
+    let routes: BTreeMap<String, String> = serde_json::from_slice(&bytes)
+        .map_err(|_| invalid_request("invalid shared record routes"))?;
+    if routes.len() > 4096
+        || routes.iter().any(|(id, source)| {
+            ThreadId::from_string(id).is_err()
+                || source.is_empty()
+                || source.len() > 256
+                || source.chars().any(char::is_control)
+        })
+    {
+        return Err(invalid_request("invalid shared record route identity"));
+    }
+    Ok(routes)
+}
+
+impl SharedRoutes {
+    pub(super) async fn load(entries: Arc<Vec<RecordSource>>) -> Result<Self, JSONRPCErrorError> {
+        let path = execution::enabled()
+            .then(|| std::env::var_os(ROUTES_ENV))
+            .flatten()
+            .map(PathBuf::from);
+        Self::load_path(path, entries).await
+    }
+
+    pub(super) async fn load_path(
+        path: Option<PathBuf>,
+        entries: Arc<Vec<RecordSource>>,
+    ) -> Result<Self, JSONRPCErrorError> {
+        let Some(path) = path else {
+            return Ok(Self::default());
+        };
+        if !path.is_absolute() {
+            return Err(invalid_request(
+                "shared record routes require an absolute path",
+            ));
+        }
+        tokio::task::spawn_blocking(move || {
+            let selected = read(&path)?;
+            let mut homes = HashMap::new();
+            let mut ambiguous = HashSet::new();
+            for source in entries.iter() {
+                if homes
+                    .insert(source.thread_id, &source.codex_home)
+                    .is_some_and(|home| home != &source.codex_home)
+                {
+                    ambiguous.insert(source.thread_id);
+                }
+            }
+            Ok(Self {
+                path: Some(path),
+                selected,
+                ambiguous,
+            })
+        })
+        .await
+        .map_err(|e| invalid_request(e.to_string()))?
+    }
+
+    pub(super) fn includes(&self, source: &RecordSource) -> bool {
+        self.selected
+            .get(&source.thread_id.to_string())
+            .is_none_or(|selected| selected == &source.source_store_id)
+    }
+
+    pub(super) fn has_selection(&self, id: ThreadId) -> bool {
+        self.selected.contains_key(&id.to_string())
+    }
+
+    pub(super) fn projects(&self, source: &RecordSource) -> bool {
+        self.path.is_some()
+            && self.ambiguous.contains(&source.thread_id)
+            && !self.selected.contains_key(&source.thread_id.to_string())
+    }
+
+    pub(super) fn revision(&self) -> String {
+        format!(
+            "{:x}",
+            sha2::Sha256::digest(serde_json::to_vec(&self.selected).unwrap_or_default())
+        )
+    }
+
+    pub(super) async fn select(&self, source: &RecordSource) -> Result<(), JSONRPCErrorError> {
+        let Some(path) = self.path.clone() else {
+            return Ok(());
+        };
+        if !self.ambiguous.contains(&source.thread_id) {
+            return Ok(());
+        }
+        let id = source.thread_id.to_string();
+        let source_id = source.source_store_id.clone();
+        tokio::task::spawn_blocking(move || {
+            let parent = path
+                .parent()
+                .ok_or_else(|| invalid_request("shared route directory missing"))?;
+            std::fs::create_dir_all(parent).map_err(|e| invalid_request(e.to_string()))?;
+            let lock_path = path.with_extension("lock");
+            if std::fs::symlink_metadata(&lock_path).is_ok_and(|m| !m.is_file()) {
+                return Err(invalid_request("invalid shared route lock"));
+            }
+            let lock = std::fs::OpenOptions::new()
+                .read(true)
+                .write(true)
+                .create(true)
+                .truncate(false)
+                .open(lock_path)
+                .map_err(|e| invalid_request(e.to_string()))?;
+            lock.lock().map_err(|e| invalid_request(e.to_string()))?;
+            let mut routes = read(&path)?;
+            if routes.contains_key(&id) {
+                return Ok(()); // All profiles and older aliases keep the first explicit selection.
+            }
+            if routes.len() >= 4096 {
+                return Err(invalid_request("shared record route limit"));
+            }
+            routes.insert(id, source_id);
+            let bytes = serde_json::to_vec(&routes).map_err(|e| invalid_request(e.to_string()))?;
+            let mut temporary = tempfile::NamedTempFile::new_in(parent)
+                .map_err(|e| invalid_request(e.to_string()))?;
+            temporary
+                .write_all(&bytes)
+                .map_err(|e| invalid_request(e.to_string()))?;
+            temporary
+                .as_file()
+                .sync_all()
+                .map_err(|e| invalid_request(e.to_string()))?;
+            temporary
+                .persist(&path)
+                .map_err(|e| invalid_request(e.to_string()))?;
+            Ok(())
+        })
+        .await
+        .map_err(|e| invalid_request(e.to_string()))?
+    }
+}
