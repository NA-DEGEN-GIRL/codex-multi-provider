+impl RecordSource {
+    fn history_revision(&self) -> Result<String, JSONRPCErrorError> {
+        // A different conversation appearing in the sidebar must not invalidate
+        // this conversation's next history page. Bind to this source's complete
+        // identity (including its home and rollout), not the whole catalog.
+        let identity = serde_json::to_vec(self)
