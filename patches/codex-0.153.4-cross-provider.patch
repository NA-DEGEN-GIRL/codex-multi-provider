+#[tokio::test]
+async fn mixed_sources_discover_open_and_update_legacy_history_without_republishing_or_writing()
+-> Result<()> {
+    let api = responses::start_mock_server().await;
+    let calls = responses::mount_sse_once(
+        &api,
+        create_final_assistant_message_sse_response("Managed answer")?,
+    )
+    .await;
+    let source = ManagedProfile::new(&api.uri(), "source-model", "source-token")?;
+    let viewer = ManagedProfile::new(&api.uri(), "viewer-model", "viewer-token")?;
+    source.write_manifest(&[&source], Vec::new())?;
+    viewer.write_manifest(&[&source, &viewer], Vec::new())?;
+    let mut owner = source.start_server().await?;
+    let managed = owner
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    complete_turn(&mut owner, &managed.id, "Create managed history").await?;
+    let legacy = TempDir::new()?;
+    let (first_id, first_path) = legacy_record(legacy.path(), "2025-01-05T12-00-00")?;
+    let original = fs::read(&first_path)?;
+    let legacy_descriptor = legacy_source(legacy.path());
+    let catalog = viewer.home.path().join("mixed-catalog.json");
+    let inventory = viewer.home.path().join("managed-inventory.json");
+    super::catalog_sources::publish(&inventory, &[&viewer])?;
+    fs::write(
+        &catalog,
+        serde_json::to_vec(&json!({
+            "version":3,"hostId":"local","sources":[],
+            "legacySources":[legacy_descriptor],"managedSourcesPath":inventory
+        }))?,
+    )?;
+    let catalog_bytes = fs::read(&catalog)?;
+    let mut reader = super::catalog_sources::start_shared(&viewer, &catalog).await?;
+    let listed = super::catalog_sources::list(&mut reader).await?;
+    assert_eq!(listed.data.len(), 1);
+    let projected = projection(&legacy_descriptor, &first_id)?;
+    assert!(listed.data.iter().any(|thread| thread.id == projected));
+    assert!(
+        listed
+            .data
+            .iter()
+            .all(|thread| thread.can_accept_direct_input == Some(false))
+    );
+    // A helper for an older runtime publishes only V2. New viewers still see
+    // that enrollment without replacing their separate legacy descriptor.
+    super::catalog_sources::publish(&inventory, &[&source, &viewer])?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_notification_message("thread/started"),
+    )
+    .await??;
+    let enrolled: ThreadStartedNotification =
+        serde_json::from_value(notification.params.context("older helper enrollment")?)?;
+    assert_eq!(
+        enrolled.thread.id,
+        projection(&json!({"sourceStoreId":source.source_id}), &managed.id)?
+    );
+    let request = reader
+        .send_raw_request("thread/resume", Some(json!({"threadId":projected})))
+        .await?;
+    let resumed: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert_eq!(resumed.thread.id, projected);
+    assert_eq!(fs::read(&first_path)?, original);
+    assert!(
+        !SqliteConfig::from_sqlite_home(legacy.path().abs())
+            .state_db_path()
+            .exists()
+    );
+    assert!(!legacy.path().join("managed-source.json").exists());
+
+    let (later_id, _) = legacy_record(legacy.path(), "2025-01-06T12-00-00")?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_notification_message("thread/started"),
+    )
+    .await??;
+    let started: ThreadStartedNotification =
+        serde_json::from_value(notification.params.context("new legacy record")?)?;
+    assert_eq!(
+        started.thread.id,
+        projection(&legacy_descriptor, &later_id)?
+    );
+    let events = [
+        EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: "legacy-later-turn".to_string(),
+            trace_id: None,
+            started_at: Some(100),
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        }),
+        EventMsg::AgentMessage(AgentMessageEvent {
+            message: "Legacy work continued in its original process".to_string(),
+            phase: None,
+            memory_citation: None,
+            delivery: None,
+            questions: None,
+        }),
+        EventMsg::TurnComplete(TurnCompleteEvent {
+            turn_id: "legacy-later-turn".to_string(),
+            last_agent_message: Some("Legacy work continued in its original process".to_string()),
+            error: None,
+            started_at: Some(100),
+            completed_at: Some(102),
+            duration_ms: Some(2000),
+            time_to_first_token_ms: None,
+        }),
+    ];
+    let mut file = fs::OpenOptions::new().append(true).open(&first_path)?;
+    for event in events {
+        writeln!(
+            file,
+            "{}",
+            json!({"timestamp":"2026-09-14T00:00:00Z","type":"event_msg","payload":event})
+        )?;
+    }
+    file.flush()?;
+    drop(file);
+    let after_writer = fs::read(&first_path)?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let completed: TurnCompletedNotification =
+        serde_json::from_value(notification.params.context("legacy update")?)?;
+    assert_eq!(
+        (&completed.thread_id, &completed.turn.id),
+        (&projected, &"legacy-later-turn".to_string())
+    );
+    for (method, params) in [
+        ("turn/start", json!({"threadId":projected,"input":[]})),
+        ("thread/archive", json!({"threadId":projected})),
+    ] {
+        let request = reader.send_raw_request(method, Some(params)).await?;
+        let error = timeout(
+            READ_TIMEOUT,
+            reader.read_stream_until_error_message(RequestId::Integer(request)),
+        )
+        .await??;
+        assert!(error.error.message.contains("read-only record catalog"));
+    }
+    let request = reader
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert!(loaded.data.is_empty());
+    assert_eq!(fs::read(&first_path)?, after_writer);
+    assert_eq!(fs::read(&catalog)?, catalog_bytes);
+    assert_eq!(calls.requests().len(), 1);
+    Ok(())
+}
