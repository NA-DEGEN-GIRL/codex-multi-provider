+use super::*;
+use crate::outgoing_message::OutgoingEnvelope;
+use crate::outgoing_message::OutgoingMessage;
+use codex_analytics::AnalyticsEventsClient;
+use codex_app_server_protocol::JSONRPCErrorError;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio::sync::mpsc;
+
+const OWNER: &str = "11111111-1111-4111-8111-111111111111";
+
+fn request() -> ExecutionPresetAuthTokensReadParams {
+    ExecutionPresetAuthTokensReadParams {
+        owner_profile_id: OWNER.to_string(),
+        role_id: Some("approved".to_string()),
+        profile_id: "22222222-2222-4222-8222-222222222222".to_string(),
+        kind: "openai".to_string(),
+        expected_account_fingerprint: Some("f".repeat(64)),
+        expected_account_identity: None,
+        rejected_credential_id: None,
+    }
+}
+
+const LENT_ID: &str = "33333333-3333-4333-8333-333333333333";
+
+fn claude_request(rejected_credential_id: Option<&str>) -> ExecutionPresetAuthTokensReadParams {
+    ExecutionPresetAuthTokensReadParams {
+        role_id: None,
+        kind: "claude".to_string(),
+        expected_account_fingerprint: None,
+        expected_account_identity: Some("e".repeat(64)),
+        rejected_credential_id: rejected_credential_id.map(str::to_string),
+        ..request()
+    }
+}
+
+/// Registers one broker connection and returns the next credential request it receives.
+async fn registered() -> (
+    Arc<ManagedPresetAuth>,
+    Arc<OutgoingMessageSender>,
+    mpsc::Receiver<OutgoingEnvelope>,
+) {
+    let (sender, messages) = mpsc::channel(8);
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        sender,
+        AnalyticsEventsClient::disabled(),
+    ));
+    let broker = Arc::new(ManagedPresetAuth::new(
+        Some(OWNER.to_string()),
+        Arc::clone(&outgoing),
+    ));
+    broker
+        .register(ConnectionId(1), Some(&json!({"profileId":OWNER})))
+        .await
+        .expect("register");
+    (broker, outgoing, messages)
+}
+
+async fn next_request(
+    messages: &mut mpsc::Receiver<OutgoingEnvelope>,
+) -> codex_app_server_protocol::ServerRequest {
+    match messages.recv().await.expect("request") {
+        OutgoingEnvelope::ToConnection {
+            message: OutgoingMessage::Request(request),
+            ..
+        } => request,
+        _ => panic!("managed auth must not broadcast"),
+    }
+}
+
+#[test]
+fn a_rejected_credential_is_sent_only_when_set_so_older_brokers_see_six_fields() {
+    let plain = serde_json::to_value(claude_request(None)).expect("params");
+    let rejected = serde_json::to_value(claude_request(Some(LENT_ID))).expect("params");
+    assert_eq!(
+        plain,
+        json!({"ownerProfileId":OWNER,"roleId":null,"profileId":"22222222-2222-4222-8222-222222222222",
+            "kind":"claude","expectedAccountFingerprint":null,"expectedAccountIdentity":"e".repeat(64)})
+    );
+    assert_eq!(rejected["rejectedCredentialId"], LENT_ID);
+    assert_eq!(
+        serde_json::from_value::<ExecutionPresetAuthTokensReadParams>(plain).expect("parse"),
+        claude_request(None)
+    );
+}
+
+#[tokio::test]
+async fn a_long_lived_credential_keeps_its_source_and_its_token_stays_out_of_logs() {
+    let (broker, outgoing, mut messages) = registered().await;
+    let pending = tokio::spawn({
+        let broker = Arc::clone(&broker);
+        async move { broker.resolve(claude_request(Some(LENT_ID))).await }
+    });
+    let request = next_request(&mut messages).await;
+    let codex_app_server_protocol::ServerRequest::ExecutionPresetAuthTokensRead {
+        request_id,
+        params,
+    } = request
+    else {
+        panic!("unexpected request");
+    };
+    assert_eq!(params.rejected_credential_id.as_deref(), Some(LENT_ID));
+    let token = "sk-ant-oat01-DUMMY-long-lived-fixture";
+    let value = json!({"kind":"claude","accessToken":token,"chatgptAccountId":null,
+        "expiresAt":2_000_000_000,"accountIdentity":"e".repeat(64),
+        "credentialSource":"longLivedToken","credentialId":"44444444-4444-4444-8444-444444444444"});
+    outgoing
+        .notify_client_response_from_connection(Some(ConnectionId(1)), request_id, value.clone())
+        .await;
+    let response = pending.await.expect("worker").expect("lent credential");
+    assert_eq!(
+        (
+            response.credential_source.as_deref(),
+            response.credential_id.as_deref()
+        ),
+        (
+            Some("longLivedToken"),
+            Some("44444444-4444-4444-8444-444444444444")
+        )
+    );
+    // The app-server logs every typed response with Debug; the token never appears there.
+    let logged = format!(
+        "{:?}",
+        codex_app_server_protocol::ServerResponse::ExecutionPresetAuthTokensRead {
+            request_id: codex_app_server_protocol::RequestId::Integer(1),
+            response,
+        }
+    );
+    assert!(!logged.contains(token), "{logged}");
+    assert!(logged.contains("longLivedToken"), "{logged}");
+    // An older broker's reply without the source fields still parses.
+    let older = serde_json::from_value::<ExecutionPresetAuthTokensReadResponse>(json!({
+        "kind":"claude","accessToken":token,"chatgptAccountId":null,"expiresAt":2_000_000_000,
+        "accountIdentity":"e".repeat(64)}))
+    .expect("older reply");
+    assert_eq!((older.credential_source, older.credential_id), (None, None));
+}
+
+#[tokio::test]
+async fn only_a_listed_refusal_reason_reaches_the_runtime() {
+    let (broker, outgoing, mut messages) = registered().await;
+    let mut refusals = Vec::new();
+    for data in [
+        Some(json!({"reason":"claude_long_lived_rejected"})),
+        Some(json!({"reason":"claude_long_lived_expired"})),
+        Some(json!({"reason":"account_mismatch"})),
+        None,
+    ] {
+        let pending = tokio::spawn({
+            let broker = Arc::clone(&broker);
+            async move { broker.resolve(claude_request(None)).await }
+        });
+        let request = next_request(&mut messages).await;
+        outgoing
+            .notify_client_error_from_connection(
+                Some(ConnectionId(1)),
+                request.id().clone(),
+                JSONRPCErrorError {
+                    code: -32042,
+                    message: "broker text is never forwarded".to_string(),
+                    data,
+                },
+            )
+            .await;
+        let error = pending.await.expect("worker").expect_err("refused");
+        assert!(!error.to_string().contains("broker text"));
+        refusals.push(
+            error
+                .get_ref()
+                .and_then(|inner| inner.downcast_ref::<ExecutionPresetAuthRefusal>())
+                .copied(),
+        );
+    }
+    assert_eq!(
+        refusals,
+        vec![
+            Some(ExecutionPresetAuthRefusal::ClaudeLongLivedRejected),
+            Some(ExecutionPresetAuthRefusal::ClaudeLongLivedExpired),
+            None,
+            None,
+        ]
+    );
+}
+
+#[tokio::test]
+async fn managed_auth_accepts_only_its_registered_connection_and_never_broadcasts() {
+    let (sender, mut messages) = mpsc::channel(8);
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        sender,
+        AnalyticsEventsClient::disabled(),
+    ));
+    let broker = Arc::new(ManagedPresetAuth::new(
+        Some(OWNER.to_string()),
+        Arc::clone(&outgoing),
+    ));
+    assert!(
+        broker
+            .register(ConnectionId(1), Some(&json!({"profileId":"other"})))
+            .await
+            .is_err()
+    );
+    broker
+        .register(ConnectionId(1), Some(&json!({"profileId":OWNER})))
+        .await
+        .expect("register");
+    assert!(
+        broker
+            .register(ConnectionId(2), Some(&json!({"profileId":OWNER})))
+            .await
+            .is_err()
+    );
+    let pending = tokio::spawn({
+        let broker = Arc::clone(&broker);
+        async move { broker.resolve(request()).await }
+    });
+    let id = match messages.recv().await.expect("request") {
+        OutgoingEnvelope::ToConnection {
+            connection_id,
+            message: OutgoingMessage::Request(request),
+            ..
+        } => {
+            assert_eq!(connection_id, ConnectionId(1));
+            request.id().clone()
+        }
+        _ => panic!("managed auth must not broadcast"),
+    };
+    let value = json!({"kind":"openai","accessToken":"selected-token","chatgptAccountId":"selected-account","expiresAt":null,"accountIdentity":null});
+    outgoing
+        .notify_client_response_from_connection(Some(ConnectionId(2)), id.clone(), value.clone())
+        .await;
+    outgoing
+        .notify_client_error_from_connection(
+            Some(ConnectionId(2)),
+            id.clone(),
+            JSONRPCErrorError {
+                code: -1,
+                message: "spoof".to_string(),
+                data: None,
+            },
+        )
+        .await;
+    outgoing
+        .notify_client_response(id.clone(), value.clone())
+        .await;
+    assert!(
+        !pending.is_finished(),
+        "wrong or unbound replies must not consume the callback"
+    );
+    outgoing
+        .notify_client_response_from_connection(Some(ConnectionId(1)), id, value)
+        .await;
+    let response = pending.await.expect("worker").expect("selected reply");
+    assert_eq!(response.access_token, "selected-token");
+    assert!(!format!("{response:?}").contains("selected-token"));
+    assert!(messages.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn disconnect_cancels_credential_reads_and_requires_a_new_owner_handshake() {
+    let (sender, mut messages) = mpsc::channel(8);
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        sender,
+        AnalyticsEventsClient::disabled(),
+    ));
+    let broker = Arc::new(ManagedPresetAuth::new(
+        Some(OWNER.to_string()),
+        Arc::clone(&outgoing),
+    ));
+    broker
+        .register(ConnectionId(1), Some(&json!({"profileId":OWNER})))
+        .await
+        .expect("register");
+    let pending = tokio::spawn({
+        let broker = Arc::clone(&broker);
+        async move { broker.resolve(request()).await }
+    });
+    messages.recv().await.expect("pending request");
+    broker.disconnected(ConnectionId(1)).await;
+    outgoing.connection_closed(ConnectionId(1)).await;
+    assert!(pending.await.expect("worker").is_err());
+    assert!(broker.resolve(request()).await.is_err());
+    assert!(messages.try_recv().is_err());
+    broker
+        .register(ConnectionId(2), Some(&json!({"profileId":OWNER})))
+        .await
+        .expect("new owner connection");
+    let (id, receiver) = outgoing
+        .send_request(ServerRequestPayload::ExecutionPresetAuthTokensRead(
+            request(),
+        ))
+        .await;
+    assert!(
+        receiver.await.is_err(),
+        "unbound broadcast API cannot send credentials"
+    );
+    assert!(!outgoing.cancel_request(&id).await);
+    assert!(messages.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn disconnect_during_enqueue_does_not_leave_a_credential_callback() {
+    let (sender, mut messages) = mpsc::channel(1);
+    let occupied = sender.clone().reserve_owned().await.expect("queue permit");
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        sender,
+        AnalyticsEventsClient::disabled(),
+    ));
+    let broker = ManagedPresetAuth::new(Some(OWNER.to_string()), Arc::clone(&outgoing));
+    broker
+        .register(ConnectionId(1), Some(&json!({"profileId":OWNER})))
+        .await
+        .expect("register");
+    let pending = broker.resolve(request());
+    tokio::pin!(pending);
+    tokio::select! {
+        biased;
+        _ = &mut pending => panic!("request must wait for queue capacity"),
+        _ = tokio::task::yield_now() => {}
+    }
+    broker.disconnected(ConnectionId(1)).await;
+    outgoing.connection_closed(ConnectionId(1)).await;
+    drop(occupied);
+    assert!(pending.await.is_err());
+    let OutgoingEnvelope::ToConnection {
+        message: OutgoingMessage::Request(request),
+        ..
+    } = messages.recv().await.expect("queued request")
+    else {
+        panic!("managed auth must not broadcast");
+    };
+    assert!(!outgoing.cancel_request(request.id()).await);
+}
