+async fn resumed_store() -> (TempDir, LocalThreadStore, ThreadId) {
+    let home = TempDir::new().expect("temporary source store");
+    let store = LocalThreadStore::new(test_config(home.path()), /*state_db*/ None);
+    let uuid = uuid::Uuid::now_v7();
+    let thread_id = ThreadId::from_string(&uuid.to_string()).expect("thread id");
+    let rollout_path =
+        write_session_file(home.path(), "2025-01-04T11-30-00", uuid).expect("source rollout");
+    store
+        .resume_thread(ResumeThreadParams {
+            thread_id,
+            rollout_path: Some(rollout_path),
+            history: None,
+            include_archived: true,
+            metadata: ThreadPersistenceMetadata {
+                cwd: Some(home.path().to_path_buf()),
+                model_provider: "test-provider".to_string(),
+                memory_mode: ThreadMemoryMode::Enabled,
+            },
+        })
+        .await
+        .expect("resume source");
+    (home, store, thread_id)
+}
+
+fn rename(thread_id: ThreadId) -> UpdateThreadMetadataParams {
+    UpdateThreadMetadataParams {
+        thread_id,
+        patch: ThreadMetadataPatch {
+            name: Some(Some("late callback".to_string())),
+            ..Default::default()
+        },
+        include_archived: true,
+    }
+}
+
+#[tokio::test]
+async fn successful_shutdown_revokes_late_metadata_in_all_clones() {
+    let (_home, store, thread_id) = resumed_store().await;
+    let store = store.with_managed_thread_scope(thread_id);
+    let clone = store.clone();
+    let late_callback = clone.update_thread_metadata(rename(thread_id));
+    store.shutdown_thread(thread_id).await.expect("shutdown");
+
+    assert!(matches!(
+        late_callback.await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(matches!(
+        clone.remove_pending_thread_metadata(thread_id).await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(matches!(
+        clone
+            .append_items(AppendThreadItemsParams {
+                thread_id,
+                items: Vec::new()
+            })
+            .await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    let thread = clone
+        .read_thread(ReadThreadParams {
+            thread_id,
+            include_archived: true,
+            include_history: true,
+        })
+        .await
+        .expect("closed source remains readable");
+    assert_eq!(thread.name, None);
+}
+
+#[tokio::test]
+async fn ordinary_store_still_allows_metadata_after_shutdown() {
+    let (_home, store, thread_id) = resumed_store().await;
+    store.shutdown_thread(thread_id).await.expect("shutdown");
+    let thread = store
+        .update_thread_metadata(rename(thread_id))
+        .await
+        .expect("ordinary offline metadata update")
+        .expect("stored thread");
+    assert_eq!(thread.name, Some("late callback".to_string()));
+    store
+        .managed_write_permit(ThreadId::default())
+        .await
+        .expect("ordinary stores remain unrestricted");
+}
+
+#[tokio::test]
+async fn scope_rejects_other_records_and_global_mutations_before_touching_storage() {
+    let (_home, store, thread_id) = resumed_store().await;
+    let store = store.with_managed_thread_scope(thread_id);
+    let other_id = ThreadId::default();
+    assert!(matches!(
+        store.update_thread_metadata(rename(other_id)).await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(matches!(
+        store
+            .delete_threads(DeleteThreadsParams {
+                thread_ids: vec![thread_id, other_id],
+            })
+            .await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(matches!(
+        store
+            .create_thread_section(CreateThreadSectionParams {
+                name: "global section".to_string(),
+                appearance: None,
+            })
+            .await,
+        Err(ThreadStoreError::Unsupported {
+            operation: "create_thread_section"
+        })
+    ));
+    store
+        .live_rollout_path(thread_id)
+        .await
+        .expect("batch did not delete source");
+    assert!(matches!(
+        store
+            .move_thread_to_section(MoveThreadToSectionParams {
+                thread_id,
+                section: Some("pinned".to_string()),
+                before_thread_id: None,
+            })
+            .await,
+        Err(ThreadStoreError::Unsupported {
+            operation: "move_thread_to_section"
+        })
+    ));
+    store.shutdown_thread(thread_id).await.expect("shutdown");
+}
+
+#[tokio::test]
+async fn cancelled_shutdown_retains_exclusive_fence_until_completion() {
+    let (_home, store, thread_id) = resumed_store().await;
+    let store = store.with_managed_thread_scope(thread_id);
+    let external_write = store
+        .managed_write_permit(thread_id)
+        .await
+        .expect("external write");
+    let mut closing = Box::pin(store.shutdown_thread(thread_id));
+    assert!(futures::poll!(closing.as_mut()).is_pending());
+    tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        let scope = store.managed_scope.as_ref().expect("managed scope");
+        while scope.revoked.try_read().is_ok() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("close is waiting for external write");
+    assert!(futures::poll!(closing.as_mut()).is_pending());
+    drop(closing);
+    drop(external_write);
+
+    assert!(matches!(
+        store.managed_write_permit(thread_id).await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(matches!(
+        store.live_rollout_path(thread_id).await,
+        Err(ThreadStoreError::ThreadNotFound { .. })
+    ));
+}
+
