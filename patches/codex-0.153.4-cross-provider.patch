new file mode 100644
index 0000000000000000000000000000000000000000..414a17cd7b39998e3f46a4e40473ccee4a4e9ae0
--- /dev/null
+++ b/codex-rs/ext/goal/src/persistence.rs
@@ -0,0 +1,60 @@
+use std::sync::Arc;
+
+use codex_core::ManagedThreadBinding;
+use codex_core::ManagedWritePermit;
+use codex_protocol::ThreadId;
+
+/// Immutable per-thread persistence; account configuration never chooses the source after start.
+#[derive(Clone)]
+pub(crate) struct GoalPersistence {
+    state_db: Arc<codex_state::StateRuntime>,
+    pub(crate) binding: Option<Arc<ManagedThreadBinding>>,
+}
+
+impl std::fmt::Debug for GoalPersistence {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("GoalPersistence")
+            .field("managed", &self.binding.is_some())
+            .finish_non_exhaustive()
+    }
+}
+
+impl GoalPersistence {
+    pub(crate) async fn new(
+        thread_id: ThreadId,
+        profile_state_db: Arc<codex_state::StateRuntime>,
+        binding: Option<Arc<ManagedThreadBinding>>,
+    ) -> Result<Self, String> {
+        if binding
+            .as_ref()
+            .is_some_and(|binding| binding.thread_id() != thread_id)
+        {
+            return Err("managed goal source belongs to another thread".to_string());
+        }
+        let state_db = match binding.as_ref() {
+            Some(binding) => binding
+                .store()
+                .state_db()
+                .await
+                .ok_or_else(|| "managed goal source has no state database".to_string())?,
+            None => profile_state_db,
+        };
+        Ok(Self { state_db, binding })
+    }
+
+    pub(crate) fn state_db(&self) -> &codex_state::StateRuntime {
+        self.state_db.as_ref()
+    }
+
+    /// Hold only around the database mutation, never across calls that reacquire this lease.
+    pub(crate) async fn write_permit(&self) -> Result<Option<ManagedWritePermit>, String> {
+        match self.binding.as_ref() {
+            Some(binding) => binding
+                .live_write_permit()
+                .await
+                .map(Some)
+                .map_err(|error| error.to_string()),
+            None => Ok(None),
+        }
+    }
+}
