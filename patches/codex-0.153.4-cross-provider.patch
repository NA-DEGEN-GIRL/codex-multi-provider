@@ -0,0 +1,133 @@
+//! A source-authorized owner can reopen a previously released subtree in the
+//! same app-server process. This does not restart a server or submit model work.
+
+use super::ThreadRequestProcessor;
+use crate::error_code::invalid_request;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ThreadManagedReloadBindingParams;
+use codex_app_server_protocol::ThreadManagedReloadBindingResponse;
+use codex_protocol::ThreadId;
+use codex_thread_store::ManagedAuthorityGrant;
+use codex_thread_store::ManagedSourceId;
+
+const MAX_ACTIVATION_THREADS: usize = 128;
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn managed_reload_binding(
+        &self,
+        params: ThreadManagedReloadBindingParams,
+    ) -> Result<ThreadManagedReloadBindingResponse, JSONRPCErrorError> {
+        if !crate::managed_sources::is_enabled() {
+            return Err(invalid_request(
+                "managed binding activation is not enabled for this instance",
+            ));
+        }
+        let (root_id, source_id, grant) = activation_identity(&params)?;
+        crate::managed_sources::validate_profile_home(&self.config.codex_home).await?;
+        // A changed manifest alone is insufficient: this helper compares the
+        // exact source authority record and the immutable current profile UUID.
+        let binding =
+            crate::managed_sources::fresh_binding_for_activation(root_id, &source_id, &grant)
+                .await?;
+        let ids = self
+            .thread_manager
+            .managed_activation_thread_ids(&binding)
+            .await
+            .map_err(|error| {
+                invalid_request(format!("cannot inspect managed activation: {error}"))
+            })?;
+        if ids.is_empty() || ids.len() > MAX_ACTIVATION_THREADS || !ids.contains(&root_id) {
+            return Err(invalid_request(
+                "managed activation requires a bounded canonical subtree",
+            ));
+        }
+        let mut expected_grants = Vec::with_capacity(ids.len());
+        for id in &ids {
+            // Descendants have their own immutable authority records. Never use
+            // the root epoch as a substitute for a child's ownership grant.
+            let expected = if *id == root_id {
+                binding.authority_grant().clone()
+            } else {
+                binding
+                    .for_child(*id)
+                    .await
+                    .map_err(|error| {
+                        invalid_request(format!(
+                            "cannot validate managed descendant ownership: {error}",
+                        ))
+                    })?
+                    .authority_grant()
+                    .clone()
+            };
+            expected_grants.push((*id, expected));
+        }
+        let thread_epochs: Vec<_> = expected_grants
+            .iter()
+            .map(|(id, grant)| (*id, grant.epoch))
+            .collect();
+        // Exclusive admission spans Core's actor/starting checks and fresh
+        // lifetime replacement. An uncertain close remains fenced even when a
+        // newer authority exists; this RPC never converts uncertainty to proof.
+        let activation = self.managed_request_gate.try_activate(&thread_epochs)?;
+        {
+            let pending = self.pending_thread_unloads.lock().await;
+            if ids.iter().any(|id| pending.contains(id)) {
+                return Err(invalid_request("a managed subtree actor is still closing"));
+            }
+        }
+        let activated = self
+            .thread_manager
+            .activate_managed_record_binding(binding, &expected_grants)
+            .await
+            .map_err(|error| {
+                invalid_request(format!("managed activation was rejected: {error}"))
+            })?;
+        // Core rechecks the exact subtree under its lifecycle admission and only
+        // installs unloaded bindings. Commit is the sole gate reopening point.
+        activation.commit();
+        Ok(ThreadManagedReloadBindingResponse {
+            thread_id: root_id.to_string(),
+            host_id: source_id.host_id,
+            source_store_id: source_id.store_id,
+            owner_profile_id: grant.owner_profile_id,
+            ownership_epoch: grant.epoch,
+            record_revision: grant.revision,
+            activated_thread_ids: activated.iter().map(ToString::to_string).collect(),
+            binding_reloaded: true,
+        })
+    }
+}
+
+fn activation_identity(
+    params: &ThreadManagedReloadBindingParams,
+) -> Result<(ThreadId, ManagedSourceId, ManagedAuthorityGrant), JSONRPCErrorError> {
+    let thread_id = ThreadId::from_string(&params.thread_id).map_err(|_| {
+        invalid_request("managed activation requires a valid canonical thread UUID")
+    })?;
+    ThreadId::from_string(&params.owner_profile_id)
+        .map_err(|_| invalid_request("managed activation requires a valid owner profile UUID"))?;
+    if params.host_id.trim().is_empty()
+        || params
+            .source_store_id
+            .strip_prefix("manager:")
+            .is_none_or(|id| ThreadId::from_string(id).is_err())
+        || params.ownership_epoch == 0
+        || params.record_revision == 0
+    {
+        return Err(invalid_request(
+            "managed activation requires an exact source and positive grant",
+        ));
+    }
+    Ok((
+        thread_id,
+        ManagedSourceId {
+            host_id: params.host_id.clone(),
+            store_id: params.source_store_id.clone(),
+        },
+        ManagedAuthorityGrant {
+            owner_profile_id: params.owner_profile_id.clone(),
+            epoch: params.ownership_epoch,
+            revision: params.record_revision,
+        },
+    ))
+}
diff --git a/codex-rs/app-server/src/request_processors/managed_thread_drain.rs b/codex-rs/app-server/src/request_processors/managed_thread_drain.rs
new file mode 100644
index 000000000..8ac862a6c
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/managed_thread_drain.rs
@@ -0,0 +1,405 @@
+//! Managed handoff closes only an idle, explicitly bound spawn subtree.
+
+use super::ThreadQueueRequestProcessor;
+use super::ThreadRequestProcessor;
+use crate::error_code::internal_error;
+use crate::error_code::invalid_request;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ThreadClosedNotification;
+use codex_app_server_protocol::ThreadManagedCloseIdleParams;
+use codex_app_server_protocol::ThreadManagedCloseIdleResponse;
+use codex_core::CodexThread;
+use codex_core::IdleCloseAdmission;
+use codex_protocol::ThreadId;
+use codex_protocol::error::CodexErrorDetails;
+use codex_protocol::protocol::AgentStatus;
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::oneshot;
+
+const MAX_DRAIN_THREADS: usize = 128;
+const DRAIN_TIMEOUT: Duration = Duration::from_secs(60);
+
+enum ClosePurpose {
+    Transfer,
+    InstanceMaintenance,
+}
+
+pub(super) enum ActorCloseError {
+    IdleRejected(JSONRPCErrorError),
+    Unverified(JSONRPCErrorError),
+}
+
+impl From<JSONRPCErrorError> for ActorCloseError {
+    fn from(error: JSONRPCErrorError) -> Self {
+        Self::Unverified(error)
+    }
+}
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn managed_close_idle(
+        &self,
+        params: ThreadManagedCloseIdleParams,
+        queues: &ThreadQueueRequestProcessor,
+    ) -> Result<ThreadManagedCloseIdleResponse, JSONRPCErrorError> {
+        tokio::time::timeout(
+            DRAIN_TIMEOUT,
+            self.managed_close_idle_inner(params, queues, ClosePurpose::Transfer),
+        )
+        .await
+        .map_err(|_| {
+            internal_error(
+                "managed close timed out; release is unverified and ownership must not transfer",
+            )
+        })?
+    }
+
+    pub(crate) async fn managed_close_for_maintenance(
+        &self,
+        params: ThreadManagedCloseIdleParams,
+        queues: &ThreadQueueRequestProcessor,
+        _admission: &crate::managed_instance_activity::ManagedMaintenanceGuard,
+    ) -> Result<ThreadManagedCloseIdleResponse, JSONRPCErrorError> {
+        self.managed_close_idle_inner(params, queues, ClosePurpose::InstanceMaintenance)
+            .await
+    }
+
+    async fn managed_close_idle_inner(
+        &self,
+        params: ThreadManagedCloseIdleParams,
+        queues: &ThreadQueueRequestProcessor,
+        purpose: ClosePurpose,
+    ) -> Result<ThreadManagedCloseIdleResponse, JSONRPCErrorError> {
+        if !crate::managed_sources::is_enabled() {
+            return Err(invalid_request(
+                "managed idle close is not enabled for this instance",
+            ));
+        }
+        let root_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_request("managed idle close requires a valid thread UUID"))?;
+        let root = self
+            .thread_manager
+            .get_thread(root_id)
+            .await
+            .map_err(|_| invalid_request("managed idle close requires a loaded root actor"))?;
+        if root
+            .config_snapshot()
+            .await
+            .session_source
+            .is_non_root_agent()
+        {
+            return Err(invalid_request(
+                "close the owning root and its complete spawn subtree",
+            ));
+        }
+        let blockers = root.managed_idle_blockers().await;
+        if !blockers.is_empty() {
+            return Err(invalid_request(format!(
+                "root thread is not idle: {}",
+                blockers.join(", ")
+            )));
+        }
+        // Avoid reserving a parent while a known child is working. The checks
+        // are repeated after reservation; this pass only reduces interference.
+        for id in self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+            .map_err(|error| internal_error(format!("cannot inspect managed subtree: {error}")))?
+        {
+            if let Ok(actor) = self.thread_manager.get_thread(id).await {
+                let blockers = actor.managed_idle_blockers().await;
+                if !blockers.is_empty() {
+                    return Err(invalid_request(format!(
+                        "thread {id} is not idle: {}",
+                        blockers.join(", ")
+                    )));
+                }
+            }
+        }
+        let root_admission = root.try_reserve_idle_close().map_err(|error| {
+            invalid_request(format!("cannot reserve root for managed close: {error}"))
+        })?;
+        let mut ids = self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+            .map_err(|error| {
+                internal_error(format!("cannot inventory managed descendants: {error}"))
+            })?;
+        ids.sort_by_cached_key(std::string::ToString::to_string);
+        ids.dedup();
+        if ids.len() > MAX_DRAIN_THREADS {
+            return Err(invalid_request(
+                "managed subtree exceeds the bounded close limit",
+            ));
+        }
+        let mut drain = self.managed_request_gate.try_drain(&ids)?;
+        let root_binding = self
+            .thread_manager
+            .managed_record_binding(root_id)
+            .await
+            .ok_or_else(|| invalid_request("root actor has no immutable managed source binding"))?;
+        let mut cold = self
+            .thread_manager
+            .prepare_managed_cold_drain(&root, &root_admission, &ids)
+            .await
+            .map_err(|error| invalid_request(format!("cannot reserve managed subtree: {error}")))?;
+
+        let mut actors = HashMap::new();
+        let mut admissions = HashMap::from([(root_id, root_admission)]);
+        let mut parents = HashMap::new();
+        let mut queue_guards = Vec::new();
+        for id in &ids {
+            let actor = self.thread_manager.get_thread(*id).await.ok();
+            if !self
+                .outgoing
+                .pending_requests_for_thread(*id)
+                .await
+                .is_empty()
+            {
+                return Err(invalid_request(format!(
+                    "thread {id} has a client request pending"
+                )));
+            }
+            if let Some(state) = self.thread_state_manager.get_thread_state(*id).await {
+                let state = state.lock().await;
+                let unknown_listener = state.cancel_tx.is_some()
+                    && actor
+                        .as_ref()
+                        .is_none_or(|actor| !state.listener_matches(actor));
+                if state.active_turn_snapshot().is_some()
+                    || !state.pending_interrupts.is_empty()
+                    || state.pending_rollbacks.is_some()
+                    || !state.turn_summary.command_execution_started.is_empty()
+                    || unknown_listener
+                {
+                    return Err(invalid_request(format!(
+                        "thread {id} has undrained runtime events"
+                    )));
+                }
+            }
+            let parent = if let Some(actor) = actor {
+                if *id != root_id {
+                    let blockers = actor.managed_idle_blockers().await;
+                    if !blockers.is_empty() {
+                        return Err(invalid_request(format!(
+                            "descendant {id} is not idle: {}",
+                            blockers.join(", ")
+                        )));
+                    }
+                    admissions.insert(
+                        *id,
+                        actor.try_reserve_idle_close().map_err(|error| {
+                            invalid_request(format!(
+                                "cannot reserve descendant {id} for managed close: {error}"
+                            ))
+                        })?,
+                    );
+                }
+                let binding = self
+                    .thread_manager
+                    .managed_record_binding(*id)
+                    .await
+                    .ok_or_else(|| {
+                        invalid_request(format!("actor {id} has no managed source binding"))
+                    })?;
+                if binding.source_id() != root_binding.source_id()
+                    || binding.source_config().codex_home != root_binding.source_config().codex_home
+                    || binding.authority_grant().owner_profile_id
+                        != root_binding.authority_grant().owner_profile_id
+                {
+                    return Err(invalid_request(
+                        "managed subtree spans different sources or owners",
+                    ));
+                }
+                let status = actor.agent_status().await;
+                if matches!(status, AgentStatus::Running)
+                    || (*id != root_id && matches!(status, AgentStatus::PendingInit))
+                    || !actor.list_background_terminals().await.is_empty()
+                {
+                    return Err(invalid_request(format!(
+                        "thread {id} is active; wait for completion"
+                    )));
+                }
+                queue_guards.push(queues.lock_for_managed_close(*id).await?);
+                let snapshot = actor.config_snapshot().await;
+                let parent = snapshot
+                    .parent_thread_id
+                    .or_else(|| snapshot.session_source.parent_thread_id());
+                actors.insert(*id, actor);
+                parent
+            } else {
+                if !cold.contains(*id) {
+                    return Err(invalid_request(format!(
+                        "descendant {id} has no held canonical writer reservation"
+                    )));
+                }
+                queue_guards.push(queues.lock_for_managed_cold_close(*id, &cold).await?);
+                cold.parent_thread_id(*id)
+            };
+            if *id != root_id && parent.is_none_or(|parent| !ids.contains(&parent)) {
+                return Err(invalid_request(
+                    "managed subtree parent relationship is unknown",
+                ));
+            }
+            parents.insert(*id, parent);
+        }
+        let order = leaves_first(parents)?;
+        let mut observed_ids = self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+            .map_err(|error| {
+                internal_error(format!("cannot recheck managed descendants: {error}"))
+            })?;
+        observed_ids.sort_by_cached_key(std::string::ToString::to_string);
+        observed_ids.dedup();
+        if observed_ids != ids {
+            return Err(invalid_request(
+                "managed descendants changed during close preflight; retry",
+            ));
+        }
+        {
+            let mut pending = self.pending_thread_unloads.lock().await;
+            if ids.iter().any(|id| pending.contains(id)) {
+                return Err(invalid_request("a subtree actor is already closing"));
+            }
+            pending.extend(ids.iter().copied());
+        }
+        // Persist the admission fence before the first core request. Cancellation,
+        // partial success, and timeout must not reopen partially released actors.
+        drain.arm();
+        let mut closed = Vec::new();
+        for id in order {
+            let result = if let Some(actor) = actors.get(&id) {
+                let admission = admissions
+                    .remove(&id)
+                    .ok_or_else(|| internal_error("managed close reservation disappeared"))?;
+                self.close_managed_actor(id, actor, admission).await
+            } else {
+                match cold.close_thread(id).await {
+                    Err(error) => Err(ActorCloseError::Unverified(internal_error(format!(
+                        "cold descendant {id} did not provide a release proof: {error}"
+                    )))),
+                    Ok(()) => {
+                        self.finish_managed_thread_close(id).await;
+                        Ok(())
+                    }
+                }
+            };
+            match result {
+                Ok(()) => closed.push(id.to_string()),
+                Err(ActorCloseError::IdleRejected(error)) if closed.is_empty() => {
+                    let mut pending = self.pending_thread_unloads.lock().await;
+                    for id in &ids {
+                        pending.remove(id);
+                    }
+                    drain.release_after_rejected_close();
+                    return Err(error);
+                }
+                Err(ActorCloseError::IdleRejected(error) | ActorCloseError::Unverified(error)) => {
+                    return Err(error);
+                }
+            }
+        }
+        match purpose {
+            ClosePurpose::Transfer => drain.commit(),
+            ClosePurpose::InstanceMaintenance => drain.release_after_verified_maintenance(),
+        }
+        drop(queue_guards);
+        Ok(ThreadManagedCloseIdleResponse {
+            thread_id: root_id.to_string(),
+            closed_thread_ids: closed,
+            writer_release_verified: true,
+        })
+    }
+
+    pub(super) async fn close_managed_actor(
+        &self,
+        id: ThreadId,
+        actor: &Arc<CodexThread>,
+        admission: IdleCloseAdmission,
+    ) -> Result<(), ActorCloseError> {
+        let state = self.thread_state_manager.thread_state(id).await;
+        let listener_drain: Option<oneshot::Receiver<()>> = {
+            let mut state = state.lock().await;
+            state
+                .listener_matches(actor)
+                .then(|| state.register_shutdown_drain_waiter())
+        };
+        if let Err(error) = actor.close_idle_and_shutdown_reserved(admission).await {
+            let rejected = matches!(error.details(), CodexErrorDetails::UnsupportedOperation(_));
+            let error = invalid_request(format!(
+                "thread {id} did not provide a release proof: {error}",
+            ));
+            if rejected {
+                state.lock().await.take_shutdown_drain_waiter();
+                return Err(ActorCloseError::IdleRejected(error));
+            }
+            return Err(ActorCloseError::Unverified(error));
+        }
+        if let Some(listener_drain) = listener_drain {
+            listener_drain.await.map_err(|_| {
+                internal_error(format!(
+                    "thread {id} listener ended before its shutdown event was drained",
+                ))
+            })?;
+        }
+        if !self
+            .outgoing
+            .pending_requests_for_thread(id)
+            .await
+            .is_empty()
+        {
+            return Err(internal_error(format!(
+                "thread {id} still has client callbacks after shutdown"
+            ))
+            .into());
+        }
+        if self
+            .thread_manager
+            .remove_thread_if_matches(&id, actor)
+            .await
+            .is_none()
+        {
+            return Err(internal_error(format!("thread {id} was replaced while closing")).into());
+        }
+        self.finish_managed_thread_close(id).await;
+        Ok(())
+    }
+
+    async fn finish_managed_thread_close(&self, id: ThreadId) {
+        self.thread_state_manager.remove_thread_state(id).await;
+        self.thread_watch_manager
+            .remove_thread(&id.to_string())
+            .await;
+        self.pending_thread_unloads.lock().await.remove(&id);
+        self.outgoing
+            .send_server_notification(ServerNotification::ThreadClosed(ThreadClosedNotification {
+                thread_id: id.to_string(),
+            }))
+            .await;
+    }
+}
+
+pub(super) fn leaves_first(
+    mut parents: HashMap<ThreadId, Option<ThreadId>>,
+) -> Result<Vec<ThreadId>, JSONRPCErrorError> {
+    let mut order = Vec::with_capacity(parents.len());
+    while !parents.is_empty() {
+        let parent_ids: HashSet<ThreadId> = parents.values().filter_map(|parent| *parent).collect();
+        let leaf = parents
+            .keys()
+            .filter(|id| !parent_ids.contains(id))
+            .min_by_key(std::string::ToString::to_string)
+            .copied()
+            .ok_or_else(|| invalid_request("managed subtree contains a parent cycle"))?;
+        parents.remove(&leaf);
+        order.push(leaf);
+    }
+    Ok(order)
+}
diff --git a/codex-rs/app-server/src/request_processors/managed_thread_idle_status.rs b/codex-rs/app-server/src/request_processors/managed_thread_idle_status.rs
new file mode 100644
index 000000000..8e15415c2
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/managed_thread_idle_status.rs
@@ -0,0 +1,224 @@
+//! Advisory, read-only activity inventory for a managed canonical subtree.
+
+use super::ThreadQueueRequestProcessor;
+use super::ThreadRequestProcessor;
+use crate::error_code::internal_error;
+use crate::error_code::invalid_request;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ThreadManagedIdleBlocker;
+use codex_app_server_protocol::ThreadManagedIdleProofScope;
+use codex_app_server_protocol::ThreadManagedIdleStatusParams;
+use codex_app_server_protocol::ThreadManagedIdleStatusResponse;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::AgentStatus;
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::time::Duration;
+
+const MAX_OBSERVED_THREADS: usize = 128;
+const OBSERVATION_TIMEOUT: Duration = Duration::from_secs(10);
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn managed_idle_status(
+        &self,
+        params: ThreadManagedIdleStatusParams,
+        queues: &ThreadQueueRequestProcessor,
+    ) -> Result<ThreadManagedIdleStatusResponse, JSONRPCErrorError> {
+        tokio::time::timeout(
+            OBSERVATION_TIMEOUT,
+            self.managed_idle_status_inner(params, queues),
+        )
+        .await
+        .map_err(|_| internal_error("managed activity observation timed out; state is unknown"))?
+    }
+
+    async fn managed_idle_status_inner(
+        &self,
+        params: ThreadManagedIdleStatusParams,
+        queues: &ThreadQueueRequestProcessor,
+    ) -> Result<ThreadManagedIdleStatusResponse, JSONRPCErrorError> {
+        if !crate::managed_sources::is_enabled() {
+            return Err(invalid_request(
+                "managed idle status is not enabled for this instance",
+            ));
+        }
+        let root_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_request("managed idle status requires a valid thread UUID"))?;
+        let root = self
+            .thread_manager
+            .get_thread(root_id)
+            .await
+            .map_err(|_| invalid_request("managed idle status requires a loaded root actor"))?;
+        if root
+            .config_snapshot()
+            .await
+            .session_source
+            .is_non_root_agent()
+        {
+            return Err(invalid_request(
+                "observe the owning root and its complete spawn subtree",
+            ));
+        }
+        // This only reads an already installed binding. Do not bind a manifest,
+        // acquire an ownership permit, or initialize a store while observing.
+        let root_binding = self
+            .thread_manager
+            .managed_record_binding(root_id)
+            .await
+            .ok_or_else(|| invalid_request("root actor has no immutable managed source binding"))?;
+        let mut ids = self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+            .map_err(|_| internal_error("cannot inspect the canonical managed subtree"))?;
+        ids.sort_by_cached_key(std::string::ToString::to_string);
+        ids.dedup();
+        if ids.is_empty() || !ids.contains(&root_id) || ids.len() > MAX_OBSERVED_THREADS {
+            return Err(invalid_request(
+                "managed idle status requires a bounded canonical subtree",
+            ));
+        }
+
+        let mut blockers = Vec::new();
+        let mut actors = HashMap::new();
+        for id in &ids {
+            let Ok(actor) = self.thread_manager.get_thread(*id).await else {
+                // A cold persisted child is not evidence of inactivity: it may
+                // still have a writer in another process or an unknown state.
+                // Only strict close can resolve this with a held writer claim.
+                add_blocker(
+                    &mut blockers,
+                    *id,
+                    if *id == root_id {
+                        "threadNotLoaded"
+                    } else {
+                        "coldDescendantRequiresWriterClaim"
+                    },
+                );
+                if !self
+                    .outgoing
+                    .pending_requests_for_thread(*id)
+                    .await
+                    .is_empty()
+                {
+                    add_blocker(&mut blockers, *id, "pendingClientRequest");
+                }
+                if let Some(state) = self.thread_state_manager.get_thread_state(*id).await {
+                    let state = state.lock().await;
+                    if state.active_turn_snapshot().is_some()
+                        || !state.pending_interrupts.is_empty()
+                        || state.pending_rollbacks.is_some()
+                        || !state.turn_summary.command_execution_started.is_empty()
+                        || state.cancel_tx.is_some()
+                    {
+                        add_blocker(&mut blockers, *id, "undrainedRuntimeEvents");
+                    }
+                }
+                continue;
+            };
+            let Some(binding) = self.thread_manager.managed_record_binding(*id).await else {
+                add_blocker(&mut blockers, *id, "sourceBindingUnknown");
+                continue;
+            };
+            if binding.source_id() != root_binding.source_id() {
+                add_blocker(&mut blockers, *id, "sourceMismatch");
+                continue;
+            }
+            let status = actor.agent_status().await;
+            // An initialized root stays PendingInit until its first turn.
+            // Its actual startup, input and hook work is checked below.
+            if matches!(status, AgentStatus::Running)
+                || (*id != root_id && matches!(status, AgentStatus::PendingInit))
+            {
+                add_blocker(&mut blockers, *id, "agentActive");
+            }
+            for kind in actor.managed_idle_blockers().await {
+                add_blocker(&mut blockers, *id, &kind);
+            }
+            if !self
+                .outgoing
+                .pending_requests_for_thread(*id)
+                .await
+                .is_empty()
+            {
+                add_blocker(&mut blockers, *id, "pendingClientRequest");
+            }
+            if let Some(state) = self.thread_state_manager.get_thread_state(*id).await {
+                let state = state.lock().await;
+                if state.active_turn_snapshot().is_some()
+                    || !state.pending_interrupts.is_empty()
+                    || state.pending_rollbacks.is_some()
+                    || !state.turn_summary.command_execution_started.is_empty()
+                    || (state.cancel_tx.is_some() && !state.listener_matches(&actor))
+                {
+                    add_blocker(&mut blockers, *id, "undrainedRuntimeEvents");
+                }
+            }
+            match queues.has_managed_pending(*id).await {
+                Ok(true) => add_blocker(&mut blockers, *id, "queuedUserInput"),
+                Ok(false) => {}
+                Err(_) => add_blocker(&mut blockers, *id, "queueStateUnknown"),
+            }
+            let snapshot = actor.config_snapshot().await;
+            let parent = snapshot
+                .parent_thread_id
+                .or_else(|| snapshot.session_source.parent_thread_id());
+            if *id != root_id && parent.is_none_or(|parent| !ids.contains(&parent)) {
+                add_blocker(&mut blockers, *id, "parentRelationshipUnknown");
+            }
+            actors.insert(*id, actor);
+        }
+        {
+            let pending = self.pending_thread_unloads.lock().await;
+            for id in &ids {
+                if pending.contains(id) {
+                    add_blocker(&mut blockers, *id, "actorClosing");
+                }
+            }
+        }
+        match self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+        {
+            Ok(mut observed) => {
+                observed.sort_by_cached_key(std::string::ToString::to_string);
+                observed.dedup();
+                if observed != ids {
+                    add_blocker(&mut blockers, root_id, "subtreeChanged");
+                }
+            }
+            Err(_) => add_blocker(&mut blockers, root_id, "subtreeStateUnknown"),
+        }
+        for (id, actor) in actors {
+            if !self
+                .thread_manager
+                .get_thread(id)
+                .await
+                .is_ok_and(|current| Arc::ptr_eq(&current, &actor))
+            {
+                add_blocker(&mut blockers, id, "actorChanged");
+            }
+        }
+        blockers.sort_by(|left, right| {
+            (&left.thread_id, &left.kind).cmp(&(&right.thread_id, &right.kind))
+        });
+        blockers.dedup();
+        Ok(ThreadManagedIdleStatusResponse {
+            thread_id: root_id.to_string(),
+            host_id: root_binding.source_id().host_id.clone(),
+            source_store_id: root_binding.source_id().store_id.clone(),
+            observed_thread_ids: ids.iter().map(ToString::to_string).collect(),
+            idle: blockers.is_empty(),
+            blockers,
+            proof_scope: ThreadManagedIdleProofScope::Advisory,
+        })
+    }
+}
+
+fn add_blocker(blockers: &mut Vec<ThreadManagedIdleBlocker>, thread_id: ThreadId, kind: &str) {
+    blockers.push(ThreadManagedIdleBlocker {
+        thread_id: thread_id.to_string(),
+        kind: kind.to_string(),
+    });
+}
