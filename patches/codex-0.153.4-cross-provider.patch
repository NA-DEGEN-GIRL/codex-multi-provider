@@ -0,0 +1,212 @@
+use super::*;
+use codex_protocol::error::CodexErrorDetails;
+use pretty_assertions::assert_eq;
+
+const PROFILE: &str = "11111111-1111-4111-8111-111111111111";
+
+fn renewed(kind: &str) -> anyhow::Result<Option<ExecutionPresetAuthTokensReadResponse>> {
+    Ok(Some(ExecutionPresetAuthTokensReadResponse {
+        kind: kind.to_string(),
+        access_token: "dummy-token-2".to_string(),
+        chatgpt_account_id: None,
+        expires_at: Some(2_000_000_000),
+        account_identity: Some("fixture-identity".to_string()),
+        credential_source: None,
+        credential_id: None,
+    }))
+}
+
+const SAVED: &str = "44444444-4444-4444-8444-444444444444";
+
+fn lent(source: Option<&str>, id: Option<&str>) -> ExecutionPresetAuthTokensReadResponse {
+    ExecutionPresetAuthTokensReadResponse {
+        credential_source: source.map(str::to_string),
+        credential_id: id.map(str::to_string),
+        ..renewed("claude").expect("fixture").expect("fixture")
+    }
+}
+
+#[test]
+fn source_keys_reach_the_runner_only_when_the_broker_reported_them() {
+    let shapes = [
+        lent(None, None),
+        lent(Some("windowsLogin"), None),
+        lent(Some("longLivedToken"), Some(SAVED)),
+    ]
+    .iter()
+    .map(|response| credentials(PROFILE, response).expect("credentials"))
+    .collect::<Vec<_>>();
+    let base = json!({"profileId":PROFILE,"accessToken":"dummy-token-2","expiresAt":2_000_000_000,
+        "accountIdentity":"fixture-identity"});
+    let mut windows = base.clone();
+    windows["credentialSource"] = json!("windowsLogin");
+    windows["credentialId"] = Value::Null;
+    let mut saved = base.clone();
+    saved["credentialSource"] = json!("longLivedToken");
+    saved["credentialId"] = json!(SAVED);
+    assert_eq!(shapes, vec![base, windows, saved]);
+}
+
+#[test]
+fn only_a_lent_long_lived_credential_can_be_reported_refused_and_only_once() {
+    let mut lent_sources = Lent::default();
+    lent_sources.record(&credentials(PROFILE, &lent(Some("windowsLogin"), None)).expect("lent"));
+    assert_eq!(lent_sources.refuse(&json!(SAVED)), None, "never lent");
+    lent_sources
+        .record(&credentials(PROFILE, &lent(Some("longLivedToken"), Some(SAVED))).expect("lent"));
+    assert_eq!(lent_sources.refuse(&json!(7)), None);
+    assert_eq!(lent_sources.refused(), None);
+    assert_eq!(lent_sources.refuse(&json!(SAVED)), Some(SAVED.to_string()));
+    assert_eq!(lent_sources.refuse(&json!(SAVED)), None, "reported once");
+    assert_eq!(lent_sources.refused(), Some(SAVED));
+    // A renewal reply names a newer saved credential the same way.
+    let newer = "55555555-5555-4555-8555-555555555555";
+    lent_sources.record(&json!({"type":"auth_update","available":true,
+        "credentials":{"credentialSource":"longLivedToken","credentialId":newer}}));
+    assert_eq!(lent_sources.refuse(&json!(newer)), Some(newer.to_string()));
+}
+
+#[test]
+fn a_listed_broker_refusal_explains_the_unavailable_account() {
+    let refused = anyhow::Error::from(std::io::Error::other(
+        ExecutionPresetAuthRefusal::ClaudeLongLivedExpired,
+    ));
+    let generic = anyhow::anyhow!("selected managed account is unavailable or changed");
+    assert_eq!(
+        [
+            unavailable_account(&refused).to_string(),
+            unavailable_account(&generic).to_string()
+        ],
+        [
+            format!(
+                "Claude agent: {}",
+                ExecutionPresetAuthRefusal::ClaudeLongLivedExpired
+            ),
+            "Claude agent: the selected Claude account is unavailable".to_string()
+        ]
+    );
+}
+
+#[tokio::test]
+async fn borrowed_token_is_renewed_with_the_runner_credential_shape() {
+    let reply = respond(
+        PROFILE,
+        async { renewed("claude") },
+        &CancellationToken::new(),
+    )
+    .await
+    .expect("reply");
+    assert_eq!(
+        reply,
+        json!({"type":"auth_update","available":true,"credentials":{
+            "profileId":PROFILE,"accessToken":"dummy-token-2","expiresAt":2_000_000_000,
+            "accountIdentity":"fixture-identity"}})
+    );
+}
+
+#[tokio::test]
+async fn refused_missing_or_foreign_credentials_are_unavailable() {
+    let cancellation = CancellationToken::new();
+    let refused = respond(
+        PROFILE,
+        async { Err(anyhow::anyhow!("account changed")) },
+        &cancellation,
+    )
+    .await
+    .expect("reply");
+    let missing = respond(PROFILE, async { Ok(None) }, &cancellation)
+        .await
+        .expect("reply");
+    let foreign = respond(PROFILE, async { renewed("openai") }, &cancellation)
+        .await
+        .expect("reply");
+    assert_eq!(
+        (refused, missing, foreign),
+        (unavailable(), unavailable(), unavailable())
+    );
+}
+
+#[test]
+fn reasons_are_read_from_the_request_and_older_runners_mean_expiry() {
+    let reasons = [
+        json!({"type":"auth_refresh"}),
+        json!({"type":"auth_refresh","reason":"expired"}),
+        json!({"type":"auth_refresh","reason":"switch"}),
+        json!({"type":"auth_refresh","reason":"rotate"}),
+        json!({"type":"auth_refresh","reason":"later"}),
+        json!({"type":"auth_refresh","reason":2}),
+    ]
+    .iter()
+    .map(Reason::of)
+    .collect::<Vec<_>>();
+    assert_eq!(
+        reasons,
+        vec![
+            Reason::Expired,
+            Reason::Expired,
+            Reason::Switch,
+            Reason::Rotate,
+            Reason::Unknown,
+            Reason::Unknown
+        ]
+    );
+}
+
+#[test]
+fn a_turn_without_a_borrowed_token_never_resolves() {
+    let mut refresh = AuthRefresh::unavailable();
+    assert!(!refresh.announced());
+    let now = Instant::now();
+    for reason in [Reason::Expired, Reason::Switch, Reason::Rotate] {
+        assert!(!refresh.admit(reason, now), "{reason:?}");
+    }
+}
+
+#[test]
+fn expiry_and_source_switch_budgets_are_separate_and_unknown_reasons_are_refused() {
+    let mut refresh = AuthRefresh::borrowed();
+    assert!(refresh.announced());
+    let now = Instant::now();
+    let admitted = [
+        Reason::Expired,
+        Reason::Expired,
+        Reason::Expired,
+        Reason::Switch,
+        Reason::Switch,
+        Reason::Switch,
+        Reason::Unknown,
+    ]
+    .into_iter()
+    .map(|reason| refresh.admit(reason, now))
+    .collect::<Vec<_>>();
+    assert_eq!(admitted, vec![true, true, false, true, true, false, false]);
+    // Rotations have their own budget after both others are spent.
+    assert!(refresh.admit(Reason::Rotate, now));
+}
+
+#[test]
+fn rotations_are_spaced_and_capped_without_touching_the_expiry_budget() {
+    let mut refresh = AuthRefresh::borrowed();
+    let start = Instant::now();
+    assert!(refresh.admit(Reason::Rotate, start));
+    assert!(!refresh.admit(Reason::Rotate, start + Duration::from_secs(14)));
+    let mut admitted: u16 = 1;
+    for step in 1..=40u32 {
+        if refresh.admit(Reason::Rotate, start + ROTATION_INTERVAL * step) {
+            admitted += 1;
+        }
+    }
+    assert_eq!(admitted, ROTATIONS);
+    assert!(refresh.admit(Reason::Expired, start));
+    assert!(refresh.admit(Reason::Expired, start));
+}
+
+#[tokio::test]
+async fn cancellation_stops_a_pending_renewal() {
+    let cancellation = CancellationToken::new();
+    cancellation.cancel();
+    let error = respond(PROFILE, std::future::pending(), &cancellation)
+        .await
+        .expect_err("cancelled");
+    assert!(matches!(error.details(), CodexErrorDetails::TurnAborted));
+}
diff --git a/codex-rs/core/src/tasks/claude_code/bridge.rs b/codex-rs/core/src/tasks/claude_code/bridge.rs
