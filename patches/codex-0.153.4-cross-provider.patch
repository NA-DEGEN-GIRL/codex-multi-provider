+#[tokio::test]
+async fn shared_spawn_admission_blocks_only_activation_of_the_same_uuid() {
+    let fixture = ActivationFixture::new().await;
+    let binding = fixture.seed_root().await;
+    let root_lock = fixture
+        .manager
+        .state
+        .managed_lifecycle_locks_for(&[fixture.root])
+        .pop()
+        .expect("root admission");
+    let first_spawn = Arc::clone(&root_lock).read_owned().await;
+    let second_spawn = Arc::clone(&root_lock)
+        .try_read_owned()
+        .expect("concurrent startup reader");
+    let other_lock = fixture
+        .manager
+        .state
+        .managed_lifecycle_locks_for(&[ThreadId::new()])
+        .pop()
+        .expect("unrelated admission");
+    let unrelated = Arc::clone(&other_lock)
+        .try_write_owned()
+        .expect("unrelated exclusive admission");
+    let grants = [(fixture.root, fixture.grant(/*epoch*/ 1))];
+    let before = fixture.bindings().await;
+    assert!(
+        fixture
+            .manager
+            .activate_managed_record_binding(binding.clone(), &grants)
+            .await
+            .is_err()
+    );
+    assert_eq!(fixture.bindings().await, before);
+    drop(first_spawn);
+    assert!(
+        fixture
+            .manager
+            .activate_managed_record_binding(binding.clone(), &grants)
+            .await
+            .is_err()
+    );
+    drop(second_spawn);
+    fixture
+        .manager
+        .activate_managed_record_binding(binding, &grants)
+        .await
+        .expect("unrelated exclusive admission does not block this root");
+    let activation = root_lock
+        .try_write_owned()
+        .expect("root exclusive admission");
+    let root_again = fixture
+        .manager
+        .state
+        .managed_lifecycle_locks_for(&[fixture.root])
+        .pop()
+        .expect("same canonical lock while activation owns it");
+    assert!(
+        root_again.try_read_owned().is_err(),
+        "activation excludes late startup"
+    );
+    drop(activation);
+    drop(unrelated);
+}
