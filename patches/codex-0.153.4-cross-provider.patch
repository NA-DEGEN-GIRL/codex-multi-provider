index 0000000000000000000000000000000000000000..be6cb46f4c9e3b3d3c009f4251f37acb2dfe0c59
--- /dev/null
+++ b/codex-rs/app-server/src/managed_read_store.rs
@@ -0,0 +1,293 @@
+//! Private compatibility adapter for browsing one canonical source record.
+//!
+//! The backing reader has no writer or database initialization path. Keep this adapter private:
+//! `ThreadStore` is needed by existing app-server read handlers, not to expose a writable source.
+
+use std::any::Any;
+use std::sync::Arc;
+
+use codex_protocol::ThreadId;
+use codex_thread_store::AppendThreadItemsParams;
+use codex_thread_store::ArchiveThreadParams;
+use codex_thread_store::ArchiveThreadsParams;
+use codex_thread_store::CreateThreadParams;
+use codex_thread_store::DeleteThreadParams;
+use codex_thread_store::DeleteThreadsParams;
+use codex_thread_store::ItemPage;
+use codex_thread_store::ListItemsParams;
+use codex_thread_store::ListThreadsParams;
+use codex_thread_store::ListTimelineParams;
+use codex_thread_store::ListTurnsParams;
+use codex_thread_store::LoadThreadHistoryParams;
+use codex_thread_store::LocalThreadStoreConfig;
+use codex_thread_store::PersistContext;
+use codex_thread_store::ReadOnlyLocalThreadStore;
+use codex_thread_store::ReadThreadByRolloutPathParams;
+use codex_thread_store::ReadThreadParams;
+use codex_thread_store::ResumeThreadParams;
+use codex_thread_store::SearchThreadOccurrencesParams;
+use codex_thread_store::StoredModelContext;
+use codex_thread_store::StoredThread;
+use codex_thread_store::StoredThreadHistory;
+use codex_thread_store::ThreadOccurrenceSearchPage;
+use codex_thread_store::ThreadPage;
+use codex_thread_store::ThreadStore;
+use codex_thread_store::ThreadStoreError;
+use codex_thread_store::ThreadStoreFuture;
+use codex_thread_store::ThreadStoreResult;
+use codex_thread_store::TimelinePage;
+use codex_thread_store::TurnPage;
+use codex_thread_store::UpdateThreadMetadataParams;
+
+struct ManagedReadStore {
+    reader: ReadOnlyLocalThreadStore,
+    thread_id: ThreadId,
+    source_config: LocalThreadStoreConfig,
+}
+
+/// Own-profile discovery handle with no live-thread or write interface.
+pub(crate) struct ManagedReadList {
+    reader: ReadOnlyLocalThreadStore,
+    default_model_provider_id: String,
+}
+
+pub(crate) async fn open_list(
+    config: LocalThreadStoreConfig,
+) -> ThreadStoreResult<ManagedReadList> {
+    Ok(ManagedReadList {
+        reader: ReadOnlyLocalThreadStore::open(config.codex_home, config.sqlite).await?,
+        default_model_provider_id: config.default_model_provider_id,
+    })
+}
+
+impl ManagedReadList {
+    pub(crate) async fn list_threads(
+        &self,
+        params: ListThreadsParams,
+    ) -> ThreadStoreResult<ThreadPage> {
+        self.reader
+            .list_threads(params, &self.default_model_provider_id)
+            .await
+    }
+
+    pub(crate) async fn project_exists(&self, project_id: &str) -> ThreadStoreResult<bool> {
+        self.reader.project_exists(project_id).await
+    }
+}
+
+pub(crate) async fn open(
+    config: LocalThreadStoreConfig,
+    thread_id: ThreadId,
+) -> ThreadStoreResult<Arc<dyn ThreadStore>> {
+    let source_config = config.clone();
+    Ok(Arc::new(ManagedReadStore {
+        reader: ReadOnlyLocalThreadStore::open(config.codex_home, config.sqlite).await?,
+        thread_id,
+        source_config,
+    }))
+}
+
+pub(crate) fn is_read_only_store(store: &dyn ThreadStore) -> bool {
+    store.as_any().is::<ManagedReadStore>()
+}
+
+/// Matches the immutable source selected at open against an actor's current canonical binding.
+pub(crate) fn matches_source(
+    store: &dyn ThreadStore,
+    config: &LocalThreadStoreConfig,
+    thread_id: ThreadId,
+) -> bool {
+    store
+        .as_any()
+        .downcast_ref::<ManagedReadStore>()
+        .is_some_and(|store| store.thread_id == thread_id && store.source_config == *config)
+}
+
+/// Reads source metadata without opening a writer or initializing source databases.
+pub(crate) async fn read_metadata(
+    store: &dyn ThreadStore,
+    thread_id: ThreadId,
+) -> ThreadStoreResult<Option<codex_state::ThreadMetadata>> {
+    let store =
+        store
+            .as_any()
+            .downcast_ref::<ManagedReadStore>()
+            .ok_or(ThreadStoreError::Unsupported {
+                operation: "read_metadata",
+            })?;
+    store.check_thread(thread_id)?;
+    store.reader.read_metadata(thread_id).await
+}
+
+impl ManagedReadStore {
+    fn check_thread(&self, thread_id: ThreadId) -> ThreadStoreResult<()> {
+        if thread_id != self.thread_id {
+            return Err(ThreadStoreError::InvalidRequest {
+                message: "read-only source store is bound to another canonical thread".to_string(),
+            });
+        }
+        Ok(())
+    }
+}
+
+fn unsupported<T: Send + 'static>(operation: &'static str) -> ThreadStoreFuture<'static, T> {
+    Box::pin(async move { Err(ThreadStoreError::Unsupported { operation }) })
+}
+
+impl ThreadStore for ManagedReadStore {
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+
+    fn create_thread(&self, _params: CreateThreadParams) -> ThreadStoreFuture<'_, ()> {
+        unsupported("create_thread")
+    }
+
+    fn resume_thread(&self, _params: ResumeThreadParams) -> ThreadStoreFuture<'_, ()> {
+        unsupported("resume_thread")
+    }
+
+    fn append_items(&self, _params: AppendThreadItemsParams) -> ThreadStoreFuture<'_, ()> {
+        unsupported("append_items")
+    }
+
+    fn persist_thread(
+        &self,
+        _thread_id: ThreadId,
+        _context: PersistContext,
+    ) -> ThreadStoreFuture<'_, ()> {
+        unsupported("persist_thread")
+    }
+
+    fn flush_thread(&self, _thread_id: ThreadId) -> ThreadStoreFuture<'_, ()> {
+        unsupported("flush_thread")
+    }
