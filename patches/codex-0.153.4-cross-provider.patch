+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn plaintext_reasoning_replays_in_generation_and_remote_compaction() -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let test = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_config(|config| {
+            let _ = config.features.disable(Feature::RemoteCompactionV2);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let native = json!({"type":"reasoning", "id":"rs_native", "summary":[],
+        "encrypted_content":"native-encrypted-state"});
+    let foreign = json!({"type":"reasoning", "id":"00000000-0000-4000-8000-000000000001",
+        "summary":[], "content":[{"type":"reasoning_text","text":"Keep the migration atomic."}],
+        "encrypted_content":"00000000-0000-4000-8000-000000000001-0"});
+    let generation = responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse(vec![
+                json!({"type":"response.output_item.done", "item":native.clone()}),
+                json!({"type":"response.output_item.done", "item":foreign}),
+                responses::ev_assistant_message("msg_first", "Ready."),
+                responses::ev_completed("resp_first"),
+            ]),
+            responses::sse(vec![
+                responses::ev_assistant_message("msg_second", "Continued."),
+                responses::ev_completed("resp_second"),
+            ]),
+        ],
+    )
+    .await;
+    let compact = responses::mount_compact_json_once(
+        &server,
+        json!({"output":[{
+            "type":"compaction", "encrypted_content":"compacted-state"
+        }]}),
+    )
+    .await;
+
+    for text in ["Start.", "Continue."] {
+        test.codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: text.to_string(),
+                text_elements: vec![],
+            }]))
+            .await?;
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        })
+        .await;
+    }
+    test.codex.submit(Op::Compact).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+
+    let requests = generation.requests();
+    assert_eq!(requests.len(), 2);
+    for request in [&requests[1], &compact.single_request()] {
+        let input = request.input();
+        let native_input = input
+            .iter()
+            .find(|item| item["type"] == "reasoning")
+            .expect("native reasoning remains");
+        assert_eq!(
+            native_input["encrypted_content"],
+            native["encrypted_content"]
+        );
+        assert!(input.iter().any(|item| item["type"] == "message"
+            && item["role"] == "assistant"
+            && item["content"]
+                == json!([{"type":"output_text","text":"Keep the migration atomic."}])));
+        let serialized = request.body_json().to_string();
+        assert!(!serialized.contains("reasoning_text"));
+        assert!(!serialized.contains("00000000-0000-4000-8000-000000000001-0"));
+    }
+    Ok(())
+}
