+/// Serves GPT through Responses Lite, as the ChatGPT backend serves GPT profiles, with a
+/// reasoning effort, reasoning summary and Fast tier that its compaction requests use.
+async fn write_responses_lite_config(codex_home: &TempDir, server: &MockServer) -> Result<()> {
+    write_config_with_root(
+        codex_home.path(),
+        server,
+        "model_reasoning_effort = \"high\"\nmodel_reasoning_summary = \"concise\"\nservice_tier = \"priority\"",
+        "",
+    )?;
+    let config = load_default_config_for_test(codex_home).await;
+    let mut model = codex_core::test_support::construct_model_info_offline(GPT_MODEL, &config);
+    model.use_responses_lite = true;
+    model.supports_reasoning_summary_parameter = true;
+    model.supported_reasoning_levels = [
+        codex_protocol::openai_models::ReasoningEffort::Low,
+        codex_protocol::openai_models::ReasoningEffort::High,
+    ]
+    .into_iter()
+    .map(
