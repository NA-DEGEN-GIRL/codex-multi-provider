+}
+
+impl ColdTreeFixture {
+    async fn new() -> Result<Self> {
+        let api = responses::start_mock_server().await;
+        responses::mount_sse_once_match(
+            &api,
+            |request: &wiremock::Request| {
+                let body = String::from_utf8_lossy(&request.body);
+                body.contains(PARENT_PROMPT) && !body.contains(SPAWN_CALL_ID)
+            },
+            responses::sse(vec![
+                responses::ev_response_created("spawn"),
+                responses::ev_function_call_with_namespace(
+                    SPAWN_CALL_ID,
+                    "collaboration",
+                    "spawn_agent",
+                    &json!({
+                        "message": CHILD_PROMPT,
+                        "task_name": "worker",
+                        "fork_turns": "none",
+                    })
+                    .to_string(),
+                ),
+                responses::ev_completed("spawn"),
+            ]),
+        )
+        .await;
+        Mock::given(method("POST"))
+            .and(path_regex(".*/responses$"))
+            .respond_with(responses::sse_response(responses::sse(vec![
+                responses::ev_response_created("parent-complete"),
+                responses::ev_assistant_message("parent-answer", "Parent complete"),
+                responses::ev_completed("parent-complete"),
+            ])))
+            .with_priority(10)
+            .mount(&api)
+            .await;
+        let child_request = responses::mount_sse_once_match(
+            &api,
+            |request: &wiremock::Request| {
+                let body = String::from_utf8_lossy(&request.body);
+                body.contains(CHILD_PROMPT) && !body.contains(SPAWN_CALL_ID)
+            },
+            responses::sse(vec![
+                responses::ev_response_created("worker"),
+                responses::ev_assistant_message("worker-answer", "Canonical worker completed"),
+                responses::ev_completed("worker"),
+            ]),
+        )
+        .await;
+        let home = TempDir::new()?;
+        let profile_id = Uuid::new_v4().to_string();
+        let source_id = format!("manager:{profile_id}");
+        MockResponsesConfig::new(&api.uri())
+            .with_provider_name("OpenAI")
+            .with_model("gpt-5.4")
+            .with_sandbox_mode("danger-full-access")
+            .with_extra_config("[features.multi_agent_v2]\nenabled = true")
+            .write(home.path())?;
+        write_models_cache(home.path())?;
+        fs::write(
+            home.path().join("managed-source.json"),
+            serde_json::to_vec(&json!({ "host_id": "local", "store_id": source_id }))?,
+        )?;
+        let manifest_path = home.path().join("managed-sources.json");
+        write_manifest(home.path(), &manifest_path, &profile_id, &source_id, &[])?;
+        let mut app = start_server(home.path(), &manifest_path).await?;
+        let root_id = app
+            .start_thread(ThreadStartParams::default())
+            .await?
+            .thread
+            .id;
+        let completed = timeout(
+            READ_TIMEOUT,
+            app.start_turn_and_wait_for_completion(turn_params(&root_id, PARENT_PROMPT)),
+        )
+        .await??;
+        assert_eq!(
+            (completed.turn.status, completed.turn.error),
+            (TurnStatus::Completed, None)
+        );
+        let request = timeout(READ_TIMEOUT, async {
+            loop {
+                // The recording matcher runs before the response filter and
+                // captures parent requests too. Select the actual worker.
+                if let Some(request) = child_request.requests().into_iter().find(|request| {
+                    request.body_contains_text(CHILD_PROMPT)
+                        && !request.body_contains_text(SPAWN_CALL_ID)
+                        && request.header("thread-id").as_deref() != Some(root_id.as_str())
+                }) {
+                    break request;
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await?;
+        let child_id = request
+            .header("thread-id")
+            .context("spawned worker thread ID")?;
+        timeout(READ_TIMEOUT, async {
+            loop {
+                let request_id = app
+                    .send_raw_request(
+                        "thread/managedIdleStatus",
+                        Some(json!({ "threadId": root_id })),
+                    )
+                    .await?;
+                let status: Value = app.read_response(request_id).await?;
+                if status["idle"] == true {
+                    break Ok::<(), anyhow::Error>(());
+                }
+                if status["blockers"].as_array().is_some_and(|blockers| {
+                    blockers.iter().any(|blocker| {
+                        blocker["threadId"] == root_id
+                            && blocker["kind"] == "pendingInputOrAgentMail"
+                    }) && !blockers.iter().any(|blocker| {
+                        blocker["threadId"] == root_id
+                            && matches!(
+                                blocker["kind"].as_str(),
+                                Some("activeTurn" | "agentActive")
+                            )
+                    })
+                }) {
+                    let completed = app
+                        .start_turn_and_wait_for_completion(turn_params(
+                            &root_id,
+                            "Record the completed worker result",
+                        ))
+                        .await?;
+                    assert_eq!(completed.turn.status, TurnStatus::Completed);
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await??;
+        let child: ThreadReadResponse = app
+            .request(|request_id| ClientRequest::ThreadRead {
+                request_id,
+                params: ThreadReadParams {
+                    thread_id: child_id.clone(),
+                    include_turns: false,
+                },
+            })
+            .await?;
+        assert_eq!(child.thread.parent_thread_id, Some(root_id.clone()));
+        assert_eq!(child.thread.can_accept_direct_input, Some(false));
+        let child_rollout = child.thread.path.context("worker rollout path")?;
+        assert!(
+            timeout(READ_TIMEOUT, app.shutdown_gracefully())
+                .await??
+                .success()
+        );
+        // Reopening uses the same durable owner grants. This fixture never
+        // invents an ownership transfer or changes the real V2 graph metadata.
+        write_manifest(
+            home.path(),
+            &manifest_path,
+            &profile_id,
+            &source_id,
+            &[root_id.as_str(), child_id.as_str()],
+        )?;
+        assert!(fs::read_to_string(&child_rollout)?.contains("Canonical worker completed"));
+        Ok(Self {
+            home,
+            profile_id,
+            source_id,
+            manifest_path,
+            root_id,
+            child_id,
+            child_rollout,
+            api,
+        })
+    }
+
+    async fn resume_root(&self) -> Result<TestAppServer> {
+        let mut app = start_server(self.home.path(), &self.manifest_path).await?;
+        let _: ThreadResumeResponse = app
+            .request(|request_id| ClientRequest::ThreadResume {
+                request_id,
+                params: ThreadResumeParams {
+                    thread_id: self.root_id.clone(),
+                    exclude_turns: true,
+                    ..Default::default()
+                },
+            })
+            .await?;
+        assert_eq!(loaded_ids(&mut app).await?, vec![self.root_id.clone()]);
+        Ok(app)
+    }
+
+    async fn open_children(&self) -> Result<Vec<ThreadId>> {
+        let state = StateRuntime::init(
+            codex_state::SqliteConfig::new_for_testing(self.home.path().abs()),
+            "mock_provider".to_string(),
+        )
+        .await?;
+        state
+            .list_thread_spawn_children_with_status(
+                ThreadId::from_string(&self.root_id)?,
+                DirectionalThreadSpawnEdgeStatus::Open,
+            )
+            .await
+    }
+
+    async fn model_request_count(&self) -> Result<usize> {
+        Ok(self
+            .api
+            .received_requests()
+            .await
+            .context("mock request log")?
+            .iter()
+            .filter(|request| {
+                request.url.path().ends_with("/responses")
+                    || request.url.path().ends_with("/guardian")
+            })
+            .count())
+    }
+}
+
+fn write_manifest(
+    home: &Path,
+    path: &Path,
+    profile_id: &str,
+    source_id: &str,
+    thread_ids: &[&str],
+) -> Result<()> {
+    let bindings = thread_ids
+        .iter()
+        .map(|thread_id| {
+            json!({
+                "threadId": thread_id, "hostId": "local", "sourceStoreId": source_id,
+                "ownerProfileId": profile_id, "ownershipEpoch": 1, "recordRevision": 1,
+            })
+        })
+        .collect::<Vec<_>>();
+    fs::write(
+        path,
+        serde_json::to_vec(&json!({
+            "version": 1, "hostId": "local", "profileId": profile_id,
+            "sources": [{ "hostId": "local", "sourceStoreId": source_id, "codexHome": home }],
+            "bindings": bindings,
+        }))?,
+    )?;
+    Ok(())
+}
+
+async fn start_server(home: &Path, manifest: &Path) -> Result<TestAppServer> {
+    TestAppServer::builder()
+        .with_codex_home(home)
+        .without_managed_config()
+        .with_env_overrides(&[
+            (
+                "CODEX_MANAGER_MANAGED_SOURCES",
+                Some(manifest.to_str().context("UTF-8 manifest path")?),
+            ),
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            ("CODEX_SQLITE_HOME", None),
+            ("OPENAI_API_KEY", None),
+            ("CODEX_ACCESS_TOKEN", None),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await
+}
+
+async fn loaded_ids(app: &mut TestAppServer) -> Result<Vec<String>> {
+    let loaded: ThreadLoadedListResponse = app
+        .request(|request_id| ClientRequest::ThreadLoadedList {
+            request_id,
+            params: ThreadLoadedListParams::default(),
+        })
