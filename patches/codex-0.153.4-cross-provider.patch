diff --git a/codex-rs/app-server/src/request_processors/shared_history_resume.rs b/codex-rs/app-server/src/request_processors/shared_history_resume.rs
new file mode 100644
index 000000000..5e57a7ff3
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/shared_history_resume.rs
@@ -0,0 +1,356 @@
+//! Refresh an idle model context when another participating app added a turn.
+//! Sidebar hydration alone updates the UI, not the loaded inference actor.
+//!
+//! The refresh replaces the actor: a strict idle close, then the native reload.
+//! Loaded spawn descendants hold the old root's agent registry, so idle ones
+//! close first, leaves first, and reload lazily from their own records later.
+//! Running work is never stopped: the submit fails with a retryable message.
+//! Agent mail queued for the idle root moves to the reloaded actor. Mail queued
+//! for an idle descendant starts no turn, so it is recorded in that
+//! descendant's history before the close instead of blocking the refresh.
+use super::super::managed_thread_drain::ActorCloseError;
+use super::super::managed_thread_drain::leaves_first;
+use super::*;
+
+const DESCENDANT_CLOSE_TIMEOUT: Duration = Duration::from_secs(30);
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn refresh_shared_history_before_turn(
+        &self,
+        request_id: &ConnectionRequestId,
+        id: &str,
+        client_name: Option<String>,
+        client_version: Option<String>,
+    ) -> Result<(), JSONRPCErrorError> {
+        if !crate::manager_record_catalog::execution::enabled()
+            && std::env::var("CODEX_RECORD_SHARED_APPEND").as_deref() != Ok("1")
+        {
+            return Ok(());
+        }
+        let thread_id = ThreadId::from_string(id)
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        let Ok(thread) = self.thread_manager.get_thread(thread_id).await else {
+            return Ok(());
+        };
+        if matches!(thread.agent_status().await, AgentStatus::Running)
+            || thread.config_snapshot().await.history_mode != ThreadHistoryMode::Paginated
+        {
+            // A running turn retains its actor and the normal steering semantics.
+            return Ok(());
+        }
+        let store = crate::managed_sources::read_store_for_thread(
+            &self.thread_manager,
+            &self.thread_store,
+            thread_id,
+        )
+        .await?;
+        store
+            .persist_thread(thread_id, PersistContext::Standard)
+            .await
+            .map_err(|err| internal_error(format!("failed to refresh shared history: {err}")))?;
+        if store
+            .read_thread_metadata(thread_id)
+            .await
+            .map_err(|err| {
+                internal_error(format!("failed to inspect shared task metadata: {err}"))
+            })?
+            .is_none()
+        {
+            // New tasks are lazily materialized by their first user message.
+            return Ok(());
+        }
+        let page = store
+            .list_turns(codex_thread_store::ListTurnsParams {
+                thread_id,
+                include_archived: true,
+                cursor: None,
+                page_size: 1,
+                sort_direction: StoreSortDirection::Desc,
+                items_view: codex_thread_store::StoredTurnItemsView::NotLoaded,
+            })
+            .await
+            .map_err(|err| internal_error(format!("failed to inspect shared history: {err}")))?;
+        let Some(latest) = page.turns.first() else {
+            return Ok(());
+        };
+        let state = self.thread_state_manager.thread_state(thread_id).await;
+        if state.lock().await.last_terminal_turn_id.as_deref() == Some(latest.turn_id.as_str()) {
+            return Ok(());
+        }
+        let snapshot = ThreadRevertRuntimeSnapshot {
+            config: thread.config().await.as_ref().clone(),
+            settings: thread.restorable_thread_settings().await,
+            client_mcp_extensions: thread.client_mcp_extensions(),
+        };
+        if matches!(
+            self.ensure_conversation_listener(
+                thread_id,
+                request_id.connection_id,
+                /*raw_events_enabled*/ false
+            )
+            .await?,
+            EnsureConversationListenerResult::ConnectionClosed
+        ) {
+            return Err(internal_error(
+                "connection closed while refreshing shared history",
+            ));
+        }
+        // Queued mail moves to the reloaded actor below.
+        let blockers = without_waiting_mail(thread.managed_idle_blockers().await);
+        if !blockers.is_empty() {
+            return Err(refresh_blocked(format!(
+                "this task still has pending work ({})",
+                blockers.join(", ")
+            )));
+        }
+        // Observe descendants before reserving the root: the reservation refuses
+        // agent mail, including the completion notice of a child still working.
+        self.idle_loaded_descendants(thread_id).await?;
+        let admission = thread
+            .try_reserve_idle_close()
+            .map_err(|err| refresh_blocked(format!("this task is receiving input ({err})")))?;
+        // Boxed: this rare path must not enlarge every turn/start future.
+        Box::pin(self.close_idle_descendants(thread_id)).await?;
+        let mail = thread
+            .take_queued_agent_mail(&admission)
+            .await
+            .map_err(|err| refresh_blocked(format!("this task still has pending work ({err})")))?;
+        let drain = state.lock().await.register_shutdown_drain_waiter();
+        // This operation refuses active/queued input, terminals and pending
+        // callbacks. It never force-stops work to refresh another app's changes.
+        if let Err(err) = thread.close_idle_and_shutdown_reserved(admission).await {
+            state.lock().await.take_shutdown_drain_waiter();
+            thread.requeue_agent_mail(mail).await;
+            // Only a refused close leaves the actor usable; a resend cannot
+            // repair a teardown that started and failed.
+            return Err(
+                if matches!(err.details(), CodexErrorDetails::UnsupportedOperation(_)) {
+                    refresh_blocked(format!("this task still has pending work ({err})"))
+                } else {
+                    internal_error(format!(
+                        "shared task did not close cleanly for the history refresh: {err}"
+                    ))
+                },
+            );
+        }
+        let reloaded: Result<(), JSONRPCErrorError> = async {
+            tokio::time::timeout(Duration::from_secs(10), drain)
+                .await
+                .map_err(|_| internal_error("timed out refreshing the shared task listener"))?
+                .map_err(|_| {
+                    internal_error("shared task listener closed during history refresh")
+                })?;
+            if self
+                .thread_manager
+                .remove_thread_if_matches(&thread_id, &thread)
+                .await
+                .is_none()
+            {
+                return Err(internal_error(
+                    "shared task was replaced during history refresh",
+                ));
+            }
+            // Reuse the native replacement path, preserving subscriptions, selected
+            // credentials, model/effort and the task ID. No desktop navigation occurs.
+            self.reload_paginated_thread(
+                request_id,
+                thread_id,
+                snapshot,
+                client_name,
+                client_version,
+            )
+            .await?;
+            Ok(())
+        }
+        .await;
+        match self.thread_manager.get_thread(thread_id).await {
+            Ok(replacement) if !Arc::ptr_eq(&replacement, &thread) => {
+                replacement.requeue_agent_mail(mail).await;
+            }
+            _ if mail.is_empty() => {}
+            _ => warn!("agent mail queued for shared task {thread_id} was lost in a failed reload"),
+        }
+        reloaded?;
+        state.lock().await.last_terminal_turn_id = Some(latest.turn_id.clone());
+        Ok(())
+    }
+
+    /// Loaded spawn descendants of `root_id`. Fails with a retryable error while
+    /// any of them has work that a strict idle close would refuse, other than
+    /// mail waiting for its next turn, which is recorded before the close.
+    async fn idle_loaded_descendants(
+        &self,
+        root_id: ThreadId,
+    ) -> Result<Vec<(ThreadId, Arc<CodexThread>)>, JSONRPCErrorError> {
+        let mut descendants = Vec::new();
+        for id in self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+            .map_err(|err| internal_error(format!("cannot inspect shared task subagents: {err}")))?
+        {
+            if id == root_id {
+                continue;
+            }
+            let Ok(actor) = self.thread_manager.get_thread(id).await else {
+                continue;
+            };
+            let mut work = without_waiting_mail(actor.managed_idle_blockers().await);
+            if matches!(
+                actor.agent_status().await,
+                AgentStatus::PendingInit | AgentStatus::Running
+            ) {
+                work.push("agentRunning".to_string());
+            }
+            if !self
+                .outgoing
+                .pending_requests_for_thread(id)
+                .await
+                .is_empty()
+            {
+                work.push("clientRequest".to_string());
+            }
+            if !work.is_empty() {
+                return Err(refresh_blocked(format!(
+                    "subagent {} is still working ({})",
+                    subagent_name(id, &actor).await,
+                    work.join(", ")
+                )));
+            }
+            descendants.push((id, actor));
+        }
+        Ok(descendants)
+    }
+
+    /// Close idle loaded descendants, leaves first. Each keeps its record and
+    /// open spawn edge, so the reloaded root restores it when it is next used.
+    async fn close_idle_descendants(&self, root_id: ThreadId) -> Result<(), JSONRPCErrorError> {
+        let descendants = self.idle_loaded_descendants(root_id).await?;
+        if descendants.is_empty() {
+            return Ok(());
+        }
+        let mut admissions = HashMap::new();
+        let mut parents = HashMap::new();
+        for (id, actor) in &descendants {
+            let admission = actor.try_reserve_idle_close().map_err(|err| {
+                refresh_blocked(format!("subagent {id} is receiving input ({err})"))
+            })?;
+            admissions.insert(*id, admission);
+            let snapshot = actor.config_snapshot().await;
+            parents.insert(
+                *id,
+                snapshot
+                    .parent_thread_id
+                    .or_else(|| snapshot.session_source.parent_thread_id()),
+            );
+        }
+        let order = leaves_first(parents)?;
+        {
+            let mut pending = self.pending_thread_unloads.lock().await;
+            if order.iter().any(|id| pending.contains(id)) {
+                return Err(refresh_blocked("a subagent is already closing"));
+            }
+            pending.extend(order.iter().copied());
+        }
+        let actors = descendants.into_iter().collect::<HashMap<_, _>>();
+        // Mail queued for an idle subagent waits for a turn nothing starts, so
+        // refusing it would block every refresh until that subagent runs again.
+        // Record it in the subagent's history; the reservations keep new mail
+        // out until the close.
+        let recorded: Result<(), JSONRPCErrorError> = async {
+            for id in &order {
+                let (Some(actor), Some(admission)) = (actors.get(id), admissions.get(id)) else {
+                    return Err(internal_error("subagent close reservation disappeared"));
+                };
+                if let Err(err) = actor.record_queued_agent_mail(admission).await {
+                    let name = subagent_name(*id, actor).await;
+                    return Err(
+                        if matches!(err.details(), CodexErrorDetails::UnsupportedOperation(_)) {
+                            refresh_blocked(format!("subagent {name} is still working ({err})"))
+                        } else {
+                            internal_error(format!(
+                                "failed to record agent mail queued for subagent {name}: {err}"
+                            ))
+                        },
+                    );
+                }
+            }
+            Ok(())
+        }
+        .await;
+        if let Err(error) = recorded {
+            let mut pending = self.pending_thread_unloads.lock().await;
+            for id in &order {
+                pending.remove(id);
+            }
+            return Err(error);
+        }
+        // The descendant whose close was submitted but not verified, including
+        // one still in flight when the timeout drops this future.
+        let mut unverified = None;
+        let closed = tokio::time::timeout(DESCENDANT_CLOSE_TIMEOUT, async {
+            for id in &order {
+                let (Some(actor), Some(admission)) = (actors.get(id), admissions.remove(id)) else {
+                    return Err(internal_error("subagent close reservation disappeared"));
+                };
+                unverified = Some(*id);
+                match self.close_managed_actor(*id, actor, admission).await {
+                    Ok(()) => unverified = None,
+                    Err(ActorCloseError::IdleRejected(error)) => {
+                        unverified = None;
+                        return Err(refresh_blocked(format!(
+                            "a subagent could not close yet ({})",
+                            error.message
+                        )));
+                    }
+                    Err(ActorCloseError::Unverified(error)) => return Err(error),
+                }
+            }
+            Ok(())
+        })
+        .await
+        .unwrap_or_else(|_| {
+            Err(internal_error(
+                "timed out closing idle subagents before reloading shared history",
+            ))
+        });
+        if closed.is_err() {
+            // Closed subagents already left the set. An unverified close stays
+            // fenced from idle unloads, as in managed handoff.
+            let mut pending = self.pending_thread_unloads.lock().await;
+            for id in &order {
+                if unverified != Some(*id) {
+                    pending.remove(id);
+                }
+            }
+        }
+        closed
+    }
+}
+
+/// Without an active turn, pending input is only agent mail waiting for the
+/// next turn, which the refresh carries across the close.
+fn without_waiting_mail(blockers: Vec<String>) -> Vec<String> {
+    let mail_only = !blockers.iter().any(|blocker| blocker == "activeTurn");
+    blockers
+        .into_iter()
+        .filter(|blocker| !(mail_only && blocker == "pendingInputOrAgentMail"))
+        .collect()
+}
+
+async fn subagent_name(id: ThreadId, actor: &CodexThread) -> String {
+    let source = actor.config_snapshot().await.session_source;
+    source
+        .get_nickname()
+        .or_else(|| source.get_agent_path().as_ref().map(ToString::to_string))
+        .unwrap_or_else(|| id.to_string())
+}
+
+/// A retryable refusal. Nothing was submitted, and the same message succeeds
+/// once the named work finishes.
+fn refresh_blocked(reason: impl std::fmt::Display) -> JSONRPCErrorError {
+    invalid_request(format!(
+        "shared history changed in another app and must be reloaded before this message, \
+         but {reason}; nothing was sent, so send it again once that work finishes"
+    ))
+}
