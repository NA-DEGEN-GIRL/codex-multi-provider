+use super::Hooks;
+use super::HooksConfig;
+use super::MANAGED_CLOSE_SEALED;
+use crate::engine::ConfiguredHandler;
+use crate::engine::ConfiguredHandlerKind;
+use crate::events::session_end::SessionEndRequest;
+use crate::events::user_prompt_submit::UserPromptSubmitRequest;
+use crate::mcp::HookMcpCall;
+use crate::mcp::HookMcpExecutor;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::HookEventName;
+use codex_protocol::protocol::HookRunStatus;
+use codex_protocol::protocol::HookSource;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use futures::FutureExt;
+use futures::future::BoxFuture;
+use pretty_assertions::assert_eq;
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use tokio::sync::Notify;
+use tokio::time::timeout;
+
+#[derive(Default)]
+struct PausedMcp {
+    entered: Notify,
+    release: Notify,
+    calls: AtomicUsize,
+}
+
+impl HookMcpExecutor for PausedMcp {
+    fn execute(&self, _call: HookMcpCall) -> BoxFuture<'_, anyhow::Result<String>> {
+        async {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            self.entered.notify_one();
+            self.release.notified().await;
+            Ok("hook completed".to_string())
+        }
+        .boxed()
+    }
+}
+
+fn request(session_id: ThreadId) -> UserPromptSubmitRequest {
+    UserPromptSubmitRequest {
+        session_id,
+        turn_id: "managed-close-test".to_string(),
+        subagent: None,
+        cwd: AbsolutePathBuf::current_dir().expect("test cwd"),
+        transcript_path: None,
+        model: "test-model".to_string(),
+        permission_mode: "default".to_string(),
+        prompt: "test prompt".to_string(),
+    }
+}
+
+fn handler(event_name: HookEventName, kind: ConfiguredHandlerKind) -> ConfiguredHandler {
+    ConfiguredHandler {
+        builtin: false,
+        event_name,
+        matcher: None,
+        timeout_sec: 10,
+        status_message: None,
+        additional_context_limit: Default::default(),
+        source_path: AbsolutePathBuf::current_dir()
+            .expect("test cwd")
+            .join("hooks.json")
+            .into(),
+        source: HookSource::User,
+        display_order: 0,
+        kind,
+    }
+}
+
+#[tokio::test]
+async fn pending_mcp_prevents_sealing_and_closed_admission_is_shared_only_with_same_thread() {
+    let id = ThreadId::new();
+    let executor = Arc::new(PausedMcp::default());
+    let (mut hooks, _results) = Hooks::new(HooksConfig::default(), id, executor.clone()).unwrap();
+    hooks.engine.handlers.push(handler(
+        HookEventName::UserPromptSubmit,
+        ConfiguredHandlerKind::McpTool {
+            server: "test".to_string(),
+            tool: "wait".to_string(),
+            input: Default::default(),
+        },
+    ));
+    let cloned = hooks.clone();
+    let refreshed = hooks.reconfigured(HooksConfig::default());
+    let run = tokio::spawn(async move { cloned.run_user_prompt_submit(request(id)).await });
+    timeout(Duration::from_secs(5), executor.entered.notified())
+        .await
+        .unwrap();
+    assert!(hooks.has_pending_work());
+    assert!(hooks.try_seal_for_managed_close().is_none());
+    assert!(refreshed.try_seal_for_managed_close().is_none());
+    assert!(!run.is_finished());
+    executor.release.notify_one();
+    let outcome = timeout(Duration::from_secs(5), run).await.unwrap().unwrap();
+    assert_eq!(outcome.hook_events[0].run.status, HookRunStatus::Completed);
+    assert!(!hooks.has_pending_work());
+
+    let seal = refreshed
+        .try_seal_for_managed_close()
+        .expect("MCP finished");
+    for view in [&hooks, &hooks.clone(), &refreshed] {
+        let blocked = view.run_user_prompt_submit(request(id)).await;
+        assert!(blocked.should_stop);
+        assert_eq!(blocked.stop_reason.as_deref(), Some(MANAGED_CLOSE_SEALED));
+        assert!(blocked.hook_events.is_empty());
+    }
+    assert_eq!(executor.calls.load(Ordering::SeqCst), 1);
+    let other_id = ThreadId::new();
+    let (mut other, _other_results) =
+        Hooks::new(HooksConfig::default(), other_id, executor).unwrap();
+    other.engine.handlers.push(handler(
+        HookEventName::UserPromptSubmit,
+        ConfiguredHandlerKind::Command {
+            command: "echo unrelated-thread".to_string(),
+            env: HashMap::new(),
+            r#async: false,
+        },
+    ));
+    let independent = other.run_user_prompt_submit(request(other_id)).await;
+    assert!(!independent.should_stop);
+    assert_eq!(
+        independent.hook_events[0].run.status,
+        HookRunStatus::Completed
+    );
+    seal.reopen();
+    assert!(
+        !refreshed
+            .run_user_prompt_submit(request(id))
+            .await
+            .should_stop
+    );
+    drop(hooks.try_seal_for_managed_close().expect("reopened"));
+    assert!(
+        refreshed
+            .run_user_prompt_submit(request(id))
+            .await
+            .should_stop
+    );
+}
+
+#[tokio::test]
+async fn managed_terminal_hook_runs_once_after_shutdown_and_requires_own_seal() {
+    let temp = tempfile::tempdir().unwrap();
+    let id = ThreadId::new();
+    let executor = Arc::new(PausedMcp::default());
+    let (mut hooks, _results) = Hooks::new(HooksConfig::default(), id, executor.clone()).unwrap();
+    hooks.engine.handlers.push(handler(
+        HookEventName::SessionEnd,
+        ConfiguredHandlerKind::Command {
+            command: "echo completed>>terminal.txt".to_string(),
+            env: HashMap::new(),
+            r#async: false,
+        },
+    ));
+    let request = SessionEndRequest {
+        session_id: id,
+        turn_id: "terminal-test".to_string(),
+        cwd: AbsolutePathBuf::try_from(temp.path()).unwrap(),
+        transcript_path: None,
+    };
+    let (other, _other_results) =
+        Hooks::new(HooksConfig::default(), ThreadId::new(), executor).unwrap();
+    let foreign_seal = other.try_seal_for_managed_close().unwrap();
+    let seal = hooks.try_seal_for_managed_close().unwrap();
+    assert!(
+        hooks
+            .run_session_end_for_managed_close(&foreign_seal, request.clone())
+            .await
+            .is_err()
+    );
+    assert!(
+        hooks
+            .run_session_end_for_managed_close(
+                &seal,
+                SessionEndRequest {
+                    session_id: ThreadId::new(),
+                    ..request.clone()
+                }
+            )
+            .await
+            .is_err()
+    );
+    let mut async_terminal = hooks.clone();
+    async_terminal.engine.handlers[0].kind = ConfiguredHandlerKind::Command {
+        command: "echo forbidden>>terminal.txt".to_string(),
+        env: HashMap::new(),
+        r#async: true,
+    };
+    assert!(
+        async_terminal
+            .run_session_end_for_managed_close(&seal, request.clone())
+            .await
+            .is_err()
+    );
+    assert!(!temp.path().join("terminal.txt").exists());
+    hooks.shutdown().await;
+    assert!(
+        hooks
+            .run_session_end(request.clone())
+            .await
+            .hook_events
+            .is_empty()
+    );
+    assert!(!temp.path().join("terminal.txt").exists());
+    let outcome = hooks
+        .run_session_end_for_managed_close(&seal, request.clone())
+        .await
+        .unwrap();
+    assert_eq!(outcome.hook_events[0].run.status, HookRunStatus::Completed);
+    assert!(
+        hooks
+            .run_session_end_for_managed_close(&seal, request)
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        std::fs::read_to_string(temp.path().join("terminal.txt"))
+            .unwrap()
+            .trim(),
+        "completed"
+    );
+    seal.reopen();
+    assert!(
+        hooks
+            .run_user_prompt_submit(self::request(id))
+            .await
+            .should_stop
+    );
+}
+
+#[tokio::test]
+async fn completed_async_hook_must_be_delivered_before_sealing() {
+    let id = ThreadId::new();
+    let (mut hooks, results) =
+        Hooks::new(HooksConfig::default(), id, Arc::new(PausedMcp::default())).unwrap();
+    hooks.engine.handlers.push(handler(
+        HookEventName::UserPromptSubmit,
+        ConfiguredHandlerKind::Command {
+            command: "echo async-delivered".to_string(),
+            env: HashMap::new(),
+            r#async: true,
+        },
+    ));
+    let refreshed = hooks.reconfigured(HooksConfig::default());
+    assert!(
+        hooks
+            .run_user_prompt_submit(request(id))
+            .await
+            .hook_events
+            .is_empty()
+    );
+    timeout(Duration::from_secs(5), async {
+        while results.is_empty() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("background hook completion");
+    assert!(refreshed.has_pending_work());
+    assert!(hooks.try_seal_for_managed_close().is_none());
+    assert!(refreshed.try_seal_for_managed_close().is_none());
+    let delivered = results.recv().await.unwrap();
+    assert_eq!(delivered.run.status, HookRunStatus::Completed);
+    assert_eq!(delivered.turn_id.as_deref(), Some("managed-close-test"));
+    assert!(
+        delivered
+            .run
+            .entries
+            .iter()
+            .any(|entry| entry.text.contains("async-delivered"))
+    );
+    let seal = timeout(Duration::from_secs(5), async {
+        loop {
+            if let Some(seal) = refreshed.try_seal_for_managed_close() {
+                break seal;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("delivered hook is idle");
+    assert!(hooks.run_user_prompt_submit(request(id)).await.should_stop);
+    drop(seal);
+}
+
+#[tokio::test]
+async fn timed_out_hook_cannot_be_certified_idle_by_consuming_its_failure() {
+    let id = ThreadId::new();
+    let (mut hooks, _results) =
+        Hooks::new(HooksConfig::default(), id, Arc::new(PausedMcp::default())).unwrap();
+    let mut timed_out = handler(
+        HookEventName::UserPromptSubmit,
+        ConfiguredHandlerKind::Command {
+            command: if cfg!(windows) {
+                "for /L %n in (1,0,2) do @rem running"
+            } else {
+                "while :; do :; done"
+            }
+            .to_string(),
+            env: HashMap::new(),
+            r#async: false,
+        },
+    );
+    timed_out.timeout_sec = 0;
+    hooks.engine.handlers.push(timed_out);
+    let outcome = hooks.run_user_prompt_submit(request(id)).await;
+    assert_eq!(outcome.hook_events[0].run.status, HookRunStatus::Failed);
+    assert!(hooks.has_pending_work());
+    assert!(hooks.try_seal_for_managed_close().is_none());
+    let refreshed = hooks.reconfigured(HooksConfig::default());
+    assert!(refreshed.has_pending_work());
+    assert!(refreshed.try_seal_for_managed_close().is_none());
+}
