+    let (session_meta, remaining_lines) = rollout
+        .split_once('\n')
+        .expect("rollout should contain session metadata and history");
+    let mut session_meta = codex_rollout::decode_rollout_line(
+        serde_json::from_str(session_meta).expect("parse session metadata JSON"),
+    )
