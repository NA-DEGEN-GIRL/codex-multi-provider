+//! Index copies may be the only metadata for another registered home's history.
+
+use super::catalog_mixed::legacy_record;
+use super::catalog_mixed::legacy_source;
+use super::catalog_mixed::projection;
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn foreign_index_only_records_keep_physical_origin_history_and_owner_priority() -> Result<()>
+{
+    let api = responses::start_mock_server().await;
+    let viewer = ManagedProfile::new(&api.uri(), "viewer-model", "viewer-token")?;
+    viewer.write_manifest(&[&viewer], Vec::new())?;
+    let owner = TempDir::new()?;
+    let mirror = TempDir::new()?;
+    let second = TempDir::new()?;
+    let outside = TempDir::new()?;
+    let (id, path) = legacy_record(owner.path(), "2025-01-05T12-00-00")?;
+    let original = fs::read(&path)?;
+    let owner_state = codex_state::StateRuntime::init(
+        SqliteConfig::from_sqlite_home(owner.path().abs()),
+        "openai".to_string(),
+    )
+    .await?;
+    let mirror_state = codex_state::StateRuntime::init(
+        SqliteConfig::from_sqlite_home(mirror.path().abs()),
+        "openai".to_string(),
+    )
+    .await?;
+    let second_state = codex_state::StateRuntime::init(
+        SqliteConfig::from_sqlite_home(second.path().abs()),
+        "openai".to_string(),
+    )
+    .await?;
+    let created = chrono::DateTime::from_timestamp(1_735_732_800, 0).context("fixture time")?;
+    let mut metadata = codex_state::ThreadMetadataBuilder::new(
+        codex_protocol::ThreadId::from_string(&id)?,
+        path.clone(),
+        created,
+        codex_protocol::protocol::SessionSource::Cli,
+    )
+    .build("openai");
+    metadata.cwd = owner.path().to_path_buf();
+    metadata.title = "Older foreign name".to_string();
+    metadata.first_user_message = Some("Foreign-index-only work".to_string());
+    mirror_state.upsert_thread(&metadata).await?;
+    metadata.title = "Latest foreign name".to_string();
+    metadata.updated_at += chrono::Duration::seconds(10);
+    second_state.upsert_thread(&metadata).await?;
+    let mut unregistered = metadata.clone();
+    unregistered.id = codex_protocol::ThreadId::new();
+    unregistered.rollout_path = outside.path().join("sessions/not-registered.jsonl");
+    mirror_state.upsert_thread(&unregistered).await?;
+    let descriptor = legacy_source(owner.path());
+    let projected = projection(&descriptor, &id)?;
+    let catalog = viewer.home.path().join("foreign-index.json");
+    fs::write(
+        &catalog,
+        serde_json::to_vec(&json!({
+            "version":3,"hostId":"local","sources":[],
+            "legacySources":[legacy_source(mirror.path()),descriptor,legacy_source(second.path())]
+        }))?,
+    )?;
+    let mut reader = super::catalog_sources::start_shared(&viewer, &catalog).await?;
+    let listed = super::catalog_sources::list(&mut reader).await?;
+    assert_eq!(listed.data.len(), 1);
+    assert_eq!(
+        (&listed.data[0].id, listed.data[0].name.as_deref()),
+        (&projected, Some("Latest foreign name"))
+    );
+    let origin = listed.data[0]
+        .extra
+        .as_ref()
+        .context("origin")?
+        .managed_record
+        .as_ref()
+        .context("managed origin")?;
+    assert_eq!(
+        (
+            origin.source_store_id.as_str(),
+            origin.canonical_thread_id.as_str()
+        ),
+        (
+            descriptor["sourceStoreId"].as_str().context("owner id")?,
+            id.as_str()
+        )
+    );
+    let request = reader
+        .send_raw_request(
+            "thread/read",
+            Some(json!({"threadId":projected,"includeTurns":true})),
+        )
+        .await?;
+    let read: ThreadReadResponse = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert_eq!(read.thread.name.as_deref(), Some("Latest foreign name"));
+    assert_eq!(read.thread.id, projected);
+    assert!(!read.thread.turns.is_empty());
+    assert_eq!(fs::read(&path)?, original);
+
+    // A newer foreign copy must not overrule an existing owner state row.
+    metadata.title = "Owner saved name".to_string();
+    metadata.updated_at -= chrono::Duration::seconds(20);
+    owner_state.upsert_thread(&metadata).await?;
+    timeout(READ_TIMEOUT, async {
+        loop {
+            let listed = super::catalog_sources::list(&mut reader).await?;
+            if listed.data.len() == 1 && listed.data[0].name.as_deref() == Some("Owner saved name")
+            {
+                break Ok::<_, anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(250)).await;
+        }
+    })
+    .await??;
+    assert_eq!(fs::read(&path)?, original);
+    let request = reader
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert!(loaded.data.is_empty());
+    for home in [owner.path(), mirror.path(), second.path()] {
+        assert!(!home.join("managed-source.json").exists());
+        assert!(!home.join("auth.json").exists());
+    }
+    owner_state.close().await;
+    mirror_state.close().await;
+    second_state.close().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn foreign_logical_session_alias_resolves_to_registered_physical_owner() -> Result<()> {
+    let api = responses::start_mock_server().await;
+    let viewer = ManagedProfile::new(&api.uri(), "viewer-model", "viewer-token")?;
+    viewer.write_manifest(&[&viewer], Vec::new())?;
+    let owner = TempDir::new()?;
+    let mirror = TempDir::new()?;
+    let (id, path) = legacy_record(owner.path(), "2025-01-05T12-00-00")?;
+    #[cfg(windows)]
+    std::os::windows::fs::symlink_dir(
+        owner.path().join("sessions"),
+        mirror.path().join("sessions"),
+    )?;
+    #[cfg(unix)]
+    std::os::unix::fs::symlink(
+        owner.path().join("sessions"),
+        mirror.path().join("sessions"),
+    )?;
+    let owner_state = codex_state::StateRuntime::init(
+        SqliteConfig::from_sqlite_home(owner.path().abs()),
+        "openai".to_string(),
+    )
+    .await?;
+    let mirror_state = codex_state::StateRuntime::init(
+        SqliteConfig::from_sqlite_home(mirror.path().abs()),
+        "openai".to_string(),
+    )
+    .await?;
+    let logical = mirror.path().join(path.strip_prefix(owner.path())?);
+    let mut metadata = codex_state::ThreadMetadataBuilder::new(
+        codex_protocol::ThreadId::from_string(&id)?,
+        logical,
+        chrono::Utc::now(),
+        codex_protocol::protocol::SessionSource::Cli,
+    )
+    .build("openai");
+    metadata.first_user_message = Some("Existing legacy work".to_string());
+    metadata.title = "Aliased work".to_string();
+    mirror_state.upsert_thread(&metadata).await?;
+    let descriptor = legacy_source(owner.path());
+    let catalog = viewer.home.path().join("foreign-alias.json");
+    fs::write(
+        &catalog,
+        serde_json::to_vec(&json!({"version":3,"hostId":"local","sources":[],
+        "legacySources":[descriptor,legacy_source(mirror.path())]}))?,
+    )?;
+    let mut reader = super::catalog_sources::start_shared(&viewer, &catalog).await?;
+    let listed = super::catalog_sources::list(&mut reader).await?;
+    assert_eq!(listed.data.len(), 1);
+    let projected = projection(&descriptor, &id)?;
+    assert_eq!(listed.data[0].id, projected);
+    let request = reader
+        .send_raw_request(
+            "thread/read",
+            Some(json!({"threadId":projected,"includeTurns":true})),
+        )
+        .await?;
+    let read: ThreadReadResponse = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert_eq!(
+        (read.thread.id, read.thread.name.as_deref()),
+        (projected, Some("Aliased work"))
+    );
+    assert!(!read.thread.turns.is_empty());
+    owner_state.close().await;
+    mirror_state.close().await;
+    Ok(())
+}
