+#[tokio::test]
+async fn dropping_cold_preflight_releases_the_reservation_without_claiming_shutdown() {
+    let fixture = ColdDrainFixture::new().await;
+    let child = fixture.seed_child(ThreadId::new()).await;
+    let path = rollout_path(&child).await;
+    let before = std::fs::read(&path).expect("canonical child before preflight");
+    let admission = fixture
+        .root_actor
+        .try_reserve_idle_close()
+        .expect("exclusive root admission");
+    let ids = [fixture.root.thread_id(), child.thread_id()];
+    let guard = fixture
+        .manager
+        .prepare_managed_cold_drain(&fixture.root_actor, &admission, &ids)
+        .await
+        .expect("first cold preflight");
+    assert!(guard.contains(child.thread_id()));
+    assert!(!guard.contains(fixture.root.thread_id()));
+    drop(guard);
+
+    assert!(
+        !child.is_released(),
+        "dropping preflight is not verified shutdown"
+    );
+    assert_eq!(
+        std::fs::read(&path).expect("child after abandoned preflight"),
+        before
+    );
+    fixture
+        .manager
+        .state
+        .check_managed_startup_uncertainty(&ids)
+        .expect("untouched preflight does not create a shutdown tombstone");
+    let mut retry = fixture
+        .manager
+        .prepare_managed_cold_drain(&fixture.root_actor, &admission, &ids)
+        .await
+        .expect("a dropped preflight releases lifecycle and writer reservations");
+    retry
+        .close_thread(child.thread_id())
+        .await
+        .expect("retry can provide verified close");
+    assert!(child.is_released());
+    drop(retry);
+    drop(admission);
+    fixture.finish().await;
+}
