+#[tokio::test]
+async fn shared_history_refresh_keeps_mail_queued_for_an_idle_subagent() -> Result<()> {
+    let fixture =
+        SharedTaskFixture::new(create_final_assistant_message_sse_response(WORKER_RESULT)?).await?;
+    let (mut owner, root_id, worker_id) = fixture.start_owner_with_idle_worker().await?;
+    responses::mount_sse_once_match(
+        &fixture.api,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains(QUEUE_MAIL_PROMPT) && !body.contains(SEND_MAIL_CALL_ID)
+        },
+        responses::sse(vec![
+            responses::ev_response_created("send-mail"),
+            responses::ev_function_call_with_namespace(
+                SEND_MAIL_CALL_ID,
+                "collaboration",
+                "send_message",
+                &json!({ "target": "worker", "message": QUEUED_MAIL }).to_string(),
+            ),
+            responses::ev_completed("send-mail"),
+        ]),
+    )
+    .await;
+    let completed = timeout(
+        READ_TIMEOUT,
+        owner.start_turn_and_wait_for_completion(text_turn(&root_id, QUEUE_MAIL_PROMPT)),
+    )
+    .await??;
+    assert_eq!(
+        (completed.turn.status, completed.turn.error),
+        (TurnStatus::Completed, None)
+    );
+    // send_message never starts a turn: the mail waits in the idle worker's
+    // queue, and nothing would run that turn on its own.
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    assert!(
+        fixture
+            .worker_request_bodies()
+            .await?
+            .iter()
+            .all(|body| !body.contains(QUEUED_MAIL))
+    );
+    fixture.append_turn_from_other_app(&root_id).await?;
+    let mut both = vec![root_id.clone(), worker_id.clone()];
+    both.sort();
+    assert_eq!(loaded_ids(&mut owner).await?, both);
+
+    // The queued mail no longer blocks the refresh: it is recorded in the
+    // worker's history, and the worker closes before the root reloads.
+    assert_refreshed_without_worker(&fixture, &mut owner, &root_id, &worker_id).await?;
+
+    // When the worker next runs, reloaded from its record, it sees the mail
+    // once, before its new task.
+    let worker_request = fixture.reach_worker_again(&mut owner, &root_id).await?;
+    assert_eq!(
+        worker_request.matches(QUEUED_MAIL).count(),
+        1,
+        "{worker_request}"
+    );
+    let mail_at = worker_request.find(QUEUED_MAIL).context("queued mail")?;
+    let task_at = worker_request
+        .find(WORKER_FOLLOW_UP)
+        .context("follow-up task")?;
+    assert!(mail_at < task_at, "{worker_request}");
+    for body in fixture.worker_request_bodies().await? {
+        assert!(body.matches(QUEUED_MAIL).count() <= 1, "{body}");
+    }
+    Ok(())
+}
