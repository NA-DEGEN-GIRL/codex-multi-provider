new file mode 100644
index 000000000..ee434766d
--- /dev/null
+++ b/codex-rs/core/src/agent/control/managed_admission.rs
@@ -0,0 +1,174 @@
+use super::*;
+use crate::session::SubmissionActivityPermit;
+use codex_thread_store::ManagedThreadBinding;
+use std::collections::HashSet;
+
+#[derive(Default)]
+pub(super) struct ManagedChildActivation {
+    _permits: Vec<SubmissionActivityPermit>,
+    pub(super) resumed_binding: Option<ManagedThreadBinding>,
+}
+
+impl ManagedChildActivation {
+    pub(super) fn is_managed(&self) -> bool {
+        !self._permits.is_empty()
+    }
+}
+
+impl AgentControl {
+    /// Keep every loaded ancestor open while admitting a managed child runtime. These are
+    /// submission gates, not persistence permits: nested fork writes remain independent.
+    /// CloseIdle reserves the root gate before inspecting descendants, so it cannot miss
+    /// a child being created or lazily reloaded under one of these permits.
+    pub(super) async fn admit_managed_child_activation(
+        &self,
+        state: &ThreadManagerState,
+        parent_thread_id: Option<ThreadId>,
+        existing_child_id: Option<ThreadId>,
+        require_loaded_parent: bool,
+    ) -> CodexResult<ManagedChildActivation> {
+        let mut expected_binding = match existing_child_id {
+            Some(thread_id) => state.managed_record_binding_for_thread(thread_id).await,
+            None => None,
+        };
+        if expected_binding.is_none()
+            && let Some(parent_id) = parent_thread_id
+        {
+            expected_binding = state.managed_record_binding_for_thread(parent_id).await;
+        }
+        if expected_binding.is_none()
+            && let Some(root_id) = self.state.agent_id_for_path(&AgentPath::root())
+        {
+            expected_binding = state.managed_record_binding_for_thread(root_id).await;
+        }
+        let Some(expected_binding) = expected_binding else {
+            return Ok(ManagedChildActivation::default());
+        };
+
+        let parent_thread_id = match (parent_thread_id, existing_child_id) {
+            (Some(parent_id), _) => parent_id,
+            (None, Some(child_id)) => {
+                let child = state
+                    .read_stored_thread(ReadThreadParams {
+                        thread_id: child_id,
+                        include_archived: true,
+                        include_history: false,
+                    })
+                    .await?;
+                child
+                    .parent_thread_id
+                    .or_else(|| child.source.parent_thread_id())
+                    .ok_or_else(|| {
+                        CodexErr::InvalidRequest(
+                            "managed child activation has no canonical parent".to_string(),
+                        )
+                    })?
+            }
+            (None, None) => {
+                return Err(CodexErr::InvalidRequest(
+                    "managed child activation requires a canonical parent".to_string(),
+                ));
+            }
+        };
+        let mut current_id = parent_thread_id;
+        let mut seen = HashSet::new();
+        let mut permits = Vec::new();
+        let mut loaded_ancestor_binding = None;
+        loop {
+            if !seen.insert(current_id) {
+                return Err(CodexErr::InvalidRequest(
+                    "managed child activation found a cyclic parent chain".to_string(),
+                ));
+            }
+            let binding = state
+                .managed_record_binding_for_thread(current_id)
+                .await
+                .ok_or_else(|| {
+                    CodexErr::InvalidRequest(
+                        "managed child ancestor has no canonical source binding".to_string(),
+                    )
+                })?;
+            if binding.source_id() != expected_binding.source_id()
+                || binding.source_config().codex_home != expected_binding.source_config().codex_home
+                || binding.authority_grant().owner_profile_id
+                    != expected_binding.authority_grant().owner_profile_id
+            {
+                return Err(CodexErr::InvalidRequest(
+                    "managed child ancestry belongs to another source or owner".to_string(),
+                ));
+            }
+
+            let ancestor = state.get_thread(current_id).await.ok();
+            let recorded_parent = if let Some(ancestor) = ancestor {
+                if !ancestor.is_running() {
+                    return Err(CodexErr::InvalidRequest(
+                        "managed child ancestor is shutting down".to_string(),
+                    ));
+                }
+                permits.push(ancestor.try_admit_managed_child_activity()?);
+                // The submission gate remains held; the persistence check itself must not
+                // be retained across nested parent-history operations during a fork.
+                drop(
+                    binding
+                        .live_write_permit()
+                        .await
+                        .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?,
+                );
+                if loaded_ancestor_binding.is_none() {
+                    loaded_ancestor_binding = Some(binding);
+                }
+                ancestor.session_source.parent_thread_id()
+            } else {
+                if require_loaded_parent && current_id == parent_thread_id {
+                    return Err(CodexErr::InvalidRequest(
+                        "managed child spawn requires its loaded parent".to_string(),
+                    ));
+                }
+                let ancestor = state
+                    .read_stored_thread(ReadThreadParams {
+                        thread_id: current_id,
+                        include_archived: true,
+                        include_history: false,
+                    })
+                    .await?;
+                let parent = ancestor
+                    .parent_thread_id
+                    .or_else(|| ancestor.source.parent_thread_id());
+                if parent.is_none() {
+                    return Err(CodexErr::InvalidRequest(
+                        "managed child activation requires its loaded root".to_string(),
+                    ));
+                }
+                parent
+            };
+            match recorded_parent {
+                Some(parent_id) => current_id = parent_id,
+                None => {
+                    // Capture the descendant grant before V2 residency can evict its idle
+                    // parent. The ancestor submission permits continue protecting this
+                    // capture through the child's eventual writer acquisition.
+                    let resumed_binding = if let Some(child_id) = existing_child_id {
+                        Some(
+                            loaded_ancestor_binding
+                                .ok_or_else(|| {
+                                    CodexErr::InvalidRequest(
+                                        "managed child activation has no loaded ancestor"
+                                            .to_string(),
+                                    )
+                                })?
+                                .for_child(child_id)
+                                .await
+                                .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?,
+                        )
+                    } else {
+                        None
+                    };
+                    return Ok(ManagedChildActivation {
+                        _permits: permits,
+                        resumed_binding,
+                    });
+                }
+            }
+        }
+    }
+}
