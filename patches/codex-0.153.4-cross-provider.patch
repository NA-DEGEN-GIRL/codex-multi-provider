+//! Sending on a shared task reloads turns another app appended, even while this
+//! app still has a subagent of that task loaded, or mail queued for one.
+
+use std::time::Duration;
+
+use anyhow::Context;
+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::create_escalated_command_execution_sse_response;
+use app_test_support::create_final_assistant_message_sse_response;
+use app_test_support::write_models_cache;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::CommandExecutionApprovalDecision;
+use codex_app_server_protocol::CommandExecutionRequestApprovalResponse;
