+#[tokio::test]
+async fn paginated_transcript_restores_compacted_history_once() {
+    let home = TempDir::new().expect("temp dir");
+    let root_uuid = Uuid::from_u128(/*v*/ 3001);
+    let root_id = ThreadId::from_string(&root_uuid.to_string()).expect("root id");
+    let root_path = write_rollout(
+        home.path(),
+        "2025-01-03T14-00-00",
+        root_uuid,
+        ThreadHistoryMode::Paginated,
+        /*first_ordinal*/ Some(1),
+        vec![
+            turn_started("turn-1"),
+            message("msg_u1", "user", "first question"),
+            completed_user_message("turn-1", "first question"),
+            message("msg_a1", "assistant", "first answer"),
+            turn_complete("turn-1"),
+            turn_started("turn-2"),
+            // Local compaction records its own output before the checkpoint, and counts it.
+            message("msg_s1", "assistant", "SUMMARY OF FIRST TURN"),
+            checkpoint(
+                "Summary prefix\nSUMMARY OF FIRST TURN",
+                Some("msg_a1"),
+                /*output_items*/ Some(1),
+                vec![user_input("first question")],
+            ),
+            turn_complete("turn-2"),
+            turn_started("turn-3"),
+            message("msg_u2", "user", "second question"),
+            completed_user_message("turn-3", "second question"),
+            message("msg_a2", "assistant", "second answer"),
+            turn_complete("turn-3"),
+            turn_started("turn-4"),
+            message("msg_u3", "user", "reverted question"),
+            completed_user_message("turn-4", "reverted question"),
+            turn_complete("turn-4"),
+        ],
+    );
+
+    // The child references the root's history up to, but not including, the reverted turn, as
+    // a paginated revert or referenced fork does.
+    let child_uuid = Uuid::from_u128(/*v*/ 3002);
+    let child_id = ThreadId::from_string(&child_uuid.to_string()).expect("child id");
+    let child_path = write_rollout(
+        home.path(),
+        "2025-01-03T14-00-01",
+        child_uuid,
+        ThreadHistoryMode::Paginated,
+        /*first_ordinal*/ Some(16),
+        vec![
+            turn_started("turn-5"),
+            // A copied item keeps its ID and must not be repeated.
+            message("msg_a2", "assistant", "second answer"),
+            message("msg_u4", "user", "child question"),
+            completed_user_message("turn-5", "child question"),
+            message("msg_a4", "assistant", "child answer"),
+            turn_complete("turn-5"),
+        ],
+    );
+    set_history_base(
+        child_path.as_path(),
+        history_position(
+            root_path.as_path(),
+            root_id,
+            /*end_ordinal_exclusive*/ 15,
+        ),
+    );
+
+    // A fresh store models a restart: nothing is cached between reads.
+    let store = LocalThreadStore::new(test_config(home.path()), /*state_db*/ None);
+    let transcript = store
+        .load_model_transcript(LoadThreadHistoryParams {
+            thread_id: child_id,
+            include_archived: false,
+        })
+        .await
+        .expect("load transcript")
+        .transcript;
+
+    assert_eq!(
+        item_ids(&transcript),
+        vec!["msg_u1", "msg_a1", "msg_u2", "msg_a2", "msg_u4", "msg_a4"]
+    );
+    assert_eq!(transcript.completeness, TranscriptCompleteness::Complete);
+    assert_eq!(transcript.rejected_checkpoints, 0);
+    assert_eq!(transcript.checkpoints.len(), 1);
+    let checkpoint = &transcript.checkpoints[0];
+    assert_eq!(checkpoint.position, 8);
+    assert_eq!(checkpoint.items_before, 2);
+    assert_eq!(
+        checkpoint
+            .compacted
+            .portable
+            .as_ref()
+            .and_then(|portable| portable.covers.position),
+        Some(8)
+    );
+    assert_eq!(
+        transcript
+            .items
+            .iter()
+            .map(|item| item.position)
+            .collect::<Vec<_>>(),
+        vec![2, 4, 11, 13, 18, 20]
+    );
+}
