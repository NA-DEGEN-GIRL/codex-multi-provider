--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_roots.rs
@@ -0,0 +1,90 @@
+//! Map registered directory aliases to the physical owner of a record.
+
+use std::collections::HashMap;
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_utils_absolute_path::AbsolutePathBuf;
+
+use super::sources::SourceHome;
+use crate::error_code::invalid_request;
+
+struct Root<'a> {
+    logical: PathBuf,
+    physical: PathBuf,
+    home: &'a Path,
+    source: &'a SourceHome,
+}
+
+pub(super) struct RecordRoots<'a> {
+    roots: Vec<Root<'a>>,
+}
+
+pub(super) struct ResolvedRecord<'a> {
+    pub(super) source: &'a SourceHome,
+    pub(super) home: &'a Path,
+    pub(super) path: PathBuf,
+}
+
+impl<'a> RecordRoots<'a> {
+    pub(super) async fn new(
+        homes: &'a HashMap<PathBuf, SourceHome>,
+    ) -> Result<Self, JSONRPCErrorError> {
+        let mut directories = Vec::new();
+        for (home, source) in homes {
+            for name in ["sessions", "archived_sessions"] {
+                let directory = home.join(name);
+                let physical = match tokio::fs::canonicalize(&directory).await {
+                    Ok(path) => path,
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => directory.clone(),
+                    Err(error) => {
+                        return Err(invalid_request(format!(
+                            "source session directory unavailable: {error}"
+                        )));
+                    }
+                };
+                let normalize = |path| {
+                    AbsolutePathBuf::from_absolute_path_checked(path)
+                        .map(AbsolutePathBuf::into_path_buf)
+                        .map_err(|error| invalid_request(error.to_string()))
+                };
+                directories.push((normalize(directory)?, normalize(physical)?, home, source));
+            }
+        }
+        let mut roots = Vec::new();
+        for (logical, physical, _, _) in &directories {
+            // A link does not enroll an otherwise unregistered destination.
+            if let Some((_, _, home, source)) = directories
+                .iter()
+                .find(|(candidate, resolved, _, _)| candidate == physical && candidate == resolved)
+            {
+                roots.push(Root {
+                    logical: logical.clone(),
+                    physical: physical.clone(),
+                    home,
+                    source,
+                });
+            }
+        }
+        roots.sort_by_key(|root| std::cmp::Reverse(root.logical.components().count()));
+        Ok(Self { roots })
+    }
+
+    pub(super) fn resolve(
+        &self,
+        path: &Path,
+    ) -> Result<Option<ResolvedRecord<'a>>, JSONRPCErrorError> {
+        let path = AbsolutePathBuf::from_absolute_path_checked(path)
+            .map_err(|error| invalid_request(error.to_string()))?;
+        Ok(self.roots.iter().find_map(|root| {
+            path.strip_prefix(&root.logical)
+                .ok()
+                .map(|relative| ResolvedRecord {
+                    source: root.source,
+                    home: root.home,
+                    path: root.physical.join(relative),
+                })
+        }))
+    }
+}
diff --git a/codex-rs/app-server/src/manager_catalog_snapshot.rs b/codex-rs/app-server/src/manager_catalog_snapshot.rs
new file mode 100644
index 0000000000000000000000000000000000000000..623cae2dc21a981e66e18d84a09db3540ed09d59
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_snapshot.rs
@@ -0,0 +1,271 @@
+//! Bounded persisted-history changes for an already opened catalog record.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+
+use codex_app_server_protocol::ItemCompletedNotification;
+use codex_app_server_protocol::ItemStartedNotification;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::SortDirection;
+use codex_app_server_protocol::Thread;
+use codex_app_server_protocol::ThreadItemsListParams;
+use codex_app_server_protocol::ThreadNameUpdatedNotification;
+use codex_app_server_protocol::ThreadTurnsListParams;
+use codex_app_server_protocol::Turn;
+use codex_app_server_protocol::TurnCompletedNotification;
+use codex_app_server_protocol::TurnItemsView;
+use codex_app_server_protocol::TurnStartedNotification;
+use codex_app_server_protocol::TurnStatus;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use sha2::Digest;
+
+use super::RecordCatalog;
+use crate::error_code::invalid_request;
+
+const MAX_CATCH_UP_TURNS: u32 = 32;
+const MAX_ITEMS: usize = 2048;
+const MAX_BYTES: usize = 8 * 1024 * 1024;
+
+struct ObservedItem {
+    hash: [u8; 32],
+    needs_completion: bool,
+}
+
+pub(super) struct Snapshot {
+    pub(super) thread: Thread,
+    pub(super) turns: Vec<Turn>,
+    rollout: Option<PathBuf>,
+    item_states: HashMap<String, HashMap<String, ObservedItem>>,
+}
+
+impl Snapshot {
+    pub(super) async fn read(
+        catalog: &RecordCatalog,
+        id: &str,
+        cwd: &AbsolutePathBuf,
+        previous: Option<&Self>,
+    ) -> Result<Self, JSONRPCErrorError> {
+        let source = catalog.source(id)?;
+        let stored = catalog.stored(source, /*include_turns*/ false).await?;
+        if previous.is_some_and(|previous| previous.rollout != stored.rollout_path) {
+            return Err(invalid_request(
+                "record history was replaced; reopen the common record",
+            ));
+        }
+        let rollout = stored.rollout_path.clone();
+        let (mut thread, _) =
+            crate::request_processors::thread_from_stored_thread(stored, "openai", cwd);
+        thread.can_accept_direct_input = Some(false);
+        thread.path = None;
+        let mut page = catalog
+            .turns_list(ThreadTurnsListParams {
+                thread_id: id.to_string(),
+                cursor: None,
+                limit: Some(if previous.is_some() {
+                    MAX_CATCH_UP_TURNS
+                } else {
+                    1
+                }),
+                sort_direction: Some(SortDirection::Desc),
+                items_view: Some(TurnItemsView::NotLoaded),
+            })
+            .await?;
+        if let Some(anchor) = previous.and_then(|previous| previous.turns.last()) {
+            let index = page
+                .data
+                .iter()
+                .position(|turn| turn.id == anchor.id)
+                .ok_or_else(|| {
+                    invalid_request(
+                        "common record history changed or exceeded catch-up limit; reopen it",
+                    )
+                })?;
+            page.data.truncate(index + 1);
+        } else if previous.is_some() && page.next_cursor.is_some() {
+            return Err(invalid_request(
+                "common record catch-up exceeds its limit; reopen it",
+            ));
+        }
+        let mut count = 0;
+        let mut bytes = 0;
+        let mut pages = 0;
+        let mut item_states = HashMap::new();
+        for turn in &mut page.data {
+            let mut cursor = None;
+            let mut states = HashMap::new();
+            let old_states = previous.and_then(|previous| previous.item_states.get(&turn.id));
+            let completed = turn.status != TurnStatus::InProgress;
+            loop {
+                pages += 1;
+                if pages > 64 {
+                    return Err(invalid_request(
+                        "common record item paging exceeds its limit",
+                    ));
+                }
+                let items = catalog
+                    .items_list(ThreadItemsListParams {
+                        thread_id: id.to_string(),
+                        turn_id: Some(turn.id.clone()),
+                        cursor: cursor.clone(),
+                        limit: Some(100),
+                        sort_direction: Some(SortDirection::Asc),
+                    })
+                    .await?;
+                for entry in items.data {
+                    if entry.turn_id != turn.id {
+                        return Err(invalid_request(
+                            "common record returned an item for another turn",
+                        ));
+                    }
+                    let serialized = serde_json::to_vec(&entry.item)
+                        .map_err(|error| invalid_request(error.to_string()))?;
+                    let hash: [u8; 32] = sha2::Sha256::digest(&serialized).into();
+                    let old = old_states.and_then(|states| states.get(entry.item.id()));
+                    let unchanged = old.is_some_and(|old| old.hash == hash);
+                    // Finish items this watcher actually started, even if their
+                    // text did not change when the turn completed. Do not replay
+                    // the entire opening baseline just for a status transition.
+                    let pending_completion = old.is_some_and(|old| old.needs_completion);
+                    let notify =
+                        previous.is_some() && (!unchanged || (completed && pending_completion));
+                    states.insert(
+                        entry.item.id().to_string(),
+                        ObservedItem {
+                            hash,
+                            needs_completion: !completed && (notify || pending_completion),
+                        },
+                    );
+                    // Opening a record establishes a baseline; paginated history
+                    // already supplies its contents. Bound only payloads that
+                    // will actually be sent as new or changed notifications.
+                    if notify {
+                        count += 1;
+                        bytes += serialized.len();
+                        if count > MAX_ITEMS || bytes > MAX_BYTES {
+                            return Err(invalid_request(
+                                "common record update exceeds its limit; reopen it",
+                            ));
+                        }
+                        turn.items.push(entry.item);
+                    }
+                }
+                if items.next_cursor.is_none() {
+                    break;
+                }
+                if items.next_cursor == cursor {
+                    return Err(invalid_request("common record item cursor did not advance"));
+                }
+                cursor = items.next_cursor;
+            }
+            item_states.insert(turn.id.clone(), states);
+            turn.items_view = TurnItemsView::NotLoaded;
+        }
+        if catalog
+            .stored(source, /*include_turns*/ false)
+            .await?
+            .rollout_path
+            != rollout
+        {
+            return Err(invalid_request(
+                "common record changed during update; reopen it",
+            ));
+        }
+        page.data.reverse();
+        if let Some(old) = previous.and_then(|previous| previous.turns.last())
+            && let Some(old_states) =
+                previous.and_then(|previous| previous.item_states.get(&old.id))
+            && item_states
+                .get(&old.id)
+                .is_some_and(|states| old_states.keys().any(|id| !states.contains_key(id)))
+        {
+            return Err(invalid_request(
+                "common record items were removed; reopen it",
+            ));
+        }
+        Ok(Self {
+            thread,
+            turns: page.data,
+            rollout,
+            item_states,
+        })
+    }
+
+    pub(super) fn changes(&self, previous: &Self) -> Vec<ServerNotification> {
+        let id = &self.thread.id;
+        let mut events = Vec::new();
+        if self.thread.name != previous.thread.name {
+            events.push(ServerNotification::ThreadNameUpdated(
+                ThreadNameUpdatedNotification {
+                    thread_id: id.clone(),
+                    thread_name: self.thread.name.clone(),
+                },
+            ));
+        }
+        for turn in &self.turns {
+            let old = previous.turns.iter().find(|old| old.id == turn.id);
+            if old == Some(turn) {
+                continue;
+            }
+            if old.is_none() {
+                let mut start = turn.clone();
+                start.items.clear();
+                start.items_view = TurnItemsView::NotLoaded;
+                start.status = TurnStatus::InProgress;
+                start.error = None;
+                start.completed_at = None;
+                start.duration_ms = None;
+                events.push(ServerNotification::TurnStarted(TurnStartedNotification {
+                    thread_id: id.clone(),
+                    turn: start,
+                }));
+            }
+            let completed = turn.status != TurnStatus::InProgress;
+            for item in &turn.items {
+                // Persisted partial items are upserts. Never invent a completion
+                // for an in-progress turn or forward an actionable tool request.
+                if completed {
+                    events.push(ServerNotification::ItemCompleted(
+                        ItemCompletedNotification {
+                            thread_id: id.clone(),
+                            turn_id: turn.id.clone(),
+                            item: item.clone(),
+                            completed_at_ms: turn.completed_at.unwrap_or(self.thread.updated_at)
+                                * 1000,
+                        },
+                    ));
+                } else {
+                    events.push(ServerNotification::ItemStarted(ItemStartedNotification {
+                        thread_id: id.clone(),
+                        turn_id: turn.id.clone(),
+                        item: item.clone(),
+                        started_at_ms: turn.started_at.unwrap_or(self.thread.updated_at) * 1000,
+                    }));
+                }
+            }
+            if completed {
+                let mut end = turn.clone();
+                end.items.clear();
+                end.items_view = TurnItemsView::NotLoaded;
+                events.push(ServerNotification::TurnCompleted(
+                    TurnCompletedNotification {
+                        thread_id: id.clone(),
+                        turn: end,
+                    },
+                ));
+            }
+        }
+        events
+    }
+
+    pub(super) fn retain_latest(&mut self) {
+        if self.turns.len() > 1 {
+            self.turns.drain(..self.turns.len() - 1);
+        }
+        for turn in &mut self.turns {
+            turn.items.clear();
+        }
+        self.item_states
+            .retain(|id, _| self.turns.last().is_some_and(|turn| turn.id == *id));
+    }
+}
diff --git a/codex-rs/app-server/src/manager_catalog_sources.rs b/codex-rs/app-server/src/manager_catalog_sources.rs
new file mode 100644
index 0000000000000000000000000000000000000000..87410ef1a69060d8b5264506369de9afcdbbc71b
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_sources.rs
@@ -0,0 +1,423 @@
+//! Resolve registered managed source homes inside the native remote runtime.
+//!
+//! Discovery uses read-only state pages; it never initializes a database, scans
+//! conversation bodies, acquires a writer, or reads another source's config/auth.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::Duration;
+use std::time::Instant;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_protocol::ThreadId;
+use codex_thread_store::ManagedSourceId;
+use codex_thread_store::ReadOnlyLocalThreadStore;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use serde::Deserialize;
+use sha2::Digest;
+use tokio::sync::Mutex;
+use tokio::sync::OnceCell;
+use uuid::Uuid;
+
+use super::CatalogMode;
+use super::HistoryProjections;
+use super::RecordCatalog;
+use super::RecordSource;
+use super::metadata::DiscoveredMetadata;
+use super::roots::RecordRoots;
+use crate::error_code::invalid_request;
+
+const MAX_SOURCES: usize = 256;
+const REFRESH_INTERVAL: Duration = Duration::from_secs(2);
+const DISCOVERY_TIMEOUT: Duration = Duration::from_secs(8);
+const PROJECTION_NAMESPACE: Uuid = Uuid::from_u128(0x14a0f21bb52945fcbd9eb07637424fa3);
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct SourceCatalog {
+    version: u32,
+    host_id: String,
+    sources: Vec<SourceHome>,
+    #[serde(default)]
+    legacy_sources: Vec<SourceHome>,
+    managed_sources_path: Option<PathBuf>,
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct SourceHome {
+    pub(super) host_id: String,
+    pub(super) source_store_id: String,
+    pub(super) codex_home: PathBuf,
+}
+
+#[derive(Clone)]
+struct Discovery {
+    revision: String,
+    entries: Arc<Vec<RecordSource>>,
+    metadata: Arc<DiscoveredMetadata>,
+}
+
+struct CachedDiscovery {
+    path: PathBuf,
+    bytes: Vec<u8>,
+    snapshot: Arc<OnceCell<DiscoverySnapshot>>,
+    history_projections: Arc<Mutex<HistoryProjections>>,
+}
+
+struct DiscoverySnapshot {
+    observed: Instant,
+    result: Result<Discovery, JSONRPCErrorError>,
+}
+
+static CACHE: Mutex<Option<CachedDiscovery>> = Mutex::const_new(None);
+
+pub(super) async fn discover(
+    path: &Path,
+    bytes: &[u8],
+) -> Result<RecordCatalog, JSONRPCErrorError> {
+    let (snapshot, history_projections) = {
+        let mut cache = CACHE.lock().await;
+        if let Some(previous) = cache.as_ref()
+            && previous.path == path
+            && previous.bytes == bytes
+            && previous
+                .snapshot
+                .get()
+                .is_none_or(|snapshot| snapshot.observed.elapsed() < REFRESH_INTERVAL)
+        {
+            (
+                Arc::clone(&previous.snapshot),
+                Arc::clone(&previous.history_projections),
+            )
+        } else {
+            let snapshot = Arc::new(OnceCell::new());
+            let history_projections = cache
+                .as_ref()
+                .filter(|previous| previous.path == path && previous.bytes == bytes)
+                .map(|previous| Arc::clone(&previous.history_projections))
+                .unwrap_or_default();
+            *cache = Some(CachedDiscovery {
+                path: path.to_path_buf(),
+                bytes: bytes.to_vec(),
+                snapshot: Arc::clone(&snapshot),
+                history_projections: Arc::clone(&history_projections),
+            });
+            (snapshot, history_projections)
+        }
+    };
+    // Share an in-flight refresh without holding the catalog mutex during I/O.
+    let current = snapshot
+        .get_or_init(|| async {
+            let result = tokio::time::timeout(DISCOVERY_TIMEOUT, read_sources(bytes))
+                .await
+                .map_err(|_| invalid_request("managed catalog source discovery timed out"))
+                .and_then(|result| result);
+            DiscoverySnapshot {
+                observed: Instant::now(),
+                result,
+            }
+        })
+        .await
+        .result
+        .clone()?;
+    Ok(RecordCatalog {
+        version: 1,
+        revision: current.revision,
+        host_id: "local".to_string(),
+        entries: current.entries,
+        discovered: Some(current.metadata),
+        mode: CatalogMode::default(),
+        canonical_homes: OnceCell::new(),
+        read_only_stores: Mutex::new(Default::default()),
+        history_projections,
+        project_aliases: Default::default(),
+    })
+}
+
+async fn read_sources(bytes: &[u8]) -> Result<Discovery, JSONRPCErrorError> {
+    let mut catalog: SourceCatalog = serde_json::from_slice(bytes)
+        .map_err(|error| invalid_request(format!("invalid managed source catalog: {error}")))?;
+    if let Some(path) = catalog.managed_sources_path.take() {
+        if catalog.version != 3 || !catalog.sources.is_empty() || !path.is_absolute() {
+            return Err(invalid_request("invalid mixed source inventory reference"));
+        }
+        let metadata = tokio::fs::metadata(&path)
+            .await
+            .map_err(|error| invalid_request(format!("managed inventory unavailable: {error}")))?;
+        if !metadata.is_file() || metadata.len() > super::MAX_MANIFEST_BYTES {
+            return Err(invalid_request("managed inventory exceeds its file limit"));
+        }
+        let bytes = tokio::fs::read(path)
+            .await
+            .map_err(|error| invalid_request(error.to_string()))?;
+        if bytes.len() as u64 > super::MAX_MANIFEST_BYTES {
+            return Err(invalid_request("managed inventory exceeds its file limit"));
+        }
+        let inventory: SourceCatalog = serde_json::from_slice(&bytes).map_err(|error| {
+            invalid_request(format!("invalid referenced managed inventory: {error}"))
+        })?;
+        if inventory.version != 2
+            || inventory.host_id != "local"
+            || !inventory.legacy_sources.is_empty()
+            || inventory.managed_sources_path.is_some()
+        {
+            return Err(invalid_request(
+                "mixed catalog requires a direct version2 managed inventory",
+            ));
+        }
+        catalog.sources = inventory.sources;
+    }
+    if !matches!(catalog.version, 2 | 3)
+        || (catalog.version == 2 && !catalog.legacy_sources.is_empty())
+        || catalog.host_id != "local"
+        || catalog.sources.len() + catalog.legacy_sources.len() > MAX_SOURCES
+    {
+        return Err(invalid_request(
+            "unsupported managed source catalog version, host, or size",
+        ));
+    }
+    let mut identities = HashSet::new();
+    let mut homes = HashMap::new();
+    let mut entries = Vec::new();
+    let mut metadata = DiscoveredMetadata::default();
+    for source in &catalog.sources {
+        let profile_id = source
+            .source_store_id
+            .strip_prefix("manager:")
+            .and_then(|id| Uuid::parse_str(id).ok());
+        if source.host_id != "local"
+            || profile_id.is_none()
+            || !source.codex_home.is_absolute()
+            || !identities.insert(source.source_store_id.clone())
+        {
+            return Err(invalid_request(
+                "invalid or duplicate managed catalog source identity",
+            ));
+        }
+        let home = tokio::fs::canonicalize(&source.codex_home)
+            .await
+            .map_err(|error| {
+                invalid_request(format!("managed source home unavailable: {error}"))
+            })?;
+        if homes.insert(home.clone(), source.clone()).is_some() {
+            return Err(invalid_request(
+                "managed source home has multiple catalog identities",
+            ));
+        }
+        let marker_path = home.join("managed-source.json");
+        let metadata = tokio::fs::symlink_metadata(&marker_path)
+            .await
+            .map_err(|error| {
+                invalid_request(format!("managed source marker unavailable: {error}"))
+            })?;
+        if !metadata.is_file() || metadata.len() > 4096 {
+            return Err(invalid_request("invalid managed source marker"));
+        }
+        let marker_bytes = tokio::fs::read(&marker_path).await.map_err(|error| {
+            invalid_request(format!("managed source marker unavailable: {error}"))
+        })?;
+        if marker_bytes.len() > 4096 {
+            return Err(invalid_request("managed source marker exceeds its limit"));
+        }
+        let marker: ManagedSourceId = serde_json::from_slice(&marker_bytes)
+            .map_err(|error| invalid_request(format!("invalid managed source marker: {error}")))?;
+        if marker.host_id != source.host_id || marker.store_id != source.source_store_id {
+            return Err(invalid_request("managed source marker identity changed"));
+        }
+    }
+    for source in &catalog.legacy_sources {
+        let expected_id = format!(
+            "legacy:{:x}",
+            sha2::Sha256::digest(source.codex_home.to_string_lossy().as_bytes())
+        );
+        if source.host_id != "local"
+            || source.source_store_id != expected_id
+            || !source.codex_home.is_absolute()
+            || !identities.insert(source.source_store_id.clone())
+        {
+            return Err(invalid_request(
+                "invalid mixed source catalog legacy identity",
+            ));
+        }
+        let home = tokio::fs::canonicalize(&source.codex_home)
+            .await
+            .map_err(|error| invalid_request(format!("legacy source home unavailable: {error}")))?;
+        if homes.insert(home, source.clone()).is_some() {
+            return Err(invalid_request(
+                "legacy home has multiple catalog identities",
+            ));
+        }
+    }
+    let mut scope = homes
+        .iter()
+        .map(|(home, source)| (&source.source_store_id, home))
+        .collect::<Vec<_>>();
+    scope.sort();
+    metadata.scope_revision = format!(
+        "{:x}",
+        sha2::Sha256::digest(
+            serde_json::to_vec(&scope).map_err(|error| invalid_request(error.to_string()))?
+        )
+    );
+    let roots = RecordRoots::new(&homes).await?;
+    metadata.registered_homes = homes
+        .iter()
+        .map(|(home, source)| (source.source_store_id.clone(), home.clone()))
+        .collect();
+    let mut indexed_entries = HashMap::new();
+    let mut unindexed_sources = Vec::new();
+    for (home, source) in &homes {
+        let sqlite = codex_state::SqliteConfig::from_sqlite_home(
+            AbsolutePathBuf::from_absolute_path(home)
+                .map_err(|error| invalid_request(error.to_string()))?,
+        );
+        // A just-enrolled profile has no database before its first native start.
+        // Existing unmanaged stores may predate the state database. Discover
+        // their headers without creating or migrating a source index.
+        if !tokio::fs::try_exists(sqlite.state_db_path())
+            .await
+            .map_err(|error| invalid_request(error.to_string()))?
+        {
+            if source.source_store_id.starts_with("legacy:") {
+                unindexed_sources.push((source, home));
+                continue;
+            }
+            for directory in [home.join("sessions"), home.join("archived_sessions")] {
+                if tokio::fs::try_exists(&directory)
+                    .await
+                    .map_err(|error| invalid_request(error.to_string()))?
+                {
+                    let mut files = tokio::fs::read_dir(directory)
+                        .await
+                        .map_err(|error| invalid_request(error.to_string()))?;
+                    if files
+                        .next_entry()
+                        .await
+                        .map_err(|error| invalid_request(error.to_string()))?
+                        .is_some()
+                    {
+                        return Err(invalid_request(
+                            "managed source has records but its state database is unavailable",
+                        ));
+                    }
+                }
+            }
+            continue;
+        }
+        let store = Arc::new(
+            ReadOnlyLocalThreadStore::open(home.clone(), sqlite)
+                .await
+                .map_err(super::history::store_error)?,
+        );
+        let result = read_pages(source, &store, &roots, &mut indexed_entries, &mut metadata).await;
+        store.close().await;
+        result?;
+    }
+    // A physical session home can have no database while another registered
+    // profile indexes its records. Resolve every index before judging headers.
+    let indexed_projections = indexed_entries.keys().copied().collect();
+    for (source, home) in unindexed_sources {
+        super::legacy_sources::read_headers(source, home, &indexed_projections, &mut entries)
+            .await?;
+    }
+    for entry in entries {
+        indexed_entries
+            .entry(entry.projection_thread_id)
+            .or_insert(entry);
+    }
+    let mut entries = indexed_entries.into_values().collect::<Vec<_>>();
+    entries.sort_by_key(|entry| entry.projection_thread_id.to_string());
+    let mut digest = sha2::Sha256::new();
+    for entry in &entries {
+        digest
+            .update(serde_json::to_vec(entry).map_err(|error| invalid_request(error.to_string()))?);
+        metadata.projections.insert(
+            (entry.source_store_id.clone(), entry.thread_id),
+            entry.projection_thread_id,
+        );
+    }
+    Ok(Discovery {
+        revision: format!("{:x}", digest.finalize()),
+        entries: Arc::new(entries),
+        metadata: Arc::new(metadata),
+    })
+}
+
+async fn read_pages(
+    source: &SourceHome,
+    store: &ReadOnlyLocalThreadStore,
+    roots: &RecordRoots<'_>,
+    entries: &mut HashMap<ThreadId, RecordSource>,
+    metadata: &mut DiscoveredMetadata,
+) -> Result<(), JSONRPCErrorError> {
+    let mut after_id = None;
+    loop {
+        let page_size = 256;
+        let page = store
+            .list_metadata_summaries_page(after_id, page_size)
+            .await
+            .map_err(super::history::store_error)?;
+        let count = page.len();
+        for mut thread in page {
+            after_id = Some(thread.thread_id);
+            let path = thread
+                .rollout_path
+                .as_ref()
+                .ok_or_else(|| invalid_request("source metadata has no rollout path"))?;
+            let Some(record) = roots.resolve(path)? else {
+                continue;
+            };
+            // Sidebar pages omit empty previews; V2 children still need an
+            // identity here so a parent's linked history can be projected.
+            let owner_id = &record.source.source_store_id;
+            let key = format!("local\0{owner_id}\0{}", thread.thread_id);
+            let projection = Uuid::new_v5(&PROJECTION_NAMESPACE, key.as_bytes());
+            let projection_thread_id = ThreadId::from_string(&projection.to_string())
+                .map_err(|error| invalid_request(error.to_string()))?;
+            if let Some(previous) = metadata.summaries.get(&projection_thread_id) {
+                let previous_source = &metadata.summary_sources[&projection_thread_id];
+                let priority = (
+                    source.source_store_id == *owner_id,
+                    thread.updated_at,
+                    &source.source_store_id,
+                );
+                let previous_priority = (
+                    previous_source == owner_id,
+                    previous.updated_at,
+                    previous_source,
+                );
+                if priority <= previous_priority {
+                    continue;
+                }
+            }
+            // Prefer the owning store's row. Without one, the newest registered
+            // metadata copy identifies the candidate read-only index. Selected
+            // reads validate physical ownership, IDs and durable checkpoints;
+            // this selection never acquires writer authority.
+            thread.rollout_path = Some(record.path.clone());
+            entries.insert(
+                projection_thread_id,
+                RecordSource {
+                    projection_thread_id,
+                    thread_id: thread.thread_id,
+                    host_id: record.source.host_id.clone(),
+                    source_store_id: owner_id.clone(),
+                    codex_home: record.home.to_path_buf(),
+                    rollout_path: record.path,
+                },
+            );
+            metadata
+                .summary_sources
+                .insert(projection_thread_id, source.source_store_id.clone());
+            metadata.summaries.insert(projection_thread_id, thread);
+        }
+        if count < page_size {
+            break;
+        }
+    }
+    Ok(())
+}
diff --git a/codex-rs/app-server/src/manager_catalog_watch.rs b/codex-rs/app-server/src/manager_catalog_watch.rs
new file mode 100644
index 0000000000000000000000000000000000000000..11617751130df8eb2878976c473c2f4dae351b83
--- /dev/null
+++ b/codex-rs/app-server/src/manager_catalog_watch.rs
@@ -0,0 +1,175 @@
+//! Connection-scoped observation of foreign history, without a loaded actor.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::time::Duration;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ThreadStatus;
+use codex_app_server_protocol::ThreadStatusChangedNotification;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use tokio::sync::Mutex;
+use tokio::sync::oneshot;
+use tokio::task::JoinHandle;
+use tokio_util::sync::CancellationToken;
+
+use super::RecordCatalog;
+use super::snapshot::Snapshot;
+use crate::error_code::invalid_request;
+use crate::outgoing_message::ConnectionId;
+use crate::outgoing_message::OutgoingMessageSender;
+
+const MAX_WATCHES: usize = 64;
+
+struct Watch {
+    cancel: CancellationToken,
+    task: JoinHandle<()>,
+}
+
+#[derive(Default)]
+pub(crate) struct CatalogWatches {
+    tasks: Mutex<HashMap<(ConnectionId, String), Watch>>,
+}
+
+impl CatalogWatches {
+    pub(crate) async fn start(
+        &self,
+        connection: ConnectionId,
+        id: String,
+        catalog: &RecordCatalog,
+        cwd: AbsolutePathBuf,
+        outgoing: Arc<OutgoingMessageSender>,
+    ) -> Result<oneshot::Sender<()>, JSONRPCErrorError> {
+        self.stop(connection, &id).await;
+        let snapshot = Snapshot::read(catalog, &id, &cwd, None).await?;
+        let (ready, wait) = oneshot::channel();
+        let cancel = CancellationToken::new();
+        let mut tasks = self.tasks.lock().await;
+        tasks.retain(|_, watch| !watch.task.is_finished());
+        if tasks.len() >= MAX_WATCHES {
+            return Err(invalid_request(
+                "too many open common records; close another record first",
+            ));
+        }
+        let token = cancel.clone();
+        let thread_id = id.clone();
+        let task = tokio::spawn(async move {
+            tokio::select! {
+                _ = token.cancelled() => return,
+                result = wait => if result.is_err() { return; },
+            }
+            let mut previous = snapshot;
+            let mut read_failed = false;
+            let connections = [connection];
+            loop {
+                tokio::select! {
+                    _ = token.cancelled() => return,
+                    _ = tokio::time::sleep(Duration::from_secs(1)) => {},
+                }
+                let update = async {
+                    let catalog = RecordCatalog::from_environment().await?.ok_or_else(|| {
+                        invalid_request("common record catalog is no longer available")
+                    })?;
+                    Snapshot::read(&catalog, &thread_id, &cwd, Some(&previous)).await
+                };
+                let result = tokio::select! {
+                    _ = token.cancelled() => return,
+                    result = tokio::time::timeout(Duration::from_secs(10), update) => result,
+                };
+                let mut next = match result {
+                    Ok(Ok(snapshot)) => snapshot,
+                    error => {
+                        if read_failed {
+                            continue;
+                        }
+                        match error {
+                            Ok(Err(error)) => tracing::warn!(
+                                thread_id,
+                                code = error.code,
+                                message = error.message,
+                                "common record update failed; retaining the last valid snapshot"
+                            ),
+                            Err(_) => tracing::warn!(
+                                thread_id,
+                                "common record update timed out; retaining the last valid snapshot"
+                            ),
+                            Ok(Ok(_)) => unreachable!(),
+                        }
+                        read_failed = true;
+                        let notification = ServerNotification::ThreadStatusChanged(
+                            ThreadStatusChangedNotification {
+                                thread_id: thread_id.clone(),
+                                status: ThreadStatus::SystemError,
+                            },
+                        );
+                        tokio::select! {
+                            _ = token.cancelled() => {},
+                            _ = outgoing.send_server_notification_to_connections(&connections, notification) => {},
+                        }
+                        continue;
+                    }
+                };
+                if read_failed {
+                    let notification =
+                        ServerNotification::ThreadStatusChanged(ThreadStatusChangedNotification {
+                            thread_id: thread_id.clone(),
+                            status: next.thread.status.clone(),
+                        });
+                    tokio::select! {
+                        _ = token.cancelled() => return,
+                        _ = outgoing.send_server_notification_to_connections(&connections, notification) => {},
+                    }
+                    read_failed = false;
+                }
+                for notification in next.changes(&previous) {
+                    tokio::select! {
+                        _ = token.cancelled() => return,
+                        _ = outgoing.send_server_notification_to_connections(&connections, notification) => {},
+                    }
+                }
+                next.retain_latest();
+                previous = next;
+            }
+        });
+        tasks.insert((connection, id), Watch { cancel, task });
+        Ok(ready)
+    }
+
+    pub(crate) async fn stop(&self, connection: ConnectionId, id: &str) -> bool {
+        let removed = self
+            .tasks
+            .lock()
+            .await
+            .remove(&(connection, id.to_string()));
+        if let Some(watch) = removed {
+            watch.cancel.cancel();
+            let _ = watch.task.await;
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(crate) async fn close_connection(&self, connection: ConnectionId) {
+        let ids = self
+            .tasks
+            .lock()
+            .await
+            .keys()
+            .filter(|(candidate, _)| *candidate == connection)
+            .map(|(_, id)| id.clone())
+            .collect::<Vec<_>>();
+        for id in ids {
+            self.stop(connection, &id).await;
+        }
+    }
+}
+
+impl Drop for CatalogWatches {
+    fn drop(&mut self) {
+        for (_, watch) in self.tasks.get_mut().drain() {
+            watch.cancel.cancel();
+        }
+    }
+}
