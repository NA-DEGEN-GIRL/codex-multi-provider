+++ b/codex-rs/core/src/context/portable_context_note.rs
@@ -0,0 +1,71 @@
+use super::ContextualUserFragment;
+use codex_protocol::models::ContentItemKind;
+
+/// Tells the model that part of its earlier context was not carried over after a switch to
+/// another provider family, and what it was given instead.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct PortableContextNote {
+    /// A summary of older turns precedes this note.
+    pub(crate) after_summary: bool,
+    /// User messages from turns that were left out precede this note.
+    pub(crate) earlier_user_messages: bool,
+    /// What follows this note.
+    pub(crate) recent: PortableRecentItems,
+}
+
+/// Recent history kept after a [`PortableContextNote`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum PortableRecentItems {
+    /// Whole turns, starting with a user message.
+    WholeTurns,
+    /// The newest items of a turn too large to keep whole.
+    PartialTurn,
+    /// Nothing recent fit.
+    Nothing,
+}
+
+impl ContextualUserFragment for PortableContextNote {
+    fn content_kind(&self) -> ContentItemKind {
+        let kind = if self.after_summary {
+            "portable_context.after_summary"
+        } else {
+            "portable_context.omitted"
+        };
+        ContentItemKind(kind.to_string())
+    }
+
+    fn role(&self) -> &'static str {
+        "developer"
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<context_note>", "</context_note>")
+    }
+
+    fn body(&self) -> String {
+        let dropped = if self.after_summary {
+            "Older turns of this conversation are summarized above. Later turns that do not fit in the available context were left out."
+        } else {
+            "Earlier parts of this conversation could not be carried over, and no summary of them is available."
+        };
+        let user_messages = if self.earlier_user_messages {
+            " The user's earlier messages are kept above."
+        } else {
+            ""
+        };
+        let recent = match self.recent {
+            PortableRecentItems::WholeTurns => " The most recent turns follow.",
+            PortableRecentItems::PartialTurn => {
+                " Only the most recent messages follow; they start partway through a turn, so its earlier steps are missing."
+            }
+            PortableRecentItems::Nothing => " No more recent messages could be kept.",
+        };
+        format!(
+            "\n{dropped}{user_messages}{recent} If something you need is missing, ask the user.\n"
+        )
+    }
+}
diff --git a/codex-rs/core/src/context/provider_handoff_note.rs b/codex-rs/core/src/context/provider_handoff_note.rs
