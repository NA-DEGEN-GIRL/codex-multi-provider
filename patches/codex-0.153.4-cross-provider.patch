+                "shared task was replaced during history refresh",
+            ));
+        }
+        // Reuse the native replacement path, preserving subscriptions, selected
+        // credentials, model/effort and the task ID. No desktop navigation occurs.
+        self.reload_paginated_thread(request_id, thread_id, snapshot, client_name, client_version)
+            .await?;
+        state.lock().await.last_terminal_turn_id = Some(latest.turn_id.clone());
+        Ok(())
+    }
+}
