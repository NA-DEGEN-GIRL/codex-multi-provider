@@ -0,0 +1,521 @@
+//! Runs the official installed Claude Code CLI through the manager's authenticated runner.
+//! All shared history and events still go through the native session recorder.
+mod auth_refresh;
+mod bridge;
+mod context;
+mod delegation;
+mod events;
+mod images;
+mod messages;
+
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::time::Duration;
+use std::time::Instant;
+
+use codex_history::RolloutItem;
+use codex_protocol::config_types::ModeKind;
+use codex_protocol::error::CodexErr;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::MessagePhase;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::AskForApproval;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ReviewDecision;
+use codex_protocol::protocol::TurnStartedEvent;
+use codex_thread_store::PersistContext;
+use serde_json::Value;
+use serde_json::json;
+use tokio_util::sync::CancellationToken;
+
+use super::SessionTask;
+use super::SessionTaskResult;
+use crate::session::TurnInput;
+use crate::session::session::Session;
+use crate::session::turn::run_hooks_and_record_inputs;
+use crate::session::turn_context::TurnContext;
+use crate::state::TaskKind;
+use auth_refresh::AuthRefresh;
+use bridge::Bridge;
+use bridge::failure;
+
+pub(crate) struct ClaudeCodeTask;
+
+impl SessionTask for ClaudeCodeTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.claude_code"
+    }
+
+    async fn run(
+        self: Arc<Self>,
+        session: Arc<Session>,
+        ctx: Arc<TurnContext>,
+        mut input: Vec<TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        session
+            .send_event(
+                &ctx,
+                EventMsg::TurnStarted(TurnStartedEvent {
+                    turn_id: ctx.sub_id.clone(),
+                    trace_id: ctx.trace_id.clone(),
+                    started_at: ctx.turn_timing_state.started_at_unix_secs().await,
+                    model_context_window: ctx.model_context_window(),
+                    collaboration_mode_kind: ctx.mode(),
+                }),
+            )
+            .await;
+        // This stable marker is checked by the manager before activating an agent profile.
+        tracing::debug!(
+            capability = "CODEX_CLAUDE_CODE_AGENT_V1",
+            "starting local Claude agent task"
+        );
+        session
+            .persist_rollout_items(&[RolloutItem::TurnContext(ctx.to_turn_context_item())])
+            .await;
+        let mut request_start = 0;
+        let mut last_message = None;
+        session
+            .input_queue
+            .accept_mailbox_delivery_for_current_turn(&session.active_turn, &ctx.sub_id)
+            .await;
+        if input.is_empty() {
+            input = session
+                .input_queue
+                .get_pending_input(&session.active_turn)
+                .await
+                .0;
+        }
+        loop {
+            if run_hooks_and_record_inputs(&session, &ctx, &input, PersistContext::TurnStart).await
+            {
+                return Ok(last_message);
+            }
+            let mut bridge = None;
+            let mut output = events::Events::default();
+            let result = tokio::select! {
+                biased;
+                _ = cancellation.cancelled() => Err(CodexErr::TurnAborted),
+                result = execute(&session, &ctx, request_start, &mut bridge, &mut output, &cancellation) => result,
+            };
+            // Preserve partial text on both failure and cancellation; never manufacture a final.
+            output.flush(&session, &ctx, MessagePhase::Commentary).await;
+            if let Err(error) = result {
+                output.interrupt_tools(&session, &ctx).await;
+                if let Some(mut bridge) = bridge {
+                    bridge.interrupt().await;
+                }
+                return Err(error);
+            }
+            if let Some(bridge) = bridge {
+                bridge.finish().await?;
+            }
+            last_message = output.last_message;
+            if !session
+                .input_queue
+                .has_pending_input(&session.active_turn)
+                .await
+            {
+                return Ok(last_message);
+            }
+            // Steering is processed as a further CLI invocation once the previous one commits.
+            // A changed current-turn fingerprint forces a fresh session with the complete prefix.
+            let transcript = context::load(&session).await?;
+            request_start = transcript
+                .items
+                .iter()
+                .map(|item| item.position)
+                .max()
+                .unwrap_or(0)
+                .saturating_add(1);
+            input = session
+                .input_queue
+                .get_pending_input(&session.active_turn)
+                .await
+                .0;
+        }
+    }
+}
+
+async fn execute(
+    session: &Arc<Session>,
+    ctx: &Arc<TurnContext>,
+    request_start: u64,
+    bridge_slot: &mut Option<Bridge>,
+    output: &mut events::Events,
+    cancellation: &CancellationToken,
+) -> codex_protocol::error::Result<()> {
+    let agent = ctx
+        .provider
+        .info()
+        .agent
+        .as_ref()
+        .ok_or_else(|| failure("agent configuration missing"))?;
+    if ctx.final_output_json_schema.is_some() {
+        return Err(failure(
+            "structured output is unavailable for this local agent",
+        ));
+    }
+    if !ctx.dynamic_tools.is_empty() {
+        events::notice(
+            session,
+            ctx,
+            "Claude uses its own tools. Codex app tools are not available in this turn.",
+        )
+        .await;
+    }
+    let environment = ctx
+        .environments
+        .primary()
+        .filter(|primary| {
+            ctx.environments.local().is_some_and(|local| {
+                local.selection.environment_id == primary.selection.environment_id
+            })
+        })
+        .ok_or_else(|| failure("a local trusted primary working directory is required"))?;
+    let cwd = environment
+        .cwd()
+        .to_abs_path()
+        .map_err(|_| failure("remote working directories are not supported"))?;
+    if !ctx.config.active_project.is_trusted() {
+        return Err(failure(
+            "trust this project in Codex before starting Claude",
+        ));
+    }
+    if !matches!(ctx.permission_profile(), PermissionProfile::Disabled) {
+        if matches!(ctx.approval_policy(), AskForApproval::Never) {
+            return Err(failure(
+                "Claude runs outside the Codex sandbox; restricted permissions with approval=never cannot be honored",
+            ));
+        }
+        let decision = events::command_approval(session, ctx, &format!("{}-external-agent", ctx.sub_id),
+            vec![agent.command.clone()],
+            "Claude Code runs outside the Codex sandbox. This turn can access files and network with your user permissions; Claude's own approval prompts remain active. Allow this external agent for this turn?").await;
+        if !matches!(decision, ReviewDecision::Approved) {
+            return Err(failure("external agent execution was not approved"));
+        }
+    }
+    let preparation_started = std::time::Instant::now();
+    let loading = context::load(session);
+    tokio::pin!(loading);
+    let transcript = tokio::select! {
+        result = &mut loading => result?,
+        _ = tokio::time::sleep(Duration::from_secs(2)) => {
+            // Keep the read future moving while publishing the notice: either
+            // side can be awaiting the shared recorder/store.
+            let (result, _) = tokio::join!(loading, events::notice(session, ctx,
+                "Preparing shared conversation history for Claude. Long conversations may take longer."));
+            result?
+        }
+    };
+    let snapshot = context::snapshot(&transcript, &ctx.sub_id);
+    tracing::info!(
+        elapsed_ms = preparation_started.elapsed().as_millis(),
+        items = transcript.items.len(),
+        "Claude shared history loaded and verified"
+    );
+    // Reuse Codex's scoped instruction discovery, without exporting its native tool
+    // contracts or base identity. The runner includes this stable text in its cache key.
+    let instructions = crate::agents_md::load_project_instructions(
+        &ctx.config,
+        session.user_instructions().await,
+        &ctx.environments,
+    )
+    .await
+    .map_err(|error| {
+        failure(format!(
+            "cannot load applicable project instructions: {error}"
+        ))
+    })?;
+    let mut system_prompt = String::from(
+        "Apply the host developer constraints with priority over project and user instructions. Use only the tools available in this Claude Code invocation.\n",
+    );
+    if let Some(managed) = &ctx
+        .config
+        .config_layer_stack
+        .requirements()
+        .additional_developer_instructions
+    {
+        system_prompt.push_str("<managed_developer_instructions>\n");
+        system_prompt.push_str(&managed.value);
+        system_prompt.push_str("\n</managed_developer_instructions>\n");
+    }
+    if let Some(developer) = ctx.developer_instructions.as_deref() {
+        system_prompt.push_str("<host_developer_instructions>\n");
+        system_prompt.push_str(developer);
+        system_prompt.push_str("\n</host_developer_instructions>\n");
+    }
+    if let Some(instructions) = instructions {
+        system_prompt.push_str("<project_and_user_instructions>\n");
+        system_prompt.push_str(&instructions.text());
+        system_prompt.push_str("\n</project_and_user_instructions>\n");
+    }
+    if system_prompt.len() > 80_000 {
+        return Err(failure(
+            "applicable instructions exceed the local agent instruction limit",
+        ));
+    }
+    let mut request = String::new();
+    let mut image_references = images::Images::new(ctx.config.codex_home.as_path());
+    for item in &transcript.items {
+        if item.turn_id.as_deref() != Some(ctx.sub_id.as_str()) || item.position < request_start {
+            continue;
+        }
+        match &item.item.item {
+            ResponseItem::Message { content, role, .. }
+                if role == "user" || role == "developer" =>
+            {
+                for part in content {
+                    match part {
+                        ContentItem::InputText { text } | ContentItem::OutputText { text } => {
+                            request.push_str(text);
+                            request.push('\n');
+                        }
+                        ContentItem::InputImage { image_url, .. } => {
+                            request.push_str(&image_references.reference(image_url)?);
+                            request.push('\n');
+                        }
+                        _ => {
+                            return Err(failure(
+                                "this agent currently accepts text requests; attached images must be supplied through a file path",
+                            ));
+                        }
+                    }
+                }
+            }
+            ResponseItem::AgentMessage { content, .. } => {
+                request.push_str(&messages::plaintext(content)?);
+                request.push('\n');
+            }
+            _ => {}
+        }
+    }
+    if request.trim().is_empty() {
+        return Err(failure("there is no accepted text request to send"));
+    }
+    let model = ctx.model_info().slug.clone();
+    let effort = ctx
+        .reasoning_effort()
+        .map(|effort| serde_json::to_value(effort).unwrap_or(Value::Null))
+        .unwrap_or(json!("high"));
+    let mut delegation = delegation::Delegation::prepare(session, ctx, cancellation).await?;
+    let delegation_tools = delegation
+        .as_ref()
+        .map(delegation::Delegation::catalog)
+        .unwrap_or_default();
+    // The same account request as the turn start for every renewal: main profile or this role.
+    let role = ctx.session_source.get_agent_role();
+    // Owned, so a refusal report can outlive this turn.
+    let resolve = |rejected: Option<String>| {
+        let control = session.services.agent_control.clone();
+        let config = Arc::clone(&ctx.config);
+        let role = role.clone();
+        async move {
+            control
+                .resolve_execution_preset_credentials(&config, role.as_deref(), rejected.as_deref())
+                .await
+        }
+    };
+    let credentials = resolve(/*rejected*/ None)
+        .await
+        .map_err(|error| auth_refresh::unavailable_account(&error))?;
