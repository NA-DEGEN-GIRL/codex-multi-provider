+#[tokio::test]
+async fn returning_to_an_owner_requires_a_new_grant_and_preserves_old_fences() {
+    let fixture = ActivationFixture::new().await;
+    let first = fixture.seed_root().await;
+    fixture
+        .manager
+        .activate_managed_record_binding(
+            first.clone(),
+            &[(fixture.root, fixture.grant(/*epoch*/ 1))],
+        )
+        .await
+        .expect("initial owner A activation");
+    let first_snapshot = fixture.bindings().await;
+    let duplicate = fixture
+        .registry
+        .bind(&fixture.source_id, fixture.root, fixture.grant(/*epoch*/ 1))
+        .await
+        .expect("same current grant");
+    fixture
+        .manager
+        .activate_managed_record_binding(duplicate, &[(fixture.root, fixture.grant(/*epoch*/ 1))])
+        .await
+        .expect("same live grant reuses its existing lifetime");
+    assert_eq!(fixture.bindings().await, first_snapshot);
+    let reservation = first
+        .prepare_writer()
+        .await
+        .expect("reserve owner A writer before resume initialization");
+    let first_live = LiveThread::resume(
+        first.store(),
+        ThreadHistoryMode::Paginated,
+        ResumeThreadParams {
+            thread_id: fixture.root,
+            rollout_path: None,
+            history: Some(Arc::new(
+                first
+                    .store()
+                    .load_latest_model_context(codex_thread_store::LoadThreadHistoryParams {
+                        thread_id: fixture.root,
+                        include_archived: true,
+                    })
+                    .await
+                    .expect("canonical paginated resume history")
+                    .items,
+            )),
+            include_archived: true,
+            metadata: ThreadPersistenceMetadata {
+                cwd: Some(fixture.source_home.clone()),
+                model_provider: "openai".to_string(),
+                memory_mode: ThreadMemoryMode::Disabled,
+            },
+        },
+    )
+    .await
+    .expect("owner A claims the canonical writer");
+    drop(reservation);
+    first_live
+        .shutdown()
+        .await
+        .expect("release owner A lifetime");
+    let same_grant = fixture
+        .registry
+        .bind(&fixture.source_id, fixture.root, fixture.grant(/*epoch*/ 1))
+        .await
+        .expect("fresh object cannot renew an old grant");
+    assert!(
+        fixture
+            .manager
+            .activate_managed_record_binding(
+                same_grant,
+                &[(fixture.root, fixture.grant(/*epoch*/ 1))]
+            )
+            .await
+            .is_err()
+    );
+    assert_eq!(fixture.bindings().await, first_snapshot);
+
+    let other_grant = ManagedAuthorityGrant {
+        owner_profile_id: ThreadId::new().to_string(),
+        epoch: 2,
+        revision: 2,
+    };
+    fixture.publish_authority(&fixture.source_id, fixture.root, &other_grant);
+    let other_registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        other_grant.owner_profile_id.clone(),
+        vec![registration(&fixture.source_home, &fixture.source_id)],
+    )
+    .expect("owner B registry");
+    let other = other_registry
+        .bind(&fixture.source_id, fixture.root, other_grant)
+        .await
+        .expect("owner B binding");
+    drop(other.write_permit().await.expect("owner B authority"));
+    assert!(first.write_permit().await.is_err());
+
+    let next_grant = fixture.grant(/*epoch*/ 3);
+    fixture.publish_authority(&fixture.source_id, fixture.root, &next_grant);
+    let fresh = fixture
+        .registry
+        .bind(&fixture.source_id, fixture.root, next_grant.clone())
+        .await
+        .expect("new owner A grant");
+    fixture
+        .manager
+        .activate_managed_record_binding(fresh.clone(), &[(fixture.root, next_grant)])
+        .await
+        .expect("owner A may return after a new durable handoff");
+    let retained = fixture
+        .manager
+        .managed_record_binding(fixture.root)
+        .await
+        .expect("new binding retained");
+    assert!(Arc::ptr_eq(&retained.store(), &fresh.store()));
+    assert!(!Arc::ptr_eq(&retained.store(), &first.store()));
+    drop(
+        retained
+            .write_permit()
+            .await
+            .expect("returned owner A can write"),
+    );
+    assert!(
+        first.write_permit().await.is_err(),
+        "old A callbacks never revive"
+    );
+    assert!(
+        other.write_permit().await.is_err(),
+        "old B callbacks are fenced by the return"
+    );
+}
