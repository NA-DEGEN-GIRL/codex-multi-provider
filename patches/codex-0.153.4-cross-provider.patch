+async fn a_quiet_live_recorder_still_prevents_the_manager_transfer_lock() {
+    let home = TempDir::new().expect("home");
+    let id = source_id();
+    std::fs::write(
+        home.path().join("managed-source.json"),
+        serde_json::to_vec(&id).expect("marker"),
+    )
+    .expect("source marker");
+    let registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        profile_id(&id),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("registry");
+    let thread_id = ThreadId::new();
+    let binding = registry.bind_new(&id, thread_id).await.expect("binding");
+    let live = LiveThread::create(binding.store(), create_params(home.path(), thread_id))
+        .await
+        .expect("writer");
+    live.persist(PersistContext::Standard)
+        .await
+        .expect("persisted writer");
+    let authority_guard = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(
+            home.path()
+                .join("managed-authority")
+                .join(format!("{thread_id}.guard")),
+        )
+        .expect("authority guard");
+    assert!(matches!(
+        authority_guard.try_lock(),
+        Err(std::fs::TryLockError::WouldBlock)
+    ));
+    let coordination = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(
+            home.path()
+                .join("thread-writer-locks")
+                .join(".coordination.lock"),
+        )
+        .expect("coordination");
+    coordination
+        .try_lock()
+        .expect("coordinate recorder inspection");
+    let recorder = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(
+            home.path()
+                .join("thread-writer-locks")
+                .join(format!("{thread_id}.lock")),
+        )
+        .expect("recorder lock");
+    assert!(matches!(
+        recorder.try_lock(),
+        Err(std::fs::TryLockError::WouldBlock)
+    ));
+    drop(recorder);
+    drop(coordination);
+    live.shutdown().await.expect("writer released");
+    authority_guard
+        .try_lock()
+        .expect("authority fence released after checked shutdown");
+    drop(authority_guard);
+    registry
+        .bind(&id, thread_id, binding.authority_grant().clone())
+        .await
+        .expect("fresh idle binding")
+        .verify_writer_absent()
+        .await
+        .expect("recorder fence released after checked shutdown");
+}
