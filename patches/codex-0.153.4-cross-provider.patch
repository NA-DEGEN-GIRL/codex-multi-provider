+//! Common-list notifications observed through independent real app servers.
+
+use super::manager_record_catalog::CatalogFixture;
+use super::manager_record_catalog::READ_TIMEOUT;
+use anyhow::Context;
+use anyhow::Result;
+use app_test_support::TestAppServer;
+use codex_app_server_protocol::ThreadDeletedNotification;
+use codex_app_server_protocol::ThreadListResponse;
+use codex_app_server_protocol::ThreadLoadedListResponse;
+use codex_app_server_protocol::ThreadReadResponse;
+use codex_app_server_protocol::ThreadStartedNotification;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::fs;
+use std::path::Path;
+use std::time::Duration;
+use tempfile::TempDir;
+use tokio::time::timeout;
+use uuid::Uuid;
+
+async fn list(server: &mut TestAppServer) -> Result<ThreadListResponse> {
+    let request = server
+        .send_raw_request("thread/list", Some(json!({})))
+        .await?;
+    timeout(READ_TIMEOUT, server.read_response(request)).await?
+}
+
+async fn started(server: &mut TestAppServer) -> Result<ThreadStartedNotification> {
+    let event = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("thread/started"),
+    )
+    .await??;
+    Ok(serde_json::from_value(
+        event.params.context("notification params")?,
+    )?)
+}
+
+fn manifest(fixture: &CatalogFixture) -> Result<Value> {
+    Ok(serde_json::from_slice(&fs::read(&fixture.manifest_path)?)?)
+}
+
+fn publish(path: &Path, mut value: Value) -> Result<()> {
+    value["revision"] = json!(Uuid::new_v4().to_string());
+    fs::write(path, serde_json::to_vec(&value)?)?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn list_membership_updates_both_profiles_without_loading_execution_or_relisting() -> Result<()>
+{
+    let first_record = CatalogFixture::new()?;
+    let added = CatalogFixture::new()?;
+    let original = fs::read(&first_record.rollout_path)?;
+    let added_bytes = fs::read(&added.rollout_path)?;
+    let second_home = TempDir::new()?;
+    let mut first = first_record.start_server().await?;
+    let mut second = TestAppServer::builder()
+        .with_codex_home(second_home.path())
+        .without_managed_config()
+        .with_env_overrides(&[
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            (
+                "CODEX_MANAGER_SHARED_CATALOG",
+                first_record.manifest_path.to_str(),
+            ),
+            ("CODEX_SQLITE_HOME", None),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    for server in [&mut first, &mut second] {
+        assert_eq!(list(server).await?.data.len(), 1);
+    }
+    let original_manifest = manifest(&first_record)?;
+    let mut expanded = original_manifest.clone();
+    let mut entry = manifest(&added)?["entries"][0].clone();
+    entry["sourceStoreId"] = json!("added-source");
+    expanded["entries"]
+        .as_array_mut()
+        .context("entries")?
+        .push(entry);
+    // An incomplete atomic replacement must not remove the prior list or stop
+    // subscriptions permanently. The next valid manifest must still catch up.
+    fs::write(&first_record.manifest_path, b"{")?;
+    assert!(
+        timeout(
+            Duration::from_millis(2300),
+            first.read_stream_until_notification_message("thread/deleted")
+        )
+        .await
+        .is_err()
+    );
+    publish(&first_record.manifest_path, expanded.clone())?;
+    for server in [&mut first, &mut second] {
+        let notification = started(server).await?;
+        assert_eq!(notification.thread.id, added.projection_id);
+        assert_eq!(notification.thread.can_accept_direct_input, Some(false));
+        assert_eq!(notification.thread.path, None);
+        let request = server
+            .send_raw_request(
+                "thread/read",
+                Some(json!({
+                    "threadId":added.projection_id,"includeTurns":false
+                })),
+            )
+            .await?;
+        let read: ThreadReadResponse =
+            timeout(READ_TIMEOUT, server.read_response(request)).await??;
+        assert_eq!(notification.thread, read.thread);
+        let request = server
+            .send_raw_request("thread/loaded/list", Some(json!({})))
+            .await?;
+        let loaded: ThreadLoadedListResponse =
+            timeout(READ_TIMEOUT, server.read_response(request)).await??;
+        assert_eq!(loaded.data, Vec::<String>::new());
+        assert_eq!(list(server).await?.data.len(), 2);
+    }
+    assert!(
+        timeout(
+            Duration::from_millis(2500),
+            first.read_stream_until_notification_message("thread/started")
+        )
+        .await
+        .is_err()
+    );
+    publish(&first_record.manifest_path, original_manifest)?;
+    for server in [&mut first, &mut second] {
+        let event = timeout(
+            READ_TIMEOUT,
+            server.read_stream_until_notification_message("thread/deleted"),
+        )
+        .await??;
+        let deleted: ThreadDeletedNotification =
+            serde_json::from_value(event.params.context("params")?)?;
+        assert_eq!(
+            deleted,
+            ThreadDeletedNotification {
+                thread_id: added.projection_id.clone()
+            }
+        );
+    }
+    drop(first);
+    publish(&first_record.manifest_path, expanded)?;
+    assert_eq!(started(&mut second).await?.thread.id, added.projection_id);
+    first_record.assert_source_untouched(&original)?;
+    added.assert_source_untouched(&added_bytes)?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn shared_list_does_not_publish_a_second_projection_for_native_records() -> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let native_record = CatalogFixture::new()?;
+    let native_manifest = manifest(&native_record)?;
+    let native_home = Path::new(
+        native_manifest["entries"][0]["codexHome"]
+            .as_str()
+            .context("native home")?,
+    );
+    let mut server = TestAppServer::builder()
+        .with_codex_home(native_home)
+        .without_managed_config()
+        .with_env_overrides(&[
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            (
+                "CODEX_MANAGER_SHARED_CATALOG",
+                fixture.manifest_path.to_str(),
+            ),
+            ("CODEX_SQLITE_HOME", None),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    list(&mut server).await?;
+    let mut value = manifest(&fixture)?;
+    let projection = Uuid::new_v4().to_string();
+    value["entries"]
+        .as_array_mut()
+        .context("entries")?
+        .push(json!({
+                "projectionThreadId":projection,"threadId":native_record.thread_id,
+            "hostId":"local","sourceStoreId":"native-fixture",
+                "codexHome":native_home,"rolloutPath":native_record.rollout_path,
+        }));
+    publish(&fixture.manifest_path, value)?;
+    assert!(
+        timeout(Duration::from_secs(5), async {
+            loop {
+                if started(&mut server).await?.thread.id == projection {
+                    return Ok::<_, anyhow::Error>(());
+                }
+            }
+        })
+        .await
+        .is_err()
+    );
+    let listed = list(&mut server).await?;
+    assert_eq!(
+        listed
+            .data
+            .iter()
+            .filter(|thread| thread.id == native_record.thread_id)
+            .count(),
+        1
+    );
+    assert!(!listed.data.iter().any(|thread| thread.id == projection));
+    Ok(())
+}
+
+#[tokio::test]
+async fn list_archive_and_restore_notifications_preserve_the_canonical_file() -> Result<()> {
+    let mut fixture = CatalogFixture::new()?;
+    let mut server = fixture.start_server().await?;
+    list(&mut server).await?;
+    let mut value = manifest(&fixture)?;
+    let home = Path::new(value["entries"][0]["codexHome"].as_str().context("home")?).to_path_buf();
+    let original_path = fixture.rollout_path.clone();
+    let original = fs::read(&original_path)?;
+    let archived = home
+        .join("archived_sessions")
+        .join(original_path.file_name().context("rollout name")?);
+    fs::create_dir_all(archived.parent().context("archive parent")?)?;
+    fs::rename(&original_path, &archived)?;
+    value["entries"][0]["rolloutPath"] = json!(archived);
+    publish(&fixture.manifest_path, value.clone())?;
+    let event = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("thread/archived"),
+    )
+    .await??;
+    assert_eq!(
+        event.params,
+        Some(json!({"threadId":fixture.projection_id}))
+    );
+    fs::rename(&archived, &original_path)?;
+    value["entries"][0]["rolloutPath"] = json!(original_path);
+    publish(&fixture.manifest_path, value)?;
+    assert_eq!(started(&mut server).await?.thread.id, fixture.projection_id);
+    let event = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("thread/unarchived"),
+    )
+    .await??;
+    assert_eq!(
+        event.params,
+        Some(json!({"threadId":fixture.projection_id}))
+    );
+    fixture.rollout_path = original_path;
+    assert_eq!(fs::read(&fixture.rollout_path)?, original);
+    assert!(!home.join("state_5.sqlite").exists());
+    Ok(())
+}
+
+#[tokio::test]
+async fn unreadable_additions_do_not_starve_a_later_readable_record() -> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let added = CatalogFixture::new()?;
+    let original = fs::read(&added.rollout_path)?;
+    let mut server = fixture.start_server().await?;
+    list(&mut server).await?;
+    let mut value = manifest(&fixture)?;
+    let mut entry = manifest(&added)?["entries"][0].clone();
+    entry["sourceStoreId"] = json!("batch-source");
+    let entries = value["entries"].as_array_mut().context("entries")?;
+    for number in 1..=64 {
+        let mut unreadable = entry.clone();
+        unreadable["projectionThreadId"] = json!(Uuid::from_u128(number).to_string());
+        // A valid UUID whose claimed rollout belongs to another canonical ID.
+        unreadable["threadId"] = json!(Uuid::new_v4().to_string());
+        entries.push(unreadable);
+    }
+    let projection = Uuid::from_u128(u128::MAX).to_string();
+    entry["projectionThreadId"] = json!(projection);
+    entries.push(entry);
+    publish(&fixture.manifest_path, value)?;
+    assert_eq!(started(&mut server).await?.thread.id, projection);
+    added.assert_source_untouched(&original)?;
+    Ok(())
+}
