+    let root_id = ThreadId::from_string(&root_uuid.to_string()).expect("root id");
+    let root_path = write_rollout(
+        home.path(),
+        "2025-01-03T14-00-08",
+        root_uuid,
+        ThreadHistoryMode::Paginated,
+        /*first_ordinal*/ Some(1),
+        vec![
+            turn_started("turn-1"),
+            message("msg_u1", "user", "first question"),
+            completed_user_message("turn-1", "first question"),
+            // A provider that reuses item IDs: both answers are real.
+            message("msg_0", "assistant", "first answer"),
+            turn_complete("turn-1"),
+            turn_started("turn-2"),
+            message("msg_u2", "user", "second question"),
+            completed_user_message("turn-2", "second question"),
+            message("msg_0", "assistant", "second answer"),
+            turn_complete("turn-2"),
+        ],
+    );
+    let child_uuid = Uuid::from_u128(/*v*/ 3009);
+    let child_id = ThreadId::from_string(&child_uuid.to_string()).expect("child id");
+    let child_path = write_rollout(
+        home.path(),
+        "2025-01-03T14-00-09",
+        child_uuid,
+        ThreadHistoryMode::Paginated,
+        /*first_ordinal*/ Some(11),
+        vec![
+            turn_started("turn-3"),
+            // An exact copy of an inherited item is not repeated; a different item that reuses
+            // an inherited ID is kept.
+            message("msg_0", "assistant", "second answer"),
+            message("msg_u3", "user", "child question"),
+            completed_user_message("turn-3", "child question"),
+            message("msg_0", "assistant", "child answer"),
+            turn_complete("turn-3"),
+        ],
+    );
+    set_history_base(
+        child_path.as_path(),
+        history_position(
+            root_path.as_path(),
+            root_id,
+            /*end_ordinal_exclusive*/ 11,
+        ),
+    );
+    let store = LocalThreadStore::new(test_config(home.path()), /*state_db*/ None);
+
+    let transcript = store
+        .load_model_transcript(LoadThreadHistoryParams {
+            thread_id: child_id,
+            include_archived: false,
+        })
+        .await
+        .expect("load transcript")
+        .transcript;
+
+    assert_eq!(
+        item_shapes(&transcript),
+        vec![
+            "user first question",
+            "assistant first answer",
+            "user second question",
+            "assistant second answer",
+            "user child question",
+            "assistant child answer",
+        ]
+    );
+}
