new file mode 100644
index 000000000..ab7441c6a
--- /dev/null
+++ b/codex-rs/core/src/thread_manager/preset_auth.rs
@@ -0,0 +1,224 @@
+//! Read-only borrowing of a manager-approved account for a child runtime.
+
+use super::preset_auth_resolver::ExecutionPresetAuthResolver;
+use super::preset_auth_resolver::request_for_config;
+use super::preset_auth_resolver::resolve_credentials;
+use crate::config::Config;
+use codex_login::AuthManager;
+use codex_login::CodexAuth;
+use codex_login::ExternalAuth;
+use codex_login::ExternalAuthFuture;
+use codex_login::ExternalAuthRefreshContext;
+use codex_protocol::config_types::ForcedLoginMethod;
+use codex_protocol::protocol::SessionSource;
+use sha2::Digest;
+use sha2::Sha256;
+use std::io::Read;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+struct ManagedAccount {
+    resolver: Arc<dyn ExecutionPresetAuthResolver>,
+    request: codex_app_server_protocol::ExecutionPresetAuthTokensReadParams,
+}
+
+impl ManagedAccount {
+    async fn read(&self) -> std::io::Result<CodexAuth> {
+        let response = resolve_credentials(&self.resolver, self.request.clone()).await?;
+        CodexAuth::from_external_chatgpt_tokens(
+            &response.access_token,
+            response
+                .chatgpt_account_id
+                .as_deref()
+                .ok_or_else(|| std::io::Error::other("managed account ID is unavailable"))?,
+            None,
+        )
+        .map_err(|_| std::io::Error::other("managed account token is invalid"))
+    }
+}
+
+impl ExternalAuth for ManagedAccount {
+    fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(self.read())
+    }
+    fn refresh(&self, _context: ExternalAuthRefreshContext) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(self.read())
+    }
+}
+
+struct BorrowedAccount {
+    home: PathBuf,
+    expected_account_fingerprint: String,
+}
+
+impl BorrowedAccount {
+    fn read(&self) -> std::io::Result<CodexAuth> {
+        let fail = || {
+            std::io::Error::other(
+                "selected subagent account is unavailable or changed; renew it in its owning profile",
+            )
+        };
+        let file = self.home.join("auth.json");
+        let mut bytes = Vec::new();
+        std::fs::File::open(file)
+            .map_err(|_| fail())?
+            .take(1024 * 1024 + 1)
+            .read_to_end(&mut bytes)
+            .map_err(|_| fail())?;
+        if bytes.len() > 1024 * 1024 {
+            return Err(fail());
+        }
+        let auth: codex_login::AuthDotJson = serde_json::from_slice(&bytes).map_err(|_| fail())?;
+        let tokens = auth.tokens.ok_or_else(fail)?;
+        let account_id = tokens
+            .account_id
+            .as_deref()
+            .or(tokens.id_token.chatgpt_account_id.as_deref())
+            .ok_or_else(fail)?;
+        let mut digest = Sha256::new();
+        digest.update(b"codex-manager-account-v1\0");
+        digest.update(account_id.as_bytes());
+        if format!("{:x}", digest.finalize()) != self.expected_account_fingerprint
+            || tokens.access_token.is_empty()
+        {
+            return Err(fail());
+        }
+        CodexAuth::from_external_chatgpt_tokens(
+            &tokens.access_token,
+            account_id,
+            tokens.id_token.get_chatgpt_plan_type_raw().as_deref(),
+        )
+        .map_err(|_| fail())
+    }
+}
+
+impl ExternalAuth for BorrowedAccount {
+    fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(async { self.read() })
+    }
+
+    fn refresh(&self, _context: ExternalAuthRefreshContext) -> ExternalAuthFuture<'_, CodexAuth> {
+        // The source profile owns refresh-token rotation. A 401 only rereads its latest token.
+        Box::pin(async { self.read() })
+    }
+}
+
+pub(super) async fn child_auth_manager(
+    config: &Config,
+    source: &SessionSource,
+    inherited: Arc<AuthManager>,
+    resolver: Option<&Arc<dyn ExecutionPresetAuthResolver>>,
+) -> anyhow::Result<Arc<AuthManager>> {
+    if !matches!(source, SessionSource::SubAgent(_)) {
+        return Ok(inherited);
+    }
+    let Some(role) = config.execution_preset_role(source.get_agent_role().as_deref())? else {
+        return Ok(inherited);
+    };
+    if let Some(request) = request_for_config(config, source.get_agent_role().as_deref())? {
+        if request.kind == "claude" {
+            // The CLI task resolves its own credential immediately before creating its process.
+            return Ok(inherited);
+        }
+        anyhow::ensure!(
+            inherited.is_login_method_allowed(ForcedLoginMethod::Chatgpt),
+            "managed policy does not allow ChatGPT subagent auth"
+        );
+        let fingerprint = request
+            .expected_account_fingerprint
+            .clone()
+            .ok_or_else(|| anyhow::anyhow!("missing managed account fingerprint"))?;
+        let resolver = Arc::clone(
+            resolver.ok_or_else(|| anyhow::anyhow!("managed account transport is unavailable"))?,
+        );
+        return isolated_account_manager(
+            config,
+            &inherited,
+            fingerprint,
+            Arc::new(ManagedAccount { resolver, request }),
+        )
+        .await;
+    }
+    let Some(home) = &role.auth_codex_home else {
+        anyhow::ensure!(
+            !config.model_provider.is_openai(),
+            "OpenAI execution preset role requires a prepared account binding"
+        );
+        return Ok(inherited);
+    };
+    anyhow::ensure!(
+        config.model_provider.is_openai(),
+        "account binding is only valid for native OpenAI roles"
+    );
+    anyhow::ensure!(
+        inherited.is_login_method_allowed(ForcedLoginMethod::Chatgpt),
+        "managed policy does not allow ChatGPT subagent auth"
+    );
+    let expected_account_fingerprint =
+        role.expected_account_fingerprint.clone().ok_or_else(|| {
+            anyhow::anyhow!("subagent account identity is not prepared; prepare/reload required")
+        })?;
+    borrowed_account_manager(
+        config,
+        &inherited,
+        home.clone(),
+        expected_account_fingerprint,
+    )
+    .await
+}
+
+async fn borrowed_account_manager(
+    config: &Config,
+    inherited: &AuthManager,
+    home: PathBuf,
+    expected_account_fingerprint: String,
+) -> anyhow::Result<Arc<AuthManager>> {
+    isolated_account_manager(
+        config,
+        inherited,
+        expected_account_fingerprint.clone(),
+        Arc::new(BorrowedAccount {
+            home,
+            expected_account_fingerprint,
+        }),
+    )
+    .await
+}
+
+async fn isolated_account_manager(
+    config: &Config,
+    inherited: &AuthManager,
+    expected_account_fingerprint: String,
+    source: Arc<dyn ExternalAuth>,
+) -> anyhow::Result<Arc<AuthManager>> {
+    anyhow::ensure!(
+        expected_account_fingerprint.len() == 64
+            && expected_account_fingerprint
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit()),
+        "invalid prepared account fingerprint"
+    );
+    // External auth stores a process-local entry keyed by home. Never share the parent's key.
+    let auth_home = config
+        .codex_home
+        .join(".execution-preset-auth")
+        .join(&expected_account_fingerprint);
+    let auth = AuthManager::shared(
+        auth_home.to_path_buf(),
+        /*enable_codex_api_key_env*/ false,
+        config.cli_auth_credentials_store_mode,
+        inherited.effective_chatgpt_workspaces(),
+        Some(config.chatgpt_base_url.clone()),
+        config.auth_keyring_backend_kind(),
+        config.auth_route_config(),
+    )
+    .await;
+    auth.set_external_auth(source)
+        .await
+        .map_err(|_| anyhow::anyhow!("selected subagent account could not be loaded"))?;
+    Ok(auth)
+}
+
+#[cfg(test)]
+#[path = "preset_auth_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/thread_manager/preset_auth_resolver.rs b/codex-rs/core/src/thread_manager/preset_auth_resolver.rs
new file mode 100644
index 000000000..a45709b96
--- /dev/null
+++ b/codex-rs/core/src/thread_manager/preset_auth_resolver.rs
@@ -0,0 +1,195 @@
+//! Credentials are resolved by the host transport only from prepared account bindings.
+
+use crate::config::Config;
+use codex_app_server_protocol::ExecutionPresetAuthRefusal;
+use codex_app_server_protocol::ExecutionPresetAuthTokensReadParams;
+use codex_app_server_protocol::ExecutionPresetAuthTokensReadResponse;
+use codex_login::ExternalAuthFuture;
+use sha2::Digest;
+use sha2::Sha256;
+use std::sync::Arc;
+
+/// Supplies short-lived credentials without giving core access to another host's login store.
+pub trait ExecutionPresetAuthResolver: Send + Sync {
+    fn resolve(
+        &self,
+        request: ExecutionPresetAuthTokensReadParams,
+    ) -> ExternalAuthFuture<'_, ExecutionPresetAuthTokensReadResponse>;
+}
+
+pub(super) fn request_for_config(
+    config: &Config,
+    role_name: Option<&str>,
+) -> anyhow::Result<Option<ExecutionPresetAuthTokensReadParams>> {
+    let owner = config.execution_preset_profile_id();
+    let (profile_id, kind, fingerprint, identity) = if let Some(role_name) = role_name {
+        let Some(role) = config.execution_preset_role(Some(role_name))? else {
+            return Ok(None);
+        };
+        let Some(source) = &role.auth_source else {
+            return Ok(None);
+        };
+        anyhow::ensure!(
+            source == "manager_proxy" && role.auth_codex_home.is_none(),
+            "invalid managed execution account source"
+        );
+        (
+            role.profile_id
+                .clone()
+                .ok_or_else(|| anyhow::anyhow!("missing managed account profile"))?,
+            if config.model_provider.is_openai() {
+                "openai"
+            } else {
+                "claude"
+            },
+            role.expected_account_fingerprint.clone(),
+            role.expected_account_identity.clone(),
+        )
+    } else {
+        let Some(main) = config.execution_preset_main_auth() else {
+            return Ok(None);
+        };
+        anyhow::ensure!(
+            main.auth_source == "manager_proxy" && main.kind == "claude",
+            "invalid managed main account source"
+        );
+        (
+            main.profile_id.clone(),
+            "claude",
+            None,
+            Some(main.expected_account_identity.clone()),
+        )
+    };
+    anyhow::ensure!(
+        uuid::Uuid::parse_str(&profile_id).is_ok(),
+        "invalid managed account profile"
+    );
+    if kind == "openai" {
+        anyhow::ensure!(
+            fingerprint.as_ref().is_some_and(
+                |value| value.len() == 64 && value.bytes().all(|byte| byte.is_ascii_hexdigit())
+            ) && identity.is_none(),
+            "invalid managed account fingerprint"
+        );
+    } else {
+        anyhow::ensure!(
+            config
+                .model_provider
+                .agent
+                .as_ref()
+                .is_some_and(|agent| agent.profile_id == profile_id)
+                && identity
+                    .as_ref()
+                    .is_some_and(|value| !value.is_empty() && value.len() <= 256)
+                && fingerprint.is_none(),
+            "managed Claude account does not match the prepared provider"
+        );
+    }
+    Ok(Some(ExecutionPresetAuthTokensReadParams {
+        owner_profile_id: owner
+            .ok_or_else(|| anyhow::anyhow!("managed account owner is unavailable"))?,
+        role_id: role_name.map(str::to_string),
+        profile_id,
+        kind: kind.to_string(),
+        expected_account_fingerprint: fingerprint,
+        expected_account_identity: identity,
+        rejected_credential_id: None,
+    }))
+}
+
+/// A lowercase hyphenated UUID, exactly as the manager writes credential IDs.
+fn canonical_credential_id(value: &str) -> bool {
+    uuid::Uuid::parse_str(value).is_ok_and(|parsed| parsed.hyphenated().to_string() == value)
+}
+
+/// A Claude credential's reported source: none (an older broker), the PC's Windows login, or
+/// a saved long-lived token with its ID, never the one this request reports as rejected.
+fn valid_source(
+    request: &ExecutionPresetAuthTokensReadParams,
+    response: &ExecutionPresetAuthTokensReadResponse,
+) -> bool {
+    match (
+        response.credential_source.as_deref(),
+        response.credential_id.as_deref(),
+    ) {
+        (None, None) => true,
+        (Some("windowsLogin"), None) => request.kind == "claude",
+        (Some("longLivedToken"), Some(id)) => {
+            request.kind == "claude"
+                && canonical_credential_id(id)
+                && request.rejected_credential_id.as_deref() != Some(id)
+        }
+        _ => false,
+    }
+}
+
+pub(super) async fn resolve_credentials(
+    resolver: &Arc<dyn ExecutionPresetAuthResolver>,
+    request: ExecutionPresetAuthTokensReadParams,
+) -> std::io::Result<ExecutionPresetAuthTokensReadResponse> {
+    let fail = || std::io::Error::other("selected managed account is unavailable or changed");
+    let response = resolver.resolve(request.clone()).await.map_err(|error| {
+        // A refusal the user can act on keeps its reason; anything else stays generic.
+        match error
+            .get_ref()
+            .and_then(|inner| inner.downcast_ref::<ExecutionPresetAuthRefusal>())
+        {
+            Some(refusal) => std::io::Error::other(*refusal),
+            None => fail(),
+        }
+    })?;
+    if response.kind != request.kind
+        || response.access_token.is_empty()
+        || response.access_token.len() > 64 * 1024
+        || !valid_source(&request, &response)
+    {
+        return Err(fail());
+    }
+    if request.kind == "openai" {
+        let account_id = response.chatgpt_account_id.as_deref().ok_or_else(fail)?;
+        let mut digest = Sha256::new();
+        digest.update(b"codex-manager-account-v1\0");
+        digest.update(account_id.as_bytes());
+        if request.expected_account_fingerprint.as_deref()
+            != Some(format!("{:x}", digest.finalize()).as_str())
+        {
+            return Err(fail());
+        }
+    } else {
+        let now = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_err(|_| fail())?
+            .as_secs();
+        if response.account_identity != request.expected_account_identity
+            || !response
+                .expires_at
+                .is_some_and(|expiry| expiry > 0 && expiry as u64 > now.saturating_add(120))
+        {
+            return Err(fail());
+        }
+    }
+    Ok(response)
+}
+
+/// Resolves the account for `config`. `rejected_credential_id` reports a lent long-lived
+/// Claude credential that Claude refused, so the broker records it and lends another.
+pub(crate) async fn resolve_for_config(
+    resolver: Option<&Arc<dyn ExecutionPresetAuthResolver>>,
+    config: &Config,
+    role_name: Option<&str>,
+    rejected_credential_id: Option<&str>,
+) -> anyhow::Result<Option<ExecutionPresetAuthTokensReadResponse>> {
+    let Some(mut request) = request_for_config(config, role_name)? else {
+        return Ok(None);
+    };
+    if let Some(rejected) = rejected_credential_id {
+        anyhow::ensure!(
+            request.kind == "claude" && canonical_credential_id(rejected),
+            "invalid rejected managed credential"
+        );
+        request.rejected_credential_id = Some(rejected.to_string());
+    }
+    let resolver =
+        resolver.ok_or_else(|| anyhow::anyhow!("managed account transport is unavailable"))?;
+    Ok(Some(resolve_credentials(resolver, request).await?))
+}
