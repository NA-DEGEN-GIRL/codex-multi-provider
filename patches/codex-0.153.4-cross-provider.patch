+    )?;
+    let manifest_path = codex_home.path().join("managed-sources.json");
+    std::fs::write(
+        &manifest_path,
+        serde_json::to_vec(&json!({
+            "version": 1,
+            "hostId": "local",
+            "profileId": "00000000-0000-4000-8000-000000000001",
+            "sources": [{
+                "hostId": "local",
+                "sourceStoreId": source_id,
+                "codexHome": codex_home.path(),
+            }],
+            "bindings": [],
+        }))?,
+    )?;
+    let manifest_path = manifest_path.to_str().context("manifest path is UTF-8")?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_managed_config()
+        .with_env_overrides(&[(SOURCES_ENV, Some(manifest_path))])
+        .build_initialized()
+        .await?;
+    let thread_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    // A fresh actor is idle without depending on TurnComplete, which is emitted
+    // before the core's final turn cleanup. Durable history is covered in core.
+    let peer_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+
+    let released: ThreadManagedCloseIdleResponse = app
+        .request(|request_id| ClientRequest::ThreadManagedCloseIdle {
+            request_id,
+            params: ThreadManagedCloseIdleParams {
+                thread_id: thread_id.clone(),
+            },
