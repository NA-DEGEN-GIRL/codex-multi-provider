+    /// Closes an idle actor without discarding active or queued work.
+    ///
+    /// Unlike ordinary shutdown, success requires a successful durable flush,
+    /// writer shutdown, and actor termination. Callers must seal external request
+    /// admission before calling this method and retain ownership on any error.
+    pub async fn close_idle_and_shutdown(&self) -> CodexResult<()> {
+        let blockers = self.managed_idle_blockers().await;
+        if !blockers.is_empty() {
+            return Err(CodexErr::UnsupportedOperation(format!(
+                "cannot close idle thread: {}",
+                blockers.join(", "),
+            )));
+        }
+        let admission = self.try_reserve_idle_close()?;
+        self.close_idle_and_shutdown_reserved(admission).await
+    }
+
+    /// Reserve this actor before inventorying children. The reservation excludes
+    /// internal mail and new child activations as well as direct user input.
+    pub fn try_reserve_idle_close(&self) -> CodexResult<crate::session::IdleCloseAdmission> {
+        self.io.tx_sub.try_reserve_idle_close()
+    }
+
