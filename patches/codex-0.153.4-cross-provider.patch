@@ -0,0 +1,31 @@
+//! Exact actor cleanup for internal sessions owned by a parent registry.
+
+use super::ThreadManagerState;
+use crate::session::session::Session;
+use codex_protocol::protocol::SessionSource;
+use futures::FutureExt;
+use std::sync::Arc;
+
+impl ThreadManagerState {
+    pub(crate) async fn remove_verified_internal_actor(&self, expected: &Arc<Session>) {
+        let mut threads = self.threads.write().await;
+        let remove = threads.get(&expected.thread_id).is_some_and(|thread| {
+            Arc::ptr_eq(&thread.session, expected)
+                && matches!(&thread.session_source, SessionSource::Internal(_))
+                && expected.internal_sessions.shutdown_is_verified()
+                && thread
+                    .io
+                    .session_loop_termination
+                    .clone()
+                    .now_or_never()
+                    .is_some()
+        });
+        if remove {
+            threads.remove(&expected.thread_id);
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "internal_sessions_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/thread_manager/internal_sessions_tests.rs b/codex-rs/core/src/thread_manager/internal_sessions_tests.rs
new file mode 100644
index 000000000..20a14c63e
--- /dev/null
+++ b/codex-rs/core/src/thread_manager/internal_sessions_tests.rs
@@ -0,0 +1,67 @@
+use crate::config::test_config;
+use crate::thread_manager::StartThreadOptions;
+use crate::thread_manager::ThreadManager;
+use codex_login::CodexAuth;
+use codex_protocol::protocol::InternalSessionSource;
+use codex_protocol::protocol::SessionSource;
+use core_test_support::PathBufExt;
+use core_test_support::PathExt;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+use std::time::Duration;
+
+#[tokio::test]
+async fn managed_internal_close_removes_verified_helper_and_keeps_unrelated_actor() {
+    let temporary = tempfile::tempdir().unwrap();
+    let mut config = test_config().await;
+    config.codex_home = temporary.path().join("home").abs();
+    config.cwd = config.codex_home.abs();
+    config.ephemeral = true;
+    std::fs::create_dir_all(&config.codex_home).unwrap();
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+    );
+    let parent = manager
+        .start_thread(StartThreadOptions::new(config.clone()))
+        .await
+        .unwrap();
+    let unrelated = manager
+        .start_thread(StartThreadOptions::new(config.clone()))
+        .await
+        .unwrap();
+    let child = manager
+        .spawn_internal_session(
+            parent.thread_id,
+            StartThreadOptions {
+                session_source: Some(SessionSource::Internal(InternalSessionSource::Guardian)),
+                ..StartThreadOptions::new(config)
+            },
+        )
+        .await
+        .unwrap();
+    assert_eq!(manager.list_thread_ids().await.len(), 2);
+    assert!(
+        manager.get_thread(child.thread_id).await.is_err(),
+        "internal helpers stay outside public task lookup"
+    );
+    tokio::time::timeout(
+        Duration::from_secs(10),
+        parent.thread.close_idle_and_shutdown(),
+    )
+    .await
+    .expect("parent close timed out")
+    .unwrap();
+    child.thread.wait_until_terminated().await;
+    let mut actual = manager.list_thread_ids().await;
+    actual.sort_by_key(ToString::to_string);
+    let mut expected = vec![parent.thread_id, unrelated.thread_id];
+    expected.sort_by_key(ToString::to_string);
+    assert_eq!(actual, expected);
+    assert!(unrelated.thread.is_running());
+    manager
+        .shutdown_all_threads_bounded(Duration::from_secs(10))
+        .await;
+}
