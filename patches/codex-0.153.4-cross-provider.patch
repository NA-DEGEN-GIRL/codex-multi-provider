+use codex_thread_store::ManagedSourceId;
+use codex_thread_store::ManagedSourceRegistration;
+use codex_thread_store::ManagedSourceRegistry;
+use codex_thread_store::PersistContext;
+use codex_thread_store::ThreadPersistenceMetadata;
+use codex_thread_store::ThreadStore;
+use pretty_assertions::assert_eq;
+
+use super::*;
+
+struct SourceFixture {
+    _home: TempDir,
+    binding: ManagedThreadBinding,
+    source: Arc<codex_state::StateRuntime>,
+    profile: Arc<codex_state::StateRuntime>,
+    harness: GoalExtensionHarness,
+}
+
+impl SourceFixture {
+    async fn new() -> anyhow::Result<Self> {
+        let home = TempDir::new()?;
+        let root = std::fs::canonicalize(home.path())?;
+        let profile_id = ThreadId::new().to_string();
+        let source_id = ManagedSourceId {
+            host_id: "goal-test-host".to_string(),
+            store_id: format!("manager:{profile_id}"),
+        };
+        std::fs::write(
+            root.join("managed-source.json"),
+            serde_json::to_vec(&source_id)?,
+        )?;
+        let registry = ManagedSourceRegistry::new(
+            source_id.host_id.clone(),
+            profile_id,
+            vec![ManagedSourceRegistration {
+                source_id: source_id.clone(),
+                config: LocalThreadStoreConfig {
+                    codex_home: root.clone(),
+                    sqlite: codex_state::SqliteConfig::new_for_testing(root.abs()),
+                    default_model_provider_id: "source-provider".to_string(),
+                },
+            }],
+        )?;
+        let thread_id = test_thread_id()?;
+        let binding = registry.bind_new(&source_id, thread_id).await?;
+        let reservation = binding.prepare_writer().await?;
+        let store = binding.store();
+        store
+            .create_thread(CreateThreadParams {
+                session_id: thread_id.into(),
+                thread_id,
+                extra_config: None,
+                forked_from_id: None,
+                parent_thread_id: None,
+                source: SessionSource::Cli,
+                thread_source: None,
+                originator: "goal-source-test".to_string(),
+                base_instructions: BaseInstructions::default(),
+                dynamic_tools: Vec::new(),
+                selected_capability_roots: Vec::new(),
+                multi_agent_version: None,
+                history_mode: ThreadHistoryMode::Legacy,
+                history_base: None,
+                subagent_history_start_ordinal: None,
+                initial_window_id: ThreadId::new().to_string(),
+                metadata: ThreadPersistenceMetadata {
+                    cwd: Some(root),
+                    model_provider: "source-provider".to_string(),
+                    memory_mode: ThreadMemoryMode::Disabled,
+                },
+            })
+            .await?;
+        drop(reservation);
+        store
+            .persist_thread(thread_id, PersistContext::Standard)
+            .await?;
+        let source = store.state_db().await.expect("source state database");
+        let profile = test_runtime().await?;
+        seed_thread_metadata(profile.as_ref(), thread_id).await?;
+        profile
+            .thread_goals()
+            .insert_thread_goal(
+                thread_id,
+                "unrelated profile goal with the same thread UUID",
+                codex_state::ThreadGoalStatus::Paused,
+                /*token_budget*/ None,
+            )
+            .await?;
+        let thread_store = ExtensionData::new(thread_id.to_string());
+        thread_store.insert(binding.clone());
+        let harness =
+            GoalExtensionHarness::with_thread_store(profile.clone(), thread_store).await?;
+        Ok(Self {
+            _home: home,
+            binding,
+            source,
+            profile,
+            harness,
+        })
+    }
+}
+
+#[tokio::test]
+async fn tools_resume_and_turn_accounting_use_the_bound_source() -> anyhow::Result<()> {
+    let fixture = SourceFixture::new().await?;
+    let thread_id = fixture.binding.thread_id();
+    let profile_before = fixture
+        .profile
+        .thread_goals()
+        .get_thread_goal(thread_id)
+        .await?;
+    let tools = fixture.harness.tools();
+    tool_by_name(&tools, "create_goal")
+        .handle(tool_call(
+            "create_goal",
+            "create-source-goal",
+            json!({ "objective": "canonical source goal", "token_budget": 200 }),
+        ))
+        .await?;
+    fixture.harness.resume_thread().await;
+    fixture
+        .harness
+        .start_turn("turn-1", &TokenUsage::default())
+        .await;
+    fixture
+        .harness
+        .record_token_usage(
+            "turn-1",
+            &TokenUsage {
+                total_tokens: 40,
+                input_tokens: 40,
+                ..Default::default()
+            },
+        )
+        .await;
+    fixture.harness.stop_turn("turn-1").await;
+
+    let call = tool_call("get_goal", "get-source-goal", json!({}));
+    let output = tool_by_name(&tools, "get_goal")
+        .handle(call.clone())
+        .await?;
+    let goal = output.code_mode_result(&call.payload);
+    assert_eq!(
+        (
+            goal["goal"]["objective"].clone(),
+            goal["goal"]["tokensUsed"].clone()
+        ),
+        (json!("canonical source goal"), json!(40)),
+    );
+    assert_eq!(
+        fixture
+            .profile
+            .thread_goals()
+            .get_thread_goal(thread_id)
+            .await?,
+        profile_before,
+    );
+    fixture.binding.store().shutdown_thread(thread_id).await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn external_goal_service_uses_runtime_source_even_with_profile_database() -> anyhow::Result<()>
+{
+    let fixture = SourceFixture::new().await?;
+    let thread_id = fixture.binding.thread_id();
+    let profile_before = fixture
+        .profile
+        .thread_goals()
+        .get_thread_goal(thread_id)
+        .await?;
+    let service = &fixture.harness.goal_service;
+    let outcome = service
+        .set_thread_goal(
+            fixture.profile.as_ref(),
+            GoalSetRequest {
+                thread_id,
+                objective: GoalObjectiveUpdate::Set("external source goal"),
+                status: Some(ThreadGoalStatus::Paused),
+                token_budget: GoalTokenBudgetUpdate::Keep,
+                max_goal_token_budget: None,
+            },
+        )
+        .await?;
+    assert_eq!(
+        service
+            .get_thread_goal(fixture.profile.as_ref(), thread_id)
+            .await?,
+        Some(outcome.goal),
+    );
+    assert!(
+        fixture
+            .source
+            .thread_goals()
+            .get_thread_goal(thread_id)
+            .await?
+            .is_some()
+    );
+    assert!(
+        service
+            .clear_thread_goal(fixture.profile.as_ref(), thread_id)
+            .await?
+    );
+    assert_eq!(
+        fixture
+            .source
+            .thread_goals()
+            .get_thread_goal(thread_id)
+            .await?,
+        None
+    );
+    assert_eq!(
+        fixture
+            .profile
+            .thread_goals()
+            .get_thread_goal(thread_id)
+            .await?,
+        profile_before
+    );
+    fixture.binding.store().shutdown_thread(thread_id).await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn successful_source_close_rejects_retained_goal_writers() -> anyhow::Result<()> {
+    let fixture = SourceFixture::new().await?;
+    let thread_id = fixture.binding.thread_id();
+    let tools = fixture.harness.tools();
+    fixture
+        .harness
+        .start_turn("turn-1", &TokenUsage::default())
+        .await;
+    tool_by_name(&tools, "create_goal")
+        .handle(tool_call(
+            "create_goal",
+            "create-before-close",
+            json!({ "objective": "preserve this goal after release" }),
+        ))
+        .await?;
+    let source_before = fixture
+        .source
+        .thread_goals()
+        .get_thread_goal(thread_id)
+        .await?;
+    let visible_before = fixture
+        .harness
+        .goal_service
+        .get_thread_goal(fixture.profile.as_ref(), thread_id)
+        .await?;
+    let profile_before = fixture
+        .profile
+        .thread_goals()
+        .get_thread_goal(thread_id)
+        .await?;
+    fixture.binding.store().shutdown_thread(thread_id).await?;
+
+    for (name, arguments) in [
+        ("create_goal", json!({ "objective": "stale create" })),
+        ("update_goal", json!({ "status": "complete" })),
+    ] {
+        assert!(
+            tool_by_name(&tools, name)
+                .handle(tool_call(name, "stale-tool", arguments))
+                .await
+                .is_err()
+        );
+    }
+    fixture
+        .harness
+        .record_token_usage(
+            "turn-1",
+            &TokenUsage {
+                total_tokens: 50,
+                input_tokens: 50,
+                ..Default::default()
+            },
+        )
+        .await;
+    assert!(
+        fixture
+            .harness
+            .runtime_handle()
+            .usage_limit_active_goal_for_turn("turn-1")
+            .await
+            .is_err()
+    );
+    fixture.harness.stop_turn("turn-1").await;
+    assert!(
+        fixture
+            .harness
+            .goal_service
+            .set_thread_goal(
+                fixture.profile.as_ref(),
+                GoalSetRequest {
+                    thread_id,
+                    objective: GoalObjectiveUpdate::Set("stale service update"),
+                    status: None,
+                    token_budget: GoalTokenBudgetUpdate::Keep,
+                    max_goal_token_budget: None,
+                },
+            )
+            .await
+            .is_err()
+    );
+    assert!(
+        fixture
+            .harness
+            .goal_service
+            .clear_thread_goal(fixture.profile.as_ref(), thread_id)
+            .await
+            .is_err()
+    );
+    fixture.harness.stop_thread().await;
+    assert!(
+        fixture
+            .harness
+            .goal_service
+            .set_thread_goal(
+                fixture.profile.as_ref(),
+                GoalSetRequest {
+                    thread_id,
+                    objective: GoalObjectiveUpdate::Set("late request after unregister"),
+                    status: None,
+                    token_budget: GoalTokenBudgetUpdate::Keep,
+                    max_goal_token_budget: None,
+                },
+            )
+            .await
+            .is_err()
+    );
+    assert!(
+        fixture
+            .harness
+            .goal_service
+            .clear_thread_goal(fixture.profile.as_ref(), thread_id)
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        fixture
+            .harness
+            .goal_service
+            .get_thread_goal(fixture.profile.as_ref(), thread_id)
+            .await?,
+        visible_before,
+    );
+    assert_eq!(
+        fixture
+            .source
+            .thread_goals()
+            .get_thread_goal(thread_id)
+            .await?,
+        source_before
+    );
+    assert_eq!(
+        fixture
+            .profile
+            .thread_goals()
+            .get_thread_goal(thread_id)
+            .await?,
+        profile_before
+    );
+    Ok(())
+}
