+fn v7_uuid(unix_seconds: i64) -> Uuid {
+    Uuid::new_v7(uuid::Timestamp::from_unix(
+        uuid::NoContext,
+        u64::try_from(unix_seconds).expect("positive timestamp"),
+        /*subsec_nanos*/ 0,
+    ))
+}
