new file mode 100644
index 000000000..d7b3645b8
--- /dev/null
+++ b/codex-rs/core/src/session/submission_admission.rs
@@ -0,0 +1,162 @@
+//! Shared admission for model input, internal mail, and child activations.
+
+use async_channel::Sender;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::Op;
+use codex_protocol::protocol::Submission;
+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use tokio::sync::OwnedRwLockReadGuard;
+use tokio::sync::OwnedRwLockWriteGuard;
+use tokio::sync::RwLock;
+use tokio::sync::oneshot;
+
+#[derive(Clone)]
+pub(crate) struct SubmissionSender {
+    sender: Sender<Submission>,
+    gate: Arc<RwLock<bool>>,
+    activities: Arc<AtomicUsize>,
+}
+
+/// An exclusive reservation for one actor's idle close. Dropping it before
+/// submitting close has no persistent effect; Core owns it once submitted.
+pub struct IdleCloseAdmission {
+    gate: Arc<RwLock<bool>>,
+    guard: OwnedRwLockWriteGuard<bool>,
+}
+
+pub(crate) struct SubmissionActivityPermit {
+    _guard: OwnedRwLockReadGuard<bool>,
+    activities: Arc<AtomicUsize>,
+}
+
+/// Admission without owning a submission channel sender, so a Session can
+/// protect internal work without keeping its own input channel alive.
+#[derive(Clone, Default)]
+pub(crate) struct SubmissionActivitySource {
+    gate: Arc<RwLock<bool>>,
+    activities: Arc<AtomicUsize>,
+}
+
+impl SubmissionActivitySource {
+    pub(crate) fn try_admit(&self) -> CodexResult<SubmissionActivityPermit> {
+        let guard = Arc::clone(&self.gate).try_read_owned().map_err(|_| {
+            CodexErr::UnsupportedOperation("thread submissions are reserved for idle close".into())
+        })?;
+        if *guard {
+            return Err(CodexErr::InternalAgentDied);
+        }
+        self.activities.fetch_add(1, Ordering::AcqRel);
+        Ok(SubmissionActivityPermit {
+            _guard: guard,
+            activities: Arc::clone(&self.activities),
+        })
+    }
+}
+
+impl Drop for SubmissionActivityPermit {
+    fn drop(&mut self) {
+        self.activities.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+
+impl From<Sender<Submission>> for SubmissionSender {
+    fn from(sender: Sender<Submission>) -> Self {
+        Self {
+            sender,
+            gate: Arc::new(RwLock::new(false)),
+            activities: Arc::new(AtomicUsize::new(0)),
+        }
+    }
+}
+
+impl SubmissionSender {
+    pub(crate) fn activity_source(&self) -> SubmissionActivitySource {
+        SubmissionActivitySource {
+            gate: Arc::clone(&self.gate),
+            activities: Arc::clone(&self.activities),
+        }
+    }
+
+    pub(crate) fn try_admit(&self) -> CodexResult<SubmissionActivityPermit> {
+        self.activity_source().try_admit()
+    }
+
+    pub(crate) async fn send(&self, submission: Submission) -> CodexResult<()> {
+        let _admission = self.try_admit()?;
+        self.sender
+            .send(submission)
+            .await
+            .map_err(|_| CodexErr::InternalAgentDied)
+    }
+
+    pub(crate) fn try_reserve_idle_close(&self) -> CodexResult<IdleCloseAdmission> {
+        let guard = Arc::clone(&self.gate).try_write_owned().map_err(|_| {
+            CodexErr::UnsupportedOperation(
+                "cannot close idle thread: a submission or child activation is in flight".into(),
+            )
+        })?;
+        if *guard || self.sender.is_closed() {
+            return Err(CodexErr::InternalAgentDied);
+        }
+        if !self.sender.is_empty() {
+            return Err(CodexErr::UnsupportedOperation(
+                "cannot close idle thread: accepted submissions are pending".into(),
+            ));
+        }
+        Ok(IdleCloseAdmission {
+            gate: Arc::clone(&self.gate),
+            guard,
+        })
+    }
+
+    pub(crate) fn request_idle_shutdown(
+        &self,
+        admission: IdleCloseAdmission,
+        reply: oneshot::Sender<CodexResult<()>>,
+    ) -> CodexResult<()> {
+        if !self.idle_close_reservation_matches(&admission) {
+            return Err(CodexErr::UnsupportedOperation(
+                "idle close reservation belongs to another actor".into(),
+            ));
+        }
+        self.sender
+            .try_send(Submission {
+                id: super::new_submission_id(),
+                op: Op::CloseIdleAndShutdown {
+                    reply,
+                    admission: admission.guard,
+                },
+                trace: codex_otel::current_span_w3c_trace_context(),
+                parent_turn_id: None,
+                root_turn_id: None,
+            })
+            .map_err(|_| CodexErr::InternalAgentDied)
+    }
+
+    pub(crate) fn idle_close_reservation_matches(&self, admission: &IdleCloseAdmission) -> bool {
+        Arc::ptr_eq(&self.gate, &admission.gate) && !*admission.guard
+    }
+
+    pub(crate) fn is_closed(&self) -> bool {
+        self.sender.is_closed()
+    }
+
+    pub(crate) fn pending_count(&self) -> usize {
+        self.sender.len()
+    }
+
+    pub(crate) fn active_admissions(&self) -> usize {
+        self.activities.load(Ordering::Acquire)
+    }
+
+    pub(crate) fn is_sealed(&self) -> bool {
+        self.gate.try_read().map_or(true, |guard| *guard)
+    }
+}
+
