+    let reviewer_path = reviewer
+        .metadata
+        .agent_path
+        .clone()
+        .expect("reviewer agent path");
+    assert_eq!(
+        child_path,
+        AgentPath::root().join("worker").expect("worker path")
+    );
+    assert_eq!(
+        reviewer_path,
+        child_path.join("reviewer").expect("reviewer path")
+    );
+    persist_thread_for_tree_resume(&root, "canonical root history").await;
+    persist_thread_for_tree_resume(&child_thread, "canonical worker history").await;
+    persist_thread_for_tree_resume(&reviewer_thread, "canonical reviewer history").await;
+    wait_for_live_thread_spawn_children(&source_control, root_id, &[child.thread_id]).await;
+    wait_for_live_thread_spawn_children(&source_control, child.thread_id, &[reviewer.thread_id])
+        .await;
+    let child_rollout = child_thread.rollout_path().expect("source child rollout");
+    stop_all_managed_test_threads(&source.manager).await;
+
+    let target = managed_v2_harness().await;
+    assert_ne!(source.config.codex_home, target.config.codex_home);
+    for thread_id in [root_id, child.thread_id, reviewer.thread_id] {
+        assert!(
+            source
+                .manager
+                .managed_record_binding(thread_id)
+                .await
+                .expect("source authority")
+                .is_released()
+        );
+    }
+    let binding = transfer_canonical_tree(
+        &source_binding,
+        &[root_id, child.thread_id, reviewer.thread_id],
+    )
+    .await;
+    let source_id = binding.source_id().clone();
+    let history = canonical_history(&binding).await;
+    let target_graph = LocalAgentGraphStore::new(target.state_db.clone().expect("target SQLite"));
+    // Same UUID in the target database must not substitute for the source record.
+    let target_only_child = ThreadId::new();
+    target_graph
+        .upsert_thread_spawn_edge(root_id, target_only_child, ThreadSpawnEdgeStatus::Open)
+        .await
+        .expect("target graph collision");
+    let resumed = target
+        .manager
+        .resume_thread_with_history_and_managed_record_binding(
+            target.config.clone(),
+            history,
+            target.manager.auth_manager(),
+            None,
+            Default::default(),
+            Some(binding),
+        )
+        .await
+        .expect("resume canonical V2 root under target profile");
+    assert_eq!(resumed.thread_id, root_id);
+    assert_eq!(
+        resumed.thread.session.codex_home().await,
+        target.config.codex_home
+    );
+    let restored_control = resumed.thread.session.services.agent_control.clone();
+
+    // Metadata restoration happens during root resume, without opening child runtimes.
+    assert_eq!(
+        restored_control.state.agent_id_for_path(&child_path),
+        Some(child.thread_id)
+    );
+    assert_eq!(
+        restored_control.state.agent_id_for_path(&reviewer_path),
+        Some(reviewer.thread_id)
+    );
+    assert!(restored_control.ensure_agent_known(child.thread_id).is_ok());
+    assert!(
+        restored_control
+            .ensure_agent_known(reviewer.thread_id)
+            .is_ok()
+    );
+    assert!(
+        restored_control
+            .ensure_agent_known(target_only_child)
+            .is_err()
+    );
+    assert_thread_not_loaded(&target.manager, child.thread_id).await;
+    assert_thread_not_loaded(&target.manager, reviewer.thread_id).await;
+    for thread_id in [root_id, child.thread_id, reviewer.thread_id] {
+        let restored_binding = target
+            .manager
+            .managed_record_binding(thread_id)
