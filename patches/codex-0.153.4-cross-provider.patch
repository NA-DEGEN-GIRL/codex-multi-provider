+/// A metadata reader with no write, migration, initialization, or repair API.
+/// Each operation observes committed source data afresh; the source database is not copied.
+pub struct ReadOnlyThreadState {
+    pool: sqlx::SqlitePool,
+}
+
+impl ReadOnlyThreadState {
+    /// Read the persisted memory policy without constructing a writable state runtime.
+    pub async fn thread_memory_mode(&self, id: codex_protocol::ThreadId) -> Result<String> {
+        Ok(
+            sqlx::query_scalar(
+                "SELECT COALESCE(memory_mode, 'disabled') FROM threads WHERE id = ?",
+            )
+            .bind(id.to_string())
+            .fetch_one(&self.pool)
+            .await?,
+        )
+    }
+
+    pub async fn open(sqlite: &SqliteConfig) -> Result<Self> {
+        let pool = sqlite
+            .open_read_only_pool(&sqlite.state_db_path(), None)
+            .await?;
+        Ok(Self { pool })
+    }
+
+    pub async fn get_thread(
+        &self,
+        id: codex_protocol::ThreadId,
+    ) -> Result<Option<crate::ThreadMetadata>> {
+        let mut query = crate::audit_schema::metadata_query(&self.pool).await?;
+        crate::runtime::threads::push_thread_select_columns(&mut query);
+        query
+            .push(" FROM threads WHERE threads.id = ")
+            .push_bind(id.to_string());
+        query
+            .build()
+            .fetch_optional(&self.pool)
+            .await?
+            .map(|row| {
+                crate::model::ThreadRow::try_from_row(&row)
+                    .and_then(crate::ThreadMetadata::try_from)
+            })
+            .transpose()
+    }
+
+    pub async fn list_threads(&self) -> Result<Vec<crate::ThreadMetadata>> {
+        let mut query = crate::audit_schema::metadata_query(&self.pool).await?;
+        crate::runtime::threads::push_thread_select_columns(&mut query);
+        query.push(" FROM threads ORDER BY threads.id");
+        query
+            .build()
+            .fetch_all(&self.pool)
+            .await?
+            .into_iter()
+            .map(|row| {
+                crate::model::ThreadRow::try_from_row(&row)
+                    .and_then(crate::ThreadMetadata::try_from)
+            })
+            .collect()
+    }
+
+    /// Inventory canonical records, including archived and empty-preview rows.
+    /// Unlike a sidebar listing, this must retain V2 children needed by history links.
+    /// The caller supplies a bounded page size and resumes after the last returned ID.
+    pub async fn list_metadata_page(
+        &self,
+        after_id: Option<codex_protocol::ThreadId>,
+        page_size: usize,
+    ) -> Result<Vec<crate::ThreadMetadata>> {
+        anyhow::ensure!(page_size > 0, "metadata inventory page must not be empty");
+        let limit = i64::try_from(page_size).context("metadata page size is too large")?;
+        let mut query = crate::audit_schema::metadata_query(&self.pool).await?;
+        crate::runtime::threads::push_thread_select_columns(&mut query);
+        query.push(" FROM threads");
+        if let Some(after_id) = after_id {
+            query
+                .push(" WHERE threads.id > ")
+                .push_bind(after_id.to_string());
+        }
+        query.push(" ORDER BY threads.id LIMIT ").push_bind(limit);
+        query
+            .build()
+            .fetch_all(&self.pool)
+            .await?
+            .into_iter()
+            .map(|row| {
+                crate::model::ThreadRow::try_from_row(&row)
+                    .and_then(crate::ThreadMetadata::try_from)
+            })
+            .collect()
+    }
+
+    /// List persisted metadata using the same filters and cursors as the writable state reader.
+    /// This never scans rollouts, repairs metadata, or initializes missing source state.
+    pub async fn list_threads_page(
+        &self,
+        page_size: usize,
+        filters: crate::ThreadFilterOptions<'_>,
+        relation_filter: Option<crate::ThreadRelationFilter>,
+    ) -> Result<crate::ThreadsPage> {
+        let mut query = crate::audit_schema::metadata_query(&self.pool).await?;
+        crate::runtime::threads::push_list_threads_query(
+            &mut query,
+            filters,
+            relation_filter,
+            page_size.saturating_add(1),
+        );
+        let rows = query.build().fetch_all(&self.pool).await?;
+        let mut items = Vec::with_capacity(rows.len());
+        let mut parent_thread_ids = std::collections::HashMap::new();
+        for row in rows {
+            let item = crate::model::ThreadRow::try_from_row(&row)
+                .and_then(crate::ThreadMetadata::try_from)?;
+            if relation_filter.is_some()
+                && let Some(parent_thread_id) =
+                    row.try_get::<Option<String>, _>("parent_thread_id")?
+            {
+                parent_thread_ids.insert(
+                    item.id,
+                    codex_protocol::ThreadId::try_from(parent_thread_id)?,
+                );
+            }
+            items.push(item);
+        }
+        let num_scanned_rows = items.len();
+        let next_anchor = if items.len() > page_size {
+            if let Some(overflow_item) = items.pop() {
+                parent_thread_ids.remove(&overflow_item.id);
+            }
+            items.last().and_then(|item| {
+                crate::model::anchor_from_item(item, filters.sort_key, relation_filter.is_some())
+            })
+        } else {
+            None
+        };
+        Ok(crate::ThreadsPage {
+            items,
+            parent_thread_ids,
+            next_anchor,
+            num_scanned_rows,
+        })
+    }
+
+    /// Check the persisted project catalog without creating or repairing it.
+    pub async fn project_exists(&self, project_id: &str) -> Result<bool> {
+        let supports_projects: i64 = sqlx::query_scalar(
+            "SELECT EXISTS(SELECT 1 FROM pragma_table_info('threads') WHERE name = 'project_id')",
+        )
+        .fetch_one(&self.pool)
+        .await?;
+        if supports_projects == 0 {
+            return Ok(false);
+        }
+        let exists =
+            sqlx::query_scalar::<_, i64>("SELECT EXISTS(SELECT 1 FROM projects WHERE id = ?)")
+                .bind(project_id)
+                .fetch_one(&self.pool)
+                .await?;
+        Ok(exists != 0)
+    }
+
+    /// Read every persisted descendant, including closed edges, without opening writable state.
+    /// Distinct recursive nodes and a traversal cap keep corrupt cycles or huge graphs bounded.
+    pub async fn list_thread_spawn_descendants(
+        &self,
+        root_thread_id: codex_protocol::ThreadId,
+        limit: usize,
+    ) -> Result<Vec<codex_protocol::ThreadId>> {
+        let query_limit = i64::try_from(limit)
+            .ok()
+            .and_then(|limit| limit.checked_add(1))
+            .context("managed descendant query limit is too large")?;
+        let rows = sqlx::query(
+            r#"
+WITH RECURSIVE subtree(child_thread_id) AS (
+    SELECT child_thread_id
+    FROM thread_spawn_edges
+    WHERE parent_thread_id = ?
+    UNION
+    SELECT edge.child_thread_id
+    FROM thread_spawn_edges AS edge
+    JOIN subtree ON edge.parent_thread_id = subtree.child_thread_id
+    LIMIT ?
+)
+SELECT child_thread_id
+FROM subtree
+ORDER BY child_thread_id
+            "#,
+        )
+        .bind(root_thread_id.to_string())
+        .bind(query_limit)
+        .fetch_all(&self.pool)
+        .await?;
+        anyhow::ensure!(
+            rows.len() <= limit,
+            "canonical descendant graph exceeds its query limit"
+        );
+        rows.into_iter()
+            .map(|row| {
+                codex_protocol::ThreadId::try_from(row.try_get::<String, _>("child_thread_id")?)
+                    .map_err(Into::into)
+            })
+            .collect()
+    }
+
+    pub async fn close(&self) {
+        self.pool.close().await;
+    }
+}
