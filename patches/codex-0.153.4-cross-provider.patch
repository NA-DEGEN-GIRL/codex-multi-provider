+#[tokio::test]
+async fn empty_source_and_identity_failure_do_not_initialize_or_overwrite_foreign_state()
+-> Result<()> {
+    let api = responses::start_mock_server().await;
+    let source = ManagedProfile::new(&api.uri(), "source-model", "source-token")?;
+    let viewer = ManagedProfile::new(&api.uri(), "viewer-model", "viewer-token")?;
+    viewer.write_manifest(&[&viewer], Vec::new())?;
+    let catalog = viewer.home.path().join("source-catalog.json");
+    publish(&catalog, &[&source, &viewer])?;
+    let mut reader = start_shared(&viewer, &catalog).await?;
+    assert!(list(&mut reader).await?.data.is_empty());
+    let foreign_sqlite = SqliteConfig::from_sqlite_home(source.home.path().abs());
+    assert!(!foreign_sqlite.state_db_path().exists());
+    let marker = source.home.path().join("managed-source.json");
+    let original = fs::read(&marker)?;
+    fs::write(&marker, br#"{"host_id":"local","store_id":"changed"}"#)?;
+    // Changing the manifest bytes invalidates discovery's short cache.
+    publish(&catalog, &[&viewer, &source])?;
+    let request = reader
+        .send_raw_request("thread/list", Some(json!({})))
+        .await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    assert!(error.error.message.contains("marker identity changed"));
+    let request = reader
+        .send_raw_request("configRequirements/read", None)
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert!(!foreign_sqlite.state_db_path().exists());
+    assert_eq!(
+        fs::read(&marker)?,
+        br#"{"host_id":"local","store_id":"changed"}"#
+    );
+    fs::write(&marker, original)?;
+    publish(&catalog, &[&source, &viewer])?;
+    assert!(list(&mut reader).await?.data.is_empty());
+    assert!(
+        api.received_requests()
+            .await
+            .context("requests")?
+            .iter()
+            .all(|request| !request.url.path().ends_with("/responses"))
+    );
+    Ok(())
+}
