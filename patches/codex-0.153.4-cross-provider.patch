+//! Canonical graph routing is persistence-only: credentials, roles, and models remain target-owned.
+use super::*;
+use codex_agent_graph_store::AgentGraphStoreError;
+use codex_agent_graph_store::AgentGraphStoreFuture;
+use codex_agent_graph_store::ThreadSpawnEdgeStatus;
+
+struct ManagedAgentGraphStore {
+    binding: ManagedThreadBinding,
+    inner: LocalAgentGraphStore,
+}
+
+impl ManagedAgentGraphStore {
+    fn require_child(&self, child_thread_id: ThreadId) -> Result<(), AgentGraphStoreError> {
+        if child_thread_id != self.binding.thread_id() {
+            return Err(AgentGraphStoreError::InvalidRequest {
+                message: "managed graph mutation is outside its canonical thread binding"
+                    .to_string(),
+            });
+        }
+        Ok(())
+    }
+}
+
+impl AgentGraphStore for ManagedAgentGraphStore {
+    fn upsert_thread_spawn_edge(
+        &self,
+        parent_thread_id: ThreadId,
+        child_thread_id: ThreadId,
+        status: ThreadSpawnEdgeStatus,
+    ) -> AgentGraphStoreFuture<'_, ()> {
+        Box::pin(async move {
+            self.require_child(child_thread_id)?;
+            let _permit = self
+                .binding
+                .live_write_permit()
+                .await
+                .map_err(graph_binding_error)?;
+            self.inner
+                .upsert_thread_spawn_edge(parent_thread_id, child_thread_id, status)
+                .await
+        })
+    }
+
+    fn set_thread_spawn_edge_status(
+        &self,
+        child_thread_id: ThreadId,
+        status: ThreadSpawnEdgeStatus,
+    ) -> AgentGraphStoreFuture<'_, ()> {
+        Box::pin(async move {
+            self.require_child(child_thread_id)?;
+            let _permit = self
+                .binding
+                .live_write_permit()
+                .await
+                .map_err(graph_binding_error)?;
+            self.inner
+                .set_thread_spawn_edge_status(child_thread_id, status)
+                .await
+        })
+    }
+
+    fn list_thread_spawn_children(
+        &self,
+        parent_thread_id: ThreadId,
+        status_filter: Option<ThreadSpawnEdgeStatus>,
+    ) -> AgentGraphStoreFuture<'_, Vec<ThreadId>> {
+        self.inner
+            .list_thread_spawn_children(parent_thread_id, status_filter)
+    }
+
+    fn list_thread_spawn_descendants(
+        &self,
+        root_thread_id: ThreadId,
+        status_filter: Option<ThreadSpawnEdgeStatus>,
+    ) -> AgentGraphStoreFuture<'_, Vec<ThreadId>> {
+        self.inner
+            .list_thread_spawn_descendants(root_thread_id, status_filter)
+    }
+}
+
+fn graph_binding_error(error: codex_thread_store::ThreadStoreError) -> AgentGraphStoreError {
+    AgentGraphStoreError::InvalidRequest {
+        message: error.to_string(),
+    }
+}
+
+impl ThreadManagerState {
+    /// Managed records must never fall back to the target account's graph database.
+    pub(crate) async fn agent_graph_store_for_thread(
+        &self,
+        thread_id: ThreadId,
+    ) -> CodexResult<Option<Arc<dyn AgentGraphStore>>> {
+        let binding = self
+            .managed_record_bindings
+            .read()
+            .await
+            .get(&thread_id)
+            .cloned();
+        let Some(binding) = binding else {
+            return Ok(self.agent_graph_store.clone());
+        };
+        let source_state = binding.store().state_db().await.ok_or_else(|| {
+            CodexErr::InvalidRequest(
+                "managed source has no canonical agent graph database".to_string(),
+            )
+        })?;
+        Ok(Some(Arc::new(ManagedAgentGraphStore {
+            binding,
+            inner: LocalAgentGraphStore::new(source_state),
+        })))
+    }
+
+    pub(crate) async fn has_managed_record_binding(&self, thread_id: ThreadId) -> bool {
+        self.managed_record_bindings
+            .read()
+            .await
+            .contains_key(&thread_id)
+    }
+
+    pub(crate) async fn managed_record_binding_for_thread(
+        &self,
+        thread_id: ThreadId,
+    ) -> Option<ManagedThreadBinding> {
+        self.managed_record_bindings
+            .read()
+            .await
+            .get(&thread_id)
+            .cloned()
+    }
+
+    /// Restored V2 identities are dormant; bind their reads before any metadata or context lookup.
+    /// Creating this binding neither starts the child nor claims its rollout writer.
+    pub(crate) async fn inherit_managed_agent_graph_binding(
+        &self,
+        root_thread_id: ThreadId,
+        descendant_thread_id: ThreadId,
+    ) -> CodexResult<()> {
+        let source = self
+            .managed_record_bindings
+            .read()
+            .await
+            .get(&root_thread_id)
+            .cloned();
+        let Some(source) = source else {
+            return Ok(());
+        };
+        let descendant = source
+            .for_child(descendant_thread_id)
+            .await
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        let loaded = self
+            .get_thread(descendant_thread_id)
+            .await
+            .is_ok_and(|thread| thread.is_running());
+        let mut bindings = self.managed_record_bindings.write().await;
+        if let Some(existing) = bindings.get(&descendant_thread_id) {
+            if existing.source_id() != descendant.source_id() {
+                return Err(CodexErr::InvalidRequest(
+                    "restored agent UUID is already bound to another canonical source".to_string(),
+                ));
+            }
+        } else {
+            if loaded {
+                return Err(CodexErr::InvalidRequest(
+                    "restored managed agent UUID is already loaded without its canonical binding"
+                        .to_string(),
+                ));
+            }
+            bindings.insert(descendant_thread_id, descendant);
+        }
+        Ok(())
+    }
+}
