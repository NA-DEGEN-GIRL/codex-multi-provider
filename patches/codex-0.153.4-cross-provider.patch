+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::fs;
+use std::io::Write;
+use std::path::PathBuf;
+use std::time::Duration;
+use tempfile::NamedTempFile;
+use tempfile::TempDir;
+use tokio::time::timeout;
+use uuid::Uuid;
+
+const READ_TIMEOUT: Duration = Duration::from_secs(60);
+
+#[path = "managed_handoff_names.rs"]
+mod names;
+
+#[path = "managed_catalog_sources.rs"]
+mod catalog_sources;
+
+#[path = "managed_catalog_mixed.rs"]
+mod catalog_mixed;
+
+#[path = "managed_catalog_foreign.rs"]
+mod catalog_foreign;
+
+#[path = "managed_catalog_shared_history.rs"]
+mod catalog_shared_history;
+
+#[path = "managed_catalog_derived_history.rs"]
+mod catalog_derived_history;
+
+#[path = "managed_instance_activity.rs"]
+mod instance_activity;
+
+#[path = "managed_instance_shutdown_websocket.rs"]
+mod instance_shutdown_websocket;
+
+struct ManagedProfile {
+    home: TempDir,
+    profile_id: String,
+    source_id: String,
+    manifest_path: PathBuf,
+    api_key: String,
+}
+
+impl ManagedProfile {
+    fn new(endpoint: &str, model: &str, api_key: &str) -> Result<Self> {
+        let home = TempDir::new()?;
+        let profile_id = Uuid::new_v4().to_string();
+        let source_id = format!("manager:{profile_id}");
+        fs::write(
+            home.path().join("managed-source.json"),
+            serde_json::to_vec(&json!({ "host_id": "local", "store_id": source_id }))?,
+        )?;
+        MockResponsesConfig::new(endpoint)
+            .with_model(model)
+            .with_provider_config(
+                "env_key = \"CODEX_MANAGED_HANDOFF_TEST_KEY\"\nsupports_websockets = false",
+            )
+            .enable_feature(Feature::Goals)
+            .write(home.path())?;
+        let manifest_path = home.path().join("managed-sources.json");
+        Ok(Self {
+            home,
+            profile_id,
+            source_id,
+            manifest_path,
+            api_key: api_key.to_string(),
+        })
+    }
+
+    fn write_manifest(&self, sources: &[&Self], bindings: Vec<Value>) -> Result<()> {
+        let sources = sources
+            .iter()
+            .map(|source| {
+                json!({
+                    "hostId": "local",
+                    "sourceStoreId": source.source_id,
+                    "codexHome": source.home.path(),
+                })
+            })
+            .collect::<Vec<_>>();
+        let mut file = NamedTempFile::new_in(self.home.path())?;
+        file.write_all(&serde_json::to_vec(&json!({
+            "version": 1,
+            "hostId": "local",
+            "profileId": self.profile_id,
+            "sources": sources,
+            "bindings": bindings,
+        }))?)?;
+        file.persist(&self.manifest_path)?;
+        Ok(())
+    }
+
+    async fn start_server(&self) -> Result<TestAppServer> {
+        TestAppServer::builder()
+            .with_codex_home(self.home.path())
+            .without_managed_config()
+            .with_env_overrides(&[
+                (
+                    "CODEX_MANAGER_MANAGED_SOURCES",
+                    Some(self.manifest_path.to_str().context("UTF-8 manifest path")?),
+                ),
+                ("CODEX_MANAGED_HANDOFF_TEST_KEY", Some(&self.api_key)),
+                ("CODEX_MANAGER_RECORD_CATALOG", None),
+                ("CODEX_SQLITE_HOME", None),
+                ("OPENAI_API_KEY", None),
+                ("CODEX_ACCESS_TOKEN", None),
+            ])
+            .build_initialized_with_timeout(READ_TIMEOUT)
+            .await
+    }
+}
+
+fn binding_grant(
+    source: &ManagedProfile,
+    owner: &ManagedProfile,
+    thread_id: &str,
+    epoch: u64,
+) -> Value {
+    json!({
+        "threadId": thread_id,
+        "hostId": "local",
+        "sourceStoreId": source.source_id,
+        "ownerProfileId": owner.profile_id,
+        "ownershipEpoch": epoch,
+        "recordRevision": epoch,
+    })
+}
+
+// Simulate the manager's durable owner CAS only after a public strict release
+// proof. The fixture follows the same directory lock and atomic replacement
+// protocol; it never manufactures release while an actor still owns the record.
+fn transfer_authority(
+    source: &ManagedProfile,
+    thread_id: &str,
+    previous_owner: &ManagedProfile,
+    previous_epoch: u64,
+    next_owner: &ManagedProfile,
+) -> Result<()> {
+    let directory = source.home.path().join("managed-authority");
+    let authority_path = directory.join(format!("{thread_id}.json"));
+    let lock_path = directory.join(format!("{thread_id}.lock"));
+    fs::create_dir(&lock_path)?;
+    let result = (|| -> Result<()> {
+        let current: Value = serde_json::from_slice(&fs::read(&authority_path)?)?;
+        assert_eq!(
+            current,
+            json!({
+                "version": 1,
+                "host_id": "local",
+                "store_id": source.source_id,
+                "thread_id": thread_id,
+                "owner_profile_id": previous_owner.profile_id,
+                "epoch": previous_epoch,
+                "revision": previous_epoch,
+            })
+        );
+        let mut next = current;
+        next["owner_profile_id"] = json!(next_owner.profile_id);
+        next["epoch"] = json!(previous_epoch + 1);
+        next["revision"] = json!(previous_epoch + 1);
+        let mut file = NamedTempFile::new_in(&directory)?;
+        file.write_all(&serde_json::to_vec(&next)?)?;
+        file.flush()?;
+        file.as_file().sync_all()?;
+        file.persist(&authority_path)?;
+        #[cfg(unix)]
+        fs::File::open(&directory)?.sync_all()?;
+        Ok(())
+    })();
+    let release_result = fs::remove_dir(lock_path);
+    result?;
+    release_result?;
+    Ok(())
+}
+
+async fn complete_turn(server: &mut TestAppServer, thread_id: &str, input: &str) -> Result<()> {
+    let request_id = server
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread_id.to_string(),
+            input: vec![UserInput::Text {
+                text: input.to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let started: TurnStartResponse =
+        timeout(READ_TIMEOUT, server.read_response(request_id)).await??;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let completed: TurnCompletedNotification =
+        serde_json::from_value(notification.params.context("turn completed params")?)?;
+    assert_eq!(
+        (
+            completed.thread_id.as_str(),
+            completed.turn.id.as_str(),
+            completed.turn.status,
+            completed.turn.error,
+        ),
+        (
+            thread_id,
+            started.turn.id.as_str(),
+            TurnStatus::Completed,
+            None
+        ),
+    );
+    Ok(())
+}
+
+async fn close_idle(server: &mut TestAppServer, thread_id: &str) -> Result<()> {
+    let close_id = server
+        .send_raw_request(
+            "thread/managedCloseIdle",
+            Some(json!({ "threadId": thread_id })),
+        )
+        .await?;
+    let proof: ThreadManagedCloseIdleResponse =
+        timeout(READ_TIMEOUT, server.read_response(close_id)).await??;
+    assert_eq!(
+        proof,
+        ThreadManagedCloseIdleResponse {
+            thread_id: thread_id.to_string(),
+            closed_thread_ids: vec![thread_id.to_string()],
+            writer_release_verified: true,
+        },
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn managed_handoff_preserves_canonical_record_and_target_config_without_stopping_other_threads()
+-> Result<()> {
+    let source_api = responses::start_mock_server().await;
+    let target_api = responses::start_mock_server().await;
+    let source_requests = responses::mount_sse_sequence(
+        &source_api,
+        vec![
+            create_final_assistant_message_sse_response("Source prior work")?,
+            create_final_assistant_message_sse_response("Source independent work")?,
+            create_final_assistant_message_sse_response("Source resumed canonical work")?,
+        ],
+    )
+    .await;
+    let target_requests = responses::mount_sse_sequence(
+        &target_api,
+        vec![
+            create_final_assistant_message_sse_response("Target continued canonical work")?,
+            create_final_assistant_message_sse_response("Target independent work")?,
+        ],
+    )
+    .await;
+    let source = ManagedProfile::new(
+        &source_api.uri(),
+        "source-test-model",
+        "source-fixture-token",
+    )?;
+    let target = ManagedProfile::new(
+        &target_api.uri(),
+        "target-test-model",
+        "target-fixture-token",
+    )?;
+    source.write_manifest(&[&source], Vec::new())?;
+    let mut source_server = source.start_server().await?;
+    let canonical = source_server
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    complete_turn(&mut source_server, &canonical.id, "Start canonical work").await?;
+    let source_other = source_server
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+
+    let read_id = source_server
+        .send_raw_request("thread/read", Some(json!({ "threadId": canonical.id })))
+        .await?;
+    let before: ThreadReadResponse =
+        timeout(READ_TIMEOUT, source_server.read_response(read_id)).await??;
+    let source_rollout = before
+        .thread
+        .path
+        .context("source rollout path after its first turn")?;
+    let source_rollout = fs::canonicalize(source_rollout)?;
+    assert!(source_rollout.starts_with(fs::canonicalize(source.home.path())?));
+    let before_bytes = fs::read(&source_rollout)?;
+
+    let goal_id = source_server
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({
+                "threadId": canonical.id,
+                "objective": "Keep this goal in the canonical source",
+                "status": "paused",
+            })),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, source_server.read_response(goal_id)).await??;
+
+    let target_grant = binding_grant(&source, &target, &canonical.id, /*epoch*/ 2);
+    target.write_manifest(&[&source, &target], vec![target_grant])?;
+    let mut target_server = target.start_server().await?;
+    let target_other = target_server
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    let resume_params = ThreadResumeParams {
+        thread_id: canonical.id.clone(),
+        model: Some("target-test-model".to_string()),
+        ..Default::default()
+    };
+    let conflicting_id = target_server
+        .send_thread_resume_request(resume_params.clone())
+        .await?;
+    let conflict = timeout(
+        READ_TIMEOUT,
+        target_server.read_stream_until_error_message(RequestId::Integer(conflicting_id)),
+    )
+    .await??;
+    assert!(
+        conflict
+            .error
+            .message
+            .contains("authority epoch has changed"),
+        "unexpected ownership refusal: {}",
+        conflict.error.message,
+    );
+    assert!(target_requests.requests().is_empty());
+
+    close_idle(&mut source_server, &canonical.id).await?;
+    let loaded_id = source_server
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, source_server.read_response(loaded_id)).await??;
+    assert_eq!(loaded.data, vec![source_other.id.clone()]);
+    transfer_authority(
+        &source,
+        &canonical.id,
+        &source,
+        /*previous_epoch*/ 1,
+        &target,
+    )?;
+
+    let resume_id = target_server
+        .send_thread_resume_request(resume_params)
+        .await?;
+    let resumed: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, target_server.read_response(resume_id)).await??;
+    assert_eq!(resumed.thread.id, canonical.id);
+    assert_eq!(resumed.model, "target-test-model");
+    assert_eq!(
+        fs::canonicalize(resumed.thread.path.context("resumed canonical rollout")?)?,
+        source_rollout
+    );
+    let goal_id = target_server
+        .send_raw_request("thread/goal/get", Some(json!({ "threadId": canonical.id })))
+        .await?;
+    let goal: Value = timeout(READ_TIMEOUT, target_server.read_response(goal_id)).await??;
+    assert_eq!(
+        goal["goal"]["objective"],
+        "Keep this goal in the canonical source"
+    );
+    assert_eq!(goal["goal"]["status"], "paused");
+    complete_turn(
+        &mut target_server,
+        &canonical.id,
+        "Continue canonical work in target profile",
+    )
+    .await?;
+
+    // Closing one actor must leave both processes and their unrelated actors usable.
+    complete_turn(
+        &mut source_server,
+        &source_other.id,
+        "Continue independent source work",
+    )
+    .await?;
+    complete_turn(
+        &mut target_server,
+        &target_other.id,
+        "Continue independent target work",
+    )
+    .await?;
+    let stale_id = source_server
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: canonical.id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let stale = timeout(
+        READ_TIMEOUT,
+        source_server.read_stream_until_error_message(RequestId::Integer(stale_id)),
+    )
+    .await??;
+    assert!(
+        stale.error.message.contains("released by this instance"),
+        "{}",
+        stale.error.message
+    );
+    close_idle(&mut target_server, &canonical.id).await?;
+
+    // Returning to an already-running former owner requires a new durable grant
+    // and explicit activation. Editing the manifest cannot reopen its old gate.
+    transfer_authority(
+        &source,
+        &canonical.id,
+        &target,
+        /*previous_epoch*/ 2,
+        &source,
+    )?;
+    let source_grant = binding_grant(&source, &source, &canonical.id, /*epoch*/ 3);
+    source.write_manifest(&[&source], vec![source_grant.clone()])?;
+    for invalid_grant in [
+        binding_grant(&source, &source, &canonical.id, /*epoch*/ 1),
+        binding_grant(&source, &target, &canonical.id, /*epoch*/ 3),
+    ] {
+        let reload_id = source_server
+            .send_raw_request("thread/managedReloadBinding", Some(invalid_grant))
+            .await?;
+        let rejected = timeout(
+            READ_TIMEOUT,
+            source_server.read_stream_until_error_message(RequestId::Integer(reload_id)),
+        )
+        .await??;
+        assert_eq!(rejected.error.code, -32600);
+    }
+    let return_params = ThreadResumeParams {
+        thread_id: canonical.id.clone(),
+        model: Some("source-test-model".to_string()),
+        ..Default::default()
+    };
+    let still_fenced_id = source_server
+        .send_thread_resume_request(return_params.clone())
+        .await?;
+    let still_fenced = timeout(
+        READ_TIMEOUT,
+        source_server.read_stream_until_error_message(RequestId::Integer(still_fenced_id)),
+    )
+    .await??;
+    assert!(
+        still_fenced
+            .error
+            .message
+            .contains("released by this instance")
+    );
+    let reload_id = source_server
+        .send_raw_request("thread/managedReloadBinding", Some(source_grant))
+        .await?;
+    let activated: ThreadManagedReloadBindingResponse =
+        timeout(READ_TIMEOUT, source_server.read_response(reload_id)).await??;
+    assert_eq!(
+        activated,
+        ThreadManagedReloadBindingResponse {
+            thread_id: canonical.id.clone(),
+            host_id: "local".to_string(),
+            source_store_id: source.source_id.clone(),
+            owner_profile_id: source.profile_id.clone(),
+            ownership_epoch: 3,
+            record_revision: 3,
+            activated_thread_ids: vec![canonical.id.clone()],
+            binding_reloaded: true,
+        }
+    );
+    let return_id = source_server
+        .send_thread_resume_request(return_params)
+        .await?;
+    let returned: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, source_server.read_response(return_id)).await??;
+    assert_eq!(returned.thread.id, canonical.id);
+    complete_turn(
+        &mut source_server,
+        &canonical.id,
+        "Continue after returning to source profile",
+    )
+    .await?;
+    close_idle(&mut source_server, &canonical.id).await?;
+
+    let after_bytes = fs::read(&source_rollout)?;
+    assert!(
+        after_bytes.starts_with(&before_bytes),
+        "handoff rewrote the canonical rollout prefix"
+    );
+    let after_text = String::from_utf8(after_bytes)?;
+    assert!(after_text.contains("Target continued canonical work"));
+    assert!(after_text.contains("Source resumed canonical work"));
+    let source_rows =
+        read_thread_state_audit_rows(&SqliteConfig::new_for_testing(source.home.path().abs()))
+            .await?;
+    let canonical_rows = source_rows
+        .iter()
+        .filter(|row| row.id == canonical.id)
+        .collect::<Vec<_>>();
+    assert_eq!(canonical_rows.len(), 1);
+    assert_eq!(
+        fs::canonicalize(&canonical_rows[0].rollout_path)?,
+        source_rollout
+    );
+    let target_rows =
+        read_thread_state_audit_rows(&SqliteConfig::new_for_testing(target.home.path().abs()))
+            .await?;
+    assert_eq!(
+        target_rows
+            .iter()
+            .map(|row| row.id.as_str())
+            .collect::<Vec<_>>(),
+        vec![target_other.id.as_str()]
+    );
+    let mut pending_directories = vec![target.home.path().join("sessions")];
+    while let Some(directory) = pending_directories.pop() {
+        for entry in fs::read_dir(directory)? {
+            let entry = entry?;
+            if entry.file_type()?.is_dir() {
+                pending_directories.push(entry.path());
+            } else {
+                assert!(!entry.file_name().to_string_lossy().contains(&canonical.id));
+            }
+        }
+    }
+
+    let source_calls = source_requests.requests();
+    let target_calls = target_requests.requests();
+    assert_eq!((source_calls.len(), target_calls.len()), (3, 2));
+    for request in &source_calls {
+        assert_eq!(
+            request.header("authorization").as_deref(),
+            Some("Bearer source-fixture-token")
+        );
+        assert_eq!(request.body_json()["model"], "source-test-model");
+    }
+    for request in &target_calls {
+        assert_eq!(
+            request.header("authorization").as_deref(),
+            Some("Bearer target-fixture-token")
+        );
+        assert_eq!(request.body_json()["model"], "target-test-model");
+    }
+    assert!(target_calls[0].body_contains_text("Source prior work"));
+    assert!(target_calls[0].body_contains_text("Continue canonical work in target profile"));
+    assert!(source_calls[2].body_contains_text("Target continued canonical work"));
+    Ok(())
+}
