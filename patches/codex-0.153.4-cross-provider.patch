+//! Explicit plaintext projection for accepted cross-harness task messages.
+use codex_protocol::error::Result;
+use codex_protocol::models::AgentMessageInputContent;
+use codex_protocol::models::plaintext_agent_message_content;
+
+use super::bridge::failure;
+
+pub(super) fn plaintext(content: &[AgentMessageInputContent]) -> Result<String> {
+    let text = plaintext_agent_message_content(content).ok_or_else(|| {
+        failure("agent messages require nonempty plaintext on the cross-provider route")
+    })?;
+    if text.len() > 8192 {
+        return Err(failure("agent message exceeds the plaintext bridge limit"));
+    }
+    Ok(text)
+}
+
