@@ -0,0 +1,373 @@
+//! Claim dormant managed descendants without starting actors, models, hooks, or tools.
+
+use super::*;
+use crate::session::IdleCloseAdmission;
+use codex_thread_store::ListTurnsParams;
+use codex_thread_store::ManagedWriterReservation;
+use codex_thread_store::ReadOnlyLocalThreadStore;
+use codex_thread_store::ResumeThreadParams;
+use codex_thread_store::SortDirection;
+use codex_thread_store::StoredTurnItemsView;
+use codex_thread_store::StoredTurnStatus;
+use codex_thread_store::ThreadPersistenceMetadata;
+use tokio::sync::OwnedRwLockWriteGuard;
+
+const MAX_COLD_DRAIN_THREADS: usize = 128;
+
+/// Owns startup exclusion for the exact tree and the actual recorder locks of its cold children.
+/// A dropped preflight only abandons reservations; it never certifies release or starts cleanup.
+pub struct ManagedColdDrain {
+    state: Arc<ThreadManagerState>,
+    root_id: ThreadId,
+    lifecycle: Arc<ColdDrainLifecycle>,
+    claims: HashMap<ThreadId, ColdDrainClaim>,
+}
+
+struct ColdDrainLifecycle {
+    _guards: Vec<OwnedRwLockWriteGuard<()>>,
+}
+
+struct ColdDrainClaim {
+    binding: ManagedThreadBinding,
+    parent_id: ThreadId,
+    resume: ResumeThreadParams,
+    _reservation: ManagedWriterReservation,
+}
+
+impl ManagedColdDrain {
+    pub fn contains(&self, thread_id: ThreadId) -> bool {
+        self.claims.contains_key(&thread_id)
+    }
+
+    pub fn binding(&self, thread_id: ThreadId) -> Option<&ManagedThreadBinding> {
+        self.claims.get(&thread_id).map(|claim| &claim.binding)
+    }
+
+    pub fn parent_thread_id(&self, thread_id: ThreadId) -> Option<ThreadId> {
+        self.claims.get(&thread_id).map(|claim| claim.parent_id)
+    }
+
+    /// Consume the held OS reservation into a recorder, then flush, close and revoke it.
+    /// Caller cancellation cannot cancel this owned close. Any failed or panicked close leaves
+    /// a startup tombstone for the root and child; it is never an absence/release proof.
+    pub async fn close_thread(&mut self, thread_id: ThreadId) -> CodexResult<()> {
+        let claim = self
+            .claims
+            .get(&thread_id)
+            .ok_or_else(|| cold_error("cold managed thread has no remaining writer reservation"))?;
+        let mut tracker = self
+            .state
+            .track_managed_startup(Some(&claim.binding), &[self.root_id])?;
+        let claim = self
+            .claims
+            .remove(&thread_id)
+            .ok_or_else(|| cold_error("cold managed writer reservation disappeared"))?;
+        let lifecycle = Arc::clone(&self.lifecycle);
+        tokio::spawn(async move {
+            // Keep lifecycle exclusion and the exact OS reservation through all nested owned
+            // initialization. The recorder consumes that lock without a release/reacquire gap.
+            let _lifecycle = lifecycle;
+            let store = claim.binding.store();
+            store
+                .resume_thread(claim.resume)
+                .await
+                .map_err(store_error)?;
+            store.flush_thread(thread_id).await.map_err(store_error)?;
+            store
+                .shutdown_thread(thread_id)
+                .await
+                .map_err(store_error)?;
+            if !claim.binding.is_released() {
+                return Err(cold_error(
+                    "cold managed writer close did not revoke its binding",
+                ));
+            }
+            tracker.complete();
+            drop(claim._reservation);
+            Ok(())
+        })
+        .await
+        .map_err(|error| {
+            cold_error(format!(
+                "cold managed writer close was not verified: {error}"
+            ))
+        })?
+    }
+}
+
+impl ThreadManager {
+    /// Prepare only dormant V2 descendants under the caller's exact root submission reservation.
+    /// The caller also seals app-server request admission and checks canonical queues/client state
+    /// before invoking close_thread. This factory creates no actor and emits no runtime events.
+    pub async fn prepare_managed_cold_drain(
+        &self,
+        root: &Arc<CodexThread>,
+        root_admission: &IdleCloseAdmission,
+        thread_ids: &[ThreadId],
+    ) -> CodexResult<ManagedColdDrain> {
+        let root_id = root.session_configured().thread_id;
+        if !root.idle_close_reservation_matches(root_admission)
+            || root.session_source.is_non_root_agent()
+            || !root.is_running()
+        {
+            return Err(cold_error(
+                "cold drain requires its live root's exact idle reservation",
+            ));
+        }
+        let mut ids = thread_ids.to_vec();
+        ids.sort_by_key(ToString::to_string);
+        ids.dedup();
+        if ids.is_empty() || ids.len() > MAX_COLD_DRAIN_THREADS || !ids.contains(&root_id) {
+            return Err(cold_error(
+                "cold drain requires a bounded complete canonical subtree",
+            ));
+        }
+        let mut guards = Vec::with_capacity(ids.len());
+        for lock in self.state.managed_lifecycle_locks_for(&ids) {
+            guards.push(lock.try_write_owned().map_err(|_| {
+                cold_error("a canonical subtree actor is starting or another drain is in progress")
+            })?);
+        }
+        self.state.check_managed_startup_uncertainty(&ids)?;
+        let registered_root = self.state.get_thread(root_id).await?;
+        if !Arc::ptr_eq(root, &registered_root) {
+            return Err(cold_error(
+                "canonical root actor changed during cold drain admission",
+            ));
+        }
+        let root_binding = self.managed_record_binding(root_id).await.ok_or_else(|| {
+            cold_error("cold drain root has no immutable canonical source binding")
+        })?;
+        // This permit is intentionally short. Holding it through child close would prevent the
+        // root's later exclusive shutdown, and retaining authority leases would block owner CAS.
+        drop(
+            root_binding
+                .live_write_permit()
+                .await
+                .map_err(store_error)?,
+        );
+        if self
+            .managed_activation_thread_ids(&root_binding)
+            .await
+            .map_err(|error| {
+                cold_error(format!("cannot read canonical cold-drain subtree: {error}"))
+            })?
+            != ids
+        {
+            return Err(cold_error(
+                "cold drain does not cover the exact persisted canonical subtree",
+            ));
+        }
+
+        let mut claims = HashMap::new();
+        for id in ids.iter().copied().filter(|id| *id != root_id) {
+            if self.state.get_thread(id).await.is_ok() {
+                let binding = self.managed_record_binding(id).await.ok_or_else(|| {
+                    cold_error("loaded subtree actor has no canonical source binding")
+                })?;
+                validate_source_owner(&root_binding, &binding)?;
+                continue;
+            }
+            let fresh = root_binding.for_child(id).await.map_err(store_error)?;
+            let previous = self.managed_record_binding(id).await;
+            let binding = if let Some(previous) = previous {
+                validate_source_owner(&root_binding, &previous)?;
+                if previous.authority_grant() != fresh.authority_grant() {
+                    return Err(cold_error(
+                        "cold child ownership changed without explicit activation",
+                    ));
+                }
+                if previous.is_released() {
+                    fresh
+                } else {
+                    previous
+                }
+            } else {
+                fresh
+            };
+            // Writer acquisition precedes DB initialization or any repair-capable history read.
+            // An occupied writer therefore cannot be disturbed by this attempted drain.
+            let reservation = binding.prepare_writer().await.map_err(store_error)?;
+            let (parent_id, resume) = prepare_cold_history(&binding, &ids).await?;
+            ensure_cold_goal_idle(&binding).await?;
+            claims.insert(
+                id,
+                ColdDrainClaim {
+                    binding,
+                    parent_id,
+                    resume,
+                    _reservation: reservation,
+                },
+            );
+        }
+        if self.managed_activation_thread_ids(&root_binding).await? != ids {
+            return Err(cold_error(
+                "canonical subtree changed during cold writer preparation",
+            ));
+        }
+        self.state.check_managed_startup_uncertainty(&ids)?;
+        // Keep fresh same-grant lifetimes private to this reservation. Abandoned preflight must
+        // never reopen a previously revoked binding or publish a new runtime execution route.
+        Ok(ManagedColdDrain {
+            state: Arc::clone(&self.state),
+            root_id,
+            lifecycle: Arc::new(ColdDrainLifecycle { _guards: guards }),
+            claims,
+        })
+    }
+}
+
+fn validate_source_owner(
+    root: &ManagedThreadBinding,
+    child: &ManagedThreadBinding,
+) -> CodexResult<()> {
+    if root.source_id() != child.source_id()
+        || root.source_config().codex_home != child.source_config().codex_home
+        || root.authority_grant().owner_profile_id != child.authority_grant().owner_profile_id
+    {
+        return Err(cold_error(
+            "canonical subtree actor belongs to another source or owner",
+        ));
+    }
+    Ok(())
+}
+
+async fn ensure_cold_goal_idle(binding: &ManagedThreadBinding) -> CodexResult<()> {
+    // A cold claim has a writer reservation but no live recorder yet. Read the canonical goal
+    // under a short write-authority permit; do not reconcile or advance its continuation state.
+    let _permit = binding.write_permit().await.map_err(store_error)?;
+    let state = binding
+        .store()
+        .state_db()
+        .await
+        .ok_or_else(|| cold_error("cold descendant canonical goal state is unavailable"))?;
+    let goal = state
+        .thread_goals()
+        .get_thread_goal(binding.thread_id())
+        .await
+        .map_err(|error| {
+            cold_error(format!("cannot verify cold descendant goal state: {error}"))
+        })?;
+    if goal.is_some_and(|goal| goal.status == codex_state::ThreadGoalStatus::Active) {
+        return Err(cold_error(
+            "cold descendant has an active goal continuation",
+        ));
+    }
+    Ok(())
+}
+
+async fn prepare_cold_history(
+    binding: &ManagedThreadBinding,
+    subtree: &[ThreadId],
+) -> CodexResult<(ThreadId, ResumeThreadParams)> {
+    let source = binding.source_config();
+    let reader = ReadOnlyLocalThreadStore::open(source.codex_home.clone(), source.sqlite.clone())
+        .await
+        .map_err(store_error)?;
+    let result = async {
+        let id = binding.thread_id();
+        let stored = reader
+            .read_thread(ReadThreadParams {
+                thread_id: id,
+                include_archived: true,
+                include_history: false,
+            })
+            .await
+            .map_err(|error| {
+                cold_error(format!("cannot read cold descendant metadata: {error}"))
+            })?;
+        let parent_id = stored
+            .source
+            .parent_thread_id()
+            .ok_or_else(|| cold_error("cold canonical descendant has no recorded spawn parent"))?;
+        if stored.thread_id != id
+            || parent_id == id
+            || !subtree.contains(&parent_id)
+            || stored
+                .parent_thread_id
+                .is_some_and(|parent| parent != parent_id)
+        {
+            return Err(cold_error(
+                "cold descendant parent identity is inconsistent",
+            ));
+        }
+        let context = reader
+            .load_latest_model_context(LoadThreadHistoryParams {
+                thread_id: id,
+                include_archived: true,
+            })
+            .await
+            .map_err(store_error)?;
+        if context.thread_id != id {
+            return Err(cold_error(
+                "cold descendant context belongs to another canonical thread",
+            ));
+        }
+        let history = Arc::new(context.items);
+        let initial = InitialHistory::Resumed(ResumedHistory {
+            conversation_id: id,
+            history: Arc::clone(&history),
+            rollout_path: stored.rollout_path.clone(),
+        });
+        if initial.get_multi_agent_version() != Some(MultiAgentVersion::V2) {
+            return Err(cold_error(
+                "only persisted dormant V2 descendants support cold drain",
+            ));
+        }
+        let turns = reader
+            .list_turns(ListTurnsParams {
+                thread_id: id,
+                include_archived: true,
+                cursor: None,
+                page_size: 1,
+                sort_direction: SortDirection::Desc,
+                items_view: StoredTurnItemsView::NotLoaded,
+            })
+            .await
+            .map_err(store_error)?;
+        if turns
+            .turns
+            .iter()
+            .any(|turn| turn.status == StoredTurnStatus::InProgress)
+        {
+            return Err(cold_error(
+                "cold descendant has an unfinished persisted turn",
+            ));
+        }
+        let persisted_memory_mode = reader.thread_memory_mode(id).await.map_err(store_error)?;
+        let memory_mode = match persisted_memory_mode.as_str() {
+            "enabled" => codex_protocol::protocol::ThreadMemoryMode::Enabled,
+            "disabled" => codex_protocol::protocol::ThreadMemoryMode::Disabled,
+            _ => return Err(cold_error("cold descendant memory mode is unknown")),
+        };
+        Ok((
+            parent_id,
+            ResumeThreadParams {
+                thread_id: id,
+                rollout_path: stored.rollout_path,
+                history: Some(history),
+                include_archived: true,
+                metadata: ThreadPersistenceMetadata {
+                    cwd: Some(stored.cwd),
+                    model_provider: stored.model_provider,
+                    memory_mode,
+                },
+            },
+        ))
+    }
+    .await;
+    reader.close().await;
+    result
+}
+
+fn cold_error(message: impl Into<String>) -> CodexErr {
+    CodexErr::InvalidRequest(message.into())
+}
+
+fn store_error(error: ThreadStoreError) -> CodexErr {
+    cold_error(error.to_string())
+}
