+#[tokio::test]
+async fn shared_catalog_keeps_native_start_and_file_work_alongside_foreign_history() -> Result<()> {
+    let fixture = CatalogFixture::new()?;
+    let original = fs::read(&fixture.rollout_path)?;
+    let mut server = TestAppServer::builder()
+        .with_codex_home(fixture.viewer_home.path())
+        .without_managed_config()
+        .with_env_overrides(&[
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            (
+                "CODEX_MANAGER_SHARED_CATALOG",
+                Some(
+                    fixture
+                        .manifest_path
+                        .to_str()
+                        .context("UTF-8 shared manifest")?,
+                ),
+            ),
+            ("CODEX_SQLITE_HOME", None),
+            ("OPENAI_API_KEY", None),
+            ("CODEX_ACCESS_TOKEN", None),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    let request = server
+        .send_raw_request(
+            "thread/list",
+            Some(json!({"projectId":null,"sectionId":null})),
+        )
+        .await?;
+    let listed: ThreadListResponse = timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(
+        listed
+            .data
+            .iter()
+            .map(|thread| thread.id.as_str())
+            .collect::<Vec<_>>(),
+        vec![fixture.projection_id.as_str()]
+    );
+    let request = server
+        .send_raw_request(
+            "thread/read",
+            Some(json!({"threadId":fixture.projection_id,"includeTurns":true})),
+        )
+        .await?;
+    let read: ThreadReadResponse = timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(read.thread.can_accept_direct_input, Some(false));
+    let started = server
+        .start_thread(codex_app_server_protocol::ThreadStartParams {
+            ephemeral: Some(true),
+            ..Default::default()
+        })
+        .await?;
+    assert_ne!(started.thread.id, fixture.projection_id);
+    let request = server
+        .send_raw_request(
+            "thread/read",
+            Some(json!({"threadId":started.thread.id,"includeTurns":false})),
+        )
+        .await?;
+    let native: ThreadReadResponse = timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(native.thread.id, started.thread.id);
+    let own_file = fixture.viewer_home.path().join("native-work.txt");
+    let request = server
+        .send_raw_request(
+            "fs/writeFile",
+            Some(json!({"path":own_file,"dataBase64":"bmF0aXZlIHdvcms="})),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    assert_eq!(fs::read(&own_file)?, b"native work");
+    for (method, params) in [
+        (
+            "turn/start",
+            json!({"threadId":fixture.projection_id,"input":[]}),
+        ),
+        ("thread/archive", json!({"threadId":fixture.projection_id})),
+    ] {
+        let request = server.send_raw_request(method, Some(params)).await?;
+        let error = timeout(
+            READ_TIMEOUT,
+            server.read_stream_until_error_message(RequestId::Integer(request)),
+        )
+        .await??;
+        assert!(
+            error.error.message.contains("read-only record catalog"),
+            "{method}"
+        );
+    }
+    fixture.assert_source_untouched(&original)?;
+    Ok(())
+}
