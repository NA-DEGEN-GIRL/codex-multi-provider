+#[tokio::test]
+async fn opaque_state_of_another_family_never_enters_the_prefix() {
+    let config = crate::config::test_config().await;
+    // GPT's replay held xAI's encrypted reasoning, as an older runtime could leave it.
+    let mut records = gpt_turns();
+    records.extend([
+        RolloutItem::TurnContext(turn_context("grok-test", "xai")),
+        record(encrypted_reasoning("XAI_REASONING")),
+        RolloutItem::TurnContext(turn_context(GPT_MODEL, "openai")),
+        record(message("user", "gpt third question")),
