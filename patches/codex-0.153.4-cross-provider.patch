+use codex_app_server_protocol::UserInput;
+use core_test_support::responses;
+use core_test_support::streaming_sse::StreamingSseChunk;
+use core_test_support::streaming_sse::start_streaming_sse_server;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::TempDir;
+use tokio::sync::oneshot;
+use tokio::time::timeout;
+
+const READ_TIMEOUT: Duration = Duration::from_secs(10);
+const SOURCES_ENV: &str = "CODEX_MANAGER_MANAGED_SOURCES";
+
+#[path = "thread_managed_close_idle_cold.rs"]
+mod cold;
+
+#[tokio::test]
+async fn unmanaged_close_request_does_not_interrupt_the_running_thread() -> Result<()> {
+    let (complete_tx, complete_rx) = oneshot::channel();
+    let (server, _) = start_streaming_sse_server(vec![vec![
+        StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![responses::ev_response_created("unmanaged")]),
+        },
+        StreamingSseChunk {
+            gate: Some(complete_rx),
+            body: responses::sse(vec![responses::ev_completed("unmanaged")]),
+        },
+    ]])
+    .await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(server.uri())
+        .with_sandbox_mode("danger-full-access")
+        .write(codex_home.path())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_managed_config()
+        .with_env_overrides(&[(SOURCES_ENV, None)])
+        .build_initialized()
+        .await?;
+    let thread_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let started: TurnStartResponse = app
+        .request(|request_id| ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
+                thread_id: thread_id.clone(),
+                input: vec![UserInput::Text {
+                    text: "finish the original unmanaged turn".into(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            },
+        })
+        .await?;
+    timeout(READ_TIMEOUT, server.wait_for_request_count(1)).await?;
+
+    let request_id = app
+        .send_request(
+            "thread/managedCloseIdle",
+            Some(json!({ "threadId": thread_id })),
+        )
+        .await?;
+    let rejected = timeout(
+        READ_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(request_id)),
+    )
+    .await??;
+    assert_eq!(rejected.error.code, -32600);
+    let loaded: ThreadLoadedListResponse = app
+        .request(|request_id| ClientRequest::ThreadLoadedList {
+            request_id,
+            params: ThreadLoadedListParams::default(),
+        })
+        .await?;
+    assert_eq!(loaded.data, vec![thread_id.clone()]);
+
+    complete_tx
+        .send(())
+        .expect("the running inference request is intact");
+    let completed: TurnCompletedNotification =
+        timeout(READ_TIMEOUT, app.read_notification("turn/completed")).await??;
+    assert_eq!(
+        (
+            completed.thread_id,
+            completed.turn.id,
+            completed.turn.status
+        ),
+        (thread_id, started.turn.id, TurnStatus::Completed)
+    );
+    assert_eq!(server.requests().await.len(), 1);
+    server.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn managed_close_proves_release_and_fences_only_the_closed_actor() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_sandbox_mode("danger-full-access")
+        .write(codex_home.path())?;
+    let source_id = "manager:00000000-0000-4000-8000-000000000001";
+    std::fs::write(
+        codex_home.path().join("managed-source.json"),
+        serde_json::to_vec(&json!({ "host_id": "local", "store_id": source_id }))?,
+    )?;
+    let manifest_path = codex_home.path().join("managed-sources.json");
+    std::fs::write(
+        &manifest_path,
+        serde_json::to_vec(&json!({
+            "version": 1,
+            "hostId": "local",
+            "profileId": "00000000-0000-4000-8000-000000000001",
+            "sources": [{
+                "hostId": "local",
+                "sourceStoreId": source_id,
+                "codexHome": codex_home.path(),
+            }],
+            "bindings": [],
+        }))?,
+    )?;
+    let manifest_path = manifest_path.to_str().context("manifest path is UTF-8")?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_managed_config()
+        .with_env_overrides(&[(SOURCES_ENV, Some(manifest_path))])
+        .build_initialized()
+        .await?;
+    let thread_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    // A fresh actor is idle without depending on TurnComplete, which is emitted
+    // before the core's final turn cleanup. Durable history is covered in core.
+    let peer_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+
+    let released: ThreadManagedCloseIdleResponse = app
+        .request(|request_id| ClientRequest::ThreadManagedCloseIdle {
+            request_id,
+            params: ThreadManagedCloseIdleParams {
+                thread_id: thread_id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(
+        released,
+        ThreadManagedCloseIdleResponse {
+            thread_id: thread_id.clone(),
+            closed_thread_ids: vec![thread_id.clone()],
+            writer_release_verified: true,
+        }
+    );
+    let closed: ThreadClosedNotification =
+        timeout(READ_TIMEOUT, app.read_notification("thread/closed")).await??;
+    assert_eq!(
+        closed,
+        ThreadClosedNotification {
+            thread_id: thread_id.clone()
+        }
+    );
+    let loaded: ThreadLoadedListResponse = app
+        .request(|request_id| ClientRequest::ThreadLoadedList {
+            request_id,
+            params: ThreadLoadedListParams::default(),
+        })
+        .await?;
+    assert_eq!(loaded.data, vec![peer_id.clone()]);
+
+    // Neither a new turn nor reloading the released actor may reopen the old
+    // instance's writer after its release proof has been delivered.
+    for (method, params) in [
+        (
+            "turn/start",
+            json!({
+                "threadId": thread_id,
+                "input": [{ "type": "text", "text": "late input", "text_elements": [] }],
+            }),
+        ),
+        ("thread/resume", json!({ "threadId": thread_id })),
+    ] {
+        let request_id = app.send_request(method, Some(params)).await?;
+        let rejected = timeout(
+            READ_TIMEOUT,
+            app.read_stream_until_error_message(RequestId::Integer(request_id)),
+        )
+        .await??;
+        assert_eq!(rejected.error.code, -32600);
+    }
+    let _: TurnStartResponse = app
+        .request(|request_id| ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
+                thread_id: peer_id.clone(),
+                input: vec![UserInput::Text {
+                    text: "the unrelated managed actor keeps working".into(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            },
+        })
+        .await?;
+    let completed: TurnCompletedNotification =
+        timeout(READ_TIMEOUT, app.read_notification("turn/completed")).await??;
+    assert_eq!(
+        (completed.thread_id, completed.turn.status),
+        (peer_id, TurnStatus::Completed)
+    );
+    Ok(())
+}
