--- /dev/null
+++ b/codex-rs/core/src/portable_context/rebuild/recent.rs
@@ -0,0 +1,222 @@
+//! Chooses what of a rebuilt context's newest history fits, and what stands in for the rest.
+
+use std::collections::HashMap;
+
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::ResponseItem;
+
+use super::PORTABLE_USER_MESSAGE_MAX_TOKENS;
+use super::PreparedItems;
+use super::Replacements;
+use super::token_count;
+use crate::compact::CompactedUserMessage;
+use crate::compact::build_compacted_history_with_limit;
+use crate::compact::collect_annotated_user_messages;
+use crate::context::ContextualUserFragment;
+use crate::context::PortableContextNote;
+use crate::context::PortableRecentItems;
+use crate::context_manager::is_user_turn_boundary;
+use crate::portable_context::budget::rebuild_token_count;
+
+/// Keeps the newest prepared items from `start` on that fit `budget_tokens`, after the user
+/// messages of every turn left out (up to the cap, newest first), the summary if there is one,
+/// and a note saying what was left out.
+///
+/// User messages keep their order around the summary: those from before `start` precede it, and
+/// those of left-out turns after it follow it.
+pub(super) fn keep_recent(
+    prepared: PreparedItems,
+    start: usize,
+    summary_text: Option<&str>,
+    budget_tokens: i64,
+) -> (Vec<ResponseItemEnvelope>, Replacements) {
+    let summary_tokens = summary_text.map_or(0, |summary_text| {
+        token_count(&build_compacted_history_with_limit(
+            Vec::new(),
+            &[],
+            summary_text,
+            /*max_tokens*/ 0,
+        ))
+    });
+    let remaining = budget_tokens
+        - summary_tokens
+        - longest_note_tokens(/*after_summary*/ summary_text.is_some());
+    // Room for the user messages of left-out turns; recent items get whatever they do not need.
+    let user_reserve = PORTABLE_USER_MESSAGE_MAX_TOKENS.min(remaining.max(0) / 4);
+    let mut recent = select_recent(
+        &prepared.items[start..],
+        &prepared.tokens[start..],
+        remaining - user_reserve,
+    );
+    let needed = token_count(&keep_user_messages(
+        &collect_annotated_user_messages(&prepared.items[..start + recent.start]),
+        /*summary_text*/ None,
+        user_reserve,
+    ));
+    if needed < user_reserve {
+        recent = select_recent(
+            &prepared.items[start..],
+            &prepared.tokens[start..],
+            remaining - needed,
+        );
+    }
+    let recent_start = start + recent.start;
+    let spare = remaining - prepared.tokens_from(recent_start);
+    let cap = spare.min(PORTABLE_USER_MESSAGE_MAX_TOKENS);
+    // The newest messages have the first claim on the cap.
+    let after_summary = keep_user_messages(
+        &collect_annotated_user_messages(&prepared.items[start..recent_start]),
+        /*summary_text*/ None,
+        cap,
+    );
+    let mut candidate = keep_user_messages(
+        &collect_annotated_user_messages(&prepared.items[..start]),
+        summary_text,
+        cap - token_count(&after_summary),
+    );
+    let earlier_user_messages =
+        candidate.len() > usize::from(summary_text.is_some()) || !after_summary.is_empty();
+    candidate.extend(after_summary);
+    let note = PortableContextNote {
+        after_summary: summary_text.is_some(),
+        earlier_user_messages,
+        recent: recent.kind,
+    };
+    candidate.push(ResponseItemEnvelope::new(ContextualUserFragment::into(
+        note,
+    )));
+    let (items, replaced) = prepared.take_from(recent_start);
+    candidate.extend(items);
+    (candidate, replaced)
+}
+
+pub(super) fn longest_note_tokens(after_summary: bool) -> i64 {
+    rebuild_token_count(&ContextualUserFragment::into(PortableContextNote {
+        after_summary,
+        earlier_user_messages: true,
+        recent: PortableRecentItems::PartialTurn,
+    }))
+}
+
+/// Builds the newest `user_messages` that fit `max_tokens`, as compaction keeps them, followed by
+/// the summary when there is one.
+pub(super) fn keep_user_messages(
+    user_messages: &[CompactedUserMessage],
+    summary_text: Option<&str>,
+    max_tokens: i64,
+) -> Vec<ResponseItemEnvelope> {
+    let max_tokens = max_tokens.max(0);
+    // Compaction limits messages by the runtime's estimate; shrink that limit until the messages
+    // also fit by the rebuild's.
+    let mut limit = usize::try_from(max_tokens).unwrap_or(usize::MAX);
+    loop {
+        let mut history = build_compacted_history_with_limit(
+            Vec::new(),
+            user_messages,
+            summary_text.unwrap_or_default(),
+            limit,
+        );
+        let summary = history.pop();
+        let user_tokens = token_count(&history);
+        if user_tokens <= max_tokens || limit == 0 {
+            if summary_text.is_some() {
+                history.extend(summary);
+            }
+            return history;
+        }
+        let scaled = i64::try_from(limit)
+            .unwrap_or(i64::MAX)
+            .saturating_mul(max_tokens)
+            / user_tokens;
+        limit = usize::try_from(scaled).unwrap_or_default().min(limit - 1);
+    }
+}
+
+/// Where the kept recent items start, relative to the items given, and what they are.
+struct RecentSelection {
+    start: usize,
+    kind: PortableRecentItems,
+}
+
+/// Chooses the newest items that fit `budget_tokens`: whole turns when at least the newest turn
+/// fits, otherwise the newest items of that turn. A tool call and its output are kept or left out
+/// together.
+fn select_recent(
+    items: &[ResponseItemEnvelope],
+    tokens: &[i64],
+    budget_tokens: i64,
+) -> RecentSelection {
+    let mut fits_from = items.len();
+    let mut suffix_tokens = 0;
+    for index in (0..items.len()).rev() {
+        suffix_tokens += tokens[index];
+        if suffix_tokens > budget_tokens {
+            break;
+        }
+        fits_from = index;
+    }
+    let cuts = call_preserving_cuts(items);
+    if let Some(start) = (fits_from..items.len())
+        .find(|&index| cuts[index] && is_user_turn_boundary(&items[index].item))
+    {
+        return RecentSelection {
+            start,
+            kind: PortableRecentItems::WholeTurns,
+        };
+    }
+    match (fits_from..items.len()).find(|&index| cuts[index]) {
+        Some(start) => RecentSelection {
+            start,
+            kind: PortableRecentItems::PartialTurn,
+        },
+        None => RecentSelection {
+            start: items.len(),
+            kind: PortableRecentItems::Nothing,
+        },
+    }
+}
+
+/// `cuts[i]` says whether keeping `items[i..]` keeps every tool call together with its output.
+fn call_preserving_cuts(items: &[ResponseItemEnvelope]) -> Vec<bool> {
+    let mut calls = HashMap::new();
+    // Difference array of how many call/output pairs each cut would separate.
+    let mut separated = vec![0_i32; items.len() + 2];
+    for (index, envelope) in items.iter().enumerate() {
+        match &envelope.item {
+            ResponseItem::FunctionCall { call_id, .. }
+            | ResponseItem::CustomToolCall { call_id, .. }
+            | ResponseItem::LocalShellCall {
+                call_id: Some(call_id),
+                ..
+            }
+            | ResponseItem::ToolSearchCall {
+                call_id: Some(call_id),
+                ..
+            } => {
+                calls.insert(call_id.as_str(), index);
+            }
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                ..
+            }
+            | ResponseItem::CustomToolCallOutput { call_id, .. }
+            | ResponseItem::ToolSearchOutput {
+                call_id: Some(call_id),
+                ..
+            } => {
+                if let Some(&call) = calls.get(call_id.as_str()) {
+                    separated[call + 1] += 1;
+                    separated[index + 1] -= 1;
+                }
+            }
+            _ => {}
+        }
+    }
+    let mut depth = 0;
+    (0..=items.len())
+        .map(|cut| {
+            depth += separated[cut];
+            depth == 0
+        })
+        .collect()
+}
diff --git a/codex-rs/core/src/portable_context/rebuild/start.rs b/codex-rs/core/src/portable_context/rebuild/start.rs
new file mode 100644
index 000000000..ada7cc39a
--- /dev/null
+++ b/codex-rs/core/src/portable_context/rebuild/start.rs
@@ -0,0 +1,154 @@
+//! Where the history a rebuilt context may use starts.
+//!
+//! A new context window deliberately leaves the history before its checkpoint behind, so a switch
+//! must not bring that history back. A thread whose first record is a checkpoint, such as a
+//! subagent or a full-history fork of a compacted parent, inherited everything before it. In both
+//! cases the checkpoint's readable replacement items start the history: plaintext messages as
+//! recorded, and the checkpoint's portable summary in place of native compaction the target
+//! cannot read. A rebuilt checkpoint that wraps a native one carries that one's summary for this.
+
+use codex_history::CheckpointKind;
+use codex_protocol::models::ResponseItem;
+use codex_rollout::TranscriptCheckpoint;
+use codex_rollout::TranscriptCompleteness;
+use codex_rollout::TranscriptItem;
+
+use super::checkpoint_kind;
+use super::portable_summary;
+use super::summary_history;
+use crate::compact::SUMMARY_PREFIX;
+use crate::portable_context::foreign_state::readable_by;
+
+/// The part of a transcript a rebuild may use.
+pub(super) struct UsableHistory {
+    pub(super) items: Vec<TranscriptItem>,
+    pub(super) checkpoints: Vec<TranscriptCheckpoint>,
+    pub(super) checkpoint_families: Vec<Option<String>>,
+    pub(super) gap: HistoryGap,
+    /// The first checkpoint starts the history.
+    pub(super) starts_at_checkpoint: bool,
+}
+
+/// History known to be missing before the usable history.
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum HistoryGap {
+    None,
+    /// An inherited checkpoint's native summary is unreadable; its messages stand in for it.
+    Partial {
+        reason: String,
+    },
+    /// Earlier history is stored elsewhere and nothing stands in for it.
+    Missing {
+        reason: String,
+    },
+}
+
+impl UsableHistory {
+    /// Starts the history at the newest new context window, or else at an inherited first
+    /// checkpoint. `producer_families` gains the family of that checkpoint's items.
+    pub(super) fn new(
+        mut items: Vec<TranscriptItem>,
+        mut checkpoints: Vec<TranscriptCheckpoint>,
+        mut checkpoint_families: Vec<Option<String>>,
+        completeness: TranscriptCompleteness,
+        producer_families: &mut Vec<Option<String>>,
+        target_family: &str,
+    ) -> Self {
+        let inherited_reason = match completeness {
+            TranscriptCompleteness::Complete => None,
+            TranscriptCompleteness::Incomplete { reason } => Some(reason),
+        };
+        let new_window = checkpoints.iter().rposition(|checkpoint| {
+            matches!(
+                checkpoint_kind(checkpoint),
+                Some(CheckpointKind::NewContextWindow)
+            )
+        });
+        let inherited = checkpoints.first().is_some_and(|checkpoint| {
+            inherited_reason.is_some()
+                && checkpoint.items_before == 0
+                && checkpoint.compacted.replacement_history.is_some()
+        });
+        let Some(base) = new_window.or(inherited.then_some(0)) else {
+            return Self {
+                items,
+                checkpoints,
+                checkpoint_families,
+                gap: match inherited_reason {
+                    Some(reason) => HistoryGap::Missing { reason },
+                    None => HistoryGap::None,
+                },
+                starts_at_checkpoint: false,
+            };
+        };
+
+        let mut checkpoints = checkpoints.split_off(base);
+        let checkpoint_families = checkpoint_families.split_off(base);
+        let start = &checkpoints[0];
+        let family = checkpoint_families[0].clone();
+        producer_families.push(family.clone());
+        let producer = Some(producer_families.len() - 1);
+        let summary = portable_summary(start);
+        let mut summary_placed = false;
+        let mut unreadable = false;
+        let mut prefix = Vec::new();
+        for envelope in start.compacted.replacement_history.iter().flatten() {
+            let native_summary = matches!(
+                envelope.item,
+                ResponseItem::Compaction { .. } | ResponseItem::ContextCompaction { .. }
+            );
+            if native_summary && !readable_by(&envelope.item, family.as_deref(), target_family) {
+                match &summary {
+                    Some(summary) if !summary_placed => {
+                        summary_placed = true;
+                        prefix.extend(
+                            summary_history(&format!("{SUMMARY_PREFIX}\n{summary}"))
+                                .into_iter()
+                                .map(|item| TranscriptItem {
+                                    turn_id: None,
+                                    completed: true,
+                                    position: start.position,
+                                    item,
+                                    producer,
+                                }),
+                        );
+                    }
+                    Some(_) => {}
+                    None => unreadable = true,
+                }
+                continue;
+            }
+            prefix.push(TranscriptItem {
+                turn_id: None,
+                completed: true,
+                position: start.position,
+                item: envelope.clone(),
+                producer,
+            });
+        }
+
+        let dropped = start.items_before;
+        let kept = prefix.len();
+        prefix.extend(items.split_off(dropped));
+        for checkpoint in &mut checkpoints {
+            checkpoint.items_before = checkpoint.items_before - dropped + kept;
+        }
+        // A new window leaves earlier history behind on purpose; only inherited history can be
+        // missing.
+        let gap = match inherited_reason.filter(|_| new_window.is_none() && unreadable) {
+            Some(reason) => HistoryGap::Partial {
+                reason: format!(
+                    "{reason}, and only its messages could be carried over to this provider"
+                ),
+            },
+            None => HistoryGap::None,
+        };
+        Self {
+            items: prefix,
+            checkpoints,
+            checkpoint_families,
+            gap,
+            starts_at_checkpoint: true,
+        }
+    }
+}
diff --git a/codex-rs/core/src/portable_context/splice.rs b/codex-rs/core/src/portable_context/splice.rs
new file mode 100644
index 000000000..b0e40420c
--- /dev/null
+++ b/codex-rs/core/src/portable_context/splice.rs
@@ -0,0 +1,452 @@
+//! Lets a provider family take a thread back from the context it last sent.
+//!
+//! Providers cache a prompt by its prefix, per account. When a thread moves from family F to
+//! family X and back, rebuilding F's context from the transcript (see [`super::build_context`])
+//! leaves out the context bundle and model-switch messages F had sent and reinjects new ones, so
+//! F's cached prefix ends at its tools and instructions. Instead, F can send what it last sent
+//! unchanged and append only what happened since:
+//!
+//! 1. **Anchor on leave.** When X takes the thread over, it records a [`ReturnAnchor`] for F in
+//!    the checkpoint that records X's rebuilt context: which transcript records F's context was
+//!    built from (F's base checkpoint and the items after it, up to the newest record), a digest
+//!    of those records as stored, and F's reference turn context and world-state baseline. X
+//!    only records it after rendering those records the way replay does and finding exactly the
+//!    history its replay of F reconstructed.
+//! 2. **Splice on return.** When F takes the thread back, it finds its newest anchor, checks that
+//!    the anchored records are unchanged (same base checkpoint, no other checkpoint among them,
+//!    same digest) and that nothing of F's came later, and renders them with its own limits,
+//!    exactly as its replay would. The other families' turns after the anchor follow, made
+//!    readable for F the way a rebuild makes them (opaque state of other families removed,
+//!    F's limits applied), without their context bundles and model-switch messages, after one
+//!    [`ProviderHandoffNote`]. F's anchored turn context and world state become the baseline, so
+//!    its next turn records only settings changes instead of a new context bundle.
+//!
+//! Any failed check falls back to the rebuild. The spliced context must also fit under the
+//! target's auto-compaction limit with the room a rebuild reserves, so the returning turn does
+//! not start with a compaction; see [`SplicePolicy`].
+
+use codex_history::CheckpointKind;
+use codex_history::PortableCheckpoint;
+use codex_history::ResponseItemEnvelope;
+use codex_history::ReturnAnchor;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::TurnContextItem;
+use codex_rollout::ModelTranscript;
+use codex_rollout::TranscriptCheckpoint;
+use codex_rollout::TranscriptItem;
+use codex_utils_output_truncation::TruncationPolicy;
+use serde_json::Map;
+use serde_json::Value;
+use sha1::Digest;
+use sha1::Sha1;
+
+use super::RebuildBudget;
+use super::TargetProvider;
+use super::budget::rebuild_token_count;
+use super::checkpoint_family;
+use super::foreign_state::readable_by;
+use super::rebuild::Replacements;
+use super::rebuild::carried_summary;
+use super::rebuild::family_at;
+use super::rebuild::is_context_bundle_item;
+use super::rebuild::prepare_for_target;
+use super::recorded_turn_family;
+use crate::config::Config;
+use crate::context::ContextualUserFragment;
+use crate::context::ProviderHandoffNote;
+use crate::context_manager::ContextManager;
+use crate::context_manager::estimate_item_token_count;
+use crate::event_mapping::is_contextual_user_message_content;
+
+/// What the family leaving a thread last sent, as the family taking over reconstructed it.
+pub(crate) struct LeavingContext<'a> {
+    pub(crate) family: &'a str,
+    /// The history replay reconstructed, before media preparation.
+    pub(crate) history: &'a [ResponseItemEnvelope],
+    /// The truncation policy `history` was reconstructed with.
+    pub(crate) truncation_policy: TruncationPolicy,
+    pub(crate) reference_context: Option<&'a TurnContextItem>,
+    pub(crate) world_state: Option<Map<String, Value>>,
+    /// Head hash of the leaving family's last request, when its usage record carries one.
+    pub(crate) request_head: Option<String>,
+}
+
+/// How far a splice may fill the target's context. The target's own earlier context is counted
+/// with the runtime's estimate, the other families' turns with a rebuild's conservative one.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum SplicePolicy {
+    /// Never splice.
+    Off,
+    /// Splice up to this many history tokens.
+    UpTo(i64),
+}
+
+impl SplicePolicy {
+    /// Reads `CODEX_PORTABLE_SPLICE`. By default a splice must stay under the auto-compaction
+    /// limit, less what every request adds (instructions, tool schemas, the new message and the
+    /// response, as a rebuild reserves them), so the returning turn does not start with a
+    /// compaction. `compact` measures against the context window instead, and a context over
+    /// the compaction limit then compacts before its first request, reading a mostly cached
+    /// prefix. `off` disables splicing.
+    pub(crate) fn from_env(
+        auto_compact_limit: Option<i64>,
+        context_window: Option<i64>,
+        base_instructions: &str,
+    ) -> Self {
+        let setting = std::env::var("CODEX_PORTABLE_SPLICE").unwrap_or_default();
+        let limit = match setting.as_str() {
+            "off" => return Self::Off,
+            "compact" => context_window.or(auto_compact_limit),
+            _ => [auto_compact_limit, context_window]
+                .into_iter()
+                .flatten()
+                .min(),
+        };
+        let budget = RebuildBudget::for_limit(limit, base_instructions);
+        Self::UpTo(budget.limit_tokens.saturating_sub(budget.overhead_tokens))
+    }
+}
+
+/// A context spliced from the target's own earlier context and the turns after it.
+#[derive(Debug)]
+pub(crate) struct SplicedContext {
+    pub(crate) items: Vec<ResponseItemEnvelope>,
+    /// Leading items that are the target's own earlier context.
+    pub(crate) prefix_items: usize,
+    pub(crate) reference_context: TurnContextItem,
+    pub(crate) world_state: Map<String, Value>,
+    /// The summary of the checkpoint the target's context started from, for a thread that
+    /// inherits the checkpoint recording this context.
+    pub(crate) portable: Option<PortableCheckpoint>,
+    pub(crate) warnings: Vec<String>,
+    pub(crate) suffix_items: usize,
+    pub(crate) prefix_tokens: i64,
+    pub(crate) suffix_tokens: i64,
+    pub(crate) request_head: Option<String>,
+}
+
+/// Why no splice was made; logged, never shown to the model.
+pub(crate) type SpliceMiss = &'static str;
+
+/// Records where `leaving` left the thread, for its return. `target` is the family taking over.
+pub(crate) fn return_anchor(
+    transcript: &ModelTranscript,
+    config: &Config,
+    target: &TargetProvider,
+    leaving: LeavingContext<'_>,
+) -> Result<ReturnAnchor, SpliceMiss> {
+    let reference_context = leaving.reference_context.ok_or("no_reference_context")?;
+    let world_state = leaving.world_state.ok_or("no_world_state")?;
+    let families = producer_families(transcript, config, target);
+    // Replay starts from the newest checkpoint; it must be the leaving family's own.
+    let base = transcript.checkpoints.last();
+    if let Some(base) = base {
+        check_base(base, &families, leaving.family)?;
+    }
+    let start = base.map_or(0, |base| base.items_before);
+    let items = &transcript.items[start.min(transcript.items.len())..];
+    let cut_position = items
+        .last()
+        .map(|item| item.position)
+        .or_else(|| base.map(|base| base.position))
+        .ok_or("empty_transcript")?;
+    if render(base, items, leaving.truncation_policy) != leaving.history {
+        return Err("replay_mismatch");
+    }
+    Ok(ReturnAnchor {
+        provider_family: leaving.family.to_string(),
+        provider_id: reference_context.model_provider.clone().unwrap_or_default(),
+        model: reference_context.model.clone(),
+        base_position: base.map(|base| base.position),
+        cut_position,
+        items: u64::try_from(items.len()).unwrap_or(u64::MAX),
+        digest: digest(base, items),
+        request_head: leaving.request_head,
+        reference_context: serde_json::to_value(reference_context)
+            .map_err(|_| "unserializable_reference_context")?,
+        world_state,
+    })
+}
+
+/// Splices `target`'s context from its newest return anchor in `transcript`.
+pub(crate) fn splice_context(
+    transcript: &ModelTranscript,
+    config: &Config,
+    target: &TargetProvider,
+    truncation_policy: TruncationPolicy,
+    policy: SplicePolicy,
+) -> Result<SplicedContext, SpliceMiss> {
+    let SplicePolicy::UpTo(max_tokens) = policy else {
+        return Err("disabled");
+    };
+    let anchor = newest_anchor(transcript, &target.family).ok_or("no_anchor")?;
+    let reference_context = serde_json::from_value::<TurnContextItem>(anchor.reference_context)
+        .map_err(|_| "unreadable_anchor")?;
+    let families = producer_families(transcript, config, target);
+    let base = match anchor.base_position {
+        Some(position) => {
+            let base = transcript
+                .checkpoints
+                .iter()
+                .find(|checkpoint| checkpoint.position == position)
+                .ok_or("base_missing")?;
+            check_base(base, &families, &target.family)?;
+            Some(base)
+        }
+        None => None,
+    };
+    let start = base
+        .map_or(0, |base| base.items_before)
+        .min(transcript.items.len());
+    let cut = start
+        + transcript.items[start..].partition_point(|item| item.position <= anchor.cut_position);
+    let (region, after) = (&transcript.items[start..cut], &transcript.items[cut..]);
+
+    // The anchored records must still be exactly the ones the family's context was built from.
+    let base_position = base.map(|base| base.position);
+    if transcript.checkpoints.iter().any(|checkpoint| {
+        base_position.is_none_or(|base| checkpoint.position > base)
+            && checkpoint.position <= anchor.cut_position
+    }) {
+        return Err("checkpoint_in_region");
+    }
+    if u64::try_from(region.len()).ok() != Some(anchor.items)
+        || digest(base, region) != anchor.digest
+    {
+        return Err("digest_mismatch");
+    }
+    // Nothing may have continued the family's own context after the anchor: not a new window,
+    // not one of its own checkpoints or turns.
+    for checkpoint in transcript
+        .checkpoints
+        .iter()
+        .filter(|checkpoint| checkpoint.position > anchor.cut_position)
+    {
+        let kind = checkpoint
+            .compacted
+            .origin
+            .as_ref()
+            .map(|origin| &origin.kind);
+        if matches!(kind, Some(CheckpointKind::NewContextWindow)) {
+            return Err("new_context_window");
+        }
+        let family = checkpoint_family(
+            &checkpoint.compacted,
+            family_at(&families, checkpoint.producer),
+        );
+        if family.as_deref() == Some(target.family.as_str()) {
+            return Err("own_checkpoint_after_anchor");
+        }
+    }
+    // Context a turn injects before recording its turn context counts as the previous turn's, so
+    // only conversation items tell whose turn came after the anchor.
+    if after.iter().any(|item| {
+        !is_injected_context(&item.item.item)
+            && family_at(&families, item.producer) == Some(target.family.as_str())
+    }) {
+        return Err("own_item_after_anchor");
+    }
+
+    let base_family = base.map(|_| target.family.as_str());
+    let readable = base
+        .and_then(|base| base.compacted.replacement_history.as_ref())
+        .into_iter()
+        .flatten()
+        .all(|envelope| readable_by(&envelope.item, base_family, &target.family))
+        && region.iter().all(|item| {
+            readable_by(
+                &item.item.item,
+                family_at(&families, item.producer),
+                &target.family,
+            )
+        });
+    if !readable {
+        return Err("foreign_state_in_prefix");
+    }
+    let mut items = render(base, region, truncation_policy);
+    let prefix_items = items.len();
+    // The prefix is what the target itself last sent and fit its limits, so the runtime's own
+    // estimate sizes it. The other families' turns are sized like a rebuild's, for a tokenizer
+    // that may count them higher.
+    let prefix_tokens = items
+        .iter()
+        .map(|envelope| estimate_item_token_count(&envelope.item))
+        .fold(0, i64::saturating_add);
+
+    let mut replaced = Replacements::default();
+    let mut suffix = Vec::new();
+    let mut suffix_tokens = 0i64;
+    for item in after
+        .iter()
+        .filter(|item| !is_context_bundle_item(&item.item))
+    {
+        let Some((envelope, tokens, item_replaced)) = prepare_for_target(
+            item.item.clone(),
+            family_at(&families, item.producer),
+            &target.family,
+            truncation_policy,
+        ) else {
+            continue;
+        };
+        if is_empty_message(&envelope.item) {
+            continue;
+        }
+        replaced = replaced + item_replaced;
+        suffix_tokens = suffix_tokens.saturating_add(tokens);
+        suffix.push((envelope, item.producer));
+    }
+    let suffix_items = suffix.len();
+    if let Some((_, producer)) = suffix.first() {
+        let provider = producer
+            .and_then(|producer| transcript.producers.get(producer))
+            .map_or("another provider", |producer| producer.model.as_str());
+        let note = ResponseItemEnvelope::new(ContextualUserFragment::into(
+            ProviderHandoffNote::new(provider),
+        ));
+        suffix_tokens = suffix_tokens.saturating_add(rebuild_token_count(&note.item));
+        items.push(note);
+    }
+    items.extend(suffix.into_iter().map(|(envelope, _)| envelope));
+    if prefix_tokens.saturating_add(suffix_tokens) > max_tokens {
+        return Err("over_limit");
+    }
+    let mut warnings = Vec::new();
+    replaced.warn(&mut warnings);
+    Ok(SplicedContext {
+        items,
+        prefix_items,
+        reference_context,
+        world_state: anchor.world_state,
+        portable: base.and_then(carried_summary),
+        warnings,
+        suffix_items,
+        prefix_tokens,
+        suffix_tokens,
+        request_head: anchor.request_head,
+    })
+}
+
+/// The newest anchor any rebuilt checkpoint recorded for `family`.
+fn newest_anchor(transcript: &ModelTranscript, family: &str) -> Option<ReturnAnchor> {
+    transcript.checkpoints.iter().rev().find_map(|checkpoint| {
+        match checkpoint
+            .compacted
+            .origin
+            .as_ref()
+            .map(|origin| &origin.kind)
+        {
+            Some(CheckpointKind::Rebuilt { return_anchors, .. }) => return_anchors
+                .iter()
+                .find(|anchor| anchor.provider_family == family)
+                .cloned(),
+            _ => None,
+        }
+    })
+}
+
+fn producer_families(
+    transcript: &ModelTranscript,
+    config: &Config,
+    target: &TargetProvider,
+) -> Vec<Option<String>> {
+    transcript
+        .producers
+        .iter()
+        .map(|producer| recorded_turn_family(config, producer, target))
+        .collect()
+}
+
+/// A context can start only from a checkpoint of its own family that holds its whole history.
+fn check_base(
+    base: &TranscriptCheckpoint,
+    families: &[Option<String>],
+    family: &str,
+) -> Result<(), SpliceMiss> {
+    if base.compacted.replacement_history.is_none() {
+        return Err("base_without_replacement_history");
+    }
+    let base_family = checkpoint_family(&base.compacted, family_at(families, base.producer));
+    if base_family.as_deref() != Some(family) {
+        return Err("base_of_another_family");
+    }
+    Ok(())
+}
+
+/// Replays a checkpoint's replacement history and the items after it as resume does.
+fn render(
+    base: Option<&TranscriptCheckpoint>,
+    items: &[TranscriptItem],
+    truncation_policy: TruncationPolicy,
+) -> Vec<ResponseItemEnvelope> {
+    let mut history = ContextManager::new();
+    if let Some(replacement) = base.and_then(|base| base.compacted.replacement_history.as_ref()) {
+        history.replace_annotated(replacement.clone());
+    }
+    for item in items {
+        history.record_annotated_items(std::slice::from_ref(&item.item), truncation_policy);
+    }
+    history.into_annotated_items()
+}
+
+/// Digest of a checkpoint's replacement history and the items after it, as stored.
+fn digest(base: Option<&TranscriptCheckpoint>, items: &[TranscriptItem]) -> String {
+    let mut writer = DigestWriter(Sha1::new());
+    writer.0.update(b"codex-return-anchor-v1\0");
+    for envelope in base
+        .and_then(|base| base.compacted.replacement_history.as_ref())
+        .into_iter()
+        .flatten()
+    {
+        writer.add(envelope);
+    }
+    // Separates the checkpoint's items from the ones after it.
+    writer.0.update([0x1d]);
+    for item in items {
+        writer.add(&item.item);
+    }
+    format!("{:x}", writer.0.finalize())
+}
+
+struct DigestWriter(Sha1);
+
+impl DigestWriter {
+    fn add(&mut self, envelope: &ResponseItemEnvelope) {
+        // Serializing an in-memory item cannot fail; a failure would only cause a mismatch.
+        let _ = serde_json::to_writer(&mut *self, &(&envelope.item, &envelope.metadata));
+        self.0.update([0x1e]);
+    }
+}
+
+impl std::io::Write for DigestWriter {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.update(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+/// Developer messages and contextual user messages: context the harness injects, not a turn's
+/// conversation.
+fn is_injected_context(item: &ResponseItem) -> bool {
+    match item {
+        ResponseItem::Message { role, content, .. } => {
+            role == "developer" || (role == "user" && is_contextual_user_message_content(content))
+        }
+        _ => false,
+    }
+}
+
+fn is_empty_message(item: &ResponseItem) -> bool {
+    matches!(item, ResponseItem::Message { content, .. }
+        if content.iter().all(|content| matches!(content,
+            ContentItem::InputText { text } | ContentItem::OutputText { text }
+                if text.trim().is_empty())))
+}
