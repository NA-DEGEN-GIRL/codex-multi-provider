+fn uuid_v7_unix_seconds(id: ThreadId) -> Option<i64> {
+    let uuid = Uuid::parse_str(&id.to_string()).ok()?;
+    if uuid.get_version() != Some(uuid::Version::SortRand) {
+        return None;
+    }
+    let (seconds, _) = uuid.get_timestamp()?.to_unix();
+    i64::try_from(seconds).ok()
+}
+
+/// Reads each rollout's session header on a few threads, returning results in input order.
+///
+/// Unreadable headers yield `None`, matching the sequential reader this replaces.
+fn read_session_headers(rollouts: &[DiscoveredRollout]) -> Vec<Option<SessionMetaLine>> {
+    let next = AtomicUsize::new(0);
+    let read_remaining = || {
+        let mut headers = Vec::new();
+        loop {
+            let index = next.fetch_add(1, Ordering::Relaxed);
+            let Some(rollout) = rollouts.get(index) else {
+                break headers;
+            };
+            let header = crate::list::read_session_meta_line_blocking(rollout.file.path()).ok();
+            headers.push((index, header));
+        }
+    };
+    let workers = rollouts.len().min(MAX_PARALLEL_HEADER_READS);
+    let indexed_headers = std::thread::scope(|scope| {
+        // The calling thread reads too, so the scan still finishes if no helper can start.
+        let mut helpers = Vec::with_capacity(workers.saturating_sub(1));
+        for _ in 1..workers {
+            match std::thread::Builder::new()
+                .name("rollout-header-reader".to_string())
+                .spawn_scoped(scope, read_remaining)
+            {
+                Ok(helper) => helpers.push(helper),
+                Err(_) => break,
+            }
+        }
+        let mut indexed_headers = read_remaining();
+        for helper in helpers {
+            match helper.join() {
+                Ok(helper_headers) => indexed_headers.extend(helper_headers),
+                Err(panic) => std::panic::resume_unwind(panic),
+            }
+        }
+        indexed_headers
+    });
+
+    let mut headers = std::iter::repeat_with(|| None)
+        .take(rollouts.len())
+        .collect::<Vec<_>>();
+    for (index, header) in indexed_headers {
+        headers[index] = header;
+    }
+    headers
+}
