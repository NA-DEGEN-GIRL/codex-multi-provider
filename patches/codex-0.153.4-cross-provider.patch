+#[tokio::test]
+async fn activation_uses_the_complete_source_subtree_despite_target_uuid_collision() {
+    let fixture = ActivationFixture::new().await;
+    let binding = fixture.seed_root().await;
+    let child = ThreadId::new();
+    let closed_grandchild = ThreadId::new();
+    let target_only = ThreadId::new();
+    for (parent, id, status) in [
+        (fixture.root, child, ThreadSpawnEdgeStatus::Open),
+        (child, closed_grandchild, ThreadSpawnEdgeStatus::Closed),
+    ] {
+        fixture.binding(id).await;
+        fixture
+            .source_graph
+            .upsert_thread_spawn_edge(parent, id, status)
+            .await
+            .expect("canonical descendant");
+    }
+    fixture
+        .target_graph
+        .upsert_thread_spawn_edge(fixture.root, target_only, ThreadSpawnEdgeStatus::Open)
+        .await
+        .expect("colliding target topology");
+    let mut expected = vec![fixture.root, child, closed_grandchild];
+    expected.sort_by_key(ToString::to_string);
+    assert_eq!(
+        fixture
+            .manager
+            .managed_activation_thread_ids(&binding)
+            .await
+            .expect("source subtree"),
+        expected,
+    );
+    let grants = expected
+        .iter()
+        .map(|id| (*id, fixture.grant(/*epoch*/ 1)))
+        .collect::<Vec<_>>();
+    assert_eq!(
+        fixture
+            .manager
+            .activate_managed_record_binding(binding, &grants)
+            .await
+            .expect("activate all source descendants"),
+        expected,
+    );
+    let actual = fixture
+        .bindings()
+        .await
+        .into_iter()
+        .map(|(id, source, grant, _)| (id, source, grant))
+        .collect::<Vec<_>>();
+    assert_eq!(
+        actual,
+        expected
+            .iter()
+            .map(|id| (
+                id.to_string(),
+                fixture.source_id.clone(),
+                fixture.grant(/*epoch*/ 1),
+            ))
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(
+        fixture
+            .target_graph
+            .list_thread_spawn_descendants(fixture.root, /*status_filter*/ None)
+            .await
+            .expect("target topology remains separate"),
+        vec![target_only],
+    );
+}
