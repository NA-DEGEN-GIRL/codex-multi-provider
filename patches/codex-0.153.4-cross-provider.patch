+fn user_input(text: &str) -> TurnInput {
+    TurnInput::UserInput {
+        content: vec![UserInput::Text {
+            text: text.to_string(),
+            text_elements: Vec::new(),
+        }],
+        client_id: None,
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn managed_queue_mutations_and_reads_use_the_canonical_source() -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let test = test_codex().build_with_auto_env(&server).await?;
+    let (_source_home, binding) = managed_source().await?;
+    let mut options = StartThreadOptions::new(test.config.clone());
+    options.managed_record_binding = Some(binding.clone());
+    let managed = test.thread_manager.start_thread(options).await?;
+    let thread_id = managed.thread_id;
+    assert_eq!(binding.thread_id(), thread_id);
+    let target_queue = process_queue(&test)?;
+    let service = QueuedItemService::new(
+        Arc::clone(&target_queue),
+        Arc::downgrade(&test.thread_manager),
+        Arc::new(NoopExtensionEventSink),
+    );
+    let source_state = binding.store().state_db().await.context("source state")?;
+    let source_reader = QueuedItemService::new(
+        Arc::new(LocalQueueStore::new(source_state)),
+        Weak::new(),
+        Arc::new(NoopExtensionEventSink),
+    );
+
+    // The manager has no queue lifecycle contributor, so these inputs stay queued.
+    let first = service.enqueue(thread_id, user_input("first")).await?;
+    let second = service.enqueue(thread_id, user_input("second")).await?;
+    let edited = service
+        .update(thread_id, first.id.clone(), user_input("edited first"))
+        .await?
+        .context("canonical queued item disappeared")?;
+    service
+        .reorder(thread_id, vec![second.id.clone(), edited.id.clone()])
+        .await?;
+    assert_eq!(
+        vec![second.clone(), edited.clone()],
+        source_reader.list(thread_id).await?
+    );
+    assert_eq!(
+        vec![edited],
+        service
+            .list_page(thread_id, /*offset*/ 1, /*limit*/ 1)
+            .await?
+    );
+    assert!(service.delete(thread_id, first.id).await?);
+    assert_eq!(vec![second.clone()], service.list(thread_id).await?);
+    assert_eq!(vec![second.clone()], source_reader.list(thread_id).await?);
+    assert!(
+        target_queue
+            .list_page(thread_id, /*offset*/ 0, /*limit*/ 10)
+            .await?
+            .is_empty()
+    );
+
+    assert!(service.delete(thread_id, second.id).await?);
+    managed.thread.close_idle_and_shutdown().await?;
+    // The actor is still registered. Its released write permit must reject late requests.
+    assert!(test.thread_manager.get_thread(thread_id).await.is_ok());
+    assert!(matches!(
+        service.enqueue(thread_id, user_input("late input")).await,
+        Err(QueueServiceError::Storage(
+            ThreadStoreError::Conflict { .. }
+        ))
+    ));
+    assert!(matches!(
+        service
+            .update(thread_id, "missing".to_string(), user_input("late edit"))
+            .await,
+        Err(QueueServiceError::Storage(
+            ThreadStoreError::Conflict { .. }
+        ))
+    ));
+    assert!(matches!(
+        service.delete(thread_id, "missing".to_string()).await,
+        Err(QueueServiceError::Storage(
+            ThreadStoreError::Conflict { .. }
+        ))
+    ));
+    assert!(matches!(
+        service.reorder(thread_id, Vec::new()).await,
+        Err(QueueServiceError::Storage(
+            ThreadStoreError::Conflict { .. }
+        ))
+    ));
+    assert!(source_reader.list(thread_id).await?.is_empty());
+    assert!(
+        target_queue
+            .list_page(thread_id, /*offset*/ 0, /*limit*/ 10)
+            .await?
+            .is_empty()
+    );
+    Ok(())
+}
