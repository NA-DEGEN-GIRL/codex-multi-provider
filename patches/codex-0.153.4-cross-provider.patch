+//! Query-local compatibility for source databases owned by older Codex versions.
+//!
+//! Never migrate a source just to read its catalog. Only optional organization
+//! metadata introduced after the legacy thread schema may be absent.
+
+use sqlx::QueryBuilder;
+use sqlx::Sqlite;
+use sqlx::SqlitePool;
+
+pub(crate) async fn metadata_query(pool: &SqlitePool) -> anyhow::Result<QueryBuilder<Sqlite>> {
+    let columns: Vec<String> = sqlx::query_scalar("SELECT name FROM pragma_table_info('threads')")
+        .fetch_all(pool)
+        .await?;
+    let missing = [
+        "thread_section_id",
+        "section_position",
+        "section_entered_at_ms",
+        "project_id",
+    ]
+    .into_iter()
+    .filter(|name| !columns.iter().any(|column| column == name))
+    .collect::<Vec<_>>();
+    let section_columns: Vec<String> =
+        sqlx::query_scalar("SELECT name FROM pragma_table_info('thread_sections')")
+            .fetch_all(pool)
+            .await?;
+    let mut definitions = Vec::new();
+    if !missing.is_empty() {
+        let defaults = missing
+            .iter()
+            .map(|name| format!("NULL AS {name}"))
+            .collect::<Vec<_>>()
+            .join(", ");
+        definitions.push(format!(
+            "threads AS (SELECT original.*, {defaults} FROM main.threads AS original)"
+        ));
+    }
+    if section_columns.is_empty() {
+        definitions.push(
+            "thread_sections AS (SELECT NULL AS id, NULL AS name, NULL AS appearance WHERE 0)"
+                .to_string(),
+        );
+    } else if !section_columns.iter().any(|name| name == "appearance") {
+        definitions.push(
+            "thread_sections AS (SELECT original.*, NULL AS appearance FROM main.thread_sections AS original)"
+                .to_string(),
+        );
+    }
+    // RECURSIVE also permits the descendant-list query to append its own CTE.
+    Ok(QueryBuilder::new(if definitions.is_empty() {
+        String::new()
+    } else {
+        format!("WITH RECURSIVE {}\n", definitions.join(", "))
+    }))
+}
