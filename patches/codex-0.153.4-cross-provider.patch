@@ -0,0 +1,679 @@
+//! Rebuilds a thread's model context for another provider family; see the parent module.
+
+use codex_context_fragments::set_annotated_content;
+use codex_context_fragments::to_annotated_content;
+use codex_history::CheckpointKind;
+use codex_history::PortableCheckpoint;
+use codex_history::PortableCheckpointStatus;
+use codex_history::PortableCoverage;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_rollout::ModelTranscript;
+use codex_rollout::TranscriptCheckpoint;
+use codex_rollout::TranscriptItem;
+use codex_utils_output_truncation::TruncationPolicy;
+
+use super::RebuildBudget;
+use super::TargetProvider;
+use super::budget::rebuild_token_count;
+use super::checkpoint_family;
+use super::foreign_state::readable_by;
+use super::foreign_state::without_opaque_state;
+use super::recorded_turn_family;
+use crate::compact::SUMMARY_PREFIX;
+use crate::compact::build_compacted_history_with_limit;
+use crate::compact::collect_annotated_user_messages;
+use crate::config::Config;
+use crate::context::ContextualUserFragment;
+use crate::context::ModelSwitchInstructions;
+use crate::context::ProviderHandoffNote;
+use crate::context::RecommendedPluginsInstructions;
+use crate::context::UserInstructions;
+use crate::context::is_contextual_user_fragment;
+use crate::context::world_state::EnvironmentsState;
+use crate::context_manager::ContextManager;
+use crate::event_mapping::is_contextual_dev_message_content;
+
+mod recent;
+mod start;
+
+use recent::keep_recent;
+use recent::keep_user_messages;
+use recent::longest_note_tokens;
+use start::HistoryGap;
+use start::UsableHistory;
+
+/// Replaces an attachment that no longer travels with the thread.
+const MISSING_ATTACHMENT_PLACEHOLDER: &str =
+    "[Attachment unavailable: this image from earlier in the conversation could not be restored.]";
+
+/// Upper bound for user messages kept beside a summary or in place of left-out turns, matching
+/// local compaction.
+const PORTABLE_USER_MESSAGE_MAX_TOKENS: i64 = 20_000;
+
+/// How [`build_context`] rebuilt the model context.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum PortableContextSource {
+    NativeCheckpoint,
+    FullTranscript,
+    PortableCheckpoint,
+    PortableCheckpointWithRecentItems,
+    RecentItemsOnly,
+}
+
+/// Model context rebuilt for another provider family.
+#[derive(Debug)]
+pub(crate) struct PortableContext {
+    pub(crate) items: Vec<ResponseItemEnvelope>,
+    pub(crate) source: PortableContextSource,
+    /// History tokens the rebuilt items were fitted into.
+    pub(crate) budget_tokens: i64,
+    /// User-visible warnings about context that could not be carried over.
+    pub(crate) warnings: Vec<String>,
+    /// For the checkpoint that records a context started from the target's own checkpoint: that
+    /// checkpoint's portable summary, so a thread that inherits the new checkpoint can still
+    /// continue on another family.
+    pub(crate) portable: Option<PortableCheckpoint>,
+}
+
+/// Rebuilds model context for `target` within `budget`.
+///
+/// The transcript is consumed: each item is prepared and sized once, and only the selected items
+/// are kept.
+pub(crate) fn build_context(
+    mut transcript: ModelTranscript,
+    config: &Config,
+    target: &TargetProvider,
+    budget: RebuildBudget,
+    truncation_policy: TruncationPolicy,
+) -> PortableContext {
+    let history_budget = budget.limit_tokens.saturating_sub(budget.overhead_tokens);
+    if super::agent_summary::has_agent_summary(&transcript)
+        && transcript
+            .items
+            .iter()
+            .map(|item| rebuild_token_count(&item.item.item))
+            .sum::<i64>()
+            > history_budget
+    {
+        super::agent_summary::apply_verified_summary(&mut transcript, Some(history_budget));
+    }
+    let ModelTranscript {
+        items,
+        checkpoints,
+        completeness,
+        rejected_checkpoints: _,
+        producers,
+    } = transcript;
+    let mut producer_families = producers
+        .iter()
+        .map(|producer| recorded_turn_family(config, producer, target))
+        .collect::<Vec<_>>();
+    let checkpoint_families = checkpoints
+        .iter()
+        .map(|checkpoint| {
+            checkpoint_family(
+                &checkpoint.compacted,
+                family_at(&producer_families, checkpoint.producer),
+            )
+        })
+        .collect::<Vec<_>>();
+    let UsableHistory {
+        items,
+        checkpoints,
+        checkpoint_families,
+        gap,
+        starts_at_checkpoint,
+    } = UsableHistory::new(
+        items,
+        checkpoints,
+        checkpoint_families,
+        completeness,
+        &mut producer_families,
+        &target.family,
+    );
+    let prepared = PreparedItems::new(items, &producer_families, &target.family, truncation_policy);
+    // The next turn reinjects the context bundle; the largest recorded copy stands in for it.
+    let budget_tokens = budget
+        .limit_tokens
+        .saturating_sub(budget.overhead_tokens)
+        .saturating_sub(prepared.context_bundle_tokens);
+    select_context(
+        prepared,
+        &checkpoints,
+        &checkpoint_families,
+        gap,
+        starts_at_checkpoint,
+        &target.family,
+        budget_tokens,
+    )
+}
+
+pub(super) fn family_at(families: &[Option<String>], producer: Option<usize>) -> Option<&str> {
+    producer
+        .and_then(|index| families.get(index))
+        .and_then(Option::as_deref)
+}
+
+/// What preparing items for the target replaced with placeholders.
+#[derive(Clone, Copy, Debug, Default)]
+pub(super) struct Replacements {
+    attachments: usize,
+    encrypted: usize,
+}
+
+impl Replacements {
+    /// Tells the user what could not be carried over.
+    pub(super) fn warn(self, warnings: &mut Vec<String>) {
+        if self.attachments > 0 {
+            warnings.push(format!(
+                "{} image attachment(s) from earlier in this thread could not be restored and were replaced with placeholders.",
+                self.attachments
+            ));
+        }
+        if self.encrypted > 0 {
+            warnings.push(format!(
+                "{} encrypted message or tool output part(s) from earlier in this thread can only be read by another model provider and were replaced with placeholders.",
+                self.encrypted
+            ));
+        }
+    }
+}
+
+impl std::ops::Add for Replacements {
+    type Output = Self;
+
+    fn add(self, other: Self) -> Self {
+        Self {
+            attachments: self.attachments + other.attachments,
+            encrypted: self.encrypted + other.encrypted,
+        }
+    }
+}
+
+impl std::iter::Sum for Replacements {
+    fn sum<I: Iterator<Item = Self>>(iter: I) -> Self {
+        iter.fold(Self::default(), std::ops::Add::add)
+    }
+}
+
+/// Transcript items prepared for the target, each with its estimated size.
+struct PreparedItems {
+    items: Vec<ResponseItemEnvelope>,
+    tokens: Vec<i64>,
+    replacements: Vec<Replacements>,
+    /// `kept_before[i]` is how many prepared items precede transcript item `i`.
+    kept_before: Vec<usize>,
+    /// Size of the largest recorded context bundle.
+    context_bundle_tokens: i64,
+    /// Limits the items were prepared with; checkpoint items are prepared the same way.
+    truncation_policy: TruncationPolicy,
+}
+
+impl PreparedItems {
+    fn new(
+        items: Vec<TranscriptItem>,
+        producer_families: &[Option<String>],
+        target_family: &str,
+        truncation_policy: TruncationPolicy,
+    ) -> Self {
+        let mut prepared = Self {
+            items: Vec::with_capacity(items.len()),
+            tokens: Vec::with_capacity(items.len()),
+            replacements: Vec::with_capacity(items.len()),
+            kept_before: Vec::with_capacity(items.len() + 1),
+            context_bundle_tokens: 0,
+            truncation_policy,
+        };
+        let mut bundle_tokens = 0;
+        for item in items {
+            prepared.kept_before.push(prepared.items.len());
+            if is_context_bundle_item(&item.item) {
+                bundle_tokens += rebuild_token_count(&item.item.item);
+                prepared.context_bundle_tokens = prepared.context_bundle_tokens.max(bundle_tokens);
+                continue;
+            }
+            bundle_tokens = 0;
+            let producer_family = family_at(producer_families, item.producer);
+            if let Some((envelope, tokens, replaced)) =
+                prepare_for_target(item.item, producer_family, target_family, truncation_policy)
+            {
+                prepared.tokens.push(tokens);
+                prepared.replacements.push(replaced);
+                prepared.items.push(envelope);
+            }
+        }
+        prepared.kept_before.push(prepared.items.len());
+        prepared
+    }
+
+    fn tokens_from(&self, start: usize) -> i64 {
+        self.tokens[start..].iter().sum()
+    }
+
+    /// Takes the prepared items from `start` on and what they had replaced.
+    fn take_from(mut self, start: usize) -> (Vec<ResponseItemEnvelope>, Replacements) {
+        let replaced = self.replacements[start..].iter().copied().sum();
+        (self.items.split_off(start), replaced)
+    }
+}
+
+/// Makes one item readable for the target, applies the target's limits and sizes it. Returns
+/// `None` for an item the target does not receive.
+pub(super) fn prepare_for_target(
+    envelope: ResponseItemEnvelope,
+    producer_family: Option<&str>,
+    target_family: &str,
+    truncation_policy: TruncationPolicy,
+) -> Option<(ResponseItemEnvelope, i64, Replacements)> {
+    let mut replaced = Replacements::default();
+    // Opaque state goes only to the family that can read it; any plaintext stays.
+    let envelope = if readable_by(&envelope.item, producer_family, target_family) {
+        envelope
+    } else {
+        let ResponseItemEnvelope { item, metadata } = envelope;
+        let readable = without_opaque_state(item);
+        replaced.encrypted = readable.placeholders;
+        ResponseItemEnvelope {
+            item: readable.item?,
+            metadata,
+        }
+    };
+    let (envelope, attachments) = prepare_item(envelope, truncation_policy)?;
+    replaced.attachments = attachments;
+    let tokens = rebuild_token_count(&envelope.item);
+    Some((envelope, tokens, replaced))
+}
+
+/// Picks the first of the parent module's steps that fits. `starts_at_checkpoint` means the first
+/// checkpoint starts the usable history, so its summary stands for everything before it whatever
+/// wrote it.
+fn select_context(
+    prepared: PreparedItems,
+    checkpoints: &[TranscriptCheckpoint],
+    checkpoint_families: &[Option<String>],
+    gap: HistoryGap,
+    starts_at_checkpoint: bool,
+    target_family: &str,
+    budget_tokens: i64,
+) -> PortableContext {
+    let truncation_policy = prepared.truncation_policy;
+    let mut warnings = Vec::new();
+    let finish = |items: Vec<ResponseItemEnvelope>,
+                  replaced: Replacements,
+                  source: PortableContextSource,
+                  mut warnings: Vec<String>| {
+        replaced.warn(&mut warnings);
+        PortableContext {
+            items,
+            source,
+            budget_tokens,
+            warnings,
+            portable: None,
+        }
+    };
+
+    // 1. The target's own newest checkpoint and everything after it.
+    if let Some((checkpoint, family)) =
+        checkpoints
+            .iter()
+            .zip(checkpoint_families)
+            .rev()
+            .find(|(checkpoint, family)| {
+                checkpoint.compacted.replacement_history.is_some()
+                    && family.as_deref() == Some(target_family)
+            })
+    {
+        let start = prepared.kept_before[checkpoint.items_before];
+        let mut replacement = Vec::new();
+        let mut replacement_tokens = 0;
+        let mut replacement_replaced = Replacements::default();
+        for envelope in checkpoint
+            .compacted
+            .replacement_history
+            .iter()
+            .flatten()
+            .filter(|envelope| !is_context_bundle_item(envelope))
+        {
+            if let Some((envelope, tokens, replaced)) = prepare_for_target(
+                envelope.clone(),
+                family.as_deref(),
+                target_family,
+                truncation_policy,
+            ) {
+                replacement_tokens += tokens;
+                replacement_replaced = replacement_replaced + replaced;
+                replacement.push(envelope);
+            }
+        }
+        if replacement_tokens.saturating_add(prepared.tokens_from(start)) <= budget_tokens {
+            let (tail, replaced) = prepared.take_from(start);
+            replacement.extend(tail);
+            let mut context = finish(
+                replacement,
+                replacement_replaced + replaced,
+                PortableContextSource::NativeCheckpoint,
+                warnings,
+            );
+            context.portable = carried_summary(checkpoint);
+            return context;
+        }
+    }
+
+    let full_history_available = !matches!(gap, HistoryGap::Missing { .. });
+    if let HistoryGap::Partial { reason } | HistoryGap::Missing { reason } = gap {
+        warnings.push(format!(
+            "Only part of this thread's history is available to the new model: {reason}."
+        ));
+    }
+
+    // 2. The full transcript.
+    if full_history_available && prepared.tokens_from(0) <= budget_tokens {
+        let (items, replaced) = prepared.take_from(0);
+        return finish(
+            items,
+            replaced,
+            PortableContextSource::FullTranscript,
+            warnings,
+        );
+    }
+
+    // Rebuilt contexts summarize nothing, so only compactions can have or lack a summary. The
+    // summary a rebuilt checkpoint carries stands for the checkpoint it started from, which is
+    // part of this history unless the rebuilt checkpoint starts it.
+    let newest_compaction = checkpoints.iter().rposition(is_compaction);
+    let newest_failed = newest_compaction.and_then(|index| failed_reason(&checkpoints[index]));
+    if let Some((checkpoint, summary)) = checkpoints
+        .iter()
+        .enumerate()
+        .rev()
+        .filter(|(index, checkpoint)| {
+            is_compaction(checkpoint) || (*index == 0 && starts_at_checkpoint)
+        })
+        .find_map(|(index, checkpoint)| {
+            portable_summary(checkpoint).map(|summary| (index, summary))
+        })
+    {
+        let start = prepared.kept_before[checkpoints[checkpoint].items_before];
+        if let Some(reason) = newest_failed
+            .as_ref()
+            .filter(|_| Some(checkpoint) != newest_compaction)
+        {
+            warnings.push(format!(
+                "The newest compaction has no portable summary ({reason}); the new model continues from an older summary."
+            ));
+        }
+        let summary_text = format!("{SUMMARY_PREFIX}\n{summary}");
+        let summary_tokens = token_count(&summary_history(&summary_text));
+        let tail_tokens = prepared.tokens_from(start);
+
+        // 3. The newest summary and everything after it.
+        if summary_tokens.saturating_add(tail_tokens) <= budget_tokens {
+            let user_messages = collect_annotated_user_messages(&prepared.items[..start]);
+            let mut candidate = keep_user_messages(
+                &user_messages,
+                Some(&summary_text),
+                (budget_tokens - summary_tokens - tail_tokens)
+                    .min(PORTABLE_USER_MESSAGE_MAX_TOKENS),
+            );
+            let (tail, replaced) = prepared.take_from(start);
+            candidate.extend(tail);
+            return finish(
+                candidate,
+                replaced,
+                PortableContextSource::PortableCheckpoint,
+                warnings,
+            );
+        }
+
+        // 4. The newest summary and the newest items after it that fit.
+        if summary_tokens.saturating_add(longest_note_tokens(/*after_summary*/ true))
+            <= budget_tokens
+        {
+            let (candidate, replaced) =
+                keep_recent(prepared, start, Some(&summary_text), budget_tokens);
+            warnings.push(
+                "Turns after this thread's newest summary do not fit the new model's context; the model was given the summary and only the most recent messages.".to_string(),
+            );
+            return finish(
+                candidate,
+                replaced,
+                PortableContextSource::PortableCheckpointWithRecentItems,
+                warnings,
+            );
+        }
+    }
+
+    // 5. Only the newest items that fit, after a note that earlier context was dropped.
+    if let Some(reason) = newest_failed {
+        warnings.push(format!(
+            "The newest compaction has no portable summary ({reason})."
+        ));
+    }
+    warnings.push(
+        "Earlier parts of this thread do not fit the new model's context and were not carried over; the model was told that older context is missing.".to_string(),
+    );
+    let (candidate, replaced) = keep_recent(prepared, /*start*/ 0, None, budget_tokens);
+    finish(
+        candidate,
+        replaced,
+        PortableContextSource::RecentItemsOnly,
+        warnings,
+    )
+}
+
+/// The history a summary alone compacts to: the summary message.
+fn summary_history(summary_text: &str) -> Vec<ResponseItemEnvelope> {
+    build_compacted_history_with_limit(Vec::new(), &[], summary_text, /*max_tokens*/ 0)
+}
+
+fn checkpoint_kind(checkpoint: &TranscriptCheckpoint) -> Option<&CheckpointKind> {
+    checkpoint
+        .compacted
+        .origin
+        .as_ref()
+        .map(|origin| &origin.kind)
+}
+
+/// Whether a checkpoint summarizes the history before it. Checkpoints written before kinds were
+/// recorded, and kinds from newer runtimes, count as compactions.
+fn is_compaction(checkpoint: &TranscriptCheckpoint) -> bool {
+    !matches!(
+        checkpoint_kind(checkpoint),
+        Some(CheckpointKind::NewContextWindow | CheckpointKind::Rebuilt { .. })
+    )
+}
+
+/// The portable summary of the checkpoint a context started from, as the checkpoint recording
+/// that context carries it. The summary covers what the checkpoint covered; the new checkpoint
+/// writes no output of its own and made no summary request, so the usage and running time stay
+/// on the checkpoint that paid for them.
+pub(super) fn carried_summary(checkpoint: &TranscriptCheckpoint) -> Option<PortableCheckpoint> {
+    portable_summary(checkpoint)?;
+    checkpoint
+        .compacted
+        .portable
+        .as_ref()
+        .map(|portable| PortableCheckpoint {
+            covers: PortableCoverage {
+                position: None,
+                output_items: Some(0),
+                ..portable.covers.clone()
+            },
+            usage: None,
+            elapsed_ms: None,
+            ..portable.clone()
+        })
+}
+
+fn portable_summary(checkpoint: &TranscriptCheckpoint) -> Option<String> {
+    match &checkpoint.compacted.portable {
+        Some(PortableCheckpoint {
+            summary,
+            status: PortableCheckpointStatus::Ready,
+            ..
+        }) if !summary.trim().is_empty() => Some(summary.clone()),
+        Some(_) => None,
+        // Local compaction written before portable summaries existed kept its summary here.
+        None => checkpoint
+            .compacted
+            .message
+            .strip_prefix(SUMMARY_PREFIX)
+            .map(|summary| summary.trim_start_matches('\n').to_string())
+            .filter(|summary| !summary.trim().is_empty()),
+    }
+}
+
+fn failed_reason(checkpoint: &TranscriptCheckpoint) -> Option<String> {
+    match &checkpoint.compacted.portable {
+        Some(PortableCheckpoint {
+            status: PortableCheckpointStatus::Failed { reason },
+            ..
+        }) => Some(reason.clone()),
+        Some(PortableCheckpoint {
+            status: PortableCheckpointStatus::Unknown,
+            ..
+        }) => Some("the summary was written by a newer version".to_string()),
+        _ => None,
+    }
+}
+
+fn token_count(items: &[ResponseItemEnvelope]) -> i64 {
+    items
+        .iter()
+        .map(|envelope| rebuild_token_count(&envelope.item))
+        .sum()
+}
+
+/// Whether an item belongs to the context bundle a full context injection records: permissions,
+/// AGENTS.md, environment, skills and similar settings, and later updates to them.
+///
+/// Upstream leaves these out of compacted history and reinjects one current copy on the next
+/// turn. A rebuilt context resets the reference context the same way, so recorded copies would
+/// only pile up as stale duplicates. Messages an app-server client wrote are kept. A spliced
+/// context's note about another provider's turns is dropped the same way.
+pub(super) fn is_context_bundle_item(envelope: &ResponseItemEnvelope) -> bool {
+    let ResponseItem::Message { role, content, .. } = &envelope.item else {
+        return false;
+    };
+    match role.as_str() {
+        "developer" => {
+            !envelope
+                .metadata
+                .as_ref()
+                .is_some_and(|metadata| metadata.client_authored)
+                && (is_contextual_dev_message_content(content)
+                    || content.iter().any(|content| {
+                        matches!(content, ContentItem::InputText { text }
+                            if ProviderHandoffNote::matches_text(text))
+                    }))
+        }
+        "user" => {
+            content.iter().any(|content| {
+                matches!(content, ContentItem::InputText { text }
+                    if UserInstructions::matches_text(text)
+                        || EnvironmentsState::matches_text(text)
+                        || RecommendedPluginsInstructions::matches_text(text))
+            }) && content.iter().all(is_contextual_user_fragment)
+        }
+        _ => false,
+    }
+}
+
+/// Normalizes one item for the target and applies its tool-output limits. Returns `None` for an
+/// item the target does not receive, and how many image attachments were replaced.
+fn prepare_item(
+    mut envelope: ResponseItemEnvelope,
+    truncation_policy: TruncationPolicy,
+) -> Option<(ResponseItemEnvelope, usize)> {
+    if !remove_model_switch_instructions(&mut envelope) {
+        return None;
+    }
+    let missing = replace_missing_attachments(&mut envelope.item);
+    // Tool outputs are stored as the source model saw them; apply the target's limits here.
+    let mut history = ContextManager::new();
+    history.record_annotated_items(std::slice::from_ref(&envelope), truncation_policy);
+    drop(envelope);
+    history
+        .into_annotated_items()
+        .pop()
+        .map(|envelope| (envelope, missing))
+}
+
+/// Removes earlier model-switch instructions and reports whether anything is left.
+///
+/// They carry a previous model's instructions. The next turn announces the switch to the current
+/// model with that model's own instructions, as upstream does for every model change.
+fn remove_model_switch_instructions(envelope: &mut ResponseItemEnvelope) -> bool {
+    // Taking a message's annotated content moves it out of the message, so a message without
+    // model-switch instructions is left untouched rather than emptied.
+    if !matches!(&envelope.item, ResponseItem::Message { role, content, .. }
+        if role == "developer" && content.iter().any(is_model_switch_instructions))
+    {
+        return true;
+    }
+    let Some(mut content) = to_annotated_content(&mut envelope.item) else {
+        return true;
+    };
+    content.retain(|content| !is_model_switch_instructions(content.content()));
+    !content.is_empty() && set_annotated_content(&mut envelope.item, content).is_some()
+}
+
+fn is_model_switch_instructions(content: &ContentItem) -> bool {
+    match content {
+        ContentItem::InputText { text } => ModelSwitchInstructions::matches_text(text),
+        ContentItem::InputImage { .. }
+        | ContentItem::InputAudio { .. }
+        | ContentItem::OutputText { .. } => false,
+    }
+}
+
+/// Keeps inline images; replaces anything that cannot travel with a placeholder.
+///
+/// Inline data URLs are stored in the rollout, so they move with the thread between hosts. Local
+/// paths do not, and remote URLs are not sent to models by this runtime.
+fn replace_missing_attachments(item: &mut ResponseItem) -> usize {
+    let mut missing = 0;
+    match item {
+        ResponseItem::Message { content, .. } => {
+            for part in content.iter_mut() {
+                if let ContentItem::InputImage { image_url, .. } = part
+                    && !is_portable_image_url(image_url)
+                {
+                    *part = ContentItem::InputText {
+                        text: MISSING_ATTACHMENT_PLACEHOLDER.to_string(),
+                    };
+                    missing += 1;
+                }
+            }
+        }
+        ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } => {
+            if let Some(content) = output.content_items_mut() {
+                for part in content.iter_mut() {
+                    if let FunctionCallOutputContentItem::InputImage { image_url, .. } = part
+                        && !is_portable_image_url(image_url)
+                    {
+                        *part = FunctionCallOutputContentItem::InputText {
+                            text: MISSING_ATTACHMENT_PLACEHOLDER.to_string(),
+                        };
+                        missing += 1;
+                    }
+                }
+            }
+        }
+        _ => {}
+    }
+    missing
+}
+
+fn is_portable_image_url(image_url: &str) -> bool {
+    image_url
+        .get(.."data:".len())
+        .is_some_and(|prefix| prefix.eq_ignore_ascii_case("data:"))
+        && image_url
+            .split_once(',')
+            .is_some_and(|(_, data)| !data.is_empty())
+}
diff --git a/codex-rs/core/src/portable_context/rebuild/recent.rs b/codex-rs/core/src/portable_context/rebuild/recent.rs
