+/// Drops every model-visible record and checkpoint before the newest checkpoint, as a thread that
+/// inherited its parent's latest context records it. Returns that checkpoint's payload.
+fn drop_history_before_newest_checkpoint(codex_home: &Path, thread_id: &str) -> Result<Value> {
+    let mut pending = vec![codex_home.join("sessions")];
+    let mut checkpoints = Vec::new();
+    while let Some(dir) = pending.pop() {
+        for entry in std::fs::read_dir(&dir)? {
+            let path = entry?.path();
+            if path.is_dir() {
+                pending.push(path);
+                continue;
+            }
+            let name = path
+                .file_name()
+                .and_then(|name| name.to_str())
+                .unwrap_or_default();
+            if !name.contains(thread_id) || !name.ends_with(".jsonl") {
+                continue;
+            }
+            let contents = std::fs::read_to_string(&path)?;
+            let records = contents
+                .lines()
+                .map(serde_json::from_str::<Value>)
+                .collect::<std::result::Result<Vec<_>, _>>()?;
+            let newest = records
+                .iter()
+                .rposition(|record| record["type"] == "compacted")
+                .expect("a checkpoint");
+            let kept = contents
+                .lines()
+                .zip(&records)
+                .enumerate()
+                .filter(|(index, (_, record))| {
+                    *index >= newest
+                        || !matches!(
+                            record["type"].as_str().unwrap_or_default(),
+                            "response_item" | "event_msg" | "compacted"
+                        )
+                })
+                .map(|(_, (line, _))| line)
+                .collect::<Vec<_>>();
+            std::fs::write(&path, kept.join("\n") + "\n")?;
+            checkpoints.push(records[newest]["payload"].clone());
+        }
+    }
+    assert_eq!(checkpoints.len(), 1, "expected one rollout for {thread_id}");
+    Ok(checkpoints.remove(0))
+}
