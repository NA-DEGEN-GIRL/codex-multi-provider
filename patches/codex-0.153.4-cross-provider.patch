+#[tokio::test]
+async fn resume_reloads_stale_preflight_under_a_retained_exclusive_writer_reservation() {
+    let fixture = ManagedRecordFixture::new().await;
+    let binding = fixture.independent_binding().await;
+    let competitor = fixture.independent_binding().await;
+    assert!(binding.store().state_db().await.is_none());
+    assert!(competitor.store().state_db().await.is_none());
+    let stale = serde_json::to_value(&fixture.stale_history).expect("stale history");
+
+    let (store, reservation, refreshed) =
+        prepare_managed_record(binding, fixture.stale_history.clone())
+            .await
+            .expect("prepare source after intervening write");
+
+    let expected = InitialHistory::Resumed(ResumedHistory {
+        conversation_id: fixture.thread_id,
+        history: Arc::new(fixture.latest_context),
+        rollout_path: Some(fixture.rollout_path),
+    });
+    let actual = serde_json::to_value(&refreshed).expect("refreshed history");
+    assert_eq!(
+        actual,
+        serde_json::to_value(expected).expect("latest history")
+    );
+    assert_ne!(
+        actual, stale,
+        "preflight must be replaced by the intervening persisted turn"
+    );
+    assert!(store.state_db().await.is_some());
+    assert!(matches!(
+        competitor.prepare_writer().await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(competitor.store().state_db().await.is_none());
+
+    drop(reservation);
+    let next_reservation = competitor
+        .prepare_writer()
+        .await
+        .expect("released preparation permits the next writer");
+    assert!(competitor.store().state_db().await.is_some());
+    drop(next_reservation);
+}
