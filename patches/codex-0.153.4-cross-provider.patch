+//! Native projection parity while the source checkpoint is missing.
+
+use super::*;
+use pretty_assertions::assert_eq;
+use std::io::Write;
+
+async fn private_reader(fixture: &PaginatedFixture) -> ReadOnlyLocalThreadStore {
+    ReadOnlyLocalThreadStore::open(
+        fixture.home.path().to_path_buf(),
+        test_config(fixture.home.path()).sqlite,
+    )
+    .await
+    .expect("open metadata read-only")
+    .with_private_history_projection(Arc::default())
+    .unwrap()
+}
+
+async fn remove_checkpoint(fixture: &PaginatedFixture) {
+    sqlx::query("DELETE FROM thread_history_projection_state")
+        .execute(
+            fixture
+                .store
+                .thread_history_db()
+                .await
+                .expect("fixture history"),
+        )
+        .await
+        .expect("simulate missing checkpoint in fixture only");
+}
+
+#[tokio::test]
+async fn private_cache_shares_only_its_bound_source_and_closing_one_reader_keeps_other_readers() {
+    let fixture = paginated_fixture().await;
+    let other = paginated_fixture().await;
+    let cache = Arc::new(super::super::PrivateHistoryProjection::default());
+    let one = ReadOnlyLocalThreadStore::open(
+        fixture.home.path().to_path_buf(),
+        test_config(fixture.home.path()).sqlite,
+    )
+    .await
+    .unwrap()
+    .with_private_history_projection(Arc::clone(&cache))
+    .unwrap();
+    assert_eq!(
+        turn_ids(
+            &one.list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .unwrap()
+        ),
+        vec!["turn-1", "turn-2"]
+    );
+    one.close().await;
+    drop(one);
+    let two = ReadOnlyLocalThreadStore::open(
+        fixture.home.path().to_path_buf(),
+        test_config(fixture.home.path()).sqlite,
+    )
+    .await
+    .unwrap()
+    .with_private_history_projection(Arc::clone(&cache))
+    .unwrap();
+    assert_eq!(
+        turn_ids(
+            &two.list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .unwrap()
+        ),
+        vec!["turn-1", "turn-2"]
+    );
+    let foreign = ReadOnlyLocalThreadStore::open(
+        other.home.path().to_path_buf(),
+        test_config(other.home.path()).sqlite,
+    )
+    .await
+    .unwrap()
+    .with_private_history_projection(cache);
+    assert!(foreign.is_err());
+    two.close().await;
+}
+
+#[tokio::test]
+async fn private_projection_recovers_missing_checkpoint_with_native_turn_item_and_timeline_parity()
+{
+    for compressed in [false, true] {
+        let fixture = paginated_fixture().await;
+        let expected_turns = fixture
+            .store
+            .list_turns(turn_params(fixture.thread_id, None, 10))
+            .await
+            .unwrap()
+            .turns;
+        let expected_items = fixture
+            .store
+            .list_items(item_params(fixture.thread_id, None, 10))
+            .await
+            .unwrap()
+            .items;
+        let expected_timeline = fixture
+            .store
+            .list_timeline(ListTimelineParams {
+                thread_id: fixture.thread_id,
+                cursor: None,
+                page_size: 100,
+            })
+            .await
+            .unwrap()
+            .items;
+        remove_checkpoint(&fixture).await;
+        if compressed {
+            let body = fs::read(&fixture.rollout_path).unwrap();
+            fs::write(
+                fixture.rollout_path.with_extension("jsonl.zst"),
+                zstd::encode_all(body.as_slice(), 0).unwrap(),
+            )
+            .unwrap();
+            fs::remove_file(&fixture.rollout_path).unwrap();
+        }
+        let before = source_snapshot(fixture.home.path());
+        let reader = private_reader(&fixture).await;
+        let first = reader
+            .list_turns(turn_params(fixture.thread_id, None, 1))
+            .await
+            .unwrap();
+        let second = reader
+            .list_turns(turn_params(fixture.thread_id, first.next_cursor, 1))
+            .await
+            .unwrap();
+        let mut actual = first.turns;
+        actual.extend(second.turns);
+        assert_eq!(
+            serde_json::to_value(actual).unwrap(),
+            serde_json::to_value(expected_turns).unwrap()
+        );
+        assert_eq!(
+            reader
+                .list_items(item_params(fixture.thread_id, None, 10))
+                .await
+                .unwrap()
+                .items,
+            expected_items
+        );
+        assert_eq!(
+            reader
+                .list_timeline(ListTimelineParams {
+                    thread_id: fixture.thread_id,
+                    cursor: None,
+                    page_size: 100,
+                })
+                .await
+                .unwrap()
+                .items,
+            expected_timeline
+        );
+        let strict = ReadOnlyLocalThreadStore::open(
+            fixture.home.path().to_path_buf(),
+            test_config(fixture.home.path()).sqlite,
+        )
+        .await
+        .unwrap();
+        assert!(
+            strict
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .is_err()
+        );
+        strict.close().await;
+        reader.close().await;
+        assert_source_unchanged(fixture.home.path(), &before);
+    }
+}
+
+#[tokio::test]
+async fn private_projection_never_creates_a_missing_source_history_database() {
+    let fixture = paginated_fixture().await;
+    let sqlite = test_config(fixture.home.path()).sqlite;
+    fixture
+        .store
+        .thread_history_db()
+        .await
+        .unwrap()
+        .close()
+        .await;
+    let saved = TempDir::new().unwrap();
+    fs::rename(
+        sqlite.thread_history_db_path(),
+        saved.path().join("fixture-history.sqlite"),
+    )
+    .unwrap();
+    let before = source_snapshot(fixture.home.path());
+    let reader = private_reader(&fixture).await;
+    assert_eq!(
+        turn_ids(
+            &reader
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .unwrap()
+        ),
+        vec!["turn-1", "turn-2"]
+    );
+    reader.close().await;
+    assert_source_unchanged(fixture.home.path(), &before);
+    assert!(!sqlite.thread_history_db_path().exists());
+}
+
+#[tokio::test]
+async fn private_projection_waits_for_complete_lines_and_reads_new_durable_appends() {
+    let fixture = paginated_fixture().await;
+    remove_checkpoint(&fixture).await;
+    let reader = private_reader(&fixture).await;
+    assert_eq!(
+        turn_ids(
+            &reader
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .unwrap()
+        ),
+        vec!["turn-1", "turn-2"]
+    );
+    let original = fs::read_to_string(&fixture.rollout_path).unwrap();
+    let last: serde_json::Value = serde_json::from_str(original.lines().last().unwrap()).unwrap();
+    let start = last["ordinal"].as_u64().unwrap() + 1;
+    let append = completed_turn(fixture.thread_id, "turn-3")
+        .into_iter()
+        .enumerate()
+        .map(|(offset, item)| {
+            let mut line = serde_json::to_value(item).unwrap();
+            line["ordinal"] = (start + offset as u64).into();
+            line["timestamp"] = "2026-09-14T00:00:00Z".into();
+            serde_json::to_string(&line).unwrap() + "\n"
+        })
+        .collect::<String>();
+    let mut file = fs::OpenOptions::new()
+        .append(true)
+        .open(&fixture.rollout_path)
+        .unwrap();
+    file.write_all(&append.as_bytes()[..10]).unwrap();
+    file.flush().unwrap();
+    let before = source_snapshot(fixture.home.path());
+    assert_eq!(
+        turn_ids(
+            &reader
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .unwrap()
+        ),
+        vec!["turn-1", "turn-2"]
+    );
+    assert_source_unchanged(fixture.home.path(), &before);
+    file.write_all(&append.as_bytes()[10..]).unwrap();
+    file.flush().unwrap();
+    let before = source_snapshot(fixture.home.path());
+    assert_eq!(
+        turn_ids(
+            &reader
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .unwrap()
+        ),
+        vec!["turn-1", "turn-2", "turn-3"]
+    );
+    reader.close().await;
+    assert_source_unchanged(fixture.home.path(), &before);
+}
+
+#[tokio::test]
+async fn private_projection_follows_revert_lineage_and_invalidates_old_cursors() {
+    let fixture = paginated_fixture().await;
+    let reader = private_reader(&fixture).await;
+    let cursor = reader
+        .list_turns(turn_params(fixture.thread_id, None, 1))
+        .await
+        .unwrap()
+        .next_cursor;
+    fixture
+        .store
+        .revert_thread(RevertThreadParams {
+            thread_id: fixture.thread_id,
+            before_turn_id: "turn-2".to_string(),
+        })
+        .await
+        .unwrap();
+    remove_checkpoint(&fixture).await;
+    // A branch's frozen prefix must not inspect a later invalid/unreadable ordinal
+    // range of its ancestor. The original rollout remains present after revert.
+    let mut excluded =
+        serde_json::to_value(completed_turn(fixture.thread_id, "excluded").remove(0)).unwrap();
+    excluded["ordinal"] = 999999.into();
+    excluded["timestamp"] = "2026-09-14T00:00:00Z".into();
+    writeln!(
+        fs::OpenOptions::new()
+            .append(true)
+            .open(&fixture.rollout_path)
+            .unwrap(),
+        "{excluded}"
+    )
+    .unwrap();
+    let before = source_snapshot(fixture.home.path());
+    assert!(
+        reader
+            .list_turns(turn_params(fixture.thread_id, cursor, 10))
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        turn_ids(
+            &reader
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .unwrap()
+        ),
+        vec!["turn-1"]
+    );
+    reader.close().await;
+    assert_source_unchanged(fixture.home.path(), &before);
+}
