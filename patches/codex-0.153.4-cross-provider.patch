+
+async fn resume_binding(binding: &ManagedThreadBinding, home: &std::path::Path) -> LiveThread {
+    let reservation = binding
+        .prepare_writer()
+        .await
+        .expect("reserve source writer");
+    let context = binding
+        .store()
+        .load_latest_model_context(LoadThreadHistoryParams {
+            thread_id: binding.thread_id(),
+            include_archived: true,
+        })
+        .await
+        .expect("canonical model context under writer reservation");
+    let live = LiveThread::resume(
+        binding.store(),
+        ThreadHistoryMode::Paginated,
+        ResumeThreadParams {
+            thread_id: binding.thread_id(),
+            rollout_path: None,
+            history: Some(Arc::new(context.items)),
+            include_archived: true,
+            metadata: metadata(home),
+        },
+    )
+    .await
+    .expect("canonical writer");
+    drop(reservation);
+    live
+}
