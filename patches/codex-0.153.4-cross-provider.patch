+#[tokio::test]
+async fn managed_status_reports_queued_input_without_consuming_it() -> Result<()> {
+    let (complete_tx, complete_rx) = oneshot::channel();
+    let (server, _) = start_streaming_sse_server(vec![vec![
+        StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![responses::ev_response_created("queued")]),
+        },
+        StreamingSseChunk {
+            gate: Some(complete_rx),
+            body: responses::sse(vec![responses::ev_completed("queued")]),
+        },
+    ]])
+    .await;
+    let profile = ManagedProfile::new(server.uri())?;
+    let mut app = profile.start_server().await?;
+    let thread_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let started = start_turn(&mut app, &thread_id).await?;
+    timeout(READ_TIMEOUT, server.wait_for_request_count(1)).await?;
+    let queued: ThreadQueueAddResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueAdd {
+            request_id,
+            params: ThreadQueueAddParams {
+                thread_id: thread_id.clone(),
+                client_user_message_id: "idle-status-queued-input".to_string(),
+                input: vec![UserInput::Text {
+                    text: "Keep this submission in the queue".to_string(),
+                    text_elements: Vec::new(),
+                }],
+            },
+        })
+        .await?;
+
+    let status = snapshot(&mut app, &thread_id).await?;
+    assert_advisory_identity(&status, &profile, &thread_id);
+    assert_eq!(status["idle"], false);
+    assert!(
+        status["blockers"]
+            .as_array()
+            .context("blocker array")?
+            .contains(&json!({ "threadId": thread_id, "kind": "queuedUserInput" }))
+    );
+    let queue_after: ThreadQueueListResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueList {
+            request_id,
+            params: ThreadQueueListParams {
+                thread_id: thread_id.clone(),
+                cursor: None,
+                limit: None,
+            },
+        })
+        .await?;
+    assert_eq!(queue_after.data, vec![queued.queued_submission.clone()]);
+    assert_eq!(server.requests().await.len(), 1);
+
+    // Remove the deliberately queued submission through its normal API before
+    // completing the active stream; the snapshot itself never drains it.
+    let deleted: ThreadQueueDeleteResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueDelete {
+            request_id,
+            params: ThreadQueueDeleteParams {
+                thread_id: thread_id.clone(),
+                queued_submission_id: queued.queued_submission.id,
+            },
+        })
+        .await?;
+    assert!(deleted.deleted);
+    complete_tx
+        .send(())
+        .expect("snapshot left the active turn intact");
+    assert_completed(&mut app, &thread_id, &started.turn.id).await?;
+    assert_eq!(server.requests().await.len(), 1);
+    server.shutdown().await;
+    Ok(())
+}
