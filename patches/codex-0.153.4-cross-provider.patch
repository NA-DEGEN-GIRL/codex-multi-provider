+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn temporary_history_indexes_are_unnamed_independent_and_keep_their_connection() {
+    let one = super::open_temporary_thread_history_db()
+        .await
+        .expect("first private index");
+    let two = super::open_temporary_thread_history_db()
+        .await
+        .expect("second private index");
+    let databases: Vec<(i64, String, String)> = sqlx::query_as("PRAGMA database_list")
+        .fetch_all(&one)
+        .await
+        .expect("private database identity");
+    assert_eq!(databases, vec![(0, "main".to_string(), String::new())]);
+    sqlx::query("INSERT INTO thread_history_projection_state (thread_id, next_rollout_byte_offset, next_rollout_ordinal) VALUES ('fixture', 17, 2)")
+        .execute(&one).await.expect("write private checkpoint");
+    let first: Vec<(String, i64, i64)> = sqlx::query_as("SELECT thread_id, next_rollout_byte_offset, next_rollout_ordinal FROM thread_history_projection_state")
+        .fetch_all(&one).await.expect("same connection retains schema and data");
+    let second: Vec<(String, i64, i64)> = sqlx::query_as("SELECT thread_id, next_rollout_byte_offset, next_rollout_ordinal FROM thread_history_projection_state")
+        .fetch_all(&two).await.expect("other index stays empty");
+    assert_eq!(first, vec![("fixture".to_string(), 17, 2)]);
+    assert_eq!(second, Vec::new());
+    one.close().await;
+    two.close().await;
+}
