+        .await
+        .expect("worker");
+    persist_thread_for_tree_resume(&worker_thread, "worker ready before close").await;
+    persist_thread_for_tree_resume(&root, "root ready before close").await;
+    let graph = LocalAgentGraphStore::new(binding.store().state_db().await.expect("canonical DB"));
+    let before = harness.manager.list_thread_ids().await;
+    let close_reservation = root
+        .try_reserve_idle_close()
+        .expect("seal root before subtree snapshot");
+    let source = thread_spawn_source(
+        worker.thread_id,
+        &worker_thread.session_source,
+        next_thread_spawn_depth(&worker_thread.session_source),
+        None,
+        Some("too_late".to_string()),
+    )
+    .expect("nested source");
+    let result = control
+        .spawn_agent_with_metadata(
+            harness.config.clone(),
+            text_input("must never run"),
+            Some(source),
+            SpawnAgentOptions {
+                parent_thread_id: Some(worker.thread_id),
+                ..Default::default()
+            },
+        )
+        .await;
+    assert!(
+        result.is_err(),
+        "a sealed ancestor must reject direct nested child activation"
+    );
+    assert_eq!(harness.manager.list_thread_ids().await, before);
+    assert!(
+        graph
+            .list_thread_spawn_children(worker.thread_id, None)
+            .await
+            .expect("worker graph")
+            .is_empty()
+    );
+    assert_eq!(
+        graph
+            .list_thread_spawn_children(root_id, None)
+            .await
+            .expect("root graph"),
+        vec![worker.thread_id]
+    );
+    assert!(
+        control
+            .state
+            .agent_id_for_path(&AgentPath::try_from("/root/worker/too_late").expect("path"))
+            .is_none()
+    );
+
+    // Another root in the same ThreadManager retains independent admission and source authority.
+    let registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        binding.authority_grant().owner_profile_id.clone(),
+        vec![ManagedSourceRegistration {
+            source_id: binding.source_id().clone(),
+            config: binding.source_config().clone(),
+        }],
+    )
+    .expect("same managed source");
+    let other_id = ThreadId::new();
+    let other_binding = registry
+        .bind_new(binding.source_id(), other_id)
+        .await
+        .expect("independent root");
+    let other = harness
+        .manager
+        .start_thread(StartThreadOptions {
+            managed_record_binding: Some(other_binding),
+            history_mode: Some(ThreadHistoryMode::Paginated),
+            environments: Some(Vec::new()),
+            ..StartThreadOptions::new(harness.config.clone())
+        })
+        .await
+        .expect("another root starts while the first is sealed");
+    let other_control = other.thread.session.services.agent_control.clone();
+    let independent_child = spawn_v2_reload_test_child(
+        &other_control,
+        harness.config.clone(),
+        &other.thread,
+        "independent",
+    )
+    .await;
+    assert!(
+        harness
+            .manager
+            .get_thread(independent_child.thread_id)
+            .await
+            .is_ok()
+    );
+    assert_eq!(
+        graph
+            .list_thread_spawn_children(other_id, None)
+            .await
+            .expect("independent graph"),
+        vec![independent_child.thread_id]
+    );
+    drop(close_reservation);
+    stop_all_managed_test_threads(&harness.manager).await;
+}
+
+#[tokio::test]
+async fn managed_root_close_reservation_blocks_lazy_reload_and_activity_blocks_reservation() {
+    let harness = managed_v2_harness().await;
+    let (root_id, root, _) = start_canonical_root(&harness).await;
+    let control = root.session.services.agent_control.clone();
+    let child = spawn_v2_reload_test_child(&control, harness.config.clone(), &root, "worker").await;
+    let child_thread = harness
+        .manager
+        .get_thread(child.thread_id)
+        .await
+        .expect("worker");
+    persist_thread_for_tree_resume(&child_thread, "worker survives dormant reload").await;
+    child_thread
+        .shutdown_and_wait()
+        .await
+        .expect("unload worker");
+    assert!(
+        harness
+            .manager
+            .remove_thread(&child.thread_id)
+            .await
+            .is_some()
+    );
+    persist_thread_for_tree_resume(&root, "root ready for lazy reload check").await;
+    let close_reservation = root.try_reserve_idle_close().expect("reserve root close");
+    assert!(
+        control
+            .ensure_v2_agent_loaded(harness.config.clone(), child.thread_id, None)
+            .await
+            .is_err()
+    );
+    assert_thread_not_loaded(&harness.manager, child.thread_id).await;
+    assert!(
+        harness
+            .manager
+            .managed_record_binding(child.thread_id)
+            .await
+            .expect("dormant binding")
+            .is_released()
+    );
+    drop(close_reservation);
+
+    let manager_state = control.upgrade().expect("manager remains available");
+    let admission = control
+        .admit_managed_child_activation(&manager_state, Some(root_id), Some(child.thread_id), false)
+        .await
+        .expect("admit canonical child activation");
+    assert!(
+        root.try_reserve_idle_close().is_err(),
+        "close must not inventory a tree while activation is admitted"
+    );
+    drop(admission);
+    control
+        .ensure_v2_agent_loaded(
+            harness.config.clone(),
+            child.thread_id,
+            Some(Arc::clone(&root)),
+        )
+        .await
+        .expect("dropping an unused close reservation permits lazy reload");
+    assert!(harness.manager.get_thread(child.thread_id).await.is_ok());
+    stop_all_managed_test_threads(&harness.manager).await;
+}
