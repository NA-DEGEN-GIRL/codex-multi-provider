diff --git a/codex-rs/app-server/src/managed_activation_gate_tests.rs b/codex-rs/app-server/src/managed_activation_gate_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f70cc2c97e5966bd9cdb8ca648c8ce41eb71316d
--- /dev/null
+++ b/codex-rs/app-server/src/managed_activation_gate_tests.rs
@@ -0,0 +1,205 @@
+use super::*;
+
+fn snapshot(gate: &ManagedRequestGate, id: ThreadId) -> (bool, bool, Option<u64>) {
+    let locks = gate.locks(&[id]);
+    let state = locks[0].try_read().unwrap();
+    (state.frozen, state.release_verified, state.activated_epoch)
+}
+
+fn release(gate: &ManagedRequestGate, ids: &[ThreadId]) {
+    let mut drain = gate.try_drain(ids).unwrap();
+    drain.arm();
+    drain.commit();
+}
+
+#[test]
+fn activation_reserves_admission_until_commit() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+    let other = ThreadId::new();
+
+    // Source authority is verified by the caller before this local gate API.
+    let activation = gate.try_activate(&[(id, 1)]).unwrap();
+    assert!(gate.begin_threads(vec![id]).is_err());
+    assert!(gate.try_drain(&[id]).is_err());
+    assert!(gate.try_activate(&[(id, 2)]).is_err());
+    assert!(gate.begin_threads(vec![other]).is_ok());
+
+    activation.commit();
+    assert!(gate.begin_threads(vec![id]).is_ok());
+    assert_eq!(snapshot(&gate, id), (false, false, Some(1)));
+}
+
+#[test]
+fn verified_release_reopens_only_at_a_strictly_newer_epoch() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+    gate.try_activate(&[(id, 5)]).unwrap().commit();
+    release(&gate, &[id]);
+
+    for stale_epoch in [1, 4, 5] {
+        assert!(gate.try_activate(&[(id, stale_epoch)]).is_err());
+        assert!(gate.begin_threads(vec![id]).is_err());
+        assert_eq!(snapshot(&gate, id), (true, true, Some(5)));
+    }
+
+    gate.try_activate(&[(id, 6)]).unwrap().commit();
+    assert!(gate.begin_threads(vec![id]).is_ok());
+    assert_eq!(snapshot(&gate, id), (false, false, Some(6)));
+    assert!(gate.try_activate(&[(id, 5)]).is_err());
+    assert!(gate.try_activate(&[(id, 6)]).is_err());
+}
+
+#[test]
+fn even_a_newer_epoch_cannot_clear_an_uncertain_release() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+    gate.try_activate(&[(id, 5)]).unwrap().commit();
+    let mut drain = gate.try_drain(&[id]).unwrap();
+    drain.arm();
+    drop(drain);
+
+    assert!(gate.try_activate(&[(id, u64::MAX)]).is_err());
+    assert!(gate.begin_threads(vec![id]).is_err());
+    assert_eq!(snapshot(&gate, id), (true, false, Some(5)));
+}
+
+#[test]
+fn cancelled_activation_preserves_the_verified_release_and_epoch() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+    gate.try_activate(&[(id, 3)]).unwrap().commit();
+    release(&gate, &[id]);
+
+    drop(gate.try_activate(&[(id, 4)]).unwrap());
+    assert!(gate.begin_threads(vec![id]).is_err());
+    assert_eq!(snapshot(&gate, id), (true, true, Some(3)));
+
+    // A failed Core binding refresh must not consume the new grant locally.
+    gate.try_activate(&[(id, 4)]).unwrap().commit();
+    assert!(gate.begin_threads(vec![id]).is_ok());
+}
+
+#[test]
+fn cancelled_first_activation_does_not_consume_its_epoch() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+
+    drop(gate.try_activate(&[(id, 1)]).unwrap());
+    assert_eq!(snapshot(&gate, id), (false, false, None));
+    gate.try_activate(&[(id, 1)]).unwrap().commit();
+    assert_eq!(snapshot(&gate, id), (false, false, Some(1)));
+}
+
+#[test]
+fn active_requests_and_drains_prevent_activation_without_blocking_other_ids() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+    let other = ThreadId::new();
+    let request = gate.begin_threads(vec![id]).unwrap();
+    assert!(gate.try_activate(&[(id, 1)]).is_err());
+    assert!(gate.begin_threads(vec![other]).is_ok());
+    drop(request);
+
+    let drain = gate.try_drain(&[id]).unwrap();
+    assert!(gate.try_activate(&[(id, 1)]).is_err());
+    assert!(gate.begin_threads(vec![other]).is_ok());
+    drop(drain);
+
+    gate.try_activate(&[(id, 1)]).unwrap().commit();
+    assert!(gate.begin_threads(vec![id]).is_ok());
+}
+
+#[test]
+fn activating_one_id_does_not_reopen_another_released_id() {
+    let gate = ManagedRequestGate::default();
+    let parent = ThreadId::new();
+    let child = ThreadId::new();
+    gate.try_activate(&[(parent, 1), (child, 1)])
+        .unwrap()
+        .commit();
+    release(&gate, &[parent, child]);
+
+    gate.try_activate(&[(parent, 2)]).unwrap().commit();
+    assert!(gate.begin_threads(vec![parent]).is_ok());
+    assert!(gate.begin_threads(vec![child]).is_err());
+    assert_eq!(snapshot(&gate, child), (true, true, Some(1)));
+}
+
+#[test]
+fn stale_epoch_in_a_batch_preserves_every_fence_and_releases_acquired_locks() {
+    let gate = ManagedRequestGate::default();
+    let mut ids = [ThreadId::new(), ThreadId::new()];
+    ids.sort_by_key(ToString::to_string);
+    let [first, second] = ids;
+    gate.try_activate(&[(first, 2), (second, 2)])
+        .unwrap()
+        .commit();
+    release(&gate, &ids);
+
+    // Sorting ensures the first lock was acquired before the stale entry fails.
+    assert!(gate.try_activate(&[(first, 3), (second, 2)]).is_err());
+    for id in ids {
+        assert_eq!(snapshot(&gate, id), (true, true, Some(2)));
+        assert!(gate.begin_threads(vec![id]).is_err());
+    }
+
+    gate.try_activate(&[(first, 3), (second, 3)])
+        .unwrap()
+        .commit();
+    assert!(gate.begin_threads(ids.to_vec()).is_ok());
+}
+
+#[test]
+fn uncertain_member_of_a_batch_cannot_partially_reopen_verified_members() {
+    let gate = ManagedRequestGate::default();
+    let mut ids = [ThreadId::new(), ThreadId::new()];
+    ids.sort_by_key(ToString::to_string);
+    let [first, second] = ids;
+    gate.try_activate(&[(first, 1), (second, 1)])
+        .unwrap()
+        .commit();
+    release(&gate, &[first]);
+    let mut uncertain = gate.try_drain(&[second]).unwrap();
+    uncertain.arm();
+    drop(uncertain);
+
+    assert!(gate.try_activate(&[(first, 2), (second, 2)]).is_err());
+    assert_eq!(snapshot(&gate, first), (true, true, Some(1)));
+    assert_eq!(snapshot(&gate, second), (true, false, Some(1)));
+    assert!(gate.begin_threads(ids.to_vec()).is_err());
+
+    // The rejected batch leaves its verified member independently recoverable.
+    gate.try_activate(&[(first, 2)]).unwrap().commit();
+    assert!(gate.begin_threads(vec![first]).is_ok());
+    assert!(gate.begin_threads(vec![second]).is_err());
+}
+
+#[test]
+fn duplicate_ids_require_the_same_epoch_and_do_not_lock_themselves() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+
+    assert!(gate.try_activate(&[(id, 1), (id, 2)]).is_err());
+    assert_eq!(snapshot(&gate, id), (false, false, None));
+    gate.try_activate(&[(id, 1), (id, 1)]).unwrap().commit();
+    assert_eq!(snapshot(&gate, id), (false, false, Some(1)));
+    assert!(gate.begin_threads(vec![id]).is_ok());
+}
+
+#[test]
+fn empty_or_zero_epoch_activation_does_not_reserve_any_member() {
+    let gate = ManagedRequestGate::default();
+    let mut ids = [ThreadId::new(), ThreadId::new()];
+    ids.sort_by_key(ToString::to_string);
+    let [first, second] = ids;
+
+    assert!(gate.try_activate(&[]).is_err());
+    assert!(gate.try_activate(&[(first, 1), (second, 0)]).is_err());
+    assert_eq!(snapshot(&gate, first), (false, false, None));
+    assert_eq!(snapshot(&gate, second), (false, false, None));
+    gate.try_activate(&[(first, 1), (second, 1)])
+        .unwrap()
+        .commit();
+    assert!(gate.begin_threads(ids.to_vec()).is_ok());
+}
