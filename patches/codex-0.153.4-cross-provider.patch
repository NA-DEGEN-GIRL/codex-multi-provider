+/// Model catalog version of the official desktop's bundled CLI that this
+/// managed build was checked against. The service offers a model only to
+/// clients at or above its minimum version; the bundled 0.160.0 catalog parses
+/// with this build and lists its models from 0.153.0 up, so the managed runtime
+/// asks for the same catalog the official app shows to the account.
+const MODELS_CATALOG_CLIENT_VERSION: (u64, u64, u64) = (0, 160, 0);
+
+/// A manager may raise the catalog version further without a rebuild.
+const MODELS_CATALOG_CLIENT_VERSION_ENV: &str = "CODEX_MANAGER_MODELS_CLIENT_VERSION";
+
 /// Convert the client version string to a whole version string (e.g. "1.2.3-alpha.4" -> "1.2.3").
+///
+/// Used only for the model catalog request and its cache key.
 pub fn client_version_to_whole() -> String {
-    format!(
-        "{}.{}.{}",
-        env!("CARGO_PKG_VERSION_MAJOR"),
-        env!("CARGO_PKG_VERSION_MINOR"),
-        env!("CARGO_PKG_VERSION_PATCH")
+    let own = (
+        env!("CARGO_PKG_VERSION_MAJOR").parse().unwrap_or(0),
+        env!("CARGO_PKG_VERSION_MINOR").parse().unwrap_or(0),
+        env!("CARGO_PKG_VERSION_PATCH").parse().unwrap_or(0),
+    );
+    catalog_client_version(
+        own,
+        std::env::var(MODELS_CATALOG_CLIENT_VERSION_ENV).ok().as_deref(),
     )
 }
+
+fn catalog_client_version(own: (u64, u64, u64), requested: Option<&str>) -> String {
+    let requested = requested.and_then(|value| {
+        let mut parts = value.trim().split('.').map(str::parse::<u64>);
+        match (parts.next(), parts.next(), parts.next(), parts.next()) {
+            (Some(Ok(major)), Some(Ok(minor)), Some(Ok(patch)), None) => {
+                Some((major, minor, patch))
+            }
+            _ => None,
+        }
+    });
+    let (major, minor, patch) = [Some(own), Some(MODELS_CATALOG_CLIENT_VERSION), requested]
+        .into_iter()
+        .flatten()
+        .max()
+        .unwrap_or(own);
+    format!("{major}.{minor}.{patch}")
+}
