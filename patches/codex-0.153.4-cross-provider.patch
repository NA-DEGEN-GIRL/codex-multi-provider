+                &thread_id,
+                provider,
+                model,
+                /*auto_compact_limit*/ None,
+            )
+            .await?;
+            run_turn(&mut mcp, &thread_id, &format!("{model} question {round}")).await?;
+            let requests = requests_of(&mock, start, model);
+            let first = &requests[0];
+            // DeepSeek's first visit rebuilds; every later return splices.
+            let returns = if model == GPT_MODEL { round } else { round - 1 };
+            // Only DeepSeek's first visit announces a model switch, and later returns keep that
+            // one message as part of DeepSeek's own context.
+            match last_requests.get(model) {
+                Some(earlier) => {
+                    assert_resends_as_prefix(earlier, first, &label);
+                    assert_eq!(
+                        occurrences(first, "<model_switch>"),
+                        occurrences(earlier, "<model_switch>"),
+                        "{label}"
+                    );
+                }
+                None => assert_eq!(occurrences(first, "<model_switch>"), 1, "{label}"),
+            }
+            assert_eq!(occurrences(first, PERMISSIONS_MARKER), 1, "{label}");
+            assert_eq!(occurrences(first, "<provider_handoff>"), returns, "{label}");
+            if model == GPT_MODEL {
+                assert_eq!(occurrences(first, "<model_switch>"), 0, "{label}");
+                assert_eq!(reasoning_without_encrypted_state(first), 0, "{label}");
+            } else {
+                assert_has_no_openai_state(first);
+                assert!(
+                    input_text(first).contains(GPT_REASONING_SUMMARY),
+                    "{label}: GPT's reasoning summary is carried as text"
+                );
+            }
+            last_requests.insert(model, requests.last().cloned().expect("a request"));
+        }
+    }
+    timeout(DEFAULT_READ_TIMEOUT, mcp.shutdown_gracefully()).await??;
+    Ok(())
+}
+
+/// DeepSeek's local compaction sends the request its turns send, tools and settings included,
+/// with only the compaction prompt appended, so its provider can serve the history from cache.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn local_compaction_repeats_the_turn_request_prefix() -> Result<()> {
+    let (server, mock) = ProviderMock::start(/*fail_portable_summary*/ false).await;
+    let codex_home = TempDir::new()?;
+    write_config(codex_home.path(), &server)?;
+    let mut mcp = start_app_server(codex_home.path()).await?;
+    let thread_id = start_thread(
+        &mut mcp,
+        DEEPSEEK_PROVIDER,
+        DEEPSEEK_MODEL,
+        ThreadHistoryMode::Paginated,
+    )
+    .await?;
+    run_turn(&mut mcp, &thread_id, "deepseek question").await?;
+    let turn = requests_of(&mock, /*start*/ 0, DEEPSEEK_MODEL)
+        .pop()
+        .expect("a DeepSeek turn request");
+
+    let compaction_start = mock.request_count();
+    compact(&mut mcp, &thread_id).await?;
+    let compactions = requests_of(&mock, compaction_start, DEEPSEEK_MODEL);
+    assert_eq!(compactions.len(), 1);
+    let compaction = &compactions[0];
+    assert!(request_kind(compaction) == RequestKind::Summary);
+    assert!(offers_tools(&turn));
+    assert_eq!(request_settings(compaction), request_settings(&turn));
+    let (turn_input, _) = split_input(&turn);
+    let (compaction_input, _) = split_input(compaction);
+    assert!(compaction_input.starts_with(&turn_input));
+    let (prompt, history) = compaction_input.split_last().expect("compaction input");
+    assert!(
+        history
+            .last()
+            .is_some_and(|item| item.to_string().contains("DEEPSEEK REPLY TO"))
+    );
+    assert!(prompt.to_string().contains(COMPACT_PROMPT));
+    assert!(prompt.to_string().contains("do not call any tools"));
+    Ok(())
+}
+
+/// A local compaction reply that calls a tool is neither run nor recorded; the summary is asked
+/// for again without tools, and the thread continues from it.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn local_compaction_that_calls_a_tool_is_retried_without_tools() -> Result<()> {
+    let (server, mock) = ProviderMock::start(/*fail_portable_summary*/ false).await;
+    mock.answer_local_compactions_with_a_tool_call();
+    let codex_home = TempDir::new()?;
+    write_config(codex_home.path(), &server)?;
+    let mut mcp = start_app_server(codex_home.path()).await?;
+    let thread_id = start_thread(
+        &mut mcp,
+        DEEPSEEK_PROVIDER,
+        DEEPSEEK_MODEL,
+        ThreadHistoryMode::Legacy,
+    )
+    .await?;
+    run_turn(&mut mcp, &thread_id, "deepseek question").await?;
+
+    let compaction_start = mock.request_count();
+    let notifications = compact(&mut mcp, &thread_id).await?;
+    let compactions = requests_of(&mock, compaction_start, DEEPSEEK_MODEL);
+    assert_eq!(
+        compactions.iter().map(offers_tools).collect::<Vec<_>>(),
+        vec![true, false]
+    );
+    let warnings = notifications
+        .iter()
+        .filter(|notification| notification.method == "warning")
+        .filter_map(|notification| notification.params.as_ref())
+        .filter_map(|params| serde_json::from_value::<WarningNotification>(params.clone()).ok())
+        .collect::<Vec<_>>();
+    assert!(
+        warnings.iter().any(|warning| warning
+            .message
+            .contains("called the update_plan tool while compacting")),
+        "missing retry warning: {warnings:?}"
+    );
+    assert!(
+        notifications
+            .iter()
+            .all(|notification| notification.method != "turn/plan/updated"),
+        "the compaction's tool call must not run"
+    );
+
+    let next = mock.request_count();
+    run_turn(&mut mcp, &thread_id, "deepseek after compaction").await?;
+    let next_request = mock.first_request_since(next, DEEPSEEK_MODEL);
+    assert_eq!(occurrences(&next_request, SUMMARY_TOOL_CALL), 0);
+    assert_eq!(occurrences(&next_request, DEEPSEEK_SUMMARY), 1);
+
+    // The call was never recorded, so no later rebuild can send it unanswered.
+    timeout(DEFAULT_READ_TIMEOUT, mcp.shutdown_gracefully()).await??;
+    drop(mcp);
+    let recorded_calls = rollout_records(codex_home.path(), &thread_id)?
+        .into_iter()
+        .filter(|record| {
+            record["type"] == "response_item" && record["payload"]["call_id"] == SUMMARY_TOOL_CALL
+        })
+        .count();
+    assert_eq!(recorded_calls, 0);
+    Ok(())
+}
+
+/// A developer message that is not part of the context bundle reaches another family with its
+/// content: a rebuild once emptied every such message while checking it for model-switch
+/// instructions, and sent `{"role":"developer","content":[]}`.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn developer_messages_keep_their_content_for_another_family() -> Result<()> {
+    let (server, mock) = ProviderMock::start(/*fail_portable_summary*/ false).await;
+    let codex_home = TempDir::new()?;
+    write_config(codex_home.path(), &server)?;
+    let mut mcp = start_app_server(codex_home.path()).await?;
+    let thread_id = start_gpt_thread(&mut mcp, ThreadHistoryMode::Paginated).await?;
+    run_turn(&mut mcp, &thread_id, "gpt first question").await?;
+    let request_id = mcp
+        .send_thread_inject_items_request(ThreadInjectItemsParams {
+            thread_id: thread_id.clone(),
+            items: vec![json!({
+                "type": "message",
+                "role": "developer",
+                "content": [{"type": "input_text", "text": "CLIENT DEVELOPER NOTE"}],
+            })],
+        })
+        .await?;
+    let _: ThreadInjectItemsResponse =
+        timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(request_id)).await??;
+    run_turn(&mut mcp, &thread_id, "gpt second question").await?;
+
+    let deepseek_start = mock.request_count();
+    let mut mcp = resume_on(
+        codex_home.path(),
+        mcp,
+        &thread_id,
+        DEEPSEEK_PROVIDER,
+        DEEPSEEK_MODEL,
+        /*auto_compact_limit*/ None,
+    )
+    .await?;
+    run_turn(&mut mcp, &thread_id, "deepseek question").await?;
+    let request = mock.first_request_since(deepseek_start, DEEPSEEK_MODEL);
+    assert_eq!(occurrences(&request, "CLIENT DEVELOPER NOTE"), 1);
+    let empty_messages = request["input"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter(|item| {
+            item["type"] == "message"
+                && item["content"]
+                    .as_array()
+                    .is_none_or(std::vec::Vec::is_empty)
+        })
+        .count();
+    assert_eq!(empty_messages, 0);
+    timeout(DEFAULT_READ_TIMEOUT, mcp.shutdown_gracefully()).await??;
+    Ok(())
+}
