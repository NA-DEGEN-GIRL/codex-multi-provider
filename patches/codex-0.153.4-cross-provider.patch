+use super::plaintext;
+use codex_protocol::models::AgentMessageInputContent;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn accepts_task_and_followup_text_without_exporting_opaque_parts() {
+    let content = vec![
+        AgentMessageInputContent::InputText {
+            text: "Review the patch.".into(),
+        },
+        AgentMessageInputContent::InputText {
+            text: "Then report the result.".into(),
+        },
+    ];
+    assert_eq!(
+        plaintext(&content).unwrap(),
+        "Review the patch.\nThen report the result."
+    );
+    let mut mixed = content;
+    mixed.push(AgentMessageInputContent::EncryptedContent {
+        encrypted_content: "opaque-secret".into(),
+    });
+    assert!(plaintext(&mixed).is_err());
+    assert!(plaintext(&[]).is_err());
+}
+
+#[test]
+fn enforces_the_existing_plaintext_route_byte_limit() {
+    let content = |text| vec![AgentMessageInputContent::InputText { text }];
+    assert_eq!(
+        plaintext(&content("a".repeat(8192))).unwrap(),
+        "a".repeat(8192)
+    );
+    assert!(plaintext(&content("가".repeat(2731))).is_err());
+}
