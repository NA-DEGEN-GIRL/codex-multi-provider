+async fn managed_source() -> anyhow::Result<(TempDir, ManagedThreadBinding)> {
+    let home = tempfile::tempdir()?;
+    let codex_home = std::fs::canonicalize(home.path())?;
+    let profile_id = ThreadId::new().to_string();
+    let source_id = ManagedSourceId {
+        host_id: "queue-test-host".to_string(),
+        store_id: format!("manager:{profile_id}"),
+    };
+    std::fs::write(
+        codex_home.join("managed-source.json"),
+        serde_json::to_vec(&source_id)?,
+    )?;
+    let registry = ManagedSourceRegistry::new(
+        source_id.host_id.clone(),
+        profile_id,
+        vec![ManagedSourceRegistration {
+            source_id: source_id.clone(),
+            config: LocalThreadStoreConfig {
+                sqlite: SqliteConfig::new_for_testing(codex_home.abs()),
+                codex_home,
+                default_model_provider_id: "test-provider".to_string(),
+            },
+        }],
+    )?;
+    let binding = registry.bind_new(&source_id, ThreadId::new()).await?;
+    Ok((home, binding))
+}
+
+fn process_queue(test: &TestCodex) -> anyhow::Result<Arc<dyn QueueStore>> {
+    let state = test
+        .codex
+        .state_db()
+        .context("target state is unavailable")?;
+    Ok(Arc::new(LocalQueueStore::new(state)))
+}
