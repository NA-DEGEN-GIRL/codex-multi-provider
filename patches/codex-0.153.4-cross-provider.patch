+/// Replays plaintext provider reasoning as assistant context on OpenAI routes.
+/// `reasoning_text` is an output shape accepted by other Responses providers, but
+/// OpenAI input reasoning requires empty content. Its accompanying opaque state
+/// also belongs to the original provider. Only the request copy is changed;
+/// native encrypted reasoning without this plaintext shape is preserved.
+pub(crate) fn normalize_plaintext_reasoning_for_openai(input: &mut [ResponseItem]) {
+    for item in input {
+        let ResponseItem::Reasoning {
+            id,
+            summary,
+            content: Some(content),
+            ..
+        } = item
+        else {
+            continue;
+        };
+        if !content
+            .iter()
+            .any(|part| matches!(part, ReasoningItemContent::ReasoningText { .. }))
+        {
+            continue;
+        }
+        let id = id.as_ref().map(|id| {
+            ResponseItemId::with_suffix(
+                "msg",
+                Uuid::new_v5(
+                    &Uuid::NAMESPACE_OID,
+                    format!("plaintext_reasoning:{}", id.as_str()).as_bytes(),
+                ),
+            )
+        });
+        let content = summary
+            .iter()
+            .map(|ReasoningItemReasoningSummary::SummaryText { text }| text)
+            .chain(content.iter().map(|part| match part {
+                ReasoningItemContent::ReasoningText { text }
+                | ReasoningItemContent::Text { text } => text,
+            }))
+            .map(|text| ContentItem::OutputText { text: text.clone() })
+            .collect();
+        *item = ResponseItem::Message {
+            id,
+            role: "assistant".to_string(),
+            content,
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        };
+    }
+}
+
+/// Removes OpenAI-only request state and lowers inter-agent messages into the ordinary
+/// user-message form accepted by configured non-OpenAI Responses providers.
+///
+/// Encrypted inter-agent messages and tool outputs can only be read by OpenAI. Resume already
+/// replaces them when a thread moves to another family; any that remain become a plaintext
+/// placeholder here, so they never make the thread unusable on this provider.
+pub(crate) fn normalize_input_for_non_openai_provider(
+    input: Vec<ResponseItem>,
+) -> Result<Vec<ResponseItem>> {
+    let mut normalized = Vec::with_capacity(input.len());
+    for item in input {
+        let Some(mut item) = normalize_item_for_non_openai_provider(item) else {
+            continue;
+        };
+        item.clear_internal_chat_message_metadata_passthrough();
+        if let ResponseItem::FunctionCall {
+            encrypted_function_args,
+            ..
+        } = &mut item
+        {
+            *encrypted_function_args = None;
+        }
+        normalized.push(item);
+    }
+    Ok(normalized)
+}
+
+fn normalize_item_for_non_openai_provider(item: ResponseItem) -> Option<ResponseItem> {
+    let (id, content) = match item {
+        ResponseItem::AgentMessage { id, content, .. } => (id, content),
+        mut item @ (ResponseItem::FunctionCallOutput { .. }
+        | ResponseItem::CustomToolCallOutput { .. }) => {
+            crate::portable_context::replace_encrypted_tool_output(&mut item);
+            return Some(item);
+        }
+        item => return Some(item),
+    };
+    let text = content
+        .iter()
+        .map(|part| match part {
+            AgentMessageInputContent::InputText { text } => text.as_str(),
+            AgentMessageInputContent::EncryptedContent { .. } => {
+                crate::portable_context::ENCRYPTED_MESSAGE_PLACEHOLDER
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    if text.trim().is_empty() {
+        return None;
+    }
+    let id = id.map(|id| {
+        let suffix = id.as_str().strip_prefix("amsg_").unwrap_or(id.as_str());
+        ResponseItemId::with_suffix("msg", suffix)
+    });
+    Some(ResponseItem::Message {
+        id,
+        role: "user".to_string(),
+        content: vec![ContentItem::InputText { text }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    })
+}
