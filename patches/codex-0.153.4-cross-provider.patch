index 0000000000000000000000000000000000000000..9dfa0b390f0b7a508898ed9576dace9dfd764e44
--- /dev/null
+++ b/codex-rs/app-server/tests/suite/v2/managed_instance_activity.rs
@@ -0,0 +1,192 @@
+//! Observe real command/process lifetimes after their initiating request returns.
+use super::*;
+use codex_app_server_protocol::ServerDiagnosticsResponse;
+use codex_app_server_protocol::ServerManagedShutdownResponse;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn managed_process_activity_survives_spawn_response_and_drains_after_exit() -> Result<()> {
+    let api = responses::start_mock_server().await;
+    let profile = ManagedProfile::new(&api.uri(), "mock-model", "mock-token")?;
+    profile.write_manifest(&[&profile], Vec::new())?;
+    let mut server = profile.start_server().await?;
+    // Starting a root must not permanently retain its request activity context.
+    server.start_thread(ThreadStartParams::default()).await?;
+    let command = if cfg!(windows) {
+        vec![
+            "powershell.exe",
+            "-NoLogo",
+            "-NoProfile",
+            "-NonInteractive",
+            "-Command",
+            "[Console]::In.ReadLine() | Out-Null",
+        ]
+    } else {
+        vec!["sh", "-c", "read line"]
+    };
+    let spawn = server
+        .send_raw_request(
+            "process/spawn",
+            Some(json!({
+                "command":command,"processHandle":"maintenance-probe","cwd":profile.home.path(),
+                "streamStdin":true,"timeoutMs":30000
+            })),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, server.read_response(spawn)).await??;
+    let diagnostics = server
+        .send_raw_request("server/diagnostics", Some(json!({})))
+        .await?;
+    let diagnostics: ServerDiagnosticsResponse =
+        timeout(READ_TIMEOUT, server.read_response(diagnostics)).await??;
+    let gauge = |name: &str| {
+        diagnostics
+            .gauges
+            .iter()
+            .find(|gauge| gauge.name == name)
+            .map(|gauge| gauge.value)
+    };
+    assert_eq!(gauge("app.managed.processes.running"), Some(1));
+    assert_eq!(gauge("app.managed.requests.pending_completion"), Some(1));
+    let process_id = diagnostics.process.id;
+    let shutdown = server
+        .send_raw_request(
+            "server/managedShutdown",
+            Some(json!({"processId":process_id})),
+        )
+        .await?;
+    let rejected = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_error_message(RequestId::Integer(shutdown)),
+    )
+    .await??;
+    assert!(rejected.error.message.contains("operations in flight"));
+    let stop = server
+        .send_raw_request(
+            "process/writeStdin",
+            Some(json!({
+                "processHandle":"maintenance-probe","closeStdin":true
+            })),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, server.read_response(stop)).await??;
+    timeout(READ_TIMEOUT, async {
+        loop {
+            let request = server
+                .send_raw_request("server/diagnostics", Some(json!({})))
+                .await?;
+            let diagnostics: ServerDiagnosticsResponse = server.read_response(request).await?;
+            if diagnostics
+                .gauges
+                .iter()
+                .any(|gauge| gauge.name == "app.managed.processes.running" && gauge.value == 0)
+            {
+                break Ok::<(), anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await??;
+    let shutdown = server
+        .send_raw_request(
+            "server/managedShutdown",
+            Some(json!({"processId":process_id})),
+        )
+        .await?;
+    let result: ServerManagedShutdownResponse =
+        timeout(READ_TIMEOUT, server.read_response(shutdown)).await??;
+    assert!(result.shutdown_requested && result.writer_release_verified);
+    assert!(
+        timeout(READ_TIMEOUT, server.wait_for_exit())
+            .await??
+            .success()
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn managed_shutdown_verifies_identity_drains_roots_and_preserves_records() -> Result<()> {
+    let api = responses::start_mock_server().await;
+    let _responses = responses::mount_sse_sequence(
+        &api,
+        vec![create_final_assistant_message_sse_response(
+            "Persisted maintenance fixture",
+        )?],
+    )
+    .await;
+    let profile = ManagedProfile::new(&api.uri(), "mock-model", "mock-token")?;
+    profile.write_manifest(&[&profile], Vec::new())?;
+    let mut server = profile.start_server().await?;
+    let first = server
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    complete_turn(&mut server, &first, "Persist this test conversation").await?;
+    let second = server
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let request = server
+        .send_raw_request("server/diagnostics", Some(json!({})))
+        .await?;
+    let diagnostics: ServerDiagnosticsResponse = server.read_response(request).await?;
+    let invalid = server
+        .send_raw_request("server/managedShutdown", Some(json!({"processId":0})))
+        .await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_error_message(RequestId::Integer(invalid)),
+    )
+    .await??;
+    assert!(error.error.message.contains("exact managed process"));
+    let request = server
+        .send_raw_request(
+            "server/managedShutdown",
+            Some(json!({"processId":diagnostics.process.id})),
+        )
+        .await?;
+    let mut response: ServerManagedShutdownResponse =
+        timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    response.closed_thread_ids.sort();
+    let mut expected = vec![first.clone(), second];
+    expected.sort();
+    assert_eq!(
+        response,
+        ServerManagedShutdownResponse {
+            process_id: diagnostics.process.id,
+            closed_thread_ids: expected,
+            shutdown_requested: true,
+            writer_release_verified: true,
+        }
+    );
+    // Keep the client input open: only the maintenance RPC may cause this exit.
+    assert!(
+        timeout(READ_TIMEOUT, server.wait_for_exit())
+            .await??
+            .success()
+    );
+    // A fresh process receives the same durable owner grant from the manager.
+    // Shutdown does not advance ownership or synthesize an account transfer.
+    profile.write_manifest(
+        &[&profile],
+        vec![binding_grant(&profile, &profile, &first, /*epoch*/ 1)],
+    )?;
+    let mut reopened = profile.start_server().await?;
+    let resume = reopened
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: first.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let response: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, reopened.read_response(resume)).await??;
+    assert_eq!(response.thread.id, first);
+    assert!(
+        timeout(READ_TIMEOUT, reopened.shutdown_gracefully())
+            .await??
+            .success()
+    );
+    Ok(())
+}
