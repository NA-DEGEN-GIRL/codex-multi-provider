+    let mirror_state = codex_state::StateRuntime::init(
+        SqliteConfig::from_sqlite_home(mirror.path().abs()),
+        "openai".to_string(),
+    )
+    .await?;
+    let second_state = codex_state::StateRuntime::init(
+        SqliteConfig::from_sqlite_home(second.path().abs()),
+        "openai".to_string(),
+    )
+    .await?;
+    let created = chrono::DateTime::from_timestamp(1_735_732_800, 0).context("fixture time")?;
+    let mut metadata = codex_state::ThreadMetadataBuilder::new(
+        codex_protocol::ThreadId::from_string(&id)?,
+        path.clone(),
+        created,
+        codex_protocol::protocol::SessionSource::Cli,
+    )
+    .build("openai");
+    metadata.cwd = owner.path().to_path_buf();
+    metadata.title = "Older foreign name".to_string();
+    metadata.first_user_message = Some("Foreign-index-only work".to_string());
+    mirror_state.upsert_thread(&metadata).await?;
+    metadata.title = "Latest foreign name".to_string();
+    metadata.updated_at += chrono::Duration::seconds(10);
+    second_state.upsert_thread(&metadata).await?;
+    let mut unregistered = metadata.clone();
+    unregistered.id = codex_protocol::ThreadId::new();
+    unregistered.rollout_path = outside.path().join("sessions/not-registered.jsonl");
+    mirror_state.upsert_thread(&unregistered).await?;
