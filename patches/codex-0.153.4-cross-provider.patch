index 000000000..ef75a8a02
--- /dev/null
+++ b/codex-rs/core/src/hook_runtime/managed_close.rs
@@ -0,0 +1,40 @@
+use super::emit_hook_completed_events;
+use super::emit_hook_started_events;
+use crate::session::session::Session;
+use codex_hooks::HookExecutionSeal;
+use codex_protocol::protocol::SessionSource;
+use std::sync::Arc;
+
+/// Preserve terminal hooks while all ordinary hook admission remains sealed.
+pub(crate) async fn run_session_end_hooks_for_managed_close(
+    session: &Arc<Session>,
+    seal: &HookExecutionSeal,
+) -> anyhow::Result<()> {
+    let hooks = session.hooks();
+    let preview = hooks.preview_session_end();
+    if preview.is_empty() {
+        return Ok(());
+    }
+    let turn = session.new_default_turn().await;
+    if matches!(&turn.session_source, SessionSource::SubAgent(_)) {
+        return Ok(());
+    }
+    let request = codex_hooks::SessionEndRequest {
+        session_id: session.session_id().into(),
+        turn_id: turn.sub_id.clone(),
+        #[allow(deprecated)]
+        cwd: turn.cwd.clone(),
+        transcript_path: session.hook_transcript_path().await,
+    };
+    session.flush_rollout().await?;
+    emit_hook_started_events(session, &turn, preview).await;
+    let outcome = hooks
+        .run_session_end_for_managed_close(seal, request)
+        .await?;
+    emit_hook_completed_events(session, &turn, outcome.hook_events).await;
+    anyhow::ensure!(
+        !hooks.has_pending_work(),
+        "terminal hook process cleanup is unverified"
+    );
+    Ok(())
+}
