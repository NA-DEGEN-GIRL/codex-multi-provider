+use codex_protocol::protocol::TokenUsage;
+use codex_protocol::protocol::TokenUsageInfo;
+use uuid::Uuid;
+
+use super::session::Session;
+use super::turn_context::TurnContext;
+
+impl Session {
+    pub(super) async fn should_rebuild_with_agent_summary(
+        &self,
+        ctx: &TurnContext,
+        history: &[codex_history::ResponseItemEnvelope],
+        rollout: &[codex_history::RolloutItem],
+    ) -> bool {
+        if ctx.provider.info().agent.is_some()
+            || !history.iter().any(|item| {
+                item.metadata
+                    .as_ref()
+                    .is_some_and(|metadata| metadata.portable_agent_summary.is_some())
+            })
+        {
+            return false;
+        }
+        let limit = [
+            ctx.model_info().auto_compact_token_limit(),
+            ctx.model_info().usable_context_window(),
+        ]
+        .into_iter()
+        .flatten()
+        .min();
+        let base = self.get_base_instructions().await;
+        let budget = crate::portable_context::RebuildBudget::for_limit(limit, &base.text);
+        let tokens = history
+            .iter()
+            .map(|item| crate::portable_context::rebuild_token_count(&item.item))
+            .sum::<i64>();
+        if tokens <= budget.limit_tokens.saturating_sub(budget.overhead_tokens) {
+            return false;
+        }
+        let mut transcript = self.load_model_transcript(rollout).await;
+        crate::portable_context::apply_verified_summary(
+            &mut transcript,
+            Some(budget.limit_tokens.saturating_sub(budget.overhead_tokens)),
+        )
+    }
+
+    pub(crate) async fn record_local_agent_usage(
+        &self,
+        ctx: &TurnContext,
+        total: TokenUsage,
+        last: Option<TokenUsage>,
+    ) {
+        let previous = self.token_usage_info().await;
+        if let Some(mut info) = TokenUsageInfo::new_or_append(
+            &previous,
+            &Some(total.clone()),
+            ctx.model_context_window(),
+        ) {
+            // Aggregate billing usage can span multiple requests. Only the final
+            // request describes the active context after the agent compacts.
+            if let Some(last) = last {
+                info.last_token_usage = last;
+            }
+            self.state.lock().await.set_token_info(Some(info));
+        }
+        self.record_observed_response_completed(
+            ctx,
+            &format!("claude-{}", Uuid::new_v4()),
+            Some(&total),
+            None,
+        )
+        .await;
+        self.send_token_count_event(ctx).await;
+    }
+}
