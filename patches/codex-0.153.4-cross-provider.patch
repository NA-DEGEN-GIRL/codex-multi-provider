+pub(super) struct CatalogFixture {
+    source_home: TempDir,
+    viewer_home: TempDir,
+    pub(super) manifest_path: PathBuf,
+    pub(super) rollout_path: PathBuf,
+    pub(super) thread_id: String,
+    pub(super) projection_id: String,
+}
+
+impl CatalogFixture {
+    pub(super) fn new() -> Result<Self> {
+        let source_home = TempDir::new()?;
+        let viewer_home = TempDir::new()?;
+        let filename_timestamp = "2025-01-05T12-00-00";
+        let thread_id = create_fake_rollout(
+            source_home.path(),
+            filename_timestamp,
+            "2025-01-05T12:00:00Z",
+            "A task from the source profile",
+            Some("openai"),
+            /*git_info*/ None,
+        )?;
+        let rollout_path = rollout_path(source_home.path(), filename_timestamp, &thread_id);
+        // Be explicit: the shared fixture helper follows the current default
+        // history mode, whereas this catalog only supports legacy histories.
+        let mut lines = fs::read_to_string(&rollout_path)?
+            .lines()
+            .map(serde_json::from_str::<Value>)
+            .collect::<Result<Vec<_>, _>>()?;
+        lines[0]["payload"]["history_mode"] = json!("legacy");
+        let contents = lines
+            .into_iter()
+            .map(|line| line.to_string())
+            .collect::<Vec<_>>()
+            .join("\n");
+        fs::write(&rollout_path, format!("{contents}\n"))?;
+
+        let projection_id = Uuid::new_v4().to_string();
+        let manifest_path = viewer_home.path().join("record-catalog.json");
+        fs::write(
+            &manifest_path,
+            serde_json::to_vec(&json!({
+                "version": 1,
+                "revision": "fixture-revision-1",
+                "hostId": "local",
+                "entries": [{
+                    "projectionThreadId": projection_id,
+                    "threadId": thread_id,
+                    "hostId": "local",
+                    "sourceStoreId": "fixture-source-profile",
+                    "codexHome": source_home.path(),
+                    "rolloutPath": rollout_path,
+                }],
+            }))?,
+        )?;
+        Ok(Self {
+            source_home,
+            viewer_home,
+            manifest_path,
+            rollout_path,
+            thread_id,
+            projection_id,
+        })
+    }
+
+    pub(super) async fn start_server(&self) -> Result<TestAppServer> {
+        TestAppServer::builder()
+            .with_codex_home(self.viewer_home.path())
+            .without_managed_config()
+            .with_env_overrides(&[
+                (
+                    "CODEX_MANAGER_RECORD_CATALOG",
+                    Some(self.manifest_path.to_str().context("UTF-8 manifest path")?),
+                ),
+                ("CODEX_SQLITE_HOME", None),
+                ("OPENAI_API_KEY", None),
+                ("CODEX_ACCESS_TOKEN", None),
+            ])
+            .build_initialized_with_timeout(READ_TIMEOUT)
+            .await
+    }
+
+    pub(super) fn assert_source_untouched(&self, expected_rollout: &[u8]) -> Result<()> {
+        assert_eq!(fs::read(&self.rollout_path)?, expected_rollout);
+        let source_entries = fs::read_dir(self.source_home.path())?
+            .map(|entry| entry.map(|entry| entry.file_name()))
+            .collect::<std::io::Result<Vec<_>>>()?;
+        assert_eq!(source_entries, vec![OsString::from("sessions")]);
+        Ok(())
+    }
+}
