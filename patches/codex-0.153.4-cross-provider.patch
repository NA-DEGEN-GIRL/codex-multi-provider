index 000000000..a6fc1aab6
--- /dev/null
+++ b/codex-rs/core/src/session/provider_switch.rs
@@ -0,0 +1,228 @@
+//! Installs a thread's model context when it resumes on another provider family.
+//!
+//! The family taking the thread over either continues its own earlier context
+//! ([`portable_context::splice_context`]) or rebuilds one from the transcript
+//! ([`portable_context::build_context`]), and records where the family it took the thread from
+//! left it ([`portable_context::return_anchor`]) for that family's return.
+
+use super::*;
+use crate::context::world_state::WorldStateSnapshot;
+use crate::state::SplicedBaseline;
+use codex_history::ReturnAnchor;
+use codex_utils_output_truncation::TruncationPolicy;
+
+/// Tracing target of the lines that say whether a family took a thread back from its own
+/// earlier context, and why not. They carry sizes and hashes, never content.
+const SPLICE_LOG_TARGET: &str = "codex_core::portable_context::splice";
+
+/// What the resume replay reconstructed: the context of the family that served the thread last.
+pub(super) struct LeavingReplay<'a> {
+    /// That family, when known and not the one taking over.
+    pub(super) family: Option<&'a str>,
+    pub(super) history: &'a [ResponseItemEnvelope],
+    pub(super) reference_context_item: Option<&'a TurnContextItem>,
+    pub(super) world_state_baseline: Option<&'a WorldStateSnapshot>,
+}
+
+/// The context a family takes a thread over with.
+pub(super) struct TakenOverContext {
+    pub(super) items: Vec<ResponseItemEnvelope>,
+    /// Portable summary the checkpoint recording this context carries.
+    pub(super) portable: Option<PortableCheckpoint>,
+    /// Set when the context continues the family's own earlier context.
+    pub(super) spliced: Option<SplicedBaseline>,
+    /// Where the family the thread was taken from left it.
+    pub(super) return_anchors: Vec<ReturnAnchor>,
+}
+
+impl Session {
+    /// Loads the thread's transcript once, records where `leaving` left the thread, and either
+    /// splices `target`'s own earlier context or rebuilds one.
+    pub(super) async fn take_over_context(
+        &self,
+        turn_context: &TurnContext,
+        rollout_items: &[RolloutItem],
+        target: &portable_context::TargetProvider,
+        leaving: LeavingReplay<'_>,
+    ) -> TakenOverContext {
+        let transcript = self.load_model_transcript(rollout_items).await;
+        let config = turn_context.config.as_ref();
+        let model_info = turn_context.model_info();
+        let truncation_policy: TruncationPolicy = model_info.truncation_policy.into();
+        let return_anchors = match leaving.family {
+            Some(family) => {
+                let anchor = portable_context::return_anchor(
+                    &transcript,
+                    config,
+                    target,
+                    portable_context::LeavingContext {
+                        family,
+                        history: leaving.history,
+                        truncation_policy,
+                        reference_context: leaving.reference_context_item,
+                        world_state: leaving
+                            .world_state_baseline
+                            .map(|snapshot| snapshot.clone().into_object()),
+                        request_head: leaving_request_head(config, rollout_items, family),
+                    },
+                );
+                match anchor {
+                    Ok(anchor) => {
+                        info!(
+                            target: SPLICE_LOG_TARGET,
+                            family,
+                            cut_position = anchor.cut_position,
+                            items = anchor.items,
+                            request_head = anchor.request_head.as_deref(),
+                            "recorded where the leaving provider family left the thread"
+                        );
+                        vec![anchor]
+                    }
+                    Err(reason) => {
+                        info!(
+                            target: SPLICE_LOG_TARGET,
+                            family,
+                            reason,
+                            "no return anchor for the leaving provider family"
+                        );
+                        Vec::new()
+                    }
+                }
+            }
+            None => Vec::new(),
+        };
+
+        let base_instructions = self.get_base_instructions().await;
+        let policy = portable_context::SplicePolicy::from_env(
+            model_info.auto_compact_token_limit(),
+            model_info.usable_context_window(),
+            &base_instructions.text,
+        );
+        match portable_context::splice_context(
+            &transcript,
+            config,
+            target,
+            truncation_policy,
+            policy,
+        ) {
+            Ok(spliced) => {
+                info!(
+                    target: SPLICE_LOG_TARGET,
+                    family = target.family.as_str(),
+                    hit = true,
+                    prefix_items = spliced.prefix_items,
+                    suffix_items = spliced.suffix_items,
+                    prefix_tokens = spliced.prefix_tokens,
+                    suffix_tokens = spliced.suffix_tokens,
+                    anchor_request_head = spliced.request_head.as_deref(),
+                    "continued the provider family's own earlier context"
+                );
+                // The next request's prefix check says whether the family still sends the tools
+                // and instructions it sent before, without which its cache misses anyway.
+                if let Some(head) = spliced.request_head.clone() {
+                    codex_api::prefix_check::expect_request_head(
+                        &self.thread_id().to_string(),
+                        head,
+                    );
+                }
+                for message in spliced.warnings {
+                    self.send_event(turn_context, EventMsg::Warning(WarningEvent { message }))
+                        .await;
+                }
+                return TakenOverContext {
+                    items: spliced.items,
+                    portable: spliced.portable,
+                    spliced: Some(SplicedBaseline {
+                        prefix_items: u64::try_from(spliced.prefix_items).unwrap_or(u64::MAX),
+                        reference_context: spliced.reference_context,
+                        world_state: spliced.world_state,
+                    }),
+                    return_anchors,
+                };
+            }
+            Err(reason) => {
+                info!(
+                    target: SPLICE_LOG_TARGET,
+                    family = target.family.as_str(),
+                    hit = false,
+                    reason,
+                    "rebuilding the provider family's context"
+                );
+            }
+        }
+        let (items, portable) = self
+            .build_portable_context(turn_context, transcript, target, &base_instructions)
+            .await;
+        TakenOverContext {
+            items,
+            portable,
+            spliced: None,
+            return_anchors,
+        }
+    }
+
+    /// Rebuilds model context for `target` from the thread's complete transcript. Also returns
+    /// the portable summary the checkpoint recording that context carries.
+    async fn build_portable_context(
+        &self,
+        turn_context: &TurnContext,
+        transcript: codex_rollout::ModelTranscript,
+        target: &portable_context::TargetProvider,
+        base_instructions: &BaseInstructions,
+    ) -> (Vec<ResponseItemEnvelope>, Option<PortableCheckpoint>) {
+        let transcript_items = transcript.items.len();
+        let rejected_checkpoints = transcript.rejected_checkpoints;
+        // Stay under the limit that triggers compaction, counting what the first request adds,
+        // so the rebuilt context does not compact on its first request.
+        let model_info = turn_context.model_info();
+        let limit_tokens = [
+            model_info.auto_compact_token_limit(),
+            model_info.usable_context_window(),
+        ]
+        .into_iter()
+        .flatten()
+        .min();
+        let context = portable_context::build_context(
+            transcript,
+            &turn_context.config,
+            target,
+            portable_context::RebuildBudget::for_limit(limit_tokens, &base_instructions.text),
+            model_info.truncation_policy.into(),
+        );
+        info!(
+            source = ?context.source,
+            items = context.items.len(),
+            budget_tokens = context.budget_tokens,
+            transcript_items,
+            rejected_checkpoints,
+            "rebuilt model context for provider family {}",
+            target.family
+        );
+        for message in context.warnings {
+            self.send_event(turn_context, EventMsg::Warning(WarningEvent { message }))
+                .await;
+        }
+        (context.items, context.portable)
+    }
+}
+
+/// Head hash of the newest request `family` recorded usage for, as its usage record names it.
+fn leaving_request_head(
+    config: &crate::config::Config,
+    rollout_items: &[RolloutItem],
+    family: &str,
+) -> Option<String> {
+    rollout_items
+        .iter()
+        .rev()
+        .filter_map(|item| match item {
+            RolloutItem::TokenUsageRecord(record) => Some(record),
+            RolloutItem::Compacted(compacted) => compacted.latest_token_usage_record.as_ref(),
+            _ => None,
+        })
+        .filter_map(|record| record.served_by.as_ref())
+        .find(|served_by| {
+            portable_context::provider_family_for_id(config, &served_by.provider_id) == family
+        })
+        .and_then(|served_by| served_by.request_head.clone())
+}
