+        serde_json::to_value(SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id: ThreadId::from_string(THREAD_A).unwrap(),
+            depth: 1,
+            agent_path: None,
+            agent_nickname: Some("Reader".to_string()),
