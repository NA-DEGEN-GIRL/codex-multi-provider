+
+/// Reads the anchors another runtime version wrote, keeping the ones this version can read.
+fn deserialize_lenient_anchors<'de, D>(deserializer: D) -> Result<Vec<ReturnAnchor>, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    #[derive(Deserialize)]
+    #[serde(untagged)]
+    enum Lenient {
+        Valid(ReturnAnchor),
+        Invalid(serde::de::IgnoredAny),
+    }
+    Ok(
+        match Option::<Vec<Lenient>>::deserialize(deserializer).unwrap_or(None) {
+            Some(anchors) => anchors
+                .into_iter()
+                .filter_map(|anchor| match anchor {
+                    Lenient::Valid(anchor) => Some(anchor),
+                    Lenient::Invalid(_) => None,
+                })
+                .collect(),
+            None => Vec::new(),
+        },
+    )
+}
