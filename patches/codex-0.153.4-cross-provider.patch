+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn repeated_resumes_keep_one_copy_of_the_context_bundle() -> Result<()> {
+    let (server, mock) = ProviderMock::start(/*fail_portable_summary*/ false).await;
+    let codex_home = TempDir::new()?;
+    let (mut mcp, thread_id) = gpt_compacted_thread(codex_home.path(), &server).await?;
+
+    // The first DeepSeek turn records its rebuilt context as DeepSeek's checkpoint; later resumes
+    // replay from it.
+    let mut bundle_copies = Vec::new();
+    let mut request_sizes = Vec::new();
+    for resume in 0..3 {
+        let start = mock.request_count();
+        mcp = resume_on(
+            codex_home.path(),
+            mcp,
+            &thread_id,
+            DEEPSEEK_PROVIDER,
+            DEEPSEEK_MODEL,
+            /*auto_compact_limit*/ None,
+        )
+        .await?;
+        run_turn(&mut mcp, &thread_id, &format!("deepseek question {resume}")).await?;
+        let request = mock.first_request_since(start, DEEPSEEK_MODEL);
+        bundle_copies.push(occurrences(&request, PERMISSIONS_MARKER));
+        request_sizes.push(input_text(&request).len());
+    }
+    assert_eq!(bundle_copies, vec![1, 1, 1]);
+    // Each resume adds only the previous exchange, far less than another context bundle.
+    let growth = request_sizes
+        .windows(2)
+        .map(|pair| pair[1].saturating_sub(pair[0]))
+        .collect::<Vec<_>>();
+    assert!(
+        growth.iter().all(|bytes| *bytes < 2_000),
+        "context grew by {growth:?} bytes per resume"
+    );
+    Ok(())
+}
