+#[tokio::test]
+async fn existing_reader_follows_revert_pointer_and_new_committed_turns() {
+    let fixture = paginated_fixture().await;
+    let sqlite = test_config(fixture.home.path()).sqlite;
+    let reader = ReadOnlyLocalThreadStore::open(fixture.home.path().to_path_buf(), sqlite)
+        .await
+        .expect("open source read-only");
+    assert_eq!(
+        turn_ids(
+            &reader
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .expect("original turns")
+        ),
+        vec!["turn-1", "turn-2"]
+    );
+    let original_cursor = reader
+        .list_turns(turn_params(fixture.thread_id, None, 1))
+        .await
+        .expect("first page before revert")
+        .next_cursor
+        .expect("cursor addressing original rollout");
+
+    fixture
+        .store
+        .revert_thread(RevertThreadParams {
+            thread_id: fixture.thread_id,
+            before_turn_id: "turn-2".to_string(),
+        })
+        .await
+        .expect("writer reverts before second turn");
+    let replacement_path = fixture
+        .state
+        .get_thread(fixture.thread_id)
+        .await
+        .expect("read current state pointer")
+        .expect("source thread metadata")
+        .rollout_path;
+    assert_ne!(replacement_path, fixture.rollout_path);
+    assert!(
+        fixture.rollout_path.exists(),
+        "old rollout remains present, so a filename scan cannot choose the current history"
+    );
+    let before_read = source_snapshot(fixture.home.path());
+    let reverted = reader
+        .read_thread(read_params(fixture.thread_id))
+        .await
+        .expect("read current replacement rollout");
+    assert_eq!(
+        reverted.rollout_path,
+        Some(fs::canonicalize(&replacement_path).expect("canonical replacement rollout"))
+    );
+    let stale_cursor_error = reader
+        .list_turns(turn_params(fixture.thread_id, Some(original_cursor), 1))
+        .await
+        .expect_err("pre-revert cursor must not cross into replacement history");
+    assert!(
+        stale_cursor_error
+            .to_string()
+            .contains("source history changed since this cursor"),
+        "stale cursors should request a conversation reload: {stale_cursor_error}"
+    );
+    assert_eq!(
+        turn_ids(
+            &reader
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .expect("reverted turns")
+        ),
+        vec!["turn-1"]
+    );
+    assert_source_unchanged(fixture.home.path(), &before_read);
+
+    fixture
+        .store
+        .resume_thread(ResumeThreadParams {
+            thread_id: fixture.thread_id,
+            rollout_path: Some(replacement_path.clone()),
+            history: None,
+            include_archived: false,
+            metadata: persistence_metadata(fixture.home.path()),
+        })
+        .await
+        .expect("resume current rollout for writing");
+    fixture
+        .store
+        .append_items(AppendThreadItemsParams {
+            thread_id: fixture.thread_id,
+            items: completed_turn(fixture.thread_id, "turn-3"),
+        })
+        .await
+        .expect("append new turn");
+    fixture
+        .store
+        .flush_thread(fixture.thread_id)
+        .await
+        .expect("commit new turn while source writer remains active");
+
+    let before_read = source_snapshot(fixture.home.path());
+    assert_eq!(
+        turn_ids(
+            &reader
+                .list_turns(turn_params(fixture.thread_id, None, 10))
+                .await
+                .expect("fresh committed turns through original reader")
+        ),
+        vec!["turn-1", "turn-3"]
+    );
+    let items = reader
+        .list_items(item_params(fixture.thread_id, None, 10))
+        .await
+        .expect("fresh committed items");
+    assert_eq!(
+        items
+            .items
+            .iter()
+            .map(|item| item.item_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["item-turn-1", "item-turn-3"]
+    );
+    assert_eq!(
+        reader
+            .read_thread(read_params(fixture.thread_id))
+            .await
+            .expect("read source after append")
+            .rollout_path,
+        Some(fs::canonicalize(replacement_path).expect("canonical replacement rollout"))
+    );
+    reader.close().await;
+    assert_source_unchanged(fixture.home.path(), &before_read);
+    fixture
+        .store
+        .shutdown_thread(fixture.thread_id)
+        .await
+        .expect("close fixture writer");
+}
