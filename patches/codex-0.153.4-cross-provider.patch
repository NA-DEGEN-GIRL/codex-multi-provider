+const READ_TIMEOUT: Duration = Duration::from_secs(60);
+const PARENT_PROMPT: &str = "Create the canonical dormant worker";
+const CHILD_PROMPT: &str = "Preserve this canonical worker history";
+const SPAWN_CALL_ID: &str = "spawn-canonical-worker";
