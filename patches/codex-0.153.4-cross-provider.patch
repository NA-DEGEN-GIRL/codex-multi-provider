@@ -0,0 +1,303 @@
+//! Claude sessions receive only portable history, with exact committed-turn fingerprints.
+use std::collections::BTreeMap;
+use std::collections::HashSet;
+
+use codex_protocol::error::Result;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_rollout::ModelTranscript;
+use serde::Serialize;
+use serde_json::Value;
+use sha1::Digest;
+use sha1::Sha1;
+
+use super::bridge::failure;
+use crate::portable_context::RebuildBudget;
+use crate::portable_context::TargetProvider;
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+
+#[cfg(test)]
+#[path = "context_tests.rs"]
+mod tests;
+
+#[derive(Clone, Debug, Serialize)]
+pub(super) struct Snapshot {
+    pub turn_ids: Vec<String>,
+    pub fingerprint: String,
+    pub turn_fingerprints: BTreeMap<String, String>,
+}
+
+pub(super) async fn load(session: &Session) -> Result<ModelTranscript> {
+    session
+        .flush_rollout()
+        .await
+        .map_err(|err| failure(format!("cannot flush shared history: {err}")))?;
+    session
+        .services
+        .thread_store
+        .load_model_transcript(codex_thread_store::LoadThreadHistoryParams {
+            thread_id: session.thread_id(),
+            include_archived: true,
+        })
+        .await
+        .map(|stored| stored.transcript)
+        .map_err(|err| failure(format!("cannot load complete shared history: {err}")))
+}
+
+pub(super) fn snapshot(transcript: &ModelTranscript, current_turn: &str) -> Snapshot {
+    let mut hashes: BTreeMap<String, Sha1> = BTreeMap::new();
+    let mut turn_ids = Vec::new();
+    for item in &transcript.items {
+        if !item.completed && item.turn_id.as_deref() != Some(current_turn) {
+            continue;
+        }
+        let id = item
+            .turn_id
+            .clone()
+            .unwrap_or_else(|| format!("legacy-{}", item.position));
+        let hash = hashes.entry(id.clone()).or_insert_with(|| {
+            turn_ids.push(id);
+            Sha1::new()
+        });
+        // Include assistant and tool outcomes, not just user input: editing a covered answer
+        // invalidates the cached session as reliably as rollback does.
+        hash.update(
+            serde_json::to_vec(&(&item.item.item, &item.item.metadata)).unwrap_or_default(),
+        );
+        hash.update(b"\n");
+    }
+    let turn_fingerprints = hashes
+        .into_iter()
+        .map(|(id, hash)| (id, format!("{:x}", hash.finalize())))
+        .collect();
+    let mut result = Snapshot {
+        turn_ids,
+        fingerprint: String::new(),
+        turn_fingerprints,
+    };
+    result.fingerprint = format!(
+        "{:x}",
+        Sha1::digest(serde_json::to_vec(&result.turn_fingerprints).unwrap_or_default())
+    );
+    result
+}
+
+/// The turns the runner's Claude session already holds, or `None` when it must start fresh.
+pub(super) fn resumable(
+    ready: &Value,
+    transcript: &ModelTranscript,
+    snapshot: &Snapshot,
+    current_turn: &str,
+) -> Option<HashSet<String>> {
+    let session = &ready["session"];
+    if session.is_null() {
+        return None;
+    }
+    let unchanged = |id: &str, recorded: &Value| {
+        id != current_turn
+            && snapshot
+                .turn_fingerprints
+                .get(id)
+                .is_some_and(|hash| recorded.as_str() == Some(hash.as_str()))
+    };
+    let mut covered = HashSet::new();
+    for id in session["covered"].as_array()? {
+        let id = id.as_str()?;
+        if !unchanged(id, &session["turn_fingerprints"][id]) {
+            return None;
+        }
+        covered.insert(id.to_string());
+    }
+    if !session["dirty"].as_bool().unwrap_or(true) {
+        return Some(covered);
+    }
+    // A request stopped by an expired login (hello "auth_resume") left Claude's transcript
+    // holding every turn it saw plus its own partial work. Input queued during that request
+    // is recorded after Claude's last output and was never seen, so it forces a fresh session.
+    let stop = &session["auth_stop"];
+    let stopped = stop["turn_id"].as_str()?;
+    let prior = stop["turn_fingerprints"].as_object()?;
+    let ends_with_claude_output = transcript
+        .items
+        .iter()
+        .filter(|item| item.turn_id.as_deref() == Some(stopped))
+        .max_by_key(|item| item.position)
+        .is_some_and(|item| {
+            matches!(&item.item.item, ResponseItem::Message { role, .. } if role == "assistant")
+        });
+    if stopped == current_turn
+        || !snapshot.turn_fingerprints.contains_key(stopped)
+        || !ends_with_claude_output
+        || !prior.iter().all(|(id, hash)| unchanged(id, hash))
+    {
+        return None;
+    }
+    covered.extend(prior.keys().cloned());
+    covered.insert(stopped.to_string());
+    Some(covered)
+}
+
+/// Keeps completed items Claude has not seen, with checkpoint offsets recounted to match.
+fn unseen_completed(transcript: &mut ModelTranscript, covered: &HashSet<String>, budget_tokens: i64) {
+    // Checkpoint offsets are relative to item positions. A checkpoint after a turn this Claude
+    // session already holds repeats covered context, so it is set aside and used only when what
+    // Claude has not seen does not fit: a resumed session that missed a long stretch of
+    // other-provider work otherwise lost the summaries written for it (including one made by
+    // /compact for this very handoff) and was refused. Incomplete items (an interrupted turn
+    // long ago, or a concurrent in-flight turn) are dropped too, but they must not discard
+    // every later checkpoint: their checkpoints keep their place by recounting offsets.
+    let id_of = |item: &codex_rollout::TranscriptItem| {
+        item.turn_id
+            .clone()
+            .unwrap_or_else(|| format!("legacy-{}", item.position))
+    };
+    let mut after_covered = Vec::new();
+    if let Some(first_covered) = transcript
+        .items
+        .iter()
+        .position(|item| covered.contains(&id_of(item)))
+    {
+        let (before, after) = std::mem::take(&mut transcript.checkpoints)
+            .into_iter()
+            .partition(|checkpoint| checkpoint.items_before <= first_covered);
+        transcript.checkpoints = before;
+        after_covered = after;
+    }
+    let keep: Vec<bool> = transcript
+        .items
+        .iter()
+        .map(|item| item.completed && !covered.contains(&id_of(item)))
+        .collect();
+    let mut kept_before = Vec::with_capacity(keep.len() + 1);
+    kept_before.push(0usize);
+    for kept in &keep {
+        kept_before.push(kept_before[kept_before.len() - 1] + usize::from(*kept));
+    }
+    for checkpoint in transcript
+        .checkpoints
+        .iter_mut()
+        .chain(after_covered.iter_mut())
+    {
+        checkpoint.items_before = kept_before[checkpoint.items_before.min(keep.len())];
+    }
+    let mut index = 0;
+    transcript.items.retain(|_| {
+        index += 1;
+        keep[index - 1]
+    });
+    if !after_covered.is_empty()
+        && transcript
+            .items
+            .iter()
+            .map(|item| crate::portable_context::rebuild_token_count(&item.item.item))
+            .sum::<i64>()
+            > budget_tokens
+    {
+        transcript.checkpoints.extend(after_covered);
+    }
+}
+
+pub(super) fn handoff(
+    mut transcript: ModelTranscript,
+    ctx: &TurnContext,
+    covered: &HashSet<String>,
+    images: &mut super::images::Images<'_>,
+) -> Result<String> {
+    let agent = ctx
+        .provider
+        .info()
+        .agent
+        .as_ref()
+        .ok_or_else(|| failure("agent configuration missing"))?;
+    unseen_completed(
+        &mut transcript,
+        covered,
+        i64::try_from(agent.handoff_budget_tokens).unwrap_or(i64::MAX),
+    );
+    // Validate summary coverage against canonical bytes before replacing images in this
+    // private handoff view. Snapshot fingerprints and stored history remain unchanged.
+    if crate::portable_context::has_agent_summary(&transcript)
+        && transcript
+            .items
+            .iter()
+            .map(|item| crate::portable_context::rebuild_token_count(&item.item.item))
+            .sum::<i64>()
+            > agent.handoff_budget_tokens as i64
+    {
+        crate::portable_context::apply_verified_summary(
+            &mut transcript,
+            Some(agent.handoff_budget_tokens as i64),
+        );
+    }
+    // Select the portable checkpoint before decoding attachments. Historical
+    // screenshots covered by that checkpoint are not part of this handoff.
+    let staged_images = super::images::StagedImages::new(&mut transcript);
+    // Ask the existing builder for a complete transcript, or the newest portable summary plus
+    // what follows it. When everything after the summary does not fit, the builder keeps the
+    // newest items and says so in a history note that Claude receives. Only a history with no
+    // portable summary at all is refused: its old turns would be dropped without any summary.
+    let mut rebuilt = crate::portable_context::build_context(
+        transcript,
+        &ctx.config,
+        &TargetProvider {
+            family: "claude_code".into(),
+            model: ctx.model_info().slug.clone(),
+        },
+        RebuildBudget {
+            limit_tokens: agent.handoff_budget_tokens as i64,
+            overhead_tokens: 0,
+        },
+        ctx.model_info().truncation_policy.into(),
+    );
+    if matches!(
+        rebuilt.source,
+        crate::portable_context::PortableContextSource::RecentItemsOnly
+    ) {
+        return Err(failure(
+            "shared history exceeds the handoff budget and has no portable summary; run /compact once on a Codex account in this task, then switch to Claude again",
+        ));
+    }
+    staged_images.resolve(&mut rebuilt.items, images)?;
+    let mut text = String::new();
+    for warning in rebuilt.warnings {
+        text.push_str(&format!("[History note: {warning}]\n"));
+    }
+    for envelope in rebuilt.items {
+        match envelope.item {
+            ResponseItem::Message { role, content, .. } => {
+                for part in content {
+                    match part {
+                        ContentItem::InputText { text: part }
+                        | ContentItem::OutputText { text: part } => {
+                            text.push_str(&format!("[{role}] {part}\n"));
+                        }
+                        _ => {
+                            return Err(failure(
+                                "history contains an attachment that the text handoff cannot preserve",
+                            ));
+                        }
+                    }
+                }
+            }
+            ResponseItem::Reasoning { .. }
+            | ResponseItem::Compaction { .. }
+            | ResponseItem::ContextCompaction { .. } => {} // Never export private thinking or signatures.
+            item => {
+                let serialized =
+                    serde_json::to_string(&item).map_err(|err| failure(err.to_string()))?;
+                text.push_str(&format!("[historical tool record] {serialized}\n"));
+            }
+        }
+    }
+    // Re-measure the rendered text with the rebuild's own conservative estimator (role labels
+    // and serialized tool records add a little). A raw byte limit disagreed with that estimator
+    // and refused histories the rebuild had already fitted.
+    let budget = i64::try_from(agent.handoff_budget_tokens).unwrap_or(i64::MAX);
+    if crate::portable_context::text_token_count(&text) > budget.saturating_add(budget / 10) {
+        return Err(failure(
+            "rendered history exceeds the conservative handoff budget; increase the budget or summarize first",
+        ));
+    }
+    Ok(text)
+}
