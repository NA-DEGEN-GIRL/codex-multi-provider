+#[tokio::test]
+async fn a_splice_must_fit_the_limit_and_can_be_disabled() {
+    let config = crate::config::test_config().await;
+    let (records, _) = thread_back_on_gpt(&config, gpt_turns(), POLICY);
+    let transcript = transcript_from_rollout_items(&records);
+    let splice = |policy| splice_context(&transcript, &config, &gpt(), POLICY, policy).err();
