+        .await
+        .expect("claim dormant child without an actor");
+    assert!(Arc::ptr_eq(
+        &guard
+            .binding(child.thread_id())
+            .expect("reserved child binding")
+            .store(),
+        &child.store()
+    ));
+    assert!(fixture.manager.get_thread(child.thread_id()).await.is_err());
+    assert_eq!(std::fs::read(&path).expect("reserved child bytes"), before);
+
+    let competitor = fixture
+        .root
+        .for_child(child.thread_id())
+        .await
+        .expect("independent binding for writer exclusion check");
+    assert!(competitor.prepare_writer().await.is_err());
+    guard
+        .close_thread(child.thread_id())
+        .await
+        .expect("strict dormant writer release");
+
+    assert!(child.is_released());
+    assert!(child.write_permit().await.is_err());
+    assert!(fixture.manager.get_thread(child.thread_id()).await.is_err());
+    assert_eq!(std::fs::read(&path).expect("closed child bytes"), before);
+    drop(
+        competitor
+            .prepare_writer()
+            .await
+            .expect("OS writer lock was released"),
+    );
+    drop(
+        fixture
+            .root
+            .write_permit()
+            .await
+            .expect("root remains writable"),
+    );
+    drop(guard);
+    drop(admission);
+    fixture.finish().await;
+}
