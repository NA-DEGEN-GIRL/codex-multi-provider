+/// Returns the ordinal of the final durable record of a paginated rollout.
+///
+/// Every writer that continues a paginated rollout derives its next ordinal here. Only the
+/// envelope is read: typed `RolloutLine` decoding also rejects valid records, such as an item
+/// from a newer runtime or a `token_count` whose floats `serde_json/arbitrary_precision` cannot
+/// replay through the flattened item, and skipping such a record hands its ordinal to the next
+/// append. Torn records at the tail are skipped, because no reader accepts them and history
+/// projection lets a same-ordinal retry replace a failed write. A complete record without a
+/// readable ordinal is an error, because appending past it could reuse its ordinal.
+pub(crate) fn final_durable_ordinal<R>(reader: R, path: &Path) -> io::Result<Option<u64>>
+where
+    R: Read + Seek,
+{
+    let mut scanner = ReverseJsonlScanner::new(reader)?;
+    while let Some(record) = scanner.scan_next_with(TailRecord::classify)? {
+        match record {
+            TailRecord::Ordinal(ordinal) => return Ok(Some(ordinal)),
+            TailRecord::Torn => {}
+            TailRecord::MissingOrdinal => {
+                return Err(io::Error::other(format!(
+                    "final paginated rollout record at {} is missing an ordinal",
+                    path.display()
+                )));
+            }
+            TailRecord::Corrupt(error) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    format!(
+                        "final rollout record at {} has no readable ordinal ({error}); refusing to append because the next ordinal is unknown",
+                        path.display()
+                    ),
+                ));
+            }
+        }
+    }
+    Ok(None)
+}
+
+#[derive(Deserialize)]
+struct OrdinalEnvelope {
+    ordinal: Option<u64>,
+}
+
+enum TailRecord {
+    Ordinal(u64),
+    MissingOrdinal,
+    /// An append that did not finish: a truncated JSON prefix, or bytes that a crash left zeroed
+    /// because they never reached the disk.
+    Torn,
+    Corrupt(serde_json::Error),
+}
+
+impl TailRecord {
+    fn classify(record: &[u8]) -> Self {
+        // Appended bytes that never reached the disk read back as zeros after a crash, and JSON
+        // text never contains a zero byte.
+        if record.contains(&0) {
+            return Self::Torn;
+        }
+        match record.trim_ascii_start().first() {
+            None => return Self::Torn,
+            Some(b'{') => {}
+            // A derived struct also deserializes from a JSON array; a record is an object.
+            Some(_) => {
+                return Self::Corrupt(serde::de::Error::custom(
+                    "rollout record is not a JSON object",
+                ));
+            }
+        }
+        match serde_json::from_slice::<OrdinalEnvelope>(record) {
+            Ok(OrdinalEnvelope {
+                ordinal: Some(ordinal),
+            }) => Self::Ordinal(ordinal),
+            Ok(OrdinalEnvelope { ordinal: None }) => Self::MissingOrdinal,
+            Err(error) if error.is_eof() => Self::Torn,
+            Err(error) => Self::Corrupt(error),
+        }
+    }
+}
