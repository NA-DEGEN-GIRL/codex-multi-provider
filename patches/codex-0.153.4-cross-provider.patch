new file mode 100644
index 0000000000000000000000000000000000000000..7586c36ad97ea9fccc086117e0c5b9bede3cb39d
--- /dev/null
+++ b/codex-rs/hooks/src/engine/managed_close.rs
@@ -0,0 +1,119 @@
+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+use super::CommandHookRuntime;
+
+/// Proof that this thread's registered hook dispatches and background work were idle,
+/// and that further dispatches were atomically sealed out.
+///
+/// Dropping the token deliberately keeps the seal in place: cancellation after close
+/// was accepted must not reopen the thread. Only call `reopen` before any teardown.
+/// This does not certify the absence of helpers deliberately detached by a hook.
+#[must_use = "retain the seal through managed close, or explicitly reopen before teardown"]
+pub struct HookExecutionSeal {
+    runtime: CommandHookRuntime,
+}
+
+impl std::fmt::Debug for HookExecutionSeal {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("HookExecutionSeal")
+            .finish_non_exhaustive()
+    }
+}
+
+pub(super) struct PendingHookTask(pub(super) Arc<AtomicUsize>);
+
+impl Drop for PendingHookTask {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+
+impl HookExecutionSeal {
+    /// Undo admission sealing after a known-safe failure before teardown begins.
+    /// A runtime already shut down cannot be reopened.
+    pub fn reopen(self) {
+        let mut state = self.runtime.lock_state();
+        if !state.concurrency_limit.is_closed() && !state.managed_session_end_started {
+            state.managed_close_sealed = false;
+        }
+    }
+}
+
+pub(crate) struct HookDispatchGuard {
+    runtime: CommandHookRuntime,
+}
+
+impl Drop for HookDispatchGuard {
+    fn drop(&mut self) {
+        self.runtime.lock_state().active_dispatches -= 1;
+    }
+}
+
+impl CommandHookRuntime {
+    pub(crate) fn has_pending_work(&self) -> bool {
+        let state = self.lock_state();
+        state.active_dispatches != 0
+            || state.pending_tasks.load(Ordering::Acquire) != 0
+            || !self.result_sender.is_empty()
+            || self.cleanup_uncertain.load(Ordering::Acquire)
+    }
+
+    pub(crate) fn try_start_dispatch(&self) -> Option<HookDispatchGuard> {
+        let mut state = self.lock_state();
+        if state.managed_close_sealed {
+            return None;
+        }
+        state.active_dispatches += 1;
+        Some(HookDispatchGuard {
+            runtime: self.clone(),
+        })
+    }
+
+    pub(crate) fn try_seal_for_managed_close(&self) -> Option<HookExecutionSeal> {
+        let mut state = self.lock_state();
+        while state.tasks.try_join_next().is_some() {}
+        if state.managed_close_sealed
+            || state.concurrency_limit.is_closed()
+            || state.active_dispatches != 0
+            || !state.tasks.is_empty()
+            || !self.result_sender.is_empty()
+            || self.cleanup_uncertain.load(Ordering::Acquire)
+        {
+            return None;
+        }
+        state.managed_close_sealed = true;
+        Some(HookExecutionSeal {
+            runtime: self.clone(),
+        })
+    }
+
+    pub(crate) fn start_managed_session_end(
+        &self,
+        seal: &HookExecutionSeal,
+        thread_id: codex_protocol::ThreadId,
+    ) -> anyhow::Result<HookDispatchGuard> {
+        anyhow::ensure!(
+            Arc::ptr_eq(&self.state, &seal.runtime.state) && self.thread_id == thread_id,
+            "hook close seal belongs to a different thread"
+        );
+        let mut state = self.lock_state();
+        anyhow::ensure!(
+            state.managed_close_sealed
+                && !state.managed_session_end_started
+                && state.active_dispatches == 0,
+            "SessionEnd requires an unused managed hook close seal"
+        );
+        state.managed_session_end_started = true;
+        state.active_dispatches += 1;
+        Ok(HookDispatchGuard {
+            runtime: self.clone(),
+        })
+    }
+}
+
