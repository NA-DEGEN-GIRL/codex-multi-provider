+/// The portable summary sends GPT's compaction request with only its trailing trigger replaced,
+/// so the provider can serve the shared prefix from its cache, and it records the summary's
+/// usage on the checkpoint.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn portable_summary_shares_the_compaction_request_prefix() -> Result<()> {
+    let (server, mock) = ProviderMock::start(/*fail_portable_summary*/ false).await;
+    mock.assign_turn_states();
+    let codex_home = TempDir::new()?;
+    write_responses_lite_config(&codex_home, &server).await?;
+    let (mut mcp, thread_id) = configured_gpt_thread_used_by_deepseek(
+        codex_home.path(),
+        ThreadHistoryMode::Legacy,
+        Some(TOOL_TURN_COMPACT_LIMIT),
+    )
+    .await?;
+
+    // GPT compacts in the middle of a turn, between its tool calls and its answer.
+    let start = mock.request_count();
+    run_turn(&mut mcp, &thread_id, TOOL_TURN).await?;
+    let requests = mock.requests_with_turn_states_since(start);
+    let only = |kind: RequestKind| {
+        let matching = requests
+            .iter()
+            .filter(|(body, _)| body["model"] == GPT_MODEL && request_kind(body) == kind)
+            .collect::<Vec<_>>();
+        assert_eq!(matching.len(), 1, "expected one request of that kind");
+        matching[0].clone()
+    };
+    let (compaction, compaction_turn_state) = only(RequestKind::NativeCompaction);
+    let (summary, summary_turn_state) = only(RequestKind::Summary);
+
+    // Every setting matches: tools, instructions, tool settings, output format, reasoning effort
+    // and summary, service tier and cache key.
+    let (compaction_input, compaction_settings) = split_input(&compaction);
+    let (summary_input, summary_settings) = split_input(&summary);
+    assert_eq!(summary_settings, compaction_settings);
+    assert_eq!(compaction_settings["reasoning"]["effort"], "high");
+    assert_eq!(compaction_settings["reasoning"]["summary"], "concise");
+    assert_eq!(compaction_settings["service_tier"], "priority");
+    assert!(compaction_settings.get("tools").is_none());
+
+    // The inputs differ only in the last item: the trigger, or the summary instruction.
+    // Responses Lite sends the tools and instructions first, so they are part of the prefix.
+    let (trigger, prefix) = compaction_input.split_last().expect("compaction input");
+    assert_eq!(trigger["type"], "compaction_trigger");
+    assert_eq!(prefix[0]["type"], "additional_tools");
+    assert!(
+        prefix[0]["tools"].to_string().contains("\"update_plan\""),
+        "compaction must offer the turn's tools"
+    );
+    assert!(prefix[1].to_string().contains(BASE_INSTRUCTIONS));
+    assert_eq!(summary_input.len(), compaction_input.len());
+    assert_eq!(&summary_input[..prefix.len()], prefix);
+    let instruction = &summary_input[prefix.len()];
+    assert_eq!(instruction["role"], "user");
+    assert!(instruction.to_string().contains(COMPACT_PROMPT));
+    assert!(instruction.to_string().contains("do not call any tools"));
+
+    // Both carry the turn's sticky routing, which the turn's first response assigned.
+    assert!(
+        compaction_turn_state
+            .as_deref()
+            .is_some_and(|state| state.starts_with("turn-state-"))
+    );
+    assert_eq!(summary_turn_state, compaction_turn_state);
+
+    // The summary's usage and running time are recorded on the checkpoint.
+    timeout(DEFAULT_READ_TIMEOUT, mcp.shutdown_gracefully()).await??;
+    drop(mcp);
+    let checkpoint = newest_checkpoint(codex_home.path(), &thread_id)?;
+    assert_eq!(checkpoint["portable"]["status"], json!({"state": "ready"}));
+    assert_eq!(checkpoint["portable"]["summary"], GPT_PORTABLE_SUMMARY);
+    assert_eq!(
+        checkpoint["portable"]["usage"],
+        json!({
+            "input_tokens": SUMMARY_INPUT_TOKENS,
+            "cached_input_tokens": SUMMARY_CACHED_INPUT_TOKENS,
+            "output_tokens": SUMMARY_OUTPUT_TOKENS,
+            "reasoning_output_tokens": SUMMARY_REASONING_TOKENS,
+        })
+    );
+    assert_summary_ran_for_its_delay(&checkpoint);
+    Ok(())
+}
+
+/// The checkpoint records how long its summary request ran, which the mock delays.
+fn assert_summary_ran_for_its_delay(checkpoint: &Value) {
+    let elapsed_ms = checkpoint["portable"]["elapsed_ms"]
+        .as_u64()
+        .expect("summary running time");
+    let delay_ms = u64::try_from(SUMMARY_DELAY.as_millis()).expect("delay milliseconds");
+    assert!(
+        (delay_ms..delay_ms + DEFAULT_READ_TIMEOUT.as_secs() * 1_000).contains(&elapsed_ms),
+        "summary ran for {elapsed_ms} ms"
+    );
+}
