index 0000000000000000000000000000000000000000..373d73b330c3306b7bcc30bafcf6b20f6e4b3ffa
--- /dev/null
+++ b/codex-rs/rollout/src/recorder_shared_append.rs
@@ -0,0 +1,83 @@
+//! Serialize a single durable append across participating manager profiles.
+//! No account owns the task: the lease ends before inference or tool execution.
+use std::fs::OpenOptions;
+use std::io;
+use std::io::Write;
+use std::path::PathBuf;
+
+use super::RolloutItem;
+use super::RolloutLineRef;
+use crate::reverse_jsonl_scanner::ReverseJsonlScanner;
+use crate::reverse_jsonl_scanner::ScanOutcome;
+
+pub(super) async fn append(
+    path: PathBuf,
+    timestamp: String,
+    item: RolloutItem,
+    initial_ordinal: Option<u64>,
+) -> io::Result<()> {
+    // Keep the lease and write in one owned blocking task. Cancellation cannot
+    // release the lock while the append continues on a different executor.
+    tokio::task::spawn_blocking(move || {
+        let lease = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(path.with_extension("manager-append.lock"))?;
+        lease.lock()?;
+        let mut file = OpenOptions::new().read(true).append(true).open(&path)?;
+        // Resume already validated history mode and completed inherited prefixes.
+        // A newly created V2 child is still copying its inherited prefix here;
+        // applying the resume-only completeness check after each line would
+        // prevent that prefix from ever being completed.
+        let ordinal = match initial_ordinal {
+            None => None,
+            Some(initial) if file.metadata()?.len() == 0 => Some(initial),
+            Some(_) => Some(next_durable_ordinal(&mut file)?),
+        };
+        let line = RolloutLineRef {
+            timestamp,
+            ordinal,
+            item: &item,
+        };
+        let mut bytes = serde_json::to_vec(&line)?;
+        bytes.push(b'\n');
+        file.write_all(&bytes)?;
+        file.flush()?;
+        drop(lease);
+        Ok(())
+    })
+    .await
+    .map_err(io::Error::other)?
+}
+
+fn next_durable_ordinal(file: &mut std::fs::File) -> io::Result<u64> {
+    // The envelope owns the sequence number. A newer runtime may write a
+    // payload variant this binary cannot deserialize (for example token_count).
+    // Skipping that record would reuse its ordinal and break history paging.
+    #[derive(serde::Deserialize)]
+    struct Envelope {
+        ordinal: u64,
+    }
+    let mut scanner = ReverseJsonlScanner::new(file)?;
+    match scanner.scan_next::<Envelope>()? {
+        Some(ScanOutcome::Parsed(record)) => {
+            return record.ordinal.checked_add(1).ok_or_else(|| {
+                io::Error::other("shared paginated record has no available next ordinal")
+            });
+        }
+        Some(ScanOutcome::Rejected(error)) => Err(io::Error::other(format!(
+            "shared paginated record has an invalid final envelope: {error}"
+        ))),
+        None => {
+            return Err(io::Error::other(
+                "shared paginated record has no durable ordinal",
+            ));
+        }
+    }
+}
