+++ b/codex-rs/app-server/tests/suite/v2/managed_handoff_names.rs
@@ -0,0 +1,142 @@
+//! Renames follow an already-held canonical writer without starting model work.
+
+use super::*;
+use codex_app_server_protocol::ThreadNameUpdatedNotification;
+use codex_app_server_protocol::ThreadSetNameResponse;
+use pretty_assertions::assert_eq;
+
+pub(super) async fn rename(server: &mut TestAppServer, thread_id: &str, name: &str) -> Result<()> {
+    let request = server
+        .send_raw_request(
+            "thread/name/set",
+            Some(json!({ "threadId": thread_id, "name": name })),
+        )
+        .await?;
+    let _: ThreadSetNameResponse = timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    let notification = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_notification_message("thread/name/updated"),
+    )
+    .await??;
+    let updated: ThreadNameUpdatedNotification =
+        serde_json::from_value(notification.params.context("updated name")?)?;
+    assert_eq!(
+        updated,
+        ThreadNameUpdatedNotification {
+            thread_id: thread_id.to_string(),
+            thread_name: Some(name.to_string()),
+        }
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn managed_names_follow_the_canonical_writer_without_loading_a_viewer() -> Result<()> {
+    let source_api = responses::start_mock_server().await;
+    let target_api = responses::start_mock_server().await;
+    let source_requests = responses::mount_sse_sequence(
+        &source_api,
+        vec![create_final_assistant_message_sse_response("Initial work")?],
+    )
+    .await;
+    let source = ManagedProfile::new(&source_api.uri(), "source-model", "source-token")?;
+    let target = ManagedProfile::new(&target_api.uri(), "target-model", "target-token")?;
+    source.write_manifest(&[&source], Vec::new())?;
+    let mut owner = source.start_server().await?;
+    let canonical = owner
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    complete_turn(&mut owner, &canonical.id, "Create a stored record").await?;
+    rename(&mut owner, &canonical.id, "공통 제목 · 첫 계정").await?;
+
+    target.write_manifest(
+        &[&source, &target],
+        vec![binding_grant(
+            &source,
+            &source,
+            &canonical.id,
+            /*epoch*/ 1,
+        )],
+    )?;
+    let mut viewer = target.start_server().await?;
+    let request = viewer
+        .send_raw_request(
+            "thread/name/set",
+            Some(json!({ "threadId": canonical.id, "name": "unowned change" })),
+        )
+        .await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        viewer.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    assert!(error.error.message.contains("assigned profile"));
+    let request = viewer
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, viewer.read_response(request)).await??;
+    assert_eq!(loaded.data, Vec::<String>::new());
+
+    close_idle(&mut owner, &canonical.id).await?;
+    transfer_authority(
+        &source,
+        &canonical.id,
+        &source,
+        /*previous_epoch*/ 1,
+        &target,
+    )?;
+    target.write_manifest(
+        &[&source, &target],
+        vec![binding_grant(
+            &source,
+            &target,
+            &canonical.id,
+            /*epoch*/ 2,
+        )],
+    )?;
+    let request = viewer
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: canonical.id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let resumed: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, viewer.read_response(request)).await??;
+    assert_eq!(resumed.thread.name.as_deref(), Some("공통 제목 · 첫 계정"));
+    rename(&mut viewer, &canonical.id, "공통 제목 · 지정 계정").await?;
+
+    let request = owner
+        .send_raw_request(
+            "thread/name/set",
+            Some(json!({ "threadId": canonical.id, "name": "stale change" })),
+        )
+        .await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        owner.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    assert!(error.error.message.contains("released by this instance"));
+    let request = owner
+        .send_raw_request("thread/read", Some(json!({ "threadId": canonical.id })))
+        .await?;
+    let stored: ThreadReadResponse = timeout(READ_TIMEOUT, owner.read_response(request)).await??;
+    assert_eq!(stored.thread.name.as_deref(), Some("공통 제목 · 지정 계정"));
+    let target_rows =
+        read_thread_state_audit_rows(&SqliteConfig::new_for_testing(target.home.path().abs()))
+            .await?;
+    assert!(!target_rows.iter().any(|row| row.id == canonical.id));
+    assert_eq!(source_requests.requests().len(), 1);
+    assert!(
+        target_api
+            .received_requests()
+            .await
+            .context("target request recording")?
+            .iter()
+            .all(|request| !request.url.path().ends_with("/responses"))
+    );
+    close_idle(&mut viewer, &canonical.id).await?;
+    Ok(())
+}
diff --git a/codex-rs/app-server/tests/suite/v2/managed_instance_activity.rs b/codex-rs/app-server/tests/suite/v2/managed_instance_activity.rs
new file mode 100644
index 000000000..9dfa0b390
--- /dev/null
+++ b/codex-rs/app-server/tests/suite/v2/managed_instance_activity.rs
@@ -0,0 +1,192 @@
+//! Observe real command/process lifetimes after their initiating request returns.
+use super::*;
+use codex_app_server_protocol::ServerDiagnosticsResponse;
+use codex_app_server_protocol::ServerManagedShutdownResponse;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn managed_process_activity_survives_spawn_response_and_drains_after_exit() -> Result<()> {
+    let api = responses::start_mock_server().await;
+    let profile = ManagedProfile::new(&api.uri(), "mock-model", "mock-token")?;
+    profile.write_manifest(&[&profile], Vec::new())?;
+    let mut server = profile.start_server().await?;
+    // Starting a root must not permanently retain its request activity context.
+    server.start_thread(ThreadStartParams::default()).await?;
+    let command = if cfg!(windows) {
+        vec![
+            "powershell.exe",
+            "-NoLogo",
+            "-NoProfile",
+            "-NonInteractive",
+            "-Command",
+            "[Console]::In.ReadLine() | Out-Null",
+        ]
+    } else {
+        vec!["sh", "-c", "read line"]
+    };
+    let spawn = server
+        .send_raw_request(
+            "process/spawn",
+            Some(json!({
+                "command":command,"processHandle":"maintenance-probe","cwd":profile.home.path(),
+                "streamStdin":true,"timeoutMs":30000
+            })),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, server.read_response(spawn)).await??;
+    let diagnostics = server
+        .send_raw_request("server/diagnostics", Some(json!({})))
+        .await?;
+    let diagnostics: ServerDiagnosticsResponse =
+        timeout(READ_TIMEOUT, server.read_response(diagnostics)).await??;
+    let gauge = |name: &str| {
+        diagnostics
+            .gauges
+            .iter()
+            .find(|gauge| gauge.name == name)
+            .map(|gauge| gauge.value)
+    };
+    assert_eq!(gauge("app.managed.processes.running"), Some(1));
+    assert_eq!(gauge("app.managed.requests.pending_completion"), Some(1));
+    let process_id = diagnostics.process.id;
+    let shutdown = server
+        .send_raw_request(
+            "server/managedShutdown",
+            Some(json!({"processId":process_id})),
+        )
+        .await?;
+    let rejected = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_error_message(RequestId::Integer(shutdown)),
+    )
+    .await??;
+    assert!(rejected.error.message.contains("operations in flight"));
+    let stop = server
+        .send_raw_request(
+            "process/writeStdin",
+            Some(json!({
+                "processHandle":"maintenance-probe","closeStdin":true
+            })),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, server.read_response(stop)).await??;
+    timeout(READ_TIMEOUT, async {
+        loop {
+            let request = server
+                .send_raw_request("server/diagnostics", Some(json!({})))
+                .await?;
+            let diagnostics: ServerDiagnosticsResponse = server.read_response(request).await?;
+            if diagnostics
+                .gauges
+                .iter()
+                .any(|gauge| gauge.name == "app.managed.processes.running" && gauge.value == 0)
+            {
+                break Ok::<(), anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await??;
+    let shutdown = server
+        .send_raw_request(
+            "server/managedShutdown",
+            Some(json!({"processId":process_id})),
+        )
+        .await?;
+    let result: ServerManagedShutdownResponse =
+        timeout(READ_TIMEOUT, server.read_response(shutdown)).await??;
+    assert!(result.shutdown_requested && result.writer_release_verified);
+    assert!(
+        timeout(READ_TIMEOUT, server.wait_for_exit())
+            .await??
+            .success()
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn managed_shutdown_verifies_identity_drains_roots_and_preserves_records() -> Result<()> {
+    let api = responses::start_mock_server().await;
+    let _responses = responses::mount_sse_sequence(
+        &api,
+        vec![create_final_assistant_message_sse_response(
+            "Persisted maintenance fixture",
+        )?],
+    )
+    .await;
+    let profile = ManagedProfile::new(&api.uri(), "mock-model", "mock-token")?;
+    profile.write_manifest(&[&profile], Vec::new())?;
+    let mut server = profile.start_server().await?;
+    let first = server
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    complete_turn(&mut server, &first, "Persist this test conversation").await?;
+    let second = server
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let request = server
+        .send_raw_request("server/diagnostics", Some(json!({})))
+        .await?;
+    let diagnostics: ServerDiagnosticsResponse = server.read_response(request).await?;
+    let invalid = server
+        .send_raw_request("server/managedShutdown", Some(json!({"processId":0})))
+        .await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        server.read_stream_until_error_message(RequestId::Integer(invalid)),
+    )
+    .await??;
+    assert!(error.error.message.contains("exact managed process"));
+    let request = server
+        .send_raw_request(
+            "server/managedShutdown",
+            Some(json!({"processId":diagnostics.process.id})),
+        )
+        .await?;
+    let mut response: ServerManagedShutdownResponse =
+        timeout(READ_TIMEOUT, server.read_response(request)).await??;
+    response.closed_thread_ids.sort();
+    let mut expected = vec![first.clone(), second];
+    expected.sort();
+    assert_eq!(
+        response,
+        ServerManagedShutdownResponse {
+            process_id: diagnostics.process.id,
+            closed_thread_ids: expected,
+            shutdown_requested: true,
+            writer_release_verified: true,
+        }
+    );
+    // Keep the client input open: only the maintenance RPC may cause this exit.
+    assert!(
+        timeout(READ_TIMEOUT, server.wait_for_exit())
+            .await??
+            .success()
+    );
+    // A fresh process receives the same durable owner grant from the manager.
+    // Shutdown does not advance ownership or synthesize an account transfer.
+    profile.write_manifest(
+        &[&profile],
+        vec![binding_grant(&profile, &profile, &first, /*epoch*/ 1)],
+    )?;
+    let mut reopened = profile.start_server().await?;
+    let resume = reopened
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: first.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let response: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, reopened.read_response(resume)).await??;
+    assert_eq!(response.thread.id, first);
+    assert!(
+        timeout(READ_TIMEOUT, reopened.shutdown_gracefully())
+            .await??
+            .success()
+    );
+    Ok(())
+}
diff --git a/codex-rs/app-server/tests/suite/v2/managed_instance_shutdown_websocket.rs b/codex-rs/app-server/tests/suite/v2/managed_instance_shutdown_websocket.rs
