--- /dev/null
+++ b/codex-rs/thread-store/src/local/model_transcript.rs
@@ -0,0 +1,85 @@
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_rollout::ModelTranscriptBuilder;
+
+use super::LocalThreadStore;
+use super::thread_rollout_resolver;
+use crate::LoadThreadHistoryParams;
+use crate::StoredModelTranscript;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+#[cfg(test)]
+#[path = "model_transcript_tests.rs"]
+mod tests;
+
+/// Loads every valid model-visible item of a thread, oldest first.
+///
+/// Paginated threads read each lineage segment forward, up to the cutoff recorded in the child's
+/// `history_base`, so a reverted or forked thread sees only the history it inherited. Legacy
+/// threads read their single rollout forward. Records are streamed; only transcript items are
+/// kept in memory.
+pub(super) async fn load_model_transcript(
+    store: &LocalThreadStore,
+    params: LoadThreadHistoryParams,
+) -> ThreadStoreResult<StoredModelTranscript> {
+    let resolved = if params.include_archived {
+        thread_rollout_resolver::resolve_current_including_archived(store, params.thread_id).await?
+    } else {
+        thread_rollout_resolver::resolve_current(store, params.thread_id).await?
+    };
+    let path =
+        resolved
+            .map(|resolved| resolved.path)
+            .ok_or_else(|| ThreadStoreError::InvalidRequest {
+                message: format!("no rollout found for thread id {}", params.thread_id),
+            })?;
+    let session_meta = codex_rollout::read_session_meta_line(path.as_path())
+        .await
+        .map_err(|err| ThreadStoreError::Internal {
+            message: format!("failed to read session metadata {}: {err}", path.display()),
+        })?;
+    if session_meta.meta.id != params.thread_id {
+        return Err(ThreadStoreError::InvalidRequest {
+            message: format!(
+                "rollout at {} belongs to thread {}, not {}",
+                path.display(),
+                session_meta.meta.id,
+                params.thread_id
+            ),
+        });
+    }
+
+    let mut builder = ModelTranscriptBuilder::new();
+    if matches!(session_meta.meta.history_mode, ThreadHistoryMode::Paginated) {
+        let lineage = store.resolve_rollout_lineage(params.thread_id).await?;
+        for segment in lineage.segments() {
+            codex_rollout::read_model_transcript_segment(
+                segment.rollout_path.as_path(),
+                segment.end_ordinal(),
+                &mut builder,
+            )
+            .await
+            .map_err(|err| ThreadStoreError::Internal {
+                message: format!(
+                    "failed to read model transcript {}: {err}",
+                    segment.rollout_path.display()
+                ),
+            })?;
+        }
+    } else {
+        codex_rollout::read_model_transcript_segment(
+            path.as_path(),
+            /*end_ordinal_exclusive*/ None,
+            &mut builder,
+        )
+        .await
+        .map_err(|err| ThreadStoreError::Internal {
+            message: format!("failed to read model transcript {}: {err}", path.display()),
+        })?;
+    }
+
+    Ok(StoredModelTranscript {
+        thread_id: params.thread_id,
+        transcript: builder.finish(),
+    })
+}
