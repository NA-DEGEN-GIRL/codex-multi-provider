@@ -0,0 +1,235 @@
+use std::fs::File;
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::Weak;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+use codex_protocol::ThreadId;
+
+use super::LocalThreadStore;
+use super::writer_lock::WriterLockGuard;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+pub(super) type ReservationSlot = Arc<Mutex<Option<Weak<ReservationState>>>>;
+
+/// Holds the actual source writer lock from before initialization through recorder open.
+///
+/// Dropping an unconsumed reservation releases only that reservation. Once consumed by
+/// create/resume, the recorder owns its exact lock and this handle no longer releases it.
+/// It deliberately does not retain a managed local RW permit across session startup.
+pub struct ManagedWriterReservation {
+    state: Option<Arc<ReservationState>>,
+}
+
+pub(super) struct ReservationState {
+    thread_id: ThreadId,
+    ready: AtomicBool,
+    writer: Mutex<Option<ReservedWriter>>,
+}
+
+struct ReservedWriter {
+    writer_lock: WriterLockGuard,
+    authority_lease: Option<File>,
+}
+
+impl std::fmt::Debug for ManagedWriterReservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ManagedWriterReservation")
+            .field(
+                "thread_id",
+                &self.state.as_ref().map(|state| state.thread_id),
+            )
+            .finish_non_exhaustive()
+    }
+}
+
+impl LocalThreadStore {
+    /// Acquire the exact managed OS writer lock before opening or repairing source state.
+    ///
+    /// The returned value must remain alive through mutable history preparation and the
+    /// matching create/resume. Independent calls conflict, including the same durable owner.
+    /// Cancellation detaches initialization instead of releasing its writer prematurely.
+    /// Ordinary stores return a no-op handle and retain their existing initialization rules.
+    pub async fn prepare_managed_writer(
+        &self,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<ManagedWriterReservation> {
+        self.prepare_managed_writer_with_init(thread_id, |store| async move {
+            store.initialize_managed_state_db().await
+        })
+        .await
+    }
+
+    async fn prepare_managed_writer_with_init<F, Fut>(
+        &self,
+        thread_id: ThreadId,
+        initialize: F,
+    ) -> ThreadStoreResult<ManagedWriterReservation>
+    where
+        F: FnOnce(LocalThreadStore) -> Fut + Send + 'static,
+        Fut: Future<Output = ThreadStoreResult<()>> + Send + 'static,
+    {
+        if !self.is_managed_thread_scope() {
+            return Ok(ManagedWriterReservation { state: None });
+        }
+        let store = self.clone();
+        tokio::spawn(async move {
+            // A short scope permit makes close wait for DB initialization. It is dropped
+            // before returning, so later startup calls can acquire nonnested permits.
+            let permit = store.managed_write_permit(thread_id).await?;
+            store.ensure_live_recorder_absent(thread_id).await?;
+            let reservation = store.reserve_managed_writer_lock(thread_id)?;
+            // The owned task retains the reservation even when its awaiting caller is gone.
+            initialize(store).await?;
+            let authority_lease = permit.into_authority_lease();
+            {
+                let mut writer = reservation.writer.lock().map_err(|_| poisoned())?;
+                writer
+                    .as_mut()
+                    .ok_or_else(|| conflict("managed writer reservation was consumed early"))?
+                    .authority_lease = authority_lease;
+            }
+            reservation.ready.store(true, Ordering::Release);
+            Ok(ManagedWriterReservation {
+                state: Some(reservation),
+            })
+        })
+        .await
+        .map_err(join_error)?
+    }
+
+    async fn initialize_managed_state_db(&self) -> ThreadStoreResult<()> {
+        self.state_db
+            .get_or_try_init(|| async {
+                codex_state::StateRuntime::init(
+                    self.config.sqlite.clone(),
+                    self.config.default_model_provider_id.clone(),
+                )
+                .await
+                .map_err(|error| ThreadStoreError::Internal {
+                    message: format!("failed to initialize managed source state: {error}"),
+                })
+            })
+            .await?;
+        Ok(())
+    }
+
+    fn reserve_managed_writer_lock(
+        &self,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<Arc<ReservationState>> {
+        let mut slot = self
+            .managed_writer_reservation
+            .lock()
+            .map_err(|_| poisoned())?;
+        if slot.as_ref().and_then(Weak::upgrade).is_some() {
+            return Err(conflict("managed writer preparation is already reserved"));
+        }
+        // No DB open, metadata read/repair, or rollover may occur before this acquisition.
+        let writer_lock = self.writer_lock_coordinator.acquire(thread_id)?;
+        let reservation = Arc::new(ReservationState {
+            thread_id,
+            ready: AtomicBool::new(false),
+            writer: Mutex::new(Some(ReservedWriter {
+                writer_lock,
+                authority_lease: None,
+            })),
+        });
+        *slot = Some(Arc::downgrade(&reservation));
+        Ok(reservation)
+    }
+
+    /// Auto-open may retain the ready reservation prepared by its owning Session startup.
+    /// Only take_writer_reservation mutates it, under the per-thread live writer mutex.
+    pub(crate) async fn managed_writer_for_open(
+        &self,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<ManagedWriterReservation> {
+        let pending = self
+            .managed_writer_reservation
+            .lock()
+            .map_err(|_| poisoned())?
+            .as_ref()
+            .and_then(Weak::upgrade);
+        if let Some(state) = pending {
+            if state.thread_id != thread_id || !state.ready.load(Ordering::Acquire) {
+                return Err(conflict(
+                    "managed writer preparation is not ready for this thread",
+                ));
+            }
+            return Ok(ManagedWriterReservation { state: Some(state) });
+        }
+        self.prepare_managed_writer(thread_id).await
+    }
+
+    /// Called only after live writer serialization and the absent-recorder check.
+    pub(super) fn take_writer_reservation(
+        &self,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<(WriterLockGuard, Option<File>)> {
+        if !self.is_managed_thread_scope() {
+            return self
+                .writer_lock_coordinator
+                .acquire(thread_id)
+                .map(|guard| (guard, None));
+        }
+        let reservation = self
+            .managed_writer_reservation
+            .lock()
+            .map_err(|_| poisoned())?
+            .as_ref()
+            .and_then(Weak::upgrade)
+            .ok_or_else(|| conflict("managed writer was not prepared"))?;
+        if reservation.thread_id != thread_id || !reservation.ready.load(Ordering::Acquire) {
+            return Err(conflict(
+                "managed writer preparation is not ready for this thread",
+            ));
+        }
+        let writer = reservation
+            .writer
+            .lock()
+            .map_err(|_| poisoned())?
+            .take()
+            .ok_or_else(|| conflict("managed writer reservation was already consumed"))?;
+        {
+            let mut slot = self
+                .managed_writer_reservation
+                .lock()
+                .map_err(|_| poisoned())?;
+            // Old public handles own only an empty state and have no slot-clearing Drop.
+            if slot
+                .as_ref()
+                .is_some_and(|pending| Weak::ptr_eq(pending, &Arc::downgrade(&reservation)))
+            {
+                *slot = None;
+            }
+        }
+        // Neither an error nor the eventual writer drop holds the reservation slot mutex.
+        Ok((writer.writer_lock, writer.authority_lease))
+    }
+}
+
+fn conflict(message: &str) -> ThreadStoreError {
+    ThreadStoreError::Conflict {
+        message: message.to_string(),
+    }
+}
+
+fn poisoned() -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: "managed writer reservation mutex was poisoned".to_string(),
+    }
+}
+
+pub(super) fn join_error(error: tokio::task::JoinError) -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: format!("managed writer preparation or open failed: {error}"),
+    }
+}
+
