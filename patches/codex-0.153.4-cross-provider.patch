+        // callbacks. It never force-stops work to refresh another app's changes.
+        if let Err(err) = thread.close_idle_and_shutdown_reserved(admission).await {
+            state.lock().await.take_shutdown_drain_waiter();
+            return Err(invalid_request(format!(
+                "shared history changed while this task still has pending work: {err}"
+            )));
+        }
