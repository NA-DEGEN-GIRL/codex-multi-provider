+#[test]
+/// Keeps portable checkpoint metadata optional in both directions of the wire format.
+fn compacted_portable_metadata_is_backward_compatible() -> Result<()> {
+    #[derive(Deserialize)]
+    #[serde(tag = "type", content = "payload", rename_all = "snake_case")]
+    enum OlderRolloutItem {
+        Compacted(OlderCompactedItem),
+    }
+
+    #[derive(Debug, Deserialize, PartialEq)]
+    struct OlderCompactedItem {
+        message: String,
+        replacement_history: Option<Vec<ResponseItem>>,
+    }
+
+    let item = CompactedItem {
+        message: String::new(),
+        replacement_history: Some(vec![ResponseItemEnvelope::new(response_message("user"))]),
+        guardian_history: None,
+        mcp_resource_origins: None,
+        window_number: Some(1),
+        first_window_id: None,
+        previous_window_id: None,
+        window_id: None,
+        compaction_response_id: None,
+        latest_token_usage_record: None,
+        origin: Some(CompactionOrigin {
+            provider_family: "openai".to_string(),
+            provider_id: "openai".to_string(),
+            model: "gpt-test".to_string(),
+            kind: CheckpointKind::Compaction,
+        }),
+        portable: Some(PortableCheckpoint {
+            summary: "plaintext summary".to_string(),
+            status: PortableCheckpointStatus::Ready,
+            covers: PortableCoverage {
+                position: None,
+                through_turn_id: Some("turn-1".to_string()),
+                through_item_id: Some("msg_1".to_string()),
+                output_items: Some(2),
+            },
+            usage: None,
+            elapsed_ms: None,
+        }),
+    };
+    let line = serde_json::to_value(RolloutItem::Compacted(item.clone()))?;
+    assert_eq!(
+        line["payload"]["portable"],
+        json!({
+            "summary": "plaintext summary",
+            "status": {"state": "ready"},
+            "covers": {"through_turn_id": "turn-1", "through_item_id": "msg_1", "output_items": 2},
+        })
+    );
+    let RolloutItem::Compacted(restored) = serde_json::from_value::<RolloutItem>(line.clone())?
+    else {
+        panic!("expected compacted item");
+    };
+    assert_eq!(restored, item);
+
+    // Readers that predate portable checkpoints ignore the new fields.
+    let OlderRolloutItem::Compacted(older) = serde_json::from_value::<OlderRolloutItem>(line)?;
+    assert_eq!(
+        older,
+        OlderCompactedItem {
+            message: String::new(),
+            replacement_history: Some(vec![response_message("user")]),
+        }
+    );
+
+    // Checkpoints written before portable checkpoints have neither field, and a status written by
+    // a newer runtime reads as unknown instead of failing the whole record.
+    let older_line = serde_json::from_value::<CompactedItem>(json!({"message": "summary"}))?;
+    assert_eq!((older_line.origin, older_line.portable), (None, None));
+    let newer_status = serde_json::from_value::<CompactedItem>(json!({
+        "message": "",
+        "portable": {"summary": "", "status": {"state": "queued", "attempt": 2}},
+    }))?;
+    assert_eq!(
+        newer_status.portable.map(|portable| portable.status),
+        Some(PortableCheckpointStatus::Unknown)
+    );
+
+    // A partial or malformed origin or portable form from another writer degrades only that
+    // field; the checkpoint itself stays readable.
+    let partial = serde_json::from_value::<CompactedItem>(json!({
+        "message": "summary",
+        "origin": {"provider_family": "openai"},
+        "portable": {"status": {"state": "failed"}},
+    }))?;
+    assert_eq!(
+        (partial.origin, partial.portable),
+        (
+            Some(CompactionOrigin {
+                provider_family: "openai".to_string(),
+                provider_id: String::new(),
+                model: String::new(),
+                kind: CheckpointKind::Compaction,
+            }),
+            Some(PortableCheckpoint {
+                summary: String::new(),
+                status: PortableCheckpointStatus::Failed {
+                    reason: String::new(),
+                },
+                covers: PortableCoverage::default(),
+                usage: None,
+                elapsed_ms: None,
+            }),
+        )
+    );
+    let malformed = serde_json::from_value::<CompactedItem>(json!({
+        "message": "summary",
+        "replacement_history": [],
+        "origin": {"provider_id": "deepseek"},
+        "portable": {"summary": 7, "status": "ready", "covers": []},
+    }))?;
+    assert_eq!(
+        (
+            malformed.message,
+            malformed.replacement_history,
+            malformed.origin,
+            malformed.portable
+        ),
+        (
+            "summary".to_string(),
+            Some(Vec::new()),
+            None,
+            Some(PortableCheckpoint {
+                summary: String::new(),
+                status: PortableCheckpointStatus::Unknown,
+                covers: PortableCoverage::default(),
+                usage: None,
+                elapsed_ms: None,
+            }),
+        )
+    );
+
+    // A compaction's kind is implied; other kinds are written, and one from a newer runtime
+    // reads as unknown.
+    let rebuilt = CompactionOrigin {
+        provider_family: "deepseek".to_string(),
+        provider_id: "deepseek".to_string(),
+        model: "deepseek-test".to_string(),
+        kind: CheckpointKind::Rebuilt {
+            from_family: "openai".to_string(),
+            spliced: None,
+            return_anchors: Vec::new(),
+        },
+    };
+    let origins = [
+        serde_json::to_value(CompactionOrigin {
+            kind: CheckpointKind::Compaction,
+            ..rebuilt.clone()
+        })?,
+        serde_json::to_value(&rebuilt)?,
+    ];
+    assert_eq!(
+        origins.map(|origin| origin["kind"].clone()),
+        [
+            serde_json::Value::Null,
+            json!({"type": "rebuilt", "from_family": "openai"})
+        ]
+    );
+    let newer_kind = serde_json::from_value::<CompactionOrigin>(json!({
+        "provider_family": "openai",
+        "kind": {"type": "merged", "sources": 3},
+    }))?;
+    assert_eq!(newer_kind.kind, CheckpointKind::Unknown);
+    Ok(())
+}
