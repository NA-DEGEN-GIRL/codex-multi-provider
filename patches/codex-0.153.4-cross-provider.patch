+            "version":3,"hostId":"local","sources":[],
+            "legacySources":[legacy_source(mirror.path()),descriptor,legacy_source(second.path())]
+        }))?,
+    )?;
+    let mut reader = super::catalog_sources::start_shared(&viewer, &catalog).await?;
+    let listed = super::catalog_sources::list(&mut reader).await?;
+    assert_eq!(listed.data.len(), 1);
+    assert_eq!(
+        (&listed.data[0].id, listed.data[0].name.as_deref()),
+        (&projected, Some("Latest foreign name"))
+    );
+    let origin = listed.data[0]
+        .extra
+        .as_ref()
+        .context("origin")?
+        .managed_record
+        .as_ref()
+        .context("managed origin")?;
+    assert_eq!(
+        (
+            origin.source_store_id.as_str(),
+            origin.canonical_thread_id.as_str()
+        ),
+        (
+            descriptor["sourceStoreId"].as_str().context("owner id")?,
+            id.as_str()
+        )
+    );
+    let request = reader
+        .send_raw_request(
+            "thread/read",
+            Some(json!({"threadId":projected,"includeTurns":true})),
+        )
+        .await?;
+    let read: ThreadReadResponse = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert_eq!(read.thread.name.as_deref(), Some("Latest foreign name"));
+    assert_eq!(read.thread.id, projected);
+    assert!(!read.thread.turns.is_empty());
+    assert_eq!(fs::read(&path)?, original);
+
+    // A newer foreign copy must not overrule an existing owner state row.
+    metadata.title = "Owner saved name".to_string();
+    metadata.updated_at -= chrono::Duration::seconds(20);
+    owner_state.upsert_thread(&metadata).await?;
+    timeout(READ_TIMEOUT, async {
+        loop {
+            let listed = super::catalog_sources::list(&mut reader).await?;
+            if listed.data.len() == 1 && listed.data[0].name.as_deref() == Some("Owner saved name")
+            {
+                break Ok::<_, anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(250)).await;
+        }
+    })
+    .await??;
+    assert_eq!(fs::read(&path)?, original);
+    let request = reader
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert!(loaded.data.is_empty());
+    for home in [owner.path(), mirror.path(), second.path()] {
+        assert!(!home.join("managed-source.json").exists());
+        assert!(!home.join("auth.json").exists());
+    }
+    owner_state.close().await;
+    mirror_state.close().await;
+    second_state.close().await;
+    Ok(())
+}
