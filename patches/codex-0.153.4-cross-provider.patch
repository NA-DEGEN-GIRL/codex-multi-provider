+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+const PRESET: &str = "11111111-1111-4111-8111-111111111111";
+const OWNER: &str = "22222222-2222-4222-8222-222222222222";
+
+fn selection() -> ExecutionPresetSelection {
+    ExecutionPresetSelection {
+        id: PRESET.to_string(),
+        revision: 1,
+    }
+}
+
+fn registry() -> serde_json::Value {
+    json!({"schema_version":1,"profile_id":OWNER,"presets":[{"id":PRESET,"revision":1,"role_ids":["prepared_worker"]}],
+        "roles":{"prepared_worker":{"model_provider":"openai","model":"gpt-5.5","effort":"high"}},
+        "default_preset":null,"task_bindings":{}})
+}
+
+fn prepare(config: &mut Config, path: PathBuf) {
+    config.agent_roles.insert(
+        "prepared_worker".to_string(),
+        AgentRoleConfig {
+            model_provider: Some("openai".to_string()),
+            ..Default::default()
+        },
+    );
+    config
+        .load_execution_presets(path)
+        .expect("load prepared union");
+}
+
+#[tokio::test]
+async fn preset_filters_roles_and_restores_legacy_without_mutating_captured_config() {
+    let temp = tempfile::tempdir().expect("fixture");
+    let path = temp.path().join("registry.json");
+    std::fs::write(&path, registry().to_string()).expect("registry");
+    let mut config = super::super::test_config().await;
+    let legacy = config.agent_roles.clone();
+    prepare(&mut config, path.clone());
+    assert_eq!(config.agent_roles, legacy);
+    config
+        .select_execution_preset(Some(selection()))
+        .expect("select");
+    let captured = config.clone();
+    assert_eq!(
+        config.agent_roles.keys().cloned().collect::<Vec<_>>(),
+        vec!["prepared_worker"]
+    );
+    assert!(!config.execution_preset_allows_role("worker"));
+    config.model = Some("gpt-5.5".to_string());
+    config.model_reasoning_effort = Some(ReasoningEffort::High);
+    assert!(
+        config
+            .execution_preset_role(Some("prepared_worker"))
+            .is_ok()
+    );
+    config.model = Some("unapproved-model".to_string());
+    assert!(
+        config
+            .execution_preset_role(Some("prepared_worker"))
+            .is_err()
+    );
+    config.select_execution_preset(None).expect("clear");
+    assert_eq!(config.agent_roles, legacy);
+    assert_eq!(captured.execution_preset_selection(), Some(selection()));
+    let mut changed = registry();
+    changed["roles"]["prepared_worker"]["model"] = json!("changed-after-prepare");
+    std::fs::write(path, changed.to_string()).expect("rewrite");
+    assert!(
+        config
+            .select_execution_preset(Some(selection()))
+            .expect_err("reject drift")
+            .to_string()
+            .contains("prepare/reload")
+    );
+    assert_eq!(config.execution_preset_selection(), None);
+}
+
+#[tokio::test]
+async fn session_update_changes_next_turn_policy_and_keeps_captured_turn_policy() {
+    let temp = tempfile::tempdir().expect("fixture");
+    let path = temp.path().join("registry.json");
+    std::fs::write(&path, registry().to_string()).expect("registry");
+    let (session, turn, _events) =
+        crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+            Vec::new(),
+            |config| prepare(config, path),
+        )
+        .await;
+    session
+        .update_settings(crate::session::session::SessionSettingsUpdate {
+            execution_preset: Some(Some(selection())),
+            ..Default::default()
+        })
+        .await
+        .expect("apply desired preset");
+    assert_eq!(turn.config.execution_preset_selection(), None);
+    assert_eq!(
+        session.get_config().await.execution_preset_selection(),
+        Some(selection())
+    );
+    assert_eq!(
+        session.thread_settings_snapshot().await.execution_preset,
+        Some(selection())
+    );
+    session
+        .update_settings(crate::session::session::SessionSettingsUpdate {
+            execution_preset: Some(None),
+            ..Default::default()
+        })
+        .await
+        .expect("clear desired preset");
+    assert_eq!(
+        session.get_config().await.execution_preset_selection(),
+        None
+    );
+}
+
+#[tokio::test]
+async fn unprepared_preset_cannot_create_authority_from_a_request() {
+    let mut config = super::super::test_config().await;
+    assert!(
+        config
+            .select_execution_preset(Some(selection()))
+            .expect_err("no registry")
+            .to_string()
+            .contains("prepare/reload")
+    );
+    assert!(config.select_execution_preset(None).is_ok());
+}
+
+#[tokio::test]
+async fn cold_resume_explicit_binding_clear_overrides_persisted_selection_and_default() {
+    let temp = tempfile::tempdir().expect("fixture");
+    let path = temp.path().join("registry.json");
+    std::fs::write(&path, registry().to_string()).expect("registry");
+    let (session, _turn, _events) =
+        crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+            Vec::new(),
+            |config| prepare(config, path.clone()),
+        )
+        .await;
+    session
+        .update_settings(crate::session::session::SessionSettingsUpdate {
+            execution_preset: Some(Some(selection())),
+            ..Default::default()
+        })
+        .await
+        .expect("select");
+    let thread_id = session.thread_id();
+    let history = codex_history::InitialHistory::Resumed(codex_history::ResumedHistory {
+        conversation_id: thread_id,
+        history: Arc::new(vec![codex_history::RolloutItem::EventMsg(
+            codex_protocol::protocol::EventMsg::ThreadSettingsApplied(
+                codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                    thread_id: Some(thread_id),
+                    thread_settings: session.thread_settings_snapshot().await,
+                },
+            ),
+        )]),
+        rollout_path: None,
+    });
+    let mut fresh = super::super::test_config().await;
+    prepare(&mut fresh, path.clone());
+    fresh
+        .restore_execution_preset(&history)
+        .expect("durable selection");
+    assert_eq!(fresh.execution_preset_selection(), Some(selection()));
+    let mut manifest = registry();
+    manifest["default_preset"] = json!({"id":PRESET,"revision":1});
+    manifest["task_bindings"][thread_id.to_string()] = serde_json::Value::Null;
+    std::fs::write(path, manifest.to_string()).expect("explicit clear");
+    fresh
+        .restore_execution_preset(&history)
+        .expect("binding wins");
+    assert_eq!(fresh.execution_preset_selection(), None);
+    fresh
+        .select_execution_preset(Some(selection()))
+        .expect("select for child");
+    fresh.mark_execution_preset_child();
+    assert_eq!(
+        fresh.multi_agent_version_override(),
+        Some(codex_protocol::protocol::MultiAgentVersion::V2)
+    );
+    assert_eq!(
+        fresh.multi_agent_version_for_model(None),
+        codex_protocol::protocol::MultiAgentVersion::Disabled
+    );
+}
