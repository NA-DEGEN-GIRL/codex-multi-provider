diff --git a/codex-rs/core/src/tasks/claude_code/images.rs b/codex-rs/core/src/tasks/claude_code/images.rs
new file mode 100644
index 000000000..06e2d8f2e
--- /dev/null
+++ b/codex-rs/core/src/tasks/claude_code/images.rs
@@ -0,0 +1,306 @@
+//! Lossless local image references for the official CLI's Read tool.
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::io::Cursor;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use base64::Engine;
+use base64::engine::general_purpose::STANDARD;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::Result;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_rollout::ModelTranscript;
+use image::ImageFormat;
+use sha1::Digest;
+use sha1::Sha1;
+
+use super::bridge::failure;
+
+const MAX_IMAGE_BYTES: usize = 8 * 1024 * 1024;
+const MAX_TURN_BYTES: usize = 64 * 1024 * 1024;
+
+/// A private, per-handoff placeholder map. Selection can discard old images
+/// without decoding or writing them. No placeholder is sent to the CLI.
+pub(super) struct StagedImages {
+    prefix: String,
+    entries: HashMap<String, Option<String>>,
+}
+
+impl StagedImages {
+    pub(super) fn new(transcript: &mut ModelTranscript) -> Self {
+        let prefix = format!("[stored-attachment-{}-", uuid::Uuid::new_v4());
+        let mut entries = HashMap::new();
+        let mut stage = |url: Option<String>| {
+            let marker = format!("{prefix}{}]", entries.len());
+            entries.insert(marker.clone(), url);
+            marker
+        };
+        for item in &mut transcript.items {
+            match &mut item.item.item {
+                ResponseItem::Message { content, .. } => {
+                    for part in content {
+                        let marker = match part {
+                            ContentItem::InputImage { image_url, .. } => {
+                                Some(stage(Some(std::mem::take(image_url))))
+                            }
+                            ContentItem::InputAudio { .. } => Some(stage(None)),
+                            _ => None,
+                        };
+                        if let Some(text) = marker {
+                            *part = ContentItem::InputText { text };
+                        }
+                    }
+                }
+                ResponseItem::FunctionCallOutput { output, .. }
+                | ResponseItem::CustomToolCallOutput { output, .. } => {
+                    for part in output.content_items_mut().into_iter().flatten() {
+                        if let FunctionCallOutputContentItem::InputImage { image_url, .. } = part {
+                            let text = stage(Some(std::mem::take(image_url)));
+                            *part = FunctionCallOutputContentItem::InputText { text };
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        Self { prefix, entries }
+    }
+
+    pub(super) fn resolve(
+        self,
+        items: &mut [ResponseItemEnvelope],
+        images: &mut Images<'_>,
+    ) -> Result<()> {
+        let mut resolved = HashMap::new();
+        let mut replace = |text: &mut String| -> Result<()> {
+            while let Some(start) = text.find(&self.prefix) {
+                let end = text[start..]
+                    .find(']')
+                    .map(|end| start + end + 1)
+                    .ok_or_else(|| {
+                        failure("an image reference was truncated while rebuilding history")
+                    })?;
+                let marker = text[start..end].to_string();
+                let url = self.entries.get(&marker).ok_or_else(|| {
+                    failure("an image reference changed while rebuilding history")
+                })?;
+                let replacement = match resolved.entry(marker) {
+                    std::collections::hash_map::Entry::Occupied(entry) => entry.into_mut(),
+                    std::collections::hash_map::Entry::Vacant(entry) => {
+                        let url = url.as_deref().ok_or_else(|| {
+                            failure("audio attachments are not supported by this agent")
+                        })?;
+                        entry.insert(images.reference(url)?)
+                    }
+                };
+                text.replace_range(start..end, replacement);
+            }
+            Ok(())
+        };
+        for item in items {
+            match &mut item.item {
+                ResponseItem::Message { content, .. } => {
+                    for part in content {
+                        if let ContentItem::InputText { text } | ContentItem::OutputText { text } =
+                            part
+                        {
+                            replace(text)?;
+                        }
+                    }
+                }
+                ResponseItem::FunctionCallOutput { output, .. }
+                | ResponseItem::CustomToolCallOutput { output, .. } => {
+                    // The context builder may flatten a content array into text.
+                    // Round-trip its public JSON shape so both representations
+                    // retain selected attachment references.
+                    let mut value =
+                        serde_json::to_string(output).map_err(|err| failure(err.to_string()))?;
+                    // JSON escaping must occur after resolving text, not inside
+                    // an encoded string (Windows paths contain backslashes).
+                    if !value.contains(&self.prefix) {
+                        continue;
+                    }
+                    let mut json: serde_json::Value =
+                        serde_json::from_str(&value).map_err(|err| failure(err.to_string()))?;
+                    fn texts(
+                        value: &mut serde_json::Value,
+                        replace: &mut impl FnMut(&mut String) -> Result<()>,
+                    ) -> Result<()> {
+                        match value {
+                            serde_json::Value::String(text) => replace(text)?,
+                            serde_json::Value::Array(values) => {
+                                for value in values {
+                                    texts(value, replace)?;
+                                }
+                            }
+                            serde_json::Value::Object(values) => {
+                                for value in values.values_mut() {
+                                    texts(value, replace)?;
+                                }
+                            }
+                            _ => {}
+                        }
+                        Ok(())
+                    }
+                    texts(&mut json, &mut replace)?;
+                    value = serde_json::to_string(&json).map_err(|err| failure(err.to_string()))?;
+                    *output =
+                        serde_json::from_str(&value).map_err(|err| failure(err.to_string()))?;
+                }
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+}
+
+pub(super) struct Images<'a> {
+    home: &'a Path,
+    bytes: usize,
+    seen: HashSet<String>,
+}
+
+impl<'a> Images<'a> {
+    pub(super) fn new(home: &'a Path) -> Self {
+        Self {
+            home,
+            bytes: 0,
+            seen: HashSet::new(),
+        }
+    }
+
+    pub(super) fn reference(&mut self, url: &str) -> Result<String> {
+        let (header, encoded) = url.split_once(',').ok_or_else(|| failure("only stored inline PNG/JPEG images can be handed to Claude; remote URLs and missing local images are unsupported"))?;
+        let mime = header
+            .strip_prefix("data:")
+            .and_then(|header| header.strip_suffix(";base64"))
+            .ok_or_else(|| failure("image attachment must contain inline base64 data"))?;
+        if !matches!(
+            mime,
+            "image/png" | "image/jpeg" | "application/octet-stream"
+        ) {
+            return Err(failure(
+                "only PNG/JPEG image attachments are currently supported",
+            ));
+        }
+        if encoded.len() > MAX_IMAGE_BYTES.div_ceil(3) * 4 {
+            return Err(failure("image exceeds the 8 MiB local handoff limit"));
+        }
+        let bytes = STANDARD
+            .decode(encoded)
+            .map_err(|_| failure("image attachment has invalid base64 data"))?;
+        if bytes.len() > MAX_IMAGE_BYTES {
+            return Err(failure("image exceeds the 8 MiB local handoff limit"));
+        }
+        let format = image::guess_format(&bytes)
+            .map_err(|_| failure("image attachment has an unrecognized format"))?;
+        let (extension, canonical_mime) = match format {
+            ImageFormat::Png => ("png", "image/png"),
+            ImageFormat::Jpeg => ("jpg", "image/jpeg"),
+            _ => {
+                return Err(failure(
+                    "only PNG/JPEG image attachments are currently supported",
+                ));
+            }
+        };
+        if mime != "application/octet-stream" && mime != canonical_mime {
+            return Err(failure("image MIME type does not match its stored bytes"));
+        }
+        let mut reader = image::ImageReader::with_format(Cursor::new(&bytes), format);
+        let mut limits = image::Limits::default();
+        limits.max_alloc = Some(64 * 1024 * 1024);
+        reader.limits(limits);
+        let decoded = reader.decode().map_err(|_| {
+            failure("image attachment is malformed or exceeds the 64 MiB decoded image limit")
+        })?;
+        let (width, height) = (decoded.width(), decoded.height());
+        drop(decoded);
+        let hash = format!("{:x}", Sha1::digest(&bytes));
+        if self.seen.insert(hash.clone()) {
+            self.bytes = self.bytes.saturating_add(bytes.len());
+            if self.bytes > MAX_TURN_BYTES {
+                return Err(failure(
+                    "image attachments exceed the 64 MiB turn handoff limit",
+                ));
+            }
+        }
+        let path = store(self.home, &format!("{hash}.{extension}"), &bytes)?;
+        let path_text = serde_json::to_string(&path).map_err(|error| failure(error.to_string()))?;
+        Ok(format!(
+            "[Image attachment ({canonical_mime}, {width}x{height}): exact stored bytes at {path_text}. This image has not been inspected by Claude. Use the Read tool on this path when relevant.]"
+        ))
+    }
+}
+
+fn store(home: &Path, name: &str, bytes: &[u8]) -> Result<PathBuf> {
+    let root = std::fs::canonicalize(home)
+        .map_err(|error| failure(format!("cannot resolve image storage root: {error}")))?;
+    let directory = root.join("claude-image-handoff");
+    match std::fs::create_dir(&directory) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(error) => return Err(failure(format!("cannot create image storage: {error}"))),
+    }
+    let metadata =
+        std::fs::symlink_metadata(&directory).map_err(|error| failure(error.to_string()))?;
+    if !metadata.is_dir()
+        || is_link(&metadata)
+        || std::fs::canonicalize(&directory).ok().as_ref() != Some(&directory)
+    {
+        return Err(failure(
+            "image storage must be a real directory within Codex home",
+        ));
+    }
+    let path = directory.join(name);
+    if !path
+        .try_exists()
+        .map_err(|error| failure(error.to_string()))?
+    {
+        // Publishing with no clobber also handles two shared profiles extracting the same image.
+        let mut temporary = tempfile::NamedTempFile::new_in(&directory)
+            .map_err(|error| failure(error.to_string()))?;
+        temporary
+            .write_all(bytes)
+            .map_err(|error| failure(error.to_string()))?;
+        if let Err(error) = temporary.persist_noclobber(&path)
+            && error.error.kind() != std::io::ErrorKind::AlreadyExists
+        {
+            return Err(failure(format!(
+                "cannot publish image attachment: {}",
+                error.error
+            )));
+        }
+    }
+    let metadata = std::fs::symlink_metadata(&path).map_err(|error| failure(error.to_string()))?;
+    if !metadata.is_file()
+        || is_link(&metadata)
+        || metadata.len() != bytes.len() as u64
+        || std::fs::canonicalize(&path).ok().as_ref() != Some(&path)
+        || std::fs::read(&path).map_err(|error| failure(error.to_string()))? != bytes
+    {
+        return Err(failure(
+            "image storage contains an unsafe link or mismatched content",
+        ));
+    }
+    Ok(path)
+}
+
+fn is_link(metadata: &std::fs::Metadata) -> bool {
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::MetadataExt;
+        metadata.file_attributes() & 0x400 != 0
+    }
+    #[cfg(not(windows))]
+    {
+        metadata.file_type().is_symlink()
+    }
+}
