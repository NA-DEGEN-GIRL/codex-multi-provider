+use super::*;
+use crate::CreateThreadParams;
+use crate::LiveThread;
+use crate::LoadThreadHistoryParams;
+use crate::PersistContext;
+use crate::ReadThreadParams;
+use crate::ResumeThreadParams;
+use crate::ThreadMetadataPatch;
+use crate::ThreadPersistenceMetadata;
+use crate::ThreadStore;
+use crate::UpdateThreadMetadataParams;
+use codex_protocol::models::BaseInstructions;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_protocol::protocol::ThreadMemoryMode;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+
+fn registration(home: &std::path::Path, id: &ManagedSourceId) -> ManagedSourceRegistration {
+    ManagedSourceRegistration {
+        source_id: id.clone(),
+        config: LocalThreadStoreConfig {
+            codex_home: home.to_path_buf(),
+            sqlite: codex_state::SqliteConfig::new_for_testing(
+                AbsolutePathBuf::try_from(home.to_path_buf()).expect("absolute home"),
+            ),
+            default_model_provider_id: "test-provider".to_string(),
+        },
+    }
+}
+
+fn source_id() -> ManagedSourceId {
+    ManagedSourceId {
+        host_id: "local".to_string(),
+        store_id: format!("manager:{}", ThreadId::new()),
+    }
+}
+
+fn profile_id(source: &ManagedSourceId) -> String {
+    source
+        .store_id
+        .strip_prefix("manager:")
+        .expect("manager store")
+        .to_string()
+}
+
+fn advance_owner(
+    home: &std::path::Path,
+    source: &ManagedSourceId,
+    thread_id: ThreadId,
+    grant: &ManagedAuthorityGrant,
+) {
+    let record = serde_json::json!({
+        "version": 1, "host_id": source.host_id, "store_id": source.store_id,
+        "thread_id": thread_id, "owner_profile_id": grant.owner_profile_id,
+        "epoch": grant.epoch, "revision": grant.revision,
+    });
+    let path = home
+        .join("managed-authority")
+        .join(format!("{thread_id}.json"));
+    let cas_guard = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(path.with_extension("guard"))
+        .expect("CAS guard");
+    cas_guard
+        .try_lock()
+        .expect("no outstanding canonical writes");
+    let temporary = path.with_extension("tmp");
+    std::fs::write(&temporary, serde_json::to_vec(&record).expect("authority")).expect("temporary");
+    std::fs::rename(temporary, path).expect("atomic authority replacement");
+}
+
+#[tokio::test]
+async fn absent_foreign_or_stale_grants_do_not_initialize_a_source_database() {
+    let home = TempDir::new().expect("home");
+    let id = source_id();
+    std::fs::write(
+        home.path().join("managed-source.json"),
+        serde_json::to_vec(&id).expect("marker"),
+    )
+    .expect("write marker");
+    let owner = profile_id(&id);
+    let registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        owner.clone(),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("registry");
+    let thread_id = ThreadId::new();
+    let old = ManagedAuthorityGrant {
+        owner_profile_id: owner,
+        epoch: 1,
+        revision: 1,
+    };
+    assert!(registry.bind(&id, thread_id, old.clone()).await.is_err());
+    assert_eq!(std::fs::read_dir(home.path()).expect("entries").count(), 1);
+    let authority =
+        ManagedAuthority::from_grant(home.path(), &id, thread_id, &old).expect("authority");
+    authority.create_new().expect("initial grant");
+    let newer = ManagedAuthorityGrant {
+        epoch: 3,
+        revision: 3,
+        ..old.clone()
+    };
+    advance_owner(home.path(), &id, thread_id, &newer);
+    assert!(registry.bind(&id, thread_id, old).await.is_err());
+    let foreign = ManagedSourceRegistry::new(
+        "local".to_string(),
+        ThreadId::new().to_string(),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("foreign registry");
+    assert!(foreign.bind(&id, thread_id, newer).await.is_err());
+    assert!(foreign.bind_new(&id, ThreadId::new()).await.is_err());
+    let mut entries = std::fs::read_dir(home.path())
+        .expect("source entries")
+        .map(|entry| {
+            entry
+                .expect("entry")
+                .file_name()
+                .to_string_lossy()
+                .to_string()
+        })
+        .collect::<Vec<_>>();
+    entries.sort();
+    assert_eq!(
+        entries,
+        vec![
+            "managed-authority".to_string(),
+            "managed-source.json".to_string()
+        ]
+    );
+}
+
+#[tokio::test]
+async fn a_quiet_live_recorder_still_prevents_the_manager_transfer_lock() {
+    let home = TempDir::new().expect("home");
+    let id = source_id();
+    std::fs::write(
+        home.path().join("managed-source.json"),
+        serde_json::to_vec(&id).expect("marker"),
+    )
+    .expect("source marker");
+    let registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        profile_id(&id),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("registry");
+    let thread_id = ThreadId::new();
+    let binding = registry.bind_new(&id, thread_id).await.expect("binding");
+    let live = LiveThread::create(binding.store(), create_params(home.path(), thread_id))
+        .await
+        .expect("writer");
+    live.persist(PersistContext::Standard)
+        .await
+        .expect("persisted writer");
+    let authority_guard = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(
+            home.path()
+                .join("managed-authority")
+                .join(format!("{thread_id}.guard")),
+        )
+        .expect("authority guard");
+    assert!(matches!(
+        authority_guard.try_lock(),
+        Err(std::fs::TryLockError::WouldBlock)
+    ));
+    let coordination = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(
+            home.path()
+                .join("thread-writer-locks")
+                .join(".coordination.lock"),
+        )
+        .expect("coordination");
+    coordination
+        .try_lock()
+        .expect("coordinate recorder inspection");
+    let recorder = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(
+            home.path()
+                .join("thread-writer-locks")
+                .join(format!("{thread_id}.lock")),
+        )
+        .expect("recorder lock");
+    assert!(matches!(
+        recorder.try_lock(),
+        Err(std::fs::TryLockError::WouldBlock)
+    ));
+    drop(recorder);
+    drop(coordination);
+    live.shutdown().await.expect("writer released");
+    authority_guard
+        .try_lock()
+        .expect("authority fence released after checked shutdown");
+    drop(authority_guard);
+    registry
+        .bind(&id, thread_id, binding.authority_grant().clone())
+        .await
+        .expect("fresh idle binding")
+        .verify_writer_absent()
+        .await
+        .expect("recorder fence released after checked shutdown");
+}
+
+#[tokio::test]
+async fn only_a_live_parent_can_create_child_authority_in_its_transferred_source() {
+    let home = TempDir::new().expect("home");
+    let id = source_id();
+    std::fs::write(
+        home.path().join("managed-source.json"),
+        serde_json::to_vec(&id).expect("marker"),
+    )
+    .expect("write marker");
+    let original = ManagedSourceRegistry::new(
+        "local".to_string(),
+        profile_id(&id),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("original registry");
+    let root = ThreadId::new();
+    let original_binding = original.bind_new(&id, root).await.expect("original root");
+    let original_live =
+        LiveThread::create(original_binding.store(), create_params(home.path(), root))
+            .await
+            .expect("root writer");
+    original_live
+        .persist(PersistContext::Standard)
+        .await
+        .expect("root persisted");
+    original_live.shutdown().await.expect("strict release");
+    let grant = ManagedAuthorityGrant {
+        owner_profile_id: ThreadId::new().to_string(),
+        epoch: 2,
+        revision: 2,
+    };
+    advance_owner(home.path(), &id, root, &grant);
+    let target = ManagedSourceRegistry::new(
+        "local".to_string(),
+        grant.owner_profile_id.clone(),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("target registry");
+    let binding = target
+        .bind(&id, root, grant.clone())
+        .await
+        .expect("target binding");
+    let dormant_child = ThreadId::new();
+    assert!(binding.for_new_child(dormant_child).await.is_err());
+    assert!(
+        !home
+            .path()
+            .join("managed-authority")
+            .join(format!("{dormant_child}.json"))
+            .exists()
+    );
+    let live = resume_binding(&binding, home.path()).await;
+    let child_id = ThreadId::new();
+    let child = binding
+        .for_new_child(child_id)
+        .await
+        .expect("new child grant");
+    assert_eq!(
+        child.authority_grant(),
+        &ManagedAuthorityGrant {
+            owner_profile_id: grant.owner_profile_id,
+            epoch: 1,
+            revision: 1,
+        }
+    );
+    binding
+        .for_child(child_id)
+        .await
+        .expect("existing child resumes its grant");
+    assert!(binding.for_child(ThreadId::new()).await.is_err());
+    live.shutdown().await.expect("target release");
+    assert!(binding.for_new_child(ThreadId::new()).await.is_err());
+    assert!(binding.for_child(child_id).await.is_err());
+}
+
+fn metadata(home: &std::path::Path) -> ThreadPersistenceMetadata {
+    ThreadPersistenceMetadata {
+        cwd: Some(home.to_path_buf()),
+        model_provider: "test-provider".to_string(),
+        memory_mode: ThreadMemoryMode::Disabled,
+    }
+}
+
+async fn resume_binding(binding: &ManagedThreadBinding, home: &std::path::Path) -> LiveThread {
+    let reservation = binding
+        .prepare_writer()
+        .await
+        .expect("reserve source writer");
+    let context = binding
+        .store()
+        .load_latest_model_context(LoadThreadHistoryParams {
+            thread_id: binding.thread_id(),
+            include_archived: true,
+        })
+        .await
+        .expect("canonical model context under writer reservation");
+    let live = LiveThread::resume(
+        binding.store(),
+        ThreadHistoryMode::Paginated,
+        ResumeThreadParams {
+            thread_id: binding.thread_id(),
+            rollout_path: None,
+            history: Some(Arc::new(context.items)),
+            include_archived: true,
+            metadata: metadata(home),
+        },
+    )
+    .await
+    .expect("canonical writer");
+    drop(reservation);
+    live
+}
+
+fn create_params(home: &std::path::Path, thread_id: ThreadId) -> CreateThreadParams {
+    CreateThreadParams {
+        session_id: thread_id.into(),
+        thread_id,
+        extra_config: None,
+        forked_from_id: None,
+        parent_thread_id: None,
+        source: SessionSource::Exec,
+        thread_source: None,
+        originator: "test".to_string(),
+        base_instructions: BaseInstructions::default(),
+        dynamic_tools: Vec::new(),
+        selected_capability_roots: Vec::new(),
+        multi_agent_version: None,
+        history_mode: ThreadHistoryMode::Paginated,
+        history_base: None,
+        subagent_history_start_ordinal: None,
+        initial_window_id: "test-window".to_string(),
+        metadata: metadata(home),
+    }
+}
+
+#[tokio::test]
+async fn unmarked_original_is_rejected_without_initializing_databases() {
+    let home = TempDir::new().expect("home");
+    assert!(
+        ManagedSourceRegistry::new(
+            "local".to_string(),
+            ThreadId::new().to_string(),
+            vec![registration(home.path(), &source_id())],
+        )
+        .is_err()
+    );
+    assert_eq!(
+        std::fs::read_dir(home.path())
+            .expect("home entries")
+            .count(),
+        0
+    );
+}
+
+#[tokio::test]
+async fn source_identity_is_rechecked_before_initialization_and_rebinding() {
+    let home = TempDir::new().expect("home");
+    let id = source_id();
+    let marker = home.path().join("managed-source.json");
+    std::fs::write(&marker, serde_json::to_vec(&id).expect("marker")).expect("write marker");
+    let registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        profile_id(&id),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("registry");
+    std::fs::write(&marker, serde_json::to_vec(&source_id()).expect("marker"))
+        .expect("replace marker");
+    assert!(registry.bind_new(&id, ThreadId::new()).await.is_err());
+    assert_eq!(
+        std::fs::read_dir(home.path())
+            .expect("home entries")
+            .count(),
+        1
+    );
+}
+
+#[tokio::test]
+async fn independent_profiles_resume_one_canonical_record_and_fence_old_callbacks() {
+    let home = TempDir::new().expect("home");
+    let id = source_id();
+    std::fs::write(
+        home.path().join("managed-source.json"),
+        serde_json::to_vec(&id).expect("marker"),
+    )
+    .expect("write marker");
+    let first_registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        profile_id(&id),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("first registry");
+    let second_profile = ThreadId::new().to_string();
+    let second_registry = ManagedSourceRegistry::new(
+        "local".to_string(),
+        second_profile.clone(),
+        vec![registration(home.path(), &id)],
+    )
+    .expect("second registry");
+    let thread_id = ThreadId::new();
+    let first = first_registry
+        .bind_new(&id, thread_id)
+        .await
+        .expect("first binding");
+    let first_live = LiveThread::create(first.store(), create_params(home.path(), thread_id))
+        .await
+        .expect("first owner");
+    first_live
+        .persist(PersistContext::Standard)
+        .await
+        .expect("persist canonical record");
+    first_live
+        .update_metadata(
+            ThreadMetadataPatch {
+                name: Some(Some("canonical task".to_string())),
+                ..Default::default()
+            },
+            /*include_archived*/ true,
+        )
+        .await
+        .expect("canonical name");
+    let original_path = first_live.local_rollout_path().await.expect("rollout path");
+    let second_grant = ManagedAuthorityGrant {
+        owner_profile_id: second_profile,
+        epoch: 2,
+        revision: 2,
+    };
+    assert!(
+        second_registry
+            .bind(&id, thread_id, second_grant.clone())
+            .await
+            .is_err()
+    );
+    let resume = || ResumeThreadParams {
+        thread_id,
+        rollout_path: None,
+        history: None,
+        include_archived: true,
+        metadata: metadata(home.path()),
+    };
+    let other_id = ThreadId::new();
+    let other = first_registry
+        .bind_new(&id, other_id)
+        .await
+        .expect("unrelated binding");
+    let other_live = LiveThread::create(other.store(), create_params(home.path(), other_id))
+        .await
+        .expect("unrelated writer");
+    other_live
+        .persist(PersistContext::Standard)
+        .await
+        .expect("unrelated persists");
+    first_live.shutdown().await.expect("release first writer");
+    advance_owner(home.path(), &id, thread_id, &second_grant);
+    let second = second_registry
+        .bind(&id, thread_id, second_grant)
+        .await
+        .expect("second binding");
+    assert!(
+        first_registry
+            .bind(&id, thread_id, first.authority_grant().clone())
+            .await
+            .is_err()
+    );
+    let second_live = resume_binding(&second, home.path()).await;
+    second_live
+        .update_metadata(
+            ThreadMetadataPatch {
+                name: Some(Some("continued task".to_string())),
+                ..Default::default()
+            },
+            /*include_archived*/ true,
+        )
+        .await
+        .expect("source metadata updated");
+    assert_eq!(
+        second_live.local_rollout_path().await.expect("same path"),
+        original_path
+    );
+    assert!(matches!(
+        first.write_permit().await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(matches!(
+        first
+            .store()
+            .update_thread_metadata(UpdateThreadMetadataParams {
+                thread_id,
+                patch: ThreadMetadataPatch {
+                    name: Some(Some("stale callback".to_string())),
+                    ..Default::default()
+                },
+                include_archived: true,
+            })
+            .await,
+        Err(ThreadStoreError::Conflict { .. }),
+    ));
+    assert!(matches!(
+        first.store().resume_thread(resume()).await,
+        Err(ThreadStoreError::Conflict { .. }),
+    ));
+    let stored = first
+        .store()
+        .read_thread(ReadThreadParams {
+            thread_id,
+            include_archived: true,
+            include_history: false,
+        })
+        .await
+        .expect("canonical read after handoff");
+    assert_eq!(
+        (stored.thread_id, stored.name),
+        (thread_id, Some("continued task".to_string()))
+    );
+    other_live
+        .flush()
+        .await
+        .expect("unrelated writer continues");
+    second_live.shutdown().await.expect("second release");
+    let returning_grant = ManagedAuthorityGrant {
+        owner_profile_id: profile_id(&id),
+        epoch: 3,
+        revision: 3,
+    };
+    advance_owner(home.path(), &id, thread_id, &returning_grant);
+    let returning = first_registry
+        .bind(&id, thread_id, returning_grant)
+        .await
+        .expect("fresh returning grant");
+    assert!(
+        first_registry
+            .bind(&id, thread_id, first.authority_grant().clone())
+            .await
+            .is_err()
+    );
+    assert!(
+        second_registry
+            .bind(&id, thread_id, second.authority_grant().clone())
+            .await
+            .is_err()
+    );
+    let returned_live = resume_binding(&returning, home.path()).await;
+    returned_live.shutdown().await.expect("returning release");
+    other_live.shutdown().await.expect("unrelated release");
+}
