--- /dev/null
+++ b/codex-rs/app-server/src/otel_reloader_tests.rs
@@ -0,0 +1,95 @@
+use super::shutdown_provider;
+use codex_otel::OtelExporter;
+use codex_otel::OtelHttpProtocol;
+use codex_otel::OtelProvider;
+use codex_otel::OtelSettings;
+use opentelemetry::Context;
+use opentelemetry_sdk::error::OTelSdkResult;
+use opentelemetry_sdk::trace::SdkTracerProvider;
+use opentelemetry_sdk::trace::Span;
+use opentelemetry_sdk::trace::SpanData;
+use opentelemetry_sdk::trace::SpanProcessor;
+use std::sync::Arc;
+use std::sync::Condvar;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+#[derive(Debug, Default)]
+struct ShutdownState {
+    started: AtomicBool,
+    released: Mutex<bool>,
+    changed: Condvar,
+}
+
+#[derive(Debug)]
+struct BlockingShutdown(Arc<ShutdownState>);
+
+impl SpanProcessor for BlockingShutdown {
+    fn on_start(&self, _span: &mut Span, _context: &Context) {}
+    fn on_end(&self, _span: SpanData) {}
+    fn force_flush(&self) -> OTelSdkResult {
+        Ok(())
+    }
+    fn shutdown_with_timeout(&self, _timeout: Duration) -> OTelSdkResult {
+        self.0.started.store(true, Ordering::SeqCst);
+        drop(
+            self.0
+                .changed
+                .wait_while(self.0.released.lock().expect("release lock"), |value| {
+                    !*value
+                })
+                .expect("release notification"),
+        );
+        Ok(())
+    }
+}
+
+struct ReleaseOnDrop(Arc<ShutdownState>);
+
+impl Drop for ReleaseOnDrop {
+    fn drop(&mut self) {
+        *self.0.released.lock().expect("release lock") = true;
+        self.0.changed.notify_all();
+    }
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn blocked_exporter_does_not_hold_app_server_shutdown_open() {
+    // No spans are emitted and the trace processor is replaced before use;
+    // this initializes the real provider's prepared shutdown worker only.
+    let mut provider = OtelProvider::try_new(&OtelSettings {
+        environment: "test".into(),
+        service_name: "app-server-shutdown-test".into(),
+        service_version: "test".into(),
+        codex_home: std::env::temp_dir(),
+        exporter: OtelExporter::None,
+        trace_exporter: OtelExporter::OtlpHttp {
+            endpoint: "http://127.0.0.1:9".into(),
+            headers: Default::default(),
+            protocol: OtelHttpProtocol::Json,
+            tls: None,
+        },
+        metrics_exporter: OtelExporter::None,
+        runtime_metrics: false,
+        span_attributes: Default::default(),
+        tracestate: Default::default(),
+    })
+    .expect("create test provider")
+    .expect("enabled test provider");
+    let state = Arc::new(ShutdownState::default());
+    let _release = ReleaseOnDrop(Arc::clone(&state));
+    provider.tracer = None;
+    provider.tracer_provider = Some(
+        SdkTracerProvider::builder()
+            .with_span_processor(BlockingShutdown(Arc::clone(&state)))
+            .build(),
+    );
+
+    tokio::time::timeout(Duration::from_secs(3), shutdown_provider(provider))
+        .await
+        .expect("telemetry shutdown must finish despite a stuck exporter");
+    assert!(state.started.load(Ordering::SeqCst));
+    assert!(!*state.released.lock().expect("release lock"));
+}
