+//! Profile-local maintenance of the standalone server. No forced interrupts.
+
+use super::MessageProcessor;
+use crate::error_code::internal_error;
+use crate::error_code::invalid_request;
+use crate::managed_instance_activity::ManagedMaintenanceGuard;
+use crate::outgoing_message::ConnectionRequestId;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ServerManagedShutdownParams;
+use codex_app_server_protocol::ServerManagedShutdownResponse;
+use codex_app_server_protocol::ThreadManagedCloseIdleParams;
+use codex_app_server_protocol::ThreadManagedIdleStatusParams;
+use codex_protocol::ThreadId;
+use std::collections::HashSet;
+use std::time::Duration;
+
+const MAX_LOADED_THREADS: usize = 1024;
+const MAINTENANCE_TIMEOUT: Duration = Duration::from_secs(60);
+
+impl MessageProcessor {
+    pub(super) async fn managed_shutdown(
+        &self,
+        request_id: ConnectionRequestId,
+        params: ServerManagedShutdownParams,
+    ) -> Result<(), JSONRPCErrorError> {
+        if !crate::managed_sources::is_enabled() || params.process_id != std::process::id() {
+            return Err(invalid_request(
+                "managed shutdown requires the exact managed process",
+            ));
+        }
+        let shutdown =
+            self.outgoing.managed_shutdown.get().ok_or_else(|| {
+                invalid_request("managed shutdown is unavailable in this embedder")
+            })?;
+        let admission = self.outgoing.managed_activity.try_freeze(&request_id)?;
+        let closed_thread_ids = tokio::time::timeout(
+            MAINTENANCE_TIMEOUT,
+            self.close_for_managed_shutdown(&admission),
+        )
+        .await
+        .map_err(|_| internal_error("managed shutdown timed out; exit is unverified"))??;
+        let response = ServerManagedShutdownResponse {
+            process_id: std::process::id(),
+            closed_thread_ids,
+            shutdown_requested: true,
+            writer_release_verified: true,
+        };
+        let delivered = tokio::time::timeout(
+            Duration::from_secs(5),
+            self.outgoing
+                .send_response_and_wait(request_id, response.into()),
+        )
+        .await
+        .unwrap_or(false);
+        if !delivered {
+            return Err(internal_error(
+                "managed shutdown response was not delivered; exit is unverified",
+            ));
+        }
+        admission.commit();
+        shutdown.cancel();
+        Ok(())
+    }
+
+    async fn close_for_managed_shutdown(
+        &self,
+        admission: &ManagedMaintenanceGuard,
+    ) -> Result<Vec<String>, JSONRPCErrorError> {
+        if self.outgoing.pending_client_callback_count().await != 0 {
+            return Err(invalid_request("managed instance has client input pending"));
+        }
+        let manager = &self.thread_processor.thread_manager;
+        let loaded = manager.list_thread_ids().await;
+        if loaded.len() > MAX_LOADED_THREADS {
+            return Err(invalid_request(
+                "managed instance exceeds the bounded maintenance limit",
+            ));
+        }
+        let mut roots = Vec::new();
+        for id in &loaded {
+            let actor = manager
+                .get_thread(*id)
+                .await
+                .map_err(|_| invalid_request("managed actor inventory changed"))?;
+            let snapshot = actor.config_snapshot().await;
+            if !snapshot.session_source.is_non_root_agent() {
+                roots.push(*id);
+            }
+        }
+        roots.sort_by_cached_key(ToString::to_string);
+        let mut observed = HashSet::new();
+        // Observe every root before closing any: a busy peer keeps its work.
+        for id in &roots {
+            let status = self
+                .thread_processor
+                .managed_idle_status(
+                    ThreadManagedIdleStatusParams {
+                        thread_id: id.to_string(),
+                    },
+                    &self.thread_queue_processor,
+                )
+                .await?;
+            if status
+                .blockers
+                .iter()
+                .any(|blocker| blocker.kind != "coldDescendantRequiresWriterClaim")
+            {
+                return Err(invalid_request(
+                    "managed instance has active or unverified thread work",
+                ));
+            }
+            for id in status.observed_thread_ids {
+                let id = ThreadId::from_string(&id)
+                    .map_err(|_| internal_error("invalid managed subtree identity"))?;
+                if !observed.insert(id) || observed.len() > MAX_LOADED_THREADS {
+                    return Err(invalid_request(
+                        "managed subtrees overlap or exceed the maintenance limit",
+                    ));
+                }
+            }
+        }
+        if loaded.iter().any(|id| !observed.contains(id)) {
+            return Err(invalid_request(
+                "managed instance has an actor outside its root inventory",
+            ));
+        }
+        let mut closed = Vec::new();
+        for id in roots {
+            let response = self
+                .thread_processor
+                .managed_close_for_maintenance(
+                    ThreadManagedCloseIdleParams {
+                        thread_id: id.to_string(),
+                    },
+                    &self.thread_queue_processor,
+                    admission,
+                )
+                .await?;
+            if !response.writer_release_verified {
+                return Err(internal_error("managed writer release was not verified"));
+            }
+            closed.extend(response.closed_thread_ids);
+        }
+        if !manager.list_thread_ids().await.is_empty()
+            || self.outgoing.pending_client_callback_count().await != 0
+        {
+            return Err(invalid_request("managed instance did not finish draining"));
+        }
+        Ok(closed)
+    }
+}
