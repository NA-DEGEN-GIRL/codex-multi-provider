+}
+
+/// The owner's next message must see the other app's turn, the worker must be
+/// unloaded, and the worker's completion notice must reach the root's history.
+async fn assert_refreshed_without_worker(
+    fixture: &SharedTaskFixture,
+    owner: &mut TestAppServer,
+    root_id: &str,
+    worker_id: &str,
+) -> Result<()> {
+    let completed = timeout(
+        READ_TIMEOUT,
+        owner.start_turn_and_wait_for_completion(text_turn(root_id, RESUMED_PROMPT)),
+    )
+    .await??;
+    assert_eq!(
+        (completed.turn.status, completed.turn.error),
+        (TurnStatus::Completed, None)
+    );
+    let closed = timeout(
+        READ_TIMEOUT,
+        owner.read_stream_until_matching_notification("worker thread/closed", |notification| {
+            notification.method == "thread/closed"
+                && notification
+                    .params
+                    .as_ref()
+                    .is_some_and(|params| params["threadId"] == worker_id)
+        }),
+    )
+    .await??;
+    let closed: ThreadClosedNotification =
+        serde_json::from_value(closed.params.context("thread/closed params")?)?;
+    assert_eq!(
+        closed,
+        ThreadClosedNotification {
+            thread_id: worker_id.to_string()
+        }
+    );
+    assert_eq!(loaded_ids(owner).await?, vec![root_id.to_string()]);
+    let requests = fixture.request_bodies_containing(RESUMED_PROMPT).await?;
+    assert_eq!(requests.len(), 1);
+    assert!(requests[0].contains(OTHER_APP_PROMPT), "{}", requests[0]);
+
+    // A user turn samples its own input first; queued child mail is recorded
+    // when that turn ends, so the following request carries it.
+    let completed = timeout(
+        READ_TIMEOUT,
+        owner.start_turn_and_wait_for_completion(text_turn(root_id, FOLLOW_UP_PROMPT)),
+    )
+    .await??;
+    assert_eq!(
+        (completed.turn.status, completed.turn.error),
+        (TurnStatus::Completed, None)
+    );
+    let requests = fixture.request_bodies_containing(FOLLOW_UP_PROMPT).await?;
+    assert_eq!(requests.len(), 1);
+    assert!(requests[0].contains(OTHER_APP_PROMPT), "{}", requests[0]);
