@@ -0,0 +1,405 @@
+//! Managed handoff closes only an idle, explicitly bound spawn subtree.
+
+use super::ThreadQueueRequestProcessor;
+use super::ThreadRequestProcessor;
+use crate::error_code::internal_error;
+use crate::error_code::invalid_request;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ThreadClosedNotification;
+use codex_app_server_protocol::ThreadManagedCloseIdleParams;
+use codex_app_server_protocol::ThreadManagedCloseIdleResponse;
+use codex_core::CodexThread;
+use codex_core::IdleCloseAdmission;
+use codex_protocol::ThreadId;
+use codex_protocol::error::CodexErrorDetails;
+use codex_protocol::protocol::AgentStatus;
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::oneshot;
+
+const MAX_DRAIN_THREADS: usize = 128;
+const DRAIN_TIMEOUT: Duration = Duration::from_secs(60);
+
+enum ClosePurpose {
+    Transfer,
+    InstanceMaintenance,
+}
+
+enum ActorCloseError {
+    IdleRejected(JSONRPCErrorError),
+    Unverified(JSONRPCErrorError),
+}
+
+impl From<JSONRPCErrorError> for ActorCloseError {
+    fn from(error: JSONRPCErrorError) -> Self {
+        Self::Unverified(error)
+    }
+}
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn managed_close_idle(
+        &self,
+        params: ThreadManagedCloseIdleParams,
+        queues: &ThreadQueueRequestProcessor,
+    ) -> Result<ThreadManagedCloseIdleResponse, JSONRPCErrorError> {
+        tokio::time::timeout(
+            DRAIN_TIMEOUT,
+            self.managed_close_idle_inner(params, queues, ClosePurpose::Transfer),
+        )
+        .await
+        .map_err(|_| {
+            internal_error(
+                "managed close timed out; release is unverified and ownership must not transfer",
+            )
+        })?
+    }
+
+    pub(crate) async fn managed_close_for_maintenance(
+        &self,
+        params: ThreadManagedCloseIdleParams,
+        queues: &ThreadQueueRequestProcessor,
+        _admission: &crate::managed_instance_activity::ManagedMaintenanceGuard,
+    ) -> Result<ThreadManagedCloseIdleResponse, JSONRPCErrorError> {
+        self.managed_close_idle_inner(params, queues, ClosePurpose::InstanceMaintenance)
+            .await
+    }
+
+    async fn managed_close_idle_inner(
+        &self,
+        params: ThreadManagedCloseIdleParams,
+        queues: &ThreadQueueRequestProcessor,
+        purpose: ClosePurpose,
+    ) -> Result<ThreadManagedCloseIdleResponse, JSONRPCErrorError> {
+        if !crate::managed_sources::is_enabled() {
+            return Err(invalid_request(
+                "managed idle close is not enabled for this instance",
+            ));
+        }
+        let root_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_request("managed idle close requires a valid thread UUID"))?;
+        let root = self
+            .thread_manager
+            .get_thread(root_id)
+            .await
+            .map_err(|_| invalid_request("managed idle close requires a loaded root actor"))?;
+        if root
+            .config_snapshot()
+            .await
+            .session_source
+            .is_non_root_agent()
+        {
+            return Err(invalid_request(
+                "close the owning root and its complete spawn subtree",
+            ));
+        }
+        let blockers = root.managed_idle_blockers().await;
+        if !blockers.is_empty() {
+            return Err(invalid_request(format!(
+                "root thread is not idle: {}",
+                blockers.join(", ")
+            )));
+        }
+        // Avoid reserving a parent while a known child is working. The checks
+        // are repeated after reservation; this pass only reduces interference.
+        for id in self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+            .map_err(|error| internal_error(format!("cannot inspect managed subtree: {error}")))?
+        {
+            if let Ok(actor) = self.thread_manager.get_thread(id).await {
+                let blockers = actor.managed_idle_blockers().await;
+                if !blockers.is_empty() {
+                    return Err(invalid_request(format!(
+                        "thread {id} is not idle: {}",
+                        blockers.join(", ")
+                    )));
+                }
+            }
+        }
+        let root_admission = root.try_reserve_idle_close().map_err(|error| {
+            invalid_request(format!("cannot reserve root for managed close: {error}"))
+        })?;
+        let mut ids = self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+            .map_err(|error| {
+                internal_error(format!("cannot inventory managed descendants: {error}"))
+            })?;
+        ids.sort_by_cached_key(std::string::ToString::to_string);
+        ids.dedup();
+        if ids.len() > MAX_DRAIN_THREADS {
+            return Err(invalid_request(
+                "managed subtree exceeds the bounded close limit",
+            ));
+        }
+        let mut drain = self.managed_request_gate.try_drain(&ids)?;
+        let root_binding = self
+            .thread_manager
+            .managed_record_binding(root_id)
+            .await
+            .ok_or_else(|| invalid_request("root actor has no immutable managed source binding"))?;
+        let mut cold = self
+            .thread_manager
+            .prepare_managed_cold_drain(&root, &root_admission, &ids)
+            .await
+            .map_err(|error| invalid_request(format!("cannot reserve managed subtree: {error}")))?;
+
+        let mut actors = HashMap::new();
+        let mut admissions = HashMap::from([(root_id, root_admission)]);
+        let mut parents = HashMap::new();
+        let mut queue_guards = Vec::new();
+        for id in &ids {
+            let actor = self.thread_manager.get_thread(*id).await.ok();
+            if !self
+                .outgoing
+                .pending_requests_for_thread(*id)
+                .await
+                .is_empty()
+            {
+                return Err(invalid_request(format!(
+                    "thread {id} has a client request pending"
+                )));
+            }
+            if let Some(state) = self.thread_state_manager.get_thread_state(*id).await {
+                let state = state.lock().await;
+                let unknown_listener = state.cancel_tx.is_some()
+                    && actor
+                        .as_ref()
+                        .is_none_or(|actor| !state.listener_matches(actor));
+                if state.active_turn_snapshot().is_some()
+                    || !state.pending_interrupts.is_empty()
+                    || state.pending_rollbacks.is_some()
+                    || !state.turn_summary.command_execution_started.is_empty()
+                    || unknown_listener
+                {
+                    return Err(invalid_request(format!(
+                        "thread {id} has undrained runtime events"
+                    )));
+                }
+            }
+            let parent = if let Some(actor) = actor {
+                if *id != root_id {
+                    let blockers = actor.managed_idle_blockers().await;
+                    if !blockers.is_empty() {
+                        return Err(invalid_request(format!(
+                            "descendant {id} is not idle: {}",
+                            blockers.join(", ")
+                        )));
+                    }
+                    admissions.insert(
+                        *id,
+                        actor.try_reserve_idle_close().map_err(|error| {
+                            invalid_request(format!(
+                                "cannot reserve descendant {id} for managed close: {error}"
+                            ))
+                        })?,
+                    );
+                }
+                let binding = self
+                    .thread_manager
+                    .managed_record_binding(*id)
+                    .await
+                    .ok_or_else(|| {
+                        invalid_request(format!("actor {id} has no managed source binding"))
+                    })?;
+                if binding.source_id() != root_binding.source_id()
+                    || binding.source_config().codex_home != root_binding.source_config().codex_home
+                    || binding.authority_grant().owner_profile_id
+                        != root_binding.authority_grant().owner_profile_id
+                {
+                    return Err(invalid_request(
+                        "managed subtree spans different sources or owners",
+                    ));
+                }
+                let status = actor.agent_status().await;
+                if matches!(status, AgentStatus::Running)
+                    || (*id != root_id && matches!(status, AgentStatus::PendingInit))
+                    || !actor.list_background_terminals().await.is_empty()
+                {
+                    return Err(invalid_request(format!(
+                        "thread {id} is active; wait for completion"
+                    )));
+                }
+                queue_guards.push(queues.lock_for_managed_close(*id).await?);
+                let snapshot = actor.config_snapshot().await;
+                let parent = snapshot
+                    .parent_thread_id
+                    .or_else(|| snapshot.session_source.parent_thread_id());
+                actors.insert(*id, actor);
+                parent
+            } else {
+                if !cold.contains(*id) {
+                    return Err(invalid_request(format!(
+                        "descendant {id} has no held canonical writer reservation"
+                    )));
+                }
+                queue_guards.push(queues.lock_for_managed_cold_close(*id, &cold).await?);
+                cold.parent_thread_id(*id)
+            };
+            if *id != root_id && parent.is_none_or(|parent| !ids.contains(&parent)) {
+                return Err(invalid_request(
+                    "managed subtree parent relationship is unknown",
+                ));
+            }
+            parents.insert(*id, parent);
+        }
+        let order = leaves_first(parents)?;
+        let mut observed_ids = self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+            .map_err(|error| {
+                internal_error(format!("cannot recheck managed descendants: {error}"))
+            })?;
+        observed_ids.sort_by_cached_key(std::string::ToString::to_string);
+        observed_ids.dedup();
+        if observed_ids != ids {
+            return Err(invalid_request(
+                "managed descendants changed during close preflight; retry",
+            ));
+        }
+        {
+            let mut pending = self.pending_thread_unloads.lock().await;
+            if ids.iter().any(|id| pending.contains(id)) {
+                return Err(invalid_request("a subtree actor is already closing"));
+            }
+            pending.extend(ids.iter().copied());
+        }
+        // Persist the admission fence before the first core request. Cancellation,
+        // partial success, and timeout must not reopen partially released actors.
+        drain.arm();
+        let mut closed = Vec::new();
+        for id in order {
+            let result = if let Some(actor) = actors.get(&id) {
+                let admission = admissions
+                    .remove(&id)
+                    .ok_or_else(|| internal_error("managed close reservation disappeared"))?;
+                self.close_managed_actor(id, actor, admission).await
+            } else {
+                match cold.close_thread(id).await {
+                    Err(error) => Err(ActorCloseError::Unverified(internal_error(format!(
+                        "cold descendant {id} did not provide a release proof: {error}"
+                    )))),
+                    Ok(()) => {
+                        self.finish_managed_thread_close(id).await;
+                        Ok(())
+                    }
+                }
+            };
+            match result {
+                Ok(()) => closed.push(id.to_string()),
+                Err(ActorCloseError::IdleRejected(error)) if closed.is_empty() => {
+                    let mut pending = self.pending_thread_unloads.lock().await;
+                    for id in &ids {
+                        pending.remove(id);
+                    }
+                    drain.release_after_rejected_close();
+                    return Err(error);
+                }
+                Err(ActorCloseError::IdleRejected(error) | ActorCloseError::Unverified(error)) => {
+                    return Err(error);
+                }
+            }
+        }
+        match purpose {
+            ClosePurpose::Transfer => drain.commit(),
+            ClosePurpose::InstanceMaintenance => drain.release_after_verified_maintenance(),
+        }
+        drop(queue_guards);
+        Ok(ThreadManagedCloseIdleResponse {
+            thread_id: root_id.to_string(),
+            closed_thread_ids: closed,
+            writer_release_verified: true,
+        })
+    }
+
+    async fn close_managed_actor(
+        &self,
+        id: ThreadId,
+        actor: &Arc<CodexThread>,
+        admission: IdleCloseAdmission,
+    ) -> Result<(), ActorCloseError> {
+        let state = self.thread_state_manager.thread_state(id).await;
+        let listener_drain: Option<oneshot::Receiver<()>> = {
+            let mut state = state.lock().await;
+            state
+                .listener_matches(actor)
+                .then(|| state.register_shutdown_drain_waiter())
+        };
+        if let Err(error) = actor.close_idle_and_shutdown_reserved(admission).await {
+            let rejected = matches!(error.details(), CodexErrorDetails::UnsupportedOperation(_));
+            let error = invalid_request(format!(
+                "thread {id} did not provide a release proof: {error}",
+            ));
+            if rejected {
+                state.lock().await.take_shutdown_drain_waiter();
+                return Err(ActorCloseError::IdleRejected(error));
+            }
+            return Err(ActorCloseError::Unverified(error));
+        }
+        if let Some(listener_drain) = listener_drain {
+            listener_drain.await.map_err(|_| {
+                internal_error(format!(
+                    "thread {id} listener ended before its shutdown event was drained",
+                ))
+            })?;
+        }
+        if !self
+            .outgoing
+            .pending_requests_for_thread(id)
+            .await
+            .is_empty()
+        {
+            return Err(internal_error(format!(
+                "thread {id} still has client callbacks after shutdown"
+            ))
+            .into());
+        }
+        if self
+            .thread_manager
+            .remove_thread_if_matches(&id, actor)
+            .await
+            .is_none()
+        {
+            return Err(internal_error(format!("thread {id} was replaced while closing")).into());
+        }
+        self.finish_managed_thread_close(id).await;
+        Ok(())
+    }
+
+    async fn finish_managed_thread_close(&self, id: ThreadId) {
+        self.thread_state_manager.remove_thread_state(id).await;
+        self.thread_watch_manager
+            .remove_thread(&id.to_string())
+            .await;
+        self.pending_thread_unloads.lock().await.remove(&id);
+        self.outgoing
+            .send_server_notification(ServerNotification::ThreadClosed(ThreadClosedNotification {
+                thread_id: id.to_string(),
+            }))
+            .await;
+    }
+}
+
+fn leaves_first(
+    mut parents: HashMap<ThreadId, Option<ThreadId>>,
+) -> Result<Vec<ThreadId>, JSONRPCErrorError> {
+    let mut order = Vec::with_capacity(parents.len());
+    while !parents.is_empty() {
+        let parent_ids: HashSet<ThreadId> = parents.values().filter_map(|parent| *parent).collect();
+        let leaf = parents
+            .keys()
+            .filter(|id| !parent_ids.contains(id))
+            .min_by_key(std::string::ToString::to_string)
+            .copied()
+            .ok_or_else(|| invalid_request("managed subtree contains a parent cycle"))?;
+        parents.remove(&leaf);
+        order.push(leaf);
+    }
+    Ok(order)
+}
diff --git a/codex-rs/app-server/src/request_processors/managed_thread_idle_status.rs b/codex-rs/app-server/src/request_processors/managed_thread_idle_status.rs
