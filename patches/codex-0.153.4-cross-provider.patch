diff --git a/codex-rs/app-server/tests/suite/v2/managed_catalog_children.rs b/codex-rs/app-server/tests/suite/v2/managed_catalog_children.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5f1183dd92ee0325314c8f98dc639425bcf5884f
--- /dev/null
+++ b/codex-rs/app-server/tests/suite/v2/managed_catalog_children.rs
@@ -0,0 +1,166 @@
+//! Shared discovery must retain V2 children hidden by normal sidebar filters.
+
+use super::*;
+use codex_app_server_protocol::ThreadItem;
+use codex_app_server_protocol::ThreadListResponse;
+use codex_state::ReadOnlyThreadState;
+use codex_state::SqliteConfig;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn source_catalog_opens_parent_and_empty_preview_v2_child() -> Result<()> {
+    let source = ColdTreeFixture::new().await?;
+    let source_state =
+        ReadOnlyThreadState::open(&SqliteConfig::from_sqlite_home(source.home.path().abs()))
+            .await?;
+    let child_id = ThreadId::from_string(&source.child_id)?;
+    let child = source_state
+        .get_thread(child_id)
+        .await?
+        .context("child metadata")?;
+    assert!(
+        child.preview.as_deref().unwrap_or_default().is_empty(),
+        "exercise the child omitted by sidebar pages"
+    );
+    let first = source_state
+        .list_metadata_page(/*after_id*/ None, /*page_size*/ 1)
+        .await?;
+    assert_eq!(first.len(), 1);
+    let second = source_state
+        .list_metadata_page(Some(first[0].id), /*page_size*/ 1)
+        .await?;
+    assert_eq!(second.len(), 1);
+    let mut expected = vec![source.root_id.clone(), source.child_id.clone()];
+    expected.sort();
+    assert_eq!(
+        vec![first[0].id.to_string(), second[0].id.to_string()],
+        expected
+    );
+    assert!(
+        source_state
+            .list_metadata_page(Some(second[0].id), /*page_size*/ 1)
+            .await?
+            .is_empty()
+    );
+    let source_paths = [
+        first[0].rollout_path.clone(),
+        second[0].rollout_path.clone(),
+    ];
+    let original = source_paths
+        .iter()
+        .map(fs::read)
+        .collect::<std::io::Result<Vec<_>>>()?;
+    source_state.close().await;
+
+    let home = TempDir::new()?;
+    let profile_id = Uuid::new_v4().to_string();
+    let source_id = format!("manager:{profile_id}");
+    MockResponsesConfig::new(&source.api.uri())
+        .with_model("gpt-5.4")
+        .write(home.path())?;
+    write_models_cache(home.path())?;
+    fs::write(
+        home.path().join("managed-source.json"),
+        serde_json::to_vec(&json!({"host_id":"local","store_id":source_id}))?,
+    )?;
+    let manifest = home.path().join("managed-sources.json");
+    write_manifest(home.path(), &manifest, &profile_id, &source_id, &[])?;
+    let catalog = home.path().join("catalog-sources.json");
+    fs::write(
+        &catalog,
+        serde_json::to_vec(&json!({
+            "version":2,"hostId":"local","sources":[
+                {"hostId":"local","sourceStoreId":source.source_id,"codexHome":source.home.path()},
+                {"hostId":"local","sourceStoreId":source_id,"codexHome":home.path()}
+            ]
+        }))?,
+    )?;
+    let original_catalog = fs::read(&catalog)?;
+    let mut reader = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_managed_config()
+        .with_env_overrides(&[
+            ("CODEX_MANAGER_MANAGED_SOURCES", manifest.to_str()),
+            ("CODEX_MANAGER_SHARED_CATALOG", catalog.to_str()),
+            ("CODEX_MANAGER_RECORD_CATALOG", None),
+            ("CODEX_SQLITE_HOME", None),
+            ("OPENAI_API_KEY", None),
+            ("CODEX_ACCESS_TOKEN", None),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    let project = |id: &str| {
+        Uuid::new_v5(
+            &Uuid::from_u128(0x14a0f21bb52945fcbd9eb07637424fa3),
+            format!("local\0{}\0{id}", source.source_id).as_bytes(),
+        )
+        .to_string()
+    };
+    let root_projection = project(&source.root_id);
+    let child_projection = project(&source.child_id);
+    let request = reader
+        .send_raw_request("thread/list", Some(json!({})))
+        .await?;
+    let listed: ThreadListResponse = timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert!(
+        listed
+            .data
+            .iter()
+            .any(|thread| thread.id == root_projection)
+    );
+    let parent: ThreadResumeResponse = reader
+        .request(|request_id| ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: root_projection.clone(),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(parent.thread.can_accept_direct_input, Some(false));
+    assert!(
+        parent
+            .thread
+            .turns
+            .iter()
+            .flat_map(|turn| &turn.items)
+            .any(|item| match item {
+                ThreadItem::SubAgentActivity {
+                    agent_thread_id, ..
+                } => agent_thread_id == &child_projection,
+                ThreadItem::CollabAgentToolCall {
+                    receiver_thread_ids,
+                    ..
+                } => receiver_thread_ids.contains(&child_projection),
+                _ => false,
+            }),
+        "parent history must link to the projected child"
+    );
+    let child: ThreadReadResponse = reader
+        .request(|request_id| ClientRequest::ThreadRead {
+            request_id,
+            params: ThreadReadParams {
+                thread_id: child_projection,
+                include_turns: true,
+            },
+        })
+        .await?;
+    assert_eq!(child.thread.parent_thread_id, Some(root_projection));
+    assert_eq!(child.thread.can_accept_direct_input, Some(false));
+    assert!(!child.thread.turns.is_empty());
+    assert!(loaded_ids(&mut reader).await?.is_empty());
+    assert_eq!(
+        source_paths
+            .iter()
+            .map(fs::read)
+            .collect::<std::io::Result<Vec<_>>>()?,
+        original
+    );
+    assert_eq!(fs::read(catalog)?, original_catalog);
+    assert!(
+        timeout(READ_TIMEOUT, reader.shutdown_gracefully())
+            .await??
+            .success()
+    );
+    Ok(())
+}
diff --git a/codex-rs/app-server/tests/suite/v2/managed_catalog_derived_history.rs b/codex-rs/app-server/tests/suite/v2/managed_catalog_derived_history.rs
