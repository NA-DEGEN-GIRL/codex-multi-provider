+#[tokio::test]
+async fn external_goal_service_uses_runtime_source_even_with_profile_database() -> anyhow::Result<()>
+{
+    let fixture = SourceFixture::new().await?;
+    let thread_id = fixture.binding.thread_id();
+    let profile_before = fixture
+        .profile
+        .thread_goals()
+        .get_thread_goal(thread_id)
+        .await?;
+    let service = &fixture.harness.goal_service;
+    let outcome = service
+        .set_thread_goal(
+            fixture.profile.as_ref(),
+            GoalSetRequest {
+                thread_id,
+                objective: GoalObjectiveUpdate::Set("external source goal"),
+                status: Some(ThreadGoalStatus::Paused),
+                token_budget: GoalTokenBudgetUpdate::Keep,
+                max_goal_token_budget: None,
+            },
+        )
+        .await?;
+    assert_eq!(
+        service
+            .get_thread_goal(fixture.profile.as_ref(), thread_id)
+            .await?,
+        Some(outcome.goal),
+    );
+    assert!(
+        fixture
+            .source
+            .thread_goals()
+            .get_thread_goal(thread_id)
+            .await?
+            .is_some()
+    );
+    assert!(
+        service
+            .clear_thread_goal(fixture.profile.as_ref(), thread_id)
+            .await?
+    );
+    assert_eq!(
+        fixture
+            .source
+            .thread_goals()
+            .get_thread_goal(thread_id)
+            .await?,
