+use codex_app_server_protocol::TurnStartParams;
+use codex_app_server_protocol::TurnStatus;
+use codex_app_server_protocol::UserInput;
+use core_test_support::responses;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::TempDir;
+use tokio::time::timeout;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::matchers::method;
+use wiremock::matchers::path_regex;
+
+const READ_TIMEOUT: Duration = Duration::from_secs(60);
+const PARENT_PROMPT: &str = "Start the shared refresh worker";
+const CHILD_PROMPT: &str = "Collect the shared refresh result";
+const OTHER_APP_PROMPT: &str = "Other app appended this shared turn";
+const RESUMED_PROMPT: &str = "Continue after the other app turn";
+const FOLLOW_UP_PROMPT: &str = "Follow up on the shared worker";
+const RECORD_RESULT_PROMPT: &str = "Record the shared worker result";
+const WORKER_RESULT: &str = "Shared refresh worker result";
+const REACH_WORKER_PROMPT: &str = "Hand the closed worker another task";
+const WORKER_FOLLOW_UP: &str = "Second task for the reloaded worker";
+const QUEUE_MAIL_PROMPT: &str = "Leave the idle worker a note";
+const QUEUED_MAIL: &str = "Note queued for the idle shared worker";
+const SPAWN_CALL_ID: &str = "spawn-shared-refresh-worker";
+const FOLLOW_UP_CALL_ID: &str = "follow-up-shared-refresh-worker";
+const SEND_MAIL_CALL_ID: &str = "send-mail-shared-refresh-worker";
+const CHILD_CALL_ID: &str = "shared-refresh-worker-command";
+const OWNER_WRITER_ID: &str = "00000000-0000-4000-8000-00000000000a";
+const OTHER_WRITER_ID: &str = "00000000-0000-4000-8000-00000000000b";
+
+struct SharedTaskFixture {
+    home: TempDir,
+    api: MockServer,
+}
+
+impl SharedTaskFixture {
+    /// Both app-servers share one home in shared-append mode, as profiles that
+    /// share a record home do. The parent spawns one V2 worker whose first
+    /// response is `worker_response`.
+    async fn new(worker_response: String) -> Result<Self> {
+        let api = responses::start_mock_server().await;
+        responses::mount_sse_once_match(
+            &api,
+            |request: &wiremock::Request| {
+                let body = String::from_utf8_lossy(&request.body);
+                body.contains(PARENT_PROMPT) && !body.contains(SPAWN_CALL_ID)
+            },
+            responses::sse(vec![
+                responses::ev_response_created("spawn"),
+                responses::ev_function_call_with_namespace(
+                    SPAWN_CALL_ID,
+                    "collaboration",
+                    "spawn_agent",
+                    &json!({
+                        "message": CHILD_PROMPT,
+                        "task_name": "worker",
+                        "fork_turns": "none",
+                    })
+                    .to_string(),
+                ),
+                responses::ev_completed("spawn"),
+            ]),
+        )
+        .await;
+        responses::mount_sse_once_match(
+            &api,
+            |request: &wiremock::Request| {
+                let body = String::from_utf8_lossy(&request.body);
+                body.contains(CHILD_PROMPT)
+                    && !body.contains(SPAWN_CALL_ID)
+                    && !body.contains(CHILD_CALL_ID)
+            },
+            worker_response,
+        )
+        .await;
+        responses::mount_sse_once_match(
+            &api,
+            |request: &wiremock::Request| {
+                String::from_utf8_lossy(&request.body).contains(CHILD_CALL_ID)
+            },
+            create_final_assistant_message_sse_response(WORKER_RESULT)?,
+        )
+        .await;
+        Mock::given(method("POST"))
+            .and(path_regex(".*/responses$"))
+            .respond_with(responses::sse_response(
+                create_final_assistant_message_sse_response("Done")?,
+            ))
+            .with_priority(10)
+            .mount(&api)
+            .await;
+        let home = TempDir::new()?;
+        MockResponsesConfig::new(&api.uri())
+            .with_provider_name("OpenAI")
+            .with_model("gpt-5.4")
+            .with_approval_policy("on-request")
+            .with_extra_config("[features.multi_agent_v2]\nenabled = true")
+            .write(home.path())?;
+        write_models_cache(home.path())?;
+        Ok(Self { home, api })
+    }
+
+    /// Each app is a separate profile writer of the shared records.
+    async fn start_app(&self, writer_id: &str) -> Result<TestAppServer> {
+        TestAppServer::builder()
+            .with_codex_home(self.home.path())
+            .without_managed_config()
+            .with_env_overrides(&[
+                ("CODEX_RECORD_SHARED_APPEND", Some("1")),
+                ("CODEX_MANAGER_SHARED_EXECUTION", Some("1")),
+                ("CODEX_MANAGER_SHARED_WRITER_ID", Some(writer_id)),
+                ("CODEX_RECORD_HOME", None),
+                ("CODEX_MANAGER_SHARED_CATALOG", None),
+                ("CODEX_MANAGER_MANAGED_SOURCES", None),
+                ("CODEX_MANAGER_RECORD_CATALOG", None),
+                ("CODEX_SQLITE_HOME", None),
+                ("OPENAI_API_KEY", None),
+                ("CODEX_ACCESS_TOKEN", None),
+            ])
+            .build_initialized_with_timeout(READ_TIMEOUT)
+            .await
+    }
+
+    /// Start the owner, run the spawning turn, and return the owner with the
+    /// root thread ID.
+    async fn start_owner_with_worker(&self) -> Result<(TestAppServer, String)> {
+        let mut owner = self.start_app(OWNER_WRITER_ID).await?;
+        let root_id = owner
+            .start_thread(ThreadStartParams {
+                history_mode: Some(ThreadHistoryMode::Paginated),
+                ..Default::default()
+            })
+            .await?
+            .thread
+            .id;
+        let completed = timeout(
+            READ_TIMEOUT,
+            owner.start_turn_and_wait_for_completion(text_turn(&root_id, PARENT_PROMPT)),
+        )
+        .await??;
+        assert_eq!(
+            (completed.turn.status, completed.turn.error),
+            (TurnStatus::Completed, None)
+        );
+        Ok((owner, root_id))
+    }
+
+    /// Like `start_owner_with_worker`, then wait until the worker finished and
+    /// the root took its completion notice in a turn of its own, leaving an
+    /// idle root with no queued mail and an idle, loaded worker. Returns the
+    /// owner, the root ID and the worker ID.
+    async fn start_owner_with_idle_worker(&self) -> Result<(TestAppServer, String, String)> {
+        let (mut owner, root_id) = self.start_owner_with_worker().await?;
+        let worker_turn = timeout(
+            READ_TIMEOUT,
+            owner.read_stream_until_matching_notification(
+                "worker turn/completed",
+                |notification| {
+                    notification.method == "turn/completed"
+                        && notification
+                            .params
+                            .as_ref()
+                            .is_some_and(|params| params["threadId"] != root_id.as_str())
+                },
+            ),
+        )
+        .await??;
+        let worker_turn: TurnCompletedNotification =
+            serde_json::from_value(worker_turn.params.context("turn/completed params")?)?;
+        assert_eq!(worker_turn.turn.status, TurnStatus::Completed);
+        tokio::time::sleep(Duration::from_millis(500)).await;
+        let completed = timeout(
+            READ_TIMEOUT,
+            owner.start_turn_and_wait_for_completion(text_turn(&root_id, RECORD_RESULT_PROMPT)),
+        )
+        .await??;
+        assert_eq!(
+            (completed.turn.status, completed.turn.error),
+            (TurnStatus::Completed, None)
+        );
+        Ok((owner, root_id, worker_turn.thread_id))
+    }
+
+    /// The root hands the closed worker a follow-up task, which reloads the
+    /// worker from its record. Returns the worker's first request for it.
+    async fn reach_worker_again(&self, owner: &mut TestAppServer, root_id: &str) -> Result<String> {
+        responses::mount_sse_once_match(
+            &self.api,
+            |request: &wiremock::Request| {
+                let body = String::from_utf8_lossy(&request.body);
+                body.contains(REACH_WORKER_PROMPT) && !body.contains(FOLLOW_UP_CALL_ID)
+            },
+            responses::sse(vec![
+                responses::ev_response_created("follow-up"),
+                responses::ev_function_call_with_namespace(
+                    FOLLOW_UP_CALL_ID,
+                    "collaboration",
+                    "followup_task",
+                    &json!({ "target": "worker", "message": WORKER_FOLLOW_UP }).to_string(),
+                ),
+                responses::ev_completed("follow-up"),
+            ]),
+        )
+        .await;
+        let completed = timeout(
+            READ_TIMEOUT,
+            owner.start_turn_and_wait_for_completion(text_turn(root_id, REACH_WORKER_PROMPT)),
+        )
+        .await??;
+        assert_eq!(
+            (completed.turn.status, completed.turn.error),
+            (TurnStatus::Completed, None)
+        );
+        timeout(READ_TIMEOUT, async {
+            loop {
+                let worker_requests = self
+                    .request_bodies_containing(WORKER_FOLLOW_UP)
+                    .await?
+                    .into_iter()
+                    .filter(|body| !body.contains(FOLLOW_UP_CALL_ID))
+                    .collect::<Vec<_>>();
+                if let Some(body) = worker_requests.into_iter().next() {
+                    return anyhow::Ok(body);
+                }
+                tokio::time::sleep(Duration::from_millis(50)).await;
+            }
+        })
+        .await?
+    }
+
+    /// Model requests made by the worker. Its task message is in each of them,
+    /// while only the root's requests record the spawn call.
+    async fn worker_request_bodies(&self) -> Result<Vec<String>> {
+        Ok(self
+            .request_bodies_containing(CHILD_PROMPT)
+            .await?
+            .into_iter()
+            .filter(|body| !body.contains(SPAWN_CALL_ID))
+            .collect())
+    }
+
+    /// Another app resumes the shared task and appends a completed turn.
+    async fn append_turn_from_other_app(&self, root_id: &str) -> Result<()> {
+        let mut other = self.start_app(OTHER_WRITER_ID).await?;
+        let _: ThreadResumeResponse = other
+            .request(|request_id| ClientRequest::ThreadResume {
+                request_id,
+                params: ThreadResumeParams {
+                    thread_id: root_id.to_string(),
+                    exclude_turns: true,
+                    ..Default::default()
+                },
+            })
+            .await?;
+        let completed = timeout(
+            READ_TIMEOUT,
+            other.start_turn_and_wait_for_completion(text_turn(root_id, OTHER_APP_PROMPT)),
+        )
+        .await??;
+        assert_eq!(
+            (completed.turn.status, completed.turn.error),
+            (TurnStatus::Completed, None)
+        );
+        assert!(
+            timeout(READ_TIMEOUT, other.shutdown_gracefully())
+                .await??
+                .success()
+        );
+        Ok(())
+    }
+
+    async fn request_bodies_containing(&self, text: &str) -> Result<Vec<String>> {
+        Ok(self
+            .api
+            .received_requests()
+            .await
+            .context("mock request log")?
+            .iter()
+            .map(|request| String::from_utf8_lossy(&request.body).into_owned())
+            .filter(|body| body.contains(text))
+            .collect())
+    }
+}
+
+fn text_turn(thread_id: &str, text: &str) -> TurnStartParams {
+    TurnStartParams {
+        thread_id: thread_id.to_string(),
+        input: vec![UserInput::Text {
+            text: text.to_string(),
+            text_elements: Vec::new(),
+        }],
+        ..Default::default()
+    }
+}
+
+async fn wait_for_turn_completed(app: &mut TestAppServer, thread_id: &str) -> Result<()> {
+    let notification = timeout(
+        READ_TIMEOUT,
+        app.read_stream_until_matching_notification("worker turn/completed", |notification| {
+            notification.method == "turn/completed"
+                && notification
+                    .params
+                    .as_ref()
+                    .is_some_and(|params| params["threadId"] == thread_id)
+        }),
+    )
+    .await??;
+    let completed: TurnCompletedNotification =
+        serde_json::from_value(notification.params.context("turn/completed params")?)?;
+    assert_eq!(completed.turn.status, TurnStatus::Completed);
+    Ok(())
+}
+
+async fn loaded_ids(app: &mut TestAppServer) -> Result<Vec<String>> {
+    let loaded: ThreadLoadedListResponse = app
+        .request(|request_id| ClientRequest::ThreadLoadedList {
+            request_id,
+            params: ThreadLoadedListParams::default(),
+        })
+        .await?;
