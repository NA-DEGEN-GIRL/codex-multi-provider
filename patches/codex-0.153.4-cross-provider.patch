+/// Every record of `thread_id`'s legacy rollout, oldest first.
+fn rollout_records(codex_home: &Path, thread_id: &str) -> Result<Vec<Value>> {
+    let mut pending = vec![codex_home.join("sessions")];
+    let mut records = Vec::new();
+    while let Some(dir) = pending.pop() {
+        for entry in std::fs::read_dir(&dir)? {
+            let path = entry?.path();
+            if path.is_dir() {
+                pending.push(path);
+                continue;
+            }
+            let name = path
+                .file_name()
+                .and_then(|name| name.to_str())
+                .unwrap_or_default();
+            if name.contains(thread_id) && name.ends_with(".jsonl") {
+                for line in std::fs::read_to_string(&path)?.lines() {
+                    records.push(serde_json::from_str(line)?);
+                }
+            }
+        }
+    }
+    Ok(records)
+}
+
+/// Replaces the digest of every return anchor in `thread_id`'s legacy rollout, as if the history
+/// it covers had changed since it was recorded. Returns how many anchors were changed.
+fn tamper_return_anchors(codex_home: &Path, thread_id: &str) -> Result<usize> {
+    let mut pending = vec![codex_home.join("sessions")];
+    let mut tampered = 0;
+    while let Some(dir) = pending.pop() {
+        for entry in std::fs::read_dir(&dir)? {
+            let path = entry?.path();
+            if path.is_dir() {
+                pending.push(path);
+                continue;
+            }
+            let name = path
+                .file_name()
+                .and_then(|name| name.to_str())
+                .unwrap_or_default();
+            if !name.contains(thread_id) || !name.ends_with(".jsonl") {
+                continue;
+            }
+            let mut lines = Vec::new();
+            for line in std::fs::read_to_string(&path)?.lines() {
+                let mut record: Value = serde_json::from_str(line)?;
+                if let Some(anchors) =
+                    record["payload"]["origin"]["kind"]["return_anchors"].as_array_mut()
+                {
+                    for anchor in anchors {
+                        anchor["digest"] = json!("tampered");
+                        tampered += 1;
+                    }
+                }
+                lines.push(serde_json::to_string(&record)?);
+            }
+            std::fs::write(&path, lines.join("\n") + "\n")?;
+        }
+    }
+    Ok(tampered)
+}
