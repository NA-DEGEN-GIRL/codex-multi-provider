+#[test]
+fn claude_image_rejects_symlink_storage() {
+    let home = tempfile::tempdir().unwrap();
+    let outside = tempfile::tempdir().unwrap();
+    let link = home.path().join("claude-image-handoff");
+    #[cfg(unix)]
+    std::os::unix::fs::symlink(outside.path(), &link).unwrap();
+    #[cfg(windows)]
+    if std::os::windows::fs::symlink_dir(outside.path(), &link).is_err() {
+        // Non-developer Windows accounts may lack symlink privileges; a junction
+        // is also a reparse point and must receive the same refusal.
+        let status = std::process::Command::new("cmd")
+            .args(["/c", "mklink", "/J"])
+            .arg(&link)
+            .arg(outside.path())
+            .status()
+            .unwrap();
+        assert!(status.success());
+    }
+    assert!(store(home.path(), "image.png", b"bytes").is_err());
+    assert!(!outside.path().join("image.png").exists());
+}
