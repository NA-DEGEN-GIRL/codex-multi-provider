+async fn start_gpt_thread(
+    mcp: &mut TestAppServer,
+    history_mode: ThreadHistoryMode,
+) -> Result<String> {
+    start_thread(mcp, GPT_PROVIDER, GPT_MODEL, history_mode).await
+}
+
+async fn start_thread(
+    mcp: &mut TestAppServer,
+    provider: &str,
+    model: &str,
+    history_mode: ThreadHistoryMode,
+) -> Result<String> {
+    let ThreadStartResponse { thread, .. } = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.start_thread(ThreadStartParams {
+            model: Some(model.to_string()),
+            model_provider: Some(provider.to_string()),
+            base_instructions: Some(BASE_INSTRUCTIONS.to_string()),
+            history_mode: Some(history_mode),
+            ..Default::default()
+        }),
+    )
+    .await??;
+    Ok(thread.id)
+}
+
+async fn run_turn(mcp: &mut TestAppServer, thread_id: &str, text: &str) -> Result<String> {
+    let completed = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: thread_id.to_string(),
+            input: vec![UserInput::Text {
+                text: text.to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        }),
+    )
+    .await??;
+    Ok(completed.turn.id)
+}
+
+/// Compacts the thread and returns the notifications seen until the compaction turn finished.
+async fn compact(mcp: &mut TestAppServer, thread_id: &str) -> Result<Vec<JSONRPCNotification>> {
+    mcp.clear_message_buffer();
+    let request_id = mcp
+        .send_thread_compact_start_request(ThreadCompactStartParams {
+            thread_id: thread_id.to_string(),
+        })
+        .await?;
+    let _: ThreadCompactStartResponse =
+        timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(request_id)).await??;
+    let mut seen = Vec::new();
+    timeout(DEFAULT_READ_TIMEOUT, async {
+        loop {
+            let JSONRPCMessage::Notification(notification) = mcp.read_next_message().await? else {
+                continue;
+            };
+            let done = notification.method == "turn/completed";
+            seen.push(notification);
+            if done {
+                return anyhow::Ok(());
+            }
+        }
+    })
+    .await??;
+    Ok(seen)
+}
+
+/// Restarts the app server and resumes `thread_id` on another provider.
+async fn resume_on(
+    codex_home: &Path,
+    mcp: TestAppServer,
+    thread_id: &str,
+    provider: &str,
+    model: &str,
+    auto_compact_limit: Option<i64>,
+) -> Result<TestAppServer> {
+    let mut previous = mcp;
+    timeout(DEFAULT_READ_TIMEOUT, previous.shutdown_gracefully()).await??;
+    let mut mcp = start_app_server(codex_home).await?;
+    let config = auto_compact_limit
+        .map(|limit| HashMap::from([("model_auto_compact_token_limit".to_string(), json!(limit))]));
+    let request_id = mcp
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: thread_id.to_string(),
+            model: Some(model.to_string()),
+            model_provider: Some(provider.to_string()),
+            base_instructions: Some(BASE_INSTRUCTIONS.to_string()),
+            config,
+            ..Default::default()
+        })
+        .await?;
+    let _: ThreadResumeResponse =
+        timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(request_id)).await??;
+    Ok(mcp)
+}
+
+async fn wait_for_warning(mcp: &mut TestAppServer, needle: &str) -> Result<WarningNotification> {
+    timeout(DEFAULT_READ_TIMEOUT, async {
+        loop {
+            let warning: WarningNotification = mcp.read_notification("warning").await?;
+            if warning.message.contains(needle) {
+                return anyhow::Ok(warning);
+            }
+        }
+    })
+    .await?
+}
+
+/// GPT compacts; the thread then continues on DeepSeek and returns to GPT.
+async fn gpt_compacted_thread(
+    codex_home: &Path,
+    server: &MockServer,
+) -> Result<(TestAppServer, String)> {
+    write_config(codex_home, server)?;
+    let mut mcp = start_app_server(codex_home).await?;
+    let thread_id = start_gpt_thread(&mut mcp, ThreadHistoryMode::Paginated).await?;
+    run_turn(&mut mcp, &thread_id, "gpt first question").await?;
+    compact(&mut mcp, &thread_id).await?;
+    Ok((mcp, thread_id))
+}
+
+/// A GPT thread that DeepSeek already served once, back on GPT: its compactions now also produce
+/// a portable summary.
+async fn gpt_thread_used_by_deepseek(
+    codex_home: &Path,
+    server: &MockServer,
+    history_mode: ThreadHistoryMode,
+) -> Result<(TestAppServer, String)> {
+    write_config(codex_home, server)?;
+    configured_gpt_thread_used_by_deepseek(
+        codex_home,
+        history_mode,
+        /*auto_compact_limit*/ None,
+    )
+    .await
+}
+
+/// [`gpt_thread_used_by_deepseek`] with the configuration already written, and GPT's
+/// auto-compaction limit on its return.
+async fn configured_gpt_thread_used_by_deepseek(
+    codex_home: &Path,
+    history_mode: ThreadHistoryMode,
+    auto_compact_limit: Option<i64>,
+) -> Result<(TestAppServer, String)> {
+    let mut mcp = start_app_server(codex_home).await?;
+    let thread_id = start_gpt_thread(&mut mcp, history_mode).await?;
+    run_turn(&mut mcp, &thread_id, "gpt first question").await?;
+    let mut mcp = resume_on(
+        codex_home,
+        mcp,
+        &thread_id,
+        DEEPSEEK_PROVIDER,
+        DEEPSEEK_MODEL,
+        /*auto_compact_limit*/ None,
+    )
+    .await?;
+    run_turn(&mut mcp, &thread_id, "deepseek question").await?;
+    let mcp = resume_on(
+        codex_home,
+        mcp,
+        &thread_id,
+        GPT_PROVIDER,
+        GPT_MODEL,
+        auto_compact_limit,
+    )
+    .await?;
+    Ok((mcp, thread_id))
+}
