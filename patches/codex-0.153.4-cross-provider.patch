+//! Forward reader for a thread's complete model-visible transcript.
+//!
+//! [`crate::ModelContextScan`] returns only the replay needed to resume on the same provider: the
+//! newest compaction checkpoint and the records after it. Continuing a thread on another provider
+//! family needs the history that checkpoint replaced, because the checkpoint's opaque items only
+//! mean something to the provider that produced them. [`ModelTranscriptBuilder`] consumes rollout
+//! records oldest first and keeps every item that is still valid:
+//!
+//! - Legacy `ThreadRolledBack` markers drop the newest user turns, as replay does: by turn when
+//!   turn markers were recorded, otherwise from the newest user message onward. Paginated
+//!   reverts need no handling here because their `history_base` already cuts the lineage.
+//! - Local compaction records its summary output as ordinary items just before the checkpoint,
+//!   and the checkpoint records how many. Only those items are dropped; the checkpoint keeps the
+//!   summary. Coverage is positional, so tool outputs and other items without IDs before a
+//!   checkpoint always survive, and remote compaction never removes anything.
+//! - An exact copy of an item from an earlier rollout file of the lineage, as a fork may record,
+//!   is not repeated. Items within one file are never merged, whatever their IDs.
+//! - A checkpoint that is the first model-visible record means earlier history is stored
+//!   elsewhere, as with subagents that inherited their parent's latest context. The transcript is
+//!   then marked incomplete, and that checkpoint is kept whatever it covers: the items it covers
+//!   belong to the other thread, so later checkpoints may cover them too. Every other checkpoint
+//!   is dropped when an item it covers is no longer part of the transcript.
+//! - Every item and checkpoint remembers the provider and model of the turn that recorded it, so
+//!   readers can tell whose opaque state an item carries. A turn recorded before providers were
+//!   tracked is tied to the provider its session was created with when it uses the model that
+//!   session started with ([`SessionProviderHint`]).
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::io;
+use std::path::Path;
+
+use codex_protocol::items::TurnItem;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::SessionMetaLine;
+use codex_protocol::protocol::TurnContextItem;
+use serde_json::Value;
+
+use crate::CompactedItem;
+use crate::ResponseItemEnvelope;
+use crate::RolloutItem;
+use crate::model_context::response_item_counts_as_user_turn;
+
+/// Provider and model recorded by the turn that produced an item.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TranscriptProducer {
+    /// Configured provider id. Turns recorded before providers were tracked omit it.
+    pub model_provider: Option<String>,
+    pub model: String,
+    /// For a turn without `model_provider`: the provider its session was created with, when the
+    /// turn uses the model that session started with.
+    pub session_provider: Option<String>,
+}
+
+/// Attributes turns recorded before providers were tracked to their session's provider.
+///
+/// Every rollout file starts with session metadata naming the provider the session was created
+/// with. A turn that records no provider but uses the model the session's first turn used most
+/// likely ran on that provider. A turn with another model may come from a switch the runtime did
+/// not record, so it gets no hint.
+#[derive(Debug, Default, Clone)]
+pub struct SessionProviderHint {
+    provider: Option<String>,
+    first_model: Option<String>,
+}
+
+impl SessionProviderHint {
+    /// Starts attributing the turns of a new session.
+    pub fn observe_session_meta(&mut self, meta: &SessionMetaLine) {
+        *self = Self {
+            provider: meta.meta.model_provider.clone(),
+            first_model: None,
+        };
+    }
+
+    /// Returns the session's provider for a turn that recorded none and uses the model the
+    /// session started with.
+    pub fn provider_for(&mut self, context: &TurnContextItem) -> Option<String> {
+        let first_model = self
+            .first_model
+            .get_or_insert_with(|| context.model.clone());
+        if context.model_provider.is_some() || *first_model != context.model {
+            return None;
+        }
+        self.provider.clone()
+    }
+}
+
+/// One valid model-visible item and the position of the record that stored it.
+#[derive(Debug, Clone, PartialEq)]
+pub struct TranscriptItem {
+    /// Owning turn, including when shared writers interleave their records.
+    pub turn_id: Option<String>,
+    /// Only terminal turns may be handed to a different local agent session.
+    pub completed: bool,
+    /// Lineage ordinal for paginated threads, record index for legacy threads.
+    pub position: u64,
+    pub item: ResponseItemEnvelope,
+    /// Index in [`ModelTranscript::producers`] of the turn that recorded this item, when a turn
+    /// context preceded it.
+    pub producer: Option<usize>,
+}
+
+/// A compaction checkpoint that survived rollback, revert and coverage checks.
+#[derive(Debug, Clone, PartialEq)]
+pub struct TranscriptCheckpoint {
+    /// Lineage ordinal for paginated threads, record index for legacy threads.
+    pub position: u64,
+    /// The checkpoint covers `ModelTranscript::items[..items_before]`.
+    pub items_before: usize,
+    pub compacted: CompactedItem,
+    /// Index in [`ModelTranscript::producers`] of the turn that recorded this checkpoint.
+    pub producer: Option<usize>,
+}
+
+/// Whether the transcript starts at the beginning of the thread's history.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum TranscriptCompleteness {
+    Complete,
+    /// Earlier history is not stored with this thread.
+    Incomplete {
+        reason: String,
+    },
+}
+
+/// Valid model-visible history of a thread, oldest first.
+#[derive(Debug, Clone, PartialEq)]
+pub struct ModelTranscript {
+    pub items: Vec<TranscriptItem>,
+    pub checkpoints: Vec<TranscriptCheckpoint>,
+    pub completeness: TranscriptCompleteness,
+    /// Checkpoints dropped because an item they cover is no longer part of the transcript.
+    pub rejected_checkpoints: usize,
+    /// Distinct producers referenced by items and checkpoints.
+    pub producers: Vec<TranscriptProducer>,
+}
+
+/// Accumulates rollout records oldest first into a [`ModelTranscript`].
+#[derive(Debug, Default)]
+pub struct ModelTranscriptBuilder {
+    current_turn_id: Option<String>,
+    turn_producers: HashMap<String, usize>,
+    completed_turns: HashSet<String>,
+    segments: Vec<TurnSegment>,
+    incomplete: Option<String>,
+    saw_model_visible_record: bool,
+    producers: Vec<TranscriptProducer>,
+    current_producer: Option<usize>,
+    session_hint: SessionProviderHint,
+    /// Rollout file the next records come from; see [`Self::begin_source`].
+    source: u32,
+    /// A user-message event arrived before its message item.
+    pending_user_message: bool,
+}
+
+/// Records from one `TurnStarted` up to the next, matching replay's rollback unit.
+#[derive(Debug, Default)]
+struct TurnSegment {
+    started_by_turn: bool,
+    counts_as_user_turn: bool,
+    entries: Vec<TranscriptEntry>,
+}
+
+#[derive(Debug)]
+enum TranscriptEntry {
+    Item {
+        item: TranscriptItem,
+        /// Starts a user turn, as `drop_last_n_user_turns` counts turns.
+        user_turn: bool,
+        /// Rollout file that recorded the item.
+        source: u32,
+    },
+    Checkpoint {
+        position: u64,
+        compacted: Box<CompactedItem>,
+        producer: Option<usize>,
+        /// No model-visible record of this thread precedes the checkpoint: it came with history
+        /// stored elsewhere.
+        inherited: bool,
+    },
+}
+
+impl ModelTranscriptBuilder {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Marks the transcript incomplete. The first reason is kept.
+    pub fn mark_incomplete(&mut self, reason: impl Into<String>) {
+        self.incomplete.get_or_insert_with(|| reason.into());
+    }
+
+    /// Starts reading another rollout file of the lineage. Only items from different files can
+    /// be copies of each other.
+    pub fn begin_source(&mut self) {
+        self.source = self.source.saturating_add(1);
+        self.session_hint = SessionProviderHint::default();
+    }
+
+    /// Adds the next oldest-to-newest rollout record.
+    pub fn push(&mut self, position: u64, item: RolloutItem) {
+        match item {
+            RolloutItem::ResponseItem(envelope) => {
+                let user_turn = response_item_counts_as_user_turn(&envelope);
+                self.push_item(position, envelope, user_turn);
+            }
+            RolloutItem::InterAgentCommunication(communication) => {
+                let item = ResponseItemEnvelope::new(communication.to_model_input_item());
+                self.push_item(position, item, /*user_turn*/ true);
+            }
+            RolloutItem::Compacted(compacted) => self.push_checkpoint(position, compacted),
+            other => self.push_marker(&other),
+        }
+    }
+
+    /// Adds a borrowed record, copying only what the transcript keeps.
+    pub fn push_ref(&mut self, position: u64, item: &RolloutItem) {
+        match item {
+            RolloutItem::ResponseItem(envelope) => {
+                let user_turn = response_item_counts_as_user_turn(envelope);
+                self.push_item(position, envelope.clone(), user_turn);
+            }
+            RolloutItem::InterAgentCommunication(communication) => {
+                let item = ResponseItemEnvelope::new(communication.to_model_input_item());
+                self.push_item(position, item, /*user_turn*/ true);
+            }
+            RolloutItem::Compacted(compacted) => self.push_checkpoint(position, compacted.clone()),
+            other => self.push_marker(other),
+        }
+    }
+
+    fn push_item(&mut self, position: u64, item: ResponseItemEnvelope, user_turn: bool) {
+        self.saw_model_visible_record = true;
+        let user_turn = user_turn || (self.pending_user_message && is_user_message(&item.item));
+        if user_turn {
+            self.pending_user_message = false;
+        }
+        let turn_id = item
+            .item
+            .turn_id()
+            .map(str::to_string)
+            .or_else(|| self.current_turn_id.clone());
+        let producer = match &turn_id {
+            Some(id) => self.turn_producers.get(id).copied(),
+            None => self.current_producer,
+        };
+        let source = self.source;
+        let completed = turn_id
+            .as_ref()
+            .is_none_or(|id| self.completed_turns.contains(id));
+        let segment = self.current_segment();
+        segment.counts_as_user_turn |= user_turn;
+        segment.entries.push(TranscriptEntry::Item {
+            item: TranscriptItem {
+                completed,
+                turn_id,
+                position,
+                item,
+                producer,
+            },
+            user_turn,
+            source,
+        });
+    }
+
+    /// Applies a record that carries no model-visible item.
+    fn push_marker(&mut self, item: &RolloutItem) {
+        match item {
+            RolloutItem::SessionMeta(meta) => self.session_hint.observe_session_meta(meta),
+            RolloutItem::TurnContext(context) => {
+                self.current_turn_id = context.turn_id.clone();
+                let producer = TranscriptProducer {
+                    model_provider: context.model_provider.clone(),
+                    model: context.model.clone(),
+                    session_provider: self.session_hint.provider_for(context),
+                };
+                let index = match self.producers.iter().position(|known| *known == producer) {
+                    Some(index) => index,
+                    None => {
+                        self.producers.push(producer);
+                        self.producers.len() - 1
+                    }
+                };
+                self.current_producer = Some(index);
+                if let Some(turn_id) = &context.turn_id {
+                    self.turn_producers.insert(turn_id.clone(), index);
+                }
+            }
+            RolloutItem::EventMsg(EventMsg::TurnStarted(event)) => {
+                self.current_turn_id = Some(event.turn_id.clone());
+                self.segments.push(TurnSegment {
+                    started_by_turn: true,
+                    ..Default::default()
+                });
+            }
+            RolloutItem::EventMsg(EventMsg::TurnComplete(event)) => {
+                self.mark_completed(&event.turn_id);
+            }
+            RolloutItem::EventMsg(EventMsg::TurnAborted(event)) => {
+                if let Some(turn_id) = &event.turn_id {
+                    self.mark_completed(turn_id);
+                } else {
+                    // Old abort records omitted the owning ID. Only infer it when
+                    // exactly one unfinished turn exists; concurrent turns remain isolated.
+                    let unfinished =
+                        self.segments
+                            .iter()
+                            .flat_map(|segment| &segment.entries)
+                            .filter_map(|entry| match entry {
+                                TranscriptEntry::Item { item, .. }
+                                    if !item.completed
+                                        && !item.turn_id.as_ref().is_some_and(|id| {
+                                            self.completed_turns.contains(id)
+                                        }) =>
+                                {
+                                    item.turn_id.clone()
+                                }
+                                _ => None,
+                            })
+                            .collect::<HashSet<_>>();
+                    if unfinished.len() == 1
+                        && let Some(turn_id) = unfinished.into_iter().next()
+                    {
+                        self.mark_completed(&turn_id);
+                    }
+                }
+            }
+            RolloutItem::EventMsg(EventMsg::UserMessage(_)) => self.mark_user_message(),
+            RolloutItem::EventMsg(EventMsg::ItemCompleted(event))
+                if matches!(&event.item, TurnItem::UserMessage(_)) =>
+            {
+                self.mark_user_message();
+            }
+            RolloutItem::EventMsg(EventMsg::ThreadRolledBack(rollback)) => {
+                self.roll_back(rollback.num_turns);
+                // Later records belong to a new span even before the next turn starts.
+                self.segments.push(TurnSegment::default());
+            }
+            RolloutItem::ResponseItem(_)
+            | RolloutItem::InterAgentCommunication(_)
+            | RolloutItem::Compacted(_)
+            | RolloutItem::InterAgentCommunicationMetadata { .. }
+            | RolloutItem::TokenUsageRecord(_)
+            | RolloutItem::WorldState(_)
+            | RolloutItem::SecurityRiskScore(_)
+            | RolloutItem::EventMsg(_)
+            | RolloutItem::RealtimeItem(_) => {}
+        }
+    }
+
+    fn mark_completed(&mut self, turn_id: &str) {
+        // Apply completion once when materializing the transcript. Rewalking
+        // every earlier item for each completed turn is quadratic on long tasks.
+        self.completed_turns.insert(turn_id.to_string());
+    }
+
+    /// Marks the current segment's newest user message as the start of a user turn. The event
+    /// follows its item; when the segment has no user message yet, the next one is marked.
+    fn mark_user_message(&mut self) {
+        let segment = self.current_segment();
+        segment.counts_as_user_turn = true;
+        let newest_user_message = segment
+            .entries
+            .iter_mut()
+            .rev()
+            .find_map(|entry| match entry {
+                TranscriptEntry::Item {
+                    item, user_turn, ..
+                } if is_user_message(&item.item.item) => Some(user_turn),
+                TranscriptEntry::Item { .. } | TranscriptEntry::Checkpoint { .. } => None,
+            });
+        match newest_user_message {
+            Some(user_turn) => *user_turn = true,
+            None => self.pending_user_message = true,
+        }
+    }
+
+    /// Returns the valid transcript. Checkpoints whose covered items were removed are dropped.
+    pub fn finish(self) -> ModelTranscript {
+        let mut items: Vec<TranscriptItem> = Vec::new();
+        let mut checkpoints = Vec::new();
+        let mut rejected_checkpoints = 0;
+        // Kept items and their files by ID. An ID only finds copy candidates: providers may reuse
+        // IDs, so only an identical item from an earlier file counts as a copy.
+        let mut seen_item_ids: HashMap<String, Vec<(u32, usize)>> = HashMap::new();
+        // Items that kept checkpoints stand for: their replacement history and, for an inherited
+        // checkpoint, the history it covers in the other thread.
+        let mut checkpoint_item_ids = HashSet::new();
+        for entry in self
+            .segments
+            .into_iter()
+            .flat_map(|segment| segment.entries)
+        {
+            match entry {
+                TranscriptEntry::Item {
+                    mut item, source, ..
+                } => {
+                    item.completed |= item
+                        .turn_id
+                        .as_ref()
+                        .is_some_and(|id| self.completed_turns.contains(id));
+                    if let Some(id) = item.item.item.id() {
+                        let same_id = seen_item_ids.entry(id.to_string()).or_default();
+                        if same_id.iter().any(|(kept_source, index)| {
+                            *kept_source < source && items[*index].item.item == item.item.item
+                        }) {
+                            continue;
+                        }
+                        same_id.push((source, items.len()));
+                    }
+                    items.push(item);
+                }
+                TranscriptEntry::Checkpoint {
+                    position,
+                    compacted,
+                    producer,
+                    inherited,
+                } => {
+                    let through_item_id = compacted
+                        .portable
+                        .as_ref()
+                        .and_then(|portable| portable.covers.through_item_id.as_deref());
+                    // An inherited checkpoint covers items of another thread, which this one
+                    // cannot check.
+                    let covers_valid_items = inherited
+                        || through_item_id.is_none_or(|id| {
+                            seen_item_ids.contains_key(id) || checkpoint_item_ids.contains(id)
+                        });
+                    if !covers_valid_items {
+                        rejected_checkpoints += 1;
+                        continue;
+                    }
+                    if inherited {
+                        checkpoint_item_ids.extend(through_item_id.map(ToString::to_string));
+                    }
+                    checkpoint_item_ids.extend(
+                        compacted
+                            .replacement_history
+                            .iter()
+                            .flatten()
+                            .filter_map(|envelope| envelope.item.id().map(ToString::to_string)),
+                    );
+                    checkpoints.push(TranscriptCheckpoint {
+                        position,
+                        items_before: items.len(),
+                        compacted: *compacted,
+                        producer,
+                    });
+                }
+            }
+        }
+        ModelTranscript {
+            items,
+            checkpoints,
+            completeness: match self.incomplete {
+                Some(reason) => TranscriptCompleteness::Incomplete { reason },
+                None => TranscriptCompleteness::Complete,
+            },
+            rejected_checkpoints,
+            producers: self.producers,
+        }
+    }
+
+    fn current_segment(&mut self) -> &mut TurnSegment {
+        if self.segments.is_empty() {
+            self.segments.push(TurnSegment::default());
+        }
+        let last = self.segments.len() - 1;
+        &mut self.segments[last]
+    }
+
+    fn push_checkpoint(&mut self, position: u64, mut compacted: CompactedItem) {
+        if let Some(portable) = compacted.portable.as_mut() {
+            portable.covers.position = Some(position);
+        }
+        self.remove_compaction_output(&compacted);
+        let inherited = !self.saw_model_visible_record;
+        if inherited
+            && compacted
+                .replacement_history
+                .as_ref()
+                .is_some_and(|items| items.iter().any(replaces_history))
+        {
+            self.mark_incomplete(
+                "history before this thread's first compaction checkpoint is stored elsewhere",
+            );
+        }
+        self.saw_model_visible_record = true;
+        let producer = self.current_producer;
+        self.current_segment()
+            .entries
+            .push(TranscriptEntry::Checkpoint {
+                position,
+                compacted: Box::new(compacted),
+                producer,
+                inherited,
+            });
+    }
+
+    /// Drops items recorded by the compaction request itself.
+    ///
+    /// Only the trailing records the checkpoint counts as its own output are dropped, and only
+    /// while they are model output: tool outputs and messages the model did not write are never
+    /// removed.
+    fn remove_compaction_output(&mut self, compacted: &CompactedItem) {
+        match compacted
+            .portable
+            .as_ref()
+            .and_then(|portable| portable.covers.output_items)
+        {
+            Some(output_items) => self.remove_trailing_model_output(output_items),
+            // Checkpoints written before their output was counted keep the summary text in
+            // `message`, and local compaction recorded the same text as the preceding assistant
+            // message. Remote compaction leaves `message` empty, so nothing is removed for it.
+            None => self.remove_trailing_summary(&compacted.message),
+        }
+    }
+
+    fn remove_trailing_model_output(&mut self, output_items: u32) {
+        let Some(segment) = self.segments.last_mut() else {
+            return;
+        };
+        for _ in 0..output_items {
+            match segment.entries.last() {
+                Some(TranscriptEntry::Item { item, .. }) if is_model_output(&item.item.item) => {
+                    segment.entries.pop();
+                }
+                Some(TranscriptEntry::Item { .. } | TranscriptEntry::Checkpoint { .. }) | None => {
+                    return;
+                }
+            }
+        }
+    }
+
+    fn remove_trailing_summary(&mut self, message: &str) {
+        if message.is_empty() {
+            return;
+        }
+        let Some(segment) = self.segments.last_mut() else {
+            return;
+        };
+        let Some(TranscriptEntry::Item { item: last, .. }) = segment.entries.last() else {
+            return;
+        };
+        let Some(text) = assistant_output_text(&last.item.item) else {
+            return;
+        };
+        if text.is_empty() || !message.ends_with(text.as_str()) {
+            return;
+        }
+        let turn_id = last.item.item.turn_id().map(ToString::to_string);
+        segment.entries.pop();
+        while let Some(TranscriptEntry::Item { item: previous, .. }) = segment.entries.last()
+            && matches!(previous.item.item, ResponseItem::Reasoning { .. })
+            && previous.item.item.turn_id() == turn_id.as_deref()
+        {
+            segment.entries.pop();
+        }
+    }
+
+    /// Drops the newest `num_turns` user turns and every record after them.
+    fn roll_back(&mut self, num_turns: u32) {
+        for _ in 0..num_turns {
+            let Some(index) = self
+                .segments
+                .iter()
+                .rposition(|segment| segment.counts_as_user_turn)
+            else {
+                return;
+            };
+            if self.segments[index].started_by_turn {
+                self.segments.truncate(index);
+                continue;
+            }
+            // Records without turn markers, such as a copied fork prefix or an old rollout: drop
+            // from the newest user message onward, as replay's `drop_last_n_user_turns` does.
+            let Some((segment_index, entry_index)) = self
+                .segments
+                .iter()
+                .enumerate()
+                .rev()
+                .find_map(|(segment_index, segment)| {
+                    segment
+                        .entries
+                        .iter()
+                        .rposition(|entry| {
+                            matches!(
+                                entry,
+                                TranscriptEntry::Item {
+                                    user_turn: true,
+                                    ..
+                                }
+                            )
+                        })
+                        .map(|entry_index| (segment_index, entry_index))
+                })
+            else {
+                return;
+            };
+            self.segments.truncate(segment_index + 1);
+            let segment = &mut self.segments[segment_index];
+            segment.entries.truncate(entry_index);
+            segment.counts_as_user_turn = segment.entries.iter().any(|entry| {
+                matches!(
+                    entry,
+                    TranscriptEntry::Item {
+                        user_turn: true,
+                        ..
+                    }
+                )
+            });
+        }
+    }
+}
+
+/// Whether an item is a message the user typed. Context the harness injects as user messages is
+/// told apart by the user-message event that follows a real one.
+fn is_user_message(item: &ResponseItem) -> bool {
+    matches!(item, ResponseItem::Message { role, .. } if role == "user")
+}
+
+/// Whether the model wrote an item, as opposed to input it was given.
+fn is_model_output(item: &ResponseItem) -> bool {
+    match item {
+        ResponseItem::Message { role, .. } => role == "assistant",
+        ResponseItem::Reasoning { .. }
+        | ResponseItem::FunctionCall { .. }
+        | ResponseItem::CustomToolCall { .. }
+        | ResponseItem::LocalShellCall { .. }
+        | ResponseItem::ToolSearchCall { .. }
+        | ResponseItem::WebSearchCall { .. }
+        | ResponseItem::ImageGenerationCall { .. }
+        | ResponseItem::Compaction { .. }
+        | ResponseItem::ContextCompaction { .. } => true,
+        ResponseItem::AdditionalTools { .. }
+        | ResponseItem::AgentMessage { .. }
+        | ResponseItem::FunctionCallOutput { .. }
+        | ResponseItem::CustomToolCallOutput { .. }
+        | ResponseItem::ToolSearchOutput { .. }
+        | ResponseItem::CompactionTrigger { .. }
+        | ResponseItem::Other => false,
+    }
+}
+
+/// Whether a replacement-history item stands in for history recorded before the checkpoint.
+fn replaces_history(envelope: &ResponseItemEnvelope) -> bool {
+    matches!(
+        &envelope.item,
+        ResponseItem::Compaction { .. } | ResponseItem::ContextCompaction { .. }
+    ) || matches!(&envelope.item, ResponseItem::Message { role, .. } if role == "user" || role == "assistant")
+}
+
+fn assistant_output_text(item: &ResponseItem) -> Option<String> {
+    let ResponseItem::Message { role, content, .. } = item else {
+        return None;
+    };
+    if role != "assistant" {
+        return None;
+    }
+    Some(
+        content
+            .iter()
+            .filter_map(|content| match content {
+                ContentItem::OutputText { text } => Some(text.as_str()),
+                ContentItem::InputText { .. }
+                | ContentItem::InputImage { .. }
+                | ContentItem::InputAudio { .. } => None,
+            })
+            .collect::<String>(),
+    )
+}
+
+/// Feeds one rollout file forward into `builder`.
+///
+/// Records with an ordinal at or past `end_ordinal_exclusive` are not read, which applies a
+/// paginated lineage segment's `history_base` cutoff. Records without an ordinal (legacy
+/// rollouts) use their record index as their position.
+pub async fn read_model_transcript_segment(
+    path: &Path,
+    end_ordinal_exclusive: Option<u64>,
+    builder: &mut ModelTranscriptBuilder,
+) -> io::Result<()> {
+    let mut reader = crate::compression::open_rollout_line_reader(path).await?;
+    builder.begin_source();
+    let mut record_index = 0_u64;
+    while let Some(line) = reader.next_line().await? {
+        if line.trim().is_empty() {
+            continue;
+        }
+        let index = record_index;
+        record_index = record_index.saturating_add(1);
+        let Ok(mut value) = serde_json::from_str::<Value>(&line) else {
+            continue;
+        };
+        if crate::recorder::strip_legacy_ghost_snapshot_rollout_line(&mut value) {
+            continue;
+        }
+        let Ok(rollout_line) = crate::decode_rollout_line(value) else {
+            continue;
+        };
+        if let (Some(end), Some(ordinal)) = (end_ordinal_exclusive, rollout_line.ordinal)
+            && ordinal >= end
+        {
+            break;
+        }
+        builder.push(rollout_line.ordinal.unwrap_or(index), rollout_line.item);
+    }
+    Ok(())
+}
