+++ b/codex-rs/core/src/portable_context.rs
@@ -0,0 +1,770 @@
+//! Carries a thread's model context across provider families.
+//!
+//! Providers in one family can read each other's opaque state, such as encrypted compaction and
+//! reasoning. OpenAI and Azure Responses providers form the OpenAI family; every other provider is
+//! its own family, keyed by its configured id. Opaque state made by one family is useless to
+//! another: sending it fails the request or silently drops the history it stands for.
+//!
+//! Compaction and encrypted reasoning belong to the provider of the turn that recorded them. Each
+//! recorded turn names its provider; turns recorded before providers were tracked are attributed
+//! to their session's provider or by their model. Encrypted inter-agent messages and tool outputs
+//! always belong to the OpenAI family. Another family gets an item without its opaque state:
+//! reasoning keeps its plaintext summary or content, and encrypted parts become placeholders.
+//!
+//! When a thread resumes on a family other than the one that produced its current history, or its
+//! replay would send another family's opaque state, [`build_context`] rebuilds the model context
+//! from the thread's complete transcript, in this order:
+//!
+//! 1. the target family's own newest checkpoint plus every valid item after it;
+//! 2. the full transcript, when it fits the target's budget;
+//! 3. the newest valid portable (plaintext) checkpoint plus the items after it, preceded by the
+//!    user messages before it;
+//! 4. that summary with the user messages of left-out turns, each before or after it as
+//!    recorded, then a note on what was left out and the newest turns after it that fit, or the
+//!    newest items of a turn too large to keep whole;
+//! 5. the same without any summary, after a note that older context is missing.
+//!
+//! Kept user messages are capped at 20k tokens, newest first, as in local compaction.
+//!
+//! Recorded copies of the context bundle (permissions, AGENTS.md, environment, skills) are left
+//! out: as after compaction, the next turn reinjects one current copy.
+//!
+//! The transcript starts at the newest new context window, whose checkpoint deliberately left
+//! earlier history behind, or else at a first checkpoint inherited from a parent thread. Either
+//! checkpoint's readable replacement items (plaintext messages, and its portable summary in place
+//! of native compaction) start the transcript.
+//!
+//! The first turn that uses a rebuilt context records it as a [`CheckpointKind::Rebuilt`]
+//! checkpoint of the target family. Later resumes on that family replay from it instead of
+//! rebuilding again or replaying superseded context bundles and model-switch messages. The
+//! checkpoint summarizes nothing, so other families keep reading the history before it. When the
+//! context started from the family's own checkpoint (step 1), it carries that checkpoint's
+//! portable summary, which only a thread inheriting it as its first checkpoint uses.
+//!
+//! Before any of these steps, a family that served the thread before tries to take it back from
+//! the context it last sent, so its provider's prompt cache still serves it ([`splice_context`]).
+//! The checkpoint recording a rebuilt or spliced context records that anchor for the family it
+//! took the thread from.
+
+use codex_api::is_azure_responses_provider;
+use codex_history::CheckpointKind;
+use codex_history::CompactedItem;
+use codex_history::CompactionOrigin;
+use codex_history::PortableCheckpoint;
+use codex_history::PortableCheckpointStatus;
+use codex_history::PortableCoverage;
+use codex_history::PortableSummaryUsage;
+use codex_history::RolloutItem;
+use codex_model_provider_info::ModelProviderInfo;
+use codex_model_provider_info::OPENAI_PROVIDER_ID;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::MessagePhase;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ServedBy;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::TokenUsage;
+use codex_rollout::ModelTranscript;
+use codex_rollout::ModelTranscriptBuilder;
+use codex_rollout::SessionProviderHint;
+use codex_rollout::TranscriptProducer;
+use codex_rollout_trace::InferenceTraceContext;
+use futures::StreamExt;
+use std::future::Future;
+use std::time::Duration;
+use tokio::time::Instant;
+
+use crate::Prompt;
+use crate::client::ModelClientSession;
+use crate::client_common::ResponseEvent;
+use crate::compact::SUMMARIZATION_PROMPT;
+use crate::compact_remote_v2::compaction_request_settings;
+use crate::config::Config;
+use crate::responses_metadata::CodexResponsesMetadata;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::session::turn_context::TurnContext;
+
+mod agent_summary;
+mod budget;
+mod foreign_state;
+mod rebuild;
+mod splice;
+
+pub(crate) use agent_summary::apply_verified_summary;
+pub(crate) use agent_summary::has_agent_summary;
+pub(crate) use budget::RebuildBudget;
+pub(crate) use budget::rebuild_token_count;
+pub(crate) use budget::text_token_count;
+pub(crate) use foreign_state::ENCRYPTED_MESSAGE_PLACEHOLDER;
+pub(crate) use foreign_state::replace_encrypted_tool_output;
+pub(crate) use rebuild::PortableContextSource;
