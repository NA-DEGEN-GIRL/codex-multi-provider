+use super::*;
+use pretty_assertions::assert_eq;
+
+fn runner(script: &str) -> AgentProviderInfo {
+    serde_json::from_value(json!({
+        "kind":"claude_code", "command":if cfg!(windows) {"python"} else {"python3"},
+        "args":["-u","-c",script], "profile_id":"fake-profile"
+    }))
+    .expect("agent fixture")
+}
+
+fn credentials() -> Value {
+    json!({"profileId":"fake-profile","accessToken":"dummy-token-1","expiresAt":2_000_000_000,
+        "accountIdentity":"fixture-identity"})
+}
+
+/// Reports what the runner received; the dummy token is echoed only inside this test.
+const STDIN_RUNNER: &str = r#"
+import json, os, sys
+assert os.environ.pop('CODEX_MANAGER_CLAUDE_AUTH_CHANNEL') == 'stdin'
+print(json.dumps({'type':'auth_channel','protocol':1}), flush=True)
+init = json.loads(sys.stdin.readline())
+print(json.dumps({'type':'seen','init':init,'environment':'CODEX_MANAGER_CLAUDE_AUTH' in os.environ}), flush=True)
+"#;
+
+/// A helper prepared before the stdin channel: it reads only its environment.
+const ENVIRONMENT_RUNNER: &str = r#"
+import json, os, sys
+raw = os.environ.pop('CODEX_MANAGER_CLAUDE_AUTH', '')
+if not raw:
+    print(json.dumps({'type':'refused','code':'remote_claude_unavailable','message':'unavailable'}), flush=True)
+    sys.exit(1)
+print(json.dumps({'type':'seen','credentials':json.loads(raw),
+    'channel':os.environ.get('CODEX_MANAGER_CLAUDE_AUTH_CHANNEL')}), flush=True)
+"#;
+
+#[tokio::test]
+async fn a_lent_credential_reaches_the_runner_over_stdin_only() {
+    let cwd = tempfile::tempdir().expect("cwd");
+    let mut bridge = Bridge::start(&runner(STDIN_RUNNER), cwd.path(), Some(&credentials()))
+        .await
+        .expect("start");
+    let seen = bridge.receive().await.expect("receive");
+    assert_eq!(
+        seen,
+        json!({"type":"seen","init":{"type":"auth_init","credentials":credentials()},"environment":false})
+    );
+}
+
+#[tokio::test]
+async fn a_helper_without_the_stdin_channel_is_started_again_with_its_environment_credential() {
+    let cwd = tempfile::tempdir().expect("cwd");
+    let mut bridge = Bridge::start(
+        &runner(ENVIRONMENT_RUNNER),
+        cwd.path(),
+        Some(&credentials()),
+    )
+    .await
+    .expect("start");
+    let seen = bridge.receive().await.expect("receive");
+    assert_eq!(
+        seen,
+        json!({"type":"seen","credentials":credentials(),"channel":null})
+    );
+}
+
+#[tokio::test]
+async fn a_turn_without_a_lent_credential_never_asks_for_a_channel() {
+    let cwd = tempfile::tempdir().expect("cwd");
+    let script = r#"
+import json, os
+print(json.dumps({'type':'seen','channel':os.environ.get('CODEX_MANAGER_CLAUDE_AUTH_CHANNEL'),
+    'credentials':os.environ.get('CODEX_MANAGER_CLAUDE_AUTH')}), flush=True)
+"#;
+    let mut bridge = Bridge::start(&runner(script), cwd.path(), None)
+        .await
+        .expect("start");
+    let seen = bridge.receive().await.expect("receive");
+    assert_eq!(
+        seen,
+        json!({"type":"seen","channel":null,"credentials":null})
+    );
+}
+
+#[tokio::test]
+async fn a_cancelled_receive_keeps_the_partial_line_for_the_next_one() {
+    let cwd = tempfile::tempdir().expect("cwd");
+    let script = r#"
+import sys, time
+sys.stdout.write('{"type":"ev'); sys.stdout.flush()
+time.sleep(1.5)
+sys.stdout.write('ent","n":1}\n{"type":"done"}\n'); sys.stdout.flush()
+"#;
+    let mut bridge = Bridge::start(&runner(script), cwd.path(), None)
+        .await
+        .expect("start");
+    let cancelled = tokio::time::timeout(Duration::from_millis(500), bridge.receive()).await;
+    assert!(
+        cancelled.is_err(),
+        "the first read must still wait for its newline"
+    );
+    let mut received = Vec::new();
+    for _ in 0..2 {
+        received.push(bridge.receive().await.expect("receive"));
+    }
+    assert_eq!(
+        received,
+        vec![json!({"type":"event","n":1}), json!({"type":"done"})]
+    );
+}
