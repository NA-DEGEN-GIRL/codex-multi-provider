@@ -0,0 +1,74 @@
+//! Explicit read-only access to shared rollouts, keeping databases in their index home.
+
+use std::path::PathBuf;
+
+use codex_protocol::ThreadId;
+use codex_state::ReadOnlyThreadState;
+use codex_state::SqliteConfig;
+use tokio::sync::OnceCell;
+
+use super::ReadOnlyLocalThreadStore;
+use super::incomplete;
+use super::invalid;
+use super::validate_database_path;
+use crate::ThreadStoreResult;
+
+impl ReadOnlyLocalThreadStore {
+    /// Opens an existing index with additional, explicitly authorized canonical
+    /// homes for shared session files. Databases remain confined to `codex_home`.
+    /// Callers authorize these homes; this reader validates paths, identities and
+    /// durable history checkpoints without creating or repairing source state.
+    pub async fn open_with_registered_rollout_homes(
+        codex_home: PathBuf,
+        sqlite: SqliteConfig,
+        registered_homes: Vec<PathBuf>,
+    ) -> ThreadStoreResult<Self> {
+        let codex_home = std::fs::canonicalize(codex_home).map_err(incomplete)?;
+        if std::fs::canonicalize(sqlite.home()).map_err(incomplete)? != codex_home {
+            return Err(invalid(
+                "source SQLite root is outside the registered source home",
+            ));
+        }
+        let mut rollout_homes = vec![codex_home.clone()];
+        for home in registered_homes {
+            if std::fs::canonicalize(&home).map_err(incomplete)? != home || !home.is_dir() {
+                return Err(invalid("registered rollout home changed"));
+            }
+            rollout_homes.push(home);
+        }
+        rollout_homes.sort();
+        rollout_homes.dedup();
+        validate_database_path(&codex_home, &sqlite.state_db_path())?;
+        let state = ReadOnlyThreadState::open(&sqlite)
+            .await
+            .map_err(incomplete)?;
+        Ok(Self {
+            codex_home,
+            sqlite,
+            state,
+            history: OnceCell::new(),
+            rollout_homes,
+            derived_history: None,
+        })
+    }
+
+    pub(super) async fn registered_ancestor(&self, id: ThreadId) -> ThreadStoreResult<PathBuf> {
+        let mut found = None;
+        for home in &self.rollout_homes {
+            let Some(path) = codex_rollout::find_rollout_path_by_rollout_id(home, id)
+                .await
+                .map_err(incomplete)?
+            else {
+                continue;
+            };
+            let path = self.rollout_path(&path).await?;
+            if found.as_ref().is_some_and(|previous| previous != &path) {
+                return Err(incomplete(
+                    "source lineage ancestor has ambiguous registered paths",
+                ));
+            }
+            found = Some(path);
+        }
+        found.ok_or_else(|| incomplete("source lineage ancestor is missing"))
+    }
+}
