+++ b/codex-rs/app-server/src/managed_request_gate_tests.rs
@@ -0,0 +1,74 @@
+use super::*;
+
+#[test]
+fn drain_waits_for_inflight_request_and_does_not_block_another_thread() {
+    let gate = ManagedRequestGate::default();
+    let first = ThreadId::new();
+    let second = ThreadId::new();
+    let permit = gate.begin_threads(vec![first]).unwrap();
+    assert!(gate.try_drain(&[first]).is_err());
+    drop(permit);
+    let drain = gate.try_drain(&[first]).unwrap();
+    assert!(gate.begin_threads(vec![first]).is_err());
+    assert!(gate.begin_threads(vec![second]).is_ok());
+    drain.commit();
+    assert!(gate.begin_threads(vec![first]).is_err());
+    assert!(gate.begin_threads(vec![second]).is_ok());
+}
+
+#[test]
+fn unsuccessful_preflight_releases_all_subtree_guards() {
+    let gate = ManagedRequestGate::default();
+    let parent = ThreadId::new();
+    let child = ThreadId::new();
+    let permit = gate.begin_threads(vec![child]).unwrap();
+    assert!(gate.try_drain(&[parent, child]).is_err());
+    assert!(gate.begin_threads(vec![parent]).is_ok());
+    drop(permit);
+    drop(gate.try_drain(&[parent, child]).unwrap());
+    assert!(gate.begin_threads(vec![parent, child]).is_ok());
+}
+
+#[test]
+fn cancelling_an_armed_drain_keeps_admission_closed() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+    let mut drain = gate.try_drain(&[id]).unwrap();
+    drain.arm();
+    drop(drain);
+    assert!(gate.begin_threads(vec![id]).is_err());
+}
+
+#[test]
+fn explicit_idle_rejection_can_reopen_an_armed_drain() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+    let mut drain = gate.try_drain(&[id]).unwrap();
+    drain.arm();
+    drain.release_after_rejected_close();
+    assert!(gate.begin_threads(vec![id]).is_ok());
+}
+
+#[test]
+fn rejected_retry_preserves_an_earlier_unverified_fence() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+    let mut first = gate.try_drain(&[id]).unwrap();
+    first.arm();
+    drop(first);
+    let mut retry = gate.try_drain(&[id]).unwrap();
+    retry.arm();
+    retry.release_after_rejected_close();
+    assert!(gate.begin_threads(vec![id]).is_err());
+    assert!(!gate.locks(&[id])[0].try_read().unwrap().release_verified);
+}
+
+#[test]
+fn verified_maintenance_close_preserves_the_same_owner_admission() {
+    let gate = ManagedRequestGate::default();
+    let id = ThreadId::new();
+    let mut drain = gate.try_drain(&[id]).unwrap();
+    drain.arm();
+    drain.release_after_verified_maintenance();
+    assert!(gate.begin_threads(vec![id]).is_ok());
+}
diff --git a/codex-rs/app-server/src/managed_sources.rs b/codex-rs/app-server/src/managed_sources.rs
new file mode 100644
index 000000000..c0b2227bc
--- /dev/null
+++ b/codex-rs/app-server/src/managed_sources.rs
@@ -0,0 +1,522 @@
+//! Persistence-only routing from a manager-owned, same-host source allowlist.
+//! Authentication and runtime configuration are never loaded from a source home.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_core::ThreadManager;
+use codex_protocol::ThreadId;
+use codex_thread_store::LocalThreadStoreConfig;
+use codex_thread_store::ManagedAuthorityGrant;
+use codex_thread_store::ManagedSourceId;
+use codex_thread_store::ManagedSourceRegistration;
+use codex_thread_store::ManagedSourceRegistry;
+use codex_thread_store::ManagedThreadBinding;
+use codex_thread_store::ThreadStore;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use serde::Deserialize;
+use tokio::sync::Mutex;
+
+use crate::error_code::invalid_request;
+
+const SOURCES_ENV: &str = "CODEX_MANAGER_MANAGED_SOURCES";
+const MAX_MANIFEST_BYTES: usize = 4 * 1024 * 1024;
+const MAX_SOURCES: usize = 256;
+const MAX_BINDINGS: usize = 4096;
+const MAX_AUTHORITY_COUNTER: u64 = (1_u64 << 53) - 1;
+
+struct CachedSources {
+    path: PathBuf,
+    bytes: Vec<u8>,
+    sources: Arc<ManagedSources>,
+}
+
+static SOURCES_CACHE: Mutex<Option<CachedSources>> = Mutex::const_new(None);
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct SourceManifest {
+    version: u32,
+    host_id: String,
+    profile_id: String,
+    sources: Vec<SourceRegistration>,
+    bindings: Vec<SourceBinding>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct SourceRegistration {
+    host_id: String,
+    source_store_id: String,
+    codex_home: PathBuf,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct SourceBinding {
+    thread_id: ThreadId,
+    host_id: String,
+    source_store_id: String,
+    owner_profile_id: String,
+    ownership_epoch: u64,
+    record_revision: u64,
+}
+
+// Foreign-owner grants preserve a canonical read reference. Only a grant owned
+// by this process's profile can be admitted for a writer or activation.
+struct DeclaredBinding {
+    source_id: ManagedSourceId,
+    grant: ManagedAuthorityGrant,
+}
+
+struct ManagedSources {
+    registry: ManagedSourceRegistry,
+    profile_id: String,
+    bindings: HashMap<ThreadId, DeclaredBinding>,
+    homes: HashMap<PathBuf, ManagedSourceId>,
+    configs: HashMap<ManagedSourceId, LocalThreadStoreConfig>,
+}
+
+pub(crate) fn is_enabled() -> bool {
+    std::env::var_os(SOURCES_ENV).is_some()
+}
+
+/// Inspect the allowlist without opening a source database or acquiring a writer.
+pub(crate) async fn declared_binding(thread_id: ThreadId) -> Result<bool, JSONRPCErrorError> {
+    Ok(ManagedSources::from_environment()
+        .await?
+        .is_some_and(|sources| sources.bindings.contains_key(&thread_id)))
+}
+
+/// Open a view without acquiring authority, creating SQLite state, repairing
+/// indexes, or flushing a retained actor after it has handed off ownership.
+pub(crate) async fn read_store_for_thread(
+    thread_manager: &ThreadManager,
+    fallback: &Arc<dyn ThreadStore>,
+    thread_id: ThreadId,
+) -> Result<Arc<dyn ThreadStore>, JSONRPCErrorError> {
+    let Some(config) = read_config_for_thread(thread_manager, thread_id).await? else {
+        return Ok(Arc::clone(fallback));
+    };
+    crate::managed_read_store::open(config, thread_id)
+        .await
+        .map_err(|error| invalid_request(format!("cannot open canonical record view: {error}")))
+}
+
+/// Resolve a canonical read reference independently of its current write owner.
+/// Ordinary profiles and loaded ephemeral actors have no managed source view.
+pub(crate) async fn read_config_for_thread(
+    thread_manager: &ThreadManager,
+    thread_id: ThreadId,
+) -> Result<Option<LocalThreadStoreConfig>, JSONRPCErrorError> {
+    let (source_id, config) =
+        if let Some(binding) = thread_manager.managed_record_binding(thread_id).await {
+            (binding.source_id().clone(), binding.source_config().clone())
+        } else {
+            let Some(sources) = ManagedSources::from_environment().await? else {
+                return Ok(None);
+            };
+            if let Ok(thread) = thread_manager.get_thread(thread_id).await
+                && thread.config_snapshot().await.ephemeral
+            {
+                // Ephemeral actors have no canonical persistence to federate. Their
+                // existing native snapshot path rejects history hydration itself.
+                return Ok(None);
+            }
+            let source_id = if let Some(binding) = sources.bindings.get(&thread_id) {
+                binding.source_id.clone()
+            } else {
+                sources
+                    .configs
+                    .keys()
+                    .find(|source| source.store_id == format!("manager:{}", sources.profile_id))
+                    .cloned()
+                    .ok_or_else(|| {
+                        invalid_request("profile has no registered source for this record view")
+                    })?
+            };
+            let config = sources
+                .configs
+                .get(&source_id)
+                .ok_or_else(|| invalid_request("record view source is not registered"))?
+                .clone();
+            (source_id, config)
+        };
+    validate_read_source_identity(&source_id, &config).await?;
+    Ok(Some(config))
+}
+
+/// Select the profile's own canonical source for native list operations. Each
+/// listed record may have a different current owner, so this grants only a view.
+pub(crate) async fn read_config_for_profile(
+    codex_home: &std::path::Path,
+) -> Result<Option<LocalThreadStoreConfig>, JSONRPCErrorError> {
+    let Some(sources) = ManagedSources::from_environment().await? else {
+        return Ok(None);
+    };
+    let home = tokio::fs::canonicalize(codex_home)
+        .await
+        .map_err(|error| invalid_request(format!("managed profile home unavailable: {error}")))?;
+    let source_id = sources
+        .homes
+        .get(&home)
+        .ok_or_else(|| invalid_request("profile home is not a registered managed source"))?;
+    if source_id.store_id != format!("manager:{}", sources.profile_id) {
+        return Err(invalid_request(
+            "profile home does not belong to the manifest profile identity",
+        ));
+    }
+    let config = sources
+        .configs
+        .get(source_id)
+        .ok_or_else(|| invalid_request("profile record view source is not registered"))?
+        .clone();
+    validate_read_source_identity(source_id, &config).await?;
+    Ok(Some(config))
+}
+
+async fn validate_read_source_identity(
+    source_id: &ManagedSourceId,
+    config: &LocalThreadStoreConfig,
+) -> Result<(), JSONRPCErrorError> {
+    let home = tokio::fs::canonicalize(&config.codex_home)
+        .await
+        .map_err(|error| invalid_request(format!("record view source unavailable: {error}")))?;
+    if home != config.codex_home {
+        return Err(invalid_request("record view source home changed"));
+    }
+    let marker_path = home.join("managed-source.json");
+    let metadata = tokio::fs::metadata(&marker_path).await.map_err(|error| {
+        invalid_request(format!("record view source marker unavailable: {error}"))
+    })?;
+    if !metadata.is_file() || metadata.len() > 4096 {
+        return Err(invalid_request("record view source marker is invalid"));
+    }
+    let bytes = tokio::fs::read(marker_path).await.map_err(|error| {
+        invalid_request(format!("record view source marker unavailable: {error}"))
+    })?;
+    if bytes.len() > 4096 {
+        return Err(invalid_request(
+            "record view source marker exceeds 4096 bytes",
+        ));
+    }
+    let actual: ManagedSourceId = serde_json::from_slice(&bytes)
+        .map_err(|error| invalid_request(format!("invalid record view source marker: {error}")))?;
+    if actual != *source_id {
+        return Err(invalid_request(
+            "record view source marker identity changed",
+        ));
+    }
+    Ok(())
+}
+
+/// New native threads in an opted-in profile bind its already registered home.
+/// This never enrolls or marks an unregistered original profile directory.
+pub(crate) async fn binding_for_new_thread(
+    codex_home: &std::path::Path,
+    thread_id: ThreadId,
+) -> Result<Option<ManagedThreadBinding>, JSONRPCErrorError> {
+    let Some(sources) = ManagedSources::from_environment().await? else {
+        return Ok(None);
+    };
+    let home = tokio::fs::canonicalize(codex_home)
+        .await
+        .map_err(|error| invalid_request(format!("managed profile home unavailable: {error}")))?;
+    let source_id = sources
+        .homes
+        .get(&home)
+        .ok_or_else(|| invalid_request("profile home is not a registered managed source"))?;
+    if source_id.store_id != format!("manager:{}", sources.profile_id) {
+        return Err(invalid_request(
+            "profile home does not belong to the manifest profile identity",
+        ));
+    }
+    sources
+        .registry
+        .bind_new(source_id, thread_id)
+        .await
+        .map(Some)
+        .map_err(|error| invalid_request(format!("cannot bind managed profile source: {error}")))
+}
+
+/// Check the process's actual configuration home against its immutable profile UUID.
+pub(crate) async fn validate_profile_home(
+    codex_home: &std::path::Path,
+) -> Result<(), JSONRPCErrorError> {
+    let Some(sources) = ManagedSources::from_environment().await? else {
+        return Ok(());
+    };
+    let home = tokio::fs::canonicalize(codex_home)
+        .await
+        .map_err(|error| invalid_request(format!("managed profile home unavailable: {error}")))?;
+    let source = sources
+        .homes
+        .get(&home)
+        .ok_or_else(|| invalid_request("profile home is not a registered managed source"))?;
+    if source.store_id != format!("manager:{}", sources.profile_id) {
+        return Err(invalid_request(
+            "profile home does not belong to the manifest profile identity",
+        ));
+    }
+    Ok(())
+}
+
+/// Resolve a fresh source-authorized binding without granting request admission
+/// or proving actors absent. The caller must fence the exact subtree and verify
+/// Core has no loaded or starting actor before opening its admission gate.
+pub(crate) async fn fresh_binding_for_activation(
+    thread_id: ThreadId,
+    source_id: &ManagedSourceId,
+    grant: &ManagedAuthorityGrant,
+) -> Result<ManagedThreadBinding, JSONRPCErrorError> {
+    let sources = ManagedSources::from_environment()
+        .await?
+        .ok_or_else(|| invalid_request("managed source routing is disabled"))?;
+    let declared = sources
+        .bindings
+        .get(&thread_id)
+        .ok_or_else(|| invalid_request("activation requires a declared managed thread binding"))?;
+    if &declared.source_id != source_id
+        || grant.owner_profile_id != sources.profile_id
+        || declared.grant.owner_profile_id != grant.owner_profile_id
+        || declared.grant.epoch != grant.epoch
+        || declared.grant.revision != grant.revision
+    {
+        return Err(invalid_request(
+            "activation grant does not match the current profile manifest",
+        ));
+    }
+    sources
+        .registry
+        .validate_owner_authority(source_id, thread_id, grant)
+        .map_err(|error| {
+            invalid_request(format!(
+                "managed owner authority rejected activation: {error}"
+            ))
+        })?;
+    sources
+        .registry
+        .bind(source_id, thread_id, grant.clone())
+        .await
+        .map_err(|error| invalid_request(format!("cannot activate managed source: {error}")))
+}
+
+/// Resolve persisted identity before selecting a writer. A live actor's binding
+/// is immutable even when the manager atomically replaces its manifest.
+pub(crate) async fn binding_for_thread(
+    thread_manager: &ThreadManager,
+    thread_id: ThreadId,
+) -> Result<Option<ManagedThreadBinding>, JSONRPCErrorError> {
+    if let Some(binding) = thread_manager.managed_record_binding(thread_id).await {
+        return Ok(Some(binding));
+    }
+    let Some(sources) = ManagedSources::from_environment().await? else {
+        return Ok(None);
+    };
+    let Some(binding) = sources.bindings.get(&thread_id) else {
+        return Ok(None);
+    };
+    if binding.grant.owner_profile_id != sources.profile_id {
+        return Err(invalid_request(
+            "this canonical record belongs to another profile and is read-only here",
+        ));
+    }
+    if thread_manager.get_thread(thread_id).await.is_ok() {
+        return Err(invalid_request(
+            "thread is already loaded without this managed source binding; close it before changing its source",
+        ));
+    }
+    sources
+        .registry
+        .bind(&binding.source_id, thread_id, binding.grant.clone())
+        .await
+        .map(Some)
+        .map_err(|error| invalid_request(format!("cannot bind managed source: {error}")))
+}
+
+impl ManagedSources {
+    async fn from_environment() -> Result<Option<Arc<Self>>, JSONRPCErrorError> {
+        let Some(path) = std::env::var_os(SOURCES_ENV) else {
+            return Ok(None);
+        };
+        let path = PathBuf::from(path);
+        if !path.is_absolute() {
+            return Err(invalid_request(
+                "managed source manifest path must be absolute",
+            ));
+        }
+        let metadata = tokio::fs::metadata(&path).await.map_err(|error| {
+            invalid_request(format!("managed source manifest unavailable: {error}"))
+        })?;
+        if !metadata.is_file() || metadata.len() > MAX_MANIFEST_BYTES as u64 {
+            return Err(invalid_request(
+                "managed source manifest must be a file of at most 4 MiB",
+            ));
+        }
+        let bytes = tokio::fs::read(&path).await.map_err(|error| {
+            invalid_request(format!("managed source manifest unavailable: {error}"))
+        })?;
+        if bytes.len() > MAX_MANIFEST_BYTES {
+            return Err(invalid_request("managed source manifest exceeds 4 MiB"));
+        }
+        let mut cache = SOURCES_CACHE.lock().await;
+        if let Some(cached) = cache.as_ref()
+            && cached.path == path
+            && cached.bytes == bytes
+        {
+            return Ok(Some(Arc::clone(&cached.sources)));
+        }
+        let sources = Arc::new(Self::parse(&bytes)?);
+        if let Some(cached) = cache.as_ref()
+            && cached.sources.profile_id != sources.profile_id
+        {
+            return Err(invalid_request(
+                "a running instance cannot change its manifest profile identity",
+            ));
+        }
+        *cache = Some(CachedSources {
+            path,
+            bytes,
+            sources: Arc::clone(&sources),
+        });
+        Ok(Some(sources))
+    }
+
+    fn parse(bytes: &[u8]) -> Result<Self, JSONRPCErrorError> {
+        let manifest: SourceManifest = serde_json::from_slice(bytes).map_err(|error| {
+            invalid_request(format!("invalid managed source manifest: {error}"))
+        })?;
+        manifest.validate()?;
+        let homes = manifest
+            .sources
+            .iter()
+            .map(|source| {
+                let home = std::fs::canonicalize(&source.codex_home).map_err(|error| {
+                    invalid_request(format!("managed source home unavailable: {error}"))
+                })?;
+                Ok((
+                    home,
+                    ManagedSourceId {
+                        host_id: source.host_id.clone(),
+                        store_id: source.source_store_id.clone(),
+                    },
+                ))
+            })
+            .collect::<Result<HashMap<_, _>, JSONRPCErrorError>>()?;
+        let bindings = manifest
+            .bindings
+            .into_iter()
+            .map(|binding| {
+                (
+                    binding.thread_id,
+                    DeclaredBinding {
+                        source_id: ManagedSourceId {
+                            host_id: binding.host_id,
+                            store_id: binding.source_store_id,
+                        },
+                        grant: ManagedAuthorityGrant {
+                            owner_profile_id: binding.owner_profile_id,
+                            epoch: binding.ownership_epoch,
+                            revision: binding.record_revision,
+                        },
+                    },
+                )
+            })
+            .collect();
+        let registrations = manifest
+            .sources
+            .into_iter()
+            .map(|source| {
+                let codex_home = std::fs::canonicalize(&source.codex_home).map_err(|error| {
+                    invalid_request(format!("managed source home unavailable: {error}"))
+                })?;
+                let sqlite_home =
+                    AbsolutePathBuf::from_absolute_path(&codex_home).map_err(|error| {
+                        invalid_request(format!("invalid managed source home: {error}"))
+                    })?;
+                Ok(ManagedSourceRegistration {
+                    source_id: ManagedSourceId {
+                        host_id: source.host_id,
+                        store_id: source.source_store_id,
+                    },
+                    config: LocalThreadStoreConfig {
+                        codex_home,
+                        sqlite: codex_state::SqliteConfig::from_sqlite_home(sqlite_home),
+                        default_model_provider_id: "openai".to_string(),
+                    },
+                })
+            })
+            .collect::<Result<Vec<_>, JSONRPCErrorError>>()?;
+        let configs = registrations
+            .iter()
+            .map(|source| (source.source_id.clone(), source.config.clone()))
+            .collect();
+        // The registry verifies every marker/root before any state DB is opened.
+        let registry = ManagedSourceRegistry::new(
+            manifest.host_id,
+            manifest.profile_id.clone(),
+            registrations,
+        )
+        .map_err(|error| {
+            invalid_request(format!("invalid managed source registration: {error}"))
+        })?;
+        Ok(Self {
+            registry,
+            profile_id: manifest.profile_id,
+            bindings,
+            homes,
+            configs,
+        })
+    }
+}
+
+impl SourceManifest {
+    fn validate(&self) -> Result<(), JSONRPCErrorError> {
+        if self.version != 1
+            || self.host_id.trim().is_empty()
+            || ThreadId::from_string(&self.profile_id).is_err()
+            || self.sources.len() > MAX_SOURCES
+            || self.bindings.len() > MAX_BINDINGS
+        {
+            return Err(invalid_request(
+                "unsupported managed source manifest version, host, or size",
+            ));
+        }
+        let mut sources = HashSet::new();
+        for source in &self.sources {
+            if source.host_id != self.host_id
+                || !source.codex_home.is_absolute()
+                || source
+                    .source_store_id
+                    .strip_prefix("manager:")
+                    .is_none_or(|id| ThreadId::from_string(id).is_err())
+                || !sources.insert((&source.host_id, &source.source_store_id))
+            {
+                return Err(invalid_request(
+                    "invalid or duplicate managed source identity",
+                ));
+            }
+        }
+        let mut threads = HashSet::new();
+        for binding in &self.bindings {
+            if !threads.insert(binding.thread_id)
+                || !sources.contains(&(&binding.host_id, &binding.source_store_id))
+                || ThreadId::from_string(&binding.owner_profile_id).is_err()
+                || !(1..=MAX_AUTHORITY_COUNTER).contains(&binding.ownership_epoch)
+                || !(1..=MAX_AUTHORITY_COUNTER).contains(&binding.record_revision)
+            {
+                return Err(invalid_request(
+                    "ambiguous or unregistered managed thread binding",
+                ));
+            }
+        }
+        Ok(())
+    }
+}
