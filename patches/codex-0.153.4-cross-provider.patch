+    let mut owner = source.start_server().await?;
+    let canonical = owner
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    complete_turn(&mut owner, &canonical.id, "Persist a record").await?;
+    let request = owner
+        .send_raw_request("thread/read", Some(json!({"threadId":canonical.id})))
+        .await?;
+    let stored: ThreadReadResponse = timeout(READ_TIMEOUT, owner.read_response(request)).await??;
+    let rollout = stored.thread.path.context("source rollout")?;
+    let bytes = fs::read(&rollout)?;
+    let mut reader = start_shared(&viewer, &catalog).await?;
+    assert!(list(&mut reader).await?.data.is_empty());
+    publish(&catalog, &[&source, &viewer])?;
+    let notification = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_notification_message("thread/started"),
+    )
+    .await??;
+    let started: ThreadStartedNotification =
+        serde_json::from_value(notification.params.context("enrolled record")?)?;
+    assert_eq!(
+        started
+            .thread
+            .extra
+            .as_ref()
+            .and_then(|extra| extra.managed_record.as_ref())
+            .map(|origin| origin.canonical_thread_id.as_str()),
+        Some(canonical.id.as_str())
+    );
+    publish(&catalog, &[&viewer])?;
+    let deleted = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_notification_message("thread/deleted"),
+    )
+    .await??;
+    assert_eq!(
+        deleted.params.context("removed projection")?["threadId"],
+        started.thread.id
+    );
+    assert_eq!(fs::read(&rollout)?, bytes);
+    assert_eq!(calls.requests().len(), 1);
+    Ok(())
+}
