+async fn create_writer(binding: &ManagedThreadBinding, parent: Option<ThreadId>) -> LiveThread {
+    let reservation = binding.prepare_writer().await.expect("reserve seed writer");
+    let thread_id = binding.thread_id();
+    let source = match parent {
+        Some(parent_thread_id) => SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id,
+            depth: 1,
+            agent_path: None,
+            agent_nickname: Some("cold child".to_string()),
+            agent_role: Some("worker".to_string()),
+        }),
+        None => SessionSource::Exec,
+    };
+    let live = LiveThread::create(
+        binding.store(),
+        CreateThreadParams {
+            session_id: parent.unwrap_or(thread_id).into(),
+            thread_id,
+            extra_config: None,
+            forked_from_id: None,
+            parent_thread_id: parent,
+            source,
+            thread_source: None,
+            originator: "managed-cold-drain-test".to_string(),
+            base_instructions: BaseInstructions::default(),
+            dynamic_tools: Vec::new(),
+            selected_capability_roots: Vec::new(),
+            multi_agent_version: Some(MultiAgentVersion::V2),
+            history_mode: ThreadHistoryMode::Paginated,
+            history_base: None,
+            subagent_history_start_ordinal: None,
+            initial_window_id: "cold-drain-test-window".to_string(),
+            metadata: metadata(binding),
+        },
+    )
+    .await
+    .expect("claim seed recorder");
+    drop(reservation);
+    live.persist(PersistContext::Standard)
+        .await
+        .expect("persist canonical seed");
+    live
+}
