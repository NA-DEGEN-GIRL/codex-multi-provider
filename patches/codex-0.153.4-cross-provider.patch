+    /// How long the summary request ran, in milliseconds: until it completed or failed, or until
+    /// the compaction beside it stopped waiting for it. Unlike `usage`, a request that ran out of
+    /// time records it too. Omitted, and read leniently, like `usage`.
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "deserialize_lenient_option"
+    )]
+    pub elapsed_ms: Option<u64>,
+}
+
+/// Token counts a provider reported for a portable summary request.
+#[derive(Serialize, Deserialize, Clone, Debug, Default, PartialEq, Eq, JsonSchema)]
+pub struct PortableSummaryUsage {
+    /// Every input token, cached ones included.
+    #[serde(default)]
+    pub input_tokens: i64,
+    /// Input tokens read from the provider's prompt cache.
+    #[serde(default)]
+    pub cached_input_tokens: i64,
+    /// Every output token, reasoning included.
+    #[serde(default)]
+    pub output_tokens: i64,
+    #[serde(default)]
+    pub reasoning_output_tokens: i64,
+}
+
+impl From<&TokenUsage> for PortableSummaryUsage {
+    fn from(usage: &TokenUsage) -> Self {
+        Self {
+            input_tokens: usage.input_tokens,
+            cached_input_tokens: usage.cached_input_tokens,
+            output_tokens: usage.output_tokens,
+            reasoning_output_tokens: usage.reasoning_output_tokens,
+        }
+    }
+}
+
+/// Reads an optional value that another writer may have malformed as absent.
+fn deserialize_lenient_option<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
+where
+    D: Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    #[derive(Deserialize)]
+    #[serde(untagged)]
+    enum Lenient<T> {
+        Valid(T),
+        Invalid(serde::de::IgnoredAny),
+    }
+    Ok(match Option::<Lenient<T>>::deserialize(deserializer)? {
+        Some(Lenient::Valid(value)) => Some(value),
+        Some(Lenient::Invalid(_)) | None => None,
+    })
+}
+
+/// Whether a portable summary was produced for a checkpoint.
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq, JsonSchema)]
+#[serde(tag = "state", rename_all = "snake_case")]
+pub enum PortableCheckpointStatus {
+    Ready,
+    Failed {
+        #[serde(default)]
+        reason: String,
+    },
+    /// A state written by a newer runtime. Readers treat it as unusable.
+    #[serde(other)]
+    Unknown,
+}
+
+/// What a checkpoint summarizes.
+///
+/// Coverage is positional and cumulative: every valid model-visible item recorded before the
+/// checkpoint record in its thread's lineage, except the `output_items` records just before it,
+/// which the compaction request wrote itself. The identifiers let readers reject a checkpoint
+/// whose covered items were later removed by rollback or revert; they never decide which items
+/// are covered.
+#[derive(Serialize, Deserialize, Clone, Debug, Default, PartialEq, Eq, JsonSchema)]
+pub struct PortableCoverage {
+    /// Lineage ordinal (paginated threads) or record index (legacy threads) of the checkpoint
+    /// record. Storage assigns positions on append, so writers leave this empty and readers fill
+    /// it in.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub position: Option<u64>,
+    /// Turn that recorded the newest covered item.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub through_turn_id: Option<String>,
+    /// Newest covered model-visible item that has an ID.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub through_item_id: Option<String>,
+    /// Model-visible records the compaction request itself wrote just before the checkpoint
+    /// record, such as local compaction's summary message. They are not history the checkpoint
+    /// covers. Remote compaction writes none; checkpoints written before this field existed omit
+    /// it.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub output_items: Option<u32>,
 }
 
