index 0000000000000000000000000000000000000000..8e15415c2c7abd9e1d98a8d116b7b3bba791aa89
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/managed_thread_idle_status.rs
@@ -0,0 +1,224 @@
+//! Advisory, read-only activity inventory for a managed canonical subtree.
+
+use super::ThreadQueueRequestProcessor;
+use super::ThreadRequestProcessor;
+use crate::error_code::internal_error;
+use crate::error_code::invalid_request;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ThreadManagedIdleBlocker;
+use codex_app_server_protocol::ThreadManagedIdleProofScope;
+use codex_app_server_protocol::ThreadManagedIdleStatusParams;
+use codex_app_server_protocol::ThreadManagedIdleStatusResponse;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::AgentStatus;
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::time::Duration;
+
+const MAX_OBSERVED_THREADS: usize = 128;
+const OBSERVATION_TIMEOUT: Duration = Duration::from_secs(10);
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn managed_idle_status(
+        &self,
+        params: ThreadManagedIdleStatusParams,
+        queues: &ThreadQueueRequestProcessor,
+    ) -> Result<ThreadManagedIdleStatusResponse, JSONRPCErrorError> {
+        tokio::time::timeout(
+            OBSERVATION_TIMEOUT,
+            self.managed_idle_status_inner(params, queues),
+        )
+        .await
+        .map_err(|_| internal_error("managed activity observation timed out; state is unknown"))?
+    }
+
+    async fn managed_idle_status_inner(
+        &self,
+        params: ThreadManagedIdleStatusParams,
+        queues: &ThreadQueueRequestProcessor,
+    ) -> Result<ThreadManagedIdleStatusResponse, JSONRPCErrorError> {
+        if !crate::managed_sources::is_enabled() {
+            return Err(invalid_request(
+                "managed idle status is not enabled for this instance",
+            ));
+        }
+        let root_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_request("managed idle status requires a valid thread UUID"))?;
+        let root = self
+            .thread_manager
+            .get_thread(root_id)
+            .await
+            .map_err(|_| invalid_request("managed idle status requires a loaded root actor"))?;
+        if root
+            .config_snapshot()
+            .await
+            .session_source
+            .is_non_root_agent()
+        {
+            return Err(invalid_request(
+                "observe the owning root and its complete spawn subtree",
+            ));
+        }
+        // This only reads an already installed binding. Do not bind a manifest,
+        // acquire an ownership permit, or initialize a store while observing.
+        let root_binding = self
+            .thread_manager
+            .managed_record_binding(root_id)
+            .await
+            .ok_or_else(|| invalid_request("root actor has no immutable managed source binding"))?;
+        let mut ids = self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+            .map_err(|_| internal_error("cannot inspect the canonical managed subtree"))?;
+        ids.sort_by_cached_key(std::string::ToString::to_string);
+        ids.dedup();
+        if ids.is_empty() || !ids.contains(&root_id) || ids.len() > MAX_OBSERVED_THREADS {
+            return Err(invalid_request(
+                "managed idle status requires a bounded canonical subtree",
+            ));
+        }
+
+        let mut blockers = Vec::new();
+        let mut actors = HashMap::new();
+        for id in &ids {
+            let Ok(actor) = self.thread_manager.get_thread(*id).await else {
+                // A cold persisted child is not evidence of inactivity: it may
+                // still have a writer in another process or an unknown state.
+                // Only strict close can resolve this with a held writer claim.
+                add_blocker(
+                    &mut blockers,
+                    *id,
+                    if *id == root_id {
+                        "threadNotLoaded"
+                    } else {
+                        "coldDescendantRequiresWriterClaim"
+                    },
+                );
+                if !self
+                    .outgoing
+                    .pending_requests_for_thread(*id)
+                    .await
+                    .is_empty()
+                {
+                    add_blocker(&mut blockers, *id, "pendingClientRequest");
+                }
+                if let Some(state) = self.thread_state_manager.get_thread_state(*id).await {
+                    let state = state.lock().await;
+                    if state.active_turn_snapshot().is_some()
+                        || !state.pending_interrupts.is_empty()
+                        || state.pending_rollbacks.is_some()
+                        || !state.turn_summary.command_execution_started.is_empty()
+                        || state.cancel_tx.is_some()
+                    {
+                        add_blocker(&mut blockers, *id, "undrainedRuntimeEvents");
+                    }
+                }
+                continue;
+            };
+            let Some(binding) = self.thread_manager.managed_record_binding(*id).await else {
+                add_blocker(&mut blockers, *id, "sourceBindingUnknown");
+                continue;
+            };
+            if binding.source_id() != root_binding.source_id() {
+                add_blocker(&mut blockers, *id, "sourceMismatch");
+                continue;
+            }
+            let status = actor.agent_status().await;
+            // An initialized root stays PendingInit until its first turn.
+            // Its actual startup, input and hook work is checked below.
+            if matches!(status, AgentStatus::Running)
+                || (*id != root_id && matches!(status, AgentStatus::PendingInit))
+            {
+                add_blocker(&mut blockers, *id, "agentActive");
+            }
+            for kind in actor.managed_idle_blockers().await {
+                add_blocker(&mut blockers, *id, &kind);
+            }
+            if !self
+                .outgoing
+                .pending_requests_for_thread(*id)
+                .await
+                .is_empty()
+            {
+                add_blocker(&mut blockers, *id, "pendingClientRequest");
+            }
+            if let Some(state) = self.thread_state_manager.get_thread_state(*id).await {
+                let state = state.lock().await;
+                if state.active_turn_snapshot().is_some()
+                    || !state.pending_interrupts.is_empty()
+                    || state.pending_rollbacks.is_some()
+                    || !state.turn_summary.command_execution_started.is_empty()
+                    || (state.cancel_tx.is_some() && !state.listener_matches(&actor))
+                {
+                    add_blocker(&mut blockers, *id, "undrainedRuntimeEvents");
+                }
+            }
+            match queues.has_managed_pending(*id).await {
+                Ok(true) => add_blocker(&mut blockers, *id, "queuedUserInput"),
+                Ok(false) => {}
+                Err(_) => add_blocker(&mut blockers, *id, "queueStateUnknown"),
+            }
+            let snapshot = actor.config_snapshot().await;
+            let parent = snapshot
+                .parent_thread_id
+                .or_else(|| snapshot.session_source.parent_thread_id());
+            if *id != root_id && parent.is_none_or(|parent| !ids.contains(&parent)) {
+                add_blocker(&mut blockers, *id, "parentRelationshipUnknown");
+            }
+            actors.insert(*id, actor);
+        }
+        {
+            let pending = self.pending_thread_unloads.lock().await;
+            for id in &ids {
+                if pending.contains(id) {
+                    add_blocker(&mut blockers, *id, "actorClosing");
+                }
+            }
+        }
+        match self
+            .thread_manager
+            .inspect_agent_subtree_thread_ids(root_id)
+            .await
+        {
+            Ok(mut observed) => {
+                observed.sort_by_cached_key(std::string::ToString::to_string);
+                observed.dedup();
+                if observed != ids {
+                    add_blocker(&mut blockers, root_id, "subtreeChanged");
+                }
+            }
+            Err(_) => add_blocker(&mut blockers, root_id, "subtreeStateUnknown"),
+        }
+        for (id, actor) in actors {
+            if !self
+                .thread_manager
+                .get_thread(id)
+                .await
+                .is_ok_and(|current| Arc::ptr_eq(&current, &actor))
+            {
+                add_blocker(&mut blockers, id, "actorChanged");
+            }
+        }
+        blockers.sort_by(|left, right| {
+            (&left.thread_id, &left.kind).cmp(&(&right.thread_id, &right.kind))
+        });
+        blockers.dedup();
+        Ok(ThreadManagedIdleStatusResponse {
+            thread_id: root_id.to_string(),
+            host_id: root_binding.source_id().host_id.clone(),
+            source_store_id: root_binding.source_id().store_id.clone(),
+            observed_thread_ids: ids.iter().map(ToString::to_string).collect(),
+            idle: blockers.is_empty(),
+            blockers,
+            proof_scope: ThreadManagedIdleProofScope::Advisory,
+        })
+    }
+}
+
+fn add_blocker(blockers: &mut Vec<ThreadManagedIdleBlocker>, thread_id: ThreadId, kind: &str) {
+    blockers.push(ThreadManagedIdleBlocker {
+        thread_id: thread_id.to_string(),
+        kind: kind.to_string(),
+    });
+}
