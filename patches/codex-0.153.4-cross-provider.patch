+fn function_call(name: &str) -> ResponseItem {
+    ResponseItem::FunctionCall {
+        id: None,
+        name: name.to_string(),
+        namespace: None,
+        arguments: "{}".to_string(),
+        encrypted_function_args: None,
+        call_id: "call-1".to_string(),
+        internal_chat_message_metadata_passthrough: None,
+    }
+}
+
+/// A compaction prompt with every field the summary must keep set away from its default.
+fn compaction_prompt() -> Prompt {
+    Prompt {
+        input: vec![
+            message("user", "first question"),
+            message("assistant", "first answer"),
+            ResponseItem::CompactionTrigger {},
+        ],
+        tools: vec![codex_tools::ToolSpec::Freeform(codex_tools::FreeformTool {
+            name: "exec".to_string(),
+            description: "Execute JavaScript.".to_string(),
+            defer_loading: None,
+            format: codex_tools::FreeformToolFormat {
+                r#type: "grammar".to_string(),
+                syntax: "lark".to_string(),
+                definition: "start: /.+/".to_string(),
+            },
+        })]
+        .into(),
+        parallel_tool_calls: true,
+        base_instructions: BaseInstructions {
+            text: "base instructions".to_string(),
+            provenance: None,
+        },
+        output_schema: Some(json!({"type": "object"})),
+        output_schema_strict: false,
+        cyber_access_program: Some(CyberAccessProgram::DaybreakBlue),
+    }
+}
+
+#[test]
+fn summary_prompt_replaces_only_the_compaction_trigger() {
+    let compaction = compaction_prompt();
+
+    let summary = portable_summary_prompt(&compaction, Some("Summarize the conversation."));
+
+    assert_eq!(summary.tools, compaction.tools);
+    assert_eq!(summary.parallel_tool_calls, compaction.parallel_tool_calls);
+    assert_eq!(summary.base_instructions, compaction.base_instructions);
+    assert_eq!(summary.output_schema, compaction.output_schema);
+    assert_eq!(
+        summary.output_schema_strict,
+        compaction.output_schema_strict
+    );
+    assert_eq!(
+        summary.cyber_access_program,
+        compaction.cyber_access_program
+    );
+    let (instruction, history) = summary.input.split_last().expect("summary input");
+    assert_eq!(history, &compaction.input[..compaction.input.len() - 1]);
+    assert_eq!(
+        instruction,
+        &message(
+            "user",
+            &format!("Summarize the conversation.\n\n{PORTABLE_SUMMARY_TEXT_ONLY}")
+        )
+    );
+
+    // Without a configured prompt, the built-in summarization prompt asks for the summary.
+    let default = portable_summary_prompt(&compaction, /*compact_prompt*/ None);
+    assert_eq!(
+        default.input.last(),
+        Some(&message(
+            "user",
+            &format!(
+                "{}\n\n{PORTABLE_SUMMARY_TEXT_ONLY}",
+                crate::compact::SUMMARIZATION_PROMPT
+            )
+        ))
+    );
+}
+
+#[test]
+fn summary_reply_that_calls_a_tool_is_not_a_summary() {
+    let mut text_only = SummaryReply::default();
+    text_only.observe(message("assistant", "the "));
+    text_only.observe(message("assistant", "summary"));
+    assert_eq!(text_only.finish(), Ok("the summary".to_string()));
+
+    let mut with_call = SummaryReply::default();
+    with_call.observe(message("assistant", "Let me check first."));
+    with_call.observe(function_call("update_plan"));
+    with_call.observe(function_call("shell"));
+    assert_eq!(
+        with_call.finish(),
+        Err("the model called the update_plan tool instead of writing the summary".to_string())
+    );
+
+    // Every kind of call counts, the freeform `exec` tool and hosted tools included: the summary
+    // reply must not act at all.
+    let calls = [
+        (
+            json!({"type": "custom_tool_call", "call_id": "c1", "name": "exec", "input": "1"}),
+            "exec",
+        ),
+        (
+            json!({
+                "type": "local_shell_call",
+                "call_id": "c2",
+                "status": "completed",
+                "action": {"type": "exec", "command": ["ls"]},
+            }),
+            "local_shell",
+        ),
+        (
+            json!({
+                "type": "tool_search_call",
+                "call_id": "c3",
+                "execution": "client",
+                "arguments": {"query": "files"},
+            }),
+            "tool_search",
+        ),
+        (
+            json!({"type": "web_search_call", "status": "completed"}),
+            "web_search",
+        ),
+        (
+            json!({"type": "image_generation_call", "status": "completed", "result": ""}),
+            "image_generation",
+        ),
+    ];
+    for (call, tool) in calls {
+        let call = serde_json::from_value::<ResponseItem>(call).expect("tool call item");
+        let mut reply = SummaryReply::default();
+        reply.observe(call);
+        reply.observe(message("assistant", "summary"));
+        assert_eq!(
+            reply.finish(),
+            Err(format!(
+                "the model called the {tool} tool instead of writing the summary"
+            ))
+        );
+    }
+}
+
+#[test]
+fn summary_reply_leaves_out_commentary_before_the_answer() {
+    let with_phase = |phase, text: &str| ResponseItem::Message {
+        id: None,
+        role: "assistant".to_string(),
+        content: vec![ContentItem::OutputText {
+            text: text.to_string(),
+        }],
+        phase: Some(phase),
+        internal_chat_message_metadata_passthrough: None,
+    };
+
+    let mut reply = SummaryReply::default();
+    reply.observe(with_phase(
+        MessagePhase::Commentary,
+        "I'll write the summary now.",
+    ));
+    reply.observe(with_phase(MessagePhase::FinalAnswer, "the summary"));
+    assert_eq!(reply.finish(), Ok("the summary".to_string()));
+
+    // Answers without a phase are kept beside the final answer.
+    let mut unphased = SummaryReply::default();
+    unphased.observe(with_phase(MessagePhase::Commentary, "Preamble. "));
+    unphased.observe(message("assistant", "the summary"));
+    assert_eq!(unphased.finish(), Ok("the summary".to_string()));
+
+    // A reply that is all commentary is still the summary.
+    let mut commentary_only = SummaryReply::default();
+    commentary_only.observe(with_phase(MessagePhase::Commentary, "the summary"));
+    assert_eq!(commentary_only.finish(), Ok("the summary".to_string()));
+}
+
+#[test]
+fn summary_attempt_records_its_usage_on_the_checkpoint() {
+    let usage = TokenUsage {
+        input_tokens: 227_000,
+        cached_input_tokens: 226_500,
+        cache_write_input_tokens: 0,
+        output_tokens: 1_200,
+        reasoning_output_tokens: 400,
+        total_tokens: 228_200,
+        codex_rollout_budget_units: None,
+    };
+    let covers = PortableCoverage {
+        through_turn_id: Some("turn-1".to_string()),
+        ..Default::default()
+    };
+    let expected_usage = Some(PortableSummaryUsage {
+        input_tokens: 227_000,
+        cached_input_tokens: 226_500,
+        output_tokens: 1_200,
+        reasoning_output_tokens: 400,
+    });
+
+    let ready = PortableSummaryAttempt {
+        summary: Ok("summary".to_string()),
+        usage: Some(usage.clone()),
+        elapsed: Some(Duration::from_millis(41_250)),
+    }
+    .into_checkpoint(covers.clone());
+    assert_eq!(
+        ready,
+        PortableCheckpoint {
+            summary: "summary".to_string(),
+            status: PortableCheckpointStatus::Ready,
+            covers: covers.clone(),
+            usage: expected_usage.clone(),
+            elapsed_ms: Some(41_250),
+        }
+    );
+
+    // A reply that called a tool still paid for its request.
+    let failed = PortableSummaryAttempt {
+        summary: Err("the model called a tool".to_string()),
+        usage: Some(usage),
+        elapsed: Some(Duration::from_millis(9_000)),
+    }
+    .into_checkpoint(covers.clone());
+    assert_eq!(
+        (&failed.status, &failed.usage, failed.elapsed_ms),
+        (
+            &PortableCheckpointStatus::Failed {
+                reason: "the model called a tool".to_string()
+            },
+            &expected_usage,
+            Some(9_000)
+        )
+    );
+
+    // A request that never completed reported no usage, only how long it ran.
+    let unfinished = PortableSummaryAttempt::failed("timed out")
+        .ran_for(Duration::from_secs(166))
+        .into_checkpoint(covers);
+    assert_eq!(
+        (unfinished.usage, unfinished.elapsed_ms),
+        (None, Some(166_000))
+    );
+}
+
+/// Waits `delay`, then returns `value`.
+async fn after<T>(delay: Duration, value: T) -> T {
+    sleep(delay).await;
+    value
+}
+
+fn summary(text: &str) -> PortableSummaryAttempt {
+    PortableSummaryAttempt {
+        summary: Ok(text.to_string()),
+        usage: None,
+        elapsed: None,
+    }
+}
+
+/// Summary attempts reduced to what the checkpoint records of them.
+fn recorded(attempt: Option<PortableSummaryAttempt>) -> Option<(Result<String, String>, u64)> {
+    attempt.map(|attempt| {
+        let elapsed_ms = attempt
+            .elapsed
+            .map(|elapsed| u64::try_from(elapsed.as_millis()).expect("elapsed milliseconds"))
+            .expect("every attempt records how long it ran");
+        (attempt.summary, elapsed_ms)
+    })
+}
+
+#[tokio::test(start_paused = true)]
+async fn summary_gets_thirty_seconds_after_its_compaction_and_records_its_time() {
+    let compaction = || after(Duration::from_secs(100), Ok::<_, ()>("compacted"));
+
+    // A summary that finishes within 30 s of the compaction is kept, with its own time.
+    let started = Instant::now();
+    let (result, attempt) = run_beside_compaction(
+        compaction(),
+        Some(after(Duration::from_secs(129), summary("in time"))),
+    )
+    .await;
+    assert_eq!(
+        (result, recorded(attempt), started.elapsed()),
+        (
+            Ok("compacted"),
+            Some((Ok("in time".to_string()), 129_000)),
+            Duration::from_secs(129)
+        )
+    );
+
+    // A slower one is given up 30 s after the compaction, and records how long it ran.
+    let started = Instant::now();
+    let (result, attempt) = run_beside_compaction(
+        compaction(),
+        Some(after(Duration::from_secs(131), summary("too late"))),
+    )
+    .await;
+    assert_eq!(
+        (result, recorded(attempt), started.elapsed()),
+        (
+            Ok("compacted"),
+            Some((
+                Err("the summary did not finish in time after compaction".to_string()),
+                130_000
+            )),
+            Duration::from_secs(130)
+        )
+    );
+
+    // A summary that finishes first records its own time, not the compaction's.
+    let started = Instant::now();
+    let (result, attempt) = run_beside_compaction(
+        compaction(),
+        Some(after(Duration::from_secs(10), summary("early"))),
+    )
+    .await;
+    assert_eq!(
+        (result, recorded(attempt), started.elapsed()),
+        (
+            Ok("compacted"),
+            Some((Ok("early".to_string()), 10_000)),
+            Duration::from_secs(100)
+        )
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn summary_never_holds_back_a_failed_compaction() {
+    let started = Instant::now();
+    let (result, attempt) = run_beside_compaction(
+        after(Duration::from_secs(50), Err::<(), _>("compaction failed")),
+        Some(after(Duration::from_secs(80), summary("unused"))),
+    )
+    .await;
+    assert_eq!(
+        (result, recorded(attempt), started.elapsed()),
+        (Err("compaction failed"), None, Duration::from_secs(50))
+    );
+
+    // Without a summary request, the compaction's result comes back alone.
+    let started = Instant::now();
+    let (result, attempt) = run_beside_compaction(
+        after(Duration::from_secs(50), Ok::<_, ()>("compacted")),
+        None::<std::future::Ready<PortableSummaryAttempt>>,
+    )
+    .await;
+    assert_eq!(
+        (result, recorded(attempt), started.elapsed()),
+        (Ok("compacted"), None, Duration::from_secs(50))
+    );
+}
