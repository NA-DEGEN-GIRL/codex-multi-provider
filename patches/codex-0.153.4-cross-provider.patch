+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[tokio::test]
+async fn borrowed_auth_rereads_source_without_rotating_or_writing_credentials() {
+    let home = tempfile::tempdir().expect("fixture");
+    let path = home.path().join("auth.json");
+    let mut digest = Sha256::new();
+    digest.update(b"codex-manager-account-v1\0fixture-account");
+    let borrowed = BorrowedAccount {
+        home: home.path().to_path_buf(),
+        expected_account_fingerprint: format!("{:x}", digest.finalize()),
+    };
+    let source = |access: &str, account: &str| {
+        json!({"tokens": {
+        "id_token":"e30.e30.signature", "access_token":access, "refresh_token":"source-owned-refresh", "account_id":account
+    }}).to_string()
+    };
+    let original = source("e30.e30.first", "fixture-account");
+    std::fs::write(&path, &original).expect("auth fixture");
+    assert_eq!(
+        borrowed
+            .resolve()
+            .await
+            .expect("borrow")
+            .get_token()
+            .expect("token"),
+        "e30.e30.first"
+    );
+    assert_eq!(std::fs::read_to_string(&path).expect("unchanged"), original);
+    let renewed = source("e30.e30.renewed", "fixture-account");
+    std::fs::write(&path, &renewed).expect("source renewed");
+    let auth = borrowed
+        .refresh(ExternalAuthRefreshContext {
+            reason: codex_login::ExternalAuthRefreshReason::Unauthorized,
+            previous_account_id: Some("fixture-account".to_string()),
+        })
+        .await
+        .expect("reread");
+    assert_eq!(auth.get_token().expect("token"), "e30.e30.renewed");
+    assert_eq!(std::fs::read_to_string(&path).expect("unchanged"), renewed);
+    std::fs::write(&path, source("other-access", "other-account")).expect("account changed");
+    assert!(borrowed.resolve().await.is_err());
+}
+
+#[tokio::test]
+async fn selected_child_account_does_not_replace_parent_ephemeral_auth() {
+    let config = crate::config::test_config().await;
+    let source = tempfile::tempdir().expect("account source");
+    std::fs::write(source.path().join("auth.json"), json!({"tokens":{
+        "id_token":"e30.e30.signature", "access_token":"e30.e30.child", "refresh_token":"owner-only", "account_id":"child-account"
+    }}).to_string()).expect("source");
+    let mut digest = Sha256::new();
+    digest.update(b"codex-manager-account-v1\0child-account");
+    let fingerprint = format!("{:x}", digest.finalize());
+    let parent = AuthManager::shared(
+        config.codex_home.to_path_buf(),
+        /*enable_codex_api_key_env*/ false,
+        codex_login::AuthCredentialsStoreMode::Ephemeral,
+        /*forced_chatgpt_workspace_id*/ None,
+        Some(config.chatgpt_base_url.clone()),
+        config.auth_keyring_backend_kind(),
+        config.auth_route_config(),
+    )
+    .await;
+    assert!(parent.auth().await.is_none());
+    let child =
+        borrowed_account_manager(&config, &parent, source.path().to_path_buf(), fingerprint)
+            .await
+            .expect("child auth");
+    assert_eq!(
+        child.auth().await.expect("child").get_account_id(),
+        Some("child-account".to_string())
+    );
+    parent.reload().await;
+    assert!(
+        parent.auth().await.is_none(),
+        "child must not populate the parent's process-local auth key"
+    );
+    assert!(
+        !config.codex_home.join(".execution-preset-auth").exists(),
+        "auth cache is memory-only"
+    );
+}
+
+struct FixtureResolver(
+    std::sync::Mutex<codex_app_server_protocol::ExecutionPresetAuthTokensReadResponse>,
+);
+
+impl ExecutionPresetAuthResolver for FixtureResolver {
+    fn resolve(
+        &self,
+        _request: codex_app_server_protocol::ExecutionPresetAuthTokensReadParams,
+    ) -> ExternalAuthFuture<'_, codex_app_server_protocol::ExecutionPresetAuthTokensReadResponse>
+    {
+        Box::pin(async { Ok(self.0.lock().expect("fixture").clone()) })
+    }
+}
+
+#[tokio::test]
+async fn managed_account_refresh_uses_selected_source_and_rejects_identity_drift() {
+    use codex_app_server_protocol::ExecutionPresetAuthTokensReadParams;
+    use codex_app_server_protocol::ExecutionPresetAuthTokensReadResponse;
+    let mut digest = Sha256::new();
+    digest.update(b"codex-manager-account-v1\0child-account");
+    let fingerprint = format!("{:x}", digest.finalize());
+    let fixture = Arc::new(FixtureResolver(std::sync::Mutex::new(
+        ExecutionPresetAuthTokensReadResponse {
+            kind: "openai".to_string(),
+            access_token: "e30.e30.first".to_string(),
+            chatgpt_account_id: Some("child-account".to_string()),
+            expires_at: None,
+            account_identity: None,
+            credential_source: None,
+            credential_id: None,
+        },
+    )));
+    let source = ManagedAccount {
+        resolver: fixture.clone(),
+        request: ExecutionPresetAuthTokensReadParams {
+            owner_profile_id: "11111111-1111-4111-8111-111111111111".to_string(),
+            role_id: Some("prepared-child".to_string()),
+            profile_id: "22222222-2222-4222-8222-222222222222".to_string(),
+            kind: "openai".to_string(),
+            expected_account_fingerprint: Some(fingerprint),
+            expected_account_identity: None,
+            rejected_credential_id: None,
+        },
+    };
+    assert_eq!(
+        source
+            .resolve()
+            .await
+            .expect("selected account")
+            .get_token()
+            .expect("token"),
+        "e30.e30.first"
+    );
+    fixture.0.lock().expect("fixture").access_token = "e30.e30.renewed".to_string();
+    assert_eq!(
+        source
+            .refresh(ExternalAuthRefreshContext {
+                reason: codex_login::ExternalAuthRefreshReason::Unauthorized,
+                previous_account_id: Some("child-account".to_string()),
+            })
+            .await
+            .expect("fresh source")
+            .get_token()
+            .expect("token"),
+        "e30.e30.renewed"
+    );
+    fixture.0.lock().expect("fixture").chatgpt_account_id = Some("parent-account".to_string());
+    assert!(
+        source.resolve().await.is_err(),
+        "parent credentials cannot satisfy the child binding"
+    );
+    fixture.0.lock().expect("fixture").kind = "claude".to_string();
+    assert!(
+        source.resolve().await.is_err(),
+        "credential kinds cannot be substituted"
+    );
+}
