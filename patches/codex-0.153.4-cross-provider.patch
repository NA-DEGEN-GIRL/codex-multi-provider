@@ -0,0 +1,209 @@
+//! Versioned, bounded JSONL transport. Only the manager runner starts Claude Code.
+use std::process::Stdio;
+use std::time::Duration;
+
+use codex_model_provider_info::AgentProviderInfo;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use serde_json::Value;
+use serde_json::json;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::io::BufReader;
+use tokio::process::Child;
+use tokio::process::ChildStdin;
+use tokio::process::ChildStdout;
+use tokio::process::Command;
+
+const MAX_LINE_BYTES: usize = 8 * 1024 * 1024;
+/// The lent credential in a runner's environment, for helpers prepared before the stdin channel.
+const AUTH_ENV: &str = "CODEX_MANAGER_CLAUDE_AUTH";
+/// Asks the runner to receive the lent credential on stdin. It never carries the credential.
+const AUTH_CHANNEL_ENV: &str = "CODEX_MANAGER_CLAUDE_AUTH_CHANNEL";
+const HANDSHAKE_TIMEOUT: Duration = Duration::from_secs(60);
+
+pub(super) struct Bridge {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+    /// The start of a line whose read a `select!` cancelled; the next receive completes it.
+    partial: Vec<u8>,
+}
+
+/// How a runner process receives the credential lent for this turn.
+enum Delivery<'a> {
+    Nothing,
+    /// The runner announces `auth_channel` and reads `auth_init` before its hello, so the
+    /// credential never appears in `/proc/<pid>/environ` of the runner.
+    Stdin,
+    Environment(&'a str),
+}
+
+impl Bridge {
+    /// Starts the runner and hands it the lent credential, if this turn has one.
+    ///
+    /// A helper prepared before the stdin channel ignores the channel request and refuses at
+    /// once without its environment credential; it is then started again the old way.
+    pub(super) async fn start(
+        agent: &AgentProviderInfo,
+        cwd: &std::path::Path,
+        credentials: Option<&Value>,
+    ) -> Result<Self> {
+        let Some(credentials) = credentials else {
+            return Self::spawn(agent, cwd, Delivery::Nothing);
+        };
+        let mut bridge = Self::spawn(agent, cwd, Delivery::Stdin)?;
+        let first = tokio::time::timeout(HANDSHAKE_TIMEOUT, bridge.receive())
+            .await
+            .map_err(|_| failure("runner handshake timed out"))??;
+        match first["type"].as_str() {
+            Some("auth_channel") if first["protocol"] == 1 => {
+                bridge
+                    .send(&json!({"type":"auth_init","credentials":credentials}))
+                    .await?;
+                Ok(bridge)
+            }
+            Some("refused") => {
+                tracing::debug!("Claude runner predates stdin credential delivery");
+                drop(bridge);
+                let environment = serde_json::to_string(credentials)
+                    .map_err(|_| failure("the selected Claude account is unavailable"))?;
+                Self::spawn(agent, cwd, Delivery::Environment(&environment))
+            }
+            _ => Err(failure("runner refused or uses an unsupported protocol")),
+        }
+    }
+
+    fn spawn(
+        agent: &AgentProviderInfo,
+        cwd: &std::path::Path,
+        delivery: Delivery<'_>,
+    ) -> Result<Self> {
+        let mut command = Command::new(&agent.command);
+        // Ambient credentials must never authorize a different registered role.
+        command.env_remove(AUTH_ENV).env_remove(AUTH_CHANNEL_ENV);
+        match delivery {
+            Delivery::Nothing => {}
+            Delivery::Stdin => {
+                command.env(AUTH_CHANNEL_ENV, "stdin");
+            }
+            Delivery::Environment(credentials) => {
+                command.env(AUTH_ENV, credentials);
+            }
+        }
+        command
+            .args(&agent.args)
+            .current_dir(cwd)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .kill_on_drop(true);
+        #[cfg(windows)]
+        command.creation_flags(0x08000000); // CREATE_NO_WINDOW
+        let mut child = command
+            .spawn()
+            .map_err(|err| failure(format!("cannot start runner: {err}")))?;
+        let stdin = child
+            .stdin
+            .take()
+            .ok_or_else(|| failure("runner stdin unavailable"))?;
+        let stdout = BufReader::new(
+            child
+                .stdout
+                .take()
+                .ok_or_else(|| failure("runner stdout unavailable"))?,
+        );
+        Ok(Self {
+            child,
+            stdin,
+            stdout,
+            partial: Vec::new(),
+        })
+    }
+
+    pub(super) async fn send(&mut self, message: &Value) -> Result<()> {
+        let mut bytes = serde_json::to_vec(message).map_err(|err| failure(err.to_string()))?;
+        if bytes.len() >= MAX_LINE_BYTES {
+            return Err(failure(
+                "handoff exceeds the runner message limit; compact or reduce the request",
+            ));
+        }
+        bytes.push(b'\n');
+        self.stdin
+            .write_all(&bytes)
+            .await
+            .map_err(|err| failure(err.to_string()))?;
+        self.stdin
+            .flush()
+            .await
+            .map_err(|err| failure(err.to_string()))
+    }
+
+    /// Reads one JSONL message. Cancellation safe: bytes already read stay in `partial`.
+    pub(super) async fn receive(&mut self) -> Result<Value> {
+        loop {
+            let chunk = self
+                .stdout
+                .fill_buf()
+                .await
+                .map_err(|err| failure(format!("cannot read runner: {err}")))?;
+            if chunk.is_empty() {
+                return Err(failure(if self.partial.is_empty() {
+                    "runner exited without a terminal response"
+                } else {
+                    "runner sent an incomplete or oversized JSONL message"
+                }));
+            }
+            let end = chunk.iter().position(|byte| *byte == b'\n');
+            let used = end.map_or(chunk.len(), |end| end + 1);
+            if self.partial.len() + used > MAX_LINE_BYTES {
+                return Err(failure(
+                    "runner sent an incomplete or oversized JSONL message",
+                ));
+            }
+            self.partial.extend_from_slice(&chunk[..used]);
+            self.stdout.consume(used);
+            if end.is_some() {
+                let line = std::mem::take(&mut self.partial);
+                return serde_json::from_slice(&line)
+                    .map_err(|err| failure(format!("invalid runner JSON: {err}")));
+            }
+        }
+    }
+
+    pub(super) async fn interrupt(&mut self) {
+        let _ = self.send(&serde_json::json!({"type":"interrupt"})).await;
+        let _ = self.stdin.shutdown().await;
+        // The runner owns process-tree cleanup. Dropping this object also terminates it,
+        // closing its Windows kill-on-close job if the task's abort grace period expires.
+        if tokio::time::timeout(Duration::from_secs(6), self.child.wait())
+            .await
+            .is_err()
+        {
+            let _ = self.child.kill().await;
+        }
+    }
+
+    pub(super) async fn finish(mut self) -> Result<()> {
+        self.stdin
+            .shutdown()
+            .await
+            .map_err(|err| failure(err.to_string()))?;
+        let status = tokio::time::timeout(Duration::from_secs(10), self.child.wait())
+            .await
+            .map_err(|_| failure("runner did not exit after committing history"))?
+            .map_err(|err| failure(err.to_string()))?;
+        if !status.success() {
+            return Err(failure(format!("runner exited with {status}")));
+        }
+        Ok(())
+    }
+}
+
+pub(super) fn failure(message: impl std::fmt::Display) -> CodexErr {
+    CodexErr::InvalidRequest(format!("Claude agent: {message}"))
+}
+
+#[cfg(test)]
+#[path = "bridge_tests.rs"]
+mod tests;
