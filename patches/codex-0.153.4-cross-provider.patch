+        AuthRefresh::borrowed()
+    } else {
+        AuthRefresh::unavailable()
+    };
+    drop(credentials);
+    let mut lent_sources = auth_refresh::Lent::default();
+    if let Some(lent) = &lent {
+        lent_sources.record(lent);
+    }
+    *bridge_slot = Some(Bridge::start(agent, cwd.as_path(), lent.as_ref()).await?);
+    drop(lent);
+    let Some(bridge) = bridge_slot.as_mut() else {
+        return Err(failure("runner was not initialized"));
+    };
+    let mut hello = json!({"type":"hello","protocol":1,"thread_id":session.thread_id().to_string(),
+        "claude_profile_id":agent.profile_id,"cwd":cwd,"trusted_cwd":true,"turn_id":ctx.sub_id,
+        "snapshot":snapshot,"model":model,"effort":effort,"context_window":agent.context_window,
+        "auto_compact_percent":agent.auto_compact_percent,"exclude_dynamic_sections":agent.exclude_dynamic_sections,
+        "system_prompt":system_prompt,"delegation_tools":delegation_tools,
+        "managed_delegation":ctx.config.execution_preset_selection().is_some(),
+        // Older runners ignore this; newer ones offer a session stopped by an expired login.
+        "auth_resume":1});
+    if renewal.announced() {
+        // Older runners ignore unknown hello fields and never ask for a renewal. Rotation
+        // requests carry their own reason and budget, and are answered while events flow.
+        // auth_sources: a refused long-lived token may be reported with auth_rejected.
+        hello["auth_refresh"] = json!(1);
+        hello["auth_rotate"] = json!(1);
+        hello["auth_sources"] = json!(1);
+    }
+    bridge.send(&hello).await?;
+    let ready = tokio::time::timeout(Duration::from_secs(60), bridge.receive())
+        .await
+        .map_err(|_| failure("runner handshake timed out"))??;
+    if ready["type"] != "ready" || ready["protocol"] != 1 {
+        return Err(failure(
+            ready["message"]
+                .as_str()
+                .unwrap_or("runner refused or uses an unsupported protocol"),
+        ));
+    }
+    let covered = context::resumable(&ready, &transcript, &snapshot, &ctx.sub_id);
+    let resume = covered.is_some();
+    let covered = covered.unwrap_or_default();
+    let mut history = transcript;
+    history.items.retain(|item| {
+        item.turn_id.as_deref() != Some(ctx.sub_id.as_str()) || item.position < request_start
+    });
+    for item in &mut history.items {
+        if item.turn_id.as_deref() == Some(ctx.sub_id.as_str()) {
+            item.completed = true;
+        }
+    }
+    // Retaining a prefix of the current turn cannot change offsets of earlier checkpoints.
+    history
+        .checkpoints
+        .retain(|checkpoint| checkpoint.items_before <= history.items.len());
+    let handoff = context::handoff(history, ctx, &covered, &mut image_references)?;
+    tracing::info!(
+        elapsed_ms = preparation_started.elapsed().as_millis(),
+        handoff_bytes = handoff.len(),
+        "Claude shared history prepared"
+    );
+    let mut blocks = Vec::new();
+    if !handoff.is_empty() {
+        blocks.push(json!({"kind":if resume {"update"} else {"context"},"text":handoff}));
+    }
+    blocks.push(json!({"kind":"request","text":request}));
+    bridge.send(&json!({"type":"run","mode":if resume {"resume"} else {"fresh"},"blocks":blocks,
+        "model":model,"effort":effort,"context_window":agent.context_window,"auto_compact_percent":agent.auto_compact_percent,
+        "exclude_dynamic_sections":agent.exclude_dynamic_sections,"permission_mode":if ctx.mode() == ModeKind::Plan {"plan"} else {"auto"},
+        "system_prompt":system_prompt,
+        "permission_prompts":if matches!(ctx.approval_policy(), AskForApproval::Never) {"none"} else {"host"}})).await?;
+    // At most one renewal is outstanding. It resolves while the runner keeps streaming, so a
+    // live rotation never stalls the turn; its reply goes out as soon as it is ready.
+    let mut renewing: Option<
+        Pin<Box<dyn Future<Output = codex_protocol::error::Result<Value>> + Send + '_>>,
+    > = None;
+    loop {
+        let event = tokio::select! {
+            reply = async {
+                match renewing.as_mut() {
+                    Some(renewal) => renewal.await,
+                    None => std::future::pending().await,
+                }
+            }, if renewing.is_some() => {
+                renewing = None;
+                let reply = reply?;
+                lent_sources.record(&reply);
+                // A runner that stopped waiting has already queued its terminal message.
+                if bridge.send(&reply).await.is_err() {
+                    tracing::debug!("Claude runner closed before its login renewal arrived");
+                }
+                continue;
+            }
+            event = bridge.receive() => event?,
+        };
+        match event["type"].as_str() {
+            Some("event") => output.handle(session, ctx, &event, &snapshot).await,
+            // An answer can outlive the runner: one that stopped its CLI (for example on an
+            // expired login) may exit while the user decides. Its queued terminal message,
+            // read next, then decides the turn instead of this write's broken pipe.
+            Some("permission_request") => {
+                let decision = events::approve(session, ctx, &event).await;
+                if bridge.send(&decision).await.is_err() {
+                    tracing::debug!("Claude runner closed before its permission decision arrived");
+                }
+            }
+            Some("agent_request") => {
+                let Some(delegation) = delegation.as_mut() else {
+                    return Err(failure("native delegation is not enabled for this task"));
+                };
+                let response = delegation.dispatch(session, event, cancellation).await?;
+                if bridge.send(&response).await.is_err() {
+                    tracing::debug!("Claude runner closed before its agent response arrived");
+                }
+            }
+            Some("auth_refresh") => {
+                if renewing.is_some() {
+                    // Replies are matched to requests by order; never answer one out of turn.
+                    return Err(failure("runner asked for a second login renewal at once"));
+                }
+                let reason = auth_refresh::Reason::of(&event);
+                if reason == auth_refresh::Reason::Switch {
+                    // This read itself reports the refusal; no separate report is needed.
+                    lent_sources.refuse(&event["rejected_credential_id"]);
+                }
+                if renewal.admit(reason, Instant::now()) {
+                    let renewed = resolve(lent_sources.refused().map(str::to_string));
+                    renewing = Some(Box::pin(auth_refresh::respond(
+                        &agent.profile_id,
+                        renewed,
+                        cancellation,
+                    )));
+                } else if bridge.send(&auth_refresh::unavailable()).await.is_err() {
+                    tracing::debug!("Claude runner closed before its login renewal arrived");
+                }
+            }
+            // A refused long-lived token: reported to the host at once, never answered.
+            Some("auth_rejected") => {
+                if let Some(id) = lent_sources.refuse(&event["credential_id"]) {
+                    auth_refresh::report_refusal(resolve(Some(id)));
+                }
+            }
+            Some("done") => {
+                events::record_usage(session, ctx, &event).await;
+                if let Some(id) = lent_sources.refuse(&event["error"]["credential_id"]) {
+                    auth_refresh::report_refusal(resolve(Some(id)));
+                }
+                if event["status"] != "success" {
+                    if event["status"] == "error" {
+                        tracing::warn!(
+                            code = event["error"]["code"].as_str().unwrap_or("unknown"),
+                            "Claude runner did not complete the turn"
+                        );
+                    }
+                    return Err(failure(
+                        event["error"]["message"]
+                            .as_str()
+                            .unwrap_or("runner did not complete successfully"),
+                    ));
+                }
+                output
+                    .finish(
+                        session,
+                        ctx,
+                        event["result_text"].as_str().unwrap_or_default(),
+                    )
+                    .await;
+                let committed = context::load(session).await?;
+                bridge.send(&json!({"type":"commit","snapshot":context::snapshot(&committed, &ctx.sub_id)})).await?;
+                let ack = tokio::time::timeout(Duration::from_secs(30), bridge.receive())
+                    .await
+                    .map_err(|_| failure("history commit acknowledgement timed out"))??;
+                if ack["type"] != "committed" {
+                    return Err(failure("runner did not acknowledge durable shared history"));
+                }
+                return Ok(());
+            }
+            Some("refused") => {
+                return Err(failure(
+                    event["message"]
+                        .as_str()
+                        .unwrap_or("runner refused the turn"),
+                ));
+            }
+            _ => return Err(failure("runner sent an unexpected protocol message")),
+        }
+    }
+}
