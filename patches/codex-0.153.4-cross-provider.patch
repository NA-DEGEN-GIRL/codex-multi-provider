+    let path = rollout_path(&child).await;
+    let before = std::fs::read(&path).expect("original child bytes");
+    let admission = fixture
+        .root_actor
+        .try_reserve_idle_close()
+        .expect("exclusive root admission");
+    let mut guard = fixture
+        .manager
+        .prepare_managed_cold_drain(
+            &fixture.root_actor,
+            &admission,
+            &[fixture.root.thread_id(), child.thread_id()],
