+#[tokio::test]
+async fn catalog_reads_legacy_and_current_schemas_without_changing_source() -> Result<()> {
+    for version in [44, 47, 52] {
+        let directory =
+            std::env::temp_dir().join(format!("codex-audit-test-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir(&directory)?;
+        let _cleanup = scopeguard::guard(directory.clone(), |path| {
+            let _ = std::fs::remove_dir_all(path);
+        });
+        let sqlite =
+            SqliteConfig::from_sqlite_home(AbsolutePathBuf::from_absolute_path(&directory)?);
+        let pool = sqlx::sqlite::SqlitePoolOptions::new()
+            .max_connections(1)
+            .connect_with(
+                sqlx::sqlite::SqliteConnectOptions::new()
+                    .filename(sqlite.state_db_path())
+                    .create_if_missing(true),
+            )
+            .await?;
+        for migration in crate::migrations::STATE_MIGRATOR.iter() {
+            if migration.version <= version {
+                sqlx::raw_sql(migration.sql.clone()).execute(&pool).await?;
+            }
+        }
+        let first = ThreadId::new();
+        let second = ThreadId::new();
+        for (id, timestamp) in [
+            (first, 1_700_000_000_000_i64),
+            (second, 1_700_000_001_000_i64),
+        ] {
+            sqlx::query(
+                "INSERT INTO threads (id, rollout_path, created_at, updated_at, created_at_ms, updated_at_ms, recency_at_ms, source, model_provider, cwd, title, preview, sandbox_policy, approval_mode) VALUES (?, 'session.jsonl', 1, 1, ?, ?, ?, 'cli', 'openai', '/project', 'task', 'preview', 'read-only', 'never')",
+            )
+            .bind(id.to_string())
+            .bind(timestamp)
+            .bind(timestamp)
+            .bind(timestamp)
+            .execute(&pool)
+            .await?;
+        }
+        sqlx::query(
+            "INSERT INTO thread_spawn_edges (parent_thread_id, child_thread_id, status) VALUES (?, ?, 'completed')",
+        )
+        .bind(first.to_string())
+        .bind(second.to_string())
+        .execute(&pool)
+        .await?;
+        if version >= 45 {
+            sqlx::query(
+                "UPDATE threads SET thread_section_id = '01984de2-8f74-7c91-a3b2-5c5e937cf318'",
+            )
+            .execute(&pool)
+            .await?;
+        }
+        pool.close().await;
+        let before = std::fs::read(sqlite.state_db_path())?;
+        let reader = ReadOnlyThreadState::open(&sqlite).await?;
+        let all = reader.list_threads().await?;
+        assert_eq!(all.len(), 2);
+        assert!(!reader.project_exists("missing-project").await?);
+        for item in &all {
+            assert_eq!(reader.get_thread(item.id).await?, Some(item.clone()));
+            assert_eq!(
+                item.section.as_ref().map(|s| s.name.as_str()),
+                (version >= 45).then_some("Pinned")
+            );
+        }
+        let one = reader.list_metadata_page(None, 1).await?;
+        let two = reader.list_metadata_page(Some(one[0].id), 1).await?;
+        assert_eq!([one, two].concat(), all);
+        let expected_second = all.iter().find(|item| item.id == second).unwrap().clone();
+        if version == 44 {
+            let mut unassigned = filters();
+            unassigned.section = Some(None);
+            unassigned.project_id = Some(None);
+            assert_eq!(
+                reader
+                    .list_threads_page(10, unassigned, None)
+                    .await?
+                    .items
+                    .len(),
+                2
+            );
+            let mut assigned = filters();
+            assigned.section = Some(Some("missing-section"));
+            assert!(
+                reader
+                    .list_threads_page(10, assigned, None)
+                    .await?
+                    .items
+                    .is_empty()
+            );
+            assigned.section = None;
+            assigned.project_id = Some(Some("missing-project"));
+            assert!(
+                reader
+                    .list_threads_page(10, assigned, None)
+                    .await?
+                    .items
+                    .is_empty()
+            );
+        }
+        let page = reader.list_threads_page(1, filters(), None).await?;
+        assert_eq!(page.items, vec![expected_second.clone()]);
+        let mut next_filters = filters();
+        next_filters.anchor = page.next_anchor.as_ref();
+        assert_eq!(
+            reader.list_threads_page(1, next_filters, None).await?.items,
+            vec![all.iter().find(|item| item.id == first).unwrap().clone()]
+        );
+        for relation in [
+            ThreadRelationFilter::DirectChildrenOf(first),
+            ThreadRelationFilter::DescendantsOf(first),
+        ] {
+            let page = reader
+                .list_threads_page(10, filters(), Some(relation))
+                .await?;
+            assert_eq!(page.items, vec![expected_second.clone()]);
+            assert_eq!(page.parent_thread_ids, [(second, first)].into());
+        }
+        reader.close().await;
+        assert_eq!(std::fs::read(sqlite.state_db_path())?, before);
+    }
+    Ok(())
+}
