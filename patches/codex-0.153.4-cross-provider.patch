+    let viewer = ManagedProfile::new(&api.uri(), "viewer-model", "viewer-token")?;
+    viewer.write_manifest(&[&viewer], Vec::new())?;
+    let source = TempDir::new()?;
+    let (readable_id, readable_path) = legacy_record(source.path(), "2025-01-05T12-00-00")?;
+    let original_rollout = fs::read(&readable_path)?;
+    let state = codex_state::StateRuntime::init(
+        SqliteConfig::from_sqlite_home(source.path().abs()),
+        "openai".to_string(),
+    )
+    .await?;
+    let mut latest = None;
+    for index in 0..5001 {
+        let id = if index == 0 {
+            codex_protocol::ThreadId::from_string(&readable_id)?
+        } else {
+            codex_protocol::ThreadId::from_string(
+                &Uuid::from_u128(0x71000000000000000000000000000000 + index).to_string(),
+            )?
+        };
+        let path = if index == 0 {
+            readable_path.clone()
+        } else {
+            source
+                .path()
+                .join("sessions")
+                .join(format!("missing-{id}.jsonl"))
+        };
+        let created = chrono::DateTime::from_timestamp(1_735_732_800 + index as i64, 0)
+            .context("fixture timestamp")?;
+        let mut metadata = codex_state::ThreadMetadataBuilder::new(
+            id,
+            path,
+            created,
+            codex_protocol::protocol::SessionSource::Cli,
+        )
+        .build("openai");
+        metadata.cwd = source.path().to_path_buf();
+        if index == 1 {
+            metadata.source =
+                serde_json::to_string(&codex_protocol::protocol::SessionSource::SubAgent(
+                    codex_protocol::protocol::SubAgentSource::ThreadSpawn {
+                        parent_thread_id: codex_protocol::ThreadId::new(),
+                        depth: 1,
+                        agent_path: None,
+                        agent_nickname: Some("Orphan reader".to_string()),
+                        agent_role: None,
+                    },
+                ))?;
+        }
+        metadata.title = format!("Existing record {index}");
+        metadata.name = Some(metadata.title.clone());
+        metadata.first_user_message = Some(metadata.title.clone());
+        state.upsert_thread(&metadata).await?;
+        latest = Some(metadata);
+    }
+    let descriptor = legacy_source(source.path());
+    let catalog = viewer.home.path().join("large-mixed.json");
+    fs::write(
+        &catalog,
+        serde_json::to_vec(&json!({
+            "version":3,"hostId":"local","sources":[],"legacySources":[descriptor]
+        }))?,
+    )?;
+    let mut reader = super::catalog_sources::start_shared(&viewer, &catalog).await?;
+    let mut cursor = None;
+    let mut seen = std::collections::HashSet::new();
+    let started = std::time::Instant::now();
+    loop {
+        let request = reader
+            .send_raw_request(
+                "thread/list",
+                Some(json!({
+                    "limit":137,"cursor":cursor,"sourceKinds":["cli","subAgent"]
+                })),
+            )
+            .await?;
+        let page: ThreadListResponse =
+            timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+        assert!(page.data.len() <= 137);
+        for thread in page.data {
+            assert!(seen.insert(thread.id));
+            assert_eq!(thread.can_accept_direct_input, Some(false));
+            assert!(thread.path.is_none());
+        }
+        if seen.len() == 137 {
+            // Newer records must not invalidate the cursor for older history.
+            let mut newer = latest.clone().context("seeded source metadata")?;
+            newer.id = codex_protocol::ThreadId::new();
+            newer.created_at = chrono::Utc::now();
+            newer.updated_at = newer.created_at;
+            newer.recency_at = newer.created_at;
+            newer.rollout_path = source.path().join("sessions/newer-missing.jsonl");
+            state.upsert_thread(&newer).await?;
+            let newer_projected = projection(&descriptor, &newer.id.to_string())?;
+            timeout(READ_TIMEOUT, async {
+                loop {
+                    let fresh = super::catalog_sources::list(&mut reader).await?;
+                    if fresh
+                        .data
+                        .first()
+                        .is_some_and(|thread| thread.id == newer_projected)
+                    {
+                        break Ok::<_, anyhow::Error>(());
+                    }
+                    tokio::time::sleep(Duration::from_millis(250)).await;
+                }
+            })
+            .await??;
+        }
+        cursor = page.next_cursor;
+        if cursor.is_none() {
+            break;
+        }
+    }
+    assert_eq!(seen.len(), 5001);
+    eprintln!("5001 catalog records paged in {:?}", started.elapsed());
+    let request = reader
+        .send_raw_request(
+            "thread/read",
+            Some(json!({
+                "threadId":projection(&descriptor, &readable_id)?,"includeTurns":false
+            })),
+        )
+        .await?;
+    let readable: ThreadReadResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert_eq!(
+        readable
+            .thread
+            .extra
+            .context("record origin")?
+            .managed_record
+            .context("managed origin")?
+            .canonical_thread_id,
+        readable_id
+    );
+
+    let mut latest = latest.context("seeded source metadata")?;
+    let projected = projection(&descriptor, &latest.id.to_string())?;
+    let request = reader
+        .send_raw_request(
+            "thread/read",
+            Some(json!({
+                "threadId":projected,"includeTurns":false
+            })),
+        )
+        .await?;
+    let _missing = timeout(
+        READ_TIMEOUT,
+        reader.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    // A damaged/unavailable history file affects opening that record, not listing others.
+    latest.name = Some("Updated after first complete scan".to_string());
+    latest.title = latest.name.clone().context("updated legacy title")?;
+    state.upsert_thread(&latest).await?;
+    timeout(READ_TIMEOUT, async {
+        loop {
+            let listed = super::catalog_sources::list(&mut reader).await?;
+            if listed.data.iter().any(|thread| {
+                thread.id == projected && thread.name.as_deref() == latest.name.as_deref()
+            }) {
+                break Ok::<_, anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(250)).await;
+        }
+    })
+    .await??;
+    let request = reader
+        .send_raw_request("thread/loaded/list", Some(json!({})))
+        .await?;
+    let loaded: ThreadLoadedListResponse =
+        timeout(READ_TIMEOUT, reader.read_response(request)).await??;
+    assert!(loaded.data.is_empty());
+    assert_eq!(fs::read(&readable_path)?, original_rollout);
+    assert!(!source.path().join("managed-source.json").exists());
+    assert!(!source.path().join("auth.json").exists());
+    state.close().await;
+    Ok(())
+}
