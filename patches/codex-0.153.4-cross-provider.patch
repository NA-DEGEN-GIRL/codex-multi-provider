@@ -0,0 +1,260 @@
+//! Instance activity that survives a transport disconnect. A response and the
+//! last handler reference must both finish before a request stops counting.
+//! These counters support maintenance preflight; they are not an idle proof for
+//! model actors, queued user input, or other background services.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_diagnostics::Gauge;
+use codex_diagnostics::GaugeGuard;
+
+use crate::error_code::invalid_request;
+use crate::outgoing_message::ConnectionRequestId;
+
+const MAX_PENDING: usize = 4096;
+static REQUESTS: Gauge = Gauge::new("app.managed.requests.pending_completion");
+static PROCESSES: Gauge = Gauge::new("app.managed.processes.running");
+static LOGINS: Gauge = Gauge::new("app.managed.logins.running");
+static SETUPS: Gauge = Gauge::new("app.managed.sandbox_setups.running");
+
+#[derive(Clone, Default)]
+pub(crate) struct ManagedInstanceActivity {
+    state: Arc<Mutex<ActivityState>>,
+}
+
+#[derive(Default)]
+struct ActivityState {
+    frozen: bool,
+    requests: HashMap<ConnectionRequestId, PendingRequest>,
+    processes: usize,
+    background: HashMap<ManagedBackgroundKind, usize>,
+}
+
+struct PendingRequest {
+    response_finished: bool,
+    handler_finished: bool,
+    _gauge: GaugeGuard,
+}
+
+pub(crate) struct ManagedRequestActivity {
+    activity: ManagedInstanceActivity,
+    id: ConnectionRequestId,
+}
+
+/// Blocks admission on every connection while the caller verifies actor drain.
+/// Dropping before commit restores admission; it never stops existing work.
+pub(crate) struct ManagedMaintenanceGuard {
+    activity: ManagedInstanceActivity,
+    committed: bool,
+}
+
+pub(crate) struct ManagedProcessActivity {
+    activity: ManagedInstanceActivity,
+    _gauge: GaugeGuard,
+}
+
+#[derive(Clone, Copy, Eq, Hash, PartialEq)]
+pub(crate) enum ManagedBackgroundKind {
+    Login,
+    SandboxSetup,
+}
+
+pub(crate) struct ManagedBackgroundActivity {
+    activity: ManagedInstanceActivity,
+    kind: ManagedBackgroundKind,
+    _gauge: GaugeGuard,
+}
+
+impl ManagedInstanceActivity {
+    pub(crate) fn begin_request(
+        &self,
+        id: ConnectionRequestId,
+    ) -> Result<ManagedRequestActivity, JSONRPCErrorError> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.frozen {
+            return Err(invalid_request(
+                "managed instance maintenance is in progress",
+            ));
+        }
+        if state.requests.contains_key(&id) {
+            return Err(invalid_request(
+                "request ID is still active on this connection",
+            ));
+        }
+        if state.requests.len() >= MAX_PENDING {
+            return Err(invalid_request(
+                "managed instance has too many unfinished requests",
+            ));
+        }
+        state.requests.insert(
+            id.clone(),
+            PendingRequest {
+                response_finished: false,
+                handler_finished: false,
+                _gauge: REQUESTS.track(),
+            },
+        );
+        Ok(ManagedRequestActivity {
+            activity: self.clone(),
+            id,
+        })
+    }
+
+    pub(crate) fn response_finished(&self, id: &ConnectionRequestId) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(request) = state.requests.get_mut(id) {
+            request.response_finished = true;
+            if request.handler_finished {
+                state.requests.remove(id);
+            }
+        }
+    }
+
+    pub(crate) fn begin_process(&self) -> Result<ManagedProcessActivity, JSONRPCErrorError> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.frozen {
+            return Err(invalid_request(
+                "managed instance maintenance is in progress",
+            ));
+        }
+        if state.processes >= MAX_PENDING {
+            return Err(invalid_request(
+                "managed instance has too many active processes",
+            ));
+        }
+        state.processes += 1;
+        Ok(ManagedProcessActivity {
+            activity: self.clone(),
+            _gauge: PROCESSES.track(),
+        })
+    }
+
+    pub(crate) fn begin_background(
+        &self,
+        kind: ManagedBackgroundKind,
+    ) -> Result<ManagedBackgroundActivity, JSONRPCErrorError> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.frozen {
+            return Err(invalid_request(
+                "managed instance maintenance is in progress",
+            ));
+        }
+        if state.background.values().sum::<usize>() >= MAX_PENDING {
+            return Err(invalid_request(
+                "managed instance has too many background operations",
+            ));
+        }
+        *state.background.entry(kind).or_default() += 1;
+        let gauge = match kind {
+            ManagedBackgroundKind::Login => &LOGINS,
+            ManagedBackgroundKind::SandboxSetup => &SETUPS,
+        };
+        Ok(ManagedBackgroundActivity {
+            activity: self.clone(),
+            kind,
+            _gauge: gauge.track(),
+        })
+    }
+
+    pub(crate) fn try_freeze(
+        &self,
+        request_id: &ConnectionRequestId,
+    ) -> Result<ManagedMaintenanceGuard, JSONRPCErrorError> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.frozen
+            || state.requests.len() != 1
+            || !state.requests.contains_key(request_id)
+            || state.processes != 0
+            || state.background.values().any(|count| *count != 0)
+        {
+            return Err(invalid_request(
+                "managed instance still has requests or operations in flight",
+            ));
+        }
+        state.frozen = true;
+        Ok(ManagedMaintenanceGuard {
+            activity: self.clone(),
+            committed: false,
+        })
+    }
+}
+
+impl ManagedMaintenanceGuard {
+    pub(crate) fn commit(mut self) {
+        self.committed = true;
+    }
+}
+
+impl Drop for ManagedMaintenanceGuard {
+    fn drop(&mut self) {
+        if !self.committed {
+            self.activity
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .frozen = false;
+        }
+    }
+}
+
+impl Drop for ManagedRequestActivity {
+    fn drop(&mut self) {
+        let mut state = self
+            .activity
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(request) = state.requests.get_mut(&self.id) {
+            request.handler_finished = true;
+            if request.response_finished {
+                state.requests.remove(&self.id);
+            }
+        }
+    }
+}
+
+impl Drop for ManagedProcessActivity {
+    fn drop(&mut self) {
+        let mut state = self
+            .activity
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.processes -= 1;
+    }
+}
+
+impl Drop for ManagedBackgroundActivity {
+    fn drop(&mut self) {
+        let mut state = self
+            .activity
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(count) = state.background.get_mut(&self.kind) {
+            *count -= 1;
+        }
+    }
+}
+
