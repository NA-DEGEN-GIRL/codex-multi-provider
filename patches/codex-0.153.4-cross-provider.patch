+                source_id: source_id.clone(),
+                config: LocalThreadStoreConfig {
+                    codex_home: root.clone(),
+                    sqlite: codex_state::SqliteConfig::new_for_testing(root.abs()),
+                    default_model_provider_id: "source-provider".to_string(),
+                },
+            }],
+        )?;
+        let thread_id = test_thread_id()?;
+        let binding = registry.bind_new(&source_id, thread_id).await?;
+        let reservation = binding.prepare_writer().await?;
+        let store = binding.store();
+        store
+            .create_thread(CreateThreadParams {
+                session_id: thread_id.into(),
+                thread_id,
+                extra_config: None,
+                forked_from_id: None,
