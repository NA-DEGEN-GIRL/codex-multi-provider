+async fn snapshot(app: &mut TestAppServer, thread_id: &str) -> Result<Value> {
+    let request_id = app
+        .send_raw_request(
+            "thread/managedIdleStatus",
+            Some(json!({ "threadId": thread_id })),
+        )
+        .await?;
+    timeout(READ_TIMEOUT, app.read_response(request_id)).await?
