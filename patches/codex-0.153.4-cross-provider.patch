+//! Explicit same-host sources used by managed profile handoffs.
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use codex_protocol::ThreadId;
+use codex_rollout::StateDbHandle;
+use serde::Deserialize;
+use serde::Serialize;
+use tokio::sync::OnceCell;
+
+use crate::LocalThreadStore;
+use crate::LocalThreadStoreConfig;
+use crate::ManagedAuthorityGrant;
+use crate::ManagedWritePermit;
+use crate::ManagedWriterReservation;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+use crate::managed_authority::ManagedAuthority;
+
+/// Stable source identity. Paths and account aliases are never record identities.
+#[derive(Clone, Debug, Deserialize, Eq, Hash, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedSourceId {
+    pub host_id: String,
+    pub store_id: String,
+}
+
+/// A source explicitly admitted by the host's user-owned managed-source allowlist.
+pub struct ManagedSourceRegistration {
+    pub source_id: ManagedSourceId,
+    pub config: LocalThreadStoreConfig,
+}
+
+struct ManagedSource {
+    id: ManagedSourceId,
+    config: LocalThreadStoreConfig,
+    state_db: Arc<OnceCell<StateDbHandle>>,
+}
+
+/// Validated, immutable same-host source registry. It never registers original homes implicitly.
+pub struct ManagedSourceRegistry {
+    sources: HashMap<ManagedSourceId, Arc<ManagedSource>>,
+    profile_id: String,
+}
+
+/// Persistence-only binding; target account credentials and runtime configuration stay separate.
+#[derive(Clone)]
+pub struct ManagedThreadBinding {
+    source: Arc<ManagedSource>,
+    thread_id: ThreadId,
+    store: Arc<LocalThreadStore>,
+    grant: ManagedAuthorityGrant,
+}
+
+fn invalid(message: impl Into<String>) -> ThreadStoreError {
+    ThreadStoreError::InvalidRequest {
+        message: message.into(),
+    }
+}
+
+fn validate_source(id: &ManagedSourceId, config: &LocalThreadStoreConfig) -> ThreadStoreResult<()> {
+    let home = std::fs::canonicalize(&config.codex_home)
+        .map_err(|error| invalid(format!("managed source root is unavailable: {error}")))?;
+    let sqlite_home = std::fs::canonicalize(config.sqlite.home())
+        .map_err(|error| invalid(format!("managed SQLite root is unavailable: {error}")))?;
+    if home != config.codex_home || home != sqlite_home {
+        return Err(invalid(
+            "managed source root changed or SQLite is outside the registered root",
+        ));
+    }
+    let marker = std::fs::read(home.join("managed-source.json"))
+        .map_err(|error| invalid(format!("managed source marker is unavailable: {error}")))?;
+    if marker.len() > 4096 {
+        return Err(invalid("managed source marker exceeds 4096 bytes"));
+    }
+    let actual: ManagedSourceId = serde_json::from_slice(&marker)
+        .map_err(|error| invalid(format!("invalid managed source marker: {error}")))?;
+    if &actual != id {
+        return Err(invalid(
+            "managed source marker identity does not match the allowlist",
+        ));
+    }
+    Ok(())
+}
+
+impl ManagedSourceRegistry {
+    /// Validate every source before initializing any SQLite database.
+    pub fn new(
+        host_id: String,
+        profile_id: String,
+        registrations: Vec<ManagedSourceRegistration>,
+    ) -> ThreadStoreResult<Self> {
+        if host_id.trim().is_empty() || ThreadId::from_string(&profile_id).is_err() {
+            return Err(invalid(
+                "managed source host or caller profile identity is invalid",
+            ));
+        }
+        let mut sources = HashMap::new();
+        let mut homes = HashSet::<PathBuf>::new();
+        for registration in registrations {
+            let ManagedSourceRegistration {
+                source_id,
+                mut config,
+            } = registration;
+            if source_id.host_id != host_id
+                || source_id
+                    .store_id
+                    .strip_prefix("manager:")
+                    .is_none_or(|id| ThreadId::from_string(id).is_err())
+            {
+                return Err(invalid(
+                    "managed source requires a same-host identity and manager:UUID store ID",
+                ));
+            }
+            config.codex_home = std::fs::canonicalize(&config.codex_home)
+                .map_err(|error| invalid(format!("managed source root is unavailable: {error}")))?;
+            validate_source(&source_id, &config)?;
+            config.sqlite = codex_state::SqliteConfig::from_sqlite_home(
+                codex_utils_absolute_path::AbsolutePathBuf::try_from(config.codex_home.clone())
+                    .map_err(|error| invalid(format!("invalid managed source root: {error}")))?,
+            );
+            if sources.contains_key(&source_id) || !homes.insert(config.codex_home.clone()) {
+                return Err(invalid("duplicate managed source identity or root"));
+            }
+            sources.insert(
+                source_id.clone(),
+                Arc::new(ManagedSource {
+                    id: source_id,
+                    config,
+                    state_db: Arc::new(OnceCell::new()),
+                }),
+            );
+        }
+        Ok(Self {
+            sources,
+            profile_id,
+        })
+    }
+
+    /// Validate ownership without opening a database or acquiring a writer.
+    pub fn validate_owner_authority(
+        &self,
+        source_id: &ManagedSourceId,
+        thread_id: ThreadId,
+        grant: &ManagedAuthorityGrant,
+    ) -> ThreadStoreResult<()> {
+        let source = self
+            .sources
+            .get(source_id)
+            .ok_or_else(|| invalid("managed source is not in the user-owned allowlist"))?;
+        validate_source(&source.id, &source.config)?;
+        if grant.owner_profile_id != self.profile_id {
+            return Err(invalid(
+                "managed authority grant belongs to another runtime profile",
+            ));
+        }
+        ManagedAuthority::from_grant(&source.config.codex_home, source_id, thread_id, grant)?
+            .validate()
+    }
+
+    /// Bind an existing grant. Missing authority is never created on a resume path.
+    pub async fn bind(
+        &self,
+        source_id: &ManagedSourceId,
+        thread_id: ThreadId,
+        grant: ManagedAuthorityGrant,
+    ) -> ThreadStoreResult<ManagedThreadBinding> {
+        self.validate_owner_authority(source_id, thread_id, &grant)?;
+        let source = self
+            .sources
+            .get(source_id)
+            .ok_or_else(|| invalid("managed source is not in the user-owned allowlist"))?;
+        Self::bind_validated(source, thread_id, grant).await
+    }
+
+    /// Admit a freshly allocated native root only in the current runtime profile's own source.
+    pub async fn bind_new(
+        &self,
+        source_id: &ManagedSourceId,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<ManagedThreadBinding> {
+        if source_id.store_id != format!("manager:{}", self.profile_id) {
+            return Err(invalid(
+                "fresh native threads require the current profile's own source",
+            ));
+        }
+        let source = self
+            .sources
+            .get(source_id)
+            .ok_or_else(|| invalid("managed source is not in the user-owned allowlist"))?;
+        validate_source(&source.id, &source.config)?;
+        let grant = ManagedAuthorityGrant {
+            owner_profile_id: self.profile_id.clone(),
+            epoch: 1,
+            revision: 1,
+        };
+        ManagedAuthority::from_grant(&source.config.codex_home, source_id, thread_id, &grant)?
+            .create_new()?;
+        self.bind(source_id, thread_id, grant).await
+    }
+
+    async fn bind_validated(
+        source: &Arc<ManagedSource>,
+        thread_id: ThreadId,
+        grant: ManagedAuthorityGrant,
+    ) -> ThreadStoreResult<ManagedThreadBinding> {
+        let authority =
+            ManagedAuthority::from_grant(&source.config.codex_home, &source.id, thread_id, &grant)?;
+        let _authority_lease = authority.write_guard()?;
+        validate_source(&source.id, &source.config)?;
+        authority.validate()?;
+        let store = LocalThreadStore::new(source.config.clone(), /*state_db*/ None)
+            .with_deferred_state_db(Arc::clone(&source.state_db))
+            .with_managed_thread_authority(thread_id, authority);
+        Ok(ManagedThreadBinding {
+            source: Arc::clone(source),
+            thread_id,
+            store: Arc::new(store),
+            grant,
+        })
+    }
+}
+
+impl ManagedThreadBinding {
+    pub fn source_id(&self) -> &ManagedSourceId {
+        &self.source.id
+    }
+
+    pub fn thread_id(&self) -> ThreadId {
+        self.thread_id
+    }
+
+    pub fn authority_grant(&self) -> &ManagedAuthorityGrant {
+        &self.grant
+    }
+
+    /// Successful local close is monotonic; this snapshot does not replace a write permit.
+    pub fn is_released(&self) -> bool {
+        self.store.managed_scope_released()
+    }
+
+    pub fn source_config(&self) -> &LocalThreadStoreConfig {
+        &self.source.config
+    }
+
+    pub fn store(&self) -> Arc<LocalThreadStore> {
+        Arc::clone(&self.store)
+    }
+
+    /// Reserve the canonical writer before initializing mutable state or staging resume history.
+    /// Keep the reservation alive until the live recorder has consumed its exact OS lock.
+    pub async fn prepare_writer(&self) -> ThreadStoreResult<ManagedWriterReservation> {
+        validate_source(&self.source.id, &self.source.config)?;
+        self.store.prepare_managed_writer(self.thread_id).await
+    }
+
+    /// Fence associated queue/goal writes against successful persistence release.
+    /// The caller must additionally require the thread actor to own its live writer.
+    pub async fn write_permit(&self) -> ThreadStoreResult<ManagedWritePermit> {
+        self.store.managed_write_permit(self.thread_id).await
+    }
+
+    /// Reserve an associated write only while this binding owns the canonical live recorder.
+    pub async fn live_write_permit(&self) -> ThreadStoreResult<ManagedWritePermit> {
+        let permit = self.write_permit().await?;
+        self.store.live_rollout_path(self.thread_id).await?;
+        Ok(permit)
+    }
+
+    /// Verify point-in-time recorder-lock absence; this is not a drain or close proof.
+    pub async fn verify_writer_absent(&self) -> ThreadStoreResult<()> {
+        self.store
+            .verify_managed_writer_absent(self.thread_id)
+            .await
+    }
+
+    /// Bind an existing descendant grant without implicitly creating or transferring ownership.
+    pub async fn for_child(&self, thread_id: ThreadId) -> ThreadStoreResult<Self> {
+        let _parent_permit = self.write_permit().await?;
+        validate_source(&self.source.id, &self.source.config)?;
+        let grant = ManagedAuthority::descendant_grant(
+            &self.source.config.codex_home,
+            &self.source.id,
+            thread_id,
+            &self.grant.owner_profile_id,
+        )?;
+        ManagedSourceRegistry::bind_validated(&self.source, thread_id, grant).await
+    }
+
+    /// A live parent may allocate a new descendant on its canonical source under its own owner.
+    pub async fn for_new_child(&self, thread_id: ThreadId) -> ThreadStoreResult<Self> {
+        let _parent_permit = self.live_write_permit().await?;
+        validate_source(&self.source.id, &self.source.config)?;
+        let grant = ManagedAuthorityGrant {
+            owner_profile_id: self.grant.owner_profile_id.clone(),
+            epoch: 1,
+            revision: 1,
+        };
+        ManagedAuthority::from_grant(
+            &self.source.config.codex_home,
+            &self.source.id,
+            thread_id,
+            &grant,
+        )?
+        .create_new()?;
+        ManagedSourceRegistry::bind_validated(&self.source, thread_id, grant).await
+    }
+}
+
+#[cfg(test)]
+#[path = "managed_source_tests.rs"]
+mod tests;
