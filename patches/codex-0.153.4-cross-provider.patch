+        run_turn(&mut mcp, &thread_id, "gpt second question").await?;
+
+        // GPT to DeepSeek and back, then again to DeepSeek; each switch is followed by plain
+        // resumes on the same family.
+        for (provider, model, question) in [
+            (DEEPSEEK_PROVIDER, DEEPSEEK_MODEL, "deepseek question"),
+            (GPT_PROVIDER, GPT_MODEL, "gpt question"),
+            (DEEPSEEK_PROVIDER, DEEPSEEK_MODEL, "deepseek again"),
+        ] {
+            let mut previous_input: Option<Vec<Value>> = None;
+            for resume in 0..3 {
+                let start = mock.request_count();
+                mcp = resume_on(
+                    codex_home.path(),
+                    mcp,
+                    &thread_id,
+                    provider,
+                    model,
+                    /*auto_compact_limit*/ None,
+                )
+                .await?;
+                run_turn(&mut mcp, &thread_id, &format!("{question} {resume}")).await?;
+                let request = mock.first_request_since(start, model);
+                let label = format!("{history_mode:?} {model} resume {resume}");
+                // What the model saw before is replayed as it was: one context bundle and at most
+                // the newest model-switch message, never the copies earlier rebuilds left out.
+                assert_eq!(occurrences(&request, PERMISSIONS_MARKER), 1, "{label}");
+                assert!(occurrences(&request, "<model_switch>") <= 1, "{label}");
+                assert_eq!(
+                    occurrences(&request, "GPT REPLY TO gpt second question"),
+                    1,
+                    "{label}"
+                );
+                if model == GPT_MODEL {
+                    assert_eq!(occurrences(&request, GPT_CHECKPOINT), 1, "{label}");
+                    assert_eq!(reasoning_without_encrypted_state(&request), 0, "{label}");
+                } else {
+                    assert_has_no_openai_state(&request);
+                }
+                // A plain resume extends the previous request instead of rewriting its history.
+                let input = request["input"].as_array().cloned().unwrap_or_default();
+                if let Some(previous) = &previous_input {
+                    assert!(
+                        input.starts_with(previous),
+                        "{label}: history was rewritten"
+                    );
+                }
+                previous_input = Some(input);
+            }
+        }
+        timeout(DEFAULT_READ_TIMEOUT, mcp.shutdown_gracefully()).await??;
+    }
+    Ok(())
+}
