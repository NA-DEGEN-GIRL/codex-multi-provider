+    let (mut owner, root_id, worker_id) = fixture.start_owner_with_idle_worker().await?;
+    fixture.append_turn_from_other_app(&root_id).await?;
+    let mut both = vec![root_id.clone(), worker_id.clone()];
+    both.sort();
+    assert_eq!(loaded_ids(&mut owner).await?, both);
+
+    // The worker is idle, so the refresh closes it before replacing the root
+    // instead of refusing because a descendant actor is still loaded.
+    assert_refreshed_without_worker(&fixture, &mut owner, &root_id, &worker_id).await?;
+
+    // The closed worker kept its record and open spawn edge: the reloaded root
+    // reaches it again, and it resumes with its own earlier history.
+    let worker_request = fixture.reach_worker_again(&mut owner, &root_id).await?;
+    assert!(
+        worker_request.contains(CHILD_PROMPT) && worker_request.contains(WORKER_RESULT),
+        "{worker_request}"
+    );
+    Ok(())
