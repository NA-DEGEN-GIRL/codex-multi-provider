+fn pending_store() -> (TempDir, LocalThreadStore, ThreadId, PathBuf) {
+    let home = TempDir::new().expect("temporary canonical source");
+    let uuid = uuid::Uuid::now_v7();
+    let thread_id = ThreadId::from_string(&uuid.to_string()).expect("source thread ID");
+    let rollout_path =
+        write_session_file(home.path(), "2025-01-04T11-30-00", uuid).expect("source rollout");
+    let store = LocalThreadStore::new(test_config(home.path()), /*state_db*/ None)
+        .with_managed_thread_scope(thread_id);
+    (home, store, thread_id, rollout_path)
+}
+
+fn resume_params(thread_id: ThreadId, rollout_path: PathBuf, home: &Path) -> ResumeThreadParams {
+    ResumeThreadParams {
+        thread_id,
+        rollout_path: Some(rollout_path),
+        history: None,
+        include_archived: true,
+        metadata: ThreadPersistenceMetadata {
+            cwd: Some(home.to_path_buf()),
+            model_provider: "test-provider".to_string(),
+            memory_mode: ThreadMemoryMode::Enabled,
+        },
+    }
+}
+
+async fn close_state_db(store: &LocalThreadStore) {
+    if let Some(state_db) = store.state_db().await {
+        state_db.close().await;
+    }
+}
+
+#[tokio::test]
+async fn competing_os_writer_rejects_preparation_before_state_or_rollout_changes() {
+    let (home, store, thread_id, rollout_path) = pending_store();
+    let original = std::fs::read(&rollout_path).expect("source bytes");
+    let competing = LocalThreadStore::new(test_config(home.path()), /*state_db*/ None);
+    let _writer = competing
+        .writer_lock_coordinator
+        .acquire(thread_id)
+        .expect("independent source writer");
+
+    assert!(matches!(
+        store.prepare_managed_writer(thread_id).await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+    assert!(store.state_db().await.is_none());
+    assert_eq!(std::fs::read(rollout_path).expect("source bytes"), original);
+}
