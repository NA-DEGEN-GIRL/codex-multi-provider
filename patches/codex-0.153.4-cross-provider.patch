+impl RecordCatalog {
+    pub(crate) async fn from_environment() -> Result<Option<Self>, JSONRPCErrorError> {
+        match (
+            std::env::var_os(CATALOG_ENV),
+            std::env::var_os(SHARED_CATALOG_ENV),
+        ) {
+            (Some(path), None) => Self::load(Path::new(&path)).await.map(Some),
+            (None, Some(path)) => {
+                let mut catalog = Self::load(Path::new(&path)).await?;
+                catalog.mode = CatalogMode::Shared;
+                if let Some(path) = std::env::var_os("CODEX_MANAGER_PROJECT_ALIASES") {
+                    catalog.project_aliases =
+                        projects::ProjectAliases::load(Path::new(&path)).await?;
+                }
+                Ok(Some(catalog))
+            }
+            (None, None) => Ok(None),
+            (Some(_), Some(_)) => Err(invalid_request(
+                "choose a shared catalog or a catalog viewer",
+            )),
+        }
+    }
+
+    pub(crate) fn is_shared(&self) -> bool {
+        self.mode == CatalogMode::Shared
+    }
+
+    pub(crate) fn handles_thread(&self, thread_id: &str) -> bool {
+        !self.is_shared() || self.source(thread_id).is_ok()
+    }
+
+    fn references_projection(&self, request: &ClientRequest) -> Result<bool, JSONRPCErrorError> {
+        fn inspect(catalog: &RecordCatalog, value: &serde_json::Value) -> bool {
+            match value {
+                serde_json::Value::Object(fields) => fields.iter().any(|(key, value)| {
+                    let reference = matches!(
+                        key.as_str(),
+                        "threadId"
+                            | "threadIds"
+                            | "conversationId"
+                            | "beforeThreadId"
+                            | "parentThreadId"
+                            | "ancestorThreadId"
+                    );
+                    if reference {
+                        value.as_str().is_some_and(|id| catalog.source(id).is_ok())
+                            || value.as_array().is_some_and(|values| {
+                                values.iter().any(|value| {
+                                    value.as_str().is_some_and(|id| catalog.source(id).is_ok())
+                                })
+                            })
+                    } else {
+                        inspect(catalog, value)
+                    }
+                }),
+                serde_json::Value::Array(values) => {
+                    values.iter().any(|value| inspect(catalog, value))
+                }
+                _ => false,
+            }
+        }
+        let value = serde_json::to_value(request).map_err(|error| {
+            invalid_request(format!("cannot inspect shared record request: {error}"))
+        })?;
+        Ok(inspect(self, &value))
+    }
+
+    async fn load(path: &Path) -> Result<Self, JSONRPCErrorError> {
+        let metadata = tokio::fs::metadata(path)
+            .await
+            .map_err(|err| invalid_request(format!("record catalog unavailable: {err}")))?;
+        if !metadata.is_file() || metadata.len() > MAX_MANIFEST_BYTES {
+            return Err(invalid_request(
+                "record catalog must be a file of at most 4 MiB",
+            ));
+        }
+        let bytes = tokio::fs::read(path)
+            .await
+            .map_err(|err| invalid_request(format!("record catalog unavailable: {err}")))?;
+        if bytes.len() as u64 > MAX_MANIFEST_BYTES {
+            return Err(invalid_request("record catalog exceeds 4 MiB"));
+        }
+        let version: serde_json::Value = serde_json::from_slice(&bytes)
+            .map_err(|err| invalid_request(format!("invalid record catalog: {err}")))?;
+        let mut catalog: Self = if matches!(
+            version.get("version").and_then(serde_json::Value::as_u64),
+            Some(2 | 3)
+        ) {
+            sources::discover(path, &bytes).await?
+        } else {
+            serde_json::from_slice(&bytes)
+                .map_err(|err| invalid_request(format!("invalid record catalog: {err}")))?
+        };
+        catalog.validate()?;
+        catalog.validated_homes().await?;
+        catalog.shared_routes =
+            shared_routes::SharedRoutes::load(Arc::clone(&catalog.entries)).await?;
+        catalog.revision.push_str(&catalog.shared_routes.revision());
+        Ok(catalog)
+    }
+
+    fn validate(&self) -> Result<(), JSONRPCErrorError> {
+        if self.version != 1
+            || self.revision.is_empty()
+            || self.host_id.is_empty()
+            || (self.discovered.is_none() && self.entries.len() > MAX_ENTRIES)
+        {
+            return Err(invalid_request(
+                "unsupported record catalog version, revision, host, or size",
+            ));
+        }
+        let mut projections = HashSet::new();
+        let mut canonical = HashSet::new();
+        let native_ids = self
+            .entries
+            .iter()
+            .map(|entry| entry.thread_id)
+            .collect::<HashSet<_>>();
+        for entry in self.entries.iter() {
+            if entry.host_id != self.host_id
+                || entry.source_store_id.is_empty()
+                || !entry.codex_home.is_absolute()
+                || !entry.rollout_path.is_absolute()
+                || !projections.insert(entry.projection_thread_id)
+                || native_ids.contains(&entry.projection_thread_id)
+                || !canonical.insert((&entry.host_id, &entry.source_store_id, entry.thread_id))
+            {
+                return Err(invalid_request(
+                    "ambiguous or invalid canonical record mapping",
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    async fn validated_homes(&self) -> Result<&HashMap<PathBuf, PathBuf>, JSONRPCErrorError> {
+        self.canonical_homes
+            .get_or_try_init(|| async {
+                self.validate()?;
+                let mut homes = HashMap::new();
+                let mut store_homes = HashMap::new();
+                let mut home_stores = HashMap::new();
+                for entry in self.entries.iter() {
+                    if !homes.contains_key(&entry.codex_home) {
+                        let home =
+                            tokio::fs::canonicalize(&entry.codex_home)
+                                .await
+                                .map_err(|err| {
+                                    invalid_request(format!("canonical store unavailable: {err}"))
+                                })?;
+                        if !tokio::fs::metadata(&home)
+                            .await
+                            .map_err(|err| {
+                                invalid_request(format!("canonical store unavailable: {err}"))
+                            })?
+                            .is_dir()
+                        {
+                            return Err(invalid_request(
+                                "canonical store home must be a directory",
+                            ));
+                        }
+                        homes.insert(entry.codex_home.clone(), home);
+                    }
+                    let home = &homes[&entry.codex_home];
+                    let store = (&entry.host_id, &entry.source_store_id);
+                    if let Some(previous_home) = store_homes.insert(store, home.clone())
+                        && previous_home != *home
+                    {
+                        return Err(invalid_request(
+                            "canonical store identity maps to multiple homes",
+                        ));
+                    }
+                    if let Some(previous_store) = home_stores.insert(home.clone(), store)
+                        && previous_store != store
+                    {
+                        return Err(invalid_request(
+                            "canonical store home has multiple identities",
+                        ));
+                    }
+                }
+                Ok(homes)
+            })
+            .await
+    }
+
+    /// Reject writes and unsupported foreign-context reads before dispatch can
+    /// acquire a writer or start an MCP stream. This entire opt-in instance is
+    /// a catalog viewer, including records owned by its authenticated account.
+    pub(crate) fn guard(&self, request: &ClientRequest) -> Result<(), JSONRPCErrorError> {
+        if self.is_shared() && !self.references_projection(request)? {
+            // Normal work still passes through the native account, permissions,
+            // managed authority and writer gates in the same process.
+            return Ok(());
+        }
+        // The manager's RuntimeProxy supplies access-only target-account auth
+        // immediately after initialize. This affects only this viewer's auth
+        // manager, never a canonical source home. Browser/device/API-key login
+        // and logout remain outside the viewer's read-only allowlist.
+        if matches!(
+            request,
+            ClientRequest::LoginAccount {
+                params: LoginAccountParams::ChatgptAuthTokens { .. },
+                ..
+            }
+        ) {
+            return Ok(());
+        }
+        if let ClientRequest::ThreadResume { params, .. } = request {
+            return self.validate_view_resume(params);
+        }
+        let value = serde_json::to_value(request)
+            .map_err(|err| invalid_request(format!("cannot inspect catalog request: {err}")))?;
+        let method = value["method"].as_str().unwrap_or_default();
+        let allowed_thread_read = matches!(
+            method,
+            "thread/list"
+                | "thread/read"
+                | "thread/loaded/list"
+                | "thread/unsubscribe"
+                | "thread/turns/list"
+                | "thread/items/list"
+                | "thread/timeline/list"
+                | "thread/searchOccurrences"
+        );
+        let scoped = value.get("params").is_some_and(has_thread_reference);
+        let allowed_unscoped_read = matches!(
+            method,
+            "server/diagnostics"
+                | "config/read"
+                | "configRequirements/read"
+                | "account/read"
+                | "account/rateLimits/read"
+                | "account/usage/read"
+                | "account/workspaceMessages/read"
+                | "model/list"
+                | "collaborationMode/list"
+                | "project/list"
+                | "project/read"
+                | "threadSection/list"
+                | "skills/list"
+                | "hooks/list"
+                | "experimentalFeature/list"
+                | "environment/list"
+                | "environment/status"
+                | "windowsSandbox/readiness"
+                | "currentTime/read"
+        );
+        if !allowed_thread_read && (scoped || !allowed_unscoped_read) {
+            return Err(invalid_request(
+                "This instance is a read-only record catalog. Open the canonical task in its assigned profile to run or change it. This operation is not supported by the catalog viewer.",
+            ));
+        }
+        Ok(())
+    }
+
+    fn validate_view_resume(&self, params: &ThreadResumeParams) -> Result<(), JSONRPCErrorError> {
+        if params.history.is_some() || params.path.is_some() {
+            return Err(invalid_request(
+                "This instance is a read-only record catalog. Viewing accepts only a registered projection thread ID; path and injected history are disabled.",
+            ));
+        }
+        self.source(&params.thread_id).map(|_| ()).map_err(|_| {
+            invalid_request("This instance is a read-only record catalog. The requested projection thread ID is not registered.")
+        })
+    }
+
+    /// The native renderer uses `thread/resume` to open a conversation even when
+    /// it will only read history. This facade does not resume a core thread: it
+    /// has no ThreadManager, ConfigManager, auth manager, recorder or write permit.
+    ///
+    /// Native clients automatically attach model/provider/cwd/personality/config,
+    /// permissions, instruction and service-tier preferences. These fields are
+    /// deliberately ignored, never evaluated or echoed as applied settings.
+    /// Only the registered projection ID and history presentation options matter.
+    pub(crate) async fn resume(
+        &self,
+        params: ThreadResumeParams,
+        fallback_cwd: &AbsolutePathBuf,
+    ) -> Result<ThreadResumeResponse, JSONRPCErrorError> {
+        self.validate_view_resume(&params)?;
+        let source = self.source(&params.thread_id)?;
+        let selected_rollout = self.stored(source, false).await?.rollout_path;
+        let thread = self
+            .read(
+                ThreadReadParams {
+                    thread_id: params.thread_id.clone(),
+                    include_turns: !params.exclude_turns,
+                },
+                fallback_cwd,
+            )
+            .await?
+            .thread;
+        let initial_turns_page = if let Some(page) = params.initial_turns_page {
+            Some(
+                self.turns_list(ThreadTurnsListParams {
+                    thread_id: params.thread_id.clone(),
+                    cursor: None,
+                    limit: page.limit,
+                    sort_direction: page.sort_direction,
+                    items_view: page.items_view,
+                })
+                .await?
+                .into(),
+            )
+        } else {
+            None
+        };
+        let (turns_backwards_cursor, items_backwards_cursor) =
+            if thread.history_mode == codex_app_server_protocol::ThreadHistoryMode::Paginated {
+                let store = self.required_history_store(source).await?;
+                let turns = store
+                    .list_turns(codex_thread_store::ListTurnsParams {
+                        thread_id: source.thread_id,
+                        include_archived: true,
+                        cursor: None,
+                        page_size: 1,
+                        sort_direction: codex_thread_store::SortDirection::Desc,
+                        items_view: StoredTurnItemsView::NotLoaded,
+                    })
+                    .await
+                    .map_err(history::store_error)?;
+                let items = store
+                    .list_items(codex_thread_store::ListItemsParams {
+                        thread_id: source.thread_id,
+                        turn_id: None,
+                        include_archived: true,
+                        cursor: None,
+                        page_size: 1,
+                        sort_direction: codex_thread_store::SortDirection::Desc,
+                        sort_key: codex_thread_store::ItemSortKey::CreatedAtOrdinal,
+                        after_updated_at_ordinal: None,
+                    })
+                    .await
+                    .map_err(history::store_error)?;
+                (
+                    self.wrap_history_cursor(
+                        source,
+                        "turns",
+                        &serde_json::Value::Null,
+                        turns.backwards_cursor,
+                    )?,
+                    self.wrap_history_cursor(
+                        source,
+                        "items",
+                        &serde_json::json!({"turnId": null}),
+                        items.backwards_cursor,
+                    )?,
+                )
+            } else {
+                (None, None)
+            };
+        if self.stored(source, false).await?.rollout_path != selected_rollout {
+            return Err(invalid_request(
+                "canonical rollout changed while opening the record viewer; reload the conversation",
+            ));
+        }
+        Ok(ThreadResumeResponse {
+            // Empty means historical metadata did not record a model; no active
+            // runtime model is selected by this view-only response.
+            model: thread.model.clone().unwrap_or_default(),
+            model_provider: thread.model_provider.clone(),
+            service_tier: None,
+            cwd: thread.cwd.clone(),
+            runtime_workspace_roots: Vec::new(),
+            instruction_sources: Vec::new(),
+            approval_policy: AskForApproval::Never,
+            approvals_reviewer: ApprovalsReviewer::User,
+            sandbox: SandboxPolicy::ReadOnly {
+                network_access: false,
+            },
+            active_permission_profile: None,
+            reasoning_effort: thread.reasoning_effort.clone(),
+            multi_agent_mode: MultiAgentMode::ExplicitRequestOnly,
+            thread,
+            initial_turns_page,
+            turns_backwards_cursor,
+            items_backwards_cursor,
+        })
+    }
+
+    async fn validated_home(&self, source: &RecordSource) -> Result<PathBuf, JSONRPCErrorError> {
+        let registered_homes = self.validated_homes().await?;
+        let home = tokio::fs::canonicalize(&source.codex_home)
+            .await
+            .map_err(|err| invalid_request(format!("canonical store unavailable: {err}")))?;
+        if registered_homes.get(&source.codex_home) != Some(&home) {
+            return Err(invalid_request(
+                "canonical store home changed; refresh the catalog",
+            ));
+        }
+        Ok(home)
+    }
+
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "serialize lazy read-only pool creation to retain exactly one pool per source"
+    )]
+    async fn read_only_store(
+        &self,
+        home: &Path,
+    ) -> Result<Option<Arc<ReadOnlyLocalThreadStore>>, JSONRPCErrorError> {
+        let mut stores = self.read_only_stores.lock().await;
+        if let Some(store) = stores.get(home) {
+            return Ok(Some(Arc::clone(store)));
+        }
+        let sqlite_home = AbsolutePathBuf::from_absolute_path(home)
+            .map_err(|err| invalid_request(format!("invalid canonical store path: {err}")))?;
+        let sqlite = codex_state::SqliteConfig::from_sqlite_home(sqlite_home);
+        if !tokio::fs::try_exists(sqlite.state_db_path())
+            .await
+            .map_err(|err| invalid_request(format!("cannot inspect canonical state: {err}")))?
+        {
+            return Ok(None);
+        }
+        let mut rollout_homes: Vec<PathBuf> = self
+            .discovered
+            .as_ref()
+            .map(|data| data.registered_homes.values().cloned().collect())
+            .unwrap_or_default();
+        rollout_homes.sort();
+        rollout_homes.dedup();
+        let projection = {
+            let mut cache = self.history_projections.lock().await;
+            // A referenced inventory can change without changing the descriptor.
+            // Retain private indexes only while their registered roots still match.
+            if cache.rollout_homes != rollout_homes {
+                cache.stores.clear();
+                cache.rollout_homes.clone_from(&rollout_homes);
+            }
+            Arc::clone(cache.stores.entry(home.to_path_buf()).or_default())
+        };
+        let store = Arc::new(
+            ReadOnlyLocalThreadStore::open_with_registered_rollout_homes(
+                home.to_path_buf(),
+                sqlite,
+                rollout_homes,
+            )
+            .await
+            .map_err(history::store_error)?
+            .with_private_history_projection(projection)
+            .map_err(history::store_error)?,
+        );
+        stores.insert(home.to_path_buf(), Arc::clone(&store));
+        Ok(Some(store))
+    }
+
+    async fn verified_rollout(
+        &self,
+        source: &RecordSource,
+        home: &Path,
+        path: &Path,
+    ) -> Result<(PathBuf, ThreadHistoryMode), JSONRPCErrorError> {
+        let path = tokio::fs::canonicalize(path)
+            .await
+            .map_err(|err| invalid_request(format!("canonical rollout unavailable: {err}")))?;
+        if !path.starts_with(home.join("sessions"))
+            && !path.starts_with(home.join("archived_sessions"))
+        {
+            return Err(invalid_request(
+                "canonical rollout escapes the registered session directories",
+            ));
+        }
+        let meta = codex_rollout::read_session_meta_line(&path)
+            .await
+            .map_err(|err| invalid_request(format!("cannot verify canonical rollout: {err}")))?;
+        if meta.meta.id != source.thread_id {
+            return Err(invalid_request(
+                "canonical rollout ID does not match the registered source",
+            ));
+        }
+        Ok((path, meta.meta.history_mode))
+    }
+
+    async fn legacy_stored(
+        &self,
+        source: &RecordSource,
+        home: &Path,
+        path: &Path,
+        include_turns: bool,
+    ) -> Result<StoredThread, JSONRPCErrorError> {
+        let (path, history_mode) = self.verified_rollout(source, home, path).await?;
+        if history_mode != ThreadHistoryMode::Legacy {
+            return Err(invalid_request(
+                "paginated record has no authoritative read-only state row; refresh the source catalog",
+            ));
+        }
+        let sqlite_home = AbsolutePathBuf::from_absolute_path(home)
+            .map_err(|err| invalid_request(format!("invalid canonical store path: {err}")))?;
+        let store = LocalThreadStore::new(
+            LocalThreadStoreConfig {
+                codex_home: home.to_path_buf(),
+                sqlite: codex_state::SqliteConfig::from_sqlite_home(sqlite_home),
+                default_model_provider_id: "openai".to_string(),
+            },
+            /*state_db*/ None,
+        );
+        let mut stored = store
+            .read_thread_by_rollout_path(path, /*include_archived*/ true, include_turns)
+            .await
+            .map_err(|err| invalid_request(format!("cannot read canonical record: {err}")))?;
+        if stored.thread_id != source.thread_id || stored.history_mode != ThreadHistoryMode::Legacy
+        {
+            return Err(invalid_request(
+                "canonical record changed during read; retry after catalog refresh",
+            ));
+        }
+        if let Some(summary) = self
+            .discovered
+            .as_ref()
+            .and_then(|data| data.summaries.get(&source.projection_thread_id))
+        {
+            // Legacy bodies do not contain every saved sidebar title. This is
+            // display metadata only; history and permissions came from the file.
+            stored.name = summary.name.clone();
+        }
+        Ok(stored)
+    }
+
+    async fn stored(
+        &self,
+        source: &RecordSource,
+        include_turns: bool,
+    ) -> Result<StoredThread, JSONRPCErrorError> {
+        let home = self.validated_home(source).await?;
+        let stored = if let Some(store) = self.record_index(source).await? {
+            match store
+                .read_thread(codex_thread_store::ReadThreadParams {
+                    thread_id: source.thread_id,
+                    include_archived: true,
+                    include_history: false,
+                })
+                .await
+            {
+                Ok(mut stored) => {
+                    // Revert/archive may rotate the rollout pointer. The current
+                    // authoritative state row selects it; the manifest path is a
+                    // legacy fallback hint, never a pin to an obsolete rollout.
+                    let path = stored.rollout_path.as_ref().ok_or_else(|| {
+                        invalid_request("canonical state row has no rollout path")
+                    })?;
+                    let (path, history_mode) = self.verified_rollout(source, &home, path).await?;
+                    if stored.thread_id != source.thread_id || stored.history_mode != history_mode {
+                        return Err(invalid_request(
+                            "canonical record changed during read; retry after catalog refresh",
+                        ));
+                    }
+                    if include_turns && history_mode == ThreadHistoryMode::Legacy {
+                        stored.history = self
+                            .legacy_stored(source, &home, &path, true)
+                            .await?
+                            .history;
+                    }
+                    stored
+                }
+                Err(ThreadStoreError::ThreadNotFound { .. }) => {
+                    self.legacy_stored(source, &home, &source.rollout_path, include_turns)
+                        .await?
+                }
+                Err(error) => return Err(history::store_error(error)),
+            }
+        } else {
+            self.legacy_stored(source, &home, &source.rollout_path, include_turns)
+                .await?
+        };
+        Ok(self.project_metadata(source, stored))
+    }
+
+    pub(crate) async fn read(
+        &self,
+        params: ThreadReadParams,
+        fallback_cwd: &AbsolutePathBuf,
+    ) -> Result<ThreadReadResponse, JSONRPCErrorError> {
+        let source = self.source(&params.thread_id)?;
+        let stored = self.stored(source, params.include_turns).await?;
+        let paginated = stored.history_mode == ThreadHistoryMode::Paginated;
+        let selected_rollout = stored.rollout_path.clone();
+        let (mut thread, history) = thread_from_stored_thread(stored, "openai", fallback_cwd);
+        if let Some(history) = history {
+            thread.turns = build_catalog_legacy_turns(&history.items);
+            for turn in &mut thread.turns {
+                self.project_items(source, &mut turn.items)?;
+            }
+        } else if paginated && params.include_turns {
+            let mut cursor = None;
+            loop {
+                let page = self
+                    .turns_list(ThreadTurnsListParams {
+                        thread_id: params.thread_id.clone(),
+                        cursor: cursor.clone(),
+                        limit: Some(HISTORY_PAGE_LIMIT as u32),
+                        sort_direction: Some(SortDirection::Asc),
+                        items_view: Some(TurnItemsView::Full),
+                    })
+                    .await?;
+                thread.turns.extend(page.data);
+                let Some(next_cursor) = page.next_cursor else {
+                    break;
+                };
+                if cursor.as_ref() == Some(&next_cursor) {
+                    return Err(invalid_request(
+                        "canonical history returned a repeated turn cursor",
+                    ));
+                }
+                cursor = Some(next_cursor);
+            }
+            if self.stored(source, false).await?.rollout_path != selected_rollout {
+                return Err(invalid_request(
+                    "canonical rollout changed while loading full history; reload the conversation",
+                ));
+            }
+        }
+        thread.can_accept_direct_input = Some(false);
+        thread.extra = Some(source.origin());
+        // Do not expose a foreign path as an alternate resume/fork input.
+        thread.path = None;
+        Ok(ThreadReadResponse { thread })
+    }
+
+    fn source(&self, projection: &str) -> Result<&RecordSource, JSONRPCErrorError> {
+        self.entries
+            .iter()
+            .find(|entry| entry.projection_thread_id.to_string() == projection)
+            .ok_or_else(|| invalid_request("record projection not registered in this catalog"))
+    }
+
+    fn projection_for(&self, source: &RecordSource, id: &str) -> Result<String, JSONRPCErrorError> {
+        self.entries.iter().find(|entry| {
+            entry.host_id == source.host_id && entry.source_store_id == source.source_store_id
+                && entry.thread_id.to_string() == id
+        }).map(|entry| entry.projection_thread_id.to_string()).ok_or_else(|| {
+            invalid_request("referenced canonical source is not registered in this catalog; refresh the catalog to view linked history")
+        })
+    }
+
+    fn project_items(
+        &self,
+        source: &RecordSource,
+        items: &mut [ThreadItem],
+    ) -> Result<(), JSONRPCErrorError> {
+        for item in items {
+            match item {
+                ThreadItem::CollabAgentToolCall {
+                    sender_thread_id,
+                    receiver_thread_ids,
+                    agents_states,
+                    ..
+                } => {
+                    *sender_thread_id = self.projection_for(source, sender_thread_id)?;
+                    for id in receiver_thread_ids {
+                        *id = self.projection_for(source, id)?;
+                    }
+                    let projected = agents_states
+                        .iter()
+                        .map(|(id, state)| Ok((self.projection_for(source, id)?, state.clone())))
+                        .collect::<Result<HashMap<_, _>, JSONRPCErrorError>>()?;
+                    *agents_states = projected;
+                }
+                ThreadItem::SubAgentActivity {
+                    agent_thread_id, ..
+                } => {
+                    *agent_thread_id = self.projection_for(source, agent_thread_id)?;
+                }
+                ThreadItem::AgentMessage {
+                    memory_citation: Some(citation),
+                    ..
+                } => {
+                    for id in &mut citation.thread_ids {
+                        *id = self.projection_for(source, id)?;
+                    }
+                }
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+
+    fn history_cursor(
+        &self,
+        source: &RecordSource,
+        method: &str,
+        query: &serde_json::Value,
+        cursor: Option<String>,
+    ) -> Result<Option<String>, JSONRPCErrorError> {
+        let Some(cursor) = cursor else {
+            return Ok(None);
+        };
+        if cursor.len() > 64 * 1024 {
+            return Err(invalid_request("record history cursor is too large"));
+        }
+        let cursor: HistoryCursor = serde_json::from_str(&cursor)
+            .map_err(|_| invalid_request("invalid record history cursor"))?;
+        // Native desktop clients reuse the thread-wide resume item boundary
+        // while hydrating individual turns. Narrowing an unfiltered item cursor
+        // is valid; a cursor already scoped to a turn cannot change turns.
+        let query_matches = &cursor.query == query
+            || (method == "items"
+                && cursor.query == serde_json::json!({"turnId": null})
+                && query
+                    .get("turnId")
+                    .is_some_and(serde_json::Value::is_string));
+        if cursor.revision != source.history_revision()?
+            || cursor.host_id != source.host_id
+            || cursor.source_store_id != source.source_store_id
+            || cursor.thread_id != source.thread_id
+            || cursor.projection_thread_id != source.projection_thread_id
+            || cursor.method != method
+            || !query_matches
+        {
+            return Err(invalid_request(
+                "record catalog or history query changed; restart listing",
+            ));
+        }
+        Ok(Some(cursor.cursor))
+    }
+
+    fn wrap_history_cursor(
+        &self,
+        source: &RecordSource,
+        method: &str,
+        query: &serde_json::Value,
+        cursor: Option<String>,
+    ) -> Result<Option<String>, JSONRPCErrorError> {
+        cursor
+            .map(|cursor| {
+                serde_json::to_string(&HistoryCursor {
+                    revision: source.history_revision()?,
+                    host_id: source.host_id.clone(),
+                    source_store_id: source.source_store_id.clone(),
+                    thread_id: source.thread_id,
+                    projection_thread_id: source.projection_thread_id,
+                    method: method.to_string(),
+                    query: query.clone(),
+                    cursor,
+                })
+                .map_err(|err| {
+                    invalid_request(format!("cannot encode record history cursor: {err}"))
+                })
+            })
+            .transpose()
+    }
+
+    async fn required_history_store(
+        &self,
+        source: &RecordSource,
+    ) -> Result<Arc<ReadOnlyLocalThreadStore>, JSONRPCErrorError> {
+        self.record_index(source).await?.ok_or_else(|| {
+            invalid_request("paginated record has no authoritative read-only state database")
+        })
+    }
+
+    pub(crate) async fn turns_list(
+        &self,
+        params: ThreadTurnsListParams,
+    ) -> Result<ThreadTurnsListResponse, JSONRPCErrorError> {
+        let source = self.source(&params.thread_id)?;
+        let query = serde_json::Value::Null;
+        let cursor = self.history_cursor(source, "turns", &query, params.cursor)?;
+        let items_view = params.items_view.unwrap_or(TurnItemsView::Summary);
+        let stored = self.stored(source, true).await?;
+        let selected_rollout = stored.rollout_path.clone();
+        let mut response = if stored.history_mode == ThreadHistoryMode::Legacy {
+            let items = stored
+                .history
+                .ok_or_else(|| invalid_request("legacy record has no history"))?
+                .items;
+            history::legacy_turns_page(
+                build_catalog_legacy_turns(&items),
+                cursor,
+                params.limit,
+                params.sort_direction.unwrap_or(SortDirection::Desc),
+                items_view,
+            )?
+        } else {
+            let store = self.required_history_store(source).await?;
+            let page = store
+                .list_turns(codex_thread_store::ListTurnsParams {
+                    thread_id: source.thread_id,
+                    include_archived: true,
+                    cursor,
+                    page_size: params
+                        .limit
+                        .map(|limit| limit as usize)
+                        .unwrap_or(25)
+                        .clamp(1, HISTORY_PAGE_LIMIT),
+                    sort_direction: history::sort(
+                        params.sort_direction.unwrap_or(SortDirection::Desc),
+                    ),
+                    items_view: match items_view {
+                        TurnItemsView::Summary => StoredTurnItemsView::Summary,
+                        TurnItemsView::NotLoaded | TurnItemsView::Full => {
+                            StoredTurnItemsView::NotLoaded
+                        }
+                    },
+                })
+                .await
+                .map_err(history::store_error)?;
+            let mut turns = Vec::with_capacity(page.turns.len());
+            for turn in page.turns {
+                let mut turn = history::turn(turn, items_view)?;
+                if items_view == TurnItemsView::Full {
+                    // Hydrate directly from the authoritative store so reference
+                    // projection happens exactly once below.
+                    let mut item_cursor = None;
+                    loop {
+                        let page = store
+                            .list_items(codex_thread_store::ListItemsParams {
+                                thread_id: source.thread_id,
+                                turn_id: Some(turn.id.clone()),
+                                include_archived: true,
+                                cursor: item_cursor.clone(),
+                                page_size: HISTORY_PAGE_LIMIT,
+                                sort_direction: codex_thread_store::SortDirection::Asc,
+                                sort_key: codex_thread_store::ItemSortKey::CreatedAtOrdinal,
+                                after_updated_at_ordinal: None,
+                            })
+                            .await
+                            .map_err(history::store_error)?;
+                        turn.items.extend(
+                            page.items
+                                .into_iter()
+                                .map(history::item)
+                                .collect::<Result<Vec<_>, _>>()?,
+                        );
+                        let Some(next_cursor) = page.next_cursor else {
+                            break;
+                        };
+                        if item_cursor.as_ref() == Some(&next_cursor) {
+                            return Err(invalid_request(
+                                "canonical history returned a repeated item cursor",
+                            ));
+                        }
+                        item_cursor = Some(next_cursor);
+                    }
+                }
+                turns.push(turn);
+            }
+            // The authenticated viewer does not own this execution. Preserve the
+            // authoritative persisted status, even if it is currently in progress.
+            ThreadTurnsListResponse {
+                data: turns,
+                next_cursor: page.next_cursor,
+                backwards_cursor: page.backwards_cursor,
+            }
+        };
+        if items_view == TurnItemsView::Full
+            && self.stored(source, false).await?.rollout_path != selected_rollout
+        {
+            return Err(invalid_request(
+                "canonical rollout changed while loading full turn items; reload the conversation",
+            ));
+        }
+        for turn in &mut response.data {
+            self.project_items(source, &mut turn.items)?;
+        }
+        response.next_cursor =
+            self.wrap_history_cursor(source, "turns", &query, response.next_cursor)?;
+        response.backwards_cursor =
+            self.wrap_history_cursor(source, "turns", &query, response.backwards_cursor)?;
+        Ok(response)
+    }
+
+    pub(crate) async fn items_list(
+        &self,
+        params: ThreadItemsListParams,
+    ) -> Result<ThreadItemsListResponse, JSONRPCErrorError> {
+        let source = self.source(&params.thread_id)?;
+        let query = serde_json::json!({"turnId": params.turn_id});
+        let cursor = self.history_cursor(source, "items", &query, params.cursor)?;
+        let stored = self.stored(source, true).await?;
+        let mut response = if stored.history_mode == ThreadHistoryMode::Legacy {
+            let history = stored
+                .history
+                .ok_or_else(|| invalid_request("legacy record has no history"))?;
+            history::legacy_items_page(
+                build_catalog_legacy_turns(&history.items),
+                params.turn_id,
+                cursor,
+                params.limit,
+                params.sort_direction.unwrap_or(SortDirection::Asc),
+            )?
+        } else {
+            let store = self.required_history_store(source).await?;
+            let page = store
+                .list_items(codex_thread_store::ListItemsParams {
+                    thread_id: source.thread_id,
+                    turn_id: params.turn_id,
+                    include_archived: true,
+                    cursor,
+                    page_size: params
+                        .limit
+                        .map(|limit| limit as usize)
+                        .unwrap_or(25)
+                        .clamp(1, HISTORY_PAGE_LIMIT),
+                    sort_direction: history::sort(
+                        params.sort_direction.unwrap_or(SortDirection::Asc),
+                    ),
+                    sort_key: codex_thread_store::ItemSortKey::CreatedAtOrdinal,
+                    after_updated_at_ordinal: None,
+                })
+                .await
+                .map_err(history::store_error)?;
+            let data = page
+                .items
+                .into_iter()
+                .map(|item| {
+                    Ok(ThreadItemEntry {
+                        turn_id: item.turn_id.clone(),
+                        item: history::item(item)?,
+                    })
+                })
+                .collect::<Result<Vec<_>, JSONRPCErrorError>>()?;
+            ThreadItemsListResponse {
+                data,
+                next_cursor: page.next_cursor,
+                backwards_cursor: page.backwards_cursor,
+            }
+        };
+        for entry in &mut response.data {
+            self.project_items(source, std::slice::from_mut(&mut entry.item))?;
+        }
+        response.next_cursor =
+            self.wrap_history_cursor(source, "items", &query, response.next_cursor)?;
+        response.backwards_cursor =
+            self.wrap_history_cursor(source, "items", &query, response.backwards_cursor)?;
+        Ok(response)
+    }
+
+    pub(crate) async fn timeline_list(
+        &self,
+        params: ThreadTimelineListParams,
+    ) -> Result<ThreadTimelineListResponse, JSONRPCErrorError> {
+        let source = self.source(&params.thread_id)?;
+        // Resolve and verify the live metadata pointer before reading any history.
+        self.stored(source, false).await?;
+        let query = serde_json::Value::Null;
+        let cursor = self.history_cursor(source, "timeline", &query, params.cursor)?;
+        let store = self.required_history_store(source).await?;
+        let page = store
+            .list_timeline(codex_thread_store::ListTimelineParams {
+                thread_id: source.thread_id,
+                cursor,
+                page_size: params
+                    .limit
+                    .map(|limit| limit as usize)
+                    .unwrap_or(25)
+                    .clamp(1, HISTORY_PAGE_LIMIT),
+            })
+            .await
+            .map_err(history::store_error)?;
+        let mut data = page.items;
+        for entry in &mut data {
+            if let ThreadTimelineEntry::Item { item, .. } = entry {
+                self.project_items(source, std::slice::from_mut(item.as_mut()))?;
+            }
+        }
+        Ok(ThreadTimelineListResponse {
+            data,
+            next_cursor: self.wrap_history_cursor(source, "timeline", &query, page.next_cursor)?,
+            active_realtime_session_at_page_start: page.active_realtime_session_at_page_start,
+        })
+    }
+
+    pub(crate) async fn search_occurrences(
+        &self,
+        params: ThreadSearchOccurrencesParams,
+    ) -> Result<ThreadSearchOccurrencesResponse, JSONRPCErrorError> {
+        let source = self.source(&params.thread_id)?;
+        if params.search_term.trim().is_empty() {
+            return Err(invalid_request(
+                "thread/searchOccurrences requires a non-empty searchTerm",
+            ));
+        }
+        let query = serde_json::json!({"searchTerm": params.search_term});
+        let cursor = self.history_cursor(source, "search", &query, params.cursor)?;
+        self.stored(source, false).await?;
+        let store = self.required_history_store(source).await?;
+        let page = store
+            .search_thread_occurrences(codex_thread_store::SearchThreadOccurrencesParams {
+                thread_id: source.thread_id,
+                search_term: params.search_term,
+                cursor,
+                page_size: params
+                    .limit
+                    .map(|limit| limit as usize)
+                    .unwrap_or(25)
+                    .clamp(1, HISTORY_PAGE_LIMIT),
+            })
+            .await
+            .map_err(history::store_error)?;
+        let data = page
+            .items
+            .into_iter()
+            .map(|item| {
+                let turn_cursor = self
+                    .wrap_history_cursor(
+                        source,
+                        "turns",
+                        &serde_json::Value::Null,
+                        Some(item.turn_cursor),
+                    )?
+                    .ok_or_else(|| invalid_request("canonical search result has no turn cursor"))?;
+                Ok(ThreadSearchOccurrence {
+                    turn_id: item.turn_id,
+                    item_id: item.item_id,
+                    snippet: item.snippet,
+                    snippet_match_range: ThreadSearchTextRange {
+                        start: item.snippet_match_range.start,
+                        end: item.snippet_match_range.end,
+                    },
+                    turn_cursor,
+                })
+            })
+            .collect::<Result<Vec<_>, JSONRPCErrorError>>()?;
+        Ok(ThreadSearchOccurrencesResponse {
+            data,
+            next_cursor: self.wrap_history_cursor(source, "search", &query, page.next_cursor)?,
+        })
+    }
+}
+
+fn key(thread: &Thread, sort: ThreadSortKey) -> (i64, &str) {
+    let timestamp = match sort {
+        ThreadSortKey::CreatedAt => thread.created_at,
+        ThreadSortKey::UpdatedAt => thread.updated_at,
+        ThreadSortKey::RecencyAt => thread.recency_at.unwrap_or(thread.updated_at),
+        ThreadSortKey::SectionPosition => {
+            unreachable!("section sorting rejected before pagination")
+        }
+    };
+    (timestamp, &thread.id)
+}
+
+fn has_thread_reference(value: &serde_json::Value) -> bool {
+    match value {
+        serde_json::Value::Object(object) => object.iter().any(|(key, value)| {
+            matches!(
+                key.as_str(),
+                "threadId"
+                    | "threadIds"
+                    | "conversationId"
+                    | "beforeThreadId"
+                    | "parentThreadId"
+                    | "ancestorThreadId"
+            ) && !value.is_null()
+                || has_thread_reference(value)
+        }),
+        serde_json::Value::Array(values) => values.iter().any(has_thread_reference),
+        _ => false,
+    }
+}
+
+fn build_catalog_legacy_turns(
+    items: &[codex_rollout::RolloutItem],
+) -> Vec<codex_app_server_protocol::Turn> {
+    // These records are already durable, including rows written by older runtimes.
+    // Applying today's write filter here can erase historical collaboration items.
+    let mut builder = codex_app_server_protocol::ThreadHistoryBuilder::new();
+    for item in items {
+        builder.handle_rollout_item(item);
+    }
+    builder.finish()
+}
