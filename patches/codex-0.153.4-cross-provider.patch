+
+impl ThreadManagerState {
+    pub(super) async fn thread_store_for_thread(
+        &self,
+        thread_id: ThreadId,
+    ) -> Arc<dyn ThreadStore> {
+        match self.managed_record_bindings.read().await.get(&thread_id) {
+            Some(binding) => binding.store(),
+            None => Arc::clone(&self.thread_store),
+        }
+    }
+
+    pub(super) async fn managed_store_for_spawn(
+        &self,
+        requested: Option<ManagedThreadBinding>,
+        history: &mut InitialHistory,
+        parent_thread_id: Option<ThreadId>,
+        reserved_thread_id: &mut Option<ThreadId>,
+        extension_init: &mut ExtensionDataInit,
+    ) -> CodexResult<(Arc<dyn ThreadStore>, Option<ManagedWriterReservation>)> {
+        let resumed_id = match history {
+            InitialHistory::Resumed(resumed) => Some(resumed.conversation_id),
+            InitialHistory::New | InitialHistory::Cleared | InitialHistory::Forked(_) => None,
+        };
+        let inherited = {
+            let bindings = self.managed_record_bindings.read().await;
+            resumed_id
+                .and_then(|id| bindings.get(&id).cloned())
+                .filter(|binding| !binding.is_released())
+                .or_else(|| parent_thread_id.and_then(|id| bindings.get(&id).cloned()))
+        };
+        let binding = match (requested, inherited) {
+            (Some(binding), _) => binding,
+            (None, Some(source)) => {
+                let thread_id = resumed_id
+                    .or(*reserved_thread_id)
+                    .unwrap_or_else(|| self.thread_id_generator.as_ref()());
+                let binding = if resumed_id.is_some() {
+                    source.for_child(thread_id).await
+                } else {
+                    source.for_new_child(thread_id).await
+                };
+                binding.map_err(|error| CodexErr::InvalidRequest(error.to_string()))?
+            }
+            (None, None) => return Ok((Arc::clone(&self.thread_store), None)),
+        };
+        let thread_id = binding.thread_id();
+        if resumed_id.is_some_and(|id| id != thread_id)
+            || reserved_thread_id.is_some_and(|id| id != thread_id)
+        {
+            return Err(CodexErr::InvalidRequest(
+                "managed record binding does not match the canonical thread UUID".to_string(),
+            ));
+        }
+        let binding = {
+            let bindings = self.managed_record_bindings.read().await;
+            if let Some(previous) = bindings.get(&thread_id) {
+                if previous.source_id() != binding.source_id()
+                    || previous.source_config().codex_home != binding.source_config().codex_home
+                {
+                    return Err(CodexErr::InvalidRequest(
+                        "canonical UUID is already bound to a different managed source".to_string(),
+                    ));
+                }
+                if previous.authority_grant() != binding.authority_grant() {
+                    return Err(CodexErr::InvalidRequest(
+                        "a different managed ownership grant requires explicit activation"
+                            .to_string(),
+                    ));
+                }
+                if previous.is_released() {
+                    binding
+                } else {
+                    previous.clone()
+                }
+            } else {
+                binding
+            }
+        };
+
+        let (store, reservation, prepared_history) =
+            prepare_managed_record(binding.clone(), history.clone()).await?;
+        *history = prepared_history;
+        if resumed_id.is_none() {
+            *reserved_thread_id = Some(thread_id);
+        }
+        extension_init.insert(binding.clone());
+        self.managed_record_bindings
+            .write()
+            .await
+            .insert(thread_id, binding);
+        Ok((store, Some(reservation)))
+    }
+}
+
+/// Keep preparation owned even when a caller cancels its resume request. Source initialization
+/// finishes before this task releases the same lock later consumed by the live recorder.
+async fn prepare_managed_record(
+    binding: ManagedThreadBinding,
+    mut history: InitialHistory,
+) -> CodexResult<(
+    Arc<LocalThreadStore>,
+    ManagedWriterReservation,
+    InitialHistory,
+)> {
+    tokio::spawn(async move {
+        let thread_id = binding.thread_id();
+        let reservation = binding
+            .prepare_writer()
+            .await
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        let store = binding.store();
+        if let InitialHistory::Resumed(resumed) = &mut history {
+            // Validate the stored paths and logical UUID without repair, including every
+            // paginated lineage source. An incomplete canonical source must fail explicitly.
+            let reader = ReadOnlyLocalThreadStore::open(
+                binding.source_config().codex_home.clone(),
+                binding.source_config().sqlite.clone(),
+            )
+            .await
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+            let snapshot: CodexResult<_> = async {
+                let stored = reader
+                    .read_thread(ReadThreadParams {
+                        thread_id,
+                        include_archived: true,
+                        include_history: false,
+                    })
+                    .await
+                    .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+                // Preflight can be stale even if owner epoch and file path are unchanged.
+                // Reconstruct model input after claiming its exact writer lock.
+                let context = reader
+                    .load_latest_model_context(LoadThreadHistoryParams {
+                        thread_id,
+                        include_archived: true,
+                    })
+                    .await
+                    .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+                Ok((stored, context))
+            }
+            .await;
+            reader.close().await;
+            let (stored, context) = snapshot?;
+            let source_path = stored.rollout_path.ok_or_else(|| {
+                CodexErr::InvalidRequest("managed source has no rollout".to_string())
+            })?;
+            if let Some(requested_path) = resumed.rollout_path.as_ref() {
+                let canonical = |path: &PathBuf| {
+                    std::fs::canonicalize(path)
+                        .map_err(|error| CodexErr::InvalidRequest(error.to_string()))
+                };
+                if canonical(requested_path)? != canonical(&source_path)? {
+                    return Err(CodexErr::InvalidRequest(
+                        "rollout override differs from the managed canonical record".to_string(),
+                    ));
+                }
+            }
+            if context.thread_id != thread_id {
+                return Err(CodexErr::InvalidRequest(
+                    "managed context belongs to another canonical record".to_string(),
+                ));
+            }
+            resumed.history = Arc::new(context.items);
+            resumed.rollout_path = Some(source_path);
+        }
+        Ok((store, reservation, history))
+    })
+    .await
+    .map_err(|error| {
+        CodexErr::InvalidRequest(format!("managed record preparation failed: {error}"))
+    })?
+}
