+#[tokio::test]
+async fn active_cold_goal_blocks_even_when_deferred_and_inactive_goals_survive_close() {
+    use codex_state::ThreadGoalStatus;
+
+    let fixture = ColdDrainFixture::new().await;
+    let child = fixture.seed_child(ThreadId::new()).await;
+    let admission = fixture
+        .root_actor
+        .try_reserve_idle_close()
+        .expect("exclusive root admission");
+    let ids = [fixture.root.thread_id(), child.thread_id()];
+    for status in [
+        ThreadGoalStatus::Active,
+        ThreadGoalStatus::Paused,
+        ThreadGoalStatus::Blocked,
+        ThreadGoalStatus::UsageLimited,
+        ThreadGoalStatus::BudgetLimited,
+        ThreadGoalStatus::Complete,
+    ] {
+        // Seed only fixture state, while owning the same locks required by production writes.
+        let source = fixture
+            .root
+            .for_child(child.thread_id())
+            .await
+            .expect("current fixture child grant");
+        let reservation = source
+            .prepare_writer()
+            .await
+            .expect("reserve goal fixture writer");
+        let state = source
+            .store()
+            .state_db()
+            .await
+            .expect("canonical goal database");
+        let permit = source
+            .write_permit()
+            .await
+            .expect("goal fixture write permit");
+        let goal = state
+            .thread_goals()
+            .replace_thread_goal(
+                child.thread_id(),
+                "Keep this goal unchanged during close",
+                status,
+                None,
+            )
+            .await
+            .expect("seed canonical goal status");
+        state
+            .thread_goals()
+            .replace_thread_goal_snapshot(&goal)
+            .await
+            .expect("seed continuation deferral without changing the goal");
+        drop(permit);
+        drop(reservation);
+
+        let result = fixture
+            .manager
+            .prepare_managed_cold_drain(&fixture.root_actor, &admission, &ids)
+            .await;
+        if status == ThreadGoalStatus::Active {
+            assert!(
+                result.is_err(),
+                "a deferral does not make an active goal idle"
+            );
+        } else {
+            let mut guard = result.expect("inactive goal permits cold close");
+            guard
+                .close_thread(child.thread_id())
+                .await
+                .expect("close inactive goal owner");
+        }
+        assert_eq!(
+            state
+                .thread_goals()
+                .get_thread_goal(child.thread_id())
+                .await
+                .expect("goal after drain"),
+            Some(goal),
+            "cold drain must preserve the complete canonical goal snapshot"
+        );
+        assert!(
+            state
+                .thread_goals()
+                .has_thread_goal_continuation_deferral(child.thread_id())
+                .await
+                .expect("goal deferral after drain"),
+            "cold drain must not consume continuation deferral"
+        );
+    }
+    drop(admission);
+    fixture.finish().await;
+}
