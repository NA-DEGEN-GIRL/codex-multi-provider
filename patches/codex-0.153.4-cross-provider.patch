diff --git a/codex-rs/core/src/session/idle_shutdown.rs b/codex-rs/core/src/session/idle_shutdown.rs
new file mode 100644
index 0000000000000000000000000000000000000000..130edabc762f8207efed78c862e5378c73e09aeb
--- /dev/null
+++ b/codex-rs/core/src/session/idle_shutdown.rs
@@ -0,0 +1,134 @@
+//! Strict, non-interrupting actor shutdown used by managed record handoff.
+
+use super::handlers;
+use super::session::Session;
+use async_channel::Receiver;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::Event;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::Submission;
+use std::sync::Arc;
+
+pub(super) struct IdleShutdownOutcome {
+    pub(super) result: CodexResult<()>,
+    pub(super) should_exit: bool,
+}
+
+pub(super) async fn close_idle_and_shutdown(
+    session: &Arc<Session>,
+    submissions: &Receiver<Submission>,
+    submission_id: String,
+    admission: &mut bool,
+) -> IdleShutdownOutcome {
+    // This executes inside the submission loop: input accepted earlier is seen
+    // by the checks; later requests cannot start a turn while teardown runs.
+    let prepare = async {
+        ensure_idle(session, submissions).await?;
+        if let Some(live_thread) = session.live_thread() {
+            live_thread.flush().await.map_err(|error| {
+                CodexErr::Fatal(format!("flush before idle thread close failed: {error}"))
+            })?;
+        }
+        // Flushing can yield to mailbox and descendant producers. Refuse work
+        // observed during that wait before stopping any runtime services.
+        ensure_idle(session, submissions).await
+    }
+    .await;
+    if let Err(error) = prepare {
+        return IdleShutdownOutcome {
+            result: Err(error),
+            should_exit: false,
+        };
+    }
+
+    let Some(hook_seal) = session.hooks().try_seal_for_managed_close() else {
+        return IdleShutdownOutcome {
+            result: Err(CodexErr::UnsupportedOperation(
+                "cannot close idle thread: hooks have pending work".into(),
+            )),
+            should_exit: false,
+        };
+    };
+    *admission = true;
+    let result = async {
+        session.internal_sessions.close_idle().await?;
+        handlers::shutdown_session_runtime_checked(
+            session,
+            handlers::ShutdownHooks::Managed(&hook_seal),
+        )
+        .await?;
+        handlers::emit_thread_stop_lifecycle(session.as_ref()).await;
+        if let Some(live_thread) = session.live_thread() {
+            live_thread.flush().await.map_err(|error| {
+                CodexErr::Fatal(format!("flush after idle thread close failed: {error}"))
+            })?;
+            live_thread.shutdown().await.map_err(|error| {
+                CodexErr::Fatal(format!("close idle thread writer failed: {error}"))
+            })?;
+        }
+        session
+            .deliver_event_raw(Event {
+                id: submission_id,
+                msg: EventMsg::ShutdownComplete,
+            })
+            .await;
+        Ok(())
+    }
+    .await
+    .map_err(|error: CodexErr| {
+        CodexErr::Fatal(format!("managed actor teardown was not verified: {error}"))
+    });
+    session.internal_sessions.record_shutdown_result(&result);
+    // Once teardown starts, never admit work into a partly stopped runtime.
+    // An error is deliberately not a release proof; management keeps its gate
+    // sealed and responsibility stays with the source until explicit recovery.
+    IdleShutdownOutcome {
+        result,
+        should_exit: true,
+    }
+}
+
+async fn ensure_idle(
+    session: &Arc<Session>,
+    submissions: &Receiver<Submission>,
+) -> CodexResult<()> {
+    session.internal_sessions.ensure_idle().await?;
+    let reason = if session.active_turn.lock().await.is_some() {
+        Some("a turn or tool task is active")
+    } else if session
+        .input_queue
+        .has_pending_input(&session.active_turn)
+        .await
+    {
+        Some("input or agent mail is pending")
+    } else if *session.services.elicitations.subscribe().borrow() {
+        Some("an elicitation is pending")
+    } else if session.conversation.running_state().await.is_some() {
+        Some("a realtime conversation is active")
+    } else if !session.list_background_terminals().await.is_empty() {
+        Some("a background terminal is active")
+    } else if session
+        .services
+        .agent_control
+        .list_live_agent_subtree_thread_ids(session.thread_id)
+        .await?
+        .len()
+        > 1
+    {
+        Some("a descendant actor is still loaded")
+    } else if session.hooks().has_pending_work()
+        || !submissions.is_empty()
+        || !session.async_hook_results.is_empty()
+    {
+        Some("a submission or hook result is pending")
+    } else {
+        None
+    };
+    match reason {
+        Some(reason) => Err(CodexErr::UnsupportedOperation(format!(
+            "cannot close idle thread: {reason}"
+        ))),
+        None => Ok(()),
+    }
+}
diff --git a/codex-rs/core/src/session/internal_sessions.rs b/codex-rs/core/src/session/internal_sessions.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1ccb399493f4b68ca2c0b410678a7d852821d62a
--- /dev/null
+++ b/codex-rs/core/src/session/internal_sessions.rs
@@ -0,0 +1,318 @@
+//! Registered delegates that do not appear in the public ThreadSpawn graph.
+
+use super::SessionIo;
+use super::SessionLoopTermination;
+use super::SubmissionActivityPermit;
+use super::SubmissionSender;
+use super::session::Session;
+use super::submission_admission::SubmissionActivitySource;
+use crate::CodexThread;
+use crate::thread_manager::ThreadManagerState;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::Op;
+use codex_protocol::protocol::Submission;
+use futures::FutureExt;
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::Weak;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU8;
+use std::sync::atomic::Ordering;
+use tokio::sync::oneshot;
+
+const MAX_INTERNAL_SESSIONS: usize = 256;
+
+#[derive(Default)]
+pub(crate) struct InternalSessionRegistry {
+    admission: SubmissionActivitySource,
+    state: Arc<Mutex<RegistryState>>,
+    // A terminated actor alone is not proof: normal shutdown can report errors.
+    shutdown_result: AtomicU8,
+    closing: AtomicBool,
+}
+
+#[derive(Default)]
+struct RegistryState {
+    next_id: u64,
+    entries: BTreeMap<u64, Option<Arc<InternalActor>>>,
+}
+
+struct InternalActor {
+    session: Arc<Session>,
+    submissions: SubmissionSender,
+    termination: SessionLoopTermination,
+    manager: Option<Weak<ThreadManagerState>>,
+}
+
+/// A cancelled/failed startup leaves an explicit unknown entry. There may be
+/// an actor spawned before its handle was returned, so elapsed time cannot
+/// turn that entry into a successful close proof.
+pub(crate) struct InternalSessionStartup {
+    state: Arc<Mutex<RegistryState>>,
+    id: u64,
+    _admission: SubmissionActivityPermit,
+}
+
+impl InternalSessionRegistry {
+    pub(crate) fn new(admission: SubmissionActivitySource) -> Self {
+        Self {
+            admission,
+            ..Self::default()
+        }
+    }
+
+    pub(crate) fn try_admit_activity(&self) -> CodexResult<SubmissionActivityPermit> {
+        let permit = self.admission.try_admit()?;
+        if self.closing.load(Ordering::Acquire) || self.shutdown_result.load(Ordering::Acquire) != 0
+        {
+            return Err(blocked("the parent actor is shutting down"));
+        }
+        Ok(permit)
+    }
+
+    pub(crate) fn begin_startup(&self) -> CodexResult<InternalSessionStartup> {
+        let admission = self.try_admit_activity()?;
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| blocked("registry lock failed"))?;
+        // Normal shutdown does not reserve the input gate. Recheck while
+        // serializing the entry insertion with its actor snapshot as well.
+        if self.closing.load(Ordering::Acquire) || self.shutdown_result.load(Ordering::Acquire) != 0
+        {
+            return Err(blocked("the parent actor is shutting down"));
+        }
+        if state.entries.len() >= MAX_INTERNAL_SESSIONS {
+            return Err(blocked("too many unverified internal actors"));
+        }
+        let id = state.next_id;
+        state.next_id = id
+            .checked_add(1)
+            .ok_or_else(|| blocked("registry exhausted"))?;
+        state.entries.insert(id, None);
+        Ok(InternalSessionStartup {
+            state: Arc::clone(&self.state),
+            id,
+            _admission: admission,
+        })
+    }
+
+    /// Called after checked runtime cleanup and final persistence shutdown.
+    /// Failure is sticky, including when cleanup was partly completed.
+    pub(crate) fn record_shutdown_result(&self, result: &CodexResult<()>) {
+        if result.is_err() {
+            self.shutdown_result.store(2, Ordering::Release);
+        } else {
+            let _ =
+                self.shutdown_result
+                    .compare_exchange(0, 1, Ordering::AcqRel, Ordering::Acquire);
+        }
+    }
+
+    pub(crate) fn shutdown_is_verified(&self) -> bool {
+        self.shutdown_result.load(Ordering::Acquire) == 1
+    }
+
+    fn actors(&self) -> CodexResult<Vec<Arc<InternalActor>>> {
+        self.state
+            .lock()
+            .map_err(|_| blocked("registry lock failed"))?
+            .entries
+            .values()
+            .map(|entry| {
+                entry
+                    .clone()
+                    .ok_or_else(|| blocked("internal startup is pending or uncertain"))
+            })
+            .collect()
+    }
+
+    pub(crate) async fn ensure_idle(&self) -> CodexResult<()> {
+        for actor in self.actors()? {
+            if actor.termination.clone().now_or_never().is_some() {
+                if actor
+                    .session
+                    .internal_sessions
+                    .shutdown_result
+                    .load(Ordering::Acquire)
+                    != 1
+                {
+                    return Err(blocked("internal actor cleanup was not verified"));
+                }
+                continue;
+            }
+            let active_turn = actor.session.active_turn.lock().await.is_some();
+            let pending_input = actor
+                .session
+                .input_queue
+                .has_pending_input(&actor.session.active_turn)
+                .await;
+            let pending_mail = actor.session.input_queue.has_pending_mailbox_items().await;
+            let elicitation = *actor.session.services.elicitations.subscribe().borrow();
+            let realtime = actor.session.conversation.running_state().await.is_some();
+            let background = !actor.session.list_background_terminals().await.is_empty();
+            if actor.submissions.pending_count() != 0
+                || actor.submissions.active_admissions() != 0
+                || actor.submissions.is_sealed()
+                || actor.submissions.is_closed()
+                || active_turn
+                || pending_input
+                || pending_mail
+                || elicitation
+                || realtime
+                || background
+                || actor.session.hooks().has_pending_work()
+                || !actor.session.async_hook_results.is_empty()
+            {
+                return Err(blocked("an internal actor has pending work or cleanup"));
+            }
+            Box::pin(actor.session.internal_sessions.ensure_idle()).await?;
+        }
+        Ok(())
+    }
+
+    /// Parent admission must already be sealed. Reserve every registered actor
+    /// before stopping any, and use the actual actor channel rather than a
+    /// delegate's forwarding channel. No active helper is interrupted here.
+    pub(crate) async fn close_idle(&self) -> CodexResult<()> {
+        self.ensure_idle().await?;
+        let mut reserved = Vec::new();
+        for actor in self.actors()? {
+            if actor.termination.clone().now_or_never().is_some() {
+                if actor
+                    .session
+                    .internal_sessions
+                    .shutdown_result
+                    .load(Ordering::Acquire)
+                    != 1
+                {
+                    return Err(blocked("internal actor cleanup was not verified"));
+                }
+                actor.remove_verified_manager_entry().await;
+                continue;
+            }
+            let reservation = actor.submissions.try_reserve_idle_close()?;
+            reserved.push((actor, reservation));
+        }
+        for (actor, reservation) in reserved {
+            let (reply, result) = oneshot::channel();
+            actor
+                .submissions
+                .request_idle_shutdown(reservation, reply)?;
+            result
+                .await
+                .map_err(|_| blocked("internal close reply was lost"))??;
+            actor.termination.clone().await;
+            actor.remove_verified_manager_entry().await;
+        }
+        Ok(())
+    }
+
+    /// Ordinary parent shutdown may interrupt work, but still retains failed
+    /// or incomplete helper cleanup as a failed ownership-release proof.
+    pub(crate) async fn shutdown(&self) -> CodexResult<()> {
+        self.closing.store(true, Ordering::Release);
+        for actor in self.actors()? {
+            if actor.termination.clone().now_or_never().is_none() {
+                let submission = actor
+                    .submissions
+                    .send(Submission {
+                        id: super::new_submission_id(),
+                        op: Op::Shutdown,
+                        trace: None,
+                        parent_turn_id: None,
+                        root_turn_id: None,
+                    })
+                    .await;
+                if submission.is_err() && actor.termination.clone().now_or_never().is_none() {
+                    return Err(blocked("internal actor shutdown submission was rejected"));
+                }
+                actor.termination.clone().await;
+            }
+            if actor
+                .session
+                .internal_sessions
+                .shutdown_result
+                .load(Ordering::Acquire)
+                != 1
+            {
+                return Err(blocked("internal actor cleanup was not verified"));
+            }
+            actor.remove_verified_manager_entry().await;
+        }
+        Ok(())
+    }
+}
+
+impl InternalSessionStartup {
+    pub(crate) fn register(&self, session: Arc<Session>, io: &SessionIo) -> CodexResult<()> {
+        self.register_actor(Arc::new(InternalActor {
+            session,
+            submissions: io.tx_sub.clone(),
+            termination: io.session_loop_termination.clone(),
+            manager: None,
+        }))
+    }
+
+    pub(crate) fn register_internal_thread(
+        &self,
+        thread: &Arc<CodexThread>,
+        manager: Weak<ThreadManagerState>,
+    ) -> CodexResult<()> {
+        self.register_actor(Arc::new(InternalActor {
+            session: Arc::clone(&thread.session),
+            submissions: thread.io.tx_sub.clone(),
+            termination: thread.io.session_loop_termination.clone(),
+            manager: Some(manager),
+        }))
+    }
+
+    fn register_actor(&self, actor: Arc<InternalActor>) -> CodexResult<()> {
+        {
+            let mut state = self
+                .state
+                .lock()
+                .map_err(|_| blocked("registry lock failed"))?;
+            let entry = state
+                .entries
+                .get_mut(&self.id)
+                .ok_or_else(|| blocked("internal startup registration disappeared"))?;
+            if entry.is_some() {
+                return Err(blocked("internal startup was registered twice"));
+            }
+            *entry = Some(Arc::clone(&actor));
+        }
+        let state = Arc::clone(&self.state);
+        let id = self.id;
+        // Reclaim only after a successful checked shutdown and loop exit.
+        // Lost/cancelled/failed cleanup remains visible to the parent's close.
+        drop(tokio::spawn(async move {
+            actor.termination.clone().await;
+            if actor.session.internal_sessions.shutdown_is_verified() {
+                actor.remove_verified_manager_entry().await;
+                if let Ok(mut state) = state.lock() {
+                    state.entries.remove(&id);
+                }
+            }
+        }));
+        Ok(())
+    }
+}
+
+impl InternalActor {
+    async fn remove_verified_manager_entry(&self) {
+        if let Some(manager) = self.manager.as_ref().and_then(Weak::upgrade) {
+            manager.remove_verified_internal_actor(&self.session).await;
+        }
+    }
+}
+
+fn blocked(reason: &str) -> CodexErr {
+    CodexErr::UnsupportedOperation(format!("cannot close idle thread: {reason}"))
+}
+
