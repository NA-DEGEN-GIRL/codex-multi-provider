+struct SourceFile {
+    bytes: Vec<u8>,
+    modified: SystemTime,
+}
+
+#[track_caller]
+fn assert_source_unchanged(root: &Path, before: &BTreeMap<PathBuf, SourceFile>) {
+    let mut after = source_snapshot(root);
+    for (path, original) in before {
+        let current = after
+            .remove(path)
+            .unwrap_or_else(|| panic!("source file removed: {}", path.display()));
+        assert_source_file_unchanged(path, original, &current);
+    }
+    if let Some((path, _)) = after.first_key_value() {
+        panic!("unexpected source file created: {}", path.display());
+    }
+}
+
+#[track_caller]
+fn assert_source_file_unchanged(path: &Path, before: &SourceFile, after: &SourceFile) {
+    // Keep byte-for-byte verification, but never ask a line diff to format entire database/WAL
+    // byte vectors. Repeated byte lines can make a small mismatch allocate enormous diff tables.
+    if before.bytes != after.bytes {
+        let offset = before
+            .bytes
+            .iter()
+            .zip(&after.bytes)
+            .position(|(original, current)| original != current)
+            .unwrap_or_else(|| before.bytes.len().min(after.bytes.len()));
+        panic!(
+            "source bytes changed: {}; length before={}, after={}; first difference at byte {offset}: before={:?}, after={:?}",
+            path.display(),
+            before.bytes.len(),
+            after.bytes.len(),
+            before.bytes.get(offset),
+            after.bytes.get(offset)
+        );
+    }
+    assert_eq!(
+        after.modified,
+        before.modified,
+        "source modification time changed: {}",
+        path.display()
+    );
+}
+
+#[track_caller]
+fn assert_only_empty_reader_sidecars_added(root: &Path, before: &BTreeMap<PathBuf, SourceFile>) {
+    let sqlite = test_config(root).sqlite;
+    let allowed_wals = [sqlite.state_db_path(), sqlite.thread_history_db_path()].map(|path| {
+        PathBuf::from(format!(
+            "{}-wal",
+            path.file_name().expect("database name").to_string_lossy()
+        ))
+    });
+    let mut after = source_snapshot(root);
+    for (path, original) in before {
+        let current = after
+            .remove(path)
+            .unwrap_or_else(|| panic!("source file removed: {}", path.display()));
+        assert_source_file_unchanged(path, original, &current);
+    }
+    for (path, added) in after {
+        // mode=ro may create an empty WAL and SHM. SHM is already excluded by source_snapshot;
+        // no existing WAL data may change and no newly added WAL may contain frames.
+        assert!(
+            allowed_wals.contains(&path) && added.bytes.is_empty(),
+            "unexpected source file or WAL data created: {}",
+            path.display()
+        );
+    }
+}
+
+fn source_snapshot(root: &Path) -> BTreeMap<PathBuf, SourceFile> {
+    fn visit(root: &Path, directory: &Path, files: &mut BTreeMap<PathBuf, SourceFile>) {
+        for entry in fs::read_dir(directory).expect("list fixture source files") {
+            let entry = entry.expect("source entry");
+            let path = entry.path();
+            let metadata = entry.metadata().expect("source metadata");
+            if metadata.is_dir() {
+                if path == root.join("thread-writer-locks") {
+                    // Recorder ownership locks are synchronization state, not durable history.
+                    // A live Windows writer intentionally denies reads of the locked byte range.
+                    continue;
+                }
+                visit(root, &path, files);
+            } else if metadata.is_file() && !entry.file_name().to_string_lossy().ends_with("-shm") {
+                // SQLite read locks update shared-memory bookkeeping, not the source database.
+                // On Windows, opening the file refreshes cached directory-entry timestamps.
+                // Read both values through the same handle instead of mixing a FindFirstFile
+                // timestamp with bytes read through a separately opened handle.
+                let mut file = fs::File::open(&path).expect("open source snapshot");
+                let mut bytes = Vec::new();
+                std::io::Read::read_to_end(&mut file, &mut bytes).expect("source bytes");
+                files.insert(
+                    path.strip_prefix(root)
+                        .expect("source-relative path")
+                        .to_path_buf(),
+                    SourceFile {
+                        bytes,
+                        modified: file
+                            .metadata()
+                            .expect("source handle metadata")
+                            .modified()
+                            .expect("source modified timestamp"),
+                    },
+                );
+            }
+        }
+    }
+
+    let mut files = BTreeMap::new();
+    visit(root, root, &mut files);
+    files
+}
