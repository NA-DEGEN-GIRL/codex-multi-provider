+    );
+    assert!(!child_request.body_contains_text(ROOT_PROMPT));
+    assert!(!child_request.body_contains_text(DELEGATOR_CIPHERTEXT));
+    assert_eq!(test.thread_manager.list_thread_ids().await.len(), 3);
