+use super::*;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_protocol::protocol::ThreadMemoryMode;
+use serde_json::json;
+use tempfile::TempDir;
+
+#[tokio::test]
+async fn shared_record_edits_and_appends_use_canonical_storage() {
+    let temp = TempDir::new().unwrap();
+    let source_home = temp.path().join("source");
+    let selected_home = temp.path().join("selected-account");
+    std::fs::create_dir_all(&selected_home).unwrap();
+    let id = ThreadId::new();
+    let rollout =
+        super::super::tests::fixture(&source_home, &id.to_string(), "original question", "legacy");
+    let auth = source_home.join("auth.json");
+    std::fs::write(&auth, b"source-credential-sentinel").unwrap();
+    let config = source_home.join("config.toml");
+    std::fs::write(&config, b"source-config-sentinel").unwrap();
+    let path = temp.path().join("catalog.json");
+    std::fs::write(&path, json!({"version":1,"hostId":"local","revision":"test","entries":[
+        super::super::tests::source(&source_home, &rollout, &id.to_string(), &ThreadId::new().to_string(), "original:local")
+    ]}).to_string()).unwrap();
+    let store = SharedStore {
+        fallback: Arc::new(LocalThreadStore::new(
+            LocalThreadStoreConfig {
+                codex_home: selected_home.clone(),
+                sqlite: codex_state::SqliteConfig::from_sqlite_home(
+                    AbsolutePathBuf::from_absolute_path(&selected_home).unwrap(),
+                ),
+                default_model_provider_id: "openai".into(),
+            },
+            None,
+        )),
+        path,
+        canonical_home: None,
+        new_thread_home: None,
+        default_store: OnceCell::new(),
+        routes: Mutex::new(HashMap::new()),
+        homes: Mutex::new(HashMap::new()),
+    };
+    let original = store
+        .read_thread(ReadThreadParams {
+            thread_id: id,
+            include_archived: true,
+            include_history: false,
+        })
+        .await
+        .unwrap();
+    assert_eq!(original.thread_id, id);
+    assert_eq!(original.history_mode, ThreadHistoryMode::Legacy);
+    store
+        .resume_thread(ResumeThreadParams {
+            thread_id: id,
+            rollout_path: Some(rollout.clone()),
+            history: None,
+            include_archived: true,
+            metadata: ThreadPersistenceMetadata {
+                cwd: Some(source_home.clone()),
+                model_provider: "openai".into(),
+                memory_mode: ThreadMemoryMode::Disabled,
+            },
+        })
+        .await
+        .unwrap();
+    let item = serde_json::from_value(json!({"type":"event_msg","payload":{"type":"agent_message","message":"reply from selected account","phase":"final_answer"}})).unwrap();
+    store
+        .append_items(AppendThreadItemsParams {
+            thread_id: id,
+            items: vec![item],
+        })
+        .await
+        .unwrap();
+    store
+        .update_thread_metadata(UpdateThreadMetadataParams {
+            thread_id: id,
+            include_archived: true,
+            patch: ThreadMetadataPatch {
+                name: Some(Some("renamed task".into())),
+                ..Default::default()
+            },
+        })
+        .await
+        .unwrap();
+    store.shutdown_thread(id).await.unwrap();
+    let updated = store
+        .read_thread(ReadThreadParams {
+            thread_id: id,
+            include_archived: true,
+            include_history: false,
+        })
+        .await
+        .unwrap();
+    assert_eq!(updated.name.as_deref(), Some("renamed task"));
+    let history = std::fs::read_to_string(&rollout).unwrap();
+    assert!(history.contains("original question"));
+    assert!(history.contains("reply from selected account"));
+    assert_eq!(std::fs::read(auth).unwrap(), b"source-credential-sentinel");
+    assert_eq!(std::fs::read(config).unwrap(), b"source-config-sentinel");
+    assert!(!selected_home.join("sessions").exists());
+
+    // A newly started root task must enter the original app's native store,
+    // without reading its credentials or copying an already running session.
+    let mut store = store;
+    store.new_thread_home = Some(source_home.clone());
+    let new_id = ThreadId::new();
+    store
+        .create_thread(CreateThreadParams {
+            session_id: new_id.into(),
+            thread_id: new_id,
+            extra_config: None,
+            forked_from_id: None,
+            parent_thread_id: None,
+            source: codex_protocol::protocol::SessionSource::Exec,
+            thread_source: None,
+            originator: "shared-new-task-test".into(),
+            base_instructions: codex_protocol::models::BaseInstructions::default(),
+            dynamic_tools: vec![],
+            selected_capability_roots: vec![],
+            multi_agent_version: None,
+            history_mode: ThreadHistoryMode::Paginated,
+            history_base: None,
+            subagent_history_start_ordinal: None,
+            initial_window_id: "test-window".into(),
+            metadata: ThreadPersistenceMetadata {
+                cwd: Some(source_home.clone()),
+                model_provider: "openai".into(),
+                memory_mode: ThreadMemoryMode::Disabled,
+            },
+        })
+        .await
+        .unwrap();
+    store
+        .persist_thread(new_id, PersistContext::Standard)
+        .await
+        .unwrap();
+    let shared_path = store.local_rollout_path(new_id).await.unwrap().unwrap();
+    store.shutdown_thread(new_id).await.unwrap();
+    assert!(shared_path.starts_with(tokio::fs::canonicalize(&source_home).await.unwrap()));
+    assert!(!selected_home.join("sessions").exists());
+    let native = store
+        .home_store(tokio::fs::canonicalize(&source_home).await.unwrap())
+        .await
+        .unwrap();
+    let persisted = native
+        .read_thread(ReadThreadParams {
+            thread_id: new_id,
+            include_archived: false,
+            include_history: false,
+        })
+        .await
+        .unwrap();
+    assert_eq!(persisted.thread_id, new_id);
+    assert_eq!(
+        std::fs::read(source_home.join("auth.json")).unwrap(),
+        b"source-credential-sentinel"
+    );
+    assert_eq!(
+        std::fs::read(source_home.join("config.toml")).unwrap(),
+        b"source-config-sentinel"
+    );
+}
