index 0000000000000000000000000000000000000000..a409f60019c767456e7aeb5e8d2ce73b2a2a233f
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/shared_history_resume.rs
@@ -0,0 +1,146 @@
+//! Refresh an idle model context when another participating app added a turn.
+//! Sidebar hydration alone updates the UI, not the loaded inference actor.
+use super::*;
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn refresh_shared_history_before_turn(
+        &self,
+        request_id: &ConnectionRequestId,
+        id: &str,
+        client_name: Option<String>,
+        client_version: Option<String>,
+    ) -> Result<(), JSONRPCErrorError> {
+        if !crate::manager_record_catalog::execution::enabled()
+            && std::env::var("CODEX_RECORD_SHARED_APPEND").as_deref() != Ok("1")
+        {
+            return Ok(());
+        }
+        let thread_id = ThreadId::from_string(id)
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        let Ok(thread) = self.thread_manager.get_thread(thread_id).await else {
+            return Ok(());
+        };
+        if matches!(thread.agent_status().await, AgentStatus::Running)
+            || thread.config_snapshot().await.history_mode != ThreadHistoryMode::Paginated
+        {
+            // A running turn retains its actor and the normal steering semantics.
+            return Ok(());
+        }
+        let store = crate::managed_sources::read_store_for_thread(
+            &self.thread_manager,
+            &self.thread_store,
+            thread_id,
+        )
+        .await?;
+        store
+            .persist_thread(thread_id, PersistContext::Standard)
+            .await
+            .map_err(|err| internal_error(format!("failed to refresh shared history: {err}")))?;
+        if store
+            .read_thread_metadata(thread_id)
+            .await
