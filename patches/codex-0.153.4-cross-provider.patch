+#[tokio::test]
+async fn foreign_profile_resume_uses_target_default_but_unknown_same_owner_revision_fails() {
+    let temp = tempfile::tempdir().expect("fixture");
+    let path = temp.path().join("registry.json");
+    std::fs::write(&path, registry().to_string()).expect("registry");
+    let (session, _turn, _events) =
+        crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+            Vec::new(),
+            |config| prepare(config, path.clone()),
+        )
+        .await;
+    session
+        .update_settings(crate::session::session::SessionSettingsUpdate {
+            execution_preset: Some(Some(selection())),
+            ..Default::default()
+        })
+        .await
+        .expect("source selection");
+    let thread_id = session.thread_id();
+    let snapshot = session.thread_settings_snapshot().await;
+    assert_eq!(snapshot.execution_preset_profile_id.as_deref(), Some(OWNER));
+    let history = codex_history::InitialHistory::Resumed(codex_history::ResumedHistory {
+        conversation_id: thread_id,
+        history: Arc::new(vec![codex_history::RolloutItem::EventMsg(
+            codex_protocol::protocol::EventMsg::ThreadSettingsApplied(
+                codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                    thread_id: Some(thread_id),
+                    thread_settings: snapshot.clone(),
+                },
+            ),
+        )]),
+        rollout_path: None,
+    });
+    let mut missing = registry();
+    missing["presets"] = json!([]);
+    std::fs::write(&path, missing.to_string()).expect("same owner missing revision");
+    let mut same_owner = super::super::test_config().await;
+    prepare(&mut same_owner, path.clone());
+    assert!(
+        same_owner
+            .restore_execution_preset(&history)
+            .expect_err("must not broaden same-owner policy")
+            .to_string()
+            .contains("prepare/reload")
+    );
+    let mut target_manifest = registry();
+    target_manifest["profile_id"] = json!("33333333-3333-4333-8333-333333333333");
+    target_manifest["presets"][0]["revision"] = json!(2);
+    target_manifest["default_preset"] = json!({"id":PRESET,"revision":2});
+    std::fs::write(&path, target_manifest.to_string()).expect("different profile");
+    let mut target = super::super::test_config().await;
+    prepare(&mut target, path.clone());
+    target
+        .restore_execution_preset(&history)
+        .expect("target default applies across profile switch");
+    assert_eq!(
+        target.execution_preset_selection(),
+        Some(ExecutionPresetSelection {
+            id: PRESET.to_string(),
+            revision: 2
+        })
+    );
+    target_manifest["task_bindings"][thread_id.to_string()] = serde_json::Value::Null;
+    std::fs::write(&path, target_manifest.to_string()).expect("target explicit baseline");
+    target
+        .restore_execution_preset(&history)
+        .expect("target binding wins");
+    assert_eq!(target.execution_preset_selection(), None);
+
+    let mut roundtrip = history.clone();
+    let codex_history::InitialHistory::Resumed(resumed) = &mut roundtrip else {
+        unreachable!()
+    };
+    let mut foreign_snapshot = snapshot;
+    foreign_snapshot.execution_preset_profile_id =
+        Some("33333333-3333-4333-8333-333333333333".to_string());
+    foreign_snapshot.execution_preset = Some(ExecutionPresetSelection {
+        id: PRESET.to_string(),
+        revision: 2,
+    });
+    foreign_snapshot.execution_preset_bindings = target.execution_preset_bindings();
+    let checkpoint_snapshot = foreign_snapshot.clone();
+    Arc::make_mut(&mut resumed.history).push(codex_history::RolloutItem::EventMsg(
+        codex_protocol::protocol::EventMsg::ThreadSettingsApplied(
+            codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                thread_id: Some(thread_id),
+                thread_settings: foreign_snapshot,
+            },
+        ),
+    ));
+    let mut changed_default = registry();
+    let mut revision_two = changed_default["presets"][0].clone();
+    revision_two["revision"] = json!(2);
+    changed_default["presets"]
+        .as_array_mut()
+        .expect("presets")
+        .push(revision_two);
+    changed_default["default_preset"] = json!({"id":PRESET,"revision":2});
+    std::fs::write(path, changed_default.to_string()).expect("source profile default changed");
+    let mut returned = super::super::test_config().await;
+    prepare(&mut returned, temp.path().join("registry.json"));
+    returned.model = Some("current-main-selection".to_string());
+    returned
+        .restore_execution_preset(&roundtrip)
+        .expect("restore original owner revision");
+    assert_eq!(returned.execution_preset_selection(), Some(selection()));
+    assert_eq!(returned.model.as_deref(), Some("current-main-selection"));
+
+    // Paginated resume supplies only the latest compaction suffix. Its current-owner
+    // checkpoint must retain A's choice even when A's original event is outside that suffix.
+    let bounded_history = codex_history::InitialHistory::Resumed(codex_history::ResumedHistory {
+        conversation_id: thread_id,
+        history: Arc::new(vec![codex_history::RolloutItem::EventMsg(
+            codex_protocol::protocol::EventMsg::ThreadSettingsApplied(
+                codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                    thread_id: Some(thread_id),
+                    thread_settings: checkpoint_snapshot.clone(),
+                },
+            ),
+        )]),
+        rollout_path: None,
+    });
+    returned
+        .select_execution_preset(None)
+        .expect("reset before bounded restore");
+    returned
+        .restore_execution_preset(&bounded_history)
+        .expect("other-owner checkpoint preserves selection");
+    assert_eq!(returned.execution_preset_selection(), Some(selection()));
+
+    let mut oversized_snapshot = checkpoint_snapshot;
+    oversized_snapshot.execution_preset_bindings = (1..=65)
+        .map(|id| (uuid::Uuid::from_u128(id).to_string(), None))
+        .collect();
+    let oversized = codex_history::InitialHistory::Resumed(codex_history::ResumedHistory {
+        conversation_id: thread_id,
+        history: Arc::new(vec![codex_history::RolloutItem::EventMsg(
+            codex_protocol::protocol::EventMsg::ThreadSettingsApplied(
+                codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                    thread_id: Some(thread_id),
+                    thread_settings: oversized_snapshot,
+                },
+            ),
+        )]),
+        rollout_path: None,
+    });
+    assert!(
+        returned
+            .restore_execution_preset(&oversized)
+            .expect_err("bounded metadata")
+            .to_string()
+            .contains("too many saved")
+    );
+    assert_eq!(returned.execution_preset_selection(), Some(selection()));
+}
