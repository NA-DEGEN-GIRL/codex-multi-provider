+async fn start_turn(app: &mut TestAppServer, thread_id: &str) -> Result<TurnStartResponse> {
+    app.request(|request_id| ClientRequest::TurnStart {
+        request_id,
+        params: TurnStartParams {
+            thread_id: thread_id.to_string(),
+            input: vec![UserInput::Text {
+                text: "Finish this turn normally".to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        },
+    })
+    .await
