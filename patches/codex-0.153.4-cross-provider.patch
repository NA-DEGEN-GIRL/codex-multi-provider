+//! Serialize a single durable append across participating manager profiles.
+//! No account owns the task: the lease ends before inference or tool execution.
+use std::fs::OpenOptions;
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use super::RolloutItem;
+use super::RolloutLineRef;
+use super::ensure_rollout_is_newline_terminated;
+use crate::ordinal::final_durable_ordinal;
+
+pub(super) async fn append(
+    path: PathBuf,
+    timestamp: String,
+    item: RolloutItem,
+    initial_ordinal: Option<u64>,
+) -> io::Result<()> {
+    // Keep the lease and write in one owned blocking task. Cancellation cannot
+    // release the lock while the append continues on a different executor.
+    tokio::task::spawn_blocking(move || {
+        let lease = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(path.with_extension("manager-append.lock"))?;
+        lease.lock()?;
+        let mut file = OpenOptions::new().read(true).append(true).open(&path)?;
+        // A writer that died holding the lease can leave a torn record. Terminate it so this
+        // record starts on its own line; the ordinal scan below then skips the torn record.
+        ensure_rollout_is_newline_terminated(&mut file)?;
+        // Resume already validated history mode and completed inherited prefixes.
+        // A newly created V2 child is still copying its inherited prefix here;
+        // applying the resume-only completeness check after each line would
+        // prevent that prefix from ever being completed.
+        let ordinal = match initial_ordinal {
+            None => None,
+            Some(initial) if file.metadata()?.len() == 0 => Some(initial),
+            Some(_) => Some(next_durable_ordinal(&mut file, &path)?),
+        };
+        let line = RolloutLineRef {
+            timestamp,
+            ordinal,
+            item: &item,
+        };
+        let mut bytes = serde_json::to_vec(&line)?;
+        bytes.push(b'\n');
+        file.write_all(&bytes)?;
+        file.flush()?;
+        drop(lease);
+        Ok(())
+    })
+    .await
+    .map_err(io::Error::other)?
+}
+
+fn next_durable_ordinal(file: &mut std::fs::File, path: &Path) -> io::Result<u64> {
+    // Same envelope-only scan as resume: an item this binary cannot decode still holds its
+    // ordinal, and a complete record without one fails instead of being skipped.
+    final_durable_ordinal(file, path)?
+        .ok_or_else(|| io::Error::other("shared paginated record has no durable ordinal"))?
+        .checked_add(1)
+        .ok_or_else(|| io::Error::other("shared paginated record has no available next ordinal"))
+}
