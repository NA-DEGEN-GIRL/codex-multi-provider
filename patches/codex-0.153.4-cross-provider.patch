+impl ThreadLifecycleContributor<Config> for InstalledQueue {
+    fn on_thread_idle<'a>(&'a self, input: ThreadIdleInput<'a>) -> ExtensionFuture<'a, ()> {
+        match self.0.get() {
+            Some(service) => {
+                <QueuedItemService as ThreadLifecycleContributor<Config>>::on_thread_idle(
+                    service.as_ref(),
+                    input,
+                )
+            }
+            None => Box::pin(async {}),
+        }
+    }
+}
