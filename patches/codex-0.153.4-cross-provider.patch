+async fn close_when_idle(codex: &CodexThread) -> Result<()> {
+    // TurnComplete precedes clearing active_turn and its final persistence
+    // barrier, so a just-completed actor may briefly and correctly refuse close.
+    timeout(Duration::from_secs(10), async {
+        loop {
+            match codex.close_idle_and_shutdown().await {
+                Err(error)
+                    if matches!(error.details(), CodexErrorDetails::UnsupportedOperation(_)) =>
+                {
+                    tokio::time::sleep(Duration::from_millis(10)).await;
+                }
+                result => break result,
+            }
+        }
+    })
+    .await??;
+    Ok(())
+}
+
+struct IdleNotification(Arc<tokio::sync::Notify>);
+
+impl codex_extension_api::ThreadLifecycleContributor<codex_core::config::Config>
+    for IdleNotification
+{
+    fn on_thread_idle<'a>(
+        &'a self,
+        _input: codex_extension_api::ThreadIdleInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        Box::pin(async move { self.0.notify_one() })
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn managed_idle_close_releases_writer_and_preserves_resumable_history() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    responses::mount_sse_once(&server, responses::sse_completed("initial")).await;
+    let test = test_codex().build_with_auto_env(&server).await?;
+    test.submit_turn("preserve this completed turn").await?;
+    let rollout_path = test.codex.rollout_path().expect("persistent rollout");
+
+    close_when_idle(&test.codex).await?;
+    timeout(Duration::from_secs(1), test.codex.wait_until_terminated()).await?;
+    assert!(test.codex.submit(Op::Interrupt).await.is_err());
+
+    let history = tokio::fs::read_to_string(&rollout_path).await?;
+    let items = history
+        .lines()
+        .map(serde_json::from_str::<RolloutLine>)
+        .collect::<serde_json::Result<Vec<_>>>()?;
+    assert!(
+        items
+            .iter()
+            .any(|line| matches!(line.item, RolloutItem::EventMsg(EventMsg::TurnComplete(_))))
+    );
+    assert!(
+        items
+            .iter()
+            .all(|line| !matches!(line.item, RolloutItem::EventMsg(EventMsg::TurnAborted(_))))
+    );
+    test.thread_manager
+        .remove_thread(&test.session_configured.thread_id)
+        .await
+        .expect("the stopped root remains registered until removal");
+
+    let recovery_server = responses::start_mock_server().await;
+    let response =
+        responses::mount_sse_once(&recovery_server, responses::sse_completed("resumed")).await;
+    let resumed = test_codex()
+        .resume(&recovery_server, Arc::clone(&test.home), rollout_path)
+        .await?;
+    assert_eq!(
+        resumed.session_configured.thread_id,
+        test.session_configured.thread_id
+    );
+    resumed
+        .submit_turn("continue after the writer was released")
+        .await?;
+    let messages = response.single_request().message_input_texts("user");
+    assert!(
+        messages
+            .iter()
+            .any(|text| text == "preserve this completed turn")
+    );
+    assert!(
+        messages
+            .iter()
+            .any(|text| text == "continue after the writer was released")
+    );
+    close_when_idle(&resumed.codex).await?;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn managed_idle_close_rejects_busy_turn_without_interrupting_it() -> Result<()> {
+    let (complete_tx, complete_rx) = oneshot::channel();
+    let (server, _) = start_streaming_sse_server(vec![vec![
+        StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![responses::ev_response_created("busy")]),
+        },
+        StreamingSseChunk {
+            gate: Some(complete_rx),
+            body: responses::sse(vec![responses::ev_completed("busy")]),
+        },
+    ]])
+    .await;
+    let test = test_codex().build_with_streaming_server(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "finish this exact turn".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnStarted(_))
+    })
+    .await;
+    timeout(Duration::from_secs(10), server.wait_for_request_count(1)).await?;
+
+    let result = timeout(
+        Duration::from_secs(10),
+        test.codex.close_idle_and_shutdown(),
+    )
+    .await?;
+    assert!(matches!(
+        result,
+        Err(error) if matches!(error.details(), CodexErrorDetails::UnsupportedOperation(_))
+    ));
+    complete_tx
+        .send(())
+        .expect("inference request remains alive");
+    let terminal_event = wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_))
+    })
+    .await;
+    assert!(matches!(terminal_event, EventMsg::TurnComplete(_)));
+    assert_eq!(server.requests().await.len(), 1);
+    close_when_idle(&test.codex).await?;
+    server.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn managed_idle_close_rejects_queued_mail_without_discarding_it() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let response = responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse(vec![
+                responses::ev_response_created("initial"),
+                json!({
+                    "type": "response.output_item.done",
+                    "item": {"type": "message", "role": "assistant", "id": "answer",
+                        "content": [{"type": "output_text", "text": "first answer"}],
+                        "phase": "final_answer"},
+                }),
+                responses::ev_completed("initial"),
+            ]),
+            responses::sse_completed("mail"),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_model("gpt-5.4")
+        .build_with_auto_env(&server)
+        .await?;
+    test.codex
+        .submit(Op::InterAgentCommunication {
+            communication: InterAgentCommunication::new(
+                AgentPath::try_from("/root/worker").expect("valid worker agent path"),
+                AgentPath::root(),
+                Vec::new(),
+                "pending worker result".to_string(),
+                /*trigger_turn*/ false,
+            ),
+            start_options: Default::default(),
+        })
+        .await?;
+
+    // submit enqueues work; use the same FIFO barrier as the pending-input
+    // tests so this checks queued mail, rather than an unprocessed submission.
+    test.codex
+        .submit(Op::RealtimeConversationListVoices)
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::RealtimeConversationListVoicesResponse(_))
+    })
+    .await;
+
+    assert!(matches!(
+        test.codex.close_idle_and_shutdown().await,
+        Err(error) if matches!(error.details(), CodexErrorDetails::UnsupportedOperation(_))
+    ));
+    // Fresh user input is sampled first. A final answer records queue-only
+    // mail for the following turn, without starting an unsolicited model call.
+    test.submit_turn("establish the conversation").await?;
+    test.submit_turn("consume the worker result").await?;
+    let requests = response.requests();
+    assert_eq!(requests.len(), 2);
+    assert!(
+        requests[1]
+            .inputs_of_type("agent_message")
+            .iter()
+            .any(|item| item["content"].as_array().is_some_and(|content| {
+                content
+                    .iter()
+                    .any(|part| part["text"] == "pending worker result")
+            }))
+    );
+    close_when_idle(&test.codex).await?;
+    Ok(())
+}
