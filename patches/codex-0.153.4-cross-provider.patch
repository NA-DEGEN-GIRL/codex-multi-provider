+#[tokio::test]
+async fn truncated_source_rejects_a_projection_checkpoint_ahead_of_durable_history() {
+    let fixture = paginated_fixture().await;
+    let bytes = fs::read(&fixture.rollout_path).expect("read complete source rollout");
+    let first_line_end = bytes
+        .iter()
+        .position(|byte| *byte == b'\n')
+        .expect("complete session metadata line")
+        + 1;
+    assert!(
+        first_line_end < bytes.len(),
+        "fixture must contain turn records"
+    );
+    let retained_length = u64::try_from(first_line_end).expect("metadata byte offset fits u64");
+    let checkpoint_offset = sqlx::query_scalar::<_, i64>(
+        "SELECT next_rollout_byte_offset FROM thread_history_projection_state WHERE thread_id = ?",
+    )
+    .bind(fixture.thread_id.to_string())
+    .fetch_one(
+        fixture
+            .store
+            .thread_history_db()
+            .await
+            .expect("source history pool"),
+    )
+    .await
+    .expect("read existing committed checkpoint");
+    assert!(
+        u64::try_from(checkpoint_offset).expect("nonnegative checkpoint offset") > retained_length
+    );
+    fs::OpenOptions::new()
+        .write(true)
+        .open(&fixture.rollout_path)
+        .expect("open source for simulated truncation")
+        .set_len(retained_length)
+        .expect("truncate source to its complete metadata line");
+    let before = source_snapshot(fixture.home.path());
+    let reader = ReadOnlyLocalThreadStore::open(
+        fixture.home.path().to_path_buf(),
+        test_config(fixture.home.path()).sqlite,
+    )
+    .await
+    .expect("open source with existing but stale projection");
+
+    let error = reader
+        .list_turns(turn_params(fixture.thread_id, None, 10))
+        .await
+        .expect_err(
+            "source truncation must not expose projected turns absent from durable history",
+        );
+    assert!(
+        error
+            .to_string()
+            .contains("source history index unavailable or incomplete:"),
+        "checkpoint ahead of durable source should return an actionable error: {error}"
+    );
+    reader.close().await;
+    assert_source_unchanged(fixture.home.path(), &before);
+}
