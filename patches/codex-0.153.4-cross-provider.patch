@@ -0,0 +1,282 @@
+//! Durable canonical ownership, separate from account configuration and live writer locks.
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Read;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_protocol::ThreadId;
+use serde::Deserialize;
+use serde::Serialize;
+
+use crate::ManagedSourceId;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+const MAX_AUTHORITY_BYTES: u64 = 4096;
+const MAX_COUNTER: u64 = (1_u64 << 53) - 1;
+
+/// An immutable grant admitted for one runtime actor. A newer manifest cannot refresh it.
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedAuthorityGrant {
+    pub owner_profile_id: String,
+    pub epoch: u64,
+    pub revision: u64,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct ManagedAuthorityRecord {
+    version: u32,
+    host_id: String,
+    store_id: String,
+    thread_id: ThreadId,
+    owner_profile_id: String,
+    epoch: u64,
+    revision: u64,
+}
+
+#[derive(Clone)]
+pub(crate) struct ManagedAuthority {
+    path: PathBuf,
+    expected: ManagedAuthorityRecord,
+}
+
+fn denied(message: impl Into<String>) -> ThreadStoreError {
+    ThreadStoreError::Conflict {
+        message: message.into(),
+    }
+}
+
+impl ManagedAuthorityGrant {
+    pub(crate) fn validate(&self) -> ThreadStoreResult<()> {
+        if ThreadId::from_string(&self.owner_profile_id).is_err()
+            || !(1..=MAX_COUNTER).contains(&self.epoch)
+            || !(1..=MAX_COUNTER).contains(&self.revision)
+        {
+            return Err(denied(
+                "invalid managed owner identity or authority counters",
+            ));
+        }
+        Ok(())
+    }
+}
+
+impl ManagedAuthority {
+    pub(crate) fn from_grant(
+        home: &Path,
+        source: &ManagedSourceId,
+        thread_id: ThreadId,
+        grant: &ManagedAuthorityGrant,
+    ) -> ThreadStoreResult<Self> {
+        grant.validate()?;
+        let home = std::fs::canonicalize(home)
+            .map_err(|error| denied(format!("managed authority source is unavailable: {error}")))?;
+        Ok(Self {
+            path: home
+                .join("managed-authority")
+                .join(format!("{thread_id}.json")),
+            expected: ManagedAuthorityRecord {
+                version: 1,
+                host_id: source.host_id.clone(),
+                store_id: source.store_id.clone(),
+                thread_id,
+                owner_profile_id: grant.owner_profile_id.clone(),
+                epoch: grant.epoch,
+                revision: grant.revision,
+            },
+        })
+    }
+
+    /// Read an existing descendant grant only after the parent's own grant is validated.
+    pub(crate) fn descendant_grant(
+        home: &Path,
+        source: &ManagedSourceId,
+        thread_id: ThreadId,
+        owner_profile_id: &str,
+    ) -> ThreadStoreResult<ManagedAuthorityGrant> {
+        let path = home
+            .join("managed-authority")
+            .join(format!("{thread_id}.json"));
+        let record = Self::read(&path)?;
+        let grant = ManagedAuthorityGrant {
+            owner_profile_id: owner_profile_id.to_string(),
+            epoch: record.epoch,
+            revision: record.revision,
+        };
+        Self::from_grant(home, source, thread_id, &grant)?.validate()?;
+        Ok(grant)
+    }
+
+    pub(crate) fn validate(&self) -> ThreadStoreResult<()> {
+        let home = self
+            .path
+            .parent()
+            .and_then(Path::parent)
+            .ok_or_else(|| denied("managed authority source root is absent"))?;
+        let current_home = std::fs::canonicalize(home)
+            .map_err(|error| denied(format!("managed authority source is unavailable: {error}")))?;
+        if current_home != home {
+            return Err(denied("managed authority source root changed"));
+        }
+        let directory = home.join("managed-authority");
+        if std::fs::canonicalize(&directory).map_err(|error| {
+            denied(format!(
+                "managed authority directory is unavailable: {error}"
+            ))
+        })? != directory
+            || std::fs::canonicalize(&self.path).map_err(|error| {
+                denied(format!("managed authority record is unavailable: {error}"))
+            })? != self.path
+        {
+            return Err(denied(
+                "managed authority directory or record was redirected",
+            ));
+        }
+        let marker = Self::read_bytes(&home.join("managed-source.json"))?;
+        let source: ManagedSourceId = serde_json::from_slice(&marker)
+            .map_err(|error| denied(format!("invalid managed authority source marker: {error}")))?;
+        if source.host_id != self.expected.host_id || source.store_id != self.expected.store_id {
+            return Err(denied("managed authority source marker changed"));
+        }
+        if Self::read(&self.path)? != self.expected {
+            return Err(denied(
+                "managed canonical owner or authority epoch has changed",
+            ));
+        }
+        Ok(())
+    }
+
+    /// Hold the same permanent-file lock that the manager acquires exclusively for CAS.
+    /// Every independent binding/process participates; the lock file must never be deleted.
+    pub(crate) fn write_guard(&self) -> ThreadStoreResult<File> {
+        self.validate()?;
+        let guard_path = self.path.with_extension("guard");
+        match std::fs::canonicalize(&guard_path) {
+            Ok(canonical) if canonical != guard_path => {
+                return Err(denied("managed authority write fence was redirected"));
+            }
+            Err(error) if error.kind() != std::io::ErrorKind::NotFound => {
+                return Err(denied(format!(
+                    "managed authority write fence is unavailable: {error}"
+                )));
+            }
+            Ok(_) | Err(_) => {}
+        }
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(&guard_path)
+            .map_err(|error| {
+                denied(format!(
+                    "managed authority write fence is unavailable: {error}"
+                ))
+            })?;
+        file.try_lock_shared().map_err(|error| {
+            denied(format!(
+                "managed authority transfer is locked or unavailable: {error}"
+            ))
+        })?;
+        if std::fs::canonicalize(&guard_path).map_err(|error| {
+            denied(format!(
+                "managed authority write fence is unavailable: {error}"
+            ))
+        })? != guard_path
+        {
+            return Err(denied("managed authority write fence was redirected"));
+        }
+        self.validate()?;
+        Ok(file)
+    }
+
+    fn read_bytes(path: &Path) -> ThreadStoreResult<Vec<u8>> {
+        let mut bytes = Vec::new();
+        File::open(path)
+            .and_then(|file| file.take(MAX_AUTHORITY_BYTES + 1).read_to_end(&mut bytes))
+            .map_err(|error| {
+                denied(format!(
+                    "managed canonical authority is unavailable: {error}"
+                ))
+            })?;
+        if bytes.len() as u64 > MAX_AUTHORITY_BYTES {
+            return Err(denied("managed canonical authority exceeds 4096 bytes"));
+        }
+        Ok(bytes)
+    }
+
+    fn read(path: &Path) -> ThreadStoreResult<ManagedAuthorityRecord> {
+        serde_json::from_slice(&Self::read_bytes(path)?)
+            .map_err(|error| denied(format!("invalid managed canonical authority: {error}")))
+    }
+
+    /// Only called for a newly allocated native UUID, never as a resume fallback.
+    /// The manager uses the same mkdir lock for CAS and never steals it by age.
+    pub(crate) fn create_new(&self) -> ThreadStoreResult<()> {
+        let directory = self
+            .path
+            .parent()
+            .ok_or_else(|| denied("missing authority directory"))?;
+        std::fs::create_dir_all(directory)
+            .map_err(|error| denied(format!("cannot create authority directory: {error}")))?;
+        let lock_path = self.path.with_extension("lock");
+        std::fs::create_dir(&lock_path).map_err(|error| {
+            denied(format!(
+                "managed authority update is already locked or unavailable: {error}"
+            ))
+        })?;
+        let _lock = AuthorityCreationLock(lock_path);
+        let temporary = directory.join(format!(
+            ".{}.{}.tmp",
+            self.expected.thread_id,
+            ThreadId::new()
+        ));
+        let result = (|| {
+            let bytes = serde_json::to_vec(&self.expected)
+                .map_err(|error| denied(format!("cannot serialize managed authority: {error}")))?;
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&temporary)
+                .map_err(|error| denied(format!("cannot prepare managed authority: {error}")))?;
+            file.write_all(&bytes)
+                .and_then(|()| file.sync_all())
+                .map_err(|error| denied(format!("cannot persist managed authority: {error}")))?;
+            drop(file);
+            // Hard-link publication is atomic and refuses to replace an existing grant on every OS.
+            std::fs::hard_link(&temporary, &self.path).map_err(|error| {
+                denied(format!(
+                    "managed canonical authority already exists or cannot be published: {error}"
+                ))
+            })?;
+            #[cfg(unix)]
+            File::open(directory)
+                .and_then(|file| file.sync_all())
+                .map_err(|error| denied(format!("cannot persist authority directory: {error}")))?;
+            self.validate()
+        })();
+        if let Err(error) = std::fs::remove_file(&temporary)
+            && error.kind() != std::io::ErrorKind::NotFound
+        {
+            tracing::warn!("failed to remove managed authority temporary file: {error}");
+        }
+        result
+    }
+}
+
+struct AuthorityCreationLock(PathBuf);
+
+impl Drop for AuthorityCreationLock {
+    fn drop(&mut self) {
+        if let Err(error) = std::fs::remove_dir(&self.0) {
+            tracing::warn!("failed to release managed authority creation lock: {error}");
+        }
+    }
+}
