+    let config = source_home.join("config.toml");
+    std::fs::write(&config, b"source-config-sentinel").unwrap();
+    let path = temp.path().join("catalog.json");
+    std::fs::write(&path, json!({"version":1,"hostId":"local","revision":"test","entries":[
+        super::super::tests::source(&source_home, &rollout, &id.to_string(), &ThreadId::new().to_string(), "original:local")
+    ]}).to_string()).unwrap();
+    let store = SharedStore {
+        fallback: Arc::new(LocalThreadStore::new(
